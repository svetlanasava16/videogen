{"id": "en-r-8b5yoi.en", "jokeId": "en-r-8b5yoi", "locale": "en", "adaptation": "original", "notes": "Source wording kept. The exhibition is in the museum hall; the artist in a beret, the critic as a pompous gentleman with a monocle and a glass of wine, a few visitors behind them.", "title": "Worthless", "location": "zal", "cast": ["paren", "nachalnik"], "roles": {"paren": "artist", "nachalnik": "aristocrat"}, "lines": [{"character": "narrator", "text": "A young artist exhibits his work for the first time.", "emotion": "neutral", "pauseAfterSec": 0.3}, {"character": "narrator", "text": "And a well known art critic is in attendance.", "emotion": "neutral", "pauseAfterSec": 0.3}, {"character": "nachalnik", "text": "Would you like my opinion on your work?", "emotion": "smug", "pauseAfterSec": 0.3}, {"character": "paren", "text": "Yes.", "emotion": "happy", "pauseAfterSec": 0.3}, {"character": "nachalnik", "text": "It's worthless.", "emotion": "smug", "pauseAfterSec": 0.8}, {"character": "paren", "text": "I know, but tell me anyway.", "emotion": "neutral", "pauseAfterSec": 0.8, "laugh": "big"}], "scenes": [{"location": "zal", "place": "museum", "cast": ["paren", "nachalnik"], "roles": {"paren": "artist", "nachalnik": "aristocrat"}, "crowd": {"who": "people", "size": "few", "at": "front"}, "beats": [{"type": "prop", "who": "nachalnik", "item": "glass", "action": "hold"}, {"type": "line", "ref": "l1"}, {"type": "line", "ref": "l2"}, {"type": "line", "ref": "l3"}, {"type": "line", "ref": "l4"}, {"type": "line", "ref": "l5"}, {"type": "line", "ref": "l6"}]}]}
