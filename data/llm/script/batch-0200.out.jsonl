быть,","emotion":"surprised","pauseAfterSec":0},{"character":"narrator","text":"говорит он.","emotion":"neutral","pauseAfterSec":0},{"character":"paren","text":"Я работаю в «Квартете И»!","emotion":"happy","pauseAfterSec":0},{"character":"narrator","text":"Четвёртый вдруг белеет как мел, хватается за голову","emotion":"neutral","pauseAfterSec":0},{"character":"narrator","text":"и начинает дрожать.","emotion":"neutral","pauseAfterSec":0},{"character":"paren","text":"Что это с вами?","emotion":"sad","pauseAfterSec":0},{"character":"narrator","text":"сочувственно спрашивают остальные.","emotion":"neutral","pauseAfterSec":0},{"character":"muzhik","text":"Я работаю в «Седьмом континенте»!","emotion":"surprised","pauseAfterSec":0,"laugh":"big"}],"scenes":[{"location":"bolnitsa","cast":["muzhik-sosed","devushka","muzhik-ryzhy","paren","muzhik"],"roles":{"muzhik-sosed":"father","devushka":"nurse","muzhik-ryzhy":"father","paren":"father","muzhik":"father"},"looks":{"muzhik-sosed":{"add":["chef-hat"]},"muzhik-ryzhy":{"add":["tie"]},"paren":{"add":["bow-tie"]},"muzhik":{"add":["apron"]}},"beats":[{"type":"move","who":"muzhik-sosed","to":"couch"},{"type":"move","who":"muzhik-ryzhy","to":"center"},{"type":"move","who":"paren","to":"right"},{"type":"move","who":"muzhik","to":"skeleton"},{"type":"act","who":"muzhik-sosed","act":"sit"},{"type":"act","who":"muzhik-ryzhy","act":"sit"},{"type":"act","who":"paren","act":"sit"},{"type":"act","who":"muzhik","act":"sit"},{"type":"line","ref":"l1"},{"type":"move","who":"devushka","from":"off-left","to":"left"},{"type":"line","ref":"l2"},{"type":"line","ref":"l3"},{"type":"line","ref":"l4"},{"type":"act","who":"muzhik-sosed","act":"flex"},{"type":"line","ref":"l5"},{"type":"line","ref":"l6"},{"type":"line","ref":"l7"},{"type":"line","ref":"l8"},{"type":"line","ref":"l9"},{"type":"line","ref":"l10"},{"type":"line","ref":"l11"},{"type":"move","who":"devushka","to":"desk"},{"type":"line","ref":"l12"},{"type":"line","ref":"l13"},{"type":"line",