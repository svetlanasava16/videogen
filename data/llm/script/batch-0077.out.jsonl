, "text": "Zwei blinde Piloten steigen in ein Flugzeug.", "emotion": "neutral", "pauseAfterSec": 0.3}, {"character": "narrator", "text": "Sie tragen Sonnenbrillen und weiße Stöcke.", "emotion": "neutral", "pauseAfterSec": 0.3}, {"character": "narrator", "text": "Als das Flugzeug losrollt, wird den Passagieren mulmig.", "emotion": "neutral", "pauseAfterSec": 0.3}, {"character": "narrator", "text": "Das Flugzeug wird schneller, bleibt aber am Boden.", "emotion": "neutral", "pauseAfterSec": 0.3}, {"character": "narrator", "text": "Die restliche Startbahn wird immer kürzer, und das Flugzeug rast auf einen Zaun zu.", "emotion": "neutral", "pauseAfterSec": 0.3}, {"character": "narrator", "text": "Die Passagiere fangen an zu kreischen, und plötzlich hebt das Flugzeug ab und verfehlt den Zaun in letzter Sekunde.", "emotion": "neutral", "pauseAfterSec": 0.3}, {"character": "narrator", "text": "Alle Passagiere beruhigen sich und denken, es war ein schlechter Scherz.", "emotion": "neutral", "pauseAfterSec": 0.4}, {"character": "narrator", "text": "Im Cockpit dreht sich der Kopilot zum Piloten um und sagt:", "emotion": "neutral", "pauseAfterSec": 0.3}, {"character": "sluzhivy-ryadovoy", "text": "Weißt du was?", "emotion": "neutral", "pauseAfterSec": 0.8}, {"character": "sluzhivy-ryadovoy", "text": "Eines Tages schreien die zu spät, und dann sind wir alle tot.", "emotion": "sad", "pauseAfterSec": 0.8, "laugh": "big"}]}
