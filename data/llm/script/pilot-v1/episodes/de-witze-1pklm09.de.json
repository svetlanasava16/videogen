  "lines": [
    {
      "id": "l1",
      "character": "muzhik",
      "text": "Guten Tag. Ein Fläschchen Arsen, bitte.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "uchilka",
      "text": "Das Zeug ist hochgiftig! So etwas darf ich nicht verkaufen.",
      "emotion": "surprised",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "muzhik",
      "text": "Aber ich möchte doch meine Frau vergiften.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "uchilka",
      "text": "Sind Sie verrückt? Das ist verboten! Ich rufe sofort die Polizei!",
      "emotion": "angry",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "muzhik",
      "text": "Moment. Schauen Sie sich erst dieses Foto an.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "Auf dem Foto küsst seine Frau gerade den Mann der Apothekerin.",
      "emotion": "neutral",
      "pauseAfterSec": 0.8
    },
    {
      "id": "l7",
      "character": "uchilka",
      "text": "Ach so. Sie haben ja ein Rezept dabei.",
      "emotion": "smug",
      "pauseAfterSec": 0.8
    }
  ],
