  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Eine Frau liegt mit ihrem Liebhaber im Bett, da hört sie ihren Mann nach Hause kommen.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "zhena",
      "text": "Schnell! Pudere dich mit Babypuder ein und tu so, als wärst du eine Statue!",
      "emotion": "surprised",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l3",
      "character": "muzhik",
      "text": "Schatz, was macht denn die Statue hier?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "zhena",
      "text": "Schmidts haben auch eine, da wollte ich auch eine.",
      "emotion": "smug",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "Nachts, als seine Frau schläft, schleicht der Mann in die Küche und kommt mit einem Butterbrot und einem Glas Milch zurück.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l6",
      "character": "muzhik",
      "text": "Hier, iss und trink was.",
      "emotion": "neutral",
      "pauseAfterSec": 0.7
    },
    {
      "id": "l7",
      "character": "muzhik",
      "text": "Ich hab drei Tage wie ein Idiot bei Schmidts rumgestanden, und keiner hat mir was angeboten!",
      "emotion": "angry",
      "pauseAfterSec": 0.8
    }
  ],
  "format": {
