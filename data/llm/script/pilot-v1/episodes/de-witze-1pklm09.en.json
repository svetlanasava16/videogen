  "lines": [
    {
      "id": "l1",
      "character": "muzhik",
      "text": "Hello. A small bottle of arsenic, please.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "uchilka",
      "text": "That's deadly poison! I'm not allowed to sell that.",
      "emotion": "surprised",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "muzhik",
      "text": "But I need it to poison my wife.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "uchilka",
      "text": "Are you out of your mind? That's illegal! I'm calling the police!",
      "emotion": "angry",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "muzhik",
      "text": "Hold on. Take a look at this photo first.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "In the photo, his wife is kissing the pharmacist's husband.",
      "emotion": "neutral",
      "pauseAfterSec": 0.8
    },
    {
      "id": "l7",
      "character": "uchilka",
      "text": "Oh. Why didn't you say you had a prescription?",
      "emotion": "smug",
      "pauseAfterSec": 0.8
    }
  ],
