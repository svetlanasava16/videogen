  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "A bus in Odessa. A woman is on the phone.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "devushka",
      "text": "And can you imagine, Sophie? I walk into the bedroom, and there he is, rolling around with the neighbor in our bed!",
      "emotion": "surprised",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "devushka",
      "text": "So I tiptoe into the kitchen, and I grab the...",
      "emotion": "smug",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "devushka",
      "text": "Oh, Sophie, that's my stop! I'll ride home at six and tell you the rest.",
      "emotion": "surprised",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "Six in the evening. Same bus, same faces. A man jumps on, out of breath.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l6",
      "character": "muzhik",
      "text": "Did I miss anything?",
      "emotion": "surprised",
      "pauseAfterSec": 0.8
    },
    {
      "id": "l7",
      "character": "muzhik",
      "text": "Well, what are you staring at? Call Sophie!",
      "emotion": "angry",
      "pauseAfterSec": 0.8
    }
  ],
