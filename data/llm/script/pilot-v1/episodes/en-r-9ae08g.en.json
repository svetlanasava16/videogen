  "title": "The Statue",
  "location": "spalnya",
  "cast": [
    "paren",
    "zhena",
    "muzhik"
  ],
  "roles": {
    "paren": "lover",
    "zhena": "wife",
    "muzhik": "husband"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "A wife is in bed with her lover when she hears her husband come home.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "zhena",
      "text": "Quick! Rub baby powder all over yourself and pretend to be a statue!",
      "emotion": "surprised",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l3",
      "character": "muzhik",
      "text": "Honey, what's this statue doing here?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "zhena",
      "text": "The Smiths got one, so I wanted one too.",
      "emotion": "smug",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "That night, once his wife is asleep, the husband sneaks to the kitchen and comes back with a sandwich and a glass of milk.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l6",
      "character": "muzhik",
      "text": "Here, buddy. Have something to eat.",
      "emotion": "neutral",
      "pauseAfterSec": 0.7
    },
    {
      "id": "l7",
      "character": "muzhik",
      "text": "I stood like an idiot for three days at the Smiths', and nobody offered me a thing!",
      "emotion": "angry",
      "pauseAfterSec": 0.8
    }
  ],
  "format": {
    "width": 1080,
    "height": 1920,
    "fps": 30
  }
}
