  "locale": "de",
  "title": "Ruf Sofie an",
  "location": "doroga",
  "cast": [
    "devushka",
    "muzhik"
  ],
  "roles": {
    "devushka": "woman",
    "muzhik": "everyman"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein Bus in Odessa. Eine Frau telefoniert.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "devushka",
      "text": "Und stell dir vor, Sofie, ich komme ins Schlafzimmer, und er wälzt sich da mit der Nachbarin in unserem Bett!",
      "emotion": "surprised",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "devushka",
      "text": "Also schleiche ich in die Küche und hole...",
      "emotion": "smug",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "devushka",
      "text": "Oh, Sofie, meine Haltestelle! Um sechs fahr ich von der Arbeit heim, dann erzähl ich weiter.",
      "emotion": "surprised",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "Sechs Uhr abends. Derselbe Bus, dieselben Gesichter. Ein Mann springt keuchend herein.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l6",
      "character": "muzhik",
      "text": "Hab ich was verpasst?",
      "emotion": "surprised",
      "pauseAfterSec": 0.8
    },
    {
      "id": "l7",
      "character": "muzhik",
      "text": "Na, was glotzt du so? Ruf Sofie an!",
      "emotion": "angry",
      "pauseAfterSec": 0.8
    }
  ],
  "format": {
    "width": 1080,
    "height": 1920,
    "fps": 30
  }
}
