    {
      "id": "l1",
      "character": "muzhik",
      "text": "Darling, fifty years together.",
      "emotion": "happy",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "muzhik",
      "text": "We never had any secrets. But one thing keeps bothering me.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "zhena",
      "text": "What is it, my love?",
      "emotion": "happy",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "Our eighth, Michael. He looks nothing like the other seven.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "muzhik",
      "text": "Red hair, two heads taller, a different face. Please be honest. Does he have a different father?",
      "emotion": "sad",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l6",
      "character": "zhena",
      "text": "Yes. I'm so sorry. He has a different father.",
      "emotion": "sad",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l7",
      "character": "muzhik",
      "text": "All right. After all these years, I forgive you. But tell me, who is it?",
      "emotion": "sad",
      "pauseAfterSec": 0.8
    },
    {
      "id": "l8",
      "character": "zhena",
      "text": "You.",
      "emotion": "sad",
      "pauseAfterSec": 0.8
    }
  ],
