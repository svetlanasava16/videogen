{
  "id": "ru-3a049c5b9532.en",
  "jokeId": "ru-3a049c5b9532",
  "locale": "en",
  "title": "Give Me a Push",
  "location": "ulitsa",
  "cast": [
    "zhena",
    "muzhik",
    "muzhik-ryzhy"
  ],
  "roles": {
    "zhena": "wife",
    "muzhik": "husband",
    "muzhik-ryzhy": "drunk"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Three in the morning. Someone rings the doorbell.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "muzhik-ryzhy",
      "text": "Hey, buddy, can you give me a push? I'm just around the corner.",
      "emotion": "happy",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "muzhik",
      "text": "Are you nuts? It's three a.m.! Go bother someone else.",
      "emotion": "angry",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l4",
      "character": "zhena",
      "text": "Who was that?",
      "emotion": "neutral",
      "pauseAfterSec": 0.2
    },
    {
      "id": "l5",
      "character": "muzhik",
      "text": "Some idiot's stuck and wants a push. I told him to get lost.",
      "emotion": "angry",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l6",
      "character": "zhena",
      "text": "You animal! Remember when our car died in the rain and that young man pushed us for an hour?",
      "emotion": "angry",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l7",
      "character": "zhena",
      "text": "And you can't help a guy out?",
      "emotion": "angry",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l8",
      "character": "narrator",
      "text": "Grumbling, the husband gets dressed and steps out into the pitch-dark yard.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l9",
      "character": "muzhik",
      "text": "Hey! Where are you?",
      "emotion": "angry",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l10",
      "character": "muzhik-ryzhy",
      "text": "Over here! Come on!",
      "emotion": "happy",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l11",
      "character": "muzhik",
      "text": "Over where?",
      "emotion": "surprised",
      "pauseAfterSec": 0.8
    },
    {
      "id": "l12",
      "character": "muzhik-ryzhy",
      "text": "Right here, on the swings!",
      "emotion": "happy",
      "pauseAfterSec": 0.8
    }
  ],
  "format": {
    "width": 1080,
    "height": 1920,
    "fps": 30
  }
}
