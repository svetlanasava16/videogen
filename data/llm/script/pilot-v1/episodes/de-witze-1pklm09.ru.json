  "lines": [
    {
      "id": "l1",
      "character": "muzhik",
      "text": "Здравствуйте. Дайте, пожалуйста, пузырёк мышьяка.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "uchilka",
      "text": "Это сильнейший яд! Я не имею права его продавать.",
      "emotion": "surprised",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "muzhik",
      "text": "Но мне нужно отравить жену.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "uchilka",
      "text": "Вы с ума сошли? Это преступление! Я сейчас вызову полицию!",
      "emotion": "angry",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "muzhik",
      "text": "Погодите. Сначала взгляните на фотографию.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "На фото его жена целует мужа аптекарши.",
      "emotion": "neutral",
      "pauseAfterSec": 0.8
    },
    {
      "id": "l7",
      "character": "uchilka",
      "text": "А, так бы сразу и сказали, что у вас рецепт.",
      "emotion": "smug",
      "pauseAfterSec": 0.8
    }
  ],
  "format": {
    "width": 1080,
