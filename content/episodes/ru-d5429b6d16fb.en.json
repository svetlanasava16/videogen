  "locale": "en",
  "title": "Sister Anna",
  "location": "bar",
  "place": "bar",
  "cast": [
    "uchilka",
    "muzhik",
    "barmen"
  ],
  "roles": {
    "uchilka": "nun",
    "muzhik": "drunk",
    "barmen": "bartender"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "A man sits in a bar, drinking. A nun walks past.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "uchilka",
      "text": "How can you waste your life in this den of sin!",
      "emotion": "angry",
      "pauseAfterSec": 0.3,
      "enter": [
        "uchilka"
      ],
      "exit": []
    },
    {
      "id": "l3",
      "character": "muzhik",
      "text": "There's no sin here, Sister...",
      "emotion": "surprised",
      "pauseAfterSec": 0.2,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "uchilka",
      "text": "Anna!",
      "emotion": "angry",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "muzhik",
      "text": "Sister Anna. It's fine. I'm just having a drink.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "uchilka",
      "text": "And that offends the Lord!",
      "emotion": "angry",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "muzhik",
      "text": "Have you ever tried it yourself?",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "uchilka",
      "text": "Never!",
      "emotion": "angry",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l9",
      "character": "muzhik",
      "text": "Then how can you judge? Let me buy you one.",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l10",
      "character": "uchilka",
      "text": "What? And let people see a nun drinking?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l11",
      "character": "muzhik",
      "text": "I'll have them pour it into a teacup.",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l12",
      "character": "uchilka",
      "text": "Well, all right.",
      "emotion": "sad",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l13",
      "character": "muzhik",
      "text": "Two whiskeys, please. And pour one of them into a teacup.",
      "emotion": "neutral",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    },
    {
      "id": "l14",
      "character": "barmen",
      "text": "Sister Anna again?",
      "emotion": "surprised",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    }
  ],
