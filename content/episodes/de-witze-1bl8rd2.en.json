{
  "id": "de-witze-1bl8rd2.en",
  "jokeId": "de-witze-1bl8rd2",
  "locale": "en",
  "title": "The Dumbest Kid in Town",
  "location": "magazin",
  "place": "barbershop",
  "cast": [
    "vovochka",
    "muzhik",
    "barmen"
  ],
  "roles": {
    "vovochka": "child",
    "muzhik": "customer",
    "barmen": "craftsman"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "A little boy walks into the barbershop.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "barmen",
      "text": "That's the dumbest kid in town. Watch this.",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "He holds a five-dollar bill in one hand and two quarters in the other.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "barmen",
      "text": "Well, kid, pick a hand. Which one do you want?",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "The boy takes the two quarters and leaves.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "barmen",
      "text": "Well, what did I tell you?",
      "emotion": "smug",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "narrator",
      "text": "A little later the customer leaves the shop. Outside he sees the boy at the ice cream stand across the street.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "muzhik",
      "text": "Hey, kid, can I ask you something? Why do you take the two quarters and not the five?",
      "emotion": "neutral",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    },
    {
      "id": "l9",
      "character": "vovochka",
      "text": "The day I take the bill, the game is over.",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
