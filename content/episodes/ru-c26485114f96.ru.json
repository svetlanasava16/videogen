{
  "id": "ru-c26485114f96.ru",
  "jokeId": "ru-c26485114f96",
  "locale": "ru",
  "title": "Мысль и идея",
  "location": "samolet",
  "place": "train",
  "cast": [
    "doktor",
    "nachalnik"
  ],
  "roles": {
    "doktor": "therapist",
    "nachalnik": "new-russian"
  },
  "lines": [
    {
      "id": "l1",
      "character": "doktor",
      "text": "Я психолог.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [
        "doktor",
        "nachalnik"
      ],
      "exit": []
    },
    {
      "id": "l2",
      "character": "nachalnik",
      "text": "А я новый русский. Угадывай мои мысли. За каждую плачу сто баксов.",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "doktor",
      "text": "Я же не ясновидец, я психолог.",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "nachalnik",
      "text": "Сто баксов, мужик! Напрягись!",
      "emotion": "angry",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "doktor",
      "text": "Ты едешь с юга. Думаешь, как классно отдохнул.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "nachalnik",
      "text": "Точно! Сотка твоя. Дальше!",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "doktor",
      "text": "Отдыхал с красивой женщиной. Думаешь о ней.",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "nachalnik",
      "text": "Ещё сотка!",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l9",
      "character": "doktor",
      "text": "И домой тебе не хочется. Там жена.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l10",
      "character": "nachalnik",
      "text": "Волшебник! Держи ещё!",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l11",
      "character": "doktor",
      "text": "И ты думаешь: а не убить ли её?",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l12",
      "character": "nachalnik",
      "text": "Стоп! Вот тебе тысяча!",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l13",
      "character": "doktor",
      "text": "За что? Мысль как мысль.",
      "emotion": "surprised",
      "pauseAfterSec": 0.7,
      "enter": [],
      "exit": []
    },
    {
      "id": "l14",
      "character": "nachalnik",
      "text": "Мужик, это уже не мысль. Это идея!",
      "emotion": "happy",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    }
  ],
