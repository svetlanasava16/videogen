  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Gerasim, ein riesiger Hausknecht, der kein Wort sprechen konnte, wollte seinen kleinen Hund Mumu ertränken. Er band ihm einen Stein um den Hals, warf ihn in den Fluss und ruderte nach Hause.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Der arme Mumu zappelt und versucht, sich zu befreien. Dabei entdeckt ihn ein anderer Mann, der gerade vorbeischwimmt.",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "Er zieht den Hund heraus, bindet den Stein los... und da:",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "pyos",
      "text": "Danke dir, guter Mann! Du hast mich gerettet!",
      "emotion": "happy",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "muzhik",
      "text": "Zum ersten Mal im Leben sehe ich einen sprechenden Hund!",
      "emotion": "surprised",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
