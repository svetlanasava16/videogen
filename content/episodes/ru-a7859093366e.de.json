      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "Zum ersten Mal im Leben sehe ich einen sprechenden Hund!",
      "emotion": "surprised",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "pyos",
      "text": "Und ich zum ersten Mal einen sprechenden Menschen!",
      "emotion": "surprised",
