      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Ein Mann rudert vorbei, zieht den Hund heraus und bindet den Stein los.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [
        "muzhik"
      ],
      "exit": []
    },
    {
      "id": "l3",
      "character": "pyos",
      "text": "Danke, guter Mann! Du hast mich gerettet!",
