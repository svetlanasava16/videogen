  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Gerasim, der große stumme Hausknecht, ruderte mit seiner kleinen Hündin Mumu hinaus, um sie zu ertränken.",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Er band ihr einen Stein um den Hals und warf sie in den Fluss. Warf sie hinein und ruderte nach Hause.",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": [
        "muzhik-ryzhy"
      ]
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "Die arme Mumu strampelt und versucht, sich zu befreien.",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "narrator",
      "text": "Dabei findet sie ein anderer Mann, der gerade vorbeischwimmt.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [
        "muzhik"
      ],
      "exit": []
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "Er zieht sie heraus, bindet den Stein los... und da sagt Mumu:",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "pyos-pudel",
      "text": "Danke dir, guter Mann! Du hast mich gerettet!",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "muzhik",
      "text": "Zum ersten Mal im Leben sehe ich einen sprechenden Hund!",
      "emotion": "surprised",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "pyos-pudel",
      "text": "Zum ersten Mal im Leben sehe ich einen sprechenden Mann!",
