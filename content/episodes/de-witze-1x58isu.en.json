  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Three little boys are arguing about whose dad is the fastest.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "devochka",
      "text": "My dad drives a Porsche and easily does a hundred and eighty miles an hour!",
      "emotion": "smug",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "vovochka-drug",
      "text": "That's nothing.",
      "emotion": "smug",
      "pauseAfterSec": 0.2
    },
    {
      "id": "l4",
      "character": "vovochka-drug",
      "text": "My dad's a pilot for Lufthansa and flies a Boeing that shoots off at four hundred and thirty miles an hour at least!",
      "emotion": "happy",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "vovochka",
      "text": "That's all nothing at all. My dad's a civil servant.",
      "emotion": "smug",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l6",
      "character": "vovochka",
      "text": "He finishes work at five in the evening, and he's home by half past three!",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
