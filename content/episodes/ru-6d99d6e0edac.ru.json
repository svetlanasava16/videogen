    {
      "id": "l1",
      "character": "muzhik",
      "text": "Ваш банк дает кредиты под честное слово?",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "nachalnik",
      "text": "Без проблем...",
      "emotion": "smug",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "muzhik",
      "text": "А если я не верну?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "nachalnik",
      "text": "Вам будет стыдно перед Всевышним, когда предстанете.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "muzhik",
      "text": "Когда это еще будет...",
      "emotion": "happy",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l6",
      "character": "nachalnik",
      "text": "Вот, если пятого не вернете, шестого предстанете.",
      "emotion": "smug",
