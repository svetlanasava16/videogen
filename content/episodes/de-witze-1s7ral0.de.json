  "locale": "de",
  "title": "Die Beichte",
  "kind": "joke",
  "v": 2,
  "location": "tserkov",
  "place": "church",
  "cast": [
    "ded",
    "batyushka"
  ],
  "roles": {
    "ded": "old-man",
    "batyushka": "priest"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein älterer Herr geht nach über dreißig Jahren wieder zur Beichte.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "ded",
      "text": "Na so was! Eine Minibar, feinste Pralinen und eine gepolsterte Lederbank!",
      "emotion": "surprised",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "batyushka",
      "text": "Grüß Gott, mein Sohn.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "ded",
      "text": "Hochwürden, die Kirche hat sich ja fantastisch modernisiert!",
      "emotion": "happy",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l4b",
      "character": "ded",
      "text": "Wirklich einladend!",
      "emotion": "happy",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "batyushka",
      "text": "Gehen Sie bitte wieder raus, mein Sohn.",
      "emotion": "sad",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l6",
      "character": "ded",
      "text": "Warum denn? Habe ich etwas falsch gemacht?",
      "emotion": "surprised",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l7",
      "character": "batyushka",
      "text": "Ja. Sie sind auf der Seite des Pfarrers eingestiegen.",
      "emotion": "neutral",
      "pauseAfterSec": 0.8
    }
  ],
