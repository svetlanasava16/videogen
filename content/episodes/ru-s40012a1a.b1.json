  "lines": [
    {
      "id": "l1",
      "character": "zhena",
      "text": "Вася, встреча в десять, а ты всё у зеркала крутишься!",
      "emotion": "angry",
      "pauseAfterSec": 0
    },
    {
      "id": "l2",
      "character": "muzhik",
      "text": "Успею, Люся. Машина под окном, домчу за пять минут.",
      "emotion": "smug",
      "pauseAfterSec": 0
    },
    {
      "id": "l3",
      "character": "zhena",
      "text": "Смотри. Опоздаешь — опять будешь сказки рассказывать.",
      "emotion": "neutral",
      "pauseAfterSec": 0
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "Я сегодня, Люся, как часы.",
      "emotion": "happy",
      "pauseAfterSec": 0.8
    }
  ],
