    {
      "id": "l1",
      "character": "narrator",
      "text": "At a restaurant, the waiter serves a customer his schnitzel, and the customer sees that the waiter has his thumb on the schnitzel.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "muzhik",
      "text": "Excuse me, but what is your thumb doing on my schnitzel?",
      "emotion": "angry",
      "pauseAfterSec": 0.2,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "muzhik",
      "text": "Ever heard of hygiene?",
      "emotion": "angry",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "barmen",
      "text": "Yes, I'm sorry, but I've got a fistula on my thumb, and the doctor said I should keep it warm whenever I can!",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "muzhik",
      "text": "But not on my schnitzel! For all I care, stick your thumb up your butt!",
      "uncensored": "But not on my schnitzel! For all I care, stick your thumb up your ass!",
      "emotion": "angry",
      "pauseAfterSec": 0.7,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "barmen",
      "text": "That's where I keep it most of the time, but every now and then I also have to serve!",
