  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Es ist Prüfung. Alle schreiben, so gut sie können, manche selbst, die meisten aber vom Spickzettel.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Nur fliegt man dafür gnadenlos raus: Der Prüfer ist ein Biest und versteht sein Handwerk. Die Reihen lichten sich langsam.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "nachalnik",
      "text": "Guten Tag, welche Gruppe ist das, was wird geprüft?",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "doktor",
      "text": "Gruppe hundertzwölf, sie schreiben Analysis.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "nachalnik",
      "text": "Bestimmt lauter Spick-Amateure, oder?",
      "emotion": "smug",
      "pauseAfterSec": 0.6,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "doktor",
      "text": "Ach was, die Amateure sind längst auf dem Flur, hier sind nur noch Profis übrig!",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
