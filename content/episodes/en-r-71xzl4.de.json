  "locale": "de",
  "title": "Eine Sechs in Mathe",
  "kind": "joke",
  "v": 2,
  "location": "gostinaya",
  "place": "home-living-room",
  "cast": [
    "muzhik",
    "vovochka-drug"
  ],
  "roles": {
    "muzhik": "father",
    "vovochka-drug": "child"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein kleiner Junge kommt von der Schule nach Hause und sagt zu seinem Vater:",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "vovochka-drug",
      "text": "Ich hab heute eine Sechs in Mathe bekommen.",
      "emotion": "sad",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "muzhik",
      "text": "Was ist passiert?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "vovochka-drug",
      "text": "Na ja, die Lehrerin hat mich gefragt,",
      "emotion": "neutral",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l4b",
      "character": "vovochka-drug",
      "text": "was ist drei mal zwei, und ich hab gesagt: sechs.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "muzhik",
      "text": "Na, das ist doch richtig.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l6",
      "character": "vovochka-drug",
      "text": "Ich weiß. Dann hat sie mich gefragt, was ist zwei mal drei.",
      "emotion": "sad",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l7",
      "character": "muzhik",
      "text": "Wo ist denn da der verdammte Unterschied?",
      "emotion": "angry",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l8",
      "character": "vovochka-drug",
      "text": "Genau das hab ich auch gesagt!",
      "emotion": "happy",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
