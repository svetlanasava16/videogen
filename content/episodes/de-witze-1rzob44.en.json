  "locale": "en",
  "title": "The Boss",
  "kind": "joke",
  "v": 2,
  "location": "magazin",
  "place": "shop",
  "cast": [
    "muzhik",
    "barmen",
    "ptitsa"
  ],
  "roles": {
    "muzhik": "customer",
    "barmen": "salesman",
    "ptitsa": "parrot"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "A customer walks into a pet shop and asks:",
      "emotion": "neutral",
      "pauseAfterSec": 0.2
    },
    {
      "id": "l2",
      "character": "muzhik",
      "text": "How much is that parrot there?",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "barmen",
      "text": "A thousand dollars.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "Why is it so expensive?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "barmen",
      "text": "That's a very gifted bird. He speaks fluently and can count to a hundred.",
      "emotion": "smug",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l6",
      "character": "muzhik",
      "text": "And how much is that one?",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l7",
      "character": "barmen",
      "text": "Fifteen hundred dollars.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l8",
      "character": "muzhik",
      "text": "That expensive again?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l9",
      "character": "barmen",
      "text": "Oh, that's an even more gifted bird.",
      "emotion": "happy",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l9b",
      "character": "barmen",
      "text": "He speaks three languages fluently and knows the complete works of Shakespeare by heart!",
      "emotion": "happy",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l10",
      "character": "narrator",
      "text": "Then the customer spots a small, old, ugly parrot in the corner.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l11",
      "character": "muzhik",
      "text": "And the one back there, that one must cost a lot less, surely?!",
      "emotion": "happy",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l12",
      "character": "barmen",
      "text": "No, that one costs three thousand dollars.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l13",
      "character": "muzhik",
      "text": "Excuse me? What can he do?!",
      "emotion": "surprised",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l14",
      "character": "barmen",
      "text": "I don't know either. He's never said a word, but the other two call him 'Boss'.",
      "emotion": "neutral",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
