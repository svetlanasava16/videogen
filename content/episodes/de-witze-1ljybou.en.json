  ],
  "roles": {
    "muzhik": "everyman",
    "muzhik-sosed": "friend"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Two friends are hanging out, musing about life.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "muzhik-sosed",
      "text": "If you had to die, how would you want to die?",
      "emotion": "neutral",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l3",
      "character": "muzhik",
      "text": "Hmmm, definitely not like my uncle.",
      "emotion": "sad",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "Rather like my father, he just fell asleep.",
      "emotion": "happy",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "After a while the friend asks:",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l6",
      "character": "muzhik-sosed",
      "text": "Your uncle, how did he die?",
      "emotion": "surprised",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l7",
      "character": "muzhik",
      "text": "Screaming loudly in panic, when my father just fell asleep at the wheel.",
      "emotion": "neutral",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
