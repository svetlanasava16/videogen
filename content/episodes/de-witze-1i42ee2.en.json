  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "A woman is sitting with her baby at the back of the bus.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "ded",
      "text": "My, what a remarkably ugly baby you have!",
      "emotion": "neutral",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "The woman is completely taken aback and doesn't know how to react.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "zhena",
      "text": "That guy back there just insulted my child!",
      "emotion": "angry",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "muzhik-ryzhy",
      "text": "What? That's not okay!",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "muzhik-ryzhy",
      "text": "You go over there right now and give him a proper piece of your mind!",
      "emotion": "angry",
      "pauseAfterSec": 0.6,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "muzhik-ryzhy",
      "text": "I'll hold your monkey for you in the meantime...",
      "emotion": "happy",
      "pauseAfterSec": 0.8,
