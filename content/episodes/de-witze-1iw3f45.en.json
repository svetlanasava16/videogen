  "title": "Three Dogs",
  "location": "ulitsa",
  "place": "park",
  "cast": [
    "pyos"
  ],
  "roles": {
    "pyos": "dog"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "At the dog park, a Dalmatian, a poodle and a mutt meet.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "pyos",
      "text": "Good day. My name is Antonius von Clawburg.",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "pyos",
      "text": "I come from an old noble line.",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "pyos",
      "text": "Like my ancestors, I too live at the side of the Duke.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "pyos",
      "text": "My name is Isabella von Houndsmark.",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "pyos",
      "text": "As the sound of my name already tells you, I too come from an old noble family.",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "pyos",
      "text": "Like my ancestors, I am the pride of the Count.",
      "emotion": "happy",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "pyos",
      "text": "Yo, friends, my owner mostly just calls me Buster.",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l9",
      "character": "pyos",
      "text": "But I'm noble too.",
      "emotion": "smug",
      "pauseAfterSec": 0.7,
      "enter": [],
      "exit": []
    },
    {
      "id": "l10",
      "character": "pyos",
      "text": "My full name is Buster Get-Off-The-Couch.",
      "emotion": "happy",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
