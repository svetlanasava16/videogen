  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "At the dog park, a Dalmatian, a poodle and a mutt meet.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "pyos-dalmatin",
      "text": "Good day. My name is Antonius von Krallenberg.",
      "emotion": "smug",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "pyos-dalmatin",
      "text": "I come from an old noble line.",
      "emotion": "smug",
      "pauseAfterSec": 0.2
    },
    {
      "id": "l4",
      "character": "pyos-dalmatin",
      "text": "Like my ancestors, I too live at the side of the Duke.",
      "emotion": "smug",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l5",
      "character": "pyos-pudel",
      "text": "My name is Isabella von Hundsmark.",
      "emotion": "smug",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l6",
      "character": "pyos-pudel",
      "text": "As the sound of my name already tells you, I too come from an old noble family.",
      "emotion": "smug",
      "pauseAfterSec": 0.2
    },
    {
      "id": "l7",
      "character": "pyos-pudel",
      "text": "Like my ancestors, I am the pride of the Count.",
      "emotion": "smug",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l8",
      "character": "pyos",
      "text": "Yo, friends, my master mostly just calls me Buster.",
      "emotion": "happy",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l9",
      "character": "pyos",
      "text": "But I'm noble too.",
      "emotion": "smug",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l10",
      "character": "pyos",
      "text": "My full name is: Buster, get off the couch!",
      "emotion": "happy",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
