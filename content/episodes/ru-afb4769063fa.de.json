  "locale": "de",
  "title": "Minus fünfundvierzig",
  "location": "gostinaya",
  "place": "home-living-room",
  "cast": [
    "muzhik",
    "muzhik-sosed"
  ],
  "roles": {
    "muzhik": "everyman",
