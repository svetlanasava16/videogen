  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein Mann hört den Wetterbericht. Es heißt: in Sibirien minus fünfundvierzig Grad.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Er glaubt es nicht und ruft seinen Freund in Sibirien an.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "muzhik",
      "text": "Hör mal, bei euch soll es ja schrecklich kalt sein?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "muzhik-sosed",
      "text": "Ach was, minus zwanzig, minus fünfundzwanzig.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "muzhik",
      "text": "Echt? Aber im Fernsehen haben sie minus fünfundvierzig gesagt?",
      "emotion": "surprised",
      "pauseAfterSec": 0.6,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "muzhik-sosed",
      "text": "Ach so... Na, das ist dann wohl draußen!",
      "emotion": "happy",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
