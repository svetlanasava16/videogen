{
  "id": "ru-3a049c5b9532.en",
  "jokeId": "ru-3a049c5b9532",
  "locale": "en",
  "title": "The Push",
  "kind": "joke",
  "v": 2,
  "location": "spalnya",
  "place": "park",
  "cast": [
    "muzhik",
    "zhena",
    "muzhik-ryzhy"
  ],
  "roles": {
    "muzhik": "husband",
    "muzhik-ryzhy": "drunk",
    "zhena": "wife"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Three in the morning. A husband and wife are asleep.",
      "emotion": "neutral",
      "pauseAfterSec": 0
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Suddenly the doorbell rings.",
      "emotion": "surprised",
      "pauseAfterSec": 0
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "The husband, swearing, goes to open the door.",
      "emotion": "angry",
      "pauseAfterSec": 0
    },
    {
      "id": "l4",
      "character": "narrator",
      "text": "On the doorstep stands a man, obviously tipsy:",
      "emotion": "neutral",
      "pauseAfterSec": 0
    },
    {
      "id": "l5",
      "character": "muzhik-ryzhy",
      "text": "Buddy, come with me, it's right nearby, you can give me a push.",
      "emotion": "happy",
      "pauseAfterSec": 0
    },
    {
      "id": "l6",
      "character": "muzhik",
      "text": "Man, are you out of your mind? It's three in the morning. Go ask somebody else.",
      "emotion": "angry",
      "pauseAfterSec": 0
    },
    {
      "id": "l7",
      "character": "narrator",
      "text": "The husband gets back into bed.",
      "emotion": "neutral",
      "pauseAfterSec": 0
    },
    {
      "id": "l8",
      "character": "narrator",
      "text": "His wife asks who it was.",
      "emotion": "neutral",
      "pauseAfterSec": 0
    },
    {
      "id": "l9",
      "character": "muzhik",
      "text": "Oh, some jerk got stuck and asked me to give him a push. I told him to get lost.",
      "emotion": "smug",
      "pauseAfterSec": 0
    },
    {
      "id": "l10",
      "character": "zhena",
      "text": "You're just some kind of beast.",
      "emotion": "angry",
      "pauseAfterSec": 0
    },
    {
      "id": "l11",
      "character": "zhena",
      "text": "Remember when our engine died, in the pouring rain,",
      "emotion": "angry",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l11b",
      "character": "zhena",
      "text": "and some young guy pushed us for a whole hour?",
      "emotion": "angry",
      "pauseAfterSec": 0
    },
    {
      "id": "l12",
      "character": "zhena",
      "text": "Can't you help a person out?",
      "emotion": "angry",
      "pauseAfterSec": 0
    },
    {
      "id": "l13",
      "character": "narrator",
      "text": "The husband, swearing again, crawls out of bed and gets dressed.",
      "emotion": "angry",
      "pauseAfterSec": 0
    },
    {
      "id": "l14",
      "character": "narrator",
      "text": "He goes out into the yard in pitch darkness. He shouts:",
      "emotion": "neutral",
      "pauseAfterSec": 0
    },
    {
      "id": "l15",
      "character": "muzhik",
      "text": "Hey, man! Where are you?",
      "emotion": "angry",
      "pauseAfterSec": 0
    },
    {
      "id": "l16",
      "character": "narrator",
      "text": "Out of the darkness:",
      "emotion": "neutral",
      "pauseAfterSec": 0
    },
    {
      "id": "l17",
      "character": "muzhik-ryzhy",
      "text": "Here I am! Over here!",
      "offscreen": true,
      "emotion": "happy",
      "pauseAfterSec": 0
    },
    {
      "id": "l18",
      "character": "muzhik",
      "text": "Where's here?",
      "emotion": "surprised",
      "pauseAfterSec": 0
    },
    {
      "id": "l19",
      "character": "muzhik-ryzhy",
      "text": "Right here, on the swings!",
      "emotion": "happy",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
