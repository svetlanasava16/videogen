{
  "id": "ru-97e1919afab9.ru",
  "jokeId": "ru-97e1919afab9",
  "locale": "ru",
  "title": "Бездонная канистра",
  "kind": "joke",
  "v": 2,
  "location": "doroga",
  "place": "road",
  "cast": [
    "muzhik",
    "chort"
  ],
  "roles": {
    "muzhik": "everyman",
    "chort": "genie"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Лето, солнце, жара... Мужик идёт из бани с канистрой пива. Предвкушает, как дома попьёт холодного пивка...",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "На дороге лежит бутылка, которую мужик пинает, и та разбивается о камень.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "Как водится — джинн, желание.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "Хочу, чтобы в канистре пиво никогда не заканчивалось.",
      "emotion": "happy",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "Джинн, поколдовав, исчезает.",
      "emotion": "neutral",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "А мужик до сих пор пытается канистру открыть.",
      "emotion": "neutral",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
  "explicit": false,
