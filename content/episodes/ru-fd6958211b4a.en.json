  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "At a cemetery, during a funeral, the foreman of the gravediggers sees a fifty-dollar bill sticking out of the breast pocket of the dead man's jacket.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "He immediately asks one of his crew to push the people away from the coffin on any pretext.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "When that's done and he reaches for the bill, the dead man suddenly grabs his hand and shouts:",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "sluzhivy",
      "text": "Tax police! Sting burial!",
      "emotion": "angry",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": [],
      "laugh": "chuckle"
    },
    {
      "id": "l5",
      "character": "barmen",
      "text": "You've got your job, and I've got mine.",
      "emotion": "neutral",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "And he nailed the coffin lid shut.",
      "emotion": "neutral",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
