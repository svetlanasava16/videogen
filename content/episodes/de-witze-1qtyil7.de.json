    {
      "id": "l1",
      "character": "narrator",
      "text": "Im Zug starrt Müller seinen Gegenüber unentwegt an.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "nachalnik",
      "text": "Was gucken Sie denn so?",
