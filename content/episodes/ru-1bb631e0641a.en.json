  "title": "A Gift for Your Girlfriend",
  "kind": "joke",
  "v": 2,
  "location": "magazin",
  "place": "shop",
  "cast": [
    "muzhik",
    "devushka"
  ],
  "roles": {
    "muzhik": "everyman",
    "devushka": "cashier"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "A man walks into a jewelry store.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "devushka",
      "text": "Oh, sir, how lovely that you stopped by!",
      "emotion": "happy",
      "pauseAfterSec": 0.2
    },
    {
      "id": "l3",
      "character": "devushka",
      "text": "For Valentine's Day we have twenty percent off for two weeks, buy something as a gift for your girlfriend.",
      "emotion": "happy",
      "pauseAfterSec": 0.2
    },
    {
      "id": "l4",
      "character": "devushka",
      "text": "Here's a little gold heart-shaped pendant, your girlfriend will love it.",
      "emotion": "smug",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "muzhik",
      "text": "I don't have a girlfriend...",
      "emotion": "sad",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l6",
      "character": "devushka",
      "text": "That can't be, such a striking, handsome, tall man and no girlfriend? Why?!",
      "emotion": "surprised",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l7",
      "character": "muzhik",
      "text": "My wife won't let me...",
      "emotion": "sad",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
