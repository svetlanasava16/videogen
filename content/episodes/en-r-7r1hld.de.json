  "locale": "de",
  "title": "Die paranoide Nachbarin",
  "kind": "joke",
  "v": 2,
  "location": "ulitsa",
  "place": "street",
  "cast": [
    "muzhik"
  ],
  "roles": {
    "muzhik": "everyman"
  },
  "lines": [
    {
      "id": "l1",
      "character": "muzhik",
      "text": "Meine attraktive Nachbarin ist total paranoid.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "muzhik",
      "text": "Sie glaubt, dass ich ihr folge oder sie sogar stalke,",
      "emotion": "surprised",
      "pauseAfterSec": 0.2
    },
    {
      "id": "l3",
      "character": "muzhik",
      "text": "sie hat Angst, dass ich von ihr besessen sein könnte,",
      "emotion": "sad",
      "pauseAfterSec": 0.2
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "und jedes Mal, wenn sie ein Geräusch im Haus hört, ist sie... versteigert?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "muzhik",
      "text": "Ach nein: versteinert.",
      "emotion": "happy",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l6",
      "character": "muzhik",
      "text": "Entschuldigung, es ist nicht leicht, ein Tagebuch mit dem Fernglas von einem Baum aus zu lesen.",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
