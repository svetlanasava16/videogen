      "pauseAfterSec": 0.2,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "und jedes Mal, wenn sie ein Geräusch im Haus hört, ist sie... versteigert?",
