    {
      "id": "l1",
      "character": "muzhik",
      "text": "Meine hübsche Nachbarin ist total paranoid.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "muzhik",
      "text": "Sie glaubt, ich verfolge sie. Ich stalke sie sogar.",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "muzhik",
      "text": "Sie hat Angst, ich sei von ihr besessen.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "Und jedes Mal, wenn sie im Haus ein Geräusch hört, ist sie ganz... erstaunt?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "muzhik",
      "text": "Ach nein. Erstarrt.",
      "emotion": "neutral",
      "pauseAfterSec": 0.6,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "muzhik",
      "text": "Entschuldigung, es ist nicht leicht, ein Tagebuch mit dem Fernglas vom Baum aus zu lesen.",
      "emotion": "happy",
      "pauseAfterSec": 0.8,
