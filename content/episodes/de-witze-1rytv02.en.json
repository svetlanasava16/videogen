      "text": "A man finds a penguin in the middle of the city.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "muzhik",
      "text": "Officer, I found this penguin. What do I do with him?",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [
        "muzhik",
        "ptitsa"
      ],
      "exit": []
    },
    {
      "id": "l3",
      "character": "sluzhivy",
      "text": "Well, sir, I'd take him to the zoo.",
