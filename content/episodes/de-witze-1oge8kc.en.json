  "roles": {
    "paren": "tourist",
    "devushka": "woman",
    "devushka-blondinka": "woman",
    "devushka-ryzhaya": "woman"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "A man is learning English. He's a real late bloomer: only at thirty does he start learning English at an evening class.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "His teacher urges him to practise in Britain. So he travels to a typical British village and goes into a typical British pub.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "At the next table sit three typical British women. He is very nervous, but he works up the courage to go over.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "paren",
      "text": "Excuse me, are you ladies from Scotland?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "The three notice right away that his English is poor. One of them answers kindly.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l6",
      "character": "devushka",
      "text": "No, dear. Wales.",
      "emotion": "happy",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l7",
      "character": "narrator",
      "text": "He realises his mistake and asks again.",
      "emotion": "neutral",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l8",
      "character": "paren",
      "text": "Are you wales from Scotland?",
      "emotion": "happy",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
