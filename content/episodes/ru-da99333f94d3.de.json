  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein Polizist hält einen Raser an.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "muzhik",
      "text": "Herr Wachtmeister, ich kann alles erklären!",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "sluzhivy",
      "text": "Erklären Sie das meinem Chef. Bis dahin ab in die Zelle.",
      "emotion": "angry",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "Aber ich wollte doch nur sagen...",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "sluzhivy",
      "text": "Ruhe!",
      "emotion": "angry",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": [
        "sluzhivy"
      ]
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "Ein paar Stunden später.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "sluzhivy",
      "text": "Sie haben Glück. Der Chef ist auf der Hochzeit seiner Tochter. Der kommt bestimmt gut gelaunt.",
      "emotion": "smug",
      "pauseAfterSec": 0.7,
      "enter": [
        "sluzhivy"
      ],
      "exit": []
    },
    {
      "id": "l8",
      "character": "muzhik",
      "text": "Darauf würde ich nicht wetten. Ich bin der Bräutigam.",
      "emotion": "sad",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    }
  ],
