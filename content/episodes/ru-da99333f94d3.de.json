{
  "id": "ru-da99333f94d3.de",
  "jokeId": "ru-da99333f94d3",
  "locale": "de",
  "title": "Der Bräutigam",
  "location": "doroga",
  "place": "police-station",
  "cast": [
    "sluzhivy",
    "paren"
  ],
  "roles": {
    "sluzhivy": "police-officer",
    "paren": "everyman"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein Polizist hält einen Raser an, der viel zu schnell gefahren ist.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "paren",
      "text": "Aber, Herr Polizist, ich kann alles erklären!",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "sluzhivy",
      "text": "Das erklärst du alles meinem Chef, und bis dahin sitzt du in der Zelle!",
      "emotion": "angry",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "paren",
      "text": "Aber ich will doch sagen...",
      "emotion": "sad",
      "pauseAfterSec": 0.2,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "sluzhivy",
      "text": "Halt den Mund...",
      "emotion": "angry",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "Ein paar Stunden später kommt der Polizist in die Zelle und sagt:",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "sluzhivy",
      "text": "Du hast Glück, der Chef ist gerade auf der Hochzeit seiner Tochter. Wenn er kommt, hat er bestimmt gute Laune!",
      "emotion": "smug",
      "pauseAfterSec": 0.6,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "paren",
      "text": "Darauf würde ich nicht zählen. Ich bin der Bräutigam.",
      "emotion": "sad",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
