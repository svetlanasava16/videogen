  "lines": [
    {
      "id": "l1",
      "character": "paren",
      "text": "Профессор Фёгеле, вам, как самому именитому натуралисту нашего времени,",
      "emotion": "neutral",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l1c",
      "character": "paren",
      "text": "после десятилетий поисков в самой глухой,",
      "emotion": "neutral",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l1b",
      "character": "paren",
      "text": "самой отдалённой части джунглей Мадагаскара удалось обнаружить последних додо.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l2",
      "character": "paren",
      "text": "Расскажите, пожалуйста, нашим зрителям, как вы их нашли?",
      "emotion": "happy",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l3",
      "character": "doktor",
      "text": "Очень вкусными! Обоих. И яйца тоже.",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
