{
  "id": "ru-d0d7c4a8d256.de",
  "jokeId": "ru-d0d7c4a8d256",
  "locale": "de",
  "title": "Strafzettel",
  "kind": "joke",
  "v": 2,
  "location": "doroga",
  "place": "street",
  "cast": [
    "muzhik",
    "sluzhivy"
  ],
  "roles": {
    "muzhik": "everyman",
    "sluzhivy": "police-officer"
  },
  "lines": [
    {
      "id": "l1",
      "character": "muzhik",
      "text": "Ich ging in den Laden und war nur ein paar Minuten drin.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "muzhik",
      "text": "Als ich rauskam, sah ich einen Bullen auf dem Motorrad,",
      "emotion": "surprised",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l2b",
      "character": "muzhik",
      "text": "der einen Strafzettel fürs Falschparken schrieb.",
      "emotion": "surprised",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "muzhik",
      "text": "Ach komm schon, verzeih mir doch, es ist das erste Mal!",
      "emotion": "happy",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "Er ignorierte mich und schrieb weiter seinen Zettel.",
      "emotion": "sad",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "muzhik",
      "text": "Du mieser Nazi!",
      "emotion": "angry",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l6",
      "character": "muzhik",
      "text": "Darauf schrieb er noch einen Strafzettel, diesmal wegen der Reifen.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l7",
      "character": "muzhik",
      "text": "Du Scheusal!",
      "emotion": "angry",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l8",
      "character": "muzhik",
      "text": "Er schrieb den zweiten Zettel,",
      "emotion": "neutral",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l8b",
      "character": "muzhik",
      "text": "klemmte ihn unter den Scheibenwischer und fing mit dem dritten an.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l9",
      "character": "muzhik",
      "text": "Zwanzig Minuten lang beschimpfte ich ihn, und er schrieb Strafzettel.",
      "emotion": "happy",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l10",
      "character": "muzhik",
      "text": "Aber mir war das egal: Mein Auto stand um die Ecke.",
      "emotion": "smug",
      "pauseAfterSec": 0.6,
      "laugh": "chuckle"
    },
    {
      "id": "l11",
      "character": "muzhik",
      "text": "Ich wollte mich einfach ein bisschen amüsieren...",
      "emotion": "happy",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
