  "lines": [
    {
      "id": "l1",
      "character": "chort",
      "text": "Du hast drei Wünsche.",
      "emotion": "smug",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "muzhik",
      "text": "Das kenne ich schon.",
      "emotion": "neutral",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l2b",
      "character": "muzhik",
      "text": "Was immer ich mir wünsche, es kommt zurück und beißt mich irgendwie.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "chort",
      "text": "Ich verspreche dir, das passiert nicht.",
      "emotion": "smug",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l3b",
      "character": "chort",
      "text": "Ich bin mir so sicher, dass ich dir unendlich viele Wünsche gebe, wenn doch.",
      "emotion": "smug",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "Okay. Ich wünsche mir einen Bumerang mit Zähnen.",
      "emotion": "smug",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l5",
      "character": "chort",
      "text": "Du Sohn einer...",
      "emotion": "angry",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
