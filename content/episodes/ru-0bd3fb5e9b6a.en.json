{
  "id": "ru-0bd3fb5e9b6a.en",
  "jokeId": "ru-0bd3fb5e9b6a",
  "locale": "en",
  "title": "Dorm Mice",
  "kind": "joke",
  "v": 2,
  "location": "ofis",
  "place": "bedroom",
  "cast": [
    "paren",
    "uchilka"
  ],
  "roles": {
    "paren": "student",
    "uchilka": "clerk"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "A student comes to the dorm warden.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "paren",
      "text": "It's simply impossible to live in our room. It's a nightmare!",
      "emotion": "angry",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "uchilka",
      "text": "What's the matter?",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "paren",
      "text": "Well, for example, there are loads of mice!",
      "emotion": "angry",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "uchilka",
      "text": "That can't be!",
      "emotion": "surprised",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l6",
      "character": "paren",
      "text": "Come on, I'll show you.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l7",
      "character": "narrator",
      "text": "They come into the room. The student takes some bread crumbs and throws them on the floor.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l8",
      "character": "narrator",
      "text": "A mouse appears, then a second one, a third, then a little fish, then a fourth mouse.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l9",
      "character": "uchilka",
      "text": "Yes, a few mice have moved in.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l10",
      "character": "uchilka",
      "text": "And what was that little fish?",
      "emotion": "surprised",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l11",
      "character": "paren",
      "text": "Right, so you're convinced about the mice?",
      "emotion": "smug",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l12",
      "character": "paren",
      "text": "Now let's deal with the damp!",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
