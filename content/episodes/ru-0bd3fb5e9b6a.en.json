  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "A student drags the dorm manager into his room.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [
        "paren",
        "barmen"
      ],
      "exit": []
    },
    {
      "id": "l2",
      "character": "paren",
      "text": "Nobody can live in here. It's a nightmare! Mice everywhere!",
      "emotion": "angry",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "barmen",
      "text": "Come on, no way.",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "paren",
      "text": "Watch. I'll drop some crumbs.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "barmen",
      "text": "One mouse... two... three...",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "barmen",
      "text": "Hang on. Was that a little fish?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "barmen",
      "text": "And another mouse. Fine, you've got a few mice. But what's with the fish?",
      "emotion": "neutral",
      "pauseAfterSec": 0.7,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "paren",
      "text": "Right, so we agree on the mice? Now let's talk about the damp!",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
