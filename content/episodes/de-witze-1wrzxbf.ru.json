  "lines": [
    {
      "id": "l1",
      "character": "tyoshcha",
      "text": "Доктор, меня замучили газы.",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [
        "tyoshcha"
      ],
      "exit": []
    },
    {
      "id": "l2",
      "character": "tyoshcha",
      "text": "Хорошо хоть, они совсем бесшумные и ничем не пахнут.",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "tyoshcha",
      "text": "Вот, видите, только что опять вышел. И никто не заметил.",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "doktor",
      "text": "Я выпишу вам лекарство. Приходите через две недели.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": [
        "tyoshcha"
      ]
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "Через две недели.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "tyoshcha",
      "text": "Доктор, что вы мне выписали?",
      "emotion": "angry",
      "pauseAfterSec": 0.3,
      "enter": [
        "tyoshcha"
      ],
      "exit": []
    },
    {
      "id": "l7",
      "character": "tyoshcha",
      "text": "Газов меньше не стало, зато теперь они ужасно воняют!",
      "emotion": "angry",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "doktor",
      "text": "Отлично, нос мы вылечили. Теперь займёмся ушами.",
      "emotion": "happy",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    }
