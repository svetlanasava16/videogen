  "locale": "de",
  "title": "Die sprechende Uhr",
  "kind": "joke",
  "v": 2,
  "location": "spalnya",
  "place": "bedroom",
  "cast": [
    "paren",
    "muzhik-sosed",
    "muzhik",
    "muzhik-ryzhy"
  ],
  "roles": {
    "paren": "friend",
    "muzhik-sosed": "friend",
    "muzhik": "drunk",
    "muzhik-ryzhy": "neighbor"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein Betrunkener zeigt seinen Freunden seine neue Wohnung.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Die letzte Station ist das Schlafzimmer, wo neben dem Bett ein großer Messinggong steht.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "muzhik-sosed",
      "text": "Wofür ist denn der Gong?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "Das ist kein Gong. Das ist eine sprechende Uhr.",
      "emotion": "smug",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l5",
      "character": "muzhik-sosed",
      "text": "Wie funktioniert die?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "Der Typ nimmt einen Hammer, haut ohrenbetäubend auf den Gong und tritt zurück.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l7",
      "character": "narrator",
      "text": "Plötzlich schreit jemand auf der anderen Seite der Wand.",
      "emotion": "neutral",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l8",
      "character": "muzhik-ryzhy",
      "text": "Um Gottes willen, du Idiot... es ist halb vier in der verdammten Früh!",
      "uncensored": "Um Gottes willen, du Arschloch... es ist halb vier in der verdammten Früh!",
      "offscreen": true,
      "emotion": "angry",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
