  ],
  "roles": {
    "muzhik-ryzhy": "friend",
    "paren": "friend",
    "muzhik": "drunk"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein Betrunkener zeigt seinen Freunden seine neue Wohnung. Die letzte Station ist das Schlafzimmer, wo neben dem Bett ein großer Messinggong steht.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "muzhik-ryzhy",
      "text": "Wofür ist denn der Gong?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "muzhik",
      "text": "Das ist kein Gong. Das ist eine sprechende Uhr.",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "muzhik-ryzhy",
      "text": "Und wie funktioniert die?",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "Der Mann nimmt einen Hammer, haut mit ohrenbetäubendem Krach auf den Gong und tritt zurück.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "Plötzlich schreit jemand auf der anderen Seite der Wand.",
      "emotion": "surprised",
      "pauseAfterSec": 0.6,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "muzhik-sosed",
      "text": "Herrgott nochmal, du Idiot... es ist halb vier in der verdammten Früh!",
      "uncensored": "Herrgott nochmal, du Arschloch... es ist halb vier in der verdammten Früh!",
      "emotion": "angry",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
