  "locale": "en",
  "title": "The Contact Lenses",
  "location": "ofis",
  "place": "office",
  "cast": [
    "paren",
    "devushka-blondinka"
  ],
  "roles": {
    "paren": "employee",
    "devushka-blondinka": "secretary"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "In the HR manager's waiting room, several men are waiting for their job interviews. One after another they come back out very quickly, white as a sheet, and flee the building.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "paren",
      "text": "What's going on in there?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "devushka-blondinka",
      "text": "The boss has no ears, and he can't stand it for the life of him when anyone mentions it.",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "paren",
      "text": "Thank you so much!",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "The young man is called in. The conversation is relaxed.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "nachalnik",
      "text": "Young man, take a really good look at me! Do you notice anything about me?",
      "emotion": "smug",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "paren",
      "text": "You wear contact lenses!",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "nachalnik",
      "text": "Good heavens, you're quite the observer! How did you spot that so fast?",
      "emotion": "surprised",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    },
    {
      "id": "l9",
      "character": "paren",
      "text": "If you had ears, you'd wear glasses.",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
