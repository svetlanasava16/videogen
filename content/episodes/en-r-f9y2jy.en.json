  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "An Englishman and an Irishman walk into a bakery.",
      "emotion": "neutral",
      "pauseAfterSec": 0.2,
      "enter": [
        "vor",
        "muzhik"
      ],
      "exit": []
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "While the baker looks away, the Englishman pockets three buns.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "vor",
      "text": "See? Pure skill. He didn't even notice.",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "That's just stealing. I'll show you the honest way, same result.",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "muzhik",
      "text": "Excuse me, sir! Want to see a magic trick?",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "barmen",
      "text": "A magic trick? Sure!",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "muzhik",
      "text": "First, I'll need a bun. And another. And one more.",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "narrator",
      "text": "He eats all three.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l9",
      "character": "barmen",
      "text": "Okay, my friend. So where's the magic trick?",
      "emotion": "angry",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    },
    {
      "id": "l10",
      "character": "muzhik",
      "text": "Look in the Englishman's pockets.",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    }
