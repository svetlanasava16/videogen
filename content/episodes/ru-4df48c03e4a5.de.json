{
  "id": "ru-4df48c03e4a5.de",
  "jokeId": "ru-4df48c03e4a5",
  "locale": "de",
  "title": "Wahrscheinlichkeitstheorie",
  "kind": "joke",
  "v": 2,
  "location": "ulitsa",
  "place": "street",
  "cast": [
    "ded",
    "doktor"
  ],
  "roles": {
    "ded": "professor",
    "doktor": "professor"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Zwei Mathematikprofessoren treffen sich.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "ded",
      "text": "Herr Kollege, man hat mich schon wieder bestohlen!",
      "emotion": "sad",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "doktor",
      "text": "Stellen Sie sich vor, Herr Kollege,",
      "emotion": "smug",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l3b",
      "character": "doktor",
      "text": "ich habe dieses Problem ein für alle Mal gelöst!",
      "emotion": "smug",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "ded",
      "text": "Hm... das würde mich interessieren, wie denn?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "doktor",
      "text": "Ich habe die Wahrscheinlichkeitstheorie angewandt und sechs der billigsten chinesischen Schlösser an meine Tür gebaut!",
      "emotion": "smug",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l6",
      "character": "ded",
      "text": "Und was hat die Wahrscheinlichkeitstheorie damit zu tun,",
      "emotion": "angry",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l6b",
      "character": "ded",
      "text": "wenn man sie alle mit einem Schlüssel öffnen kann?!",
      "emotion": "angry",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l7",
      "character": "doktor",
      "text": "Sagen Sie das nicht, Herr Kollege!",
      "emotion": "smug",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l7b",
      "character": "doktor",
      "text": "Wenn ich aus dem Haus gehe, schließe ich drei Schlösser ab und drei nicht!",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
  "explicit": false,
