  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Здоровенная немецкая овчарка зашла на почту, взяла бланк для телеграммы и написала: «Гав... гав... гав... гав... гав... гав... гав... гав... гав».",
      "emotion": "neutral",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l2",
      "character": "uchilka",
      "text": "Тут только девять слов. Вы можете добавить ещё одно слово за ту же цену.",
      "emotion": "neutral",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l3",
      "character": "pyos",
      "text": "Да нет, тогда какая-то фигня получится...",
      "uncensored": "Да нет, тогда какая-то хуйня получится...",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
