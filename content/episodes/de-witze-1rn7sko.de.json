  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein Bauer sitzt wegen Diebstahls im Gefängnis. Seine Frau schreibt ihm.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "zhena",
      "text": "Glaub bloß nicht, dass ich den Kartoffelacker jetzt allein umgrabe.",
      "emotion": "angry",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "muzhik",
      "text": "Hände weg vom Kartoffelacker! Da ist doch die ganze Beute drin.",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "narrator",
      "text": "Eine Woche später.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "zhena",
      "text": "Jemand im Gefängnis muss deinen Brief gelesen haben. Gestern waren unzählige Polizisten hier.",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "zhena",
      "text": "Sie haben den ganzen Acker umgegraben. Gefunden haben sie nichts.",
      "emotion": "sad",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "muzhik",
      "text": "Bestens. Jetzt kannst du die Kartoffeln setzen.",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    }
  ],
