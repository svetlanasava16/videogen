  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein Bauer muss wegen Diebstahls ins Gefängnis. Die Bäuerin schreibt ihm.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "zhena",
      "text": "Glaub bloß nicht, dass ich nun den Kartoffelacker allein umgrabe.",
      "emotion": "angry",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "Der Bauer schreibt zurück.",
      "emotion": "neutral",
      "pauseAfterSec": 0.2,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "Hände weg vom Kartoffelacker! Da ist doch die ganze Beute drin.",
      "emotion": "surprised",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "Eine Woche später schreibt die Bäuerin.",
      "emotion": "neutral",
      "pauseAfterSec": 0.2,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "zhena",
      "text": "Jemand im Gefängnis muss deinen Brief gelesen haben.",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "zhena",
      "text": "Gestern waren unzählige Polizisten hier. Sie haben den ganzen Acker umgegraben.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "zhena",
      "text": "Gefunden haben sie jedoch nichts.",
      "emotion": "sad",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    },
    {
      "id": "l9",
      "character": "muzhik",
      "text": "Bestens, jetzt kannst du die Kartoffeln setzen.",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
