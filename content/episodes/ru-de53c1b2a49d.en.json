  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Two customs officers are choosing a birthday present for a colleague.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "sluzhivy",
      "text": "How about a new Mercedes?",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "sluzhivy-ryadovoy",
      "text": "He's got one. We gave him that last year.",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "sluzhivy-ryadovoy",
      "text": "Then a beach house in the Canaries.",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "sluzhivy",
      "text": "He's got one of those too.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "sluzhivy",
      "text": "I've got it! We let him work a whole shift alone!",
      "emotion": "happy",
      "pauseAfterSec": 0.7,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "sluzhivy-ryadovoy",
      "text": "Are you out of your mind? That's way too expensive!",
      "emotion": "surprised",
      "pauseAfterSec": 0.8,
