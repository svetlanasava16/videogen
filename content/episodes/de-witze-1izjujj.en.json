    {
      "id": "l1",
      "character": "barmen",
      "text": "See that kid? Dumbest kid in town. Watch this.",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [
        "vovochka"
      ],
      "exit": []
    },
    {
      "id": "l2",
      "character": "barmen",
      "text": "Hey, Johnny. Five-dollar bill or two quarters. Pick one.",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "vovochka",
      "text": "The quarters, please.",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": [
        "vovochka"
      ]
    },
    {
      "id": "l4",
      "character": "barmen",
      "text": "What did I tell you? Every single time. He never learns.",
      "emotion": "smug",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "Later, the customer spots Johnny outside with an ice cream.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [
        "vovochka"
      ],
      "exit": []
    },
    {
      "id": "l6",
      "character": "muzhik",
      "text": "Hey, kid, why do you always take the quarters instead of the five?",
      "emotion": "surprised",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "vovochka",
      "text": "The day I take the five, the game is over.",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
