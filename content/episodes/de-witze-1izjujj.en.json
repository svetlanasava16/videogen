{
  "id": "de-witze-1izjujj.en",
  "jokeId": "de-witze-1izjujj",
  "locale": "en",
  "title": "The Dumbest Kid in Town",
  "kind": "joke",
  "v": 2,
  "location": "magazin",
  "place": "barbershop",
  "cast": [
    "vovochka",
    "barmen",
    "muzhik"
  ],
  "roles": {
    "vovochka": "vovochka",
    "muzhik": "customer",
    "barmen": "craftsman"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Little Johnny walks into a barbershop.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "barmen",
      "text": "That's the dumbest kid in town! Just a moment, I'll show you.",
      "emotion": "smug",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "He takes a five-dollar bill in one hand and two quarters in the other.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "barmen",
      "text": "Well, boy, pick a hand. Which one do you want?",
      "emotion": "happy",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "Johnny takes the two quarters and leaves.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l6",
      "character": "barmen",
      "text": "Now, what did I tell you? Every time, really every time!",
      "emotion": "smug",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l7",
      "character": "barmen",
      "text": "That brat will never, ever learn!",
      "emotion": "happy",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l8",
      "character": "narrator",
      "text": "A little later the customer leaves the shop and steps out into the street. There he sees Johnny sitting at the ice cream stand.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l9",
      "character": "muzhik",
      "text": "Hey, kid, can I ask you something?",
      "emotion": "surprised",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l9b",
      "character": "muzhik",
      "text": "Why do you take the two quarters and not the five-dollar bill?",
      "emotion": "surprised",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l10",
      "character": "vovochka",
      "text": "The day I take the bill, the game is over.",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
