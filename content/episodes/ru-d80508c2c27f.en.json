  },
  "lines": [
    {
      "id": "l1",
      "character": "muzhik",
      "text": "The psychiatrist shoves a sheet of paper with an inkblot at me.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "doktor",
      "text": "What do you see?",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "muzhik",
      "text": "A sad, lonely man, worn out by dealing with idiots,",
      "emotion": "sad",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l3b",
      "character": "muzhik",
      "text": "boring underpaid work and all the other injustices of life.",
      "emotion": "sad",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l4",
      "character": "doktor",
      "text": "And in the picture?..",
      "emotion": "sad",
      "pauseAfterSec": 0.6,
      "laugh": "chuckle"
    },
    {
      "id": "l5",
      "character": "muzhik",
      "text": "I felt like giving him a hug.",
      "emotion": "sad",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
