      "character": "muzhik",
      "text": "I've won a million pounds in the lottery!",
      "emotion": "happy",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "muzhik",
      "text": "First thing, I'm buying myself a nice one-bedroom flat.",
      "emotion": "smug",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "muzhik-sosed",
      "text": "Wow, congratulations! And what are you doing with the rest?",
      "emotion": "surprised",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l5",
      "character": "muzhik",
      "text": "The rest I'll probably have to finance.",
