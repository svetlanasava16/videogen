      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Im Flur fällt er hin, reißt die Garderobe um, es kracht fürchterlich, und alles stürzt herunter: Schüsseln, Skier, das Fahrrad...",
