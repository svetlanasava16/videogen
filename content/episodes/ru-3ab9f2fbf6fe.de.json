  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein betrunkener Ehemann kriecht um drei Uhr nachts nach Hause.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Im Flur fällt er hin, reißt die Garderobe um, es gibt ein furchtbares Getöse, und alles kracht herunter: Wannen, Skier, ein Fahrrad...",
      "emotion": "surprised",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "Entsetzt stürzen die Frau und die zwei Kinder aus dem Zimmer.",
      "emotion": "neutral",
      "pauseAfterSec": 0.6,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "Na, was ist, könnt ihr ohne Papi nicht schlafen?",
      "emotion": "happy",
      "pauseAfterSec": 0.8,
