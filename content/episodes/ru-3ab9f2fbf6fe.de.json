      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "Aus dem Zimmer rennen entsetzt die Frau und die zwei Kinder. Und er zu ihnen:",
