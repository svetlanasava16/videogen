  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Der Vater holt seinen Sohn von der Theatergruppe ab, der dieser erst kürzlich beigetreten ist.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "An diesem Tag sollte die Rollenverteilung für das nächste Stück verkündet werden.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "muzhik",
      "text": "Und, mein Sohn, hast du eine Rolle im nächsten Stück ergattert?",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "paren",
      "text": "Ja! Ich spiele einen Mann, der seit zwanzig Jahren verheiratet ist.",
      "emotion": "happy",
      "pauseAfterSec": 0.7,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "muzhik",
      "text": "Das ist schon mal ein guter Anfang. Mach weiter so, dann bekommst du vielleicht nächstes Mal sogar eine Sprechrolle.",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
