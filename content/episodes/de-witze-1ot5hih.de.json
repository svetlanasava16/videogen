{
  "id": "de-witze-1ot5hih.de",
  "jokeId": "de-witze-1ot5hih",
  "locale": "de",
  "title": "Die Beichte",
  "kind": "joke",
  "v": 2,
  "location": "tserkov",
  "place": "church",
  "cast": [
    "batyushka",
    "ded"
  ],
  "roles": {
    "batyushka": "priest",
    "ded": "old-man"
  },
  "lines": [
    {
      "id": "l1",
      "character": "ded",
      "text": "Vergib mir Vater, ich habe gesündigt.",
      "emotion": "sad",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "batyushka",
      "text": "Was hast du getan, mein Sohn?",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "ded",
      "text": "Im Zweiten Weltkrieg habe ich einen Juden auf meinem Dachboden versteckt.",
      "emotion": "sad",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "batyushka",
      "text": "Aber das ist doch keine Sünde.",
      "emotion": "surprised",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "ded",
      "text": "Ich sagte zu ihm, dass er für zwanzig Gulden die Woche so lange bleiben kann, wie er will.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l6",
      "character": "batyushka",
      "text": "Da hast du doch etwas Gutes getan.",
      "emotion": "happy",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l7",
      "character": "ded",
      "text": "Danke, das erleichtert mich sehr. Eine Frage hätte ich aber noch.",
      "emotion": "happy",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l8",
      "character": "batyushka",
      "text": "Ja, mein Sohn?",
      "emotion": "neutral",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l9",
      "character": "ded",
      "text": "Soll ich ihm sagen, dass der Krieg vorbei ist?",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
