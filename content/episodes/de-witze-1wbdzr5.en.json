  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "In the middle of the night, a plumber is called to the doctor's house: a water pipe has burst, and the cellar is flooded.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "So the plumber drives over and goes down into the cellar, which really is already half full of water.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "He looks left, he looks right, then throws three gaskets into the water and says to the doctor:",
      "emotion": "neutral",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l4",
      "character": "barmen",
      "text": "If it's not better by morning, call me again.",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
  "explicit": false,
