    {
      "id": "l1",
      "character": "narrator",
      "text": "In the middle of the night, a pipe bursts at the doctor's house. The basement is half full of water.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "barmen",
      "text": "So, what seems to be the trouble?",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [
        "barmen"
      ],
      "exit": []
    },
    {
      "id": "l3",
      "character": "doktor",
      "text": "Can't you see? The whole basement is flooded!",
      "emotion": "angry",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "narrator",
      "text": "The plumber looks left, looks right, and tosses three washers into the water.",
      "emotion": "neutral",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "barmen",
      "text": "If it's no better by morning, call me again.",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
