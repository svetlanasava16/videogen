  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein Typ kommt zu einem Mädchen nach Hause. Er läuft herum und sieht sich die Wohnung an.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Plötzlich sieht er neben dem Sofa eine schöne, teure chinesische Vase. Er schaut hinein, sieht etwas, steckt die Hand hinein und fragt:",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "paren",
      "text": "Oh, was ist denn das hier?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "devushka",
      "text": "Ach, das! Das ist die Asche von meinem Opa...",
      "emotion": "neutral",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "Der Typ zieht erschrocken die Hand heraus.",
      "emotion": "surprised",
      "pauseAfterSec": 0.6,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "devushka",
      "text": "...er ist nämlich zu faul, für einen Aschenbecher in die Küche zu gehen!",
      "emotion": "angry",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
