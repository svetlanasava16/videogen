  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein alter Mann liegt im Sterben, seine Frau sitzt an seinem Bett.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "ded",
      "text": "Gabi, seit unserer Hochzeit waren wir nie getrennt.",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "ded",
      "text": "Als ich meine Arbeit verlor, warst du bei mir.",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "ded",
      "text": "Als meine Eltern starben, warst du an meiner Seite.",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "ded",
      "text": "Als ich mich beim Skifahren schwer verletzt habe, warst du neben mir.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "ded",
      "text": "Als die Inflation mein ganzes Vermögen gefressen hat, bist du geblieben.",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "ded",
      "text": "Und jetzt bin ich todkrank, und du bist immer noch hier.",
      "emotion": "surprised",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "ded",
      "text": "Gabi, du hast mir immer nur Unglück gebracht!",
      "emotion": "angry",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    }
  ],
