  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein alter, sehr kranker Mann liegt im Sterben und sagt zu seiner Frau:",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "ded",
      "text": "Elfriede, seit dem Tage unserer Hochzeit waren wir nie getrennt.",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "ded",
      "text": "Als ich meine Arbeit verlor, warst du bei mir.",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "ded",
      "text": "Als meine Eltern starben, warst du an meiner Seite.",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "ded",
      "text": "Als ich mich damals im Ski-Urlaub schwer verletzt habe, warst du neben mir.",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "ded",
      "text": "Als mein Vermögen der Inflation zum Opfer fiel und ich nichts mehr hatte, selbst zu der Zeit warst du da und bist geblieben.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "ded",
      "text": "Jetzt bin ich sterbenskrank und du bist immer noch hier.",
      "emotion": "surprised",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "ded",
      "text": "Elfriede, du hast mir immer nur Unglück gebracht!",
      "emotion": "angry",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
