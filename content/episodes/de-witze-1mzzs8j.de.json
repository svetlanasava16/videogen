{
  "id": "de-witze-1mzzs8j.de",
  "jokeId": "de-witze-1mzzs8j",
  "locale": "de",
  "title": "Frischer Fall",
  "kind": "joke",
  "v": 2,
  "location": "nebesa",
  "place": "heaven",
  "cast": [
    "muzhik",
    "ded"
  ],
  "roles": {
    "muzhik": "everyman",
    "ded": "saint-peter"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein Mann stirbt und findet sich am Himmelstor wieder, wo ihn der heilige Petrus erwartet.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "ded",
      "text": "Nun, mein Sohn! Du warst in deinem Leben nicht gerade ein guter Mensch.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "ded",
      "text": "Kannst du mir eine gute Tat nennen, auf deren Grundlage ich dich hier hineinlassen kann?",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "Ja. Einmal haben ein paar Motorradfahrer einige Nonnen belästigt.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "muzhik",
      "text": "Da bin ich zu ihrem Anführer gegangen, ein großer, tätowierter Kerl mit Nasenring,",
      "emotion": "smug",
      "pauseAfterSec": 0.2
    },
    {
      "id": "l6",
      "character": "muzhik",
      "text": "habe ihn am Ring gepackt, ihm eine Ohrfeige verpasst und gesagt: Und jetzt entschuldigst du dich bei den Damen!",
      "emotion": "smug",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l7",
      "character": "narrator",
      "text": "Der heilige Petrus blättert in seinem Buch.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l8",
      "character": "ded",
      "text": "So etwas finde ich hier nicht! Sag mir, wann ist das passiert?",
      "emotion": "surprised",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l9",
      "character": "muzhik",
      "text": "Vor ungefähr ein bis zwei Minuten.",
      "emotion": "sad",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
