  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein Mann stirbt und steht vor dem Himmelstor.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [
        "muzhik"
      ],
      "exit": []
    },
    {
      "id": "l2",
      "character": "ded",
      "text": "Nun, mein Sohn. Ein guter Mensch warst du nicht gerade. Nenn mir eine gute Tat.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "muzhik",
      "text": "Einmal haben Rocker ein paar Nonnen belästigt.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "Ich bin zu ihrem Anführer. Ein Riese mit Tattoos und Nasenring. Hab ihn am Ring gepackt, ihm eine geknallt und gesagt: Entschuldige dich bei den Damen!",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "ded",
      "text": "Davon steht nichts in meinem Buch. Wann war das?",
      "emotion": "surprised",
      "pauseAfterSec": 0.7,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "muzhik",
      "text": "So vor ein, zwei Minuten.",
      "emotion": "sad",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    }
  ],
