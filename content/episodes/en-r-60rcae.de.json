      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "zhena",
      "text": "Doch. Ich will in Frieden sterben. Ich habe mit deinem Bruder geschlafen, mit deinem besten Freund, mit dessen bestem Freund und mit deinem Vater.",
      "emotion": "sad",
      "pauseAfterSec": 0.8,
