  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Meine Frau lag im Sterben. Ich saß an ihrem Bett.",
      "emotion": "sad",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "zhena",
      "text": "Ich muss dir etwas gestehen.",
      "emotion": "sad",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "muzhik",
      "text": "Pssst. Es gibt nichts zu gestehen. Alles ist gut.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "zhena",
      "text": "Nein, ich muss in Frieden sterben.",
      "emotion": "sad",
      "pauseAfterSec": 0.2
    },
    {
      "id": "l5",
      "character": "zhena",
      "text": "Ich hatte Sex mit deinem Bruder, deinem besten Freund,",
      "emotion": "sad",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l5b",
      "character": "zhena",
      "text": "seinem besten Freund und deinem Vater.",
      "emotion": "sad",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l6",
      "character": "muzhik",
      "text": "Ich weiß. Deshalb habe ich dich vergiftet.",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
