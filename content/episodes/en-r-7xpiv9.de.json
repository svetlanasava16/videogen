  "lines": [
    {
      "id": "l1",
      "character": "doktor",
      "text": "Ihre Werte sind bestens. Und wie stehen Sie mit Gott?",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "ded",
      "text": "Gott und ich sind dicke Freunde. Er weiß, dass ich schlecht sehe.",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "ded",
      "text": "Wenn ich nachts aufs Klo muss, puff, geht das Licht an.",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "ded",
      "text": "Bin ich fertig, puff, geht es wieder aus.",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": [
        "ded"
      ]
    },
    {
      "id": "l5",
      "character": "doktor",
      "text": "Unglaublich.",
      "emotion": "surprised",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "doktor",
      "text": "Hallo, hier ist der Doktor. Ihrem Mann geht es gut.",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [
        "tyoshcha"
      ],
      "exit": []
    },
    {
      "id": "l7",
      "character": "doktor",
      "text": "Aber stimmt es, dass bei ihm nachts das Licht im Bad von selbst angeht?",
      "emotion": "surprised",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "tyoshcha",
      "text": "Ach du lieber Gott! Er pinkelt schon wieder in den Kühlschrank!",
      "emotion": "angry",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    }
  ],
