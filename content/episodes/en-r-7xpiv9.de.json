{
  "id": "en-r-7xpiv9.de",
  "jokeId": "en-r-7xpiv9",
  "locale": "de",
  "title": "Puff, das Licht geht an",
  "kind": "joke",
  "v": 2,
  "location": "bolnitsa",
  "place": "doctor-office",
  "cast": [
    "ded",
    "doktor",
    "tyoshcha"
  ],
  "roles": {
    "doktor": "doctor",
    "tyoshcha": "old-woman",
    "ded": "old-man"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein neunzigjähriger Mann geht zur Vorsorgeuntersuchung, und alle seine Werte sind normal.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "doktor",
      "text": "Larry, alles sieht großartig aus.",
      "emotion": "happy",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "doktor",
      "text": "Wie geht es Ihnen seelisch und emotional? Sind Sie im Reinen mit Gott?",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "ded",
      "text": "Gott und ich sind dicke Freunde.",
      "emotion": "smug",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "ded",
      "text": "Er weiß, dass ich schlecht sehe, also hat er es so eingerichtet,",
      "emotion": "happy",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l5c",
      "character": "ded",
      "text": "dass, wenn ich mitten in der Nacht aufstehe, um ins Bad zu gehen, puff!",
      "emotion": "happy",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l5b",
      "character": "ded",
      "text": "Das Licht geht an.",
      "emotion": "happy",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l6",
      "character": "ded",
      "text": "Wenn ich fertig bin, puff! Das Licht geht aus.",
      "emotion": "happy",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l7",
      "character": "doktor",
      "text": "Wow, das ist unglaublich.",
      "emotion": "surprised",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l8",
      "character": "narrator",
      "text": "Etwas später am Tag ruft der Arzt Larrys Frau an.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l9",
      "character": "doktor",
      "text": "Bonnie, Larry geht es gut!",
      "emotion": "happy",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l10",
      "character": "doktor",
      "text": "Aber ich musste Sie anrufen,",
      "emotion": "happy",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l10b",
      "character": "doktor",
      "text": "weil ich so beeindruckt von seiner Beziehung zu Gott bin.",
      "emotion": "happy",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l11",
      "character": "doktor",
      "text": "Stimmt es, dass er nachts aufsteht, und puff, im Bad geht das Licht an,",
      "emotion": "surprised",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l11b",
      "character": "doktor",
      "text": "und wenn er fertig ist, puff, geht das Licht aus?",
      "emotion": "surprised",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l12",
      "character": "tyoshcha",
      "text": "Ach du lieber Jesus!",
      "emotion": "surprised",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l13",
      "character": "tyoshcha",
      "text": "Er pinkelt schon wieder in den Kühlschrank!",
      "emotion": "angry",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
