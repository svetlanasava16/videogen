{
  "id": "ru-a26828014741.en",
  "jokeId": "ru-a26828014741",
  "locale": "en",
  "title": "The Hearse",
  "kind": "joke",
  "v": 2,
  "location": "doroga",
  "place": "car",
  "cast": [
    "muzhik-ryzhy",
    "muzhik"
  ],
  "roles": {
    "muzhik-ryzhy": "driver",
    "muzhik": "customer"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "A taxi passenger wanted to ask the driver a question and tapped him on the shoulder. The driver screamed wildly and lost control.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "The taxi nearly hit a bus, flew up onto the sidewalk and stopped an inch from a shop window.",
      "emotion": "surprised",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "For a second there was silence in the cab, and then the driver said hoarsely:",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "muzhik-ryzhy",
      "text": "Listen, pal, don't ever do that again. I nearly crapped myself...",
      "emotion": "angry",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l5",
      "character": "muzhik",
      "text": "Sorry. I never imagined a light tap on the shoulder could scare you like that.",
      "emotion": "sad",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l6",
      "character": "muzhik-ryzhy",
      "text": "Actually, it's not really your fault... It's just my first day driving a taxi.",
      "emotion": "neutral",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l7",
      "character": "muzhik-ryzhy",
      "text": "Before that, I drove a hearse for twenty-five years!",
      "emotion": "sad",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
  "explicit": false,
