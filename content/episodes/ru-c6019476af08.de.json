  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Die Kinder haben sich mit ihrer Lehrerin fotografieren lassen. Jetzt will die Lehrerin, dass jedes Kind ein Foto kauft.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "uchilka",
      "text": "Stellt euch vor, wie schön das ist: Wenn ihr erwachsen seid, schaut ihr euch das Foto an und sagt:",
      "emotion": "happy",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "uchilka",
      "text": "Das ist die kleine Lena, die ist jetzt Schauspielerin. Und das ist Peter, der ist jetzt Arzt...",
      "emotion": "happy",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l4",
      "character": "vovochka",
      "text": "Und das ist Frau Müller, die ist schon lange tot...",
      "emotion": "sad",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
