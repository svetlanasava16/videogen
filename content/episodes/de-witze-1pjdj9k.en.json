  "locale": "en",
  "title": "Interview with Farmer Hubert",
  "kind": "joke",
  "v": 2,
  "location": "derevnya",
  "place": "farm",
  "cast": [
    "paren",
    "muzhik-ryzhy",
    "korova",
    "korova-chyornaya"
  ],
  "roles": {
    "paren": "journalist",
    "muzhik-ryzhy": "farmer",
    "korova": "cow",
    "korova-chyornaya": "cow"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Farmer Hubert is being interviewed for the local TV news. Fittingly, they're talking right by the cow pasture.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l2",
      "character": "paren",
      "text": "Tell me, Farmer, how many gallons of milk does a cow like that give a day?",
      "emotion": "happy",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "muzhik-ryzhy",
      "text": "The brown cow or the black cow?",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "paren",
      "text": "The brown one.",
      "emotion": "neutral",
      "pauseAfterSec": 0.2
    },
    {
      "id": "l5",
      "character": "muzhik-ryzhy",
      "text": "Just under eight gallons.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l6",
      "character": "paren",
      "text": "And the black one?",
      "emotion": "neutral",
      "pauseAfterSec": 0.2
    },
    {
      "id": "l7",
      "character": "muzhik-ryzhy",
      "text": "That one too.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l8",
      "character": "paren",
      "text": "And what do they eat all day?",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l9",
      "character": "muzhik-ryzhy",
      "text": "The brown one or the black one?",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l10",
      "character": "paren",
      "text": "The black one.",
      "emotion": "sad",
      "pauseAfterSec": 0.2
    },
    {
      "id": "l11",
      "character": "muzhik-ryzhy",
      "text": "Grass.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l12",
      "character": "paren",
      "text": "And the brown one?",
      "emotion": "sad",
      "pauseAfterSec": 0.2
    },
    {
      "id": "l13",
      "character": "muzhik-ryzhy",
      "text": "That one too.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l14",
      "character": "paren",
      "text": "But if it's always the same for both of them, why do you keep asking whether I mean the brown one or the black one?",
      "emotion": "angry",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l15",
      "character": "muzhik-ryzhy",
      "text": "Well, because the brown cow is mine.",
      "emotion": "smug",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l16",
      "character": "paren",
      "text": "And the black one?",
      "emotion": "surprised",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l17",
      "character": "muzhik-ryzhy",
      "text": "That one too.",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
