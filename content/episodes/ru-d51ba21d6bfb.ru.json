{
  "id": "ru-d51ba21d6bfb.ru",
  "jokeId": "ru-d51ba21d6bfb",
  "locale": "ru",
  "title": "Стихи",
  "location": "doroga",
  "place": "road",
  "cast": [
    "sluzhivy",
    "nachalnik"
  ],
  "roles": {
    "sluzhivy": "traffic-cop",
    "nachalnik": "new-russian"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Инспектор ДПС останавливает Бентли. Превышение скорости трёхкратное.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Приоткрывается наглухо тонированное стекло.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "sluzhivy",
      "text": "Инспектор Петров, ваши документы.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "narrator",
      "text": "Из Бентли высовывается рука с пятитысячной купюрой. Инспектор прячет её в нагрудный карман.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "sluzhivy",
      "text": "Всего хорошего, постарайтесь больше не нарушать...",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "Из окна появляется следующая купюра того же достоинства.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "sluzhivy",
      "text": "И будьте внимательны, через два квартала ещё один экипаж...",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "narrator",
      "text": "Снова пятитысячная.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l9",
      "character": "sluzhivy",
      "text": "Я здесь работаю вторник, четверг, с восьми утра и до пятнадцати ноль-ноль.",
      "emotion": "smug",
      "pauseAfterSec": 0.2,
      "enter": [],
      "exit": []
    },
    {
      "id": "l10",
      "character": "sluzhivy",
      "text": "Я ваш номер запомнил, в эти дни можете ездить спокойно...",
      "emotion": "smug",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": [],
      "laugh": "chuckle"
    },
    {
      "id": "l11",
      "character": "narrator",
      "text": "Снова купюра в пять тысяч.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l12",
      "character": "sluzhivy",
      "text": "Счастья, здоровья вам, умных детей, успехов в бизнесе, чтоб собака на конкурсах побеждала...",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l13",
      "character": "narrator",
      "text": "Снова рука с купюрой. Инспектор некоторое время стоит в замешательстве, затем прокашливается...",
      "emotion": "neutral",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    },
    {
      "id": "l14",
      "character": "sluzhivy",
      "text": "Стихи!",
      "emotion": "happy",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
