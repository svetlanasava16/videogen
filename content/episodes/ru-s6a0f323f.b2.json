  "lines": [
    {
      "id": "l1",
      "character": "muzhik-sosed",
      "text": "Даша, тебя не узнать! Откуда такая красота?",
      "emotion": "surprised",
      "pauseAfterSec": 0
    },
    {
      "id": "l2",
      "character": "devushka",
      "text": "Повезло вчера, Коля. Еду в деревню, пусть посмотрят, как в городе одеваются.",
      "emotion": "smug",
      "pauseAfterSec": 0
    },
    {
      "id": "l3",
      "character": "muzhik-sosed",
      "text": "Ты бы лучше замуж вышла, вот что я тебе скажу.",
      "emotion": "neutral",
      "pauseAfterSec": 0
    },
    {
      "id": "l4",
      "character": "devushka",
      "text": "Вот и мой автобус. Пока, Коля!",
      "emotion": "happy",
      "pauseAfterSec": 0.8
    }
  ],
