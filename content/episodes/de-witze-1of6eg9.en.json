  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "A Catholic priest, a Protestant pastor and a Jewish rabbi are discussing when life begins.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "batyushka",
      "text": "Life begins at conception!",
      "emotion": "angry",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "batyushka-molodoy",
      "text": "Nonsense, life begins at birth!",
      "emotion": "angry",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l4",
      "character": "batyushka-ravvin",
      "text": "Dear colleagues, you have no idea.",
      "emotion": "smug",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l5",
      "character": "batyushka-ravvin",
      "text": "Life begins when the kids move out.",
      "emotion": "happy",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
