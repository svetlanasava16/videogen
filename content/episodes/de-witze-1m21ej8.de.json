  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein Mann geht ans Telefon. Es meldet sich sein Arzt.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "doktor",
      "text": "Herr Meier, es tut mir leid, aber ich habe zwei schlechte Nachrichten für Sie.",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "doktor",
      "text": "Erstens: Nach den letzten Untersuchungsergebnissen gibt es keine Chance mehr auf Heilung.",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "doktor",
      "text": "Sie werden innerhalb von drei Tagen sterben.",
      "emotion": "sad",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "doktor",
      "text": "Zweitens: Ich versuche Sie bereits seit vorgestern zu erreichen.",
      "emotion": "neutral",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
