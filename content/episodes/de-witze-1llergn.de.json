  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Nächtlicher Anruf beim Chef einer Spedition. Einer seiner Fahrer meldet sich.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "muzhik-ryzhy",
      "text": "Chef, sorry, dass ich Sie wecke, aber ich hatte einen Unfall und kann die Lieferung nicht machen.",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "nachalnik",
      "text": "Um Himmels willen, sind Sie in Ordnung?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "muzhik-ryzhy",
      "text": "Ja, alles gut, aber ich kann nicht weiter, der Rückspiegel auf der Beifahrerseite ist kaputt.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "nachalnik",
      "text": "Was soll der Blödsinn, damit können Sie doch locker weiterfahren!",
      "emotion": "angry",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "muzhik-ryzhy",
      "text": "Nee, geht nicht.",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "nachalnik",
      "text": "Sind Sie bekloppt? Wegen dem Rückspiegel?",
      "emotion": "angry",
      "pauseAfterSec": 0.6,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "muzhik-ryzhy",
      "text": "Na ja, der LKW liegt drauf.",
      "emotion": "neutral",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
