  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "A hot day, a steep hill. A worn-out cyclist stops on a bridge next to a fisherman.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "muzhik",
      "text": "So, fishing, are we?",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [
        "muzhik"
      ],
      "exit": []
    },
    {
      "id": "l3",
      "character": "muzhik",
      "text": "I said, fishing, are we?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "What, are you deaf? I asked if we're fishing!",
      "emotion": "angry",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": [
        "muzhik"
      ]
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "He spits and pedals on uphill, dripping with sweat. Two miles later he looks back, and the fisherman is waving like mad for him to come back.",
      "emotion": "neutral",
      "pauseAfterSec": 0.7,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "muzhik-ryzhy",
      "text": "So, cycling, are we?",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
