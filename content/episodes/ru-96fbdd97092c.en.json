  "locale": "en",
  "title": "He's Moving!",
  "kind": "joke",
  "v": 2,
  "location": "nebesa",
  "place": "heaven",
  "cast": [
    "ded",
    "muzhik",
    "muzhik-sosed",
    "muzhik-ryzhy"
