  "roles": {
    "ded": "saint-peter",
    "muzhik": "everyman",
    "muzhik-sosed": "everyman",
    "muzhik-ryzhy": "everyman"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Three friends die in a car crash. Naturally, they end up straight at an interview with Saint Peter.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Peter sees that the guys are really down, crushed, and to cheer them up a little, he says:",
      "emotion": "neutral",
      "pauseAfterSec": 0.2
    },
    {
      "id": "l3",
      "character": "ded",
      "text": "Now picture this: your funeral is underway, you're lying in the coffin,",
      "emotion": "happy",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l3b",
      "character": "ded",
      "text": "all dressed up and solemn, with your families and friends around you.",
      "emotion": "happy",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "ded",
      "text": "What would you like them to say about you?",
      "emotion": "happy",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l5",
      "character": "muzhik",
      "text": "Well, it would be nice if they said I was a wonderful family man,",
      "emotion": "sad",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l5b",
      "character": "muzhik",
      "text": "a good doctor, that I saved lots of people and left my mark on medicine.",
      "emotion": "sad",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l6",
      "character": "muzhik-sosed",
      "text": "I'd like someone to say what a wonderful teacher I was,",
      "emotion": "sad",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l6b",
      "character": "muzhik-sosed",
      "text": "that I left my mark on the souls of the younger generation,",
      "emotion": "sad",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l6c",
      "character": "muzhik-sosed",
      "text": "sowing what is wise, good and eternal.",
      "emotion": "sad",
      "pauseAfterSec": 0.2
    },
    {
      "id": "l7",
      "character": "muzhik-sosed",
      "text": "And that I was a good father and husband.",
      "emotion": "sad",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l8",
      "character": "muzhik-ryzhy",
      "text": "And I'd like everyone to suddenly shout at once: \"Look, he's moving!\"",
      "emotion": "happy",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
  "explicit": false,
