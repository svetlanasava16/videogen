  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Пожилой мужчина впервые за тридцать лет пришёл на исповедь.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "ded",
      "text": "Ничего себе! Мини-бар, дорогие конфеты, кожаный диванчик!",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "batyushka",
      "text": "Здравствуй, сын мой.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [
        "batyushka"
      ],
      "exit": []
    },
    {
      "id": "l4",
      "character": "ded",
      "text": "Святой отец, как у вас тут всё модно стало! Прямо заходить приятно!",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "batyushka",
      "text": "Выйдите, пожалуйста, сын мой.",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "ded",
      "text": "Почему? Я что-то не так сделал?",
      "emotion": "surprised",
      "pauseAfterSec": 0.6,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "batyushka",
      "text": "Да. Вы сидите на месте священника.",
      "emotion": "neutral",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    }
  ],
