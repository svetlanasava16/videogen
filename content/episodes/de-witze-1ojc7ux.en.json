{
  "id": "de-witze-1ojc7ux.en",
  "jokeId": "de-witze-1ojc7ux",
  "locale": "en",
  "title": "City vs. Country",
  "location": "derevnya",
  "place": "farm",
  "cast": [
    "muzhik",
    "ptitsa",
    "muzhik-ryzhy"
  ],
  "roles": {
    "muzhik": "hunter",
    "ptitsa": "duck",
    "muzhik-ryzhy": "farmer"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "A city man goes out to the country to hunt ducks. When he sees the first duck, he aims and shoots.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "The duck he hit falls from the sky and lands on a farm. The farmer won't hand it over.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "muzhik",
      "text": "That duck is my game now!",
      "emotion": "angry",
      "pauseAfterSec": 0.3,
      "enter": [
        "muzhik"
      ],
      "exit": []
    },
    {
      "id": "l4",
      "character": "muzhik-ryzhy",
      "text": "Let's settle it the way things are done in the country.",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "muzhik-ryzhy",
      "text": "Here's how we'll do it: we take turns kicking each other in the groin.",
      "emotion": "smug",
      "pauseAfterSec": 0.2,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "muzhik-ryzhy",
      "text": "Whoever screams the least gets the duck.",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "narrator",
      "text": "The city man thinks it over for a moment and agrees.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "narrator",
      "text": "The farmer winds up and lands a nasty kick right in the city man's privates. The man drops to the ground, rolling and groaning in pain.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l9",
      "character": "narrator",
      "text": "A quarter of an hour later the city man is back on his feet.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l10",
      "character": "muzhik",
      "text": "Get ready, now it's my turn.",
      "emotion": "angry",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    },
    {
      "id": "l11",
      "character": "muzhik-ryzhy",
      "text": "Nah. Just take the duck.",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [
        "muzhik-ryzhy"
      ],
      "laugh": "big"
    }
  ],
  "explicit": false,
  "outroLaughs": [],
