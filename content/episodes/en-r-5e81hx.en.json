  "locale": "en",
  "title": "The Last Bowl",
  "kind": "joke",
  "v": 2,
  "location": "bar",
  "place": "restaurant",
  "cast": [
    "muzhik",
    "muzhik-ryzhy",
    "devushka"
  ],
  "roles": {
    "muzhik": "everyman",
    "muzhik-ryzhy": "customer",
    "devushka": "waiter"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "A guy sits down in a diner.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "muzhik",
      "text": "A bowl of hot chili, please.",
      "emotion": "happy",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "devushka",
      "text": "Sorry, but the guy next to you got the last bowl.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "narrator",
      "text": "He looks over and sees that the guy's finished his meal, but the bowl of chili is still full.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "muzhik",
      "text": "Are you going to eat that chili?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l6",
      "character": "muzhik-ryzhy",
      "text": "No. Help yourself.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l7",
      "character": "narrator",
      "text": "He slides the bowl of chili over and starts to eat.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l8",
      "character": "narrator",
      "text": "When he gets about halfway down, his spoon hits something.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l9",
      "character": "narrator",
      "text": "He looks down, sees a dead mouse and immediately pukes all the chili back into the bowl.",
      "emotion": "surprised",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l10",
      "character": "muzhik-ryzhy",
      "text": "Yeah, that's about as far as I got, too.",
      "emotion": "sad",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
  "explicit": false,
