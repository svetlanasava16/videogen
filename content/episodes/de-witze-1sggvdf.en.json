  "locale": "en",
  "title": "Duck Hunt",
  "location": "derevnya",
  "place": "farm",
  "cast": [
    "muzhik-ryzhy",
    "ptitsa",
    "muzhik-sosed"
  ],
  "roles": {
    "muzhik-ryzhy": "hunter",
    "ptitsa": "duck",
