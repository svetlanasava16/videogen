{
  "id": "ru-c20746e7cca4.de",
  "jokeId": "ru-c20746e7cca4",
  "locale": "de",
  "title": "Der Spatz",
  "kind": "joke",
  "v": 2,
  "location": "doroga",
  "place": "home-living-room",
  "cast": [
    "muzhik-ryzhy",
    "ptitsa"
  ],
  "roles": {
    "muzhik-ryzhy": "biker",
    "ptitsa": "bird"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein Motorradfahrer rast mit hoher Geschwindigkeit dahin und sieht plötzlich, wie ihm etwas direkt entgegenfliegt… ein Spatz!",
      "emotion": "surprised",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Er tritt auf die Bremse, versucht mit aller Kraft auszuweichen, streift den Spatz aber doch mit dem Helm. Der Spatz fliegt zur Seite und fällt herunter.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "Dem Motorradfahrer tut der arme Vogel leid. Mit Mühe findet er den Spatz am Boden und nimmt ihn mit.",
      "emotion": "sad",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "narrator",
      "text": "Er bringt ihn nach Hause, setzt ihn in einen Käfig, stellt ihm ein Schälchen Wasser hin, streut Brotkrümel und geht schlafen.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "Am Morgen kommt der Spatz zu sich, schaut sich um und sagt zu sich selbst.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l6",
      "character": "ptitsa",
      "text": "Wo bin ich?..",
      "offscreen": true,
      "emotion": "surprised",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l7",
      "character": "ptitsa",
      "text": "Soso… Gitter… ein Napf mit Wasser… Brot…",
      "offscreen": true,
      "emotion": "neutral",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l8",
      "character": "ptitsa",
      "text": "Wie schrecklich! Ich habe den Motorradfahrer umgebracht!",
      "offscreen": true,
      "emotion": "surprised",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
  "explicit": false,
