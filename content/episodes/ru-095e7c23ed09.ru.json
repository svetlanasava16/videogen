  "lines": [
    {
      "id": "l1",
      "character": "paren",
      "text": "Здравствуйте, профессор! Можно вас спросить?",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [
        "paren"
      ],
      "exit": []
    },
    {
      "id": "l2",
      "character": "doktor",
      "text": "Конечно, молодой человек.",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "paren",
      "text": "Когда вы ложитесь спать, бороду кладёте на одеяло или под одеяло?",
      "emotion": "neutral",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "doktor",
      "text": "Хм. Знаете, как-то не задумывался.",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "paren",
      "text": "Извините, пожалуйста.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": [
        "paren"
      ]
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "Через неделю. Профессор зелёный, с кругами под глазами.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [
        "paren"
      ],
      "exit": []
    },
    {
      "id": "l7",
      "character": "doktor",
      "text": "Ну ты и сволочь!",
      "emotion": "angry",
      "pauseAfterSec": 0.6,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "doktor",
      "text": "Неделю спать не могу! И так неудобно, и так неудобно!",
      "emotion": "angry",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    }
  ],
