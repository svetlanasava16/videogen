{
  "id": "ru-095e7c23ed09.ru",
  "jokeId": "ru-095e7c23ed09",
  "locale": "ru",
  "title": "Борода",
  "location": "klass",
  "place": "university",
  "cast": [
    "paren",
    "doktor"
  ],
  "roles": {
    "paren": "student",
    "doktor": "professor"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "По коридору ВУЗа идет профессор.",
      "emotion": "neutral",
      "pauseAfterSec": 0,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Навстречу студент:",
      "emotion": "neutral",
      "pauseAfterSec": 0,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "paren",
      "text": "Здравствуйте, профессор. Можно Вас спросить?",
      "emotion": "happy",
      "pauseAfterSec": 0,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "doktor",
      "text": "Конечно, спрашивайте, молодой человек.",
      "emotion": "smug",
      "pauseAfterSec": 0,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "paren",
      "text": "Скажите, профессор, Вы когда спать ложитесь, бороду на одеяло или под одеяло кладете?",
      "emotion": "neutral",
      "pauseAfterSec": 0,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "После некоторой паузы:",
      "emotion": "neutral",
      "pauseAfterSec": 0,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "doktor",
      "text": "Да, знаете, как-то не задумывался.",
      "emotion": "surprised",
      "pauseAfterSec": 0,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "paren",
      "text": "Ну, извините, пожалуйста.",
      "emotion": "neutral",
      "pauseAfterSec": 0,
      "enter": [],
      "exit": []
    },
    {
      "id": "l9",
      "character": "narrator",
      "text": "Разошлись.",
      "emotion": "neutral",
      "pauseAfterSec": 0,
      "enter": [],
      "exit": []
    },
    {
      "id": "l10",
      "character": "narrator",
      "text": "Через неделю зеленый профессор с кругами под глазами",
      "emotion": "neutral",
      "pauseAfterSec": 0,
      "enter": [],
      "exit": []
    },
    {
      "id": "l11",
      "character": "narrator",
      "text": "встречает в коридоре того же студента и хватает за грудки:",
      "emotion": "neutral",
      "pauseAfterSec": 0,
      "enter": [],
      "exit": []
    },
    {
      "id": "l12",
      "character": "doktor",
      "text": "Ну ты и сволочь!",
      "emotion": "angry",
      "pauseAfterSec": 0,
      "enter": [],
      "exit": []
    },
    {
      "id": "l13",
      "character": "doktor",
      "text": "Неделю уже спать не могу — и так неудобно, и так неудобно!",
      "emotion": "angry",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
