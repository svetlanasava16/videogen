  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "They meet at her place.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "paren",
      "text": "Tell me something I don't know about you yet.",
      "emotion": "happy",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "devushka",
      "text": "Well, I'm thirty, and I have the body of an eighteen-year-old.",
      "emotion": "smug",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "paren",
      "text": "Prove it!",
      "emotion": "happy",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l5",
      "character": "devushka",
      "text": "Not now. I keep it in the chest freezer in the garage, and right now it's too dark and too cold to go out there.",
      "emotion": "neutral",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
