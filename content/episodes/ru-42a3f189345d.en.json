{
  "id": "ru-42a3f189345d.en",
  "jokeId": "ru-42a3f189345d",
  "locale": "en",
  "title": "The Bridge",
  "kind": "joke",
  "v": 2,
  "location": "derevnya",
  "place": "river-lake",
  "cast": [
    "ded",
    "nachalnik"
  ],
  "roles": {
    "ded": "old-man",
    "nachalnik": "businessman"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Russia. A river flows by, and on its bank stands a village.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "An old man sits there, watching.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "A tractor comes down the road, brakes before the bridge, turns right, fords the river, turns left onto the road and drives on.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "narrator",
      "text": "A truck comes along, brakes before the bridge, turns right, fords the river, turns left onto the road and drives on.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "A little Lada comes down the road, brakes before the bridge, turns right, fords the river, turns left onto the road and drives on.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "A Mercedes comes racing down the road, doesn't slow down, flies onto the bridge,",
      "emotion": "surprised",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l6b",
      "character": "narrator",
      "text": "the bridge collapses with a crash, and the Mercedes falls into the river.",
      "emotion": "surprised",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l7",
      "character": "ded",
      "text": "Look at that, the place is crawling with idiots. Racing around.",
      "emotion": "angry",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l8",
      "character": "ded",
      "text": "Don't even notice the bridge.",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
