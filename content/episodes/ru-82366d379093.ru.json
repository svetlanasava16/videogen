      "character": "narrator",
      "text": "потом достает ее же, поворачивает,",
      "emotion": "neutral",
      "audio": {
        "file": "audio/voice/ru-82366d379093.ru/l9.mp3",
        "durationSec": 1.907,
        "words": [
