  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Мясная лавка, минута до закрытия.",
      "emotion": "neutral",
      "audio": {
        "file": "audio/voice/ru-82366d379093.ru/l1.mp3",
        "durationSec": 1.907,
        "words": [
          {
            "text": "Мясная",
            "start": 0,
            "end": 0.395
          },
          {
            "text": "лавка,",
            "start": 0.464,
            "end": 0.789
          },
          {
            "text": "минута",
            "start": 0.813,
            "end": 1.115
          },
          {
            "text": "до",
            "start": 1.161,
            "end": 1.231
          },
          {
            "text": "закрытия.",
            "start": 1.265,
            "end": 1.858
          }
        ],
        "provider": "elevenlabs",
        "voiceId": "ogi2DyUAKJb7CEdqqvlU",
        "model": "eleven_multilingual_v2",
        "textHash": "00e77c3b"
      },
      "pauseAfterSec": 0
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Вбегает запыхавшаяся женщина и говорит:",
      "emotion": "surprised",
      "audio": {
        "file": "audio/voice/ru-82366d379093.ru/l2.mp3",
        "durationSec": 2.038,
        "words": [
          {
            "text": "Вбегает",
            "start": 0,
            "end": 0.464
          },
          {
            "text": "запыхавшаяся",
            "start": 0.499,
            "end": 1.149
          },
          {
            "text": "женщина",
            "start": 1.219,
            "end": 1.591
          },
          {
            "text": "и",
            "start": 1.614,
            "end": 1.637
          },
          {
            "text": "говорит:",
            "start": 1.672,
            "end": 1.997
          }
        ],
        "provider": "elevenlabs",
        "voiceId": "ogi2DyUAKJb7CEdqqvlU",
        "model": "eleven_multilingual_v2",
        "textHash": "0d9754a7"
      },
      "pauseAfterSec": 0
    },
    {
      "id": "l3",
      "character": "devushka",
      "text": "Слава Богу, успела! У вас куры есть?",
      "emotion": "happy",
      "audio": {
        "file": "audio/voice/ru-82366d379093.ru/l3.mp3",
        "durationSec": 3.109,
        "words": [
          {
            "text": "Слава",
            "start": 0,
            "end": 0.476
          },
          {
            "text": "Богу,",
            "start": 0.546,
            "end": 0.882
          },
          {
            "text": "успела!",
            "start": 0.917,
            "end": 1.579
          },
          {
            "text": "У",
            "start": 1.625,
            "end": 1.683
          },
          {
            "text": "вас",
            "start": 1.765,
            "end": 1.927
          },
          {
            "text": "куры",
            "start": 2.009,
            "end": 2.322
          },
          {
            "text": "есть?",
            "start": 2.368,
            "end": 3.065
          }
        ],
        "provider": "elevenlabs",
        "voiceId": "AB9XsbSA4eLG12t2myjN",
        "model": "eleven_multilingual_v2",
        "textHash": "78b32547"
      },
      "pauseAfterSec": 0
    },
    {
      "id": "l4",
      "character": "narrator",
      "text": "Мясник достает из морозилки единственную курицу",
      "emotion": "neutral",
      "audio": {
        "file": "audio/voice/ru-82366d379093.ru/l4.mp3",
        "durationSec": 2.534,
        "words": [
          {
            "text": "Мясник",
            "start": 0,
            "end": 0.36
          },
          {
            "text": "достает",
            "start": 0.418,
            "end": 0.813
          },
          {
            "text": "из",
            "start": 0.859,
            "end": 0.906
          },
          {
            "text": "морозилки",
            "start": 0.964,
            "end": 1.428
          },
          {
            "text": "единственную",
            "start": 1.463,
            "end": 2.009
          },
          {
            "text": "курицу",
            "start": 2.067,
            "end": 2.508
          }
        ],
        "provider": "elevenlabs",
        "voiceId": "ogi2DyUAKJb7CEdqqvlU",
        "model": "eleven_multilingual_v2",
        "textHash": "708151ee"
      },
      "pauseAfterSec": 0
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "и кладет на весы.",
      "emotion": "neutral",
      "audio": {
        "file": "audio/voice/ru-82366d379093.ru/l5.mp3",
        "durationSec": 1.62,
        "words": [
          {
            "text": "и",
            "start": 0,
            "end": 0.07
          },
          {
            "text": "кладет",
            "start": 0.093,
            "end": 0.418
          },
          {
            "text": "на",
            "start": 0.464,
            "end": 0.522
          },
          {
            "text": "весы.",
            "start": 0.557,
            "end": 1.579
          }
        ],
        "provider": "elevenlabs",
        "voiceId": "ogi2DyUAKJb7CEdqqvlU",
        "model": "eleven_multilingual_v2",
        "textHash": "d8b80b5f"
      },
      "pauseAfterSec": 0
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "Весы показывают килограмм. Женщина:",
      "emotion": "neutral",
      "audio": {
        "file": "audio/voice/ru-82366d379093.ru/l6.mp3",
        "durationSec": 2.534,
        "words": [
          {
            "text": "Весы",
            "start": 0,
            "end": 0.372
          },
          {
            "text": "показывают",
            "start": 0.418,
            "end": 0.929
          },
          {
            "text": "килограмм.",
            "start": 0.964,
            "end": 1.625
          },
          {
            "text": "Женщина:",
            "start": 1.8,
            "end": 2.508
          }
        ],
        "provider": "elevenlabs",
        "voiceId": "ogi2DyUAKJb7CEdqqvlU",
        "model": "eleven_multilingual_v2",
        "textHash": "423ee1b7"
      },
      "pauseAfterSec": 0
    },
    {
      "id": "l7",
      "character": "devushka",
      "text": "Н-да... А побольше нет?",
      "emotion": "sad",
      "audio": {
        "file": "audio/voice/ru-82366d379093.ru/l7.mp3",
        "durationSec": 2.456,
        "words": [
          {
            "text": "Н-да...",
            "start": 0,
            "end": 0.673
          },
          {
            "text": "А",
            "start": 1.115,
            "end": 1.184
          },
          {
            "text": "побольше",
            "start": 1.277,
            "end": 1.741
          },
          {
            "text": "нет?",
            "start": 1.811,
            "end": 2.415
          }
        ],
        "provider": "elevenlabs",
        "voiceId": "AB9XsbSA4eLG12t2myjN",
        "model": "eleven_multilingual_v2",
        "textHash": "d0e25a48"
      },
      "pauseAfterSec": 0
    },
    {
      "id": "l8",
      "character": "narrator",
      "text": "Мясник убирает курицу обратно,",
      "emotion": "neutral",
      "audio": {
        "file": "audio/voice/ru-82366d379093.ru/l8.mp3",
        "durationSec": 1.75,
        "words": [
          {
            "text": "Мясник",
            "start": 0,
            "end": 0.36
          },
          {
            "text": "убирает",
            "start": 0.406,
            "end": 0.731
          },
          {
            "text": "курицу",
            "start": 0.778,
            "end": 1.126
          },
          {
            "text": "обратно,",
            "start": 1.161,
            "end": 1.718
          }
        ],
        "provider": "elevenlabs",
        "voiceId": "ogi2DyUAKJb7CEdqqvlU",
        "model": "eleven_multilingual_v2",
        "textHash": "35f1d081"
      },
      "pauseAfterSec": 0
    },
    {
