      "audio": {
        "file": "audio/voice/ru-82366d379093.ru/l11.mp3",
        "durationSec": 3.422,
        "words": [
          {
            "text": "Весы",
            "start": 0,
            "end": 0.348
          },
          {
            "text": "показывают",
            "start": 0.395,
            "end": 0.906
          },
          {
            "text": "полтора",
            "start": 0.964,
            "end": 1.347
          },
          {
            "text": "кило.",
            "start": 1.393,
            "end": 1.927
          },
          {
            "text": "Женщина:",
            "start": 2.531,
            "end": 3.39
          }
