            "end": 0.302
          },
          {
            "text": "достает",
            "start": 0.36,
            "end": 0.789
          },
          {
            "text": "ее",
            "start": 0.848,
            "end": 0.929
          },
          {
            "text": "же,",
            "start": 0.998,
            "end": 1.126
          },
          {
            "text": "поворачивает,",
            "start": 1.149,
            "end": 1.858
          }
        ],
        "provider": "elevenlabs",
        "voiceId": "ogi2DyUAKJb7CEdqqvlU",
        "model": "eleven_multilingual_v2",
        "textHash": "99252a98"
      },
      "pauseAfterSec": 0
    },
