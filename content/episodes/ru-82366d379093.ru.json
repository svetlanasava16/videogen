  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Мясная лавка, минута до закрытия.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "devushka",
      "text": "Слава богу, успела! Курицы есть?",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [
        "devushka"
      ],
      "exit": []
    },
    {
      "id": "l3",
      "character": "barmen",
      "text": "Последняя. Ровно килограмм.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "devushka",
      "text": "Хм… А побольше нет?",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "barmen",
      "text": "Сейчас поищу.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "Мясник уносит ту же курицу, приносит обратно и прижимает весы пальцем.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "barmen",
      "text": "Вот. Полтора кило.",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "devushka",
      "text": "Отлично! Будьте добры, обе.",
      "emotion": "happy",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    }
