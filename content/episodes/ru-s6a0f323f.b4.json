  "lines": [
    {
      "id": "l1",
      "character": "muzhik",
      "text": "Мой, Палыч. Это мой телефон.",
      "emotion": "sad",
      "pauseAfterSec": 0
    },
    {
      "id": "l2",
      "character": "muzhik-sosed",
      "text": "Поздравляю, Вася. Платье, шуба, Канары и машина.",
      "emotion": "smug",
      "pauseAfterSec": 0
    },
    {
      "id": "l3",
      "character": "muzhik",
      "text": "Палыч, ты не начальник, ты пень в банной шапке!",
      "emotion": "angry",
      "pauseAfterSec": 0
    },
    {
      "id": "l4",
      "character": "nachalnik",
      "text": "Это ты кого пнём назвал? Я лицо государственное! Увидимся в суде.",
      "emotion": "angry",
      "pauseAfterSec": 0.8
    }
  ],
  "explicit": false,
