  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Einem Bauern wurden ständig Wassermelonen geklaut, und schließlich stellte er auf dem Feld ein Schild auf.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "muzhik-ryzhy",
      "text": "Vorsicht! In einer der Wassermelonen ist Rattengift!",
      "emotion": "smug",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "Am nächsten Tag sah er, dass nichts geklaut worden war, aber auf dem Schild stand ein Zusatz.",
      "emotion": "neutral",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l4",
      "character": "muzhik-ryzhy",
      "text": "Jetzt sind es zwei!",
      "emotion": "surprised",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
