  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "A Scottish lad studies at an English university and shares a room with two English students.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "zhena",
      "text": "Hello, son! So, how are you getting on with the English boys?",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [
        "zhena"
      ],
      "exit": []
    },
    {
      "id": "l3",
      "character": "paren",
      "text": "Oh, Mum, they're dreadful, noisy people!",
      "emotion": "angry",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "paren",
      "text": "One of them bangs his head against the wall all night long.",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "paren",
      "text": "The other one just screams and screams. Every single night.",
      "emotion": "angry",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "zhena",
      "text": "Oh, you poor thing! How do you put up with them?",
      "emotion": "sad",
      "pauseAfterSec": 0.7,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "paren",
      "text": "I don't, Mum. I just ignore them. I sit here all night and play my bagpipes.",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    }
  ],
