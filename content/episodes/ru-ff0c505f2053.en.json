{
  "id": "ru-ff0c505f2053.en",
  "jokeId": "ru-ff0c505f2053",
  "locale": "en",
  "title": "Noisy Roommates",
  "location": "spalnya",
  "place": "bedroom",
  "cast": [
    "zhena",
    "paren"
  ],
  "roles": {
    "zhena": "mother",
    "paren": "student"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Angus MacDonald came from Scotland to study at an English university, where he was put in a room with two other students.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "When he had lived there for about a month, his mother came to visit him.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [
        "zhena"
      ],
      "exit": []
    },
    {
      "id": "l3",
      "character": "zhena",
      "text": "So, how do you like these English students, Angus?",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "paren",
      "text": "Mum, they're such awful, noisy people!",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "paren",
      "text": "The one on this side bangs his head against the wall all night without a break, and the one on that side screams and screams, and it's like that every night.",
      "emotion": "angry",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "zhena",
      "text": "Oh, Angus, how do you get along with these awful, noisy Englishmen?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "paren",
      "text": "Mum, I don't do anything. I just ignore them.",
      "emotion": "neutral",
      "pauseAfterSec": 0.7,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "paren",
      "text": "I sit here all night and play my bagpipes.",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
  "explicit": false,
  "outroLaughs": [],
