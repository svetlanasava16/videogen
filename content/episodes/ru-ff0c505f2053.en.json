  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Angus MacDonald came from Scotland to study at an English university, where he was put in a room with two other students. After about a month there, his mother came to visit him.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "zhena",
      "text": "So how do you like these English students, Angus?",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "paren",
      "text": "Mum, they're such awful, noisy people!",
      "emotion": "angry",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "paren",
      "text": "The one on this side bangs his head against the wall all night without a break, and the one on that side screams and screams, and it's like that every night.",
      "emotion": "angry",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "zhena",
      "text": "Oh, Angus, how do you put up with these awful, noisy Englishmen?",
      "emotion": "sad",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l6",
      "character": "paren",
      "text": "Mum, I don't do anything. I just ignore them.",
      "emotion": "smug",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l7",
      "character": "paren",
      "text": "I sit here all night and play my bagpipes.",
      "emotion": "happy",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
