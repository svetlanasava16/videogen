{
  "id": "en-r-c2dun5.de",
  "jokeId": "en-r-c2dun5",
  "locale": "de",
  "title": "Die Golfschläger",
  "kind": "joke",
  "v": 2,
  "location": "gostinaya",
  "place": "home-living-room",
  "cast": [
    "zhena",
    "muzhik"
  ],
  "roles": {
    "zhena": "wife",
    "muzhik": "husband"
  },
  "lines": [
    {
      "id": "l1",
      "character": "zhena",
      "text": "Schatz, wenn ich sterben würde, würdest du wieder heiraten?",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "muzhik",
      "text": "Nach einer angemessenen Trauerzeit wohl schon. Wir alle brauchen Gesellschaft.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "zhena",
      "text": "Wenn ich sterben würde und du wieder heiratest, würde sie dann in diesem Haus wohnen?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "Wir haben viel Geld ausgegeben, um dieses Haus genau so herzurichten, wie wir es wollen. Ich werde mein Haus nicht aufgeben. Ich schätze, das würde sie.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "zhena",
      "text": "Wenn ich sterben würde und du wieder heiratest und sie in diesem Haus wohnt, würde sie dann in unserem Bett schlafen?",
      "emotion": "angry",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l6",
      "character": "muzhik",
      "text": "Na ja, das Bett ist ganz neu und hat uns zweitausend Euro gekostet. Das hält noch lange, also ich schätze, das würde sie.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l7",
      "character": "zhena",
      "text": "Wenn ich sterben würde und du wieder heiratest und sie in diesem Haus wohnt und in unserem Bett schläft, würde sie dann meine Golfschläger benutzen?",
      "emotion": "angry",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l8",
      "character": "muzhik",
      "text": "Oh nein. Sie ist Linkshänderin!",
      "emotion": "happy",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
  "explicit": false,
