  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Der beste Freund des Menschen ist wirklich der Hund. Sie glauben das nicht?",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Machen Sie folgendes Experiment: Sperren Sie Ihren Hund und Ihre Frau zusammen in den Kofferraum.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "Nach ein, zwei Stündchen machen Sie wieder auf.",
      "emotion": "neutral",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l4",
      "character": "narrator",
      "text": "Was meinen Sie, wer freut sich mehr, Sie zu sehen?",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
