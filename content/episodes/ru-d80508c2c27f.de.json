  },
  "lines": [
    {
      "id": "l1",
      "character": "muzhik",
      "text": "Der Psychiater hält mir ein Blatt Papier mit einem Klecks unter die Nase.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "doktor",
      "text": "Was sehen Sie?",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "muzhik",
      "text": "Einen traurigen, einsamen Menschen, zermürbt vom Umgang mit Idioten, von öder,",
      "emotion": "sad",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l3b",
      "character": "muzhik",
      "text": "schlecht bezahlter Arbeit und all den anderen Ungerechtigkeiten des Lebens.",
      "emotion": "sad",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l4",
      "character": "doktor",
      "text": "Und auf dem Bild?..",
      "emotion": "sad",
      "pauseAfterSec": 0.6,
      "laugh": "chuckle"
    },
    {
      "id": "l5",
      "character": "muzhik",
      "text": "Ich hätte ihn am liebsten umarmt.",
      "emotion": "sad",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
