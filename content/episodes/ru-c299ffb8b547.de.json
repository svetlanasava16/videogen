{
  "id": "ru-c299ffb8b547.de",
  "jokeId": "ru-c299ffb8b547",
  "locale": "de",
  "title": "Die Trommel",
  "location": "gostinaya",
  "place": "front-door",
  "cast": [
    "paren",
    "muzhik"
  ],
  "roles": {
    "paren": "musician",
    "muzhik": "patient"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Es klingelt. Der Hausherr öffnet und sieht: vor der Tür eine riesige Trommel mit Becken obendrauf, und hinter der Trommel steht jemand.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "muzhik",
      "text": "Zu wem wollen Sie?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "paren",
      "text": "Entschuldigung, ist hier die Beerdigung?",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "Nein... der Arzt hat gesagt, ich hab noch drei Tage...",
      "emotion": "sad",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "paren",
      "text": "Um Gottes willen, verzeihen Sie... Entschuldigung...",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "Etwas später klingelt es wieder. Der Hausherr öffnet wieder. Dasselbe Bild.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "muzhik",
      "text": "Was wollen Sie denn?",
      "emotion": "angry",
      "pauseAfterSec": 0.6,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "paren",
      "text": "Entschuldigung, darf ich meine Trommel so lange bei Ihnen lassen?",
      "emotion": "neutral",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
