{
  "id": "ru-c299ffb8b547.de",
  "jokeId": "ru-c299ffb8b547",
  "locale": "de",
  "title": "Die Trommel",
  "location": "gostinaya",
  "place": "front-door",
  "cast": [
    "muzhik",
    "paren"
  ],
  "roles": {
    "muzhik": "everyman",
    "paren": "musician"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Es klingelt an der Tür. Der Hausherr öffnet und sieht eine riesige Trommel, oben mit Becken dran... und dahinter steht jemand.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "muzhik",
      "text": "...Zu wem wollen Sie?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "paren",
      "text": "Entschuldigung, ist hier die Beerdigung?",
      "emotion": "neutral",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "Nein... der Doktor hat gesagt, mir bleiben noch drei Tage...",
      "emotion": "sad",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "paren",
      "text": "Um Himmels willen, verzeihen Sie... entschuldigen Sie...",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "Der Mann mit der Trommel dreht sich mühsam um und geht.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "narrator",
      "text": "Nach einer Weile klingelt es wieder. Der Hausherr öffnet wieder. Dasselbe Bild.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "muzhik",
      "text": "Was wollen Sie denn?",
      "emotion": "angry",
      "pauseAfterSec": 0.7,
      "enter": [],
      "exit": []
    },
    {
      "id": "l9",
      "character": "paren",
      "text": "Entschuldigung, kann ich meine Trommel so lange bei Ihnen lassen?",
      "emotion": "neutral",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
