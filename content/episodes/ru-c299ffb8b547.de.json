  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Es klingelt. Vor der Tür steht eine riesige Trommel mit Becken, dahinter ein Mann.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "muzhik",
      "text": "Zu wem wollen Sie?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "paren",
      "text": "Entschuldigung, ist hier die Beerdigung?",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [
        "paren"
      ],
      "exit": []
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "Nein... Der Arzt sagt, noch drei Tage.",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "paren",
      "text": "Oh Gott, verzeihen Sie!",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": [
        "paren"
      ]
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "Ein paar Minuten später klingelt es wieder.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "muzhik",
      "text": "Was denn noch?",
      "emotion": "angry",
      "pauseAfterSec": 0.7,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "paren",
      "text": "Entschuldigung, kann ich die Trommel so lange bei Ihnen lassen?",
      "emotion": "neutral",
      "pauseAfterSec": 0.8,
      "enter": [
        "paren"
      ],
      "exit": []
    }
  ],
