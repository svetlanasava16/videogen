    {
      "id": "l2",
      "character": "muzhik",
      "text": "Hast du mein Sakko sauber gemacht?",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "zhena",
      "text": "Ja, Schatz.",
      "emotion": "happy",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "Und die Hose?",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "zhena",
      "text": "Natürlich, Schatz.",
      "emotion": "happy",
      "pauseAfterSec": 0.3
    },
    {
