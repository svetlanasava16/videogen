{
  "id": "de-witze-1ikywni.de",
  "jokeId": "de-witze-1ikywni",
  "locale": "de",
  "title": "Die Katze der Frau",
  "kind": "joke",
  "v": 2,
  "location": "gostinaya",
  "place": "car",
  "cast": [
    "muzhik",
    "kot",
    "zhena"
  ],
  "roles": {
    "muzhik": "husband",
    "zhena": "wife",
    "kot": "cat"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein Mann will die Katze seiner Frau heimlich loswerden und beschließt, sie auszusetzen.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Er nimmt sie mit ins Auto, fährt zwanzig Häuser weit, setzt die Katze aus und fährt heim.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "Zehn Minuten später ist die Katze auch wieder da.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "Na gut, war vielleicht ein wenig zu kurz die Strecke.",
      "emotion": "sad",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "Er setzt sich wieder mit der Katze ins Auto, fährt fünf Kilometer weit und setzt sie aus.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "Zwanzig Minuten später ist die Katze wieder zu Hause.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l7",
      "character": "muzhik",
      "text": "Jetzt reicht's!",
      "emotion": "angry",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l8",
      "character": "narrator",
      "text": "Er nimmt die Katze mit ins Auto und fährt zwanzig Kilometer, dann durch den Wald, über eine Brücke, rechts, links,",
      "emotion": "neutral",
      "pauseAfterSec": 0.2
    },
    {
      "id": "l9",
      "character": "narrator",
      "text": "und setzt die Katze dann schließlich mitten im Wald auf einer Lichtung aus.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l10",
      "character": "narrator",
      "text": "Eine halbe Stunde später ruft der Mann zu Hause an.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l11",
      "character": "muzhik",
      "text": "Ist die Katze da?",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l12",
      "character": "zhena",
      "text": "Ja, warum?",
      "emotion": "surprised",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l13",
      "character": "muzhik",
      "text": "Hol sie mal ans Telefon, ich habe mich verfahren.",
      "emotion": "sad",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
