  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein Mann will heimlich die Katze seiner Frau loswerden.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "muzhik",
      "text": "Zwanzig Häuser weit reicht. Raus mit dir!",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": [
        "kot"
      ]
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "Zehn Minuten später ist die Katze wieder zu Hause. Nach fünf Kilometern auch.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [
        "kot"
      ],
      "exit": []
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "Jetzt reicht's! Zwanzig Kilometer, durch den Wald, über die Brücke, rechts, links. Raus!",
      "emotion": "angry",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": [
        "kot"
      ]
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "Eine halbe Stunde später ruft er zu Hause an.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "muzhik",
      "text": "Schatz, ist die Katze schon da?",
      "emotion": "sad",
      "pauseAfterSec": 0.7,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "muzhik",
      "text": "Gut. Hol sie mal ans Telefon. Ich hab mich verfahren.",
      "emotion": "sad",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    }
  ],
