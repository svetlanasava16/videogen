{
  "id": "de-witze-1ikywni.de",
  "jokeId": "de-witze-1ikywni",
  "locale": "de",
  "title": "Die Katze der Frau",
  "location": "doroga",
  "cast": [
    "muzhik",
    "kot",
    "zhena"
  ],
  "roles": {
    "muzhik": "husband",
    "kot": "cat",
    "zhena": "wife"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein Mann will heimlich die Katze seiner Frau loswerden.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "muzhik",
      "text": "So, zwanzig Häuser weiter. Tschüss, Katze.",
      "emotion": "smug",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l3",
      "character": "muzhik",
      "text": "Was? Die ist ja schon wieder da!",
      "emotion": "surprised",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "Na gut. Dann eben fünf Kilometer.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l5",
      "character": "muzhik",
      "text": "Schon wieder zu Hause? Jetzt reicht's!",
      "emotion": "angry",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l6",
      "character": "muzhik",
      "text": "Zwanzig Kilometer, durch den Wald, über die Brücke, rechts, links. Raus mit dir!",
      "emotion": "angry",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l7",
      "character": "narrator",
      "text": "Eine halbe Stunde später ruft er zu Hause an.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l8",
      "character": "muzhik",
      "text": "Schatz, ist die Katze da?",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l9",
      "character": "zhena",
      "text": "Ja. Warum?",
      "emotion": "surprised",
      "pauseAfterSec": 0.7
    },
    {
      "id": "l10",
      "character": "muzhik",
      "text": "Hol sie mal ans Telefon. Ich hab mich verfahren.",
      "emotion": "sad",
      "pauseAfterSec": 0.8
    }
  ],
  "format": {
    "width": 1080,
    "height": 1920,
    "fps": 30
  }
}
