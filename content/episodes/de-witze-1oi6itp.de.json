{
  "id": "de-witze-1oi6itp.de",
  "jokeId": "de-witze-1oi6itp",
  "locale": "de",
  "title": "Küken im Wald",
  "location": "derevnya",
  "place": "forest",
  "cast": [
    "muzhik",
    "ptitsa"
  ],
  "roles": {
    "muzhik": "everyman",
    "ptitsa": "chicken"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein Mann läuft nach dem Einkaufen mit einer vollen Einkaufstüte durch den Wald.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Da kommt ihm ein kleines Küken entgegen – komplett zugekackt.",
      "uncensored": "Da kommt ihm ein kleines Küken entgegen – komplett zugeschissen.",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "Dem Mann tut das Küken leid.",
      "emotion": "sad",
      "pauseAfterSec": 0.2,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "narrator",
      "text": "Also holt er eine Rolle Klopapier aus seiner Tüte und putzt es sauber.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "Kurz darauf kommen ihm drei weitere Küken entgegen, ebenfalls total zugekackt.",
      "uncensored": "Kurz darauf kommen ihm drei weitere Küken entgegen, ebenfalls total zugeschissen.",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "Der Mann putzt auch diese sauber.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "narrator",
      "text": "Ein gutes Stück weiter trifft er auf fünf weitere Küken, wieder komplett zugekackt.",
      "uncensored": "Ein gutes Stück weiter trifft er auf fünf weitere Küken, wieder komplett zugeschissen.",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "narrator",
      "text": "Er putzt auch diese ab, aber beim letzten Küken ist das Klopapier leer.",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l9",
      "character": "narrator",
      "text": "Weil ihm das letzte Küken leid tut, geht er weiter in den Wald, um etwas anderes zu finden, womit er es sauber machen kann.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l10",
      "character": "narrator",
      "text": "Da kommt ihm ein Bauer auf einem Traktor entgegen.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l11",
      "character": "muzhik",
      "text": "Entschuldigung, hätten Sie vielleicht etwas Klopapier?",
      "emotion": "sad",
      "pauseAfterSec": 0.6,
      "enter": [],
      "exit": []
    },
    {
      "id": "l12",
      "character": "muzhik-ryzhy",
      "text": "Klopapier? Nehmen Sie doch einfach ein Küken!",
      "emotion": "surprised",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
