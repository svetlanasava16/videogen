  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein Mann kommt vom Einkaufen und geht durch den Wald. Da kommt ihm ein Küken entgegen, komplett zugeschissen.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "muzhik",
      "text": "Du armes Ding. Zum Glück hab ich Klopapier gekauft.",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "Er putzt es sauber. Dann kommen drei weitere Küken. Dann noch fünf. Alle zugeschissen.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "Mist, das Papier ist alle. Und das letzte ist noch dreckig.",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "muzhik",
      "text": "Entschuldigung! Hätten Sie vielleicht etwas Klopapier?",
      "emotion": "surprised",
      "pauseAfterSec": 0.7,
      "enter": [
        "muzhik-ryzhy"
      ],
      "exit": []
    },
    {
      "id": "l6",
      "character": "muzhik-ryzhy",
      "text": "Klopapier? Nehmen Sie doch einfach ein Küken!",
      "emotion": "surprised",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    }
  ],
