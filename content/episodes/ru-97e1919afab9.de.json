  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Sommer, Sonne, Hitze... Ein Mann kommt mit einem Kanister Bier aus der Sauna. Er freut sich schon auf ein kaltes Bierchen zu Hause...",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Auf der Straße liegt eine Flasche, der Mann tritt dagegen, und sie zerschellt an einem Stein.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "Wie üblich: ein Dschinn, ein Wunsch.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "Ich will, dass das Bier im Kanister nie ausgeht.",
      "emotion": "happy",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "Der Dschinn zaubert ein bisschen und verschwindet.",
      "emotion": "neutral",
      "pauseAfterSec": 0.6,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "Und der Mann versucht bis heute, den Kanister aufzumachen.",
      "emotion": "neutral",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
