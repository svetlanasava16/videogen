  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Sommer, Sonne, Hitze. Ein Mann kommt aus der Sauna, mit einem Kanister Bier. Er freut sich schon auf ein kaltes Bier zu Hause.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Auf der Straße liegt eine Flasche. Der Mann tritt dagegen, und sie zerschellt an einem Stein.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "Wie üblich: ein Dschinn, ein Wunsch.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [
        "chort"
      ],
      "exit": []
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "Ich will, dass das Bier in meinem Kanister nie ausgeht.",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "Der Dschinn zaubert und verschwindet.",
      "emotion": "neutral",
      "pauseAfterSec": 0.7,
      "enter": [],
      "exit": [
        "chort"
      ]
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "Und der Mann versucht bis heute, den Kanister aufzukriegen.",
      "emotion": "neutral",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
