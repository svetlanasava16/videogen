    {
      "id": "l1",
      "character": "narrator",
      "text": "Hitze. Ein Mann trägt einen Kanister Bier aus der Sauna nach Hause, kickt eine alte Flasche weg, und heraus kommt ein Flaschengeist.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "chort",
      "text": "Dein Wunsch ist mir Befehl!",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [
        "chort"
      ],
      "exit": []
    },
    {
      "id": "l3",
      "character": "muzhik",
      "text": "Ich will, dass das Bier in diesem Kanister nie alle wird!",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "chort",
      "text": "Gewährt!",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": [
        "chort"
      ]
    },
    {
      "id": "l5",
      "character": "muzhik",
      "text": "Na dann, prost. Moment. Wie geht der denn auf?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "Zehn Jahre später.",
      "emotion": "neutral",
      "pauseAfterSec": 0.7,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "muzhik",
      "text": "Immer noch zu. Aber das Bier wird nie alle. Er hat Wort gehalten.",
      "emotion": "sad",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    }
  ],
