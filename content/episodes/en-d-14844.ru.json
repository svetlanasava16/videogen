  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "У папы любимая шутка: скажешь ему «я голодный», а он в ответ: «Привет, Голодный, я папа!»",
      "emotion": "neutral",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l2",
      "character": "paren",
      "text": "Мама, папа, я гей.",
      "emotion": "sad",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "Мама смотрит на папу. Папа сжимает кулак и потеет.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "zhena",
      "text": "Нет, не на…",
      "emotion": "surprised",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l5",
      "character": "muzhik",
      "text": "Привет, Гей, я папа!",
      "emotion": "happy",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
