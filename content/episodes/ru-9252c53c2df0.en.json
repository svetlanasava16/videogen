  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "In the middle of a flight, a grinding and creaking of the hull is suddenly heard in the cabin.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "One of the passengers turns pale, cold sweat breaks out on his forehead, and he digs his fingers into the seat.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "muzhik",
      "text": "There's no need to worry like that!",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "I fly a lot, and I can assure you the guys up there in the cockpit know what they're doing!",
      "emotion": "smug",
      "pauseAfterSec": 0.7,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "muzhik-sosed",
      "text": "I'm a pilot! I know exactly what they're doing in there!",
      "emotion": "angry",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
