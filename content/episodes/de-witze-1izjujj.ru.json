{
  "id": "de-witze-1izjujj.ru",
  "jokeId": "de-witze-1izjujj",
  "locale": "ru",
  "title": "Самый глупый ребёнок в городе",
  "location": "magazin",
  "place": "barbershop",
  "cast": [
    "vovochka",
    "barmen",
    "muzhik"
  ],
  "roles": {
    "vovochka": "vovochka",
    "barmen": "craftsman",
    "muzhik": "customer"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Вовочка заходит в парикмахерскую.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "barmen",
      "text": "Это самый глупый ребёнок в городе! Минутку, сейчас я вам покажу.",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "Он берёт в одну руку сторублёвую купюру, а в другую две монеты по десять рублей.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "barmen",
      "text": "Ну, мальчик, выбирай руку. Какую хочешь?",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "Вовочка берёт две монеты и уходит.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "barmen",
      "text": "Ну, что я вам говорил? Каждый раз, ну буквально каждый раз!",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "barmen",
      "text": "Этот сорванец никогда в жизни не научится!",
      "emotion": "happy",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "narrator",
      "text": "Чуть позже клиент выходит из парикмахерской на улицу и видит Вовочку у киоска с мороженым.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l9",
      "character": "muzhik",
      "text": "Эй, малыш, можно вопрос? Почему ты берёшь две монеты, а не сторублёвку?",
      "emotion": "surprised",
      "pauseAfterSec": 0.6,
      "enter": [],
      "exit": []
    },
    {
      "id": "l10",
      "character": "vovochka",
      "text": "В тот день, когда я возьму бумажку, игра закончится.",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
