{
  "id": "en-r-axy53t.de",
  "jokeId": "en-r-axy53t",
  "locale": "de",
  "title": "Der erste Tag",
  "kind": "joke",
  "v": 2,
  "location": "doroga",
  "place": "car",
  "cast": [
    "muzhik-ryzhy",
    "paren"
  ],
  "roles": {
    "muzhik-ryzhy": "driver",
    "paren": "customer"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein Taxifahrer, neu im Job, nimmt seinen ersten Fahrgast auf.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Ein paar Minuten vergehen, und die ganze Fahrt über ist es still. Nicht mal das Radio läuft.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "Der Fahrgast ist sehr gesellig, also fängt er ein Gespräch an, um die Stille zu brechen.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "paren",
      "text": "Hey, Ma—",
      "emotion": "happy",
      "pauseAfterSec": 0.2
    },
    {
      "id": "l5",
      "character": "muzhik-ryzhy",
      "text": "Verdammter Mist!",
      "uncensored": "Verdammte Scheiße!",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "laugh": "chuckle"
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "Der Fahrer steigt abrupt in die Bremsen.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l7",
      "character": "paren",
      "text": "Alter, was soll der Mist?!",
      "uncensored": "Alter, was soll die Scheiße?!",
      "emotion": "angry",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l8",
      "character": "muzhik-ryzhy",
      "text": "Tut mir leid, Mann.",
      "emotion": "sad",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l8b",
      "character": "muzhik-ryzhy",
      "text": "Ist mein erster Tag im Job,",
      "emotion": "sad",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l8c",
      "character": "muzhik-ryzhy",
      "text": "und ich hab mich von meinem alten Job noch nicht umgestellt.",
      "emotion": "sad",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l9",
      "character": "paren",
      "text": "Was hast du denn vorher gemacht?",
      "emotion": "surprised",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l10",
      "character": "muzhik-ryzhy",
      "text": "Ich bin einen Leichenwagen gefahren.",
      "emotion": "neutral",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
