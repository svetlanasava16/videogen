      "character": "devushka",
      "text": "What would these men do right now without women?! Just what would they do without us?!",
      "emotion": "angry",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "devushka",
      "text": "Huh?! I'm asking you!",
