{
  "id": "ru-c20746e7cca4.en",
  "jokeId": "ru-c20746e7cca4",
  "locale": "en",
  "title": "The Sparrow",
  "location": "doroga",
  "place": "home-living-room",
  "cast": [
    "muzhik-ryzhy",
    "ptitsa"
  ],
  "roles": {
    "muzhik-ryzhy": "biker",
    "ptitsa": "bird"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "A motorcyclist speeding along suddenly sees something flying straight at him… a sparrow!",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "He slams on the brakes, tries every way to swerve, but still clips the sparrow with his helmet. The sparrow flies off to the side and falls.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "The motorcyclist feels sorry for the poor little bird. After some searching he finds the sparrow lying on the ground and takes it with him.",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "narrator",
      "text": "He brings it home, puts it in a cage, sets out a saucer of water, sprinkles some bread crumbs, and then goes to bed.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "In the morning the sparrow comes to, looks around and says to himself.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "ptitsa",
      "text": "Where am I?..",
      "offscreen": true,
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "ptitsa",
      "text": "Well, well… bars… a bowl of water… bread…",
      "offscreen": true,
      "emotion": "neutral",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "ptitsa",
      "text": "How awful! I killed the motorcyclist!",
      "offscreen": true,
      "emotion": "surprised",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
