  "locale": "en",
  "title": "The Sparrow",
  "location": "doroga",
  "place": "home-living-room",
  "cast": [
    "muzhik-ryzhy",
    "ptitsa"
  ],
  "roles": {
    "muzhik-ryzhy": "biker",
    "ptitsa": "bird"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "A motorcyclist racing at high speed suddenly sees something flying straight at him… a sparrow!",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "He slams on the brakes, tries everything to swerve, but still clips the sparrow with his helmet. The sparrow flies off to the side and falls.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "The motorcyclist felt sorry for the poor little bird. After a long search he found the sparrow lying on the ground and took it with him.",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "narrator",
      "text": "He brought it home, put it in a cage, set out a little saucer of water, sprinkled some bread crumbs, and then went to bed.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": [
        "muzhik-ryzhy"
      ]
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "In the morning the sparrow comes to, looks around and says to himself:",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "ptitsa",
      "text": "Where am I?.. Well, well… bars… a bowl of water… bread…",
      "emotion": "surprised",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "ptitsa",
      "text": "How awful! I killed the motorcyclist!",
      "emotion": "sad",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
