{
  "id": "de-witze-1ptmsrw.de",
  "jokeId": "de-witze-1ptmsrw",
  "locale": "de",
  "title": "Auf dem Heimweg",
  "location": "doroga",
  "place": "street",
  "cast": [
    "vovochka",
    "muzhik"
  ],
  "roles": {
    "vovochka": "child",
    "muzhik": "father"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein Junge geht von der Schule zu Fuß nach Hause.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Ein Auto nähert sich von hinten, und der Fahrer lässt die Seitenscheibe herunter.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "muzhik",
      "text": "Hey, steig ein.",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "vovochka",
      "text": "Auf gar keinen Fall. Ich gehe lieber zu Fuß.",
      "emotion": "angry",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "muzhik",
      "text": "Na komm schon, ich hab hier auch einen Lolli für dich.",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "vovochka",
      "text": "Ist mir egal, ich steig nicht zu dir ins Auto!",
      "emotion": "angry",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "muzhik",
      "text": "Hör zu: Ich halte jetzt an, du steigst bei mir ein, dann fahren wir zusammen ein Eis essen und danach kaufe ich dir noch ein Videospiel deiner Wahl.",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "muzhik",
      "text": "Wäre das nicht schön?",
      "emotion": "smug",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l9",
      "character": "vovochka",
      "text": "Das kannst du voll vergessen! Ich steig auf gar keinen Fall jemals in dein Auto.",
      "emotion": "angry",
      "pauseAfterSec": 0.6,
      "enter": [],
      "exit": []
    },
    {
      "id": "l10",
      "character": "vovochka",
      "text": "Du hast den Fiat gekauft, also komm damit auch allein klar, Dad.",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
