{
  "id": "ru-19a7da93045c.de",
  "jokeId": "ru-19a7da93045c",
  "locale": "de",
  "title": "Der Parkplatz",
  "kind": "joke",
  "v": 2,
  "location": "doroga",
  "place": "street",
  "cast": [
    "muzhik"
  ],
  "roles": {
    "muzhik": "everyman"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein Mann fährt zu einem Termin, ist spät dran, ist nervös,",
      "emotion": "neutral",
      "pauseAfterSec": 0
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "und findet keinen Parkplatz.",
      "emotion": "neutral",
      "pauseAfterSec": 0
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "Er hebt das Gesicht zum Himmel und sagt:",
      "emotion": "neutral",
      "pauseAfterSec": 0
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "Herr, hilf mir, einen Parkplatz zu finden.",
      "emotion": "sad",
      "pauseAfterSec": 0
    },
    {
      "id": "l5",
      "character": "muzhik",
      "text": "Dann hör ich auf zu trinken und gehe jeden Sonntag in die Kirche!",
      "emotion": "sad",
      "pauseAfterSec": 0
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "Plötzlich wird wie durch ein Wunder eine Lücke frei.",
      "emotion": "surprised",
      "pauseAfterSec": 0
    },
    {
      "id": "l7",
      "character": "narrator",
      "text": "Der Mann wendet sich wieder an den Himmel:",
      "emotion": "neutral",
      "pauseAfterSec": 0
    },
    {
      "id": "l8",
      "character": "muzhik",
      "text": "Ach, schon gut, nicht nötig. Hab einen gefunden!",
      "emotion": "happy",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
