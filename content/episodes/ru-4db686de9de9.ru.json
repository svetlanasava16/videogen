{
  "id": "ru-4db686de9de9.ru",
  "jokeId": "ru-4db686de9de9",
  "locale": "ru",
  "title": "Последняя просьба",
  "kind": "joke",
  "v": 2,
  "location": "spalnya",
  "place": "bedroom",
  "cast": [
    "muzhik",
    "zhena"
  ],
  "roles": {
    "muzhik": "husband",
    "zhena": "wife"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Джон был при смерти и тяжело дышал.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "muzhik",
      "text": "Выполнишь ли ты мою последнюю просьбу?",
      "emotion": "sad",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "zhena",
      "text": "Конечно, Джон.",
      "emotion": "sad",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "Я хочу, чтобы через шесть месяцев после моей смерти ты вышла замуж за Джо...",
      "emotion": "sad",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l5",
      "character": "zhena",
      "text": "Но я полагала, что ты его ненавидишь?",
      "emotion": "surprised",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "На последнем дыхании Джон вымолвил:",
      "emotion": "neutral",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l7",
      "character": "muzhik",
      "text": "Еще как ненавижу...",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
  "explicit": false,
