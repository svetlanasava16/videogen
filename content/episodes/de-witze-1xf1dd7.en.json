  "title": "The IKEA Wardrobe",
  "location": "spalnya",
  "place": "bedroom",
  "cast": [
    "zhena",
    "muzhik-sosed",
    "muzhik"
  ],
  "roles": {
    "zhena": "wife",
    "muzhik-sosed": "neighbor",
    "muzhik": "husband"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "A woman buys a wardrobe from IKEA and puts it together. But as soon as the tram rumbles past, the thing collapses.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "She builds it again, the tram comes, the wardrobe collapses.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "zhena",
      "text": "Could you please help me with my wardrobe?",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "narrator",
      "text": "But same story: wardrobe done, the tram rumbles past, the thing falls apart.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "muzhik-sosed",
      "text": "I'll stand inside, maybe from in there I can see what the problem is.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "No sooner said than done: he steps into the wardrobe, and at that moment her husband comes home.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "narrator",
      "text": "He sees the new wardrobe, wants a look, and opens it. Inside stands the neighbor.",
      "emotion": "surprised",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "muzhik-sosed",
      "text": "You know what, just hit me right now. If I tell you I'm waiting for the tram, you'll do it anyway.",
      "emotion": "sad",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
