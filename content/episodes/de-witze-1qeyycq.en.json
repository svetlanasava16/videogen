{
  "id": "de-witze-1qeyycq.en",
  "jokeId": "de-witze-1qeyycq",
  "locale": "en",
  "title": "The Good Deed",
  "kind": "joke",
  "v": 2,
  "location": "nebesa",
  "place": "heaven",
  "cast": [
    "ded",
    "paren"
  ],
  "roles": {
    "ded": "saint-peter",
    "paren": "everyman"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "A young man is standing at the gates of Heaven.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "ded",
      "text": "Do you have a good deed to show that would earn you a place in the Kingdom of Heaven?",
      "emotion": "neutral",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l3",
      "character": "paren",
      "text": "I helped two pretty ladies who were being harassed by a biker gang!",
      "emotion": "happy",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "ded",
      "text": "And how exactly did you manage that?",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "paren",
      "text": "Well, I bravely stood in front of them and made it clear to the bikers that I wasn't going to allow it!",
      "emotion": "smug",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l6",
      "character": "ded",
      "text": "And when was this supposed to have happened?",
      "emotion": "surprised",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l7",
      "character": "paren",
      "text": "About three minutes ago.",
      "emotion": "sad",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
