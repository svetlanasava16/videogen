  "lines": [
    {
      "id": "l1",
      "character": "devushka-blondinka",
      "text": "Na, was schreit ihr denn so, warum regt ihr euch so auf!",
      "emotion": "angry",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "devushka-blondinka",
      "text": "Na und, es hat dreimal gerüttelt. Ein ganz normales Luftloch, eine Turbulenzzone. Kann doch jedem passieren.",
      "emotion": "smug",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "devushka-blondinka",
      "text": "So, so, jetzt beruhigen wir uns… Alles gut? Na also.",
      "emotion": "happy",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l4",
      "character": "devushka-blondinka",
      "text": "Dann geh ich jetzt mal die Passagiere beruhigen.",
      "emotion": "neutral",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
