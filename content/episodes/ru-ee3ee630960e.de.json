  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein junger Mann fängt bei der Polizei an und holt schon seit drei Monaten sein Gehalt nicht ab.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "nachalnik",
      "text": "Sag mal, wie lange holst du dein Gehalt schon nicht ab?",
      "emotion": "angry",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l3",
      "character": "sluzhivy",
      "text": "Ach, ich dachte, man kriegt eine Pistole,",
      "emotion": "surprised",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l3b",
      "character": "sluzhivy",
      "text": "und dann muss man selbst sehen, wie man klarkommt...",
      "emotion": "surprised",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
