  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "A man pulls into a gas station with five penguins in the back seat.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [
        "muzhik",
        "ptitsa"
      ],
      "exit": []
    },
    {
      "id": "l2",
      "character": "paren",
      "text": "What the heck? You've got five penguins back there!",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "muzhik",
      "text": "I know! They jumped in at a red light. I have no idea what to do.",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "paren",
      "text": "If I were you, I'd take them to the zoo.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "muzhik",
      "text": "Great idea!",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": [
        "muzhik",
        "ptitsa"
      ]
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "A week later, same man, same penguins. Only now they're wearing sunglasses.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [
        "muzhik",
        "ptitsa"
      ],
      "exit": []
    },
    {
      "id": "l7",
      "character": "paren",
      "text": "What are you doing? I told you to take them to the zoo!",
      "emotion": "angry",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "muzhik",
      "text": "We went! We had a blast! Today we're going to the beach!",
      "emotion": "happy",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    }
  ],
