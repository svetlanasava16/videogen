  ],
  "roles": {
    "barmen": "mechanic",
    "muzhik": "customer",
    "pingvin": "penguin"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "A man pulls into a gas station, and the attendant notices five penguins sitting on the back seat.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "barmen",
      "text": "What the hell, you've got five penguins on the back seat.",
      "emotion": "surprised",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "muzhik",
      "text": "I know!",
      "emotion": "sad",
      "pauseAfterSec": 0.2
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "They jumped in at the traffic light, and now I don't know what to do.",
      "emotion": "sad",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l5",
      "character": "barmen",
      "text": "I'll tell you what I'd do. I'd take them to the zoo.",
      "emotion": "smug",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l6",
      "character": "muzhik",
      "text": "That's a great idea!",
      "emotion": "happy",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l7",
      "character": "narrator",
      "text": "A week later the same driver pulls up with the same five penguins, only now they're wearing sunglasses.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l8",
      "character": "barmen",
      "text": "What are you doing? I thought I told you to take the penguins to the zoo!",
      "emotion": "angry",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l9",
      "character": "muzhik",
      "text": "We went there! We had a great time!",
      "emotion": "happy",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l10",
      "character": "muzhik",
      "text": "Today we're going to the beach!",
      "emotion": "happy",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
