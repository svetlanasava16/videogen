  "locale": "en",
  "title": "Penguins",
  "location": "doroga",
  "place": "road",
  "cast": [
    "barmen",
    "muzhik-ryzhy",
    "ptitsa"
  ],
  "roles": {
    "barmen": "mechanic",
    "muzhik-ryzhy": "driver",
    "ptitsa": "bird"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "A man pulls into a gas station, and the attendant notices five penguins sitting in the back seat.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "barmen",
      "text": "What the hell, you've got five penguins in the back seat.",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "muzhik-ryzhy",
      "text": "I know! They jumped in at the traffic light, and now I don't know what to do.",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "barmen",
      "text": "I'll tell you what I'd do. I'd take them to the zoo.",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "muzhik-ryzhy",
      "text": "That's a great idea!",
      "emotion": "happy",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "A week later the same driver pulls up with the same five penguins, only now they're wearing sunglasses.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "barmen",
      "text": "What are you doing? I thought I told you to take the penguins to the zoo!",
      "emotion": "angry",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "muzhik-ryzhy",
      "text": "We went! We had a great time! Today we're going to the beach!",
      "emotion": "happy",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
