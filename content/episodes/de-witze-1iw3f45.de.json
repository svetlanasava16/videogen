  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Auf der Hundewiese treffen ein Dalmatiner, ein Pudel und eine Promenadenmischung aufeinander.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "korova",
      "text": "Guten Tag. Mein Name ist Antonius von Krallenberg.",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "korova",
      "text": "Ich entstamme einer alten Adelslinie. Wie meine Vorfahren lebe auch ich an der Seite des Herzogs.",
      "emotion": "smug",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "kot",
      "text": "Mein Name ist Isabella von Hundsmark.",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "kot",
      "text": "Wie der Klang meines Namens bereits erkennen lässt, entstamme auch ich einem alten Adelsgeschlecht.",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "kot",
      "text": "Wie auch meine Vorfahren bin ich der Stolz des Grafen.",
      "emotion": "happy",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "pyos",
      "text": "Yo Freunde, mein Herrchen nennt mich meistens nur Kalle.",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "pyos",
      "text": "Aber auch ich bin adlig.",
      "emotion": "smug",
      "pauseAfterSec": 0.7,
      "enter": [],
      "exit": []
    },
    {
      "id": "l9",
      "character": "pyos",
      "text": "Mein voller Name lautet „Kalle runter vom Sofa“.",
      "emotion": "happy",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
