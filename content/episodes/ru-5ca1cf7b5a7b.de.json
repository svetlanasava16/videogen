{
  "id": "ru-5ca1cf7b5a7b.de",
  "jokeId": "ru-5ca1cf7b5a7b",
  "locale": "de",
  "title": "Der vierte Leibwächter",
  "kind": "joke",
  "v": 2,
  "location": "bar",
  "place": "restaurant",
  "cast": [
    "sluzhivy",
    "muzhik",
    "nachalnik",
    "paren"
  ],
  "roles": {
    "sluzhivy": "guard",
    "muzhik": "new-russian",
    "nachalnik": "new-russian",
    "paren": "guard"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein Treffen neuer Russen. Jeder hat einen riesigen Leibwächter mitgebracht.",
      "emotion": "neutral",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l1b",
      "character": "narrator",
      "text": "Nur einer hat einen schmächtigen, kleinen, kränklich aussehenden.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "muzhik",
      "text": "Ist er ein harter Kämpfer?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "nachalnik",
      "text": "Ach was, überhaupt nicht.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "Ein Scharfschütze?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "nachalnik",
      "text": "Hatte noch nie eine Waffe in der Hand.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l6",
      "character": "muzhik",
      "text": "Wozu schleppst du ihn dann überall mit?",
      "emotion": "angry",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l7",
      "character": "narrator",
      "text": "Er tätschelt dem Leibwächter den Kopf:",
      "emotion": "neutral",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l8",
      "character": "nachalnik",
      "text": "Er ist schon mein vierter von der Sorte. Alle halten ihn für mich.",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
  "explicit": false,
