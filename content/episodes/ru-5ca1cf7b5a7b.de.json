  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein Treffen neuer Russen. Jeder hat einen riesigen Leibwächter mitgebracht. Nur einer hat einen schmächtigen, kleinen, kränklich aussehenden.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "muzhik",
      "text": "Ist er ein harter Kämpfer?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "nachalnik",
      "text": "Ach was, überhaupt nicht.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "Ein Scharfschütze?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "nachalnik",
      "text": "Hatte noch nie eine Waffe in der Hand.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "muzhik",
      "text": "Wozu schleppst du ihn dann überall mit?",
      "emotion": "angry",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "narrator",
      "text": "Er tätschelt dem Leibwächter den Kopf:",
      "emotion": "neutral",
      "pauseAfterSec": 0.6,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "nachalnik",
      "text": "Er ist schon mein vierter von der Sorte. Alle halten ihn für mich.",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
