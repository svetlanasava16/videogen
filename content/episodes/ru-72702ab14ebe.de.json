  "lines": [
    {
      "id": "l1",
      "character": "muzhik",
      "text": "Ich bin am Freitagabend mit dem Fahrrad zum Schnapsladen gefahren, habe eine Flasche Whisky gekauft und sie in meinen Fahrradkorb gelegt.",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "muzhik",
      "text": "Bevor ich losfuhr, dachte ich mir, wenn ich vom Fahrrad falle, geht die Flasche kaputt.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "muzhik",
      "text": "Deshalb habe ich beschlossen, die ganze Flasche sofort auszutrinken, bevor ich nach Hause fahre.",
      "emotion": "smug",
      "pauseAfterSec": 0.7,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "Und wissen Sie, das war eine verdammt richtige Entscheidung, denn ich bin auf dem Heimweg siebenmal hingefallen.",
      "emotion": "happy",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
