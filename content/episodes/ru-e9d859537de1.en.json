    {
      "id": "l1",
      "character": "narrator",
      "text": "A new drug is being tested. The patients are split into two groups, the test group and the control group. One of the patients comes in to see the doctor.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "muzhik",
      "text": "Doctor, why did you switch my medication?",
      "emotion": "angry",
      "pauseAfterSec": 0.3,
      "enter": [
        "muzhik"
      ],
      "exit": []
    },
    {
      "id": "l3",
      "character": "doktor",
      "text": "And what makes you think I switched it?",
      "emotion": "surprised",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "Well, you see, before, when I threw these pills down the toilet, they floated, and now all of a sudden they sink.",
      "emotion": "smug",
