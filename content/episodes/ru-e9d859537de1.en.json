  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "A new drug is being tested. The patients are split into two groups, the test group and the control group.",
      "emotion": "neutral",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l1b",
      "character": "narrator",
      "text": "One of the patients comes in to see the doctor.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "muzhik",
      "text": "Doctor, why did you switch my medication?",
      "emotion": "angry",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "doktor",
      "text": "And what makes you think I switched it?",
      "emotion": "surprised",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "Well, you see, before, when I threw these pills down the toilet,",
      "emotion": "smug",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l4b",
      "character": "muzhik",
      "text": "they floated, and now all of a sudden they sink.",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
