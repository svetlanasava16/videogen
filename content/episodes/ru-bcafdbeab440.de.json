  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein Mann rast im Cabrio über den Highway, die Polizei dicht hinter ihm.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "muzhik",
      "text": "Ha! Mit dem Wagen kriegen die mich nie!",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "muzhik",
      "text": "Zweihundertvierzig, und die kleben immer noch an mir. Na gut, ich gebe auf.",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "sluzhivy",
      "text": "Guten Tag. Heute ist mein letzter Arbeitstag vor der Pension, und ich habe keine Lust auf Strafzettel.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [
        "sluzhivy"
      ],
      "exit": []
    },
    {
      "id": "l5",
      "character": "sluzhivy",
      "text": "Liefern Sie mir eine gute Ausrede, dann lasse ich Sie fahren.",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "muzhik",
      "text": "Wissen Sie, letzte Woche ist meine Frau mit einem Polizisten durchgebrannt.",
      "emotion": "sad",
      "pauseAfterSec": 0.7,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "muzhik",
      "text": "Ich dachte, Sie wollen sie mir zurückbringen!",
      "emotion": "surprised",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    }
  ],
  "format": {
    "width": 1080,
