{
  "id": "ru-bcafdbeab440.de",
  "jokeId": "ru-bcafdbeab440",
  "locale": "de",
  "title": "Letzter Diensttag",
  "kind": "joke",
  "v": 2,
  "location": "doroga",
  "place": "road",
  "cast": [
    "muzhik",
    "sluzhivy"
  ],
  "roles": {
    "muzhik": "driver",
    "sluzhivy": "traffic-cop"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein Mann fährt im offenen Mercedes über die Autobahn. Die Sonne scheint, alles bestens.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Plötzlich taucht aus dem Nichts ein Polizeiwagen auf und nimmt die Verfolgung auf.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "muzhik",
      "text": "Mit so einem Auto! Die holen mich nie ein...",
      "emotion": "smug",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "narrator",
      "text": "Er gibt Gas, schon über hundertsechzig. Die Polizei bleibt dran.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "Hundertneunzig, die Polizei bleibt dran. Er tritt das Pedal durch, volle zweihundertvierzig. Die Polizei bleibt dran.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "Er muss aufgeben und hält auf dem Seitenstreifen.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l7",
      "character": "sluzhivy",
      "text": "Guten Tag, mein Herr. Heute ist mein letzter Diensttag, ich gehe in Pension.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l8",
      "character": "sluzhivy",
      "text": "Deshalb habe ich keine große Lust, Strafzettel zu schreiben.",
      "emotion": "smug",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l8b",
      "character": "sluzhivy",
      "text": "Wenn Ihnen eine gute Erklärung einfällt, lasse ich Sie fahren.",
      "emotion": "smug",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l9",
      "character": "muzhik",
      "text": "Oh!",
      "emotion": "surprised",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l9b",
      "character": "muzhik",
      "text": "Wissen Sie, vor einer Woche ist meine Frau mit einem Polizisten durchgebrannt,",
      "emotion": "surprised",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l9c",
      "character": "muzhik",
      "text": "und ich dachte, Sie wollen sie mir zurückbringen...",
      "emotion": "surprised",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
