  "lines": [
    {
      "id": "l1",
      "character": "devushka",
      "text": "How are you?",
      "emotion": "neutral",
      "pauseAfterSec": 0.2
    },
    {
      "id": "l2",
      "character": "devushka-blondinka",
      "text": "Wonderful! You know, my lover promised to buy me a mink coat...",
      "emotion": "smug",
      "pauseAfterSec": 0.2
    },
    {
      "id": "l3",
      "character": "devushka",
      "text": "Fantastic!",
      "emotion": "happy",
      "pauseAfterSec": 0.2
    },
    {
      "id": "l4",
      "character": "devushka-blondinka",
      "text": "...and he also promised to buy me a Jaguar...",
      "emotion": "smug",
      "pauseAfterSec": 0.2
    },
    {
      "id": "l5",
      "character": "devushka",
      "text": "Fantastic!",
      "emotion": "happy",
      "pauseAfterSec": 0.2
    },
    {
      "id": "l6",
      "character": "devushka-blondinka",
      "text": "...and we're going on holiday to the Canary Islands together!",
      "emotion": "happy",
      "pauseAfterSec": 0.2
    },
    {
      "id": "l7",
      "character": "devushka",
      "text": "Fantastic!",
      "emotion": "happy",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l8",
      "character": "devushka-blondinka",
      "text": "And what's new with you?",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l9",
      "character": "devushka",
      "text": "I'm studying at a school of good manners.",
      "emotion": "smug",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l10",
      "character": "devushka-blondinka",
      "text": "And what do they teach you there?",
      "emotion": "surprised",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l11",
      "character": "devushka",
      "text": "Well, for example, in the last class they taught us to say,",
      "uncensored": "Well, for example, in the last class they taught us to say,",
      "emotion": "smug",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l11b",
      "character": "devushka",
      "text": "instead of “Bullcrap!”, “Fantastic!”",
      "uncensored": "instead of “Bullshit!”, “Fantastic!”",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
