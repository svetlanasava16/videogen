  "cast": [
    "vovochka-drug",
    "paren"
  ],
  "roles": {
    "vovochka-drug": "child",
    "paren": "everyman"
  },
  "lines": [
    {
      "id": "l1",
      "character": "vovochka-drug",
      "text": "Скажите, эта змея ядовитая?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "paren",
      "text": "Нет, эта змея совсем не ядовитая.",
      "emotion": "smug",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "Мальчик берёт змею в руки, она его кусает, у мальчика начинаются судороги и пена изо рта, а остальные дети в ужасе смотрят.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l4",
      "character": "paren",
      "text": "Но эта змея ядоносная.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "paren",
      "text": "Ядовитое отравляет, если его съесть или потрогать, а ядоносное само впрыскивает яд.",
      "emotion": "smug",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l6",
      "character": "paren",
      "text": "В следующий раз давайте точнее, ребята.",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
