  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Zwei Ballonflieger müssen notlanden.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "sluzhivy",
      "text": "Wo sind wir hier?",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "Der Mann überlegt sehr lange.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l4",
      "character": "doktor",
      "text": "In einem Korb.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l5",
      "character": "sluzhivy-ryadovoy",
      "text": "Das war garantiert ein Psychologe!",
      "emotion": "smug",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l6",
      "character": "sluzhivy",
      "text": "Wie kommst du darauf?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l7",
      "character": "sluzhivy-ryadovoy",
      "text": "Ist doch klar.",
      "emotion": "smug",
      "pauseAfterSec": 0.2
    },
    {
      "id": "l8",
      "character": "sluzhivy-ryadovoy",
      "text": "Erstens dauerte es eine Ewigkeit, bis er antwortet.",
      "emotion": "neutral",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l9",
      "character": "sluzhivy-ryadovoy",
      "text": "Zweitens ist die Antwort völlig richtig und drittens völlig unbrauchbar!",
      "emotion": "angry",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
