      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "Dead silence in the cabin. A minute later, the radio comes on again.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "sluzhivy",
      "text": "My apologies to our dear passengers. It's just that our flight attendant spilled hot coffee on me.",
      "emotion": "sad",
