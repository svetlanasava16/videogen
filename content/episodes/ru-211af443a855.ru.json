  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Американский анекдот. В магазине игрушек покупатель интересуется куклами Барби.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "barmen",
      "text": "Это Барби в бассейне — восемнадцать долларов девяносто девять центов.",
      "emotion": "happy",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "barmen",
      "text": "Это Барби в колледже — восемнадцать долларов девяносто девять центов.",
      "emotion": "happy",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "barmen",
      "text": "А это — разведенная Барби — сто девяносто девять долларов девяносто девять центов.",
      "emotion": "smug",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "muzhik",
      "text": "Сколько?!",
      "emotion": "surprised",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l6",
      "character": "barmen",
      "text": "В комплект «Разведенная Барби» входит домик Кена, машина Кена и вертолет Кена.",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
