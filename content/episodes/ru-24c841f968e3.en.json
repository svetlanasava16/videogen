{
  "id": "ru-24c841f968e3.en",
  "jokeId": "ru-24c841f968e3",
  "locale": "en",
  "title": "I Know Everything",
  "location": "gostinaya",
  "place": "home-living-room",
  "cast": [
    "vovochka",
    "zhena",
    "muzhik"
  ],
  "roles": {
    "vovochka": "vovochka",
    "zhena": "mother",
    "muzhik": "father"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Little Johnny's friends told him that every grown-up has some kind of secret, and that's why they're very easy to blackmail.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Johnny decided to test it.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "vovochka",
      "text": "I know everything!",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "narrator",
      "text": "Mom went pale and slipped Johnny twenty dollars.",
      "emotion": "neutral",
      "pauseAfterSec": 0.2,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "zhena",
      "text": "Just don't tell Dad!",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "Johnny liked that a lot.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "vovochka",
      "text": "I know everything!",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "narrator",
      "text": "Dad glanced around nervously and gave Johnny fifty dollars.",
      "emotion": "neutral",
      "pauseAfterSec": 0.2,
      "enter": [],
      "exit": []
    },
    {
      "id": "l9",
      "character": "muzhik",
      "text": "Not a word to Mom!",
      "emotion": "surprised",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": [],
      "laugh": "chuckle"
    },
    {
      "id": "l10",
      "character": "narrator",
      "text": "In the morning Johnny met the postman at the garden gate.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l11",
      "character": "vovochka",
      "text": "I know everything!",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l12",
      "character": "narrator",
      "text": "The postman dropped his bag, a tear glistened on his cheek, and he opened his arms for a hug.",
      "emotion": "neutral",
      "pauseAfterSec": 0.6,
      "enter": [],
      "exit": []
    },
    {
      "id": "l13",
      "character": "paren",
      "text": "Then come and hug your daddy, son!",
      "emotion": "happy",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
