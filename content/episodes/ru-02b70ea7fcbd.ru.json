  "locale": "ru",
  "title": "Голосование",
  "kind": "joke",
  "v": 2,
  "location": "bolnitsa",
  "place": "doctor-office",
  "cast": [
    "doktor",
    "muzhik"
  ],
  "roles": {
    "doktor": "doctor",
    "muzhik": "patient"
  },
  "lines": [
    {
      "id": "l1",
      "character": "muzhik",
      "text": "Доктор, я слышал, что можно сделать такую операцию,",
      "emotion": "sad",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l1b",
      "character": "muzhik",
      "text": "что потом детей уже никак не может быть.",
      "emotion": "sad",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "muzhik",
      "text": "Вот сделайте мне такую.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "doktor",
      "text": "Ну, мой дорогой, такие решения с кондачка не принимают.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "doktor",
      "text": "Сегодня вы детей не хотите, а завтра захотите.",
      "emotion": "smug",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "doktor",
      "text": "Взвесьте все, обсудите с семьей...",
      "emotion": "neutral",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l6",
      "character": "muzhik",
      "text": "Да уж обсуждали. Голосование такое: два против, семнадцать за.",
      "emotion": "sad",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
  "explicit": false,
