  "locale": "de",
  "title": "Angler am See",
  "kind": "joke",
  "v": 2,
  "location": "derevnya",
  "place": "river-lake",
  "cast": [
    "batyushka",
    "muzhik-ryzhy"
  ],
  "roles": {
    "batyushka": "priest",
    "muzhik-ryzhy": "fisherman"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Auf dem Weg zwischen Kirche und Friedhof kommt der Leichenzug an einem See vorbei, an dem ein Angler sitzt.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Dieser sieht den Zug, steht auf, nimmt seinen Hut ab und verneigt sich vor dem Leichenzug.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "Nach der Beerdigung kommt der Pfarrer auf dem Rückweg wieder an dem See vorbei.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "batyushka",
      "text": "Diese Geste von dem Angler fand ich gerade toll, ich muss ihn mal darauf ansprechen.",
      "emotion": "happy",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "batyushka",
      "text": "Ihre Geste vorhin hat mich wirklich beeindruckt.",
      "emotion": "happy",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l6",
      "character": "muzhik-ryzhy",
      "text": "Ach wissen Sie, Herr Pfarrer, wenn man dreißig Jahre miteinander verheiratet war...",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
  "explicit": false,
