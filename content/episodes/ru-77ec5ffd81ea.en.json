  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Little Red Riding Hood was walking and walking through the forest. Suddenly she sees the Big Bad Wolf sitting under a tree.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "devochka",
      "text": "What big eyes you have, Wolf!",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "The Wolf jumped up and ran away.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "narrator",
      "text": "Little Red Riding Hood walks on. She crosses a forest stream. Suddenly she sees the Wolf hiding behind a stump.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "devochka",
      "text": "What big ears you have, Wolf!",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "The Wolf just shot her a glare. And ran off.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "narrator",
      "text": "She walks on. She pushes through the thicket. And look! There in the thicket, under a little pine, sits the Wolf.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "devochka",
      "text": "What big teeth you have, Wolf!",
      "emotion": "happy",
      "pauseAfterSec": 0.6,
      "enter": [],
      "exit": []
    },
    {
      "id": "l9",
      "character": "pyos",
      "text": "Freaking heck, will you let me take a crap or not?",
      "uncensored": "Fucking hell, will you let me take a shit or not?",
