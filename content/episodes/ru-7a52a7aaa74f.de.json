  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Familienessen. Ein Vater und seine drei Söhne.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "muzhik",
      "text": "Iss deine Suppe ordentlich! Hör auf, darin herumzustochern!",
      "emotion": "angry",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "paren",
      "text": "Was brüllst du denn so?",
      "emotion": "angry",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "Ich brülle? Du Frechdachs!",
      "emotion": "angry",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "Der Älteste kriegt eine Kopfnuss. Der Mittlere nennt den Vater einen Tyrannen und kriegt auch eine. Der Jüngste legt den Löffel weg und hält sich die Ohren zu.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "muzhik",
      "text": "Und du? Du isst brav, bist höflich, widersprichst nie. Wovor hast du Angst?",
      "emotion": "surprised",
      "pauseAfterSec": 0.7,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "vovochka",
      "text": "Ich weiß, dass ich höflich bin. Nur für alle Fälle. Du bist ja so ein Idiot.",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    }
  ],
  "format": {
    "width": 1080,
