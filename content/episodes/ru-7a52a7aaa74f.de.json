  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Familienessen. Am Tisch der Vater und die Söhne. Plötzlich sagt der Vater zum Ältesten:",
      "emotion": "neutral",
      "pauseAfterSec": 0
    },
    {
      "id": "l2",
      "character": "muzhik",
      "text": "Iss deine Suppe ordentlich!",
      "emotion": "angry",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l2b",
      "character": "muzhik",
      "text": "Was stocherst du da so lustlos rum, das ist ja widerlich anzusehen!",
      "emotion": "angry",
      "pauseAfterSec": 0
    },
    {
      "id": "l3",
      "character": "paren",
      "text": "Was schreist du denn so rum?",
      "emotion": "angry",
      "pauseAfterSec": 0
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "Ich schreie rum? Du Mistkerl!",
      "emotion": "angry",
      "pauseAfterSec": 0
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "Und zack, eine Kopfnuss! Der zweite Sohn mischt sich ein:",
      "emotion": "surprised",
      "pauseAfterSec": 0
    },
    {
      "id": "l6",
      "character": "vovochka-drug",
      "text": "Papa, wenn jemand nicht essen will,",
      "emotion": "sad",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l6c",
      "character": "vovochka-drug",
      "text": "warum zwingst du ihn dann und schlägst ihn auch noch?",
      "emotion": "sad",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l6b",
      "character": "vovochka-drug",
      "text": "Du bist ja wie ein Tyrann.",
      "emotion": "sad",
      "pauseAfterSec": 0
    },
    {
      "id": "l7",
      "character": "muzhik",
      "text": "Ich ein Tyrann? Du Lump!",
      "emotion": "angry",
      "pauseAfterSec": 0
    },
    {
      "id": "l8",
      "character": "narrator",
      "text": "Und zack-zack, gibt's was auf die Ohren.",
      "emotion": "surprised",
      "pauseAfterSec": 0
    },
    {
      "id": "l9",
      "character": "narrator",
      "text": "Da legt der Jüngste den Löffel weg und hält sich die Ohren zu. Der Vater:",
      "emotion": "neutral",
      "pauseAfterSec": 0
    },
    {
      "id": "l10",
      "character": "muzhik",
      "text": "Und warum hältst du dir die Ohren zu?",
      "emotion": "surprised",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l10b",
      "character": "muzhik",
      "text": "Du isst schön, bist höflich,",
      "emotion": "surprised",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l10c",
      "character": "muzhik",
      "text": "widersprichst deinem Vater nicht, wovor hast du denn Angst?",
      "emotion": "surprised",
      "pauseAfterSec": 0
    },
    {
      "id": "l11",
      "character": "vovochka",
      "text": "Ich weiß ja, dass ich höflich bin.",
      "uncensored": "Ich weiß ja, dass ich höflich bin.",
      "emotion": "smug",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l11b",
      "character": "vovochka",
      "text": "Das ist nur für alle Fälle, du bist ja so ein Blödmann...",
      "uncensored": "Das ist nur für alle Fälle, du bist ja so ein Arschloch...",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
