  "locale": "de",
  "title": "Im Zug",
  "kind": "joke",
  "v": 2,
  "location": "samolet",
  "place": "train",
  "cast": [
    "muzhik",
    "muzhik-sosed"
  ],
  "roles": {
    "muzhik": "everyman",
    "muzhik-sosed": "customer"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Eine Unterhaltung im Bahnabteil eines ICE.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "muzhik-sosed",
      "text": "Auf was kauen Sie denn da ständig herum?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "muzhik",
      "text": "Auf Apfelkernen.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "muzhik-sosed",
      "text": "Und wozu soll das gut sein?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "muzhik",
      "text": "Es fördert die Intelligenz.",
      "emotion": "smug",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l6",
      "character": "muzhik-sosed",
      "text": "Aha, können Sie mir auch vier Stück geben?",
      "emotion": "happy",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l7",
      "character": "muzhik",
      "text": "Gerne. Vier Stück kosten acht Euro.",
      "emotion": "smug",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l8",
      "character": "narrator",
      "text": "Der Fahrgast zahlt und bekommt die Kerne. Nach einer Weile des Kauens meint er:",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l9",
      "character": "muzhik-sosed",
      "text": "Für acht Euro hätte ich mir aber jede Menge Äpfel kaufen können!",
      "emotion": "angry",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l10",
      "character": "muzhik",
      "text": "Sehen Sie, die Kerne wirken schon!",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
