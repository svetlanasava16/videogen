      "id": "l1",
      "character": "narrator",
      "text": "Frau Müller hat nach zehn Jahren Ehe ihren Mann betrogen.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Weil sie der Fehler sehr belastet, will sie sich die Erinnerung daran bei einem Hypnotiseur löschen lassen.",
