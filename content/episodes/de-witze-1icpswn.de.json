  ],
  "roles": {
    "uchilka": "clerk",
    "zhena": "wife",
    "doktor": "therapist"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Frau Müller hat nach zehn Jahren Ehe ihren Mann betrogen.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Weil sie der Fehler sehr belastet, will sie sich die Erinnerung daran bei einem Hypnotiseur löschen lassen.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "Der Empfangsdame in der Praxis erklärt sie ihre Gründe.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "zhena",
      "text": "Ich habe ein einziges Mal in zehn Jahren einen Fehler gemacht.",
      "emotion": "sad",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "zhena",
      "text": "Ich möchte nicht, dass er mein ganzes Leben ruiniert.",
      "emotion": "sad",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "Plötzlich betritt der Hypnotiseur den Raum.",
      "emotion": "neutral",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l7",
      "character": "doktor",
      "text": "Ach, Frau Müller! Sie schon wieder?!",
      "emotion": "surprised",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
