      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "Der Empfangsdame in der Praxis erklärt sie ihre Gründe.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "zhena",
      "text": "Ich habe ein einziges Mal in zehn Jahren einen Fehler gemacht.",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "zhena",
      "text": "Ich möchte nicht, dass er mein ganzes Leben ruiniert.",
