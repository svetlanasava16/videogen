  "locale": "de",
  "title": "Die größte Lüge",
  "kind": "joke",
  "v": 2,
  "location": "klass",
  "place": "school-classroom",
  "cast": [
    "vovochka",
    "vovochka-drug",
    "uchilka"
  ],
  "roles": {
    "vovochka": "child",
    "vovochka-drug": "child",
    "uchilka": "teacher"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Zwei Jungen streiten sich, als die Lehrerin ins Klassenzimmer kommt.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "uchilka",
      "text": "Worüber streitet ihr zwei denn?",
      "emotion": "angry",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "vovochka",
      "text": "Wir haben einen Zehn-Euro-Schein gefunden und abgemacht:",
      "emotion": "smug",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l3b",
      "character": "vovochka",
      "text": "Wer die größte Lüge erzählt, darf ihn behalten.",
      "emotion": "smug",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "uchilka",
      "text": "Ihr solltet euch schämen, alle beide.",
      "emotion": "angry",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "uchilka",
      "text": "Als ich in eurem Alter war, wusste ich nicht einmal, was eine Lüge ist.",
      "emotion": "smug",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "Die Jungen sahen sich an und gaben der Lehrerin die zehn Euro.",
      "emotion": "neutral",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
