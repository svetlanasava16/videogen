    "paren": "student",
    "uchilka": "teacher"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Zwei Jungen streiten sich, als die Lehrerin ins Klassenzimmer kommt.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "uchilka",
      "text": "Worüber streitet ihr zwei?",
      "emotion": "angry",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "vovochka",
      "text": "Wir haben einen Zehn-Euro-Schein gefunden und beschlossen: Wer die größte Lüge erzählt, darf ihn behalten.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "uchilka",
      "text": "Ihr beiden solltet euch schämen.",
      "emotion": "angry",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "uchilka",
      "text": "Als ich in eurem Alter war, wusste ich nicht einmal, was eine Lüge ist.",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "Die Jungen sahen sich an und gaben der Lehrerin die zehn Euro.",
      "emotion": "neutral",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
