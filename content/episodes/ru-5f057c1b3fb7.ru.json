  ],
  "roles": {
    "nachalnik": "new-russian",
    "muzhik-ryzhy": "gangster",
    "muzhik": "everyman"
  },
  "lines": [
    {
      "id": "l1",
      "character": "muzhik",
      "text": "Ребята, это не ваш бультерьер тут бегает?!",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "nachalnik",
      "text": "Ну наш, и чё тебе надо?",
      "uncensored": "Ну наш, и хули тебе надо?",
      "emotion": "angry",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "muzhik",
      "text": "Понимаете, мы тут тоже рядом отдыхаем, и моя собачка случайно убила вашу!",
      "emotion": "sad",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "muzhik-ryzhy",
      "text": "Да ну нафиг!? А чо у тебя за зверь?",
      "uncensored": "Да ну на хуй!? А чо у тебя за зверь?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "muzhik",
      "text": "Да маленький такой пуделёк!",
      "emotion": "neutral",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l6",
      "character": "muzhik",
      "text": "А ваш им подавился!",
      "emotion": "sad",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
