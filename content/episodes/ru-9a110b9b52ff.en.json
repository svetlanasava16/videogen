  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Once a war veteran was invited to a third-grade history lesson.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "uchilka",
      "text": "Tell us about the battle you remember most.",
      "emotion": "happy",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "ded",
      "text": "Well, so, we got surrounded near Minsk.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "ded",
      "text": "Holy crap, Germans on the left, holy crap, Germans on the right, and Germans up front.",
      "uncensored": "Holy shit, Germans on the left, holy shit, Germans on the right, and Germans up front.",
      "emotion": "angry",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "uchilka",
      "text": "These are children!",
      "emotion": "surprised",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l6",
      "character": "ded",
      "text": "What freaking children?! Fascists!",
      "uncensored": "What fucking children?! Fascists!",
      "emotion": "angry",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
