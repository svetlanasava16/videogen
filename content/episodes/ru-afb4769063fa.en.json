  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "A man is listening to the weather forecast. They say: in Siberia it's forty-five below.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Well, he doesn't believe it, and calls his friend in Siberia.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "muzhik",
      "text": "Listen, they say it's terribly cold over there?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "muzhik-sosed",
      "text": "Nah, twenty below, twenty-five below.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "muzhik",
      "text": "Really? But on TV they said forty-five below?",
      "emotion": "surprised",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l6",
      "character": "muzhik-sosed",
      "text": "Ahh... Well, that's probably outside!",
      "emotion": "happy",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
