  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "A scorching day. A man carries a big can of beer home from the sauna, kicks an old bottle, and out pops a genie.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "chort",
      "text": "Your wish is my command!",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [
        "chort"
      ],
      "exit": []
    },
    {
      "id": "l3",
      "character": "muzhik",
      "text": "I wish the beer in this can would never run out!",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "chort",
      "text": "Granted!",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": [
        "chort"
      ]
    },
    {
      "id": "l5",
      "character": "muzhik",
      "text": "Well, cheers. Hang on. How do you open this thing?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "Ten years later.",
      "emotion": "neutral",
      "pauseAfterSec": 0.7,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "muzhik",
      "text": "Still can't open it. But the beer never runs out. He kept his word.",
      "emotion": "sad",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    }
  ],
