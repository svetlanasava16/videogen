  "locale": "en",
  "title": "The Endless Canister",
  "kind": "joke",
  "v": 2,
  "location": "doroga",
  "place": "road",
  "cast": [
    "muzhik",
    "chort"
  ],
  "roles": {
    "muzhik": "everyman",
    "chort": "genie"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Summer, sun, heat... A man is walking home from the bathhouse with a canister of beer. He's looking forward to a cold beer at home...",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "There's a bottle lying on the road; the man kicks it, and it smashes on a rock.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "As usual: a genie, a wish.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "I want the beer in this canister to never run out.",
      "emotion": "happy",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "The genie works a little magic and vanishes.",
      "emotion": "neutral",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "And the man is still trying to open the canister.",
      "emotion": "neutral",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
  "explicit": false,
