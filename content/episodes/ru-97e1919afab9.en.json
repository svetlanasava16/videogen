  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Summer, sun, heat. A man is walking home from the sauna with a canister of beer, looking forward to a cold one at home.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "There's a bottle lying on the road. The man kicks it, and it smashes on a rock.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "As usual: a genie, a wish.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [
        "chort"
      ],
      "exit": []
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "I want the beer in this canister never to run out.",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "The genie works his magic and vanishes.",
      "emotion": "neutral",
      "pauseAfterSec": 0.7,
      "enter": [],
      "exit": [
        "chort"
      ]
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "And the man is still trying to open the canister.",
      "emotion": "neutral",
      "pauseAfterSec": 0.8,
