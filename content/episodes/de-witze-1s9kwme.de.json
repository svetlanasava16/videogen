{
  "id": "de-witze-1s9kwme.de",
  "jokeId": "de-witze-1s9kwme",
  "locale": "de",
  "title": "Der Fotograf im Flugzeug",
  "kind": "joke",
  "v": 2,
  "location": "samolet",
  "place": "plane",
  "cast": [
    "paren",
    "sluzhivy"
  ],
  "roles": {
    "paren": "journalist",
    "sluzhivy": "pilot"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein Fotograf einer Natur- und Wissenschaftszeitschrift erhielt den Auftrag, Fotos von einem großen Waldbrand zu machen.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Sein Verleger hatte ein kleines Flugzeug für ihn gemietet, damit er ein paar Luftaufnahmen machen konnte.",
      "emotion": "neutral",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l2b",
      "character": "narrator",
      "text": "Der Pilot wartete bereits auf einem lokalen Flugplatz in der Nähe.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "paren",
      "text": "Komm schnell! Wir fliegen sofort los!",
      "emotion": "surprised",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "narrator",
      "text": "Während das Flugzeug abhob, gab der Fotograf dem Piloten Anweisungen:",
      "emotion": "neutral",
      "pauseAfterSec": 0.2
    },
    {
      "id": "l5",
      "character": "paren",
      "text": "Ich möchte, dass du über die Nordseite des Brandherds fliegst und drei- oder viermal ganz tief darüber hinwegfliegst.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l6",
      "character": "sluzhivy",
      "text": "Warum?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l7",
      "character": "paren",
      "text": "Was meinst du mit warum?",
      "emotion": "angry",
      "pauseAfterSec": 0.2
    },
    {
      "id": "l8",
      "character": "paren",
      "text": "Damit ich ein paar Fotos machen kann natürlich!",
      "emotion": "angry",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l8b",
      "character": "paren",
      "text": "Ich bin Fotograf, und ein Fotograf macht Fotos!",
      "emotion": "angry",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l9",
      "character": "sluzhivy",
      "text": "Du meinst also... dass du nicht der Fluglehrer bist?",
      "emotion": "surprised",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
