  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein Fotograf soll einen großen Waldbrand von oben fotografieren. Am Flugplatz wartet schon eine kleine Maschine.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "paren",
      "text": "Schnell! Wir fliegen sofort los!",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [
        "paren"
      ],
      "exit": []
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "Die Maschine hebt ab.",
      "emotion": "neutral",
      "pauseAfterSec": 0.2,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "paren",
      "text": "Flieg über die Nordseite des Brandes. Drei- oder viermal, ganz tief.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "sluzhivy",
      "text": "Warum?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "paren",
      "text": "Was heißt hier warum? Damit ich Fotos machen kann! Ich bin Fotograf, und ein Fotograf macht Fotos!",
      "emotion": "angry",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "sluzhivy",
      "text": "Du meinst also... du bist gar nicht mein Fluglehrer?",
      "emotion": "surprised",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    }
  ],
