  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Пожарные только что потушили пожар в больнице.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "sluzhivy-ryadovoy",
      "text": "Товарищ главврач, задача выполнена. Возгорание ликвидировано.",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [
        "sluzhivy-ryadovoy"
      ],
      "exit": []
    },
    {
      "id": "l3",
      "character": "sluzhivy-ryadovoy",
      "text": "Правда, есть пострадавшие. Девять человек.",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "sluzhivy-ryadovoy",
      "text": "Семерых мы откачали.",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "sluzhivy-ryadovoy",
      "text": "А двоих, к сожалению, спасти не удалось.",
      "emotion": "sad",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "doktor",
      "text": "Как семерых?!",
      "emotion": "surprised",
      "pauseAfterSec": 0.7,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "doktor",
      "text": "Ребята, вы же морг тушили!",
      "emotion": "surprised",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    }
  ],
