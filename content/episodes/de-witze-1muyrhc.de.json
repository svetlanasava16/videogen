  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Horst kommt in die Hölle.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "chort",
      "text": "Du darfst dir aussuchen, in welchem Zimmer du die Ewigkeit verbringst.",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "chort",
      "text": "Zimmer eins: Handstand auf glühenden Kohlen.",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "chort",
      "text": "Zimmer zwei: Handstand auf rostigen Nägeln.",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "chort",
      "text": "Zimmer drei: Alle stehen knietief in Jauche und trinken Kaffee.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "muzhik",
      "text": "Das ist gar nicht so schlecht. Ich nehme das dritte.",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "chort",
      "text": "Wie du willst.",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": [
        "chort"
      ]
    },
    {
      "id": "l8",
      "character": "narrator",
      "text": "Horst nimmt sich eine Tasse. Nach ein paar Minuten geht die Tür auf.",
      "emotion": "neutral",
      "pauseAfterSec": 0.6,
      "enter": [],
      "exit": []
    },
    {
      "id": "l9",
      "character": "chort",
      "text": "So, Jungs! Kaffeepause vorbei! Alle wieder auf die Hände!",
      "emotion": "angry",
      "pauseAfterSec": 0.8,
