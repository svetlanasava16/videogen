{
  "id": "de-witze-1muyrhc.de",
  "jokeId": "de-witze-1muyrhc",
  "locale": "de",
  "title": "Kaffeepause",
  "location": "nebesa",
  "place": "hell",
  "cast": [
    "chort",
    "muzhik"
  ],
  "roles": {
    "chort": "devil",
    "muzhik": "everyman"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Hannes kommt in die Hölle. Satan führt ihn in einen Flur mit drei Türen.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "chort",
      "text": "In einem dieser drei Zimmer wirst du nun die Ewigkeit verbringen, aber du darfst wählen, in welchem!",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "Satan öffnet die erste Tür. Dahinter müssen Dutzende Leute Handstand auf glühenden Kohlen machen.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "narrator",
      "text": "Dann zeigt Satan ihm das zweite Zimmer. In diesem machen unzählige Menschen Handstand auf rostigen Nägeln.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "Schließlich führt Satan ihn zum dritten Zimmer. Hier stehen alle knietief in Mist und trinken Kaffee.",
      "uncensored": "Schließlich führt Satan ihn zum dritten Zimmer. Hier stehen alle knietief in Scheiße und trinken Kaffee.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "muzhik",
      "text": "Das ist gar nicht so schlecht. Dieses Zimmer nehme ich.",
      "emotion": "happy",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "narrator",
      "text": "Er gesellt sich zu den anderen in den Mist und nimmt sich eine Tasse.",
      "uncensored": "Er gesellt sich zu den anderen in die Scheiße und nimmt sich eine Tasse.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "narrator",
      "text": "Nach ein paar Minuten betritt ein Diener Satans das Zimmer.",
      "emotion": "neutral",
      "pauseAfterSec": 0.6,
      "enter": [],
      "exit": []
    },
    {
      "id": "l9",
      "character": "paren",
      "text": "So, Jungs! Kaffeepause vorbei! Alle wieder auf die Hände!",
      "emotion": "happy",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
