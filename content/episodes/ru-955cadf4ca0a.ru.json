  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Заходит студент на экзамен и без разговоров ставит на стол пузырь коньяка.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "doktor",
      "text": "Удовлетворительно.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "Студент вытаскивает коробку шоколадных конфет.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "doktor",
      "text": "Хорошо.",
      "emotion": "happy",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "Студент кладет сверху шикарную авторучку.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l6",
      "character": "doktor",
      "text": "Отлично.",
      "emotion": "happy",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l7",
      "character": "narrator",
      "text": "Экзаменатор пишет в зачетке. Студент забирает зачетку и сгребает все со стола.",
      "emotion": "neutral",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l8",
      "character": "paren",
      "text": "Теперь еще физику надо сдать.",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
