  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "An der Uni läuft eine Vorlesung über Arbeitsschutz.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "doktor",
      "text": "Sie sind Bauleiter auf einer Baustelle. Vor Ihren Augen stürzt ein Arbeiter vom Gerüst und ist sofort tot.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "doktor",
      "text": "Was tun Sie als Erstes?",
      "emotion": "neutral",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "paren",
      "text": "Einen Krankenwagen rufen!",
      "emotion": "surprised",
      "pauseAfterSec": 0.2,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "devushka",
      "text": "Die Polizei rufen!",
      "emotion": "surprised",
      "pauseAfterSec": 0.2,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "devushka-blondinka",
      "text": "Die Angehörigen benachrichtigen!",
      "emotion": "sad",
      "pauseAfterSec": 0.6,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "doktor",
      "text": "Setzen Sie der Leiche einen Helm auf und legen Sie ihr den Sicherheitsgurt an, sonst holt die Polizei Sie ab.",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "enter": [],
