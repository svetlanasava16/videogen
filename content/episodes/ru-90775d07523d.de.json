  "roles": {
    "paren": "student",
    "devushka": "student",
    "devushka-blondinka": "student",
    "doktor": "professor"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "An der Uni läuft eine Vorlesung über Arbeitsschutz.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "doktor",
      "text": "Sie sind Bauleiter auf einer Baustelle.",
      "emotion": "neutral",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l2b",
      "character": "doktor",
      "text": "Vor Ihren Augen stürzt ein Arbeiter vom Gerüst und ist sofort tot.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "doktor",
      "text": "Was tun Sie als Erstes?",
      "emotion": "neutral",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l4",
      "character": "paren",
      "text": "Einen Krankenwagen rufen!",
      "emotion": "surprised",
      "pauseAfterSec": 0.2
    },
    {
      "id": "l5",
      "character": "devushka",
      "text": "Die Polizei rufen!",
      "emotion": "surprised",
      "pauseAfterSec": 0.2
    },
    {
      "id": "l6",
      "character": "devushka-blondinka",
      "text": "Die Angehörigen benachrichtigen!",
      "emotion": "sad",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l7",
      "character": "doktor",
      "text": "Setzen Sie der Leiche einen Helm auf und legen Sie ihr den Sicherheitsgurt an,",
      "emotion": "smug",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l7b",
      "character": "doktor",
      "text": "sonst holt die Polizei Sie ab.",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
