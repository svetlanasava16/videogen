    {
      "id": "l1",
      "character": "narrator",
      "text": "Zwei Jäger gehen durch den Wald, als einer plötzlich zusammenbricht. Der andere ruft panisch den Notruf an.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "muzhik-ryzhy",
      "text": "Mein Freund ist tot! Was soll ich tun?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "uchilka",
      "text": "Beruhigen Sie sich. Erstmal müssen wir sichergehen, dass er wirklich tot ist.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "narrator",
      "text": "Stille am Telefon, dann hört man einen Schuss.",
      "emotion": "neutral",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "muzhik-ryzhy",
      "text": "Okay, und jetzt?",
      "emotion": "neutral",
      "pauseAfterSec": 0.8,
