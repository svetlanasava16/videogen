  "locale": "de",
  "title": "Scharfes Chili",
  "location": "bar",
  "place": "restaurant",
  "cast": [
    "muzhik",
    "barmen",
    "muzhik-ryzhy"
  ],
  "roles": {
    "muzhik": "everyman",
    "barmen": "waiter",
    "muzhik-ryzhy": "customer"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein Typ setzt sich in einen Imbiss.",
      "emotion": "neutral",
      "pauseAfterSec": 0.2,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "muzhik",
      "text": "Eine Schüssel scharfes Chili, bitte.",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "barmen",
      "text": "Tut mir leid, aber der Mann neben Ihnen hat die letzte Schüssel bekommen.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "narrator",
      "text": "Er schaut rüber: Der Mann ist fertig mit Essen, aber die Schüssel Chili ist noch voll.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "muzhik",
      "text": "Essen Sie das Chili noch?",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "muzhik-ryzhy",
      "text": "Nein. Bedienen Sie sich.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "narrator",
      "text": "Er zieht die Schüssel rüber und fängt an zu essen. Etwa bei der Hälfte stößt sein Löffel auf etwas.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "narrator",
      "text": "Er schaut hin, sieht eine tote Maus und kotzt sofort das ganze Chili zurück in die Schüssel.",
      "emotion": "surprised",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    },
    {
      "id": "l9",
      "character": "muzhik-ryzhy",
      "text": "Ja, genau so weit bin ich auch gekommen.",
      "emotion": "sad",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
  "explicit": false,
  "outroLaughs": [],
