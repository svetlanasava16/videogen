{
  "id": "en-r-5e81hx.de",
  "jokeId": "en-r-5e81hx",
  "locale": "de",
  "title": "Das Chili",
  "kind": "joke",
  "v": 2,
  "location": "bar",
  "place": "restaurant",
  "cast": [
    "muzhik",
    "muzhik-ryzhy",
    "devushka"
  ],
  "roles": {
    "muzhik": "customer",
    "muzhik-ryzhy": "customer",
    "devushka": "waiter"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein Mann setzt sich in ein Diner und bestellt eine Schüssel scharfes Chili.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "devushka",
      "text": "Tut mir leid, aber der Herr neben Ihnen hat die letzte Schüssel bekommen.",
      "emotion": "sad",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "Er schaut hinüber: Der Mann ist mit dem Essen fertig, aber die Schüssel Chili ist noch voll.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "Essen Sie das Chili noch?",
      "emotion": "happy",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "muzhik-ryzhy",
      "text": "Nein. Bedienen Sie sich.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "Er zieht die Schüssel zu sich und fängt an zu essen. Etwa auf halber Strecke stößt sein Löffel auf etwas.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l7",
      "character": "narrator",
      "text": "Er schaut nach unten, sieht eine tote Maus und kotzt sofort das ganze Chili zurück in die Schüssel.",
      "emotion": "surprised",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l8",
      "character": "muzhik-ryzhy",
      "text": "Ja, ungefähr so weit bin ich auch gekommen.",
      "emotion": "sad",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
  "explicit": false,
