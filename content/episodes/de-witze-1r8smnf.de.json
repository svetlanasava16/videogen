    {
      "id": "l1",
      "character": "narrator",
      "text": "Fritzchen kommt stark weinend und schluchzend zur Mutter.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "zhena",
      "text": "Fritzchen, was ist passiert?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "vovochka",
      "text": "Papa hat sich mit dem Hammer auf den Daumen gehauen!",
      "emotion": "sad",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "zhena",
      "text": "Na, dann brauchst du doch nicht weinen!",
      "emotion": "neutral",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l5",
      "character": "vovochka",
      "text": "Zuerst habe ich ja auch gelacht...",
      "emotion": "sad",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
