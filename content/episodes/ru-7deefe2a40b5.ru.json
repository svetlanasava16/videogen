{
  "id": "ru-7deefe2a40b5.ru",
  "jokeId": "ru-7deefe2a40b5",
  "locale": "ru",
  "title": "Как говорят моржи",
  "kind": "joke",
  "v": 2,
  "location": "klass",
  "place": "school-classroom",
  "cast": [
    "uchilka",
    "devochka",
    "paren",
    "vovochka"
  ],
  "roles": {
    "uchilka": "teacher",
    "devochka": "child",
    "paren": "student",
    "vovochka": "vovochka"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Урок природоведения в первом классе.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "uchilka",
      "text": "Дети, как разговаривают животные? Ну-ка, Маша, скажи?",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "devochka",
      "text": "Коровка кричит «Мууу».",
      "emotion": "happy",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "uchilka",
      "text": "Умница, Маша, садись, пять. А что ты скажешь, Миша?",
      "emotion": "happy",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "paren",
      "text": "Собачки говорят «Гав-гав».",
      "emotion": "happy",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l6",
      "character": "uchilka",
      "text": "Молодец, Миша, пять.",
      "emotion": "happy",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l7",
      "character": "narrator",
      "text": "Вовочка тянет руку, аж со стула падает.",
      "emotion": "neutral",
      "pauseAfterSec": 0.2
    },
    {
      "id": "l8",
      "character": "vovochka",
      "text": "Марь Иванна, Марь Иванна, а я знаю, как моржи разговаривают!",
      "emotion": "happy",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l9",
      "character": "uchilka",
      "text": "Ну и как же моржи разговаривают?",
      "emotion": "surprised",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l10",
      "character": "vovochka",
      "text": "Ой, блин, а вода-то какая холодна-а-ая!",
      "uncensored": "Ой, блядь, а вода-то какая холодна-а-ая!",
      "emotion": "surprised",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
