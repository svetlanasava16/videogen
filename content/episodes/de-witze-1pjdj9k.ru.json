{
  "id": "de-witze-1pjdj9k.ru",
  "jokeId": "de-witze-1pjdj9k",
  "locale": "ru",
  "title": "Интервью с фермером Хубертом",
  "kind": "joke",
  "v": 2,
  "location": "derevnya",
  "place": "farm",
  "cast": [
    "paren",
    "muzhik-ryzhy",
    "korova",
    "korova-chyornaya"
  ],
  "roles": {
    "paren": "journalist",
    "muzhik-ryzhy": "farmer",
    "korova": "cow",
    "korova-chyornaya": "cow"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Фермера Хуберта снимает местное телевидение. Беседуют, как и положено, прямо у коровьего луга.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l2",
      "character": "paren",
      "text": "Скажите-ка, господин фермер, сколько литров молока даёт такая корова в день?",
      "emotion": "happy",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "muzhik-ryzhy",
      "text": "Бурая корова или чёрная корова?",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "paren",
      "text": "Бурая.",
      "emotion": "neutral",
      "pauseAfterSec": 0.2
    },
    {
      "id": "l5",
      "character": "muzhik-ryzhy",
      "text": "Почти тридцать литров.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l6",
      "character": "paren",
      "text": "А чёрная?",
      "emotion": "neutral",
      "pauseAfterSec": 0.2
    },
    {
      "id": "l7",
      "character": "muzhik-ryzhy",
      "text": "Тоже.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l8",
      "character": "paren",
      "text": "А что они едят целый день?",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l9",
      "character": "muzhik-ryzhy",
      "text": "Бурая или чёрная?",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l10",
      "character": "paren",
      "text": "Чёрная.",
      "emotion": "sad",
      "pauseAfterSec": 0.2
    },
    {
      "id": "l11",
      "character": "muzhik-ryzhy",
      "text": "Траву.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l12",
      "character": "paren",
      "text": "А бурая?",
      "emotion": "sad",
      "pauseAfterSec": 0.2
    },
    {
      "id": "l13",
      "character": "muzhik-ryzhy",
      "text": "Тоже.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l14",
      "character": "paren",
      "text": "Но если у обеих всегда всё одинаково, почему вы всё время спрашиваете, бурую я имею в виду или чёрную?",
      "emotion": "angry",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l15",
      "character": "muzhik-ryzhy",
      "text": "Так ведь бурая корова моя.",
      "emotion": "smug",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l16",
      "character": "paren",
      "text": "А чёрная?",
      "emotion": "surprised",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l17",
      "character": "muzhik-ryzhy",
      "text": "Тоже.",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
