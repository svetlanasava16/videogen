  "lines": [
    {
      "id": "l1",
      "character": "muzhik",
      "text": "А мой дед заранее знал, в какой день умрёт.",
      "emotion": "smug",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "muzhik",
      "text": "И даже час приблизительно.",
      "emotion": "smug",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l3",
      "character": "muzhik-sosed",
      "text": "Экстрасенс, что ли, был?",
      "emotion": "surprised",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "Какой к чёрту экстрасенс!",
      "emotion": "angry",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l5",
      "character": "muzhik",
      "text": "Судья ему сказал.",
      "emotion": "neutral",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
