  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Thanks to a new hearing aid, an eighty-year-old man can hear like a young man again.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "ded",
      "text": "Morning, Doctor. I'm here for my check-up.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [
        "ded"
      ],
      "exit": []
    },
    {
      "id": "l3",
      "character": "doktor",
      "text": "Well, everything looks perfect.",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "doktor",
      "text": "Your family must be thrilled you can hear again.",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "ded",
      "text": "Oh, I haven't told them yet.",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "ded",
      "text": "I just sit there and listen to them talk.",
      "emotion": "smug",
      "pauseAfterSec": 0.7,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "ded",
      "text": "I've changed my will three times already.",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    }
  ],
