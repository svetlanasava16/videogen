{
  "id": "ru-130c12be4fde.en",
  "jokeId": "ru-130c12be4fde",
  "locale": "en",
  "title": "The Hearing Aid",
  "kind": "joke",
  "v": 2,
  "location": "bolnitsa",
  "place": "doctor-office",
  "cast": [
    "ded",
    "doktor"
  ],
  "roles": {
    "ded": "old-man",
    "doktor": "doctor"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "An eighty-year-old man, who has heard almost nothing for many years, finally goes to see a specialist.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "The doctor easily fits him with a small hearing aid, and he hears again like when he was young.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "A month later the old man goes back to the doctor for a check-up.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "doktor",
      "text": "Well then, everything is in perfect order.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "doktor",
      "text": "Tell me, your family must be thrilled that you can hear perfectly again?",
      "emotion": "happy",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l6",
      "character": "ded",
      "text": "Oh, I haven't told them anything yet. I just sit and listen to their conversations.",
      "emotion": "smug",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l7",
      "character": "ded",
      "text": "I've already had to change my will three times...",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
  "explicit": false,
