  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Однажды ученик приходит в кабинет директора.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "nachalnik",
      "text": "Как тебя зовут, сынок?",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "vovochka",
      "text": "Д-д-д-дав-дав-Давид.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l4",
      "character": "nachalnik",
      "text": "О, ты заикаешься?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "vovochka",
      "text": "Нет, это мой папа заикается,",
      "emotion": "neutral",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l6",
      "character": "vovochka",
      "text": "а вот тот, кто записывал моё имя, был козлом.",
      "uncensored": "а вот тот, кто записывал моё имя, был мудаком.",
      "emotion": "angry",
      "pauseAfterSec": 0.8,
