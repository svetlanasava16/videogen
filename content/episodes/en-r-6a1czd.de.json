  "locale": "de",
  "title": "Von Studenten gebaut",
  "kind": "joke",
  "v": 2,
  "location": "samolet",
  "place": "plane",
  "cast": [
    "devushka-blondinka",
    "doktor"
  ],
  "roles": {
    "devushka-blondinka": "flight-attendant",
    "doktor": "professor"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Eine Gruppe von Ingenieurprofessoren wurde zu einem Flug eingeladen.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "devushka-blondinka",
      "text": "Dieses Flugzeug haben Ihre Studenten gebaut.",
      "emotion": "happy",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "Alle bis auf einen sprangen von ihren Sitzen und stürzten in heller Panik zu den Ausgängen.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l4",
      "character": "devushka-blondinka",
      "text": "Warum sind Sie sitzen geblieben?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "doktor",
      "text": "Ich habe vollstes Vertrauen in meine Studenten.",
      "emotion": "smug",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l6",
      "character": "doktor",
      "text": "So wie ich sie kenne, kann ich Ihnen versichern: Diese Mistkiste springt nicht einmal an.",
      "uncensored": "So wie ich sie kenne, kann ich Ihnen versichern: Diese Scheißkiste springt nicht einmal an.",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
