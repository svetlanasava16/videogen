    {
      "id": "l1",
      "character": "narrator",
      "text": "Eine Gruppe von Ingenieurprofessoren sitzt in einem nagelneuen Flugzeug.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "devushka-blondinka",
      "text": "Meine Damen und Herren, dieses Flugzeug haben Ihre eigenen Studenten gebaut!",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "ded",
      "text": "Unsere Studenten? Lassen Sie mich sofort raus!",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": [
        "ded"
      ]
    },
    {
      "id": "l4",
      "character": "devushka-blondinka",
      "text": "Herr Professor, alle sind weg. Warum bleiben Sie sitzen?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "doktor",
      "text": "Ich kenne meine Studenten.",
      "emotion": "smug",
      "pauseAfterSec": 0.7,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "doktor",
      "text": "Die Kiste springt nicht mal an.",
      "emotion": "smug",
