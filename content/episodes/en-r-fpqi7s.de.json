  "lines": [
    {
      "id": "l1",
      "character": "muzhik",
      "text": "Wir sind seit elf Tagen in Selbstisolation.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "muzhik",
      "text": "Und es tut mir wirklich weh, meine Frau am Wohnzimmerfenster stehen zu sehen, wie sie ziellos ins Leere starrt und ihr die Tränen über die Wangen laufen.",
      "emotion": "sad",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "muzhik",
      "text": "Versteht mich nicht falsch, ich fühle mit ihr.",
      "emotion": "sad",
      "pauseAfterSec": 0.6,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "Ich habe schon oft überlegt, sie reinzulassen, aber Regeln sind Regeln.",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
