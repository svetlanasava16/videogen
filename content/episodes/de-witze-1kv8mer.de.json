  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Läuft einer an einem Zaun vorbei und hört auf der anderen Seite ein paar Leute rufen.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "muzhik-sosed",
      "text": "Dreizehn, dreizehn, dreizehn!",
      "emotion": "happy",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "muzhik",
      "text": "Was machen die wohl?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "narrator",
      "text": "Ein paar Schritte weiter hat es ein Loch im Zaun, durch welches er schaut.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "In diesem Moment sticht ihm von der anderen Seite ein Finger ins Auge.",
      "emotion": "neutral",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l6",
      "character": "muzhik-sosed",
      "text": "Vierzehn, vierzehn, vierzehn!",
      "emotion": "happy",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
