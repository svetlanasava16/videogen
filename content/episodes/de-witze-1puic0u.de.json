{
  "id": "de-witze-1puic0u.de",
  "jokeId": "de-witze-1puic0u",
  "locale": "de",
  "title": "Kernig",
  "kind": "joke",
  "v": 2,
  "location": "samolet",
  "place": "train",
  "cast": [
    "muzhik",
    "barmen"
  ],
  "roles": {
    "muzhik": "customer",
    "barmen": "salesman"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Sitzen sich zwei im Zugabteil gegenüber. Einer wirft sich alle paar Minuten etwas ein.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "muzhik",
      "text": "Was kauen Sie denn da?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "barmen",
      "text": "Apfelkerne, gut für das Gehirn. Und schärft die Sinne.",
      "emotion": "smug",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "Kann ich auch welche bekommen?",
      "emotion": "happy",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "barmen",
      "text": "Kosten aber, zehn Stück fünf Euro.",
      "emotion": "smug",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l6",
      "character": "muzhik",
      "text": "Ist aber teuer, aber egal.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l7",
      "character": "narrator",
      "text": "Er kauft zehn Stück und beginnt sofort zu kauen. Nach drei Stück meint er zum Verkäufer.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l8",
      "character": "muzhik",
      "text": "Für fünf Euro hätte ich mir locker fünf Kilo Äpfel kaufen können.",
      "emotion": "angry",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l9",
      "character": "barmen",
      "text": "Schön, dass es schon wirkt.",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
