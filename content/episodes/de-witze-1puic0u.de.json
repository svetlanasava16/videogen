    {
      "id": "l1",
      "character": "narrator",
      "text": "Zwei Männer sitzen sich im Zug gegenüber. Einer kaut alle paar Minuten etwas.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "muzhik",
      "text": "Was kauen Sie denn da?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "barmen",
      "text": "Apfelkerne. Gut fürs Gehirn, schärfen die Sinne.",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "Kann ich auch welche haben?",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "barmen",
      "text": "Zehn Stück, fünf Euro.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "muzhik",
      "text": "Ganz schön teuer. Aber egal, her damit.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "muzhik",
      "text": "Moment mal! Für fünf Euro hätte ich locker fünf Kilo Äpfel bekommen!",
      "emotion": "angry",
      "pauseAfterSec": 0.7,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "barmen",
      "text": "Sehen Sie? Es wirkt schon.",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    }
