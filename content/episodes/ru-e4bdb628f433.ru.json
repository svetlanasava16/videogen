{
  "id": "ru-e4bdb628f433.ru",
  "jokeId": "ru-e4bdb628f433",
  "locale": "ru",
  "title": "Вежливый пёс",
  "kind": "joke",
  "v": 2,
  "location": "derevnya",
  "place": "street",
  "cast": [
    "pyos",
    "muzhik"
  ],
  "roles": {
    "pyos": "dog",
    "muzhik": "everyman"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Подходит мужик к воротам своего соседа и стучится.",
      "emotion": "neutral",
      "pauseAfterSec": 0
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Стучит, стучит, но никто не отвечает.",
      "emotion": "neutral",
      "pauseAfterSec": 0
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "Стучит сильнее.",
      "emotion": "neutral",
      "pauseAfterSec": 0
    },
    {
      "id": "l4",
      "character": "narrator",
      "text": "К воротам тихо подходит пёс и говорит:",
      "emotion": "neutral",
      "pauseAfterSec": 0
    },
    {
      "id": "l5",
      "character": "pyos",
      "text": "Мужик, не стучи, никого дома нет.",
      "emotion": "neutral",
      "pauseAfterSec": 0
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "Тут мужик падает сразу в обморок.",
      "emotion": "surprised",
      "pauseAfterSec": 0
    },
    {
      "id": "l7",
      "character": "narrator",
      "text": "После пришёл в себя, смотрит на пса и говорит:",
      "emotion": "neutral",
      "pauseAfterSec": 0
    },
    {
      "id": "l8",
      "character": "muzhik",
      "text": "Ты чего, пёс, гавкать не умеешь?",
      "emotion": "surprised",
      "pauseAfterSec": 0
    },
    {
      "id": "l9",
      "character": "narrator",
      "text": "Пёс отвечает:",
      "emotion": "neutral",
      "pauseAfterSec": 0
    },
    {
      "id": "l10",
      "character": "pyos",
      "text": "Умею, но не хотел тебя пугать.",
      "emotion": "neutral",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
