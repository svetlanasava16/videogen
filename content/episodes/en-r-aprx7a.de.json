{
  "id": "en-r-aprx7a.de",
  "jokeId": "en-r-aprx7a",
  "locale": "de",
  "title": "In Texas ist alles größer",
  "kind": "joke",
  "v": 2,
  "location": "spalnya",
  "place": "hotel",
  "cast": [
    "muzhik",
    "paren",
    "barmen"
  ],
  "roles": {
    "muzhik": "disabled-person",
    "barmen": "bartender",
    "paren": "employee"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein Blinder besucht Texas. Als er in seinem Hotelzimmer ankommt, tastet er das Bett ab.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "muzhik",
      "text": "Wow, ist das Bett groß!",
      "emotion": "surprised",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "paren",
      "text": "In Texas ist alles größer.",
      "emotion": "smug",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l4",
      "character": "narrator",
      "text": "Der Mann geht runter an die Bar, setzt sich auf einen riesigen Barhocker und bestellt ein Bier. Man stellt ihm einen Krug zwischen die Hände.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "muzhik",
      "text": "Wow, sind die Getränke hier groß!",
      "emotion": "happy",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l6",
      "character": "barmen",
      "text": "In Texas ist alles groß.",
      "emotion": "smug",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l7",
      "character": "narrator",
      "text": "Nach ein paar Bier fragt der Blinde, wo die Toilette ist.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l8",
      "character": "barmen",
      "text": "Zweite Tür rechts.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l9",
      "character": "narrator",
      "text": "Der Blinde macht sich auf den Weg zur Toilette, geht aber aus Versehen durch die dritte Tür, die zum Schwimmbad führt, und fällt hinein.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l10",
      "character": "narrator",
      "text": "Er taucht wieder auf, rudert mit den Armen und schreit:",
      "emotion": "neutral",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l11",
      "character": "muzhik",
      "text": "Nicht spülen, nicht spülen!",
      "emotion": "surprised",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
