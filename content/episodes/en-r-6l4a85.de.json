  "locale": "de",
  "title": "Ich weiß alles",
  "location": "gostinaya",
  "place": "home-living-room",
  "cast": [
    "paren",
    "vovochka",
    "zhena",
    "muzhik"
  ],
  "roles": {
    "paren": "postman",
    "vovochka": "fritzchen",
    "zhena": "mother",
    "muzhik": "father"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Fritzchens Freunde erzählen ihm, dass Erwachsene ein dunkles Geheimnis haben und sich leicht manipulieren lassen.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Fritzchen will das testen.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "vovochka",
      "text": "Mama, ich weiß alles.",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "narrator",
      "text": "Mama bringt ihn zum Schweigen und gibt ihm zehn Euro.",
      "emotion": "neutral",
      "pauseAfterSec": 0.2,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "zhena",
      "text": "Aber sag Papa nichts.",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "vovochka",
      "text": "Hey, es funktioniert!",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": [],
      "laugh": "chuckle"
    },
    {
      "id": "l7",
      "character": "narrator",
      "text": "Eine Stunde später kommt Papa von der Arbeit.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "vovochka",
      "text": "Papa, ich weiß alles.",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l9",
      "character": "narrator",
      "text": "Papa gibt Fritzchen hundert Euro.",
      "emotion": "neutral",
      "pauseAfterSec": 0.2,
      "enter": [],
      "exit": []
    },
    {
      "id": "l10",
      "character": "muzhik",
      "text": "Sag Mama nichts.",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l11",
      "character": "narrator",
      "text": "Da klopft der Briefträger an die Tür.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l12",
      "character": "vovochka",
      "text": "Ich weiß alles, mein Herr.",
      "emotion": "smug",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l13",
      "character": "narrator",
      "text": "Der Briefträger lässt die ganze Post fallen, ihm kommen die Tränen, und er sagt:",
      "emotion": "neutral",
      "pauseAfterSec": 0.6,
      "enter": [],
      "exit": []
    },
    {
      "id": "l14",
      "character": "paren",
      "text": "Na dann, Fritzchen, komm und drück deinen Papi.",
      "emotion": "happy",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
