  "roles": {
    "batyushka": "priest",
    "muzhik-sosed": "friend",
    "muzhik": "everyman"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Jack goes to his buddy Bob.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "muzhik",
      "text": "I'm sleeping with the priest's wife. Can you hold him in church for an hour after mass for me?",
      "emotion": "smug",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "The friend doesn't like it but being a buddy, he agrees.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "narrator",
      "text": "After mass, Bob starts talking to the priest, asking him all sorts of stupid questions, just to keep him occupied.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "Finally the priest gets annoyed.",
      "emotion": "neutral",
      "pauseAfterSec": 0.2
    },
    {
      "id": "l6",
      "character": "batyushka",
      "text": "What are you really up to?",
      "emotion": "angry",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l7",
      "character": "narrator",
      "text": "Bob, feeling guilty, finally confesses to the priest.",
      "emotion": "neutral",
      "pauseAfterSec": 0.2
    },
    {
      "id": "l8",
      "character": "muzhik-sosed",
      "text": "My friend is sleeping with your wife right now, so he asked me to keep you occupied.",
      "emotion": "sad",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l9",
      "character": "narrator",
      "text": "The priest smiles and puts a brotherly hand on Bob's shoulder.",
      "emotion": "neutral",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l10",
      "character": "batyushka",
      "text": "You better hurry home now. My wife died a year ago.",
      "emotion": "happy",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
