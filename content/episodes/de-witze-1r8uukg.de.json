  ],
  "roles": {
    "muzhik-ryzhy": "driver",
    "zhena": "mother",
    "vovochka": "child",
    "muzhik": "customer"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Eine Frau steigt mit ihrem Baby auf dem Arm vorne beim Fahrer in den Bus ein.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [
        "zhena",
        "vovochka"
      ],
      "exit": []
    },
    {
      "id": "l2",
      "character": "muzhik-ryzhy",
      "text": "Das ist ja wohl das hässlichste Kind, das ich je gesehen habe.",
      "emotion": "smug",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "Die Frau, schockiert, aber unfähig, etwas zu sagen, setzt sich neben einen Mann, der ihr ansieht, dass etwas nicht stimmt.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "Gute Frau, ist etwas passiert?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "zhena",
      "text": "Ich bin gerade vom Busfahrer beleidigt worden.",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "muzhik",
      "text": "Das ist eine absolute Frechheit, und so etwas müssen Sie sich nicht bieten lassen.",
      "emotion": "angry",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "muzhik",
      "text": "Wir machen jetzt Folgendes.",
      "emotion": "neutral",
      "pauseAfterSec": 0.6,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "muzhik",
      "text": "Sie gehen vor zum Fahrer, verlangen eine Entschuldigung, und ich halte derweil Ihren Affen.",
      "emotion": "happy",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
