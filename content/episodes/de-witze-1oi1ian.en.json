  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "A little girl is riding her new bike up and down the street.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Suddenly a police officer on horseback comes by. He stops the girl.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [
        "sluzhivy",
        "loshad"
      ],
      "exit": []
    },
    {
      "id": "l3",
      "character": "sluzhivy",
      "text": "So, did Santa bring you a bike for Christmas?",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "devochka",
      "text": "Yes, he did. I wished for it really, really hard.",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "sluzhivy",
      "text": "Well, that's great.",
      "emotion": "happy",
      "pauseAfterSec": 0.2,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "sluzhivy",
      "text": "Unfortunately, I have to give you a ticket, because Santa forgot to put reflectors on your bike.",
      "emotion": "smug",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "devochka",
      "text": "Is your horse from Santa too?",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "narrator",
      "text": "The officer smiles and nods.",
      "emotion": "neutral",
      "pauseAfterSec": 0.6,
      "enter": [],
      "exit": []
    },
    {
      "id": "l9",
      "character": "devochka",
      "text": "Well then, tell Santa next year the butt goes at the back, not on top!",
      "uncensored": "Well then, tell Santa next year the asshole goes at the back, not on top!",
      "emotion": "angry",
      "pauseAfterSec": 0.8,
