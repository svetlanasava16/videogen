  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "A little girl is riding her new bike up and down the street.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "sluzhivy",
      "text": "Well now, did Santa bring you that bike for Christmas?",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [
        "sluzhivy",
        "loshad"
      ],
      "exit": []
    },
    {
      "id": "l3",
      "character": "devochka",
      "text": "Yes! It's exactly what I wished for.",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "sluzhivy",
      "text": "Lovely. But I'm afraid I still have to give you a ticket.",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "sluzhivy",
      "text": "Santa forgot to put reflectors on it.",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "devochka",
      "text": "Did Santa bring you your horse too?",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "sluzhivy",
      "text": "He sure did.",
      "emotion": "happy",
      "pauseAfterSec": 0.7,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "devochka",
      "text": "Then tell Santa next year the horse's ass goes at the back, not on top!",
      "emotion": "angry",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    }
  ],
