  "lines": [
    {
      "id": "l1",
      "character": "muzhik",
      "text": "Gibt Ihre Bank Kredite auf Ehrenwort?",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "nachalnik",
      "text": "Kein Problem...",
      "emotion": "smug",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "muzhik",
      "text": "Und wenn ich nicht zurückzahle?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "nachalnik",
      "text": "Dann werden Sie sich vor dem Allmächtigen schämen, wenn Sie vor ihn treten.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "muzhik",
      "text": "Bis dahin ist es ja noch lange hin...",
      "emotion": "happy",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l6",
      "character": "nachalnik",
      "text": "Na ja, wenn Sie am Fünften nicht zurückzahlen,",
      "emotion": "smug",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l6b",
      "character": "nachalnik",
      "text": "treten Sie am Sechsten vor ihn.",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
