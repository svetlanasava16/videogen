  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "In a harbor pub, a typical pirate sits at the bar: eye patch, wooden leg, a hook for a hand.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "muzhik-sosed",
      "text": "So where did you lose your leg?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [
        "muzhik-sosed"
      ],
      "exit": []
    },
    {
      "id": "l3",
      "character": "sluzhivy",
      "text": "It got shot off in a battle off Trinidad.",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "muzhik-sosed",
      "text": "And what happened to your hand?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "sluzhivy",
      "text": "A saber blow, when we boarded a frigate.",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "muzhik-sosed",
      "text": "And the eye?",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "sluzhivy",
      "text": "A seagull crapped in it.",
      "uncensored": "A seagull shat in it.",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "muzhik-sosed",
      "text": "But you don't lose an eye from that?",
      "emotion": "surprised",
      "pauseAfterSec": 0.7,
      "enter": [],
      "exit": []
    },
    {
      "id": "l9",
      "character": "sluzhivy",
      "text": "You do, if you've only had the hook for two days.",
      "emotion": "sad",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
