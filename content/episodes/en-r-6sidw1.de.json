  ],
  "roles": {
    "zhena": "wife",
    "vovochka": "child",
    "muzhik": "husband"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Nach zehn Jahren findet die Frau, dass ihr Kind irgendwie seltsam aussieht. Also macht sie einen DNA-Test.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Es stellt sich heraus, dass das Kind von ganz anderen Eltern stammt.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l3",
      "character": "zhena",
      "text": "Schatz, ich muss dir etwas sehr Ernstes sagen.",
      "emotion": "sad",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "Was ist los?",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "zhena",
      "text": "Laut DNA-Test ist das nicht unser Kind.",
      "emotion": "sad",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l6",
      "character": "muzhik",
      "text": "Weißt du das nicht mehr?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l7",
      "character": "muzhik",
      "text": "Als wir aus dem Krankenhaus kamen, haben wir gemerkt,",
      "emotion": "neutral",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l7b",
      "character": "muzhik",
      "text": "dass unser Baby die Windel voll hatte.",
      "emotion": "neutral",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l8",
      "character": "muzhik",
      "text": "Du hast gesagt: Geh bitte das Baby wechseln, ich warte hier auf dich.",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
