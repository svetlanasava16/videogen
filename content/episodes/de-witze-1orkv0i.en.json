{
  "id": "de-witze-1orkv0i.en",
  "jokeId": "de-witze-1orkv0i",
  "locale": "en",
  "title": "Looking Back",
  "kind": "joke",
  "v": 2,
  "location": "spalnya",
  "place": "bedroom",
  "cast": [
    "tyoshcha",
    "ded"
  ],
  "roles": {
    "tyoshcha": "old-woman",
    "ded": "old-man"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "An old, very sick man lies dying and says to his wife:",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "ded",
      "text": "Elfriede, since the day of our wedding we have never been apart.",
      "emotion": "sad",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "ded",
      "text": "When I lost my job, you were with me.",
      "emotion": "sad",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "ded",
      "text": "When my parents died, you were by my side.",
      "emotion": "sad",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "ded",
      "text": "When I got badly hurt on that ski holiday, you were next to me.",
      "emotion": "sad",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l6",
      "character": "ded",
      "text": "When inflation ate up my savings and I had nothing left,",
      "emotion": "neutral",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l6b",
      "character": "ded",
      "text": "even then you were there, and you stayed.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l7",
      "character": "ded",
      "text": "Now I'm dying, and you're still here.",
      "emotion": "surprised",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l8",
      "character": "ded",
      "text": "Elfriede, you've never brought me anything but bad luck!",
      "emotion": "angry",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
