  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein Dampfer fährt an einer kleinen Insel im Ozean vorbei, auf der ein bärtiger Mann etwas schreit und verzweifelt mit den Armen fuchtelt.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l2",
      "character": "muzhik-sosed",
      "text": "Wer ist das?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "sluzhivy-ryadovoy",
      "text": "Keine Ahnung.",
      "emotion": "neutral",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l4",
      "character": "sluzhivy-ryadovoy",
      "text": "Jedes Jahr, wenn wir hier vorbeifahren, dreht er genauso durch.",
      "emotion": "neutral",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
