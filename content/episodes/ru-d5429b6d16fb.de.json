  "locale": "de",
  "title": "Schwester Anna",
  "location": "bar",
  "place": "bar",
  "cast": [
    "uchilka",
    "muzhik",
    "barmen"
  ],
  "roles": {
    "uchilka": "nun",
    "muzhik": "drunk",
    "barmen": "bartender"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein Mann trinkt in einer Kneipe. Eine Nonne kommt vorbei.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "uchilka",
      "text": "Wie kannst du dein Leben in dieser Lasterhöhle vergeuden!",
      "emotion": "angry",
      "pauseAfterSec": 0.3,
      "enter": [
        "uchilka"
      ],
      "exit": []
    },
    {
      "id": "l3",
      "character": "muzhik",
      "text": "Kein Laster hier, Schwester...",
      "emotion": "surprised",
      "pauseAfterSec": 0.2,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "uchilka",
      "text": "Anna!",
      "emotion": "angry",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "muzhik",
      "text": "Schwester Anna. Alles gut. Ich trinke nur.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "uchilka",
      "text": "Und das ist dem Herrn zuwider!",
      "emotion": "angry",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "muzhik",
      "text": "Hast du es denn je probiert?",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "uchilka",
      "text": "Nein!",
      "emotion": "angry",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l9",
      "character": "muzhik",
      "text": "Wie kannst du dann urteilen? Ich spendier dir einen.",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l10",
      "character": "uchilka",
      "text": "Niemals! Damit alle sehen, wie eine Nonne Schnaps trinkt?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l11",
      "character": "muzhik",
      "text": "Ich lass ihn dir in eine Teetasse füllen.",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l12",
      "character": "uchilka",
      "text": "Na gut.",
      "emotion": "sad",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l13",
      "character": "muzhik",
      "text": "Zwei Schnäpse. Aber einen bitte in eine Teetasse.",
      "emotion": "neutral",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    },
    {
      "id": "l14",
      "character": "barmen",
      "text": "Was, schon wieder Schwester Anna?",
      "emotion": "surprised",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    }
  ],
  "outroLaughs": [],
