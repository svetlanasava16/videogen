{
  "id": "ru-d5429b6d16fb.de",
  "jokeId": "ru-d5429b6d16fb",
  "locale": "de",
  "title": "Schwester Anna",
  "kind": "joke",
  "v": 2,
  "location": "bar",
  "place": "bar",
  "cast": [
    "uchilka",
    "muzhik",
    "barmen"
  ],
  "roles": {
    "uchilka": "nun",
    "muzhik": "customer",
    "barmen": "bartender"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein Mann sitzt im Café und betrinkt sich. Eine Nonne geht vorbei.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "uchilka",
      "text": "Wie kannst du dein Leben in dieser Höhle der Unzucht und Verderbtheit verschwenden!",
      "emotion": "angry",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "muzhik",
      "text": "Hier gibt es doch keine Verderbtheit, Schwester...",
      "emotion": "neutral",
      "pauseAfterSec": 0.2
    },
    {
      "id": "l4",
      "character": "uchilka",
      "text": "Anna.",
      "emotion": "angry",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "muzhik",
      "text": "Ja, Anna. Alles in Ordnung. Ich trinke nur.",
      "emotion": "happy",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l6",
      "character": "uchilka",
      "text": "Und das ist dem Herrn zuwider.",
      "emotion": "angry",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l7",
      "character": "muzhik",
      "text": "Hast du es selbst schon mal probiert, Schwester Anna?",
      "emotion": "smug",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l8",
      "character": "uchilka",
      "text": "Nein!",
      "emotion": "angry",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l9",
      "character": "muzhik",
      "text": "Wie kannst du es dann behaupten?",
      "emotion": "smug",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l9b",
      "character": "muzhik",
      "text": "Komm, ich kaufe dir was zu trinken, und du probierst...",
      "emotion": "smug",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l10",
      "character": "uchilka",
      "text": "Niemals! Damit die Leute sehen, wie eine Nonne Schnaps trinkt?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l11",
      "character": "muzhik",
      "text": "Ich lasse es dir in eine Tasse gießen.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l12",
      "character": "narrator",
      "text": "Die Nonne willigt widerwillig ein. Der Mann geht zur Theke.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l13",
      "character": "muzhik",
      "text": "Hör mal, gib mir zwei Gläser Wodka, aber gieß eins in eine Teetasse.",
      "emotion": "neutral",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l14",
      "character": "barmen",
      "text": "Was, schon wieder Schwester Anna?",
      "emotion": "surprised",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
