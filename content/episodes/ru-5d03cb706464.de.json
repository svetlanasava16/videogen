  ],
  "roles": {
    "muzhik": "husband",
    "kot": "cat",
    "zhena": "wife"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein Mann hatte einen Kater.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Ob der Kater schon zu alt geworden war oder ob er die saure Sahne geklaut hatte, jedenfalls befahl die Frau des Mannes, ihn weit in den Wald zu tragen und dort seinem Schicksal zu überlassen.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "Nichts zu machen, der Mann trug den Kater in den Wald.",
      "emotion": "sad",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "narrator",
      "text": "Und verschwand selbst.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "Einen Tag ist er weg, zwei Tage weg, am dritten Tag taucht zu Hause der Kater auf.",
      "emotion": "neutral",
      "pauseAfterSec": 0.2
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "Und gleich hinter ihm der Mann: dreckig, wütend und hungrig.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l7",
      "character": "zhena",
      "text": "Na, du Trottel, hast du den Kater in den Wald gebracht?",
      "emotion": "angry",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l8",
      "character": "muzhik",
      "text": "Ja, hab ich, Mist! Und wenn ich ihm nicht hinterhergelaufen wäre, hätte ich mich verdammt noch mal verlaufen...",
      "emotion": "angry",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
