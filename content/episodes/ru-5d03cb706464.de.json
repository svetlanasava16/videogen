  "locale": "de",
  "title": "Der Kater im Wald",
  "location": "gostinaya",
  "place": "forest",
  "cast": [
    "zhena",
    "muzhik",
    "kot"
  ],
  "roles": {
    "zhena": "wife",
    "muzhik": "husband",
    "kot": "cat"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein Mann hatte einen Kater. Ob der Kater schon zu alt geworden war oder ob er die saure Sahne geklaut hatte, jedenfalls befahl die Frau:",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "zhena",
      "text": "Bring ihn weit in den Wald und überlass ihn dort seinem Schicksal!",
      "emotion": "angry",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "Nichts zu machen, der Mann trug den Kater in den Wald.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "narrator",
      "text": "Und verschwand selbst.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "Einen Tag ist er weg, zwei Tage, am dritten Tag taucht zu Hause der Kater auf,",
      "emotion": "neutral",
      "pauseAfterSec": 0.2,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "und gleich hinterher der Mann, dreckig, wütend und hungrig.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "zhena",
      "text": "Na, du Trottel, hast du den Kater in den Wald gebracht?",
      "emotion": "angry",
      "pauseAfterSec": 0.7,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "muzhik",
      "text": "Ja, hab ich, verdammt! Und wenn ich ihm nicht hinterhergelaufen wäre, hätte ich mich zum Teufel noch mal verlaufen...",
      "emotion": "angry",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
