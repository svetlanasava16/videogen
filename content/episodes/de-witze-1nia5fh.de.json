{
  "id": "de-witze-1nia5fh.de",
  "jokeId": "de-witze-1nia5fh",
  "locale": "de",
  "title": "Eisfischen",
  "kind": "joke",
  "v": 2,
  "location": "derevnya",
  "place": "river-lake",
  "cast": [
    "devushka",
    "paren"
  ],
  "roles": {
    "devushka": "woman",
    "paren": "employee"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Nora wollte Eisfischen gehen. Sie hatte viele Bücher zu diesem Thema gelesen und schließlich alle notwendigen Utensilien zusammengestellt.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Nachdem sie ihren bequemen Fußschemel aufgestellt hatte, begann sie, einen kreisförmigen Schnitt ins Eis zu machen. Plötzlich ertönte von oben eine Stimme.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "paren",
      "text": "Unter dem Eis gibt es keine Fische.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l4",
      "character": "narrator",
      "text": "Erschrocken bewegte sie sich weiter über das Eis und begann, ein weiteres Loch zu schneiden. Wieder dröhnte die Stimme.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "paren",
      "text": "Unter dem Eis gibt es keine Fische.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "Nora, nun besorgt, entfernte sich bis zum gegenüberliegenden Ende des Eises und versuchte erneut, ihr Angelloch zu schneiden.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l7",
      "character": "paren",
      "text": "Unter dem Eis gibt es keine Fische.",
      "emotion": "angry",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l8",
      "character": "narrator",
      "text": "Sie hielt inne und blickte zum Himmel.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l9",
      "character": "devushka",
      "text": "Bist du das, Herr?",
      "emotion": "surprised",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l10",
      "character": "paren",
      "text": "Nein, hier spricht der Manager der Eisbahn.",
      "emotion": "neutral",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
