      "character": "narrator",
      "text": "Ein Tourist am See Genezareth will mit der Fähre übersetzen.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "muzhik-sosed",
      "text": "Einmal rüber, bitte.",
      "emotion": "happy",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "sluzhivy-ryadovoy",
      "text": "Macht zweihundert Euro.",
      "emotion": "smug",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "muzhik-sosed",
      "text": "Zweihundert Euro? Warum ist das denn so teuer?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "sluzhivy-ryadovoy",
      "text": "Weil Jesus hier übers Wasser gegangen ist!",
      "emotion": "smug",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l6",
      "character": "muzhik-sosed",
      "text": "Ja, jetzt weiß ich auch, warum!",
