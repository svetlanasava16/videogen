  "locale": "de",
  "title": "Pinguine",
  "location": "doroga",
  "place": "road",
  "cast": [
    "barmen",
    "muzhik-ryzhy",
    "ptitsa"
  ],
  "roles": {
    "barmen": "mechanic",
    "muzhik-ryzhy": "driver",
    "ptitsa": "bird"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein Mann fährt an eine Tankstelle, und der Tankwart bemerkt, dass auf dem Rücksitz fünf Pinguine sitzen.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "barmen",
      "text": "Was zum Teufel – du hast fünf Pinguine auf dem Rücksitz.",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "muzhik-ryzhy",
      "text": "Ich weiß! Die sind an der Ampel eingesprungen, und jetzt weiß ich nicht, was ich tun soll.",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "barmen",
      "text": "Ich sag dir, was ich tun würde – ich würde sie in den Zoo bringen.",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "muzhik-ryzhy",
      "text": "Das ist eine super Idee!",
      "emotion": "happy",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "Eine Woche später fährt derselbe Fahrer mit denselben fünf Pinguinen vor, nur dass sie jetzt Sonnenbrillen tragen.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "barmen",
      "text": "Was machst du denn da – ich dachte, ich hätte dir gesagt, du sollst die Pinguine in den Zoo bringen!",
      "emotion": "angry",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "muzhik-ryzhy",
      "text": "Wir waren doch dort! Wir hatten eine tolle Zeit! Heute fahren wir an den Strand!",
      "emotion": "happy",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
