{
  "id": "de-witze-1tmxtlw.de",
  "jokeId": "de-witze-1tmxtlw",
  "locale": "de",
  "title": "Pinguine",
  "kind": "joke",
  "v": 2,
  "location": "doroga",
  "place": "road",
  "cast": [
    "barmen",
    "muzhik",
    "pingvin"
  ],
  "roles": {
    "barmen": "mechanic",
    "muzhik": "customer",
    "pingvin": "penguin"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein Mann fährt an eine Tankstelle, und der Tankwart bemerkt, dass auf dem Rücksitz fünf Pinguine sitzen.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "barmen",
      "text": "Was zum Teufel, du hast fünf Pinguine auf dem Rücksitz.",
      "emotion": "surprised",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "muzhik",
      "text": "Ich weiß!",
      "emotion": "sad",
      "pauseAfterSec": 0.2
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "Die sind an der Ampel eingesprungen, und jetzt weiß ich nicht, was ich tun soll.",
      "emotion": "sad",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l5",
      "character": "barmen",
      "text": "Ich sag dir, was ich tun würde, ich würde sie in den Zoo bringen.",
      "emotion": "smug",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l6",
      "character": "muzhik",
      "text": "Das ist eine super Idee!",
      "emotion": "happy",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l7",
      "character": "narrator",
      "text": "Eine Woche später fährt derselbe Fahrer mit denselben fünf Pinguinen vor, nur dass sie jetzt Sonnenbrillen tragen.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l8",
      "character": "barmen",
      "text": "Was machst du denn da?",
      "emotion": "angry",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l8b",
      "character": "barmen",
      "text": "Ich dachte, ich hätte dir gesagt, du sollst die Pinguine in den Zoo bringen!",
      "emotion": "angry",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l9",
      "character": "muzhik",
      "text": "Wir waren doch dort! Wir hatten eine tolle Zeit!",
      "emotion": "happy",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l10",
      "character": "muzhik",
      "text": "Heute fahren wir an den Strand!",
      "emotion": "happy",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
