  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein Mann hält an einer Tankstelle, auf seinem Rücksitz sitzen fünf Pinguine.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [
        "muzhik",
        "ptitsa"
      ],
      "exit": []
    },
    {
      "id": "l2",
      "character": "paren",
      "text": "Was zum Teufel? Du hast fünf Pinguine auf dem Rücksitz!",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "muzhik",
      "text": "Ich weiß! Die sind an der Ampel eingesprungen. Was soll ich denn jetzt machen?",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "paren",
      "text": "Ich sag dir, was ich machen würde. Ich würde sie in den Zoo bringen.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "muzhik",
      "text": "Super Idee!",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": [
        "muzhik",
        "ptitsa"
      ]
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "Eine Woche später. Derselbe Mann, dieselben Pinguine, aber jetzt mit Sonnenbrillen.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [
        "muzhik",
        "ptitsa"
      ],
      "exit": []
    },
    {
      "id": "l7",
      "character": "paren",
      "text": "Was machst du denn da? Ich hab dir doch gesagt, bring sie in den Zoo!",
      "emotion": "angry",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "muzhik",
      "text": "Da waren wir doch! War total toll! Heute fahren wir an den Strand!",
      "emotion": "happy",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    }
  ],
