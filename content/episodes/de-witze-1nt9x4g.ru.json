  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "В честь девяностопятилетия у старичка в доме престарелых берут интервью для местной газеты.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "paren",
      "text": "Как вы себя чувствуете в вашем возрасте и в этой обстановке?",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "ded",
      "text": "Спасибо, очень хорошо.",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "paren",
      "text": "А как выглядит ваш распорядок дня здесь?",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "ded",
      "text": "Утром: первым делом пописать!",
      "uncensored": "Утром: первым делом поссать!",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "paren",
      "text": "И как? Никаких проблем?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "ded",
      "text": "Да что вы! Мощная струя, никакого жжения, здоровый цвет!",
      "emotion": "smug",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": [],
      "laugh": "chuckle"
    },
    {
      "id": "l8",
      "character": "paren",
      "text": "А потом?",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l9",
      "character": "ded",
      "text": "Стул.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l10",
      "character": "paren",
      "text": "Какие-нибудь жалобы?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l11",
      "character": "ded",
      "text": "Ни малейших. Достаточный напор, никакой крови, совершенно нормальное опорожнение кишечника.",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l12",
      "character": "paren",
      "text": "А что дальше?",
      "emotion": "neutral",
      "pauseAfterSec": 0.7,
      "enter": [],
      "exit": []
    },
    {
      "id": "l13",
      "character": "ded",
      "text": "Ну, а потом я встаю.",
      "emotion": "happy",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
