  "locale": "de",
  "title": "Die zwei Tore",
  "location": "nebesa",
  "place": "heaven",
  "cast": [
    "ded",
    "muzhik"
  ],
  "roles": {
    "ded": "saint-peter",
    "muzhik": "husband"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Am Eingang zum Himmel befinden sich zwei Tore.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "An einem Eingang steht ein Schild: Für Männer, die von ihren Frauen bevormundet wurden!",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "Am anderen Eingang steht: Für Männer, die nicht von ihren Frauen bevormundet wurden!",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "narrator",
      "text": "Vor dem ersten Tor steht eine riesige Schlange von Männern. Vor dem zweiten Tor nur einer.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "ded",
      "text": "Mein Sohn, warum stehst ausgerechnet du ganz alleine vor diesem Tor?",
      "emotion": "surprised",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "muzhik",
      "text": "Das weiß ich eigentlich auch nicht.",
      "emotion": "sad",
      "pauseAfterSec": 0.6,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "muzhik",
      "text": "Meine Frau hat gesagt, ich soll mich hier anstellen.",
      "emotion": "neutral",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
