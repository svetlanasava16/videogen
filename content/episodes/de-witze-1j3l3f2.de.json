  ],
  "roles": {
    "ded": "saint-peter",
    "muzhik": "husband"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Vor dem Himmel gibt es zwei Tore.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Auf dem einen steht: Für Männer, die von ihren Frauen bevormundet wurden. Auf dem anderen: Für Männer, die nicht bevormundet wurden.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "Vor dem ersten Tor eine endlose Schlange. Vor dem zweiten steht nur einer.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "ded",
      "text": "Mein Sohn, warum stehst ausgerechnet du ganz allein vor diesem Tor?",
      "emotion": "surprised",
      "pauseAfterSec": 0.8,
      "enter": [
        "ded"
      ],
      "exit": []
    },
    {
      "id": "l5",
      "character": "muzhik",
      "text": "Das weiß ich eigentlich auch nicht. Meine Frau hat gesagt, ich soll mich hier anstellen.",
      "emotion": "neutral",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    }
  ],
