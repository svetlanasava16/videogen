  "locale": "en",
  "title": "Everything Hurts",
  "kind": "joke",
  "v": 2,
  "location": "bolnitsa",
  "place": "doctor-office",
  "cast": [
    "doktor",
    "devushka-blondinka"
  ],
  "roles": {
    "doktor": "doctor",
    "devushka-blondinka": "blonde"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "A gorgeous young brunette goes into the doctor's office.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "devushka-blondinka",
      "text": "Doctor, my body hurts wherever I touch it.",
      "emotion": "sad",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "doktor",
      "text": "Impossible! Show me.",
      "emotion": "surprised",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "narrator",
      "text": "She took her finger and pushed on her left wrist.",
      "emotion": "neutral",
      "pauseAfterSec": 0.2
    },
    {
      "id": "l5",
      "character": "devushka-blondinka",
      "text": "Ow!",
      "emotion": "sad",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "Then she pushed her elbow.",
      "emotion": "neutral",
      "pauseAfterSec": 0.2
    },
    {
      "id": "l7",
      "character": "devushka-blondinka",
      "text": "Ow, ow, ow!",
      "emotion": "sad",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l8",
      "character": "narrator",
      "text": "She pushed her knee, then her ankle.",
      "emotion": "neutral",
      "pauseAfterSec": 0.2
    },
    {
      "id": "l9",
      "character": "devushka-blondinka",
      "text": "Ow! Ow!",
      "emotion": "sad",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l10",
      "character": "doktor",
      "text": "You're not really a brunette, are you?",
      "emotion": "smug",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l11",
      "character": "devushka-blondinka",
      "text": "Well, no. I'm actually a blonde.",
      "emotion": "surprised",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l12",
      "character": "doktor",
      "text": "I thought so. Your finger is broken.",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
