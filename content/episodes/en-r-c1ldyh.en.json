  "locale": "en",
  "title": "Took the Bus",
  "kind": "joke",
  "v": 2,
  "location": "bar",
  "place": "road",
  "cast": [
    "muzhik",
    "sluzhivy"
  ],
  "roles": {
    "muzhik": "drunk",
