  },
  "lines": [
    {
      "id": "l1",
      "character": "muzhik",
      "text": "Last night I was out for a few drinks.",
      "emotion": "happy",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "muzhik",
      "text": "One thing led to another and I had a few too many cocktails and then went onto the wine.",
      "emotion": "happy",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "muzhik",
      "text": "Not a good idea.",
      "emotion": "sad",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "Knowing I was over the limit, I decided to leave my car at the pub and took a bus home.",
      "emotion": "smug",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l5",
      "character": "muzhik",
      "text": "Sure enough, I passed a police checkpoint, where they were pulling over drivers and performing breathalyzer tests.",
      "offscreen": true,
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l6",
      "character": "muzhik",
      "text": "Because I was in a bus they just waved it past.",
      "offscreen": true,
      "emotion": "smug",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l7",
      "character": "muzhik",
      "text": "I arrived home safely and without incident,",
      "emotion": "happy",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l8",
      "character": "muzhik",
      "text": "which was a real surprise as I've never driven a bus before and I am not even sure where I got it from.",
      "emotion": "surprised",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
