    {
      "id": "l1",
      "character": "narrator",
      "text": "At a company, in the middle of the working day, wild screams ring out and guys in camouflage and masks burst in.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Everyone freaks out, and then a shout:",
      "emotion": "neutral",
      "pauseAfterSec": 0.2,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "vor",
      "text": "Everybody down, this is a robbery!",
      "emotion": "angry",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "narrator",
      "text": "The chief accountant, lowering himself to the floor:",
      "emotion": "neutral",
      "pauseAfterSec": 0.6,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "muzhik-sosed",
      "text": "You scared me, you scumbags, I thought it was a tax raid...",
      "emotion": "happy",
      "pauseAfterSec": 0.8,
