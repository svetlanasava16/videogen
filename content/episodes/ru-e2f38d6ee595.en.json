  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "A man walks into a fancy bar and says to the bartender:",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "nachalnik",
      "text": "A hundred grams of vodka.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "The bartender pours it and serves it. The man takes a measuring beaker and an ID out of his pocket:",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "nachalnik",
      "text": "Test purchase. Seventy-five grams! That's a fifty-dollar fine.",
      "emotion": "smug",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "The next evening. Same faces. The man measures with his beaker again and collects another fifty-dollar fine.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "nachalnik",
      "text": "Listen, you recognized me, so why did you still pour short?",
      "emotion": "surprised",
      "pauseAfterSec": 0.6,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "barmen",
      "text": "It's easier for me to hand you fifty bucks than to throw off my pouring hand because of jerks like you...",
      "uncensored": "It's easier for me to hand you fifty bucks than to throw off my pouring hand because of assholes like you...",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
