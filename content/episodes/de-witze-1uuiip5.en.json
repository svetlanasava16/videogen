    {
      "id": "l3",
      "character": "muzhik",
      "text": "In three years? Hmm… Morning or afternoon?",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "paren",
      "text": "What difference does that make? It's three years away.",
      "emotion": "surprised",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l5",
      "character": "muzhik",
      "text": "Well, in the morning I've got a specialist appointment.",
