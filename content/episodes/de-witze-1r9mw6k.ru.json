  "lines": [
    {
      "id": "l1",
      "character": "doktor",
      "text": "А теперь расскажите мне, как вы обожгли себе уши.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "muzhik",
      "text": "Я гладил, когда зазвонил телефон, и приложил утюг к уху.",
      "emotion": "sad",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l3",
      "character": "doktor",
      "text": "Но вы же обожгли оба уха!",
      "emotion": "surprised",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "Это потому, что я сразу хотел позвонить в скорую.",
      "emotion": "neutral",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
