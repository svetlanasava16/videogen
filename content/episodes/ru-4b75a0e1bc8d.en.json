{
  "id": "ru-4b75a0e1bc8d.en",
  "jokeId": "ru-4b75a0e1bc8d",
  "locale": "en",
  "title": "The Hiccups",
  "location": "bolnitsa",
  "place": "hospital",
  "cast": [
    "zhena",
    "paren"
  ],
  "roles": {
    "zhena": "patient",
