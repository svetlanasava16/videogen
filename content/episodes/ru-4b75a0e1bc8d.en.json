  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Mrs. Peterson went to the doctor.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "She got an appointment with a very young doctor, fresh out of medical school.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "After a few minutes in his office, Mrs. Peterson burst out of it, shrieking and wailing, and tore off down the corridor.",
      "emotion": "surprised",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "narrator",
      "text": "An elderly doctor was coming the other way. He stopped her.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "doktor",
      "text": "What's the matter?",
      "emotion": "surprised",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l6",
      "character": "doktor",
      "text": "What do you think you're doing?",
      "emotion": "angry",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l7",
      "character": "doktor",
      "text": "Mrs.",
      "emotion": "angry",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l7b",
      "character": "doktor",
      "text": "Peterson is fifty-five, she has a grown-up daughter,",
      "emotion": "angry",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l7c",
      "character": "doktor",
      "text": "a grandchild on the way, and you tell her she's pregnant!",
      "emotion": "angry",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l8",
      "character": "narrator",
      "text": "The young doctor, still writing something in her chart, replied.",
      "emotion": "neutral",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l9",
      "character": "paren",
      "text": "Well, her hiccups are gone, aren't they?",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
