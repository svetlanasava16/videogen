  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Mrs. Peterson went to the doctor. She was booked with a very young doctor, fresh out of medical school.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "After a few minutes in his office, Mrs. Peterson burst out of it, shrieking and wailing, and tore off down the corridor.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "An older doctor was coming the other way. He stopped her and asked what was the matter.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "narrator",
      "text": "When he walked into the young doctor's office, he looked stern.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "doktor",
      "text": "What do you think you're doing?",
      "emotion": "angry",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "doktor",
      "text": "Mrs. Peterson is fifty-five, she has a grown daughter, a grandchild on the way, and you tell her she's pregnant!",
      "emotion": "angry",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "paren",
      "text": "But the hiccups did go away, didn't they?",
      "emotion": "neutral",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
