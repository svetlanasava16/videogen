  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "A lady in her fifties is seeing a young doctor fresh out of medical school.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "tyoshcha",
      "text": "Pregnant? Me? Have you lost your mind?",
      "emotion": "angry",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": [
        "tyoshcha"
      ]
    },
    {
      "id": "l3",
      "character": "doktor",
      "text": "What on earth were you thinking?",
      "emotion": "angry",
      "pauseAfterSec": 0.3,
      "enter": [
        "doktor"
      ],
      "exit": []
    },
    {
      "id": "l4",
      "character": "doktor",
      "text": "She's fifty-five, she has a grown daughter, she's about to be a grandmother!",
      "emotion": "angry",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "doktor",
      "text": "And you tell her she's pregnant?",
      "emotion": "surprised",
      "pauseAfterSec": 0.8,
      "enter": [],
