      "exit": []
    },
    {
      "id": "l2",
      "character": "muzhik",
      "text": "Sorry, honey, but I'm up to my neck in work today.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "zhena",
      "text": "But, sweetheart, I have news for you: a good one and a bad one.",
      "emotion": "happy",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "Fine, I don't have time right now, just tell me the good news.",
      "emotion": "angry",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "zhena",
      "text": "Well... basically... the airbag works.",
      "emotion": "smug",
