  ],
  "roles": {
    "devushka": "woman",
    "nachalnik": "judge",
    "muzhik": "husband"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Eine uneinsichtige Frau steht wegen Ladendiebstahls vor Gericht. Der Richter fällt sein Urteil.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "nachalnik",
      "text": "Trotz eindeutiger Beweise sind Sie nicht geständig und ohne Reue.",
      "emotion": "angry",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "nachalnik",
      "text": "Sie haben nachweislich eine Tüte Pfefferminzbonbons gestohlen.",
      "emotion": "angry",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "nachalnik",
      "text": "Ich verurteile Sie zu Schadenersatz und zwölf Tagen Haft, ein Tag für jedes Bonbon in der Packung.",
      "emotion": "smug",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "Da steht plötzlich der Ehemann der Angeklagten auf und ruft dem Richter zu.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l6",
      "character": "muzhik",
      "text": "Machen wir doch gleich reinen Tisch!",
      "emotion": "happy",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l7",
      "character": "muzhik",
      "text": "Sie hat außerdem eine Packung Reis geklaut!",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
