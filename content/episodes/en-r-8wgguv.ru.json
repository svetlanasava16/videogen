{
  "id": "en-r-8wgguv.ru",
  "jokeId": "en-r-8wgguv",
  "locale": "ru",
  "title": "Кошка на крыше",
  "kind": "joke",
  "v": 2,
  "location": "plyazh",
  "place": "beach",
  "cast": [
    "zhena",
    "muzhik"
  ],
  "roles": {
    "zhena": "wife",
    "muzhik": "husband"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Жена уехала в отпуск и звонит домой.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "zhena",
      "text": "Как там моя кошка?",
      "emotion": "happy",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "muzhik",
      "text": "Кошка сдохла.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l4",
      "character": "zhena",
      "text": "Ну мог бы сказать мне об этом, когда я вернусь домой!",
      "emotion": "angry",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "zhena",
      "text": "Теперь мне и отпуск не в радость.",
      "emotion": "sad",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l6",
      "character": "zhena",
      "text": "Мог бы просто немножко соврать. Например, что кошка залезла на крышу и ты не можешь её снять.",
      "emotion": "angry",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l7",
      "character": "muzhik",
      "text": "Ладно, прости. Я запомню.",
      "emotion": "sad",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l8",
      "character": "zhena",
      "text": "Ну а как там моя мама?",
      "emotion": "neutral",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l9",
      "character": "muzhik",
      "text": "Твоя мама на крыше, и мы не можем её снять.",
      "emotion": "neutral",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
