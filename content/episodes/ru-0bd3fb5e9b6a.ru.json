  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Студент привёл коменданта общаги к себе в комнату.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [
        "paren",
        "barmen"
      ],
      "exit": []
    },
    {
      "id": "l2",
      "character": "paren",
      "text": "Жить тут невозможно. Кошмар! Мышей полно!",
      "emotion": "angry",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "barmen",
      "text": "Да быть такого не может.",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "paren",
      "text": "Смотрите. Бросаю крошки.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "barmen",
      "text": "Одна мышь... вторая... третья...",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "barmen",
      "text": "Стоп. Это что, рыбка была?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "barmen",
      "text": "И опять мышь. Ну ладно, завелись немножко. А рыбка-то откуда?",
      "emotion": "neutral",
      "pauseAfterSec": 0.7,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "paren",
      "text": "Так, насчёт мышей убедились? Теперь давайте разберёмся с сыростью!",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    }
  ],
