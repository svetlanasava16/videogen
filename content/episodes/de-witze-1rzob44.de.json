{
  "id": "de-witze-1rzob44.de",
  "jokeId": "de-witze-1rzob44",
  "locale": "de",
  "title": "Der Chef",
  "location": "magazin",
  "place": "shop",
  "cast": [
    "muzhik",
    "barmen",
    "ptitsa"
  ],
  "roles": {
    "muzhik": "customer",
    "barmen": "salesman",
    "ptitsa": "parrot"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Kommt ein Kunde in eine Tierhandlung und fragt:",
      "emotion": "neutral",
      "pauseAfterSec": 0.2,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "muzhik",
      "text": "Was kostet denn dieser Papagei da?",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "barmen",
      "text": "Tausend Euro.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "Wieso ist der denn so teuer?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "barmen",
      "text": "Das ist ein sehr begabter Vogel, er kann fließend sprechen und bis hundert zählen.",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "muzhik",
      "text": "Und was kostet der da?",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "barmen",
      "text": "Tausendfünfhundert Euro.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "muzhik",
      "text": "So teuer schon wieder?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l9",
      "character": "barmen",
      "text": "Oh, das ist ein noch begabterer Vogel, der spricht fließend drei Sprachen und kann die gesamten Werke von Goethe auswendig!",
      "emotion": "happy",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l10",
      "character": "narrator",
      "text": "Da sieht der Kunde in der Ecke einen kleinen alten hässlichen Papagei.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l11",
      "character": "muzhik",
      "text": "Und der da hinten, der kostet doch sicher viel weniger?!",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l12",
      "character": "barmen",
      "text": "Nein, der kostet dreitausend Euro.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l13",
      "character": "muzhik",
      "text": "Wie bitte? Was kann der denn?!",
      "emotion": "surprised",
      "pauseAfterSec": 0.6,
      "enter": [],
      "exit": []
    },
    {
      "id": "l14",
      "character": "barmen",
      "text": "Ich weiß es auch nicht, der hat noch nie gesprochen, aber die beiden anderen nennen ihn „Chef“.",
      "emotion": "neutral",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
