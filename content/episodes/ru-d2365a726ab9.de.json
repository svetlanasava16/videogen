      "id": "l1",
      "character": "narrator",
      "text": "Religionsunterricht.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "uchilka",
      "text": "Und vergesst nicht, Kinder! Wer Einsen und Zweien schreibt, kommt in den Himmel.",
      "emotion": "smug",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "uchilka",
      "text": "Und wer Vieren und Fünfen schreibt, kommt in die Hölle!",
      "emotion": "angry",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l4",
      "character": "vovochka",
      "text": "Frau Müller, kann man die Schule denn gar nicht lebend abschließen?",
      "emotion": "surprised",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
