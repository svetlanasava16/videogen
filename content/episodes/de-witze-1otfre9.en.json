{
  "id": "de-witze-1otfre9.en",
  "jokeId": "de-witze-1otfre9",
  "locale": "en",
  "title": "The Divorce",
  "location": "gostinaya",
  "place": "home-living-room",
  "cast": [
    "tyoshcha",
    "ded",
    "paren"
  ],
  "roles": {
    "tyoshcha": "old-woman",
    "ded": "old-man",
    "paren": "son"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "An old man calls his son.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "ded",
      "text": "Listen, your mother and I are getting divorced.",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "ded",
      "text": "Forty-five years of this crap is enough.",
      "emotion": "angry",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "paren",
      "text": "What are you talking about, Dad?!",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "ded",
      "text": "We just can't stand each other anymore.",
      "emotion": "angry",
      "pauseAfterSec": 0.2,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "ded",
      "text": "I can't even look at her anymore, I've had enough.",
      "emotion": "angry",
      "pauseAfterSec": 0.2,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "ded",
      "text": "I don't want to discuss it.",
      "emotion": "neutral",
      "pauseAfterSec": 0.2,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "ded",
      "text": "Call your sister and let her know.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l9",
      "character": "narrator",
      "text": "Click. He hangs up.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l10",
      "character": "narrator",
      "text": "In a total panic, the son calls his sister right away. She completely loses it.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l11",
      "character": "devushka-ryzhaya",
      "text": "They are not getting divorced!",
      "emotion": "angry",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l12",
      "character": "narrator",
      "text": "She calls her father straight away.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l13",
      "character": "devushka-ryzhaya",
      "text": "You are not getting divorced!",
      "emotion": "angry",
      "pauseAfterSec": 0.2,
      "enter": [],
      "exit": []
    },
    {
      "id": "l14",
      "character": "devushka-ryzhaya",
      "text": "Don't you dare sign anything.",
      "emotion": "angry",
      "pauseAfterSec": 0.2,
      "enter": [],
      "exit": []
    },
    {
      "id": "l15",
      "character": "devushka-ryzhaya",
      "text": "We're both coming home tomorrow to sort this out.",
      "emotion": "angry",
      "pauseAfterSec": 0.2,
      "enter": [],
      "exit": []
    },
    {
      "id": "l16",
      "character": "devushka-ryzhaya",
      "text": "No lawyer, no forms, nothing! Got it?!",
      "emotion": "angry",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l17",
      "character": "narrator",
      "text": "Bam. She slams down the phone.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l18",
      "character": "ded",
      "text": "Good. They're both coming for Christmas.",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    },
    {
      "id": "l19",
      "character": "ded",
      "text": "And this year they're even paying for their own flights.",
      "emotion": "happy",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
