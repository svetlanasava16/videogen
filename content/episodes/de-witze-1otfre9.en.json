{
  "id": "de-witze-1otfre9.en",
  "jokeId": "de-witze-1otfre9",
  "locale": "en",
  "title": "The Divorce",
  "location": "gostinaya",
  "place": "home-living-room",
  "cast": [
    "ded",
    "tyoshcha",
    "paren"
  ],
  "roles": {
    "ded": "old-man",
    "tyoshcha": "old-woman",
    "paren": "son"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "An old man calls his son.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "ded",
      "text": "Listen, your mother and I are getting divorced.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "ded",
      "text": "Forty-five years of this crap is enough.",
      "emotion": "angry",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "paren",
      "text": "What are you talking about, Dad?!",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "ded",
      "text": "We just can't stand each other anymore. I can't even look at her, I've had enough.",
      "emotion": "angry",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "ded",
      "text": "I don't want to discuss it. Call your sister and let her know.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "narrator",
      "text": "The son, in a total panic, calls his sister right away.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "devushka-ryzhaya",
      "text": "They're not getting divorced at all!",
      "emotion": "angry",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l9",
      "character": "narrator",
      "text": "She calls her father directly.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l10",
      "character": "devushka-ryzhaya",
      "text": "You are not getting divorced! Don't you dare sign anything!",
      "emotion": "angry",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l11",
      "character": "devushka-ryzhaya",
      "text": "We're both coming home tomorrow and we'll sort this out. No lawyer, no forms, nothing! Understood?!",
      "emotion": "angry",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [
        "devushka-ryzhaya"
      ]
    },
    {
      "id": "l12",
      "character": "ded",
      "text": "Good. They're both coming for Christmas. And this year they're even paying for their own flights.",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
