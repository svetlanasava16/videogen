{
  "id": "ru-96fbdd97092c.de",
  "jokeId": "ru-96fbdd97092c",
  "locale": "de",
  "title": "Er bewegt sich!",
  "kind": "joke",
  "v": 2,
  "location": "nebesa",
  "place": "heaven",
  "cast": [
    "ded",
    "muzhik",
    "muzhik-sosed",
    "muzhik-ryzhy"
  ],
  "roles": {
    "ded": "saint-peter",
    "muzhik": "everyman",
    "muzhik-sosed": "everyman",
    "muzhik-ryzhy": "everyman"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Drei Freunde sterben bei einem Autounfall und landen natürlich direkt bei Petrus.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Petrus will die niedergeschlagenen Männer aufmuntern.",
      "emotion": "neutral",
      "pauseAfterSec": 0.2
    },
    {
      "id": "l3",
      "character": "ded",
      "text": "Stellt euch vor: Eure Beerdigung, ihr liegt im Sarg,",
      "emotion": "happy",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l3b",
      "character": "ded",
      "text": "festlich und feierlich, um euch Familie und Freunde.",
      "emotion": "happy",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "ded",
      "text": "Was sollen sie über euch sagen?",
      "emotion": "happy",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l5",
      "character": "muzhik",
      "text": "Schön wäre, wenn sie sagen, ich war ein wunderbarer Familienvater, ein guter Arzt,",
      "emotion": "sad",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l5b",
      "character": "muzhik",
      "text": "habe viele Menschen gerettet und Spuren in der Medizin hinterlassen.",
      "emotion": "sad",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l6",
      "character": "muzhik-sosed",
      "text": "Ich wünsche mir, dass jemand sagt, was für ein großartiger Lehrer ich war,",
      "emotion": "sad",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l6b",
      "character": "muzhik-sosed",
      "text": "dass ich Spuren in den Seelen der Jugend hinterlassen und Vernünftiges,",
      "emotion": "sad",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l6c",
      "character": "muzhik-sosed",
      "text": "Gutes, Ewiges gesät habe.",
      "emotion": "sad",
      "pauseAfterSec": 0.2
    },
    {
      "id": "l7",
      "character": "muzhik-sosed",
      "text": "Und dass ich ein guter Vater und Ehemann war.",
      "emotion": "sad",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l8",
      "character": "muzhik-ryzhy",
      "text": "Und ich wünsche mir, dass plötzlich alle auf einmal rufen: „Schaut, er bewegt sich!“",
      "emotion": "happy",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
