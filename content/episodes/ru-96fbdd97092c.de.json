  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Drei Freunde sterben bei einem Autounfall und landen natürlich direkt bei Petrus.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Petrus will die niedergeschlagenen Männer aufmuntern.",
      "emotion": "neutral",
      "pauseAfterSec": 0.2,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "ded",
      "text": "Stellt euch vor: Eure Beerdigung, ihr liegt im Sarg, festlich und feierlich, um euch Familie und Freunde.",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "ded",
      "text": "Was sollen sie über euch sagen?",
      "emotion": "happy",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "muzhik",
      "text": "Schön wäre, wenn sie sagen, ich war ein wunderbarer Familienvater, ein guter Arzt, habe viele Menschen gerettet und Spuren in der Medizin hinterlassen.",
      "emotion": "sad",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "muzhik-sosed",
      "text": "Ich wünsche mir, dass jemand sagt, was für ein großartiger Lehrer ich war, dass ich Spuren in den Seelen der Jugend hinterlassen und Vernünftiges, Gutes, Ewiges gesät habe.",
      "emotion": "sad",
      "pauseAfterSec": 0.2,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "muzhik-sosed",
      "text": "Und dass ich ein guter Vater und Ehemann war.",
      "emotion": "sad",
      "pauseAfterSec": 0.6,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "muzhik-ryzhy",
      "text": "Und ich wünsche mir, dass plötzlich alle auf einmal rufen: „Schaut, er bewegt sich!“",
      "emotion": "happy",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
  "explicit": false,
  "outroLaughs": [],
