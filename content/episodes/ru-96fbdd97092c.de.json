  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Zwei Freunde sterben bei einem Autounfall und landen bei Petrus.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "ded",
      "text": "Kopf hoch, Jungs. Stellt euch eure Beerdigung vor. Ihr liegt im Sarg, schick angezogen, Familie und Freunde um euch herum.",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "ded",
      "text": "Was sollen die Leute über euch sagen?",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "doktor",
      "text": "Dass ich ein guter Familienvater und ein guter Arzt war. Dass ich viele Leben gerettet habe.",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "doktor",
      "text": "Dass ich in der Medizin Spuren hinterlassen habe.",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "ded",
      "text": "Schön. Und du?",
      "emotion": "neutral",
      "pauseAfterSec": 0.7,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "muzhik",
      "text": "Ich hätte gern, dass alle auf einmal schreien: Guckt mal, er bewegt sich!",
      "emotion": "happy",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    }
  ],
