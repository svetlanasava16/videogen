{
  "id": "ru-e30eafa1a0e6.de",
  "jokeId": "ru-e30eafa1a0e6",
  "locale": "de",
  "title": "Die Streichholzschachtel",
  "kind": "joke",
  "v": 2,
  "location": "ulitsa",
  "place": "hospital",
  "cast": [
    "muzhik",
    "zhena",
    "tyoshcha"
  ],
  "roles": {
    "muzhik": "husband",
    "zhena": "wife",
    "tyoshcha": "janitor"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein Mann geht eine Stuhlprobe abgeben.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Er packt sie in eine Streichholzschachtel und macht sich auf den Weg zur Klinik.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "Und verschwindet...",
      "emotion": "sad",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l4",
      "character": "narrator",
      "text": "Drei Tage lang ist er nicht da.",
      "emotion": "sad",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "Seine Frau wird verrückt vor Sorge, sie hat alle angerufen, die sie nur konnte, nirgends ist er.",
      "emotion": "sad",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l6",
      "character": "zhena",
      "text": "Na, dann gehe ich in die Klinik, vielleicht weiß da jemand was.",
      "emotion": "sad",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l7",
      "character": "narrator",
      "text": "Sie kommt hin, aber dort weiß auch keiner Bescheid.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l8",
      "character": "tyoshcha",
      "text": "Schau mal in der Chirurgie nach,",
      "emotion": "neutral",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l8b",
      "character": "tyoshcha",
      "text": "da sitzt schon lange so ein Mann, vielleicht ist das deiner?",
      "emotion": "neutral",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l9",
      "character": "narrator",
      "text": "Die Frau geht hin. Sie schaut, und da sitzt ihr Mann, ganz in Gips.",
      "emotion": "surprised",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l10",
      "character": "zhena",
      "text": "Horst, wie ist das denn passiert, wer war das?",
      "emotion": "surprised",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l11",
      "character": "muzhik",
      "text": "Ich weiß gar nichts mehr.",
      "emotion": "sad",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l12",
      "character": "muzhik",
      "text": "Ich weiß nur noch, jemand hat nach Streichhölzern gefragt...",
      "emotion": "sad",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
