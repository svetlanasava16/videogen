{
  "id": "ru-e30eafa1a0e6.de",
  "jokeId": "ru-e30eafa1a0e6",
  "locale": "de",
  "title": "Die Streichholzschachtel",
  "location": "gostinaya",
  "place": "hospital",
  "cast": [
    "muzhik",
    "zhena"
  ],
  "roles": {
    "muzhik": "husband",
    "zhena": "wife"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein Mann ging eine Stuhlprobe abgeben.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Er tat sie in eine Streichholzschachtel und ging in die Klinik.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "Und verschwand... Drei Tage ist er weg.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "narrator",
      "text": "Seine Frau ist außer sich, sie hat alle angerufen, die sie nur konnte, nirgends ist er.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "zhena",
      "text": "Na, ich geh in die Klinik, vielleicht weiß da jemand was.",
      "emotion": "sad",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "Sie kommt hin, aber da weiß auch keiner Bescheid.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "tyoshcha",
      "text": "Schau mal in der Chirurgie nach, da sitzt schon lange irgendein Mann, vielleicht ist das deiner?",
      "emotion": "neutral",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "narrator",
      "text": "Die Frau geht hin. Sie schaut, da sitzt ihr Mann, ganz in Gips.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l9",
      "character": "zhena",
      "text": "Horst, wie ist das denn passiert, wer war das?",
      "emotion": "surprised",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l10",
      "character": "muzhik",
      "text": "Ich weiß nichts mehr.",
      "emotion": "sad",
      "pauseAfterSec": 0.7,
      "enter": [],
      "exit": []
    },
    {
      "id": "l11",
      "character": "muzhik",
      "text": "Ich weiß nur noch, jemand hat mich nach Streichhölzern gefragt...",
      "emotion": "sad",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
