  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Англичанин и ирландец заходят в булочную. Англичанин крадёт три булочки и прячет их по карманам.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "vor",
      "text": "Чтобы стащить эти булочки, нужны большое мастерство и хитрость. Хозяин меня даже не заметил.",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "muzhik",
      "text": "Это просто обычное воровство.",
      "emotion": "neutral",
      "pauseAfterSec": 0.2,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "Я покажу тебе, как сделать это честно и получить тот же результат.",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "muzhik",
      "text": "Хозяин! Хочу показать вам фокус.",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "Хозяину любопытно, и он подходит посмотреть на фокус.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [
        "barmen"
      ],
      "exit": []
    },
    {
      "id": "l7",
      "character": "muzhik",
      "text": "Дайте мне булочку.",
      "emotion": "happy",
      "pauseAfterSec": 0.2,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "narrator",
      "text": "И съедает её.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l9",
      "character": "muzhik",
      "text": "Ещё одну, пожалуйста.",
      "emotion": "happy",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l10",
      "character": "muzhik",
      "text": "И ещё одну.",
      "emotion": "happy",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l11",
      "character": "barmen",
      "text": "Ну хорошо, друг мой, а где же фокус?",
      "emotion": "surprised",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    },
    {
      "id": "l12",
      "character": "muzhik",
      "text": "Загляните в карманы англичанина.",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
