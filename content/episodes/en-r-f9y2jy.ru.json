{
  "id": "en-r-f9y2jy.ru",
  "jokeId": "en-r-f9y2jy",
  "locale": "ru",
  "title": "Фокус",
  "kind": "joke",
  "v": 2,
  "location": "magazin",
  "place": "shop",
  "cast": [
    "muzhik-sosed",
    "muzhik-ryzhy",
    "barmen"
  ],
  "roles": {
    "muzhik-sosed": "customer",
    "muzhik-ryzhy": "customer",
    "barmen": "cook"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Англичанин и ирландец заходят в булочную.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Англичанин крадёт три булочки, рассовывает их по карманам и уходит. Он говорит ирландцу:",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "muzhik-sosed",
      "text": "Чтобы украсть эти булочки, нужны большое мастерство и хитрость. Хозяин меня даже не заметил.",
      "emotion": "smug",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l4",
      "character": "muzhik-ryzhy",
      "text": "Это просто обычное воровство.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "muzhik-ryzhy",
      "text": "Я покажу тебе, как сделать это честным путём и получить тот же результат.",
      "emotion": "smug",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "Тогда ирландец подзывает хозяина булочной.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l7",
      "character": "muzhik-ryzhy",
      "text": "Уважаемый, я хочу показать вам фокус.",
      "emotion": "happy",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l8",
      "character": "narrator",
      "text": "Хозяину стало интересно, и он подошёл посмотреть на фокус.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l9",
      "character": "narrator",
      "text": "Ирландец попросил у него булочку и съел её.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l10",
      "character": "narrator",
      "text": "Он попросил ещё два раза, и когда съел и эти, хозяин говорит:",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l11",
      "character": "barmen",
      "text": "Ну хорошо, друг мой, и где же фокус?",
      "emotion": "surprised",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l12",
      "character": "muzhik-ryzhy",
      "text": "Загляните в карманы англичанина.",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
