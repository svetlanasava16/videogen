  "locale": "en",
  "title": "Arthritis",
  "kind": "joke",
  "v": 2,
  "location": "doroga",
  "place": "bus",
  "cast": [
    "muzhik",
    "batyushka"
  ],
  "roles": {
    "muzhik": "drunk",
    "batyushka": "priest"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "A totally drunk guy in a torn shirt, with lipstick marks on his face and empty bottles in his pockets,",
      "emotion": "neutral",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l1b",
      "character": "narrator",
      "text": "gets on a bus and sits down next to a priest.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "The drunk opens a newspaper and reads something.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "muzhik",
      "text": "Father, do you happen to know what causes arthritis?",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "batyushka",
      "text": "Arthritis, my son, comes to those who have strayed from the true path,",
      "emotion": "angry",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l4b",
      "character": "batyushka",
      "text": "who sleep with fallen women and abuse alcohol!",
      "emotion": "angry",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l5",
      "character": "muzhik",
      "text": "Well, I'll be damned...",
      "emotion": "surprised",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "The drunk falls silent and stares thoughtfully at the floor. The priest regrets speaking so harshly.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l7",
      "character": "batyushka",
      "text": "All right, my son! How long have you had arthritis?",
      "emotion": "sad",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l8",
      "character": "muzhik",
      "text": "What are you talking about! I don't have arthritis!",
      "emotion": "surprised",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l8b",
      "character": "muzhik",
      "text": "It says here in the paper that the Pope has arthritis!",
      "emotion": "surprised",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
