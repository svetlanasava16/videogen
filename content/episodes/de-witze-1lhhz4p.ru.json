  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Мужчина приходит к врачу.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "muzhik",
      "text": "Доктор, мне кажется, моя жена плохо слышит.",
      "emotion": "sad",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "doktor",
      "text": "Заговорите с ней со спины. По тому, с какого расстояния она отреагирует, можно будет судить.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l4",
      "character": "narrator",
      "text": "Мужчина приходит домой и застаёт жену на кухне: она готовит ужин.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "muzhik",
      "text": "Дорогая, что у нас сегодня поесть?",
      "emotion": "neutral",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l6",
      "character": "muzhik",
      "text": "Дорогая, что у нас сегодня на ужин?",
      "emotion": "neutral",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l7",
      "character": "muzhik",
      "text": "Дорогая, что мы сегодня едим?",
      "emotion": "surprised",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l8",
      "character": "zhena",
      "text": "Я тебе уже третий раз говорю: на ужин курица!",
      "emotion": "angry",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
