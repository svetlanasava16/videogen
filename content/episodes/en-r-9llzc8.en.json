  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Finding a woman sobbing that she had locked her keys in her car, a passing soldier assures her that he can help.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "She looks on amazed as he removes his trousers, rolls them into a tight ball and rubs them against the car door.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "Magically it opens.",
      "emotion": "surprised",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l4",
      "character": "devushka",
      "text": "That's so clever. How did you do it?",
      "emotion": "surprised",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l5",
      "character": "sluzhivy-ryadovoy",
      "text": "Easy. These are my khakis.",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
