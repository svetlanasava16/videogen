  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein Mann wacht mit einem höllischen Kater auf: Der Kopf wie mit Blei gefüllt, Arme und Beine wie fremd, sie lassen sich nicht heben.",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Irgendwie dreht er sich auf die Seite und stöhnt ganz jämmerlich, herzzerreißend:",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "muzhik",
      "text": "Be-ello... Be-e-ello...",
      "emotion": "sad",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "narrator",
      "text": "Der Hund kommt angerannt, winselt, schleckt ihn ab.",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "Der Mann haucht ihn kräftig an und sagt mit letzter Kraft:",
      "emotion": "neutral",
      "pauseAfterSec": 0.7,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "muzhik",
      "text": "Such!",
      "emotion": "angry",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
