  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Eine Frau bittet ihren Mann, einen Programmierer, einkaufen zu gehen.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "zhena",
      "text": "Kannst du runter zum Laden gehen und einen Liter Milch holen, und wenn sie Eier haben, nimm sechs.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "Später kommt er nach Hause.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "zhena",
      "text": "Warum zum Teufel hast du sechs Liter Milch?",
      "emotion": "angry",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l5",
      "character": "paren",
      "text": "Sie hatten Eier.",
      "emotion": "neutral",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
