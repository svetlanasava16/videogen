  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Пьяный мужик стоит в трамвае и ругает пассажиров слева:",
      "emotion": "neutral",
      "pauseAfterSec": 0.2,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "muzhik",
      "text": "Одни идиоты, одни идиоты!",
      "emotion": "angry",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "А на тех, кто справа, орёт:",
      "emotion": "neutral",
      "pauseAfterSec": 0.2,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "Одни изменщики, одни изменщики!",
      "emotion": "angry",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "Вдруг один мужчина вскакивает и кричит на него:",
      "emotion": "neutral",
      "pauseAfterSec": 0.2,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "muzhik-ryzhy",
      "text": "Да как вы смеете?",
      "emotion": "angry",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "muzhik-ryzhy",
      "text": "Я двадцать лет женат и ни разу не изменял жене!",
      "emotion": "angry",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "muzhik",
      "text": "Тогда пересядь к идиотам!",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
