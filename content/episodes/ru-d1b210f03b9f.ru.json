  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Звонили оба сотовых телефона, верещал стационарный.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Настойчиво вопил Скайп.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "Хозяин квартиры, сидящий на унитазе, истерично кричал:",
      "emotion": "neutral",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "В дверь позвоните кто-нибудь, заразы, ещё и в дверь!",
      "uncensored": "В дверь позвоните кто-нибудь, суки, ещё и в дверь!",
      "emotion": "angry",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
