  "lines": [
    {
      "id": "l1",
      "character": "paren",
      "text": "Надоело! Вечно с вами, вечно приходить вовремя!",
      "emotion": "angry",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "paren",
      "text": "Я хочу романтики, свободы, пива и девчонок!",
      "emotion": "angry",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "paren",
      "text": "Я ухожу! И не пытайтесь меня удержать!",
      "emotion": "angry",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "narrator",
      "text": "У двери его догоняет отец.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "paren",
      "text": "Папа, я же сказал, не останавливай меня!",
      "emotion": "angry",
      "pauseAfterSec": 0.7,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "muzhik",
      "text": "Я не останавливаю, сынок. Я с тобой!",
      "emotion": "happy",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [
        "paren",
        "muzhik"
      ]
    }
  ],
