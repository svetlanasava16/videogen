  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "A man is driving to a meeting, he's late, he's nervous,",
      "emotion": "neutral",
      "pauseAfterSec": 0
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "and he can't find anywhere to park.",
      "emotion": "neutral",
      "pauseAfterSec": 0
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "He lifts his face to the sky and says:",
      "emotion": "neutral",
      "pauseAfterSec": 0
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "Lord, help me find a parking space.",
      "emotion": "sad",
      "pauseAfterSec": 0
    },
    {
      "id": "l5",
      "character": "muzhik",
      "text": "Then I'll quit drinking and go to church every Sunday!",
      "emotion": "sad",
      "pauseAfterSec": 0
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "Suddenly, miraculously, a free spot appears.",
      "emotion": "surprised",
      "pauseAfterSec": 0
    },
    {
      "id": "l7",
      "character": "narrator",
      "text": "The man turns to the sky again:",
      "emotion": "neutral",
      "pauseAfterSec": 0
    },
    {
      "id": "l8",
      "character": "muzhik",
      "text": "Oh, never mind. Found one!",
      "emotion": "happy",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
