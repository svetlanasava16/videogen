  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein Verkehrspolizist starb. Er stand vor Gott.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "ded",
      "text": "Nun, mein Sohn, hast du den Menschen Gutes getan?",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "sluzhivy",
      "text": "Ja, kam vor.",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "ded",
      "text": "Und Böses?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "sluzhivy",
      "text": "Das kam auch vor.",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "ded",
      "text": "Nun, hier sind zwei Wege für dich, einer in den Himmel, der andere in die Hölle.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "ded",
      "text": "Welchen du wählst, dorthin kommst du.",
      "emotion": "neutral",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "sluzhivy",
      "text": "Kann ich nicht einfach hier an der Kreuzung bleiben?",
      "emotion": "happy",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
