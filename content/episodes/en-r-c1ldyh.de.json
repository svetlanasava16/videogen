  "locale": "de",
  "title": "Der Bus",
  "location": "bar",
  "place": "road",
  "cast": [
    "muzhik"
  ],
  "roles": {
    "muzhik": "drunk"
  },
  "lines": [
    {
      "id": "l1",
      "character": "muzhik",
      "text": "Gestern Abend war ich auf ein paar Drinks unterwegs.",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "muzhik",
      "text": "Eins führte zum anderen, ich hatte ein paar Cocktails zu viel und bin dann auf Wein umgestiegen. Keine gute Idee.",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "muzhik",
      "text": "Weil ich wusste, dass ich über der Promillegrenze war, habe ich mein Auto an der Kneipe stehen lassen und bin mit einem Bus nach Hause.",
      "emotion": "smug",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "Und tatsächlich kam ich an einer Polizeikontrolle vorbei, wo sie Fahrer rauswinkten und Alkoholtests machten.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "muzhik",
      "text": "Weil ich in einem Bus war, haben sie ihn einfach durchgewunken.",
      "emotion": "happy",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "muzhik",
      "text": "Ich bin sicher und ohne Zwischenfälle zu Hause angekommen,",
      "emotion": "smug",
      "pauseAfterSec": 0.6,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "muzhik",
      "text": "was mich echt überrascht hat, denn ich bin noch nie einen Bus gefahren und weiß nicht mal, wo ich ihn herhabe.",
      "emotion": "surprised",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
