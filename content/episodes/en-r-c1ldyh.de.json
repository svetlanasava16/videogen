{
  "id": "en-r-c1ldyh.de",
  "jokeId": "en-r-c1ldyh",
  "locale": "de",
  "title": "Mit dem Bus",
  "kind": "joke",
  "v": 2,
  "location": "bar",
  "place": "road",
  "cast": [
    "muzhik",
    "sluzhivy"
  ],
  "roles": {
    "muzhik": "drunk",
    "sluzhivy": "traffic-cop"
  },
  "lines": [
    {
      "id": "l1",
      "character": "muzhik",
      "text": "Gestern Abend war ich auf ein paar Drinks unterwegs.",
      "emotion": "happy",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "muzhik",
      "text": "Eins führte zum anderen, ich hatte ein paar Cocktails zu viel und bin dann auf Wein umgestiegen.",
      "emotion": "happy",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "muzhik",
      "text": "Keine gute Idee.",
      "emotion": "sad",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "Weil ich wusste, dass ich über der Grenze war, hab ich beschlossen, mein Auto an der Kneipe stehen zu lassen, und bin mit dem Bus nach Hause gefahren.",
      "emotion": "smug",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l5",
      "character": "muzhik",
      "text": "Und tatsächlich kam ich an einer Polizeikontrolle vorbei, wo sie Fahrer rausgewinkt und Alkoholtests gemacht haben.",
      "offscreen": true,
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l6",
      "character": "muzhik",
      "text": "Weil ich in einem Bus saß, haben sie ihn einfach durchgewinkt.",
      "offscreen": true,
      "emotion": "smug",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l7",
      "character": "muzhik",
      "text": "Ich bin sicher und ohne Zwischenfälle zu Hause angekommen,",
      "emotion": "happy",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l8",
      "character": "muzhik",
      "text": "was mich echt überrascht hat, denn ich bin noch nie einen Bus gefahren und weiß nicht mal genau, wo ich ihn herhatte.",
      "emotion": "surprised",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
