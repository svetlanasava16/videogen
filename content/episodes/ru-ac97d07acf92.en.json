  "lines": [
    {
      "id": "l1",
      "character": "zhena",
      "text": "Sweetheart, that boy is an orphan, and on top of that he limps.",
      "emotion": "sad",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "zhena",
      "text": "Don't marry him.",
      "emotion": "sad",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l3",
      "character": "devushka-ryzhaya",
      "text": "I don't need a handsome one.",
      "emotion": "angry",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l4",
      "character": "zhena",
      "text": "That's not what I mean.",
      "emotion": "neutral",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l5",
      "character": "zhena",
      "text": "Have pity on the boy, life has been hard enough on him already.",
      "emotion": "sad",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
