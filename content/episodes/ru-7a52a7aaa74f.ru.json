            "end": 0.522
          },
          {
            "text": "обед.",
            "start": 0.546,
            "end": 1.033
          },
          {
            "text": "За",
            "start": 1.474,
            "end": 1.602
          },
          {
            "text": "столом",
            "start": 1.625,
            "end": 1.95
          },
          {
