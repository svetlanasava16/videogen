    {
      "id": "l1",
      "character": "muzhik",
      "text": "Herr Doktor, es gibt doch so eine Operation, nach der man garantiert keine Kinder mehr bekommt. Die hätte ich gern.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [
        "muzhik"
      ],
      "exit": []
    },
    {
      "id": "l2",
      "character": "doktor",
      "text": "Aber, mein Lieber, so eine Entscheidung bricht man nicht übers Knie.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "doktor",
      "text": "Heute wollen Sie keine Kinder, morgen vielleicht doch. Überlegen Sie es sich gut, besprechen Sie es mit der Familie.",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "Haben wir schon.",
      "emotion": "sad",
      "pauseAfterSec": 0.6,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "muzhik",
      "text": "Ergebnis der Abstimmung: zwei dagegen, siebzehn dafür.",
      "emotion": "sad",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    }
