  "locale": "de",
  "title": "Die Abstimmung",
  "kind": "joke",
  "v": 2,
  "location": "bolnitsa",
  "place": "doctor-office",
  "cast": [
    "doktor",
    "muzhik"
  ],
  "roles": {
    "doktor": "doctor",
    "muzhik": "patient"
  },
  "lines": [
    {
      "id": "l1",
      "character": "muzhik",
      "text": "Herr Doktor, ich habe gehört, es gibt so eine Operation, nach der man gar keine Kinder mehr bekommen kann.",
      "emotion": "sad",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "muzhik",
      "text": "Machen Sie mir so eine.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "doktor",
      "text": "Na, mein Lieber, solche Entscheidungen trifft man nicht aus dem Bauch heraus.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "doktor",
      "text": "Heute wollen Sie keine Kinder, und morgen wollen Sie doch welche.",
      "emotion": "smug",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "doktor",
      "text": "Wägen Sie alles ab, besprechen Sie es mit der Familie...",
      "emotion": "neutral",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l6",
      "character": "muzhik",
      "text": "Haben wir schon. Die Abstimmung: zwei dagegen, siebzehn dafür.",
      "emotion": "sad",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
  "explicit": false,
