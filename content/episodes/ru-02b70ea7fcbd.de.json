  "lines": [
    {
      "id": "l1",
      "character": "muzhik",
      "text": "Herr Doktor, ich habe gehört, es gibt so eine Operation, nach der man gar keine Kinder mehr bekommen kann.",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [
        "muzhik"
      ],
      "exit": []
    },
    {
      "id": "l2",
      "character": "muzhik",
      "text": "Machen Sie mir so eine.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "doktor",
      "text": "Na, mein Lieber, solche Entscheidungen trifft man nicht aus dem Bauch heraus.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "doktor",
      "text": "Heute wollen Sie keine Kinder, und morgen wollen Sie doch welche.",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "doktor",
      "text": "Wägen Sie alles ab, besprechen Sie es mit der Familie...",
      "emotion": "neutral",
      "pauseAfterSec": 0.6,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "muzhik",
      "text": "Haben wir schon. Die Abstimmung: zwei dagegen, siebzehn dafür.",
      "emotion": "sad",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
