{
  "id": "ru-96793a9895e8.de",
  "jokeId": "ru-96793a9895e8",
  "locale": "de",
  "title": "Der Totengräber",
  "location": "ulitsa",
  "place": "cemetery",
  "cast": [
    "muzhik",
    "muzhik-ryzhy"
  ],
  "roles": {
    "muzhik": "drunk",
    "muzhik-ryzhy": "everyman"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein Säufer hat sich auf dem Friedhof volllaufen lassen, ist in ein Grab gefallen und eingeschlafen.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Nachts wacht er auf und merkt, dass er auf dem Friedhof ist. Da gräbt ein Totengräber ein Grab.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "muzhik",
      "text": "Na warte, den erschrecke ich mal.",
      "emotion": "smug",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "narrator",
      "text": "Er wirft sich ein weißes Laken über den Kopf, geht zum Totengräber und heult ganz schaurig:",
      "emotion": "neutral",
      "pauseAfterSec": 0.2,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "muzhik",
      "text": "Huuuuuuu!",
      "emotion": "angry",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "Der Totengräber schaut ihn völlig gleichgültig an und gräbt weiter.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "narrator",
      "text": "Der Säufer versteht das nicht, kommt von der anderen Seite, noch lauter und schauriger:",
      "emotion": "neutral",
      "pauseAfterSec": 0.2,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "muzhik",
      "text": "Huuu! Huuu! Huuu! Huuuuuuu!",
      "emotion": "angry",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l9",
      "character": "narrator",
      "text": "Dem Totengräber ist es wieder egal, er schaut, Mist, überhaupt keine Reaktion.",
      "uncensored": "Dem Totengräber ist es wieder egal, er schaut, Scheiße, überhaupt keine Reaktion.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l10",
      "character": "narrator",
      "text": "Enttäuscht geht der Säufer zum Ausgang und vergisst sogar, das Laken abzunehmen.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l11",
      "character": "narrator",
      "text": "Am Tor holt ihn der Totengräber ein, haut ihm die Schaufel ins Gesicht und sagt ganz ruhig:",
      "uncensored": "Am Tor holt ihn der Totengräber ein, haut ihm die Schaufel in die Fresse und sagt ganz ruhig:",
      "emotion": "neutral",
      "pauseAfterSec": 0.6,
      "enter": [],
      "exit": []
    },
    {
      "id": "l12",
      "character": "muzhik-ryzhy",
      "text": "Spazieren – spazier ruhig, aber das Gelände verlässt du nicht.",
      "emotion": "neutral",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
