  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Молодожены по дороге в церковь попали в аварию и прямиком отправились в рай на встречу с Богом.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "zhena",
      "text": "Мы так любим друг друга,",
      "emotion": "happy",
      "pauseAfterSec": 0.2,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "muzhik",
      "text": "и хотим все-таки пожениться.",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "ded",
      "text": "Вы тут первые с такой просьбой.",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": [
        "ded"
      ]
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "И исчез на три недели.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "Через три недели он появился со священником, который их и повенчал.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [
        "ded",
        "batyushka"
      ],
      "exit": []
    },
    {
      "id": "l7",
      "character": "narrator",
      "text": "А молодожены опять недовольны.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "muzhik",
      "text": "Так, вроде, в раю ни к чему брак.",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l9",
      "character": "zhena",
      "text": "А нельзя ли развестись?",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l10",
      "character": "ded",
      "text": "Не морочьте мне голову!",
      "emotion": "angry",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l11",
      "character": "ded",
      "text": "Я три недели потратил, чтобы найти в раю хоть какого-нибудь священника!",
      "emotion": "angry",
      "pauseAfterSec": 0.7,
      "enter": [],
      "exit": []
    },
    {
      "id": "l12",
      "character": "ded",
      "text": "Вы хоть представляете, сколько времени потребуется, чтобы найти в раю адвоката?!",
      "emotion": "angry",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
