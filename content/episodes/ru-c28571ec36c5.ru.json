  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Паркуются рядом «Мерседес» и «Запорожец».",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "nachalnik",
      "text": "Ездят тут всякие «мичуринцы» чёртовы на своих тачках дешёвых!",
      "uncensored": "Ездят тут всякие «мичуринцы» долбаные на своих тачках дешёвых!",
      "emotion": "angry",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "nachalnik",
      "text": "Того и гляди крутую машину поцарапают!",
      "emotion": "angry",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "И не говори, братан! Обнаглели совсем!",
      "emotion": "smug",
      "pauseAfterSec": 0.7,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "muzhik",
      "text": "Представляешь, мне вчера велосипедист в бочину въехал!",
      "emotion": "angry",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
