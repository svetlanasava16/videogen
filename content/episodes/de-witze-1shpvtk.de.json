{
  "id": "de-witze-1shpvtk.de",
  "jokeId": "de-witze-1shpvtk",
  "locale": "de",
  "title": "Kükenwitz",
  "kind": "joke",
  "v": 2,
  "location": "magazin",
  "place": "shop",
  "cast": [
    "barmen",
    "muzhik"
  ],
  "roles": {
    "barmen": "salesman",
    "muzhik": "customer"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Kommt ein Mann zur Tierhandlung.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "muzhik",
      "text": "Guten Tag, ich hätte hundert Küken.",
      "emotion": "happy",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "Der Händler wundert sich, was er denn mit den ganzen Küken anstellen will, sagt aber erstmal nichts und verkauft sie ihm.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "narrator",
      "text": "Ein paar Tage später steht der Mann wieder im Laden.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "muzhik",
      "text": "Guten Tag, bitte nochmal hundert Küken.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "Das Ganze wiederholt sich noch ein paar Mal, bis der Ladenbesitzer irgendwann verwundert fragt:",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l7",
      "character": "barmen",
      "text": "Ja sagen Sie mal, was machen Sie denn mit den ganzen Küken?",
      "emotion": "surprised",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l8",
      "character": "muzhik",
      "text": "Ja ich weiß es auch nicht!",
      "emotion": "sad",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l8b",
      "character": "muzhik",
      "text": "Entweder ich pflanze sie zu tief oder zu dicht beieinander!",
      "emotion": "sad",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
