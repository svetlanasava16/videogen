      "id": "l1",
      "character": "narrator",
      "text": "Kommt ein Mann zur Tierhandlung.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "muzhik",
      "text": "Guten Tag, ich hätte hundert Küken.",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [
        "muzhik"
      ],
      "exit": []
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "Der Händler wundert sich, was er denn mit den ganzen Küken anstellen will, sagt aber erstmal nichts und verkauft sie ihm.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": [
        "muzhik"
      ]
    },
    {
      "id": "l4",
      "character": "narrator",
      "text": "Ein paar Tage später steht der Mann wieder im Laden.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [
        "muzhik"
      ],
      "exit": []
    },
    {
      "id": "l5",
      "character": "muzhik",
      "text": "Guten Tag, bitte nochmal hundert Küken.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "Das Ganze wiederholt sich noch ein paar Mal, bis der Ladenbesitzer irgendwann verwundert fragt:",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "barmen",
      "text": "Ja sagen Sie mal, was machen Sie denn mit den ganzen Küken?",
      "emotion": "surprised",
      "pauseAfterSec": 0.7,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "muzhik",
      "text": "Ja ich weiß es auch nicht! Entweder ich pflanze sie zu tief oder zu dicht beieinander!",
      "emotion": "sad",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
