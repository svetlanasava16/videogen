  "locale": "ru",
  "title": "Рецепт",
  "kind": "joke",
  "v": 2,
  "location": "magazin",
  "place": "pharmacy",
  "cast": [
    "muzhik",
    "uchilka"
  ],
  "roles": {
    "muzhik": "customer",
    "uchilka": "pharmacist"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Приходит мужик в аптеку.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "muzhik",
      "text": "Дайте мне, пожалуйста, пузырёк мышьяка.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "uchilka",
      "text": "Это вещество сильно ядовитое, такое я продавать не имею права!",
      "emotion": "surprised",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "Но я же хочу отравить свою жену!",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "uchilka",
      "text": "Да вы с ума сошли! Это запрещено, я сейчас же вызову полицию!",
      "emotion": "angry",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "Мужик достаёт фотографию своей жены, на которой она целует мужа аптекарши, и кладёт её на прилавок.",
      "emotion": "neutral",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l7",
      "character": "uchilka",
      "text": "А, так у вас есть рецепт...",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
