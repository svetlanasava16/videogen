  "lines": [
    {
      "id": "l1",
      "character": "barmen",
      "text": "Heiliger Vater, wir zahlen zehn Millionen Euro,",
      "emotion": "smug",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l1b",
      "character": "barmen",
      "text": "wenn es im Gottesdienst ab jetzt heißt: Unsere tägliche Cola gib uns heute.",
      "emotion": "smug",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "batyushka",
      "text": "Keine Chance. Das können wir nicht machen!",
      "emotion": "angry",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "barmen",
      "text": "Wir würden der Kirche sogar hundert Millionen zahlen.",
      "emotion": "smug",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l4",
      "character": "batyushka",
      "text": "Bruder, wie lange läuft eigentlich noch der Vertrag mit der Bäckerei?",
      "emotion": "neutral",
      "pauseAfterSec": 0.8
    }
  ],
