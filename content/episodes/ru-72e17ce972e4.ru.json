    {
      "id": "l1",
      "character": "narrator",
      "text": "Пёс на дачном участке копает землю. Копает лопатой.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Соседский барбос смотрит на него обалдевшим взором.",
      "emotion": "neutral",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l3",
      "character": "pyos",
      "text": "А всё началось с того, что я, дурак, научился приносить тапочки...",
      "emotion": "sad",
      "pauseAfterSec": 0.8,
      "laugh": "big"
