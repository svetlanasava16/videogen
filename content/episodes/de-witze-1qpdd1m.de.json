      "id": "l1",
      "character": "devushka",
      "text": "Und, wie war deine Fahrprüfung?",
      "emotion": "happy",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "devushka-blondinka",
      "text": "Oh hör bloß auf, ich bin durchgefallen!",
      "emotion": "sad",
