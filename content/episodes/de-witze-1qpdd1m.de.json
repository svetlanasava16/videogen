      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "devushka-blondinka",
      "text": "Naja, da war ein Kreisverkehr mit 'nem Schild dreißig,",
      "emotion": "sad",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l4b",
