{
  "id": "ru-9ec25a940d9f.en",
  "jokeId": "ru-9ec25a940d9f",
  "locale": "en",
  "title": "Chops with Peas",
  "kind": "joke",
  "v": 2,
  "location": "gostinaya",
  "place": "home-kitchen",
  "cast": [
    "zhena",
    "muzhik",
    "nachalnik"
  ],
  "roles": {
    "muzhik": "husband",
    "nachalnik": "boss",
    "zhena": "wife"
  },
  "lines": [
    {
      "id": "l1",
      "character": "muzhik",
      "text": "We're having guests in half an hour. I invited my boss.",
      "emotion": "surprised",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "zhena",
      "text": "Are you out of your mind? We have nothing in the house to treat him with.",
      "emotion": "angry",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "muzhik",
      "text": "Well, come up with something.",
      "emotion": "neutral",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l3b",
      "character": "muzhik",
      "text": "We absolutely have to have him over, tomorrow they decide who gets a raise.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "zhena",
      "text": "But we have nothing. Just soup for you and a can of peas.",
      "emotion": "sad",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "muzhik",
      "text": "Okay, listen to me. When he comes, I'll say you're making pork chops with peas.",
      "emotion": "smug",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l6",
      "character": "muzhik",
      "text": "Meanwhile I'll treat him to our homemade liqueur in here.",
      "emotion": "smug",
      "pauseAfterSec": 0.2
    },
    {
      "id": "l7",
      "character": "muzhik",
      "text": "Then you break a plate in the kitchen and start wailing.",
      "emotion": "smug",
      "pauseAfterSec": 0.2
    },
    {
      "id": "l8",
      "character": "muzhik",
      "text": "I'll ask you what's wrong, and you shout that you dropped the chops in the trash.",
      "emotion": "smug",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l9",
      "character": "muzhik",
      "text": "You serve the peas, nothing else we can do.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l10",
      "character": "narrator",
      "text": "Long story short, they agree. The boss arrives.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l11",
      "character": "narrator",
      "text": "The husband treats him to the liqueur, then shouts to his wife:",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l12",
      "character": "muzhik",
      "text": "So, how are our pork chops with peas coming along?",
      "emotion": "happy",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l13",
      "character": "narrator",
      "text": "In the kitchen, plates fall, a crash, wailing.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l14",
      "character": "muzhik",
      "text": "Well, butterfingers? Don't tell me you dropped the chops in the trash?",
      "emotion": "smug",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l15",
      "character": "zhena",
      "text": "No, the peas.",
      "offscreen": true,
      "emotion": "sad",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
