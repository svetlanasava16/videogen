  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Two priests are putting up a sign by the road: “Stop, the end is near! Turn back before it's too late!”",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "A truck races past them at top speed.",
      "emotion": "neutral",
      "pauseAfterSec": 0.2,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "muzhik-ryzhy",
      "text": "Damn cultists, I'm sick of you!",
      "emotion": "angry",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "narrator",
      "text": "The truck disappears around the bend, and from there comes a crash and a loud splash.",
      "emotion": "neutral",
      "pauseAfterSec": 0.9,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "batyushka",
      "text": "Looks like you were right, we should have just written “Bridge out”.",
      "emotion": "sad",
      "pauseAfterSec": 0.8,
