  "locale": "en",
  "title": "Church Acoustics",
  "kind": "joke",
  "v": 2,
  "location": "tserkov",
  "place": "church",
  "cast": [
    "batyushka",
    "vovochka"
  ],
  "roles": {
    "batyushka": "priest",
    "vovochka": "child"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "A priest confronts the altar boy in church.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "batyushka",
      "text": "Boy, I know you've been getting drunk on the communion wine!",
      "emotion": "angry",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l3",
      "character": "batyushka",
      "text": "Boy, why don't you react? Can't you hear me?",
      "emotion": "angry",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "vovochka",
      "text": "No, Father, I can't.",
      "emotion": "neutral",
      "pauseAfterSec": 0.2
    },
    {
      "id": "l5",
      "character": "vovochka",
      "text": "From where I'm standing, I can't hear your voice.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l6",
      "character": "batyushka",
      "text": "Tell me, are you pulling my leg?",
      "emotion": "angry",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l7",
      "character": "vovochka",
      "text": "Father, I can prove it.",
      "emotion": "smug",
      "pauseAfterSec": 0.2
    },
    {
      "id": "l8",
      "character": "vovochka",
      "text": "You stand here, and I'll stand over there, where you're standing now.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l9",
      "character": "vovochka",
      "text": "Oh, by the way, Father, they say a big part of the collection money has gone missing.",
      "emotion": "smug",
      "pauseAfterSec": 0.2
    },
    {
      "id": "l10",
      "character": "vovochka",
      "text": "Would you happen to know anything about that?",
      "emotion": "smug",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l11",
      "character": "batyushka",
      "text": "You're right. From here you really can't hear a thing.",
      "emotion": "happy",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
