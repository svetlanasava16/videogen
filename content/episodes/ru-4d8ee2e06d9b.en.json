    {
      "id": "l1",
      "character": "muzhik",
      "text": "I call my wife sweet names: my bunny, my little goldfish, my little birdie...",
      "emotion": "happy",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "muzhik-sosed",
      "text": "And what does she do?",
      "emotion": "surprised",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l3",
      "character": "muzhik",
      "text": "She sticks her ears out, bulges her eyes and clacks her beak...",
