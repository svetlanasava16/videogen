  "locale": "de",
  "title": "Rückwärts",
  "kind": "joke",
  "v": 2,
  "location": "doroga",
  "place": "road",
  "cast": [
    "muzhik",
    "muzhik-ryzhy"
  ],
  "roles": {
    "muzhik": "everyman",
    "muzhik-ryzhy": "driver"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Fährt ein Fahrer mit seinem Vierzigtonner rückwärts eine fünf Kilometer lange und steile Serpentinenstraße hoch.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Nach zwei Kilometern hält ihn einer an.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "muzhik",
      "text": "Warum fährst du rückwärts?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "muzhik-ryzhy",
      "text": "Ich muss oben was ausliefern, und mein Chef hat gesagt,",
      "emotion": "neutral",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l4b",
      "character": "muzhik-ryzhy",
      "text": "man kann dort oben nicht wenden.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "Nach sechs Stunden kommt er wieder runter. Rückwärts!",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l6",
      "character": "muzhik",
      "text": "Warum fährst du rückwärts wieder runter?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l7",
      "character": "muzhik-ryzhy",
      "text": "Da sieht man mal wieder, dass der Chef keine Ahnung hat vom Fahren.",
      "emotion": "smug",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l8",
      "character": "muzhik-ryzhy",
      "text": "Ich konnte doch wenden!",
      "emotion": "happy",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
