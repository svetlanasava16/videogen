  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein Lkw-Fahrer fährt mit seinem Vierzigtonner rückwärts eine steile Serpentinenstraße hinauf.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [
        "muzhik-ryzhy"
      ],
      "exit": []
    },
    {
      "id": "l2",
      "character": "muzhik",
      "text": "Hey! Warum fährst du denn rückwärts?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "muzhik-ryzhy",
      "text": "Ich muss oben was ausliefern, und mein Chef sagt, da oben kann man nicht wenden.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": [
        "muzhik-ryzhy"
      ]
    },
    {
      "id": "l4",
      "character": "narrator",
      "text": "Sechs Stunden später kommt er wieder herunter. Rückwärts.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [
        "muzhik-ryzhy"
      ],
      "exit": []
    },
    {
      "id": "l5",
      "character": "muzhik",
      "text": "Und warum fährst du jetzt rückwärts wieder runter?",
      "emotion": "surprised",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "muzhik-ryzhy",
      "text": "Tja, der Chef hat eben keine Ahnung vom Fahren.",
      "emotion": "smug",
      "pauseAfterSec": 0.6,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "muzhik-ryzhy",
      "text": "Ich konnte oben nämlich doch wenden!",
      "emotion": "happy",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    }
  ],
