  "lines": [
    {
      "id": "l1",
      "character": "sluzhivy",
      "text": "Ватсон, а что это вы курите?",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "sluzhivy",
      "text": "Дайте угадаю: табак «Королева Вирджиния» с листочками вишни, из юбилейного выпуска в бархатной упаковке?",
      "emotion": "smug",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "doktor",
      "text": "Поразительно, Холмс! Как это вы угадали?",
      "emotion": "surprised",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l4",
      "character": "sluzhivy",
      "text": "Ей-богу, Ватсон! Ну не миссис Хадсон же стащила из моей комнаты последнюю пачку!",
      "uncensored": "Ей-богу, Ватсон! Ну не миссис Хадсон же спиздила из моей комнаты последнюю пачку!",
      "emotion": "angry",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
