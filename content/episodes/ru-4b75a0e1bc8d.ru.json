  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Женщина за пятьдесят на приёме у молоденького доктора, только что из института.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "tyoshcha",
      "text": "Что? Беременна? Я? Да вы с ума сошли!",
      "emotion": "angry",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": [
        "tyoshcha"
      ]
    },
    {
      "id": "l3",
      "character": "doktor",
      "text": "Ты что себе позволяешь?",
      "emotion": "angry",
      "pauseAfterSec": 0.3,
      "enter": [
        "doktor"
      ],
      "exit": []
    },
    {
      "id": "l4",
      "character": "doktor",
      "text": "Ей пятьдесят шестой год, у неё взрослая дочь, скоро внук будет!",
      "emotion": "angry",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "doktor",
      "text": "А ты ей говоришь, что она беременна?",
      "emotion": "surprised",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "paren",
      "text": "Но икоточка-то у неё прошла?",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    }
  ],
