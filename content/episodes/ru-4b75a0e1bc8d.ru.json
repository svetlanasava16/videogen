{
  "id": "ru-4b75a0e1bc8d.ru",
  "jokeId": "ru-4b75a0e1bc8d",
  "locale": "ru",
  "title": "Икота",
  "location": "bolnitsa",
  "place": "hospital",
  "cast": [
    "paren",
    "tyoshcha"
  ],
  "roles": {
    "paren": "doctor",
    "tyoshcha": "patient"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Мария Петровна пошла к врачу.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Её записали на приём к совсем молоденькому доктору, только что из института.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "После нескольких минут пребывания в его кабинете Мария Петровна выскочила оттуда с дикими криками и воплями и понеслась вдоль по коридору.",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "narrator",
      "text": "Навстречу ей шёл пожилой врач. Он остановил её.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "doktor",
      "text": "В чём дело?",
      "emotion": "surprised",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "doktor",
      "text": "Ты что это себе позволяешь?",
      "emotion": "angry",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "doktor",
      "text": "Марии Петровне пошёл пятьдесят шестой год, у неё взрослая дочь, скоро внук будет, а ты ей говоришь, что она беременна!",
      "emotion": "angry",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "narrator",
      "text": "Молодой врач, продолжая писать что-то в карточке, ответил.",
      "emotion": "neutral",
      "pauseAfterSec": 0.6,
      "enter": [],
      "exit": []
    },
    {
      "id": "l9",
      "character": "paren",
      "text": "Но икоточка-то у неё прошла?",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
