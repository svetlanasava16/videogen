  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "A man wakes up with a terrible hangover and a black eye.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "muzhik",
      "text": "A rose? Breakfast? And a note: I love you, darling?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [
        "muzhik"
      ],
      "exit": []
    },
    {
      "id": "l3",
      "character": "muzhik",
      "text": "Kevin, what happened last night?",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "paren",
      "text": "You came home drunk and tripped over a chair. That's the eye.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "muzhik",
      "text": "Then why is your mom being so sweet?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "paren",
      "text": "Mom dragged you to the bedroom and tried to take your clothes off.",
      "emotion": "smug",
      "pauseAfterSec": 0.7,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "paren",
      "text": "And you yelled: leave me alone, I'm married!",
      "emotion": "happy",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    }
  ],
