{
  "id": "en-r-74wivp.en",
  "jokeId": "en-r-74wivp",
  "locale": "en",
  "title": "I'm Married!",
  "location": "spalnya",
  "place": "home-kitchen",
  "cast": [
    "muzhik"
  ],
  "roles": {
    "muzhik": "husband"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Joe wakes up with a horrible hangover and a throbbing black eye.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "The first thing he sees is a single rose on the side table and a note from his wife.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "muzhik",
      "text": "Dear, breakfast is made. I've gone shopping to make you your favorite dinner tonight. I love you!",
      "emotion": "surprised",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "narrator",
      "text": "He stumbles to the kitchen and, sure enough, there's breakfast.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "muzhik",
      "text": "Kevin, what happened last night?",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "paren",
      "text": "You came home soused and got that black eye tripping over a chair.",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "muzhik",
      "text": "So, why the rose, breakfast, and sweet note from your mother?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "paren",
      "text": "Oh, that.",
      "emotion": "smug",
      "pauseAfterSec": 0.6,
      "enter": [],
      "exit": []
    },
    {
      "id": "l9",
      "character": "paren",
      "text": "Mom dragged you to the bedroom, and when she tried to take off your clothes, you screamed: Leave me alone, I'm married!",
      "emotion": "happy",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
