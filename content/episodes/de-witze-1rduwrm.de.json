{
  "id": "de-witze-1rduwrm.de",
  "jokeId": "de-witze-1rduwrm",
  "locale": "de",
  "title": "Opas letzte Worte",
  "location": "bar",
  "place": "hospital",
  "cast": [
    "muzhik",
    "muzhik-sosed"
  ],
  "roles": {
    "muzhik": "everyman",
    "muzhik-sosed": "friend"
  },
  "lines": [
    {
      "id": "l1",
      "character": "muzhik",
      "text": "Mein Opa hatte einen Herzanfall.",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "muzhik",
      "text": "So wie ich, ist er auch stark übergewichtig.",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "muzhik",
      "text": "Ich habe ihn im Krankenhaus besucht.",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "Ich stand ganz nah an seinem Bett, als er versuchte, mir etwas zuzuflüstern.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "muzhik",
      "text": "Ich beugte mich über ihn, aber konnte leider nichts verstehen.",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "muzhik",
      "text": "Es schien ihm wichtig zu sein, da er mich sehr intensiv anstarrte.",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "muzhik",
      "text": "Ich reichte ihm einen Zettel, in der Hoffnung, dass er es aufschreiben kann.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "muzhik",
      "text": "In dem Moment, als er mir den Zettel zurückgeben wollte, erlitt er einen erneuten Herzanfall und ist verstorben.",
      "emotion": "sad",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l9",
      "character": "muzhik-sosed",
      "text": "Mein Beileid. Was stand auf dem Zettel?",
      "emotion": "sad",
      "pauseAfterSec": 0.6,
      "enter": [],
      "exit": []
    },
    {
      "id": "l10",
      "character": "muzhik",
      "text": "Auf dem Zettel stand: Du Trottel stehst auf meinem Sauerstoffschlauch!",
      "emotion": "neutral",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
