  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Урок «Основы православной культуры».",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "uchilka",
      "text": "И помните, дети! Те, кто будет учиться на четыре и пять, попадут в рай.",
      "emotion": "smug",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "uchilka",
      "text": "А те, кто будет учиться на два и три, — в ад!",
      "emotion": "angry",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l4",
      "character": "vovochka",
      "text": "Мариванна, а что, закончить школу живым нельзя?",
      "emotion": "surprised",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
