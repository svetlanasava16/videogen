    {
      "id": "l1",
      "character": "narrator",
      "text": "A traffic cop pulls a car over. The window rolls down, and the driver smiles ingratiatingly:",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "muzhik",
      "text": "Good day to you, Officer, sir!",
      "emotion": "happy",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "muzhik",
      "text": "Here you go, my license, registration, power of attorney,",
      "emotion": "happy",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l3b",
      "character": "muzhik",
      "text": "insurance of course, everything just as it should be, all in order...",
      "emotion": "happy",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l4",
      "character": "vovochka",
      "text": "Daddy, where are the pigs?",
      "emotion": "surprised",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
