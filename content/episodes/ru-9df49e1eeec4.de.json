  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Der Geheimdienst stellt Leute ein.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Nach einem ersten Vorstellungsgespräch bekamen alle einen Umschlag mit dem Stempel „Streng geheim!“ und sollten ihn in ein bestimmtes Büro bringen.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "Ein Typ ging unterwegs aufs Klo und machte den Umschlag auf. Darin stand:",
      "emotion": "smug",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l4",
      "character": "paren",
      "text": "Sie passen zu uns! Kommen Sie zurück!",
      "emotion": "surprised",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
