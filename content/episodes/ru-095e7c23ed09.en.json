  "lines": [
    {
      "id": "l1",
      "character": "paren",
      "text": "Good morning, professor! May I ask you something?",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [
        "paren"
      ],
      "exit": []
    },
    {
      "id": "l2",
      "character": "doktor",
      "text": "Of course, young man.",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "paren",
      "text": "When you go to bed, do you put your beard over the blanket or under it?",
      "emotion": "neutral",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "doktor",
      "text": "Hmm. You know, I've never thought about it.",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "paren",
      "text": "Sorry to bother you.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": [
        "paren"
      ]
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "A week later. The professor is pale, with dark circles under his eyes.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [
        "paren"
      ],
      "exit": []
    },
    {
      "id": "l7",
      "character": "doktor",
      "text": "You little rat!",
      "emotion": "angry",
      "pauseAfterSec": 0.6,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "doktor",
      "text": "I haven't slept in a week! Over the blanket is wrong, under the blanket is wrong!",
      "emotion": "angry",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    }
  ],
