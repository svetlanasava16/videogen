{
  "id": "ru-095e7c23ed09.en",
  "jokeId": "ru-095e7c23ed09",
  "locale": "en",
  "title": "The Beard",
  "location": "klass",
  "place": "university",
  "cast": [
    "doktor",
    "paren"
  ],
  "roles": {
    "doktor": "professor",
    "paren": "student"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "A professor is walking down a university corridor. A student comes the other way.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "paren",
      "text": "Hello, professor. May I ask you something?",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "doktor",
      "text": "Of course, ask away, young man.",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "paren",
      "text": "Tell me, professor, when you go to bed, do you put your beard over the blanket or under the blanket?",
      "emotion": "neutral",
      "pauseAfterSec": 0.6,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "doktor",
      "text": "Well, you know, I've never really thought about it.",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "paren",
      "text": "Oh, I'm sorry, then.",
      "emotion": "happy",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "narrator",
      "text": "A week later, the professor, green in the face with dark circles under his eyes, runs into the same student in the corridor and grabs him by the collar.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "doktor",
      "text": "You little swine!",
      "emotion": "angry",
      "pauseAfterSec": 0.6,
      "enter": [],
      "exit": []
    },
    {
      "id": "l9",
      "character": "doktor",
      "text": "I haven't slept for a week! It's uncomfortable this way, and it's uncomfortable that way!",
      "emotion": "angry",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
