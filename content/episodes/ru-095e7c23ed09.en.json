{
  "id": "ru-095e7c23ed09.en",
  "jokeId": "ru-095e7c23ed09",
  "locale": "en",
  "title": "The Beard",
  "location": "klass",
  "place": "university",
  "cast": [
    "paren",
    "doktor"
  ],
  "roles": {
    "paren": "student",
    "doktor": "professor"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "A professor is walking down a university corridor.",
      "emotion": "neutral",
      "pauseAfterSec": 0,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "A student comes the other way:",
      "emotion": "neutral",
      "pauseAfterSec": 0,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "paren",
      "text": "Hello, professor. May I ask you something?",
      "emotion": "happy",
      "pauseAfterSec": 0,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "doktor",
      "text": "Of course, ask away, young man.",
      "emotion": "smug",
      "pauseAfterSec": 0,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "paren",
      "text": "Tell me, professor, when you go to bed, do you put your beard over the blanket or under the blanket?",
      "emotion": "neutral",
      "pauseAfterSec": 0,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "After a little pause:",
      "emotion": "neutral",
      "pauseAfterSec": 0,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "doktor",
      "text": "Well, you know, I've never really thought about it.",
      "emotion": "surprised",
      "pauseAfterSec": 0,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "paren",
      "text": "Well, sorry to bother you.",
      "emotion": "neutral",
      "pauseAfterSec": 0,
      "enter": [],
      "exit": []
    },
    {
      "id": "l9",
      "character": "narrator",
      "text": "They went their separate ways.",
      "emotion": "neutral",
      "pauseAfterSec": 0,
      "enter": [],
      "exit": []
    },
    {
      "id": "l10",
      "character": "narrator",
      "text": "A week later the professor, green in the face, with circles under his eyes,",
      "emotion": "neutral",
      "pauseAfterSec": 0,
      "enter": [],
      "exit": []
    },
    {
      "id": "l11",
      "character": "narrator",
      "text": "runs into the same student in the corridor and grabs him by the collar:",
      "emotion": "neutral",
      "pauseAfterSec": 0,
      "enter": [],
      "exit": []
    },
    {
      "id": "l12",
      "character": "doktor",
      "text": "Why, you swine!",
      "emotion": "angry",
      "pauseAfterSec": 0,
      "enter": [],
      "exit": []
    },
    {
      "id": "l13",
      "character": "doktor",
      "text": "I haven't slept for a week — it's uncomfortable this way, and it's uncomfortable that way!",
      "emotion": "angry",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
