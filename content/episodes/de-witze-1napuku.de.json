    {
      "id": "l1",
      "character": "narrator",
      "text": "Moses, am Berg angekommen, lässt das Volk am Fuße warten und beginnt den Aufstieg zum Herrn, um die Gebote zu empfangen.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Nach einer Woche kehrt er zurück und stellt sich vor die Menschen.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "ded",
      "text": "Ich hab eine gute und eine schlechte Nachricht.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "ded",
      "text": "Die Gute zuerst: Ich hab ihn runter auf zehn!",
      "emotion": "happy",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "ded",
      "text": "Die Schlechte: Ehebruch ist immer noch dabei!",
      "emotion": "sad",
      "pauseAfterSec": 0.8,
