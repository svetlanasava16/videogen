{
  "id": "de-witze-1ptmsrw.en",
  "jokeId": "de-witze-1ptmsrw",
  "locale": "en",
  "title": "The Ride Home",
  "kind": "joke",
  "v": 2,
  "location": "doroga",
  "place": "street",
  "cast": [
    "vovochka",
    "muzhik"
  ],
  "roles": {
    "vovochka": "child",
    "muzhik": "father"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "A boy is walking home from school.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "A car comes up from behind, and the driver rolls down the window.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "muzhik",
      "text": "Hey, get in.",
      "emotion": "happy",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "vovochka",
      "text": "No way. I'd rather walk.",
      "emotion": "angry",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "muzhik",
      "text": "Oh, come on, I've even got a lollipop for you here.",
      "emotion": "happy",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l6",
      "character": "vovochka",
      "text": "I don't care, I'm not getting in your car!",
      "emotion": "angry",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l7",
      "character": "muzhik",
      "text": "Listen, I'll pull over now, you get in, then we'll go get ice cream together,",
      "emotion": "happy",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l7b",
      "character": "muzhik",
      "text": "and after that I'll buy you any video game you want.",
      "emotion": "happy",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l8",
      "character": "muzhik",
      "text": "Wouldn't that be nice?",
      "emotion": "smug",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l9",
      "character": "vovochka",
      "text": "Forget it! I am never, ever getting in your car.",
      "emotion": "angry",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l10",
      "character": "vovochka",
      "text": "You bought the Prius, so you deal with it yourself, Dad.",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
