  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "A general is strolling across a bridge. A soldier who is absent without leave tries to slip past him.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [
        "sluzhivy-ryadovoy"
      ],
      "exit": []
    },
    {
      "id": "l2",
      "character": "sluzhivy",
      "text": "Soldier! What is this? Why didn't you salute?",
      "emotion": "angry",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "sluzhivy-ryadovoy",
      "text": "Article one hundred forty-seven of the regulations, sir! No saluting on bridges!",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": [
        "sluzhivy-ryadovoy"
      ]
    },
    {
      "id": "l4",
      "character": "narrator",
      "text": "The confused general salutes back. At home, he opens the regulations.",
      "emotion": "neutral",
      "pauseAfterSec": 0.7,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "sluzhivy",
      "text": "Article one hundred forty-seven. A soldier must be resourceful and bold.",
      "emotion": "surprised",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    }
  ],
