{
  "id": "ru-5ac09cf92c37.en",
  "jokeId": "ru-5ac09cf92c37",
  "locale": "en",
  "title": "Article One Forty-Seven",
  "location": "derevnya",
  "place": "river-lake",
  "cast": [
    "sluzhivy",
    "sluzhivy-ryadovoy"
  ],
  "roles": {
    "sluzhivy": "officer",
    "sluzhivy-ryadovoy": "soldier"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "A general is strolling across a bridge, looking around lazily, and wouldn't you know it, he spots a soldier.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "The soldier, as usual, is AWOL and wants to slip past, pretending not to notice the general.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "sluzhivy",
      "text": "Soldier, damn you, what is this?!",
      "emotion": "angry",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "sluzhivy",
      "text": "Why didn't you salute?!",
      "emotion": "angry",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "sluzhivy-ryadovoy",
      "text": "According to article one hundred forty-seven of the regulations, there is no saluting on a bridge!",
      "emotion": "smug",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "The general is taken aback, salutes, and heads straight home.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "narrator",
      "text": "He gets there, leafs through the regulations, finds the article, reads it and can't believe his eyes:",
      "emotion": "neutral",
      "pauseAfterSec": 0.6,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "sluzhivy",
      "text": "Article one hundred forty-seven. A soldier must be resourceful and bold.",
      "emotion": "surprised",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
  "explicit": false,
