  ],
  "roles": {
    "muzhik": "everyman",
    "sluzhivy": "police-officer",
    "vor": "thief"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Поздно вечером мужик видит в своём сарае свет фонарика.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "muzhik",
      "text": "Алло, полиция? У меня в сарае воры!",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "Ему отвечают: все патрули заняты, ждите час-другой.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "Алло, это снова я. Раз патрулей нет, я их сам перестрелял.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "muzhik",
      "text": "Так что пришлите заодно пару машин скорой. Трупы забрать.",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "Через минуту двор полон полиции. Воры выбегают из сарая и сдаются.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [
        "vor"
      ],
      "exit": []
    },
    {
      "id": "l7",
      "character": "sluzhivy",
      "text": "Вы же сказали, тут как минимум три трупа!",
      "emotion": "angry",
      "pauseAfterSec": 0.7,
      "enter": [
        "sluzhivy"
      ],
      "exit": []
    },
    {
      "id": "l8",
      "character": "muzhik",
      "text": "А вы сказали, что свободных патрулей нет.",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    }
  ],
  "format": {
    "width": 1080,
