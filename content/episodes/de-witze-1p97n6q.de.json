  "locale": "de",
  "title": "Der Ballonfahrer",
  "kind": "joke",
  "v": 2,
  "location": "nebesa",
  "place": "farm",
  "cast": [
    "nachalnik",
    "paren"
  ],
  "roles": {
    "nachalnik": "businessman",
    "paren": "engineer"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein Mann schwebt in einem Heißluftballon über die Landschaft, leider hat er sich verirrt. Er sieht einen Mann am Boden.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "nachalnik",
      "text": "Wo bin ich?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "paren",
      "text": "Sie sind in einem Heißluftballon.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l4",
      "character": "nachalnik",
      "text": "Sie müssen ein Ingenieur sein.",
      "emotion": "angry",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l4b",
      "character": "nachalnik",
      "text": "Ihre Antwort war absolut korrekt, aber überhaupt nicht hilfreich.",
      "emotion": "angry",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l5",
      "character": "paren",
      "text": "Und Sie sind mit Sicherheit ein Manager.",
      "emotion": "smug",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l6",
      "character": "paren",
      "text": "Sie wissen nicht, wo Sie sind, Sie sind absolut hilflos,",
      "emotion": "smug",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l6b",
      "character": "paren",
      "text": "und trotzdem ist auf einmal alles meine Schuld.",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
