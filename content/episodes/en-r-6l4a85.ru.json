  "locale": "ru",
  "title": "Я всё знаю",
  "location": "gostinaya",
  "place": "home-living-room",
  "cast": [
    "paren",
    "vovochka",
    "zhena",
    "muzhik"
  ],
  "roles": {
    "paren": "postman",
    "vovochka": "vovochka",
    "zhena": "mother",
    "muzhik": "father"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Друзья рассказали Вовочке, что у взрослых есть страшная тайна и ими легко манипулировать.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Вовочка решает это проверить.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "vovochka",
      "text": "Мама, я всё знаю.",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "narrator",
      "text": "Мама шикает на него и даёт ему сто рублей.",
      "emotion": "neutral",
      "pauseAfterSec": 0.2,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "zhena",
      "text": "Только папе не говори.",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "vovochka",
      "text": "Ого, работает!",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": [],
      "laugh": "chuckle"
    },
    {
      "id": "l7",
      "character": "narrator",
      "text": "Через час с работы приходит папа.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "vovochka",
      "text": "Папа, я всё знаю.",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l9",
      "character": "narrator",
      "text": "Папа даёт Вовочке тысячу рублей.",
      "emotion": "neutral",
      "pauseAfterSec": 0.2,
      "enter": [],
      "exit": []
    },
    {
      "id": "l10",
      "character": "muzhik",
      "text": "Маме не говори.",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l11",
      "character": "narrator",
      "text": "Тут в дверь стучит почтальон.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l12",
      "character": "vovochka",
      "text": "Я всё знаю, дяденька.",
      "emotion": "smug",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l13",
      "character": "narrator",
      "text": "Почтальон роняет всю почту, на глазах у него слёзы, и он говорит:",
      "emotion": "neutral",
      "pauseAfterSec": 0.6,
      "enter": [],
      "exit": []
    },
    {
      "id": "l14",
      "character": "paren",
      "text": "Ну раз так, Вовочка, иди обними папочку.",
      "emotion": "happy",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
