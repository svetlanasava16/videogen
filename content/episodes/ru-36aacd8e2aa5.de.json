  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein paar reiche Typen in der Sauna. Ein Handy klingelt.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "nachalnik",
      "text": "Hallo? Ja, Schatz. Ja, in der Sauna. Ja, mit den Jungs. Ja. Bis elf.",
      "emotion": "neutral",
      "pauseAfterSec": 0.2,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "nachalnik",
      "text": "Was kaufen? Ein Kleid? Tausend Euro?",
      "emotion": "surprised",
      "pauseAfterSec": 0.2,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "nachalnik",
      "text": "Wozu brauchst du ein fünfzigstes Kleid? Ins Theater gehen? Na gut.",
      "emotion": "neutral",
      "pauseAfterSec": 0.2,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "nachalnik",
      "text": "Du weißt, wo das Geld ist? Kauf es.",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "Wieder ein Anruf.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "nachalnik",
      "text": "Hallo? Ja, Schatz. Ja, in der Sauna. Ja, mit den Jungs. Ja. Bis elf.",
      "emotion": "neutral",
      "pauseAfterSec": 0.2,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "nachalnik",
      "text": "Was kaufen? Einen Pelzmantel? Wozu brauchst du einen zehnten Pelzmantel?",
      "emotion": "surprised",
      "pauseAfterSec": 0.2,
      "enter": [],
      "exit": []
    },
    {
      "id": "l9",
      "character": "nachalnik",
      "text": "Auf die Kanaren fliegen? Fünfzigtausend? Na gut. Du weißt, wo das Geld ist.",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l10",
      "character": "narrator",
      "text": "Wieder ein Anruf.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l11",
      "character": "nachalnik",
      "text": "Hallo? Ja, Schatz. Ja, in der Sauna. Ja, mit den Jungs. Ja. Bis elf.",
      "emotion": "neutral",
      "pauseAfterSec": 0.2,
      "enter": [],
      "exit": []
    },
    {
      "id": "l12",
      "character": "nachalnik",
      "text": "Was kaufen? Ein Auto? Wozu brauchst du ein sechstes Auto?",
      "emotion": "surprised",
      "pauseAfterSec": 0.2,
      "enter": [],
      "exit": []
    },
    {
      "id": "l13",
      "character": "nachalnik",
      "text": "Vor deiner Mutter angeben? Wie viel? Dreihunderttausend Euro?",
      "emotion": "surprised",
      "pauseAfterSec": 0.2,
      "enter": [],
      "exit": []
    },
    {
      "id": "l14",
      "character": "nachalnik",
      "text": "Na gut. Kauf es. Du weißt, wo das Geld ist.",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l15",
      "character": "narrator",
      "text": "Er legt auf.",
      "emotion": "neutral",
      "pauseAfterSec": 0.7,
      "enter": [],
      "exit": []
    },
    {
      "id": "l16",
      "character": "nachalnik",
      "text": "Hm... Ähem... Jungs, wessen Handy ist das?",
      "emotion": "surprised",
