  "locale": "de",
  "title": "Wessen Handy?",
  "location": "banya",
  "place": "bathhouse",
  "cast": [
    "muzhik",
    "nachalnik",
    "muzhik-sosed"
  ],
  "roles": {
    "muzhik": "new-russian",
    "nachalnik": "new-russian",
    "muzhik-sosed": "new-russian"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein paar reiche Typen sitzen in der Sauna.",
      "emotion": "neutral",
      "pauseAfterSec": 0,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Ein Handy klingelt.",
      "emotion": "neutral",
      "pauseAfterSec": 0,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "Einer von ihnen geht ran:",
      "emotion": "neutral",
      "pauseAfterSec": 0,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "nachalnik",
      "text": "Hallo... ja, Schatz... ja, in der Sauna... ja, mit den Jungs... ja. Bis elf.",
      "emotion": "neutral",
      "pauseAfterSec": 0,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "nachalnik",
      "text": "Was kaufen? Ein Kleid?? Tausend Euro? Wozu brauchst du ein fünfzigstes Kleid?",
      "emotion": "surprised",
      "pauseAfterSec": 0,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "nachalnik",
      "text": "Ins Theater gehen? Na gut. Du weißt, wo das Geld ist? Kauf es.",
      "emotion": "smug",
      "pauseAfterSec": 0,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "narrator",
      "text": "Wieder ein Anruf, derselbe reiche Typ geht ran:",
      "emotion": "neutral",
      "pauseAfterSec": 0,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "nachalnik",
      "text": "Hallo... ja, Schatz... ja, in der Sauna... ja, mit den Jungs... ja. Bis elf.",
      "emotion": "neutral",
      "pauseAfterSec": 0,
      "enter": [],
      "exit": []
    },
    {
      "id": "l9",
      "character": "nachalnik",
      "text": "Was kaufen? Einen Pelzmantel?? Wozu brauchst du einen zehnten Pelzmantel??",
      "emotion": "surprised",
      "pauseAfterSec": 0,
      "enter": [],
      "exit": []
    },
    {
      "id": "l10",
      "character": "nachalnik",
      "text": "Auf die Kanaren fliegen? Fünfzigtausend?? Na gut... du weißt, wo das Geld ist...",
      "emotion": "smug",
      "pauseAfterSec": 0,
      "enter": [],
      "exit": []
    },
    {
      "id": "l11",
      "character": "narrator",
      "text": "Wieder ein Anruf, wieder derselbe reiche Typ:",
      "emotion": "neutral",
      "pauseAfterSec": 0,
      "enter": [],
      "exit": []
    },
    {
      "id": "l12",
      "character": "nachalnik",
      "text": "Hallo... ja, Schatz... ja, in der Sauna... ja, mit den Jungs... ja. Bis elf.",
      "emotion": "neutral",
      "pauseAfterSec": 0,
      "enter": [],
      "exit": []
    },
    {
      "id": "l13",
      "character": "nachalnik",
      "text": "Was kaufen? Ein Auto??? Wozu brauchst du ein sechstes Auto???",
      "emotion": "angry",
      "pauseAfterSec": 0,
      "enter": [],
      "exit": []
    },
    {
      "id": "l14",
      "character": "nachalnik",
      "text": "Vor deiner Mama angeben? Wie viel??? Dreihunderttausend Euro??? Na gut... kauf's... du weißt, wo das Geld ist...",
      "emotion": "smug",
      "pauseAfterSec": 0,
      "enter": [],
      "exit": []
    },
    {
      "id": "l15",
      "character": "narrator",
      "text": "Er legt auf...",
      "emotion": "neutral",
      "pauseAfterSec": 0,
      "enter": [],
      "exit": []
    },
    {
      "id": "l16",
      "character": "nachalnik",
      "text": "Hm... ähem... Jungs, wessen Handy ist das?",
      "emotion": "surprised",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
