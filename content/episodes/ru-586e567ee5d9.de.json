    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein Mann hat sein Handy zu Hause vergessen. Abends kommt er zurück und liest die Nachrichten. Die erste:",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "devushka",
      "text": "Liebling, Schatz, mein Süßer, ruf mich bitte an. Küsschen, für immer deine Jenny.",
      "emotion": "happy",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "Die zweite:",
      "emotion": "neutral",
      "pauseAfterSec": 0.7,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "zhena",
      "text": "Ich habe sie schon angerufen, du brauchst dich nicht zu bemühen. Deine Frau.",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
