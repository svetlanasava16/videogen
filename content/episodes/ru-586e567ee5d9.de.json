  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein Mann hat seinen Pager zu Hause vergessen.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Am Abend kommt er zurück und liest die Nachrichten.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "Die erste:",
      "emotion": "neutral",
      "pauseAfterSec": 0.2
    },
    {
      "id": "l4",
      "character": "devushka",
      "text": "Schatz, Liebster, mein Geliebter, ruf mich bitte an.",
      "emotion": "happy",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "devushka",
      "text": "Küsschen, für immer deine Marina.",
      "emotion": "happy",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "Die zweite:",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l7",
      "character": "zhena",
      "text": "Ich habe schon angerufen, du musst dir keine Sorgen machen.",
      "emotion": "smug",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l8",
      "character": "zhena",
      "text": "Deine Frau.",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
