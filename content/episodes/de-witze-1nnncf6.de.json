  "locale": "de",
  "title": "Das Beste an einer Tasse",
  "kind": "joke",
  "v": 2,
  "location": "bolnitsa",
  "place": "doctor-office",
  "cast": [
    "zhena",
    "doktor"
  ],
  "roles": {
    "zhena": "wife",
    "doktor": "therapist"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Eine Frau geht zum Psychiater, um sich über ihren Mann zu beschweren.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "zhena",
      "text": "Mein Mann ist total bekloppt.",
      "emotion": "angry",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "zhena",
      "text": "Zum Frühstück trinkt er den Kaffee aus und isst dann die Kaffeetasse mit.",
      "emotion": "surprised",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "zhena",
      "text": "Nur den Henkel lässt er übrig.",
      "emotion": "sad",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l5",
      "character": "doktor",
      "text": "Ja, das ist schon verrückt.",
      "emotion": "neutral",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l6",
      "character": "doktor",
      "text": "Der Henkel ist doch das Beste an der Tasse.",
      "emotion": "surprised",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
