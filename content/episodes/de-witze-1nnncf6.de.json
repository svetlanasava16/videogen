      "pauseAfterSec": 0.3,
      "enter": [
        "zhena"
      ],
      "exit": []
    },
    {
      "id": "l3",
      "character": "zhena",
      "text": "Zum Frühstück trinkt er den Kaffee aus und isst dann die Kaffeetasse mit.",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "zhena",
      "text": "Nur den Henkel lässt er übrig.",
      "emotion": "sad",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "doktor",
      "text": "Ja, das ist schon verrückt.",
      "emotion": "neutral",
      "pauseAfterSec": 0.6,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "doktor",
      "text": "Der Henkel ist doch das Beste an der Tasse.",
      "emotion": "surprised",
