  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "An einer Ampel halten zwei Autos: ein Dacia Logan und ein Lamborghini.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Der Fahrer des Logan kurbelt das Fenster herunter und fragt den Fahrer des Lamborghini:",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "muzhik",
      "text": "Und, wie ist die Karre so? Geht sie oft kaputt?",
      "emotion": "happy",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "nachalnik",
      "text": "Eigentlich ein ganz normales Auto. Warum fragst du?",
      "emotion": "surprised",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l5",
      "character": "muzhik",
      "text": "Na, ich sehe, die Leute kaufen die irgendwie nicht so oft.",
      "emotion": "neutral",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
