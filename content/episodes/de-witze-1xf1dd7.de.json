  "lines": [
    {
      "id": "l1",
      "character": "devushka",
      "text": "Sehen Sie? Jedes Mal, wenn die Straßenbahn vorbeirumpelt, fällt mein neuer IKEA-Schrank zusammen!",
      "emotion": "angry",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "muzhik-sosed",
      "text": "Komisch. Ich stell mich mal rein, vielleicht sehe ich von innen, was das Problem ist.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": [
        "muzhik-sosed"
      ]
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "In dem Moment kommt ihr Mann nach Hause und macht den neuen Schrank auf.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [
        "muzhik"
      ],
      "exit": []
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "Und was machst du in unserem Schrank?",
      "emotion": "angry",
      "pauseAfterSec": 0.3,
      "enter": [
        "muzhik-sosed"
      ],
      "exit": []
    },
    {
      "id": "l5",
      "character": "muzhik-sosed",
      "text": "Weißt du was? Hau mir gleich eine runter.",
      "emotion": "sad",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "muzhik-sosed",
      "text": "Wenn ich dir sage, dass ich auf die Straßenbahn warte, machst du es ja sowieso.",
      "emotion": "sad",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    }
  ],
