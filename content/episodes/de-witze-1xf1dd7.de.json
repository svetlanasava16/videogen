{
  "id": "de-witze-1xf1dd7.de",
  "jokeId": "de-witze-1xf1dd7",
  "locale": "de",
  "title": "Der IKEA-Schrank",
  "location": "spalnya",
  "place": "bedroom",
  "cast": [
    "zhena",
    "muzhik-sosed",
    "muzhik"
  ],
  "roles": {
    "zhena": "wife",
    "muzhik-sosed": "neighbor",
    "muzhik": "husband"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Eine Frau kauft einen Schrank von IKEA und baut ihn zusammen. Nur sobald die Straßenbahn vorbeirumpelt, fällt der Kasten zusammen.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Sie baut ihn wieder auf, die Straßenbahn kommt, der Schrank fällt zusammen.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "zhena",
      "text": "Bitte helfen Sie mir mit dem Schrank!",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "narrator",
      "text": "Allerdings, gleiches Spiel: Schrank fertig, Straßenbahn rumpelt vorbei, Kasten bricht zusammen.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "muzhik-sosed",
      "text": "Ich stell mich mal rein, vielleicht kann ich drinnen sehen, was das Problem ist.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "Gesagt, getan, er stellt sich in den Schrank, und in dem Moment kommt ihr Mann heim.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "narrator",
      "text": "Er sieht den neuen Schrank, will ihn sich anschauen und macht ihn auf. Drinnen steht der Nachbar.",
      "emotion": "surprised",
      "pauseAfterSec": 0.6,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "muzhik-sosed",
      "text": "Weißt was, hau mir gleich eine runter. Wenn ich dir jetzt sag, dass ich auf die Straßenbahn warte, machst es ohnehin.",
      "emotion": "sad",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
  "explicit": false,
