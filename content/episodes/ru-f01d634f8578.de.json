  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Die überfütterte Tochter reicher Eltern prahlt vor ihrer Mitschülerin.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "devochka",
      "text": "Gestern waren Papa und ich im Restaurant,",
      "emotion": "smug",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l2b",
      "character": "devochka",
      "text": "und was haben wir da nicht alles gegessen: Hummer, Steak, Barbecue!",
      "emotion": "smug",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "devochka",
      "text": "Ich habe so viel gegessen, dass ich fast geplatzt wäre!",
      "emotion": "happy",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l4",
      "character": "narrator",
      "text": "Die dünne Mitschülerin sieht sie traurig an und sagt dann:",
      "emotion": "neutral",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l5",
      "character": "devochka-podruga",
      "text": "Und warum nur fast? Hat Papas Geld nicht gereicht?",
      "emotion": "sad",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
  "explicit": false,
