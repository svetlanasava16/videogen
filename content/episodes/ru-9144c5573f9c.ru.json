{
  "id": "ru-9144c5573f9c.ru",
  "jokeId": "ru-9144c5573f9c",
  "locale": "ru",
  "title": "Кто-то под кроватью",
  "location": "bolnitsa",
  "place": "doctor-office",
  "cast": [
    "muzhik",
    "doktor"
  ],
  "roles": {
    "muzhik": "patient",
    "doktor": "doctor"
  },
  "lines": [
    {
      "id": "l1",
      "character": "muzhik",
      "text": "Доктор, я замучился. Ложусь спать, и кажется, что под кроватью кто-то есть.",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [
        "muzhik"
      ],
      "exit": []
    },
    {
      "id": "l2",
      "character": "muzhik",
      "text": "Лезу под кровать, а мне кажется, что кто-то лежит на кровати. И так всю ночь.",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "doktor",
      "text": "Сложный синдром. Будем лечить месяца два-три. Дорого, но вылечим.",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "Ладно, я подумаю.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": [
        "muzhik"
      ]
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "Через месяц доктор встречает его на улице.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "doktor",
      "text": "О, здравствуйте! Что же вы больше не пришли?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [
        "muzhik"
      ],
      "exit": []
    },
    {
      "id": "l7",
      "character": "muzhik",
      "text": "А меня сосед вылечил. За бутылку.",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "doktor",
      "text": "Это как?",
      "emotion": "surprised",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    },
    {
      "id": "l9",
      "character": "muzhik",
      "text": "Выпили мы, а он говорит: да отпили ты на фиг ножки у кровати!",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    }
  ],
  "format": {
    "width": 1080,
    "height": 1920,
    "fps": 30
  }
}
