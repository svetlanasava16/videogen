  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "В конторе допущена грубая ошибка, имевшая ужасные последствия.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Разъярённый начальник вбегает в комнату и хватает подчинённого за грудки.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "nachalnik",
      "text": "Кто-то из нас двоих идиот: или вы, или я!",
      "emotion": "angry",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l4",
      "character": "paren",
      "text": "Шеф, разве вы с вашим опытом и предусмотрительностью могли принять на службу идиота?",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
