  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein Mann geht am Seeufer entlang und sieht, wie irgendein Kerl mit der Hand Wasser aus dem See schöpft und trinkt. Der Mann ruft:",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "muzhik",
      "text": "Warum trinkst du dieses dreckige Wasser?",
      "emotion": "angry",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "muzhik",
      "text": "Hier wirft jeder seinen Müll rein, die Fabriken leiten ihre Abwässer ein, und aus dem ganzen Dorf läuft Mist hier rein!",
      "uncensored": "Hier wirft jeder seinen Müll rein, die Fabriken leiten ihre Abwässer ein, und aus dem ganzen Dorf läuft Scheiße hier rein!",
      "emotion": "angry",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "inostranets",
      "text": "What did you say?",
      "emotion": "surprised",
      "pauseAfterSec": 0.7,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "muzhik",
      "text": "Ich sag ja: Schöpf mit beiden Händen!",
      "emotion": "happy",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
