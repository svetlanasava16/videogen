    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein Mann geht am See entlang. Ein Fremder schöpft mit der Hand Wasser und trinkt.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [
        "muzhik"
      ],
      "exit": []
    },
    {
      "id": "l2",
      "character": "muzhik",
      "text": "He, trinkst du etwa dieses Wasser?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "muzhik",
      "text": "Hier wirft jeder seinen Müll rein! Die Fabrik leitet ihre Abwässer ein! Das ganze Dorf spült sein Klo hier rein!",
      "emotion": "angry",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "muzhik-sosed",
      "text": "What did you say?",
      "emotion": "surprised",
      "pauseAfterSec": 0.7,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "muzhik",
      "text": "Ich sagte, nimm beide Hände!",
      "emotion": "happy",
      "pauseAfterSec": 0.8,
