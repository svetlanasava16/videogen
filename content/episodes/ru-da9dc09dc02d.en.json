  ],
  "roles": {
    "sluzhivy": "traffic-cop",
    "nachalnik": "new-russian"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "So a big Mercedes is driving along, with an ambulance and a fire engine right behind it.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "As usual, a traffic cop pulls it over at the checkpoint, and right away the ambulance and the fire engine stop too.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "sluzhivy",
      "text": "Why did you lot stop? Drive on, I only pulled over the Mercedes.",
      "emotion": "surprised",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "nachalnik",
      "text": "They're with me.",
      "emotion": "smug",
      "pauseAfterSec": 0.4,
      "laugh": "chuckle"
    },
    {
      "id": "l5",
      "character": "sluzhivy",
      "text": "What do you need them for?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l6",
      "character": "nachalnik",
      "text": "Because of you parasites!",
      "emotion": "angry",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l7",
      "character": "nachalnik",
      "text": "One time it's show us your first-aid kit, the next time it's your fire extinguisher...",
      "emotion": "angry",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
