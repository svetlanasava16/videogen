    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein Polizist steht an der Straße. Da kommt ein VW Golf angefahren.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [
        "muzhik"
      ],
      "exit": []
    },
    {
      "id": "l2",
      "character": "sluzhivy",
      "text": "Halt! Sofort anhalten, oder ich schieße!",
      "emotion": "angry",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "Der Fahrer macht eine Vollbremsung und steigt kreidebleich aus.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "Was ist denn los?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "sluzhivy",
      "text": "Ach, nichts. Ich will mir auch einen Golf kaufen.",
      "emotion": "neutral",
      "pauseAfterSec": 0.7,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "sluzhivy",
      "text": "Aber man hört ja, die Bremsen sollen schwach sein.",
      "emotion": "smug",
