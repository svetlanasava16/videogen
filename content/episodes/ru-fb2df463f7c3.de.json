  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein Polizist steht an der Straße, ein VW Golf fährt vorbei.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Plötzlich winkt der Polizist dem Fahrer heftig mit der Kelle, pfeift ohrenbetäubend und zieht die Pistole.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "Der Fahrer steigt sofort in die Eisen, fliegt fast durch die Windschutzscheibe und steigt kreidebleich mit weichen Knien aus:",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "Was ist denn los?",
      "emotion": "surprised",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "sluzhivy",
      "text": "Ach, nichts.",
      "emotion": "neutral",
      "pauseAfterSec": 0.6,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "sluzhivy",
      "text": "Ich will mir auch einen Golf kaufen, aber man sagt irgendwie, die Bremsen sind schwach...",
      "emotion": "neutral",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
