  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Fährt ein Landei zum ersten Mal, als er in der Stadt ist, mit einem Mercedes-Taxi.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "muzhik-sosed",
      "text": "Für was ist der Stern da auf der Motorhaube?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "muzhik-ryzhy",
      "text": "Na warte, dich nehm ich hops.",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "muzhik-ryzhy",
      "text": "Das ist eine Zielvorrichtung, um Rentner zu treffen.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "muzhik-ryzhy",
      "text": "Für jeden, den ich erwische, bekomm ich fünfhundert Euro Prämie.",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "Sagt's und hält voll auf einen Rentner zu, weicht aber im allerletzten Moment aus.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "narrator",
      "text": "Trotzdem tut es einen dumpfen Schlag, und der Rentner liegt am Boden.",
      "emotion": "surprised",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "muzhik-sosed",
      "text": "Wenn ich jetzt nicht im letzten Moment die Tür aufgerissen hätte, wär uns die Prämie sauber flöten gegangen.",
      "emotion": "happy",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
  "explicit": false,
