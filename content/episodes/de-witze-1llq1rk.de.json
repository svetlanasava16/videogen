  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein Bauer ist zum ersten Mal in der Stadt und fährt Taxi. Mercedes.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "muzhik-sosed",
      "text": "Sagen Sie mal, wofür ist eigentlich der Stern da vorne auf der Motorhaube?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "muzhik-ryzhy",
      "text": "Das ist eine Zielvorrichtung. Für Rentner.",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "muzhik-ryzhy",
      "text": "Für jeden, den ich erwische, krieg ich fünfhundert Euro Prämie.",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "muzhik-sosed",
      "text": "Echt jetzt?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "muzhik-ryzhy",
      "text": "Passen Sie auf.",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [
        "ded"
      ],
      "exit": []
    },
    {
      "id": "l7",
      "character": "narrator",
      "text": "Er hält voll auf den Rentner zu und weicht im allerletzten Moment aus. Trotzdem gibt es einen dumpfen Schlag.",
      "emotion": "neutral",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "muzhik-sosed",
      "text": "Mann, wenn ich nicht im letzten Moment die Tür aufgerissen hätte, wär uns die Prämie glatt flöten gegangen!",
      "emotion": "happy",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    }
  ],
