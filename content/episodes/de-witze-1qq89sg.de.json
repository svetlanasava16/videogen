  "locale": "de",
  "title": "Der Salzladen",
  "location": "magazin",
  "place": "shop",
  "cast": [
    "muzhik",
    "barmen"
  ],
  "roles": {
    "muzhik": "customer",
    "barmen": "salesman"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein Mann auf der Durchreise hält an einem kleinen Dorfladen.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "muzhik",
      "text": "Boah. Hier ist ja alles voller Salz! Die Regale, der Tresen, sogar der Boden!",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [
        "muzhik"
      ],
      "exit": []
    },
    {
      "id": "l3",
      "character": "muzhik",
      "text": "Sie müssen hier im Ort einen riesigen Bedarf an Salz haben.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "barmen",
      "text": "Eigentlich nicht. Eigentlich gar keinen.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "muzhik",
      "text": "Dann sind Sie ein echtes Verkaufsgenie, wenn Sie das alles loswerden.",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "barmen",
      "text": "Null. Verkaufen ist nicht so mein Talent.",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "muzhik",
      "text": "Aber warum um Gottes willen ist dann der ganze Laden voller Salz?",
      "emotion": "angry",
      "pauseAfterSec": 0.7,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "barmen",
      "text": "Naja, der Mann, bei dem ich das Salz kaufe, der ist ein richtig guter Verkäufer.",
      "emotion": "sad",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    }
  ],
