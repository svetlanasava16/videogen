  "locale": "de",
  "title": "Salz",
  "location": "magazin",
  "place": "shop",
  "cast": [
    "muzhik",
    "barmen"
  ],
  "roles": {
    "muzhik": "customer",
    "barmen": "salesman"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein Typ ist auf der Durchreise und hält an einem Lebensmittelgeschäft, um ein bisschen was zu essen zu kaufen.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Er betritt den Laden, und alles ist voller Salz. Der ganze Laden, alles Salz. Sämtliche Regale, von oben bis unten, selbst auf dem Boden. Nix anderes, nur Salz.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "muzhik",
      "text": "Boah! Sie müssen ja hier im Ort einen immensen Bedarf an Tafelsalz haben.",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [
        "muzhik"
      ],
      "exit": []
    },
    {
      "id": "l4",
      "character": "barmen",
      "text": "Eigentlich nicht so sehr. Eher wenig. Eigentlich gar nicht.",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "muzhik",
      "text": "Ah so. Dann sind Sie jedenfalls ein echtes Verkaufsgenie, wenn Sie das alles immer an den Mann bringen.",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "barmen",
      "text": "Null. Verkaufen ist nicht unbedingt mein Talent.",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "muzhik",
      "text": "Aber wieso haben Sie denn dann den ganzen Laden voll mit Salz, um Gottes willen?!",
      "emotion": "surprised",
      "pauseAfterSec": 0.6,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "barmen",
      "text": "Naja. Der Mann, von dem ich das Salz beziehe, der ist ein richtig guter Verkäufer.",
      "emotion": "sad",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
  "explicit": false,
  "outroLaughs": [],
