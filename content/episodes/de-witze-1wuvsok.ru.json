{
  "id": "de-witze-1wuvsok.ru",
  "jokeId": "de-witze-1wuvsok",
  "locale": "ru",
  "title": "Билет",
  "kind": "joke",
  "v": 2,
  "location": "samolet",
  "place": "train-station",
  "cast": [
    "paren",
    "muzhik"
  ],
  "roles": {
    "paren": "employee",
    "muzhik": "customer"
  },
  "lines": [
    {
      "id": "l1",
      "character": "muzhik",
      "text": "Скажите, а сколько стоит билет до Твери?",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "paren",
      "text": "Пятьсот рублей.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "muzhik",
      "text": "Не, это слишком дорого...",
      "emotion": "angry",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "narrator",
      "text": "Поезд трогается, мужик бежит рядом трусцой, всё быстрее и быстрее, под конец во весь опор, из последних сил.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "Показывается следующая станция, финишный рывок, и наконец поезд останавливается.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "Мужик, красный как рак, весь мокрый, с пульсом двести, хватает ртом воздух.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l7",
      "character": "muzhik",
      "text": "Ну... а теперь...?",
      "emotion": "sad",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l8",
      "character": "paren",
      "text": "Шестьсот рублей.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l9",
      "character": "muzhik",
      "text": "Что?!",
      "emotion": "surprised",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l10",
      "character": "paren",
      "text": "Тверь в другую сторону...",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
