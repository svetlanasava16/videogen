{
  "id": "en-r-74wivp.de",
  "jokeId": "en-r-74wivp",
  "locale": "de",
  "title": "Lass mich, ich bin verheiratet",
  "kind": "joke",
  "v": 2,
  "location": "spalnya",
  "place": "home-kitchen",
  "cast": [
    "muzhik",
    "zhena",
    "paren"
  ],
  "roles": {
    "muzhik": "husband",
    "paren": "son",
    "zhena": "wife"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Horst wacht mit einem furchtbaren Kater und einem pochenden blauen Auge auf.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Als Erstes sieht er eine einzelne Rose auf dem Nachttisch und einen Zettel von seiner Frau.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "zhena",
      "text": "Schatz, das Frühstück ist fertig. Ich bin einkaufen, damit ich dir heute Abend dein Lieblingsessen kochen kann. Ich liebe dich!",
      "offscreen": true,
      "emotion": "happy",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l4",
      "character": "narrator",
      "text": "Er schleppt sich in die Küche, und tatsächlich, da steht das Frühstück.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "muzhik",
      "text": "Kevin, was ist letzte Nacht passiert?",
      "emotion": "sad",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l6",
      "character": "paren",
      "text": "Du bist sturzbetrunken nach Hause gekommen und hast dir das blaue Auge geholt, als du über einen Stuhl gestolpert bist.",
      "emotion": "smug",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l7",
      "character": "muzhik",
      "text": "Und warum dann die Rose, das Frühstück und der liebe Zettel von deiner Mutter?",
      "emotion": "surprised",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l8",
      "character": "paren",
      "text": "Ach, das. Mama hat dich ins Schlafzimmer geschleppt, und als sie dich ausziehen wollte, hast du geschrien: Lass mich in Ruhe, ich bin verheiratet!",
      "emotion": "happy",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
