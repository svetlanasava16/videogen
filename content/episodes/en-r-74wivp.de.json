{
  "id": "en-r-74wivp.de",
  "jokeId": "en-r-74wivp",
  "locale": "de",
  "title": "Ich bin verheiratet!",
  "location": "spalnya",
  "place": "home-kitchen",
  "cast": [
    "muzhik"
  ],
  "roles": {
    "muzhik": "husband"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Horst wacht mit einem fürchterlichen Kater und einem pochenden blauen Auge auf.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Als Erstes sieht er eine einzelne Rose auf dem Nachttisch und einen Zettel von seiner Frau.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "muzhik",
      "text": "Schatz, das Frühstück ist fertig. Ich bin einkaufen, um dir heute Abend dein Lieblingsessen zu kochen. Ich liebe dich!",
      "emotion": "surprised",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "narrator",
      "text": "Er torkelt in die Küche, und tatsächlich, da steht das Frühstück.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "muzhik",
      "text": "Kevin, was war gestern Abend los?",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "paren",
      "text": "Du bist sturzbetrunken nach Hause gekommen und hast dir das blaue Auge geholt, als du über einen Stuhl gestolpert bist.",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "muzhik",
      "text": "Und warum dann die Rose, das Frühstück und der liebe Zettel von deiner Mutter?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "paren",
      "text": "Ach, das.",
      "emotion": "smug",
      "pauseAfterSec": 0.6,
      "enter": [],
      "exit": []
    },
    {
      "id": "l9",
      "character": "paren",
      "text": "Mama hat dich ins Schlafzimmer geschleppt, und als sie dich ausziehen wollte, hast du geschrien: Lass mich in Ruhe, ich bin verheiratet!",
      "emotion": "happy",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
