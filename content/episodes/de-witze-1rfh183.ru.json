  "lines": [
    {
      "id": "l1",
      "character": "paren",
      "text": "Мам, я всё время слышу,",
      "emotion": "neutral",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l1b",
      "character": "paren",
      "text": "как люди говорят про какого-то деревенского дурачка у нас в посёлке.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "paren",
      "text": "Его, похоже, все знают, а я его, видимо, ни разу не встречал.",
      "emotion": "surprised",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "paren",
      "text": "Как такое может быть?",
      "emotion": "surprised",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l4",
      "character": "zhena",
      "text": "Ну, Геннадий-Кевин...",
      "emotion": "sad",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
