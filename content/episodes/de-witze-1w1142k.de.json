      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "muzhik-sosed",
      "text": "Ich hoffe, Sie nehmen nicht an, dass ich ein Serienmörder bin.",
