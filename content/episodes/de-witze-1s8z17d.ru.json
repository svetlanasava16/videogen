      "id": "l1",
      "character": "muzhik",
      "text": "Больше никогда не буду сдавать кровь!",
      "emotion": "angry",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "muzhik-sosed",
      "text": "Что? Так плохо было?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "muzhik",
      "text": "Да эти вечные вопросы!",
      "emotion": "angry",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "muzhik-sosed",
      "text": "Да, регистрация бывает та ещё...",
      "emotion": "neutral",
      "pauseAfterSec": 0.2
    },
    {
      "id": "l5",
      "character": "muzhik",
      "text": "Откуда у вас эта кровь?",
      "emotion": "angry",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l6",
      "character": "muzhik",
      "text": "Почему её так много?",
      "emotion": "angry",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l7",
      "character": "muzhik",
      "text": "Почему вы несёте её в ведре?",
