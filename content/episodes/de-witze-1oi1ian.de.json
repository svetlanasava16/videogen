  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein kleines Mädchen fährt auf seinem neuen Fahrrad die Straße rauf und runter.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "sluzhivy",
      "text": "Na, hat dir das Christkind das Fahrrad geschenkt?",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [
        "sluzhivy",
        "loshad"
      ],
      "exit": []
    },
    {
      "id": "l3",
      "character": "devochka",
      "text": "Ja, genau! Das hab ich mir ganz doll gewünscht.",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "sluzhivy",
      "text": "Schön. Leider muss ich dir trotzdem einen Strafzettel geben.",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "sluzhivy",
      "text": "Das Christkind hat die Reflektoren vergessen.",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "devochka",
      "text": "Ist Ihr Pferd auch vom Christkind?",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "sluzhivy",
      "text": "Allerdings.",
      "emotion": "happy",
      "pauseAfterSec": 0.7,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "devochka",
      "text": "Dann sagen Sie dem Christkind nächstes Jahr: Der Arsch kommt hinten hin, nicht obendrauf!",
      "emotion": "angry",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    }
  ],
