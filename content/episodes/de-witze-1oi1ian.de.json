{
  "id": "de-witze-1oi1ian.de",
  "jokeId": "de-witze-1oi1ian",
  "locale": "de",
  "title": "Weihnachtsgeschenk",
  "location": "ulitsa",
  "place": "street",
  "cast": [
    "devochka",
    "sluzhivy",
    "loshad"
  ],
  "roles": {
    "devochka": "child",
    "sluzhivy": "police-officer",
    "loshad": "horse"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein kleines Mädchen fährt auf seinem neuen Fahrrad die Straße rauf und runter.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Plötzlich kommt ein Polizist zu Pferd vorbei. Er hält das Mädchen an.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "sluzhivy",
      "text": "Na, hat dir das Christkind zu Weihnachten ein Fahrrad geschenkt?",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "devochka",
      "text": "Ja genau. Das habe ich mir auch ganz doll gewünscht.",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "sluzhivy",
      "text": "Das ist aber toll.",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "sluzhivy",
      "text": "Leider muss ich dir einen Strafzettel geben, denn das Christkind hat vergessen, dein Fahrrad mit Reflektoren auszustatten.",
      "emotion": "smug",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "devochka",
      "text": "Ist Ihr Pferd auch vom Christkind?",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "narrator",
      "text": "Der Polizist lächelt und nickt bestätigend.",
      "emotion": "neutral",
      "pauseAfterSec": 0.7,
      "enter": [],
      "exit": []
    },
    {
      "id": "l9",
      "character": "devochka",
      "text": "Na, dann sagen Sie dem Christkind nächstes Jahr, das Hinterteil kommt hinten hin, und nicht oben drauf!",
      "uncensored": "Na, dann sagen Sie dem Christkind nächstes Jahr, das Arschloch kommt hinten hin, und nicht oben drauf!",
      "emotion": "angry",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
