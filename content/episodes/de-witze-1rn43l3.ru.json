  "lines": [
    {
      "id": "l1",
      "character": "uchilka",
      "text": "Как бы ты хотел однажды умереть?",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "vovochka",
      "text": "Как мой дедушка.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "uchilka",
      "text": "А как умер твой дедушка?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "vovochka",
      "text": "Он уснул.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "uchilka",
      "text": "Да, это прекрасная смерть, я бы тоже хотела так умереть.",
      "emotion": "happy",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l6",
      "character": "uchilka",
      "text": "А как бы ты не хотел умереть?",
      "emotion": "neutral",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l7",
      "character": "vovochka",
      "text": "Как те двое, которые ехали с дедушкой.",
      "emotion": "sad",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
