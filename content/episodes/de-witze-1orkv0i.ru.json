  "locale": "ru",
  "title": "Верная жена",
  "location": "spalnya",
  "place": "bedroom",
  "cast": [
    "ded",
    "zhena"
  ],
  "roles": {
    "ded": "old-man",
    "zhena": "wife"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Старик умирает. У его постели сидит жена.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "ded",
      "text": "Галя, со дня свадьбы мы ни разу не расставались.",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "ded",
      "text": "Когда меня уволили, ты была рядом.",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "ded",
      "text": "Когда умерли мои родители, ты была рядом.",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "ded",
      "text": "Когда я разбился на лыжах, ты сидела у моей кровати.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "ded",
      "text": "Когда инфляция съела все мои сбережения, ты не ушла.",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "ded",
      "text": "А теперь я умираю, и ты опять здесь.",
      "emotion": "surprised",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "ded",
      "text": "Галя, от тебя одни несчастья!",
      "emotion": "angry",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    }
  ],
