  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Zwei Anwälte gehen in ein Café, bestellen Getränke und packen ihre Butterbrote aus.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "barmen",
      "text": "Entschuldigung, aber bei uns darf man kein eigenes Essen essen.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "Die Anwälte sehen sich an, zucken mit den Schultern...",
      "emotion": "neutral",
      "pauseAfterSec": 0.6,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "narrator",
      "text": "...und tauschen ihre Butterbrote.",
      "emotion": "neutral",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
