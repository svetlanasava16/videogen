  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Drei Uhr nachts. Ein wütender Mann hämmert gegen die Wand zum Nachbarn.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "muzhik",
      "text": "Wenn du Mistkerl nicht sofort aufhörst, auf deiner verdammten Posaune zu spielen, werde ich verrückt!",
      "uncensored": "Wenn du Scheißkerl nicht sofort aufhörst, auf deiner verfickten Posaune zu spielen, werde ich verrückt!",
      "emotion": "angry",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l3",
      "character": "muzhik-sosed",
      "text": "Ich fürchte, du kommst zu spät, mein Lieber. Ich spiele schon seit gut zwei Stunden nicht mehr...",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
