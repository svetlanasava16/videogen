  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Мать даёт дочери, которая только что вышла замуж, советы по хозяйству.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "zhena",
      "text": "Вот у меня, например, на полотенцах в ванной всегда вышита буква Л — для лица, и буква М — для мягкого места.",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "zhena",
      "text": "Так я никогда не путаю полотенца.",
      "emotion": "happy",
      "pauseAfterSec": 0.6,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "Как это?! Я всегда думал, что М — это для морды.",
      "emotion": "surprised",
      "pauseAfterSec": 0.8,
      "enter": [
        "muzhik"
      ],
      "exit": [],
      "laugh": "big"
    }
  ],
