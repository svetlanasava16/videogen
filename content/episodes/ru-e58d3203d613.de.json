  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein Volvo streift an einer Kreuzung einen Jeep.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Alle halten an, aus dem Jeep quellen Typen in Trainingsanzügen und gehen auf den Volvo-Fahrer zu.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "nachalnik",
      "text": "So, Mann, du bist dran!",
      "emotion": "angry",
      "pauseAfterSec": 0.2,
      "enter": [
        "nachalnik",
        "muzhik-ryzhy",
        "paren"
      ],
      "exit": []
    },
    {
      "id": "l4",
      "character": "nachalnik",
      "text": "Verkauf dein Auto, verkauf deine Wohnung, du schuldest uns Geld!",
      "emotion": "angry",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "muzhik",
      "text": "Jungs, und wer seid ihr?",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "nachalnik",
      "text": "Wir? Wir sind Sportler!",
      "emotion": "surprised",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "narrator",
      "text": "Der Mann zieht eine Pistole und sagt, während er sie lädt:",
      "emotion": "neutral",
      "pauseAfterSec": 0.7,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "muzhik",
      "text": "Na dann: Auf die Plätze! Fertig!..",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
