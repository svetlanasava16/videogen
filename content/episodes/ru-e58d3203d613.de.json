  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein Volvo rammt an einer Kreuzung einen Jeep. Alle halten an, aus dem Jeep springen Typen in Trainingsanzügen und gehen auf den Volvofahrer zu.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "nachalnik",
      "text": "So, Mann, jetzt bist du dran! Verkauf dein Auto, verkauf deine Wohnung, du schuldest uns Geld!",
      "emotion": "angry",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "muzhik",
      "text": "Jungs, wer seid ihr denn?",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "nachalnik",
      "text": "Wir? Wir sind Sportler!",
      "emotion": "surprised",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l5",
      "character": "muzhik",
      "text": "Na dann: Auf die Plätze! Fertig!",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
  "explicit": false,
