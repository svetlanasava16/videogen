    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein Volvo schrammt an der Kreuzung einen Geländewagen. Heraus springen Typen in Trainingsanzügen.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "nachalnik",
      "text": "So, Alter, jetzt bist du dran!",
      "emotion": "angry",
      "pauseAfterSec": 0.3,
      "enter": [
        "nachalnik"
      ],
      "exit": []
    },
    {
      "id": "l3",
      "character": "nachalnik",
      "text": "Verkauf dein Auto, verkauf deine Wohnung, du zahlst!",
      "emotion": "angry",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "Leute, wer seid ihr überhaupt?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "nachalnik",
      "text": "Wir? Wir sind Sportler!",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "Der Mann zieht seelenruhig eine Pistole.",
      "emotion": "neutral",
      "pauseAfterSec": 0.7,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "muzhik",
      "text": "Na dann: Auf die Plätze! Fertig!",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
