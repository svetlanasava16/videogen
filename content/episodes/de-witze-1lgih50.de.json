      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "muzhik",
      "text": "Ich hätte gern das Schnitzel mit Bratkartoffeln und Salat, dazu ein lauwarmes Bier ohne Krone.",
