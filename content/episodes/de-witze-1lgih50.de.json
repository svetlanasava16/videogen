      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "muzhik",
      "text": "Die Kartoffeln richtig schwarz angebrannt, das Schnitzel möglichst zäh und fade, den Salat können Sie ganz weglassen.",
