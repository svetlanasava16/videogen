  "locale": "de",
  "title": "Die Bestellung",
  "kind": "joke",
  "v": 2,
  "location": "bar",
  "place": "restaurant",
  "cast": [
    "muzhik",
    "barmen"
  ],
  "roles": {
    "muzhik": "customer",
    "barmen": "waiter"
  },
  "lines": [
    {
      "id": "l1",
      "character": "barmen",
      "text": "Na, was darf's denn sein?",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "muzhik",
      "text": "Ich hätte gern das Schnitzel mit Bratkartoffeln und Salat,",
      "emotion": "smug",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l2b",
      "character": "muzhik",
      "text": "dazu ein lauwarmes Bier ohne Krone.",
      "emotion": "smug",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "muzhik",
      "text": "Die Kartoffeln richtig schwarz angebrannt,",
      "emotion": "smug",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l3b",
      "character": "muzhik",
      "text": "das Schnitzel möglichst zäh und fade, den Salat können Sie ganz weglassen.",
      "emotion": "smug",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "Und genieren Sie sich nicht mit der Rechnung.",
      "emotion": "smug",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l5",
      "character": "barmen",
      "text": "Also wissen Sie, sowas servieren wir eigentlich nicht.",
      "emotion": "angry",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l6",
      "character": "muzhik",
      "text": "Komisch, gestern kam's genau so...",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
