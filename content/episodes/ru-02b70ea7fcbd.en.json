{
  "id": "ru-02b70ea7fcbd.en",
  "jokeId": "ru-02b70ea7fcbd",
  "locale": "en",
  "title": "The Family Vote",
  "kind": "joke",
  "v": 2,
  "location": "bolnitsa",
  "place": "doctor-office",
  "cast": [
    "doktor",
    "muzhik"
  ],
  "roles": {
    "doktor": "doctor",
    "muzhik": "patient"
  },
  "lines": [
    {
      "id": "l1",
      "character": "muzhik",
      "text": "Doctor, I heard there's an operation after which you just can't have any more children.",
      "emotion": "sad",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "muzhik",
      "text": "Do that one for me.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "doktor",
      "text": "Now, my dear man, decisions like that aren't made on a whim.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "doktor",
      "text": "Today you don't want children, but tomorrow you will.",
      "emotion": "smug",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "doktor",
      "text": "Weigh it all up, discuss it with your family...",
      "emotion": "neutral",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l6",
      "character": "muzhik",
      "text": "Oh, we did. The vote was: two against, seventeen in favour.",
      "emotion": "sad",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
  "explicit": false,
