  "lines": [
    {
      "id": "l1",
      "character": "muzhik",
      "text": "Doctor, I heard there's an operation after which you just can't have any more children.",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [
        "muzhik"
      ],
      "exit": []
    },
    {
      "id": "l2",
      "character": "muzhik",
      "text": "Do that one for me.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "doktor",
      "text": "Now, my dear man, decisions like that aren't made on a whim.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "doktor",
      "text": "Today you don't want children, but tomorrow you will.",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "doktor",
      "text": "Weigh it all up, discuss it with your family...",
      "emotion": "neutral",
      "pauseAfterSec": 0.7,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "muzhik",
      "text": "Oh, we did. The vote was: two against, seventeen in favour.",
      "emotion": "sad",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
