  "locale": "de",
  "title": "Schubs mich an",
  "location": "gostinaya",
  "place": "park",
  "cast": [
    "zhena",
    "muzhik",
    "muzhik-ryzhy"
  ],
  "roles": {
    "zhena": "wife",
    "muzhik": "husband",
    "muzhik-ryzhy": "drunk"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Drei Uhr nachts. Es klingelt an der Tür.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "muzhik-ryzhy",
      "text": "Kumpel, hilf mir! Ist gleich um die Ecke. Schubs mich an.",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [
        "muzhik-ryzhy"
      ],
      "exit": []
    },
    {
      "id": "l3",
      "character": "muzhik",
      "text": "Spinnst du? Es ist drei Uhr nachts! Frag jemand anderen.",
      "emotion": "angry",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": [
        "muzhik-ryzhy"
      ]
    },
    {
      "id": "l4",
      "character": "zhena",
      "text": "Wer war das?",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "muzhik",
      "text": "Irgendein Betrunkener steckt fest und will angeschubst werden. Ich hab ihn weggeschickt.",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "zhena",
      "text": "Du Unmensch! Weißt du noch, wie unser Motor im Regen ausging und uns einer eine Stunde lang angeschoben hat?",
      "emotion": "angry",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "zhena",
      "text": "Und du hilfst keinem?",
      "emotion": "angry",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "muzhik",
      "text": "Schon gut, ich geh ja.",
      "emotion": "sad",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l9",
      "character": "muzhik",
      "text": "Hallo! Wo bist du?",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l10",
      "character": "muzhik-ryzhy",
      "text": "Hier bin ich! Komm her!",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [
        "muzhik-ryzhy"
      ],
      "exit": []
    },
    {
      "id": "l11",
      "character": "muzhik",
      "text": "Wo ist denn hier?",
      "emotion": "angry",
      "pauseAfterSec": 0.7,
      "enter": [],
      "exit": []
    },
    {
      "id": "l12",
      "character": "muzhik-ryzhy",
      "text": "Na hier, auf der Schaukel!",
      "emotion": "happy",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    }
  ],
