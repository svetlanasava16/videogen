{
  "id": "ru-3a049c5b9532.de",
  "jokeId": "ru-3a049c5b9532",
  "locale": "de",
  "title": "Anschubsen",
  "location": "spalnya",
  "place": "park",
  "cast": [
    "muzhik",
    "zhena"
  ],
  "roles": {
    "muzhik": "husband",
    "zhena": "wife"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Drei Uhr nachts. Mann und Frau schlafen.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Plötzlich klingelt es an der Tür.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "Der Mann geht fluchend aufmachen.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "muzhik-ryzhy",
      "text": "Kumpel, komm mit, ist gleich hier um die Ecke, du musst mich anschubsen.",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "muzhik",
      "text": "Sag mal, spinnst du, Mann? Es ist drei Uhr nachts. Frag jemand anderen.",
      "emotion": "angry",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "Der Mann legt sich wieder ins Bett.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "zhena",
      "text": "Wer war das?",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "muzhik",
      "text": "Ach, irgendein Idiot steckt fest und wollte, dass ich ihn anschubse. Ich hab ihn zum Teufel geschickt.",
      "emotion": "smug",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l9",
      "character": "zhena",
      "text": "Du bist wirklich ein Unmensch.",
      "emotion": "angry",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l10",
      "character": "zhena",
      "text": "Weißt du noch, wie uns der Motor abgesoffen ist, mitten im Regen, und irgendein junger Mann uns eine ganze Stunde lang angeschubst hat?",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l11",
      "character": "zhena",
      "text": "Und du kannst einem Menschen nicht helfen?",
      "emotion": "angry",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l12",
      "character": "narrator",
      "text": "Der Mann kriecht wieder fluchend aus dem Bett und zieht sich an.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l13",
      "character": "narrator",
      "text": "Er geht in stockdunkler Nacht auf den Hof.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l14",
      "character": "muzhik",
      "text": "Mann! Wo bist du?",
      "emotion": "angry",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l15",
      "character": "muzhik-ryzhy",
      "text": "Hier bin ich! Komm her!",
      "offscreen": true,
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l16",
      "character": "muzhik",
      "text": "Wo ist denn hier?",
      "emotion": "angry",
      "pauseAfterSec": 0.6,
      "enter": [],
      "exit": []
    },
    {
      "id": "l17",
      "character": "muzhik-ryzhy",
      "text": "Na hier, auf der Schaukel!",
      "offscreen": true,
      "emotion": "happy",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
