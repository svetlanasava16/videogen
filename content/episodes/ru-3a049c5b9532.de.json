{
  "id": "ru-3a049c5b9532.de",
  "jokeId": "ru-3a049c5b9532",
  "locale": "de",
  "title": "Anschubsen",
  "location": "gostinaya",
  "place": "park",
  "cast": [
    "muzhik-ryzhy",
    "muzhik"
  ],
  "roles": {
    "muzhik-ryzhy": "drunk",
    "muzhik": "husband"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Drei Uhr nachts. Mann und Frau schlafen. Plötzlich klingelt es. Fluchend geht der Mann aufmachen.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "muzhik-ryzhy",
      "text": "Kumpel, komm mit, ist gleich hier um die Ecke, du kannst mich anschubsen.",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "muzhik",
      "text": "Sag mal, Mann, spinnst du? Es ist drei Uhr nachts. Frag jemand anderen.",
      "emotion": "angry",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "zhena",
      "text": "Wer war das?",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "muzhik",
      "text": "Ach, irgendein Trottel steckt fest und wollte, dass ich ihn anschubse. Ich hab ihn zum Teufel geschickt.",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "zhena",
      "text": "Du bist echt ein Unmensch. Weißt du noch, wie uns der Motor abgesoffen ist, noch dazu im Regen, und irgendein Kerl hat uns eine ganze Stunde lang angeschubst?",
      "emotion": "angry",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "zhena",
      "text": "Und du kannst einem Menschen nicht helfen?",
      "emotion": "angry",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "narrator",
      "text": "Wieder fluchend steht der Mann auf und zieht sich an. Draußen im Hof ist es stockdunkel.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l9",
      "character": "muzhik",
      "text": "Hey, Mann! Wo bist du?",
      "emotion": "angry",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l10",
      "character": "muzhik-ryzhy",
      "text": "Hier bin ich! Komm her!",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l11",
      "character": "muzhik",
      "text": "Wo denn hier?",
      "emotion": "surprised",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    },
    {
      "id": "l12",
      "character": "muzhik-ryzhy",
      "text": "Na hier, auf der Schaukel!",
      "emotion": "happy",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
