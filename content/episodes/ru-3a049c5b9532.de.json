{
  "id": "ru-3a049c5b9532.de",
  "jokeId": "ru-3a049c5b9532",
  "locale": "de",
  "title": "Anschubsen",
  "location": "ulitsa",
  "cast": [
    "zhena",
    "muzhik",
    "muzhik-ryzhy"
  ],
  "roles": {
    "zhena": "wife",
    "muzhik": "husband",
    "muzhik-ryzhy": "drunk"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Drei Uhr nachts. Es klingelt an der Tür.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "muzhik-ryzhy",
      "text": "Kumpel, hilf mir mal! Gleich um die Ecke. Du musst mich anschubsen.",
      "emotion": "happy",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "muzhik",
      "text": "Spinnst du? Es ist drei Uhr nachts! Frag jemand anderen.",
      "emotion": "angry",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l4",
      "character": "zhena",
      "text": "Wer war das?",
      "emotion": "neutral",
      "pauseAfterSec": 0.2
    },
    {
      "id": "l5",
      "character": "muzhik",
      "text": "Irgendein Trottel hängt fest und will angeschubst werden. Ich hab ihn weggeschickt.",
      "emotion": "angry",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l6",
      "character": "zhena",
      "text": "Du Unmensch! Weißt du noch, als unser Motor im Regen ausging und uns ein junger Mann eine Stunde lang angeschubst hat?",
      "emotion": "angry",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l7",
      "character": "zhena",
      "text": "Und du kannst keinem helfen?",
      "emotion": "angry",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l8",
      "character": "narrator",
      "text": "Fluchend zieht er sich an und geht hinaus in den stockdunklen Hof.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l9",
      "character": "muzhik",
      "text": "Hallo! Wo bist du?",
      "emotion": "angry",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l10",
      "character": "muzhik-ryzhy",
      "text": "Hier! Komm her!",
      "emotion": "happy",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l11",
      "character": "muzhik",
      "text": "Wo denn hier?",
      "emotion": "surprised",
      "pauseAfterSec": 0.8
    },
    {
      "id": "l12",
      "character": "muzhik-ryzhy",
      "text": "Na hier, auf der Schaukel!",
      "emotion": "happy",
      "pauseAfterSec": 0.8
    }
  ],
  "format": {
    "width": 1080,
    "height": 1920,
    "fps": 30
  }
}
