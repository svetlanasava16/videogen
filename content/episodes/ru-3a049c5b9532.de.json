{
  "id": "ru-3a049c5b9532.de",
  "jokeId": "ru-3a049c5b9532",
  "locale": "de",
  "title": "Anschubsen",
  "kind": "joke",
  "v": 2,
  "location": "spalnya",
  "place": "park",
  "cast": [
    "muzhik",
    "zhena",
    "muzhik-ryzhy"
  ],
  "roles": {
    "muzhik": "husband",
    "muzhik-ryzhy": "drunk",
    "zhena": "wife"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Drei Uhr nachts. Mann und Frau schlafen.",
      "emotion": "neutral",
      "pauseAfterSec": 0
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Plötzlich klingelt es an der Tür.",
      "emotion": "surprised",
      "pauseAfterSec": 0
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "Der Mann geht fluchend aufmachen.",
      "emotion": "angry",
      "pauseAfterSec": 0
    },
    {
      "id": "l4",
      "character": "narrator",
      "text": "Vor der Tür steht ein Kerl, offensichtlich angetrunken:",
      "emotion": "neutral",
      "pauseAfterSec": 0
    },
    {
      "id": "l5",
      "character": "muzhik-ryzhy",
      "text": "Freund, komm mit, ist gleich hier um die Ecke, du musst mich anschubsen.",
      "emotion": "happy",
      "pauseAfterSec": 0
    },
    {
      "id": "l6",
      "character": "muzhik",
      "text": "Sag mal, Mann, spinnst du? Es ist drei Uhr nachts. Frag jemand anderen.",
      "emotion": "angry",
      "pauseAfterSec": 0
    },
    {
      "id": "l7",
      "character": "narrator",
      "text": "Der Mann legt sich wieder ins Bett.",
      "emotion": "neutral",
      "pauseAfterSec": 0
    },
    {
      "id": "l8",
      "character": "narrator",
      "text": "Die Frau fragt, wer da war.",
      "emotion": "neutral",
      "pauseAfterSec": 0
    },
    {
      "id": "l9",
      "character": "muzhik",
      "text": "Ach, irgendein Trottel hängt fest und wollte, dass ich ihn anschubse. Ich hab ihn zum Teufel geschickt.",
      "emotion": "smug",
      "pauseAfterSec": 0
    },
    {
      "id": "l10",
      "character": "zhena",
      "text": "Du bist echt ein Unmensch.",
      "emotion": "angry",
      "pauseAfterSec": 0
    },
    {
      "id": "l11",
      "character": "zhena",
      "text": "Weißt du noch, wie uns der Motor abgesoffen ist, mitten im Regen, und irgendein junger Kerl uns eine ganze Stunde angeschoben hat?",
      "emotion": "angry",
      "pauseAfterSec": 0
    },
    {
      "id": "l12",
      "character": "zhena",
      "text": "Kannst du einem Menschen nicht mal aushelfen?",
      "emotion": "angry",
      "pauseAfterSec": 0
    },
    {
      "id": "l13",
      "character": "narrator",
      "text": "Der Mann kriecht, wieder fluchend, aus dem Bett und zieht sich an.",
      "emotion": "angry",
      "pauseAfterSec": 0
    },
    {
      "id": "l14",
      "character": "narrator",
      "text": "Er geht hinaus in den Hof, stockdunkel. Er ruft:",
      "emotion": "neutral",
      "pauseAfterSec": 0
    },
    {
      "id": "l15",
      "character": "muzhik",
      "text": "Hey, Mann! Wo bist du?",
      "emotion": "angry",
      "pauseAfterSec": 0
    },
    {
      "id": "l16",
      "character": "narrator",
      "text": "Aus der Dunkelheit:",
      "emotion": "neutral",
      "pauseAfterSec": 0
    },
    {
      "id": "l17",
      "character": "muzhik-ryzhy",
      "text": "Hier bin ich! Komm her!",
      "offscreen": true,
      "emotion": "happy",
      "pauseAfterSec": 0
    },
    {
      "id": "l18",
      "character": "muzhik",
      "text": "Wo ist denn hier?",
      "emotion": "surprised",
      "pauseAfterSec": 0
    },
    {
      "id": "l19",
      "character": "muzhik-ryzhy",
      "text": "Na hier, auf der Schaukel!",
      "emotion": "happy",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
