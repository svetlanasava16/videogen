{
  "id": "en-r-9phvd8.en",
  "jokeId": "en-r-9phvd8",
  "locale": "en",
  "title": "The Prescription",
  "kind": "joke",
  "v": 2,
  "location": "magazin",
  "place": "pharmacy",
  "cast": [
    "zhena",
    "doktor",
    "muzhik",
    "devushka"
  ],
  "roles": {
    "zhena": "wife",
    "doktor": "pharmacist",
    "muzhik": "husband",
    "devushka": "woman"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "A nice, calm and respectable lady went into the pharmacy, right up to the pharmacist, and looked straight into his eyes.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "zhena",
      "text": "I would like to buy some cyanide.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "doktor",
      "text": "Why in the world do you need cyanide?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "zhena",
      "text": "I need it to poison my husband.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l5",
      "character": "doktor",
      "text": "Lord have mercy! I can't give you cyanide to kill your husband!",
      "emotion": "surprised",
      "pauseAfterSec": 0.2
    },
    {
      "id": "l6",
      "character": "doktor",
      "text": "That's against the law! I'll lose my license! They'll throw both of us in jail!",
      "emotion": "angry",
      "pauseAfterSec": 0.2
    },
    {
      "id": "l7",
      "character": "doktor",
      "text": "All kinds of bad things will happen.",
      "emotion": "angry",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l7b",
      "character": "doktor",
      "text": "Absolutely not! You cannot have any cyanide!",
      "emotion": "angry",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l8",
      "character": "narrator",
      "text": "The lady reached into her purse and pulled out a picture of her husband in bed with the pharmacist's wife.",
      "emotion": "neutral",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l9",
      "character": "doktor",
      "text": "Well now. That's different. You didn't tell me you had a prescription.",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
  "explicit": false,
