  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Mitten in der Stadt findet ein Mann einen Pinguin.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Er nimmt diesen mit auf ein Polizeirevier, um zu fragen, was er mit dem Tier machen soll.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "sluzhivy",
      "text": "Tja, guter Mann, also ich würde mit dem Pinguin in den Zoo gehen.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "narrator",
      "text": "Der Mann bedankt sich und zottelt mit dem Pinguin davon.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "Am nächsten Tag trifft der Polizist den Mann und den Pinguin zufällig in der Stadt.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "sluzhivy",
      "text": "Sagen Sie mal, habe ich Ihnen nicht gesagt, dass Sie mit dem Pinguin in den Zoo gehen sollen?",
      "emotion": "angry",
      "pauseAfterSec": 0.7,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "muzhik",
      "text": "Ja, klar, da waren wir gestern, heute gehen wir ins Kino.",
      "emotion": "happy",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
