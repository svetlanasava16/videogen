  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Турист на Генисаретском озере хочет переправиться на пароме.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "muzhik-sosed",
      "text": "Мне на тот берег.",
      "emotion": "happy",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "sluzhivy-ryadovoy",
      "text": "Двести долларов.",
      "emotion": "smug",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "muzhik-sosed",
      "text": "Двести долларов? Почему так дорого?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "sluzhivy-ryadovoy",
      "text": "Так ведь здесь сам Иисус по воде ходил!",
      "emotion": "smug",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l6",
      "character": "muzhik-sosed",
      "text": "Теперь понятно, почему он пешком пошёл!",
      "emotion": "angry",
      "pauseAfterSec": 0.8
    }
  ],
