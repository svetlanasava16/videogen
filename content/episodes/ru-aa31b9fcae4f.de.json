{
  "id": "ru-aa31b9fcae4f.de",
  "jokeId": "ru-aa31b9fcae4f",
  "locale": "de",
  "title": "Der runden Summe wegen",
  "kind": "joke",
  "v": 2,
  "location": "ulitsa",
  "place": "street",
  "cast": [
    "muzhik",
    "muzhik-sosed"
  ],
  "roles": {
    "muzhik": "everyman",
    "muzhik-sosed": "friend"
  },
  "lines": [
    {
      "id": "l1",
      "character": "muzhik",
      "text": "Ach, verdammt, Geldbeutel vergessen, und mir fehlt ein Zehner. Leihst du mir einen?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "muzhik-sosed",
      "text": "Na, hier.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "Am nächsten Tag.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "Schulde ich dir einen Zehner?",
      "emotion": "neutral",
      "pauseAfterSec": 0.2
    },
    {
      "id": "l5",
      "character": "muzhik-sosed",
      "text": "Ja.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l6",
      "character": "muzhik",
      "text": "Schon wieder hab ich den Geldbeutel vergessen. Leih mir noch vierzig, dann schulde ich dir genau fünfzig.",
      "emotion": "happy",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l7",
      "character": "muzhik-sosed",
      "text": "Na gut.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l8",
      "character": "narrator",
      "text": "Am nächsten Tag.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l9",
      "character": "muzhik",
      "text": "Schulde ich dir fünfzig Euro?",
      "emotion": "neutral",
      "pauseAfterSec": 0.2
    },
    {
      "id": "l10",
      "character": "muzhik-sosed",
      "text": "Ja.",
      "emotion": "sad",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l11",
      "character": "muzhik",
      "text": "Heute schon wieder ohne Geldbeutel. Komm, leih mir noch hundertfünfzig, dann geb ich dir zweihundert zurück.",
      "emotion": "happy",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l12",
      "character": "muzhik-sosed",
      "text": "Na schön.",
      "emotion": "sad",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l13",
      "character": "narrator",
      "text": "Am nächsten Tag.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l14",
      "character": "muzhik",
      "text": "Schulde ich dir zweihundert?",
      "emotion": "neutral",
      "pauseAfterSec": 0.2
    },
    {
      "id": "l15",
      "character": "muzhik-sosed",
      "text": "Na klar.",
      "emotion": "sad",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l16",
      "character": "muzhik",
      "text": "Komm, der runden Summe wegen leih ich mir noch dreihundert, und dann geb ich dir gleich fünfhundert zurück.",
      "emotion": "smug",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l17",
      "character": "muzhik-sosed",
      "text": "Na, was soll man machen, hier.",
      "emotion": "sad",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l18",
      "character": "narrator",
      "text": "Am nächsten Tag.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l19",
      "character": "muzhik",
      "text": "Schulde ich dir fünfhundert?",
      "emotion": "neutral",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l20",
      "character": "muzhik-sosed",
      "text": "Nein!",
      "emotion": "angry",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
