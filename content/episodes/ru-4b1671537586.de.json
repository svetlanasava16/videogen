{
  "id": "ru-4b1671537586.de",
  "jokeId": "ru-4b1671537586",
  "locale": "de",
  "title": "Der Neurochirurg",
  "location": "spalnya",
  "place": "bathroom",
  "cast": [
    "doktor",
    "barmen"
  ],
  "roles": {
    "doktor": "doctor",
    "barmen": "plumber"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Bei einem Arzt zu Hause ist die Toilette verstopft.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Man rief einen Klempner.",
      "emotion": "neutral",
      "pauseAfterSec": 0.2,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "Der Klempner kam, klopfte ein paar Mal irgendwo mit dem Hammer, wechselte eine Dichtung, zog eine Mutter fest.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "barmen",
      "text": "Fertig, alles funktioniert. Das macht zweihundert Euro.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "doktor",
      "text": "Wie, zweihundert Euro? Für fünf Minuten Arbeit?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "doktor",
      "text": "Ich bin Neurochirurg, ich habe zwölf Jahre lang mein Fach studiert, aber mir zahlt keiner für fünf Minuten Arbeit zweihundert Euro.",
      "emotion": "angry",
      "pauseAfterSec": 0.6,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "barmen",
      "text": "Das ist doch normal. Als ich Neurochirurg war, hat man mir das auch nicht gezahlt.",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
