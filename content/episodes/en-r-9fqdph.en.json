  "lines": [
    {
      "id": "l1",
      "character": "devushka-blondinka",
      "text": "Doctor, I really need to lose some weight.",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [
        "devushka-blondinka"
      ],
      "exit": []
    },
    {
      "id": "l2",
      "character": "doktor",
      "text": "Easy. Eat normally for two days, then skip a day. Repeat for two weeks.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "doktor",
      "text": "You'll lose at least five pounds.",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": [
        "devushka-blondinka"
      ]
    },
    {
      "id": "l4",
      "character": "narrator",
      "text": "Two weeks later.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "devushka-blondinka",
      "text": "Doctor, I lost almost twenty pounds!",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [
        "devushka-blondinka"
      ],
      "exit": []
    },
    {
      "id": "l6",
      "character": "doktor",
      "text": "Amazing! So you followed my instructions?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "devushka-blondinka",
      "text": "I did. But I thought I'd drop dead on the third day.",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "doktor",
      "text": "From hunger?",
      "emotion": "surprised",
      "pauseAfterSec": 0.7,
      "enter": [],
      "exit": []
    },
    {
      "id": "l9",
      "character": "devushka-blondinka",
      "text": "No, from skipping.",
      "emotion": "neutral",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    }
  ],
