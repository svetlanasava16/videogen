{
  "id": "en-r-9fqdph.en",
  "jokeId": "en-r-9fqdph",
  "locale": "en",
  "title": "Skip a Day",
  "kind": "joke",
  "v": 2,
  "location": "bolnitsa",
  "place": "doctor-office",
  "cast": [
    "devushka-blondinka",
    "doktor"
  ],
  "roles": {
    "devushka-blondinka": "blonde",
    "doktor": "doctor"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "A blonde is overweight, so her doctor puts her on a diet.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "doktor",
      "text": "I want you to eat regularly for two days,",
      "emotion": "neutral",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l2b",
      "character": "doktor",
      "text": "then skip a day, and repeat the procedure for two weeks.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "doktor",
      "text": "The next time I see you, you'll have lost at least five pounds.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l4",
      "character": "narrator",
      "text": "When the blonde returns, she's lost nearly twenty pounds.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "doktor",
      "text": "Wow, that's amazing!",
      "emotion": "surprised",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l6",
      "character": "doktor",
      "text": "Did you follow my instructions?",
      "emotion": "happy",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l7",
      "character": "devushka-blondinka",
      "text": "I'll tell you, I'd thought I was going to drop dead that third day.",
      "emotion": "sad",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l8",
      "character": "doktor",
      "text": "From hunger, you mean?",
      "emotion": "neutral",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l9",
      "character": "devushka-blondinka",
      "text": "No, from skipping.",
      "emotion": "neutral",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
