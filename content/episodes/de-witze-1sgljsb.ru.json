  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Сидят два рыбака на реке.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Мимо идёт похоронная процессия.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "Один рыбак встаёт, снимает шляпу и склоняет голову, пока процессия не пройдёт, а потом возвращается к рыбалке.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l4",
      "character": "muzhik-sosed",
      "text": "Ого, уважаю, вот уж не думал, что в тебе столько порядочности.",
      "emotion": "surprised",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l5",
      "character": "muzhik-ryzhy",
      "text": "Мы ведь, в конце концов, сорок восемь лет прожили в браке.",
      "emotion": "neutral",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
