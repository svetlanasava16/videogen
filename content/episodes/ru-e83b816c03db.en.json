{
  "id": "ru-e83b816c03db.en",
  "jokeId": "ru-e83b816c03db",
  "locale": "en",
  "title": "The Change",
  "kind": "joke",
  "v": 2,
  "location": "bar",
  "place": "bar",
  "cast": [
    "barmen",
    "muzhik"
  ],
  "roles": {
    "barmen": "bartender",
    "muzhik": "customer"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "A man walks into a bar and orders a whisky:",
      "emotion": "neutral",
      "pauseAfterSec": 0
    },
    {
      "id": "l2",
      "character": "muzhik",
      "text": "How much do I owe you?",
      "emotion": "neutral",
      "pauseAfterSec": 0
    },
    {
      "id": "l3",
      "character": "barmen",
      "text": "Three dollars.",
      "emotion": "neutral",
      "pauseAfterSec": 0
    },
    {
      "id": "l4",
      "character": "narrator",
      "text": "The man takes three dollars out of his pocket.",
      "emotion": "neutral",
      "pauseAfterSec": 0
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "He puts one on the bar in front of him,",
      "emotion": "neutral",
      "pauseAfterSec": 0
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "then walks to the left end of the bar and puts the second one there,",
      "emotion": "neutral",
      "pauseAfterSec": 0
    },
    {
      "id": "l7",
      "character": "narrator",
      "text": "then walks to the right end of the bar and puts the third one there.",
      "emotion": "neutral",
      "pauseAfterSec": 0
    },
    {
      "id": "l8",
      "character": "narrator",
      "text": "The bartender, quietly cursing, walks right and left and collects the money.",
      "emotion": "neutral",
      "pauseAfterSec": 0
    },
    {
      "id": "l9",
      "character": "narrator",
      "text": "The next day the same man comes in again,",
      "emotion": "neutral",
      "pauseAfterSec": 0
    },
    {
      "id": "l10",
      "character": "narrator",
      "text": "again orders a glass of whisky and again spreads the dollars out to different ends of the bar.",
      "emotion": "neutral",
      "pauseAfterSec": 0
    },
    {
      "id": "l11",
      "character": "narrator",
      "text": "The bartender is furious, but he goes for the money.",
      "emotion": "neutral",
      "pauseAfterSec": 0
    },
    {
      "id": "l12",
      "character": "narrator",
      "text": "Long story short, this goes on day after day.",
      "emotion": "neutral",
      "pauseAfterSec": 0
    },
    {
      "id": "l13",
      "character": "narrator",
      "text": "And then one day the man orders a whisky, takes the glass,",
      "emotion": "neutral",
      "pauseAfterSec": 0
    },
    {
      "id": "l14",
      "character": "narrator",
      "text": "digs in his pocket and pulls out a five-dollar bill.",
      "emotion": "neutral",
      "pauseAfterSec": 0
    },
    {
      "id": "l15",
      "character": "narrator",
      "text": "The bartender quickly grabs the bill, smiles vengefully,",
      "emotion": "neutral",
      "pauseAfterSec": 0
    },
    {
      "id": "l16",
      "character": "narrator",
      "text": "takes out two dollars in change,",
      "emotion": "neutral",
      "pauseAfterSec": 0
    },
    {
      "id": "l17",
      "character": "narrator",
      "text": "walks to the left end of the bar and puts one dollar there,",
      "emotion": "neutral",
      "pauseAfterSec": 0
    },
    {
      "id": "l18",
      "character": "narrator",
      "text": "then walks to the right end and puts the second one there.",
      "emotion": "neutral",
      "pauseAfterSec": 0
    },
    {
      "id": "l19",
      "character": "narrator",
      "text": "Then he comes back and stares at the man, gloating.",
      "emotion": "neutral",
      "pauseAfterSec": 0
    },
    {
      "id": "l20",
      "character": "narrator",
      "text": "The man calmly drinks his whisky,",
      "emotion": "neutral",
      "pauseAfterSec": 0
    },
    {
      "id": "l21",
      "character": "narrator",
      "text": "takes a dollar out of his pocket, puts it down in front of him and says:",
      "emotion": "neutral",
      "pauseAfterSec": 0
    },
    {
      "id": "l22",
      "character": "muzhik",
      "text": "I think I'll have another glass.",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
