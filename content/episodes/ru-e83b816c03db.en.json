{
  "id": "ru-e83b816c03db.en",
  "jokeId": "ru-e83b816c03db",
  "locale": "en",
  "title": "The Change",
  "location": "bar",
  "place": "bar",
  "cast": [
    "muzhik",
    "barmen"
  ],
  "roles": {
    "muzhik": "everyman",
    "barmen": "bartender"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "A man walks into a bar and orders a whiskey.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "muzhik",
      "text": "How much do I owe you?",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "barmen",
      "text": "Three dollars.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "narrator",
      "text": "He puts one dollar on the bar in front of him, walks to the left end and puts down the second, then to the right end and puts down the third.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "The bartender, swearing under his breath, walks right and left to collect the money.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "The next day the same man is back, and again his dollars go to both ends of the bar. The bartender fumes, but he walks.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "narrator",
      "text": "And so it goes, day after day.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "narrator",
      "text": "Then one day the man digs in his pocket and pulls out a five-dollar bill.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l9",
      "character": "narrator",
      "text": "The bartender smiles vengefully, puts one dollar of change at the left end and the other at the right end.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l10",
      "character": "narrator",
      "text": "Then he comes back and gloats at the man.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l11",
      "character": "narrator",
      "text": "The man calmly drinks up, takes out a dollar and puts it in front of him.",
      "emotion": "neutral",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    },
    {
      "id": "l12",
      "character": "muzhik",
      "text": "I think I'll have another one.",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
