{
  "id": "en-r-c1ldyh.ru",
  "jokeId": "en-r-c1ldyh",
  "locale": "ru",
  "title": "На автобусе",
  "location": "bar",
  "place": "road",
  "cast": [
    "muzhik"
  ],
  "roles": {
    "muzhik": "drunk"
  },
  "lines": [
    {
      "id": "l1",
      "character": "muzhik",
      "text": "Вчера вечером я пошёл пропустить пару рюмок.",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "muzhik",
      "text": "Слово за слово, я перебрал с коктейлями, а потом перешёл на вино.",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "muzhik",
      "text": "Плохая идея.",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "Понимая, что я уже выше нормы, я решил оставить машину у бара и поехал домой на автобусе.",
      "emotion": "smug",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "muzhik",
      "text": "И точно, по дороге я проехал полицейский пост, где тормозили водителей и проверяли их алкотестером.",
      "offscreen": true,
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "muzhik",
      "text": "Раз я был в автобусе, его просто пропустили, махнув рукой.",
      "offscreen": true,
      "emotion": "smug",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "muzhik",
      "text": "До дома я добрался целым и невредимым, без всяких происшествий,",
      "emotion": "happy",
      "pauseAfterSec": 0.6,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "muzhik",
      "text": "что стало для меня настоящим сюрпризом, ведь я никогда раньше не водил автобус и даже не уверен, где я его взял.",
      "emotion": "surprised",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
