  "locale": "de",
  "title": "Neuer Sportwagen",
  "kind": "joke",
  "v": 2,
  "location": "ulitsa",
  "place": "street",
  "cast": [
    "paren",
    "nachalnik"
  ],
  "roles": {
    "paren": "employee",
    "nachalnik": "boss"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Der Chef fährt morgens mit einem brandneuen, sehr teuren Sportwagen vor.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "paren",
      "text": "Das ist aber ein toller, neuer Wagen, den Sie da haben.",
      "emotion": "surprised",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l2b",
      "character": "paren",
      "text": "Da wird man ja direkt neidisch.",
      "emotion": "surprised",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l3",
      "character": "nachalnik",
      "text": "Wissen Sie, wenn Sie das ganze Jahr hart arbeiten,",
      "emotion": "smug",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l3b",
      "character": "nachalnik",
      "text": "alles für den Erfolg der Firma in die Waagschale schmeißen und das Ergebnis vom vergangenen Geschäftsjahr toppen,",
      "emotion": "smug",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l4",
      "character": "nachalnik",
      "text": "dann kann ich mir nächstes Jahr einen noch besseren Wagen leisten.",
      "emotion": "happy",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
  "explicit": false,
