    {
      "id": "l1",
      "character": "narrator",
      "text": "A wife asks her programmer husband to go to the store.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "zhena",
      "text": "Can you go down to the store, and get a gallon of milk,",
      "emotion": "neutral",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l2b",
      "character": "zhena",
      "text": "and if they have eggs, get six.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "Later on he returns home.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "zhena",
      "text": "Why the heck do you have six gallons of milk?",
      "uncensored": "Why the fuck do you have six gallons of milk?",
      "emotion": "angry",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l5",
      "character": "paren",
      "text": "They had eggs.",
      "emotion": "neutral",
      "pauseAfterSec": 0.8,
