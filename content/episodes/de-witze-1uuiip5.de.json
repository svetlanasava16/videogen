      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "paren",
      "text": "Also, wenn Sie heute unterschreiben, können Sie schon in drei Jahren schnell surfen!",
