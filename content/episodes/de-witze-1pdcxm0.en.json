  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "In the middle of the night, a doctor is called out to an emergency.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [
        "doktor"
      ],
      "exit": []
    },
    {
      "id": "l2",
      "character": "doktor",
      "text": "Have you made your will yet?",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "muzhik",
      "text": "No, I haven't. Is it really that bad?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "doktor",
      "text": "Call a lawyer right now. And get your closest relatives over here!",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "muzhik",
      "text": "Does that mean I'm dying?",
      "emotion": "sad",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "doktor",
      "text": "No. I just don't want to be the only one dragged out of bed in the middle of the night for nothing.",
      "emotion": "angry",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    }
  ],
