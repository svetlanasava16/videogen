{
  "id": "ru-9ec25a940d9f.de",
  "jokeId": "ru-9ec25a940d9f",
  "locale": "de",
  "title": "Schnitzel mit Erbsen",
  "location": "gostinaya",
  "place": "home-kitchen",
  "cast": [
    "zhena",
    "muzhik"
  ],
  "roles": {
    "zhena": "wife",
    "muzhik": "husband"
  },
  "lines": [
    {
      "id": "l1",
      "character": "muzhik",
      "text": "In einer halben Stunde kommen Gäste. Ich habe meinen Chef eingeladen.",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "zhena",
      "text": "Bist du verrückt geworden? Wir haben doch nichts im Haus, womit wir ihn bewirten können.",
      "emotion": "angry",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "muzhik",
      "text": "Na, lass dir was einfallen. Wir müssen ihn unbedingt empfangen, morgen wird entschieden, wer eine Gehaltserhöhung bekommt.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "zhena",
      "text": "Aber wir haben doch gar nichts. Nur Suppe für dich und eine Dose Erbsen.",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "muzhik",
      "text": "Also, hör mir zu. Wenn er kommt, sage ich, dass du Schnitzel mit Erbsen machst.",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "muzhik",
      "text": "Ich bewirte ihn solange hier mit unserem selbstgemachten Likör.",
      "emotion": "smug",
      "pauseAfterSec": 0.2,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "muzhik",
      "text": "Dann zerschlägst du in der Küche einen Teller und fängst an zu jammern.",
      "emotion": "smug",
      "pauseAfterSec": 0.2,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "muzhik",
      "text": "Ich frage dich, was los ist, und du rufst, du hast die Schnitzel in den Müll fallen lassen.",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l9",
      "character": "muzhik",
      "text": "Du servierst die Erbsen, da kann man nichts machen.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l10",
      "character": "narrator",
      "text": "Kurz und gut, sie sind sich einig. Der Chef kommt.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l11",
      "character": "narrator",
      "text": "Der Mann bewirtet ihn mit dem Likör, dann ruft er seiner Frau zu:",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l12",
      "character": "muzhik",
      "text": "Na, wie steht's mit unseren Schnitzeln mit Erbsen?",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l13",
      "character": "narrator",
      "text": "In der Küche fallen Teller, es kracht, es wird gejammert.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l14",
      "character": "muzhik",
      "text": "Na, du Tollpatsch? Hast du etwa die Schnitzel in den Müll fallen lassen?",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    },
    {
      "id": "l15",
      "character": "zhena",
      "text": "Nein, die Erbsen.",
      "offscreen": true,
      "emotion": "sad",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
