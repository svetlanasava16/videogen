    {
      "id": "l1",
      "character": "muzhik",
      "text": "Mein Opa wusste im Voraus, an welchem Tag er sterben würde.",
      "emotion": "smug",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "muzhik",
      "text": "Und sogar ungefähr die Stunde.",
      "emotion": "smug",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "muzhik-sosed",
      "text": "War er etwa Hellseher?",
      "emotion": "surprised",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "Was denn für ein Hellseher, zum Teufel! Der Richter hat es ihm gesagt.",
      "emotion": "angry",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
