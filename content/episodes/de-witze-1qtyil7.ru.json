    {
      "id": "l1",
      "character": "narrator",
      "text": "В поезде Мюллер не сводит глаз с попутчика напротив.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "nachalnik",
      "text": "Что вы так смотрите?",
      "emotion": "angry",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "muzhik",
      "text": "Простите, но если не считать усов, вы вылитая моя жена.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "nachalnik",
      "text": "Но у меня же нет никаких усов!",
      "emotion": "surprised",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l5",
      "character": "muzhik",
      "text": "У вас нет.",
      "emotion": "sad",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
