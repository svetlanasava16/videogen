  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "So I was at a bar last night and saw this fat chick wearing a shirt that said: Caution, I'm a maneater.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "muzhik",
      "text": "Excuse me, Miss... about your shirt.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "devushka",
      "text": "Oh let me guess, you're here to make a comment about how I'm so fat and how I actually eat men.",
      "emotion": "angry",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "devushka",
      "text": "I can't help my weight, you know.",
      "emotion": "sad",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l4b",
      "character": "devushka",
      "text": "I have feelings too, and your comments can really hurt.",
      "emotion": "sad",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l5",
      "character": "muzhik",
      "text": "That's actually not what I was going to say at all.",
      "emotion": "surprised",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l6",
      "character": "devushka",
      "text": "Oh... What were you going to say?",
      "emotion": "happy",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l7",
      "character": "muzhik",
      "text": "That's not how you spell manatee.",
      "emotion": "neutral",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
