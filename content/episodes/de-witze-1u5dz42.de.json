  "locale": "de",
  "title": "Die Ausstellung",
  "location": "zal",
  "place": "museum",
  "cast": [
    "paren",
    "nachalnik"
  ],
  "roles": {
    "paren": "artist",
    "nachalnik": "businessman"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein Künstler hat soeben seine erste Ausstellung hinter sich gebracht und holt sich nun Feedback beim Galeristen.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "nachalnik",
      "text": "Ich habe eine gute und eine schlechte Nachricht für Sie. Welche möchten Sie zuerst hören?",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "paren",
      "text": "Die gute Nachricht bitte.",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "nachalnik",
      "text": "Ein Besucher hat mich gefragt, ob die Gemälde nach dem Tod des Künstlers im Wert noch beträchtlich steigen würden.",
      "emotion": "neutral",
      "pauseAfterSec": 0.2,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "nachalnik",
      "text": "Ich versicherte ihm, dass dies erfahrungsgemäß so sei.",
      "emotion": "smug",
      "pauseAfterSec": 0.2,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "nachalnik",
      "text": "Daraufhin hat er alle fünfzehn Gemälde gekauft.",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "paren",
      "text": "Das ist ja fantastisch! Was ist denn die schlechte Nachricht?",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "nachalnik",
      "text": "Nun, Sie kennen den Käufer.",
      "emotion": "sad",
      "pauseAfterSec": 0.7,
      "enter": [],
      "exit": []
    },
    {
      "id": "l9",
      "character": "nachalnik",
      "text": "Er ist Ihr Hausarzt.",
      "emotion": "sad",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
