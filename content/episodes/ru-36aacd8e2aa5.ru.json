{
  "id": "ru-36aacd8e2aa5.ru",
  "jokeId": "ru-36aacd8e2aa5",
  "locale": "ru",
  "title": "Чей телефон?",
  "location": "banya",
  "place": "bathhouse",
  "cast": [
    "muzhik",
    "nachalnik",
    "muzhik-sosed"
  ],
  "roles": {
    "muzhik": "new-russian",
    "nachalnik": "new-russian",
    "muzhik-sosed": "new-russian"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Сидят несколько новых русских в бане.",
      "emotion": "neutral",
      "pauseAfterSec": 0,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Звонит сотовик.",
      "emotion": "neutral",
      "pauseAfterSec": 0,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "Один из них берёт трубку:",
      "emotion": "neutral",
      "pauseAfterSec": 0,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "nachalnik",
      "text": "Алё... да, дорогая... да, в бане... да, с друганами... да. До одиннадцати.",
      "emotion": "neutral",
      "pauseAfterSec": 0,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "nachalnik",
      "text": "Что купить? Платье?? Тысяча долларов? Зачем тебе пятидесятое платье?",
      "emotion": "surprised",
      "pauseAfterSec": 0,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "nachalnik",
      "text": "В театр сходить? Ну ладно. Деньги знаешь где? Купи.",
      "emotion": "smug",
      "pauseAfterSec": 0,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "narrator",
      "text": "Опять звонок, тот же новый русский берёт трубку:",
      "emotion": "neutral",
      "pauseAfterSec": 0,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "nachalnik",
      "text": "Алё... да, дорогая... да, в бане... да, с друганами... да. До одиннадцати.",
      "emotion": "neutral",
      "pauseAfterSec": 0,
      "enter": [],
      "exit": []
    },
    {
      "id": "l9",
      "character": "nachalnik",
      "text": "Что купить? Шубу?? Зачем тебе десятая шуба??",
      "emotion": "surprised",
      "pauseAfterSec": 0,
      "enter": [],
      "exit": []
    },
    {
      "id": "l10",
      "character": "nachalnik",
      "text": "На Канары съездить? Пятьдесят тысяч?? Ну ладно... Деньги знаешь где...",
      "emotion": "smug",
      "pauseAfterSec": 0,
      "enter": [],
      "exit": []
    },
    {
      "id": "l11",
      "character": "narrator",
      "text": "Опять звонок, опять тот же новый русский:",
      "emotion": "neutral",
      "pauseAfterSec": 0,
      "enter": [],
      "exit": []
    },
    {
      "id": "l12",
      "character": "nachalnik",
      "text": "Алё... да, дорогая... да, в бане... да, с друганами... да. До одиннадцати.",
      "emotion": "neutral",
      "pauseAfterSec": 0,
      "enter": [],
      "exit": []
    },
    {
      "id": "l13",
      "character": "nachalnik",
      "text": "Что купить? Машину??? Зачем тебе шестая машина???",
      "emotion": "angry",
      "pauseAfterSec": 0,
      "enter": [],
      "exit": []
    },
    {
      "id": "l14",
      "character": "nachalnik",
      "text": "Перед мамой выпендриться? Сколько??? Триста тысяч гринов??? Ну ладно... Покупай... Деньги знаешь где...",
      "emotion": "smug",
      "pauseAfterSec": 0,
      "enter": [],
      "exit": []
    },
    {
      "id": "l15",
      "character": "narrator",
      "text": "Отключает трубку...",
      "emotion": "neutral",
      "pauseAfterSec": 0,
      "enter": [],
      "exit": []
    },
    {
      "id": "l16",
      "character": "nachalnik",
      "text": "Гм... кхем... мужики, чей телефон?",
      "emotion": "surprised",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
