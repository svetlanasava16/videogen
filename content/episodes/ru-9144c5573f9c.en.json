  "locale": "en",
  "title": "Someone Under the Bed",
  "location": "bolnitsa",
  "place": "doctor-office",
  "cast": [
    "muzhik",
    "doktor"
  ],
  "roles": {
    "muzhik": "patient",
    "doktor": "doctor"
  },
  "lines": [
    {
      "id": "l1",
      "character": "muzhik",
      "text": "Doctor, I'm exhausted. Every night in bed I feel someone is under it.",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [
        "muzhik"
      ],
      "exit": []
    },
    {
      "id": "l2",
      "character": "muzhik",
      "text": "So I crawl under the bed, and then I feel someone lying on top. All night long.",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "doktor",
      "text": "A complex syndrome. Two or three months of intensive treatment. Expensive, but we'll cure you.",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "Okay. I'll think about it.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": [
        "muzhik"
      ]
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "A month later, the doctor runs into him on the street.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "doktor",
      "text": "Hello! Why didn't you come back?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [
        "muzhik"
      ],
      "exit": []
    },
    {
      "id": "l7",
      "character": "muzhik",
      "text": "My neighbor cured me. For one bottle.",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "doktor",
      "text": "How?",
      "emotion": "surprised",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    },
    {
      "id": "l9",
      "character": "muzhik",
      "text": "We had a drink, and he said: just saw the legs off your bed.",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    }
  ],
  "format": {
    "width": 1080,
