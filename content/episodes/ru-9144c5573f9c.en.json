{
  "id": "ru-9144c5573f9c.en",
  "jokeId": "ru-9144c5573f9c",
  "locale": "en",
  "title": "The Bed Legs",
  "location": "bolnitsa",
  "place": "doctor-office",
  "cast": [
    "muzhik",
    "doktor"
  ],
  "roles": {
    "muzhik": "patient",
    "doktor": "doctor"
  },
  "lines": [
    {
      "id": "l1",
      "character": "muzhik",
      "text": "Doctor, I'm worn out.",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [
        "muzhik"
      ],
      "exit": []
    },
    {
      "id": "l2",
      "character": "muzhik",
      "text": "I go to bed, and I feel like there's someone under the bed. I crawl under the bed, take a good look, and then I sense someone lying on my bed.",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "muzhik",
      "text": "I crawl out from under the bed, nobody's up there. I lie down, and I feel it: there is someone under the bed after all.",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "And when I crawl under the bed again, I feel like there's someone on top. And so on all night.",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "doktor",
      "text": "Yes, there is such a complex syndrome. We'll treat you intensively, two or three months.",
      "emotion": "neutral",
      "pauseAfterSec": 0.2,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "doktor",
      "text": "We do charge a lot, mind you, but most likely we'll cure you.",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "muzhik",
      "text": "All right, I'll think about it.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": [
        "muzhik"
      ]
    },
    {
      "id": "l8",
      "character": "narrator",
      "text": "He never came back. A month later the doctor runs into him on the street.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l9",
      "character": "doktor",
      "text": "How are you doing?",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l10",
      "character": "muzhik",
      "text": "Oh, my neighbor cured me for a bottle.",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l11",
      "character": "doktor",
      "text": "How's that?",
      "emotion": "surprised",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    },
    {
      "id": "l12",
      "character": "muzhik",
      "text": "We had a drink, and he says to me: just saw the damn legs off your bed.",
      "emotion": "happy",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
