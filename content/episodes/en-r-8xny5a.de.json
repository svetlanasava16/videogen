    {
      "id": "l1",
      "character": "narrator",
      "text": "Nach drei Jahren fällt der Frau auf, dass der Sohn ihnen gar nicht ähnlich sieht. Sie macht einen DNA-Test.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "zhena",
      "text": "Schatz, ich muss dir etwas sehr Ernstes sagen.",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "muzhik",
      "text": "Was ist los?",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "zhena",
      "text": "Laut DNA-Test ist das nicht unser Kind.",
      "emotion": "sad",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "muzhik",
      "text": "Weißt du nicht mehr? Beim Verlassen des Krankenhauses hatte unser Baby eine nasse Windel.",
      "emotion": "surprised",
      "pauseAfterSec": 0.7,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "muzhik",
      "text": "Und du hast gesagt: Schatz, geh mal schnell das Baby wechseln, ich warte hier.",
      "emotion": "neutral",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    }
  ],
