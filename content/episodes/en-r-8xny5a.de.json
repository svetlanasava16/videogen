{
  "id": "en-r-8xny5a.de",
  "jokeId": "en-r-8xny5a",
  "locale": "de",
  "title": "Wechsel das Baby",
  "kind": "joke",
  "v": 2,
  "location": "gostinaya",
  "place": "home-living-room",
  "cast": [
    "zhena",
    "vovochka",
    "muzhik"
  ],
  "roles": {
    "zhena": "wife",
    "vovochka": "child",
    "muzhik": "husband"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Nach drei Jahren fängt die Frau an zu glauben, dass ihr Kind irgendwie anders aussieht, und beschließt, einen DNA-Test zu machen.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Sie findet heraus, dass das Kind in Wahrheit von ganz anderen Eltern stammt.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "zhena",
      "text": "Schatz, ich muss dir etwas sehr Ernstes sagen.",
      "emotion": "sad",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "Was ist los?",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "zhena",
      "text": "Laut DNA-Test ist das nicht unser Kind.",
      "emotion": "surprised",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l6",
      "character": "muzhik",
      "text": "Na, weißt du nicht mehr?",
      "emotion": "surprised",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l7",
      "character": "muzhik",
      "text": "Als wir aus dem Krankenhaus kamen, haben wir gemerkt,",
      "emotion": "smug",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l7c",
      "character": "muzhik",
      "text": "dass unser Baby eine nasse Windel hatte,",
      "emotion": "smug",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l7b",
      "character": "muzhik",
      "text": "und du hast gesagt: 'Schatz, geh und wechsle das Baby, ich warte hier auf dich.'",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
