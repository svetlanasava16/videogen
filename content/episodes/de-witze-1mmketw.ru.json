    {
      "id": "l1",
      "character": "narrator",
      "text": "Молодой человек приходит на собеседование, начальник представляется.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "nachalnik",
      "text": "Как вас зовут?",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "paren",
      "text": "П-П-П-Петер Мюллер.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l4",
      "character": "nachalnik",
      "text": "А, вы заикаетесь?",
      "emotion": "surprised",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l5",
      "character": "paren",
      "text": "Нет, но мой отец — да, а работник загса был козёл!",
      "uncensored": "Нет, но мой отец — да, а работник загса был мудак!",
      "emotion": "angry",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
