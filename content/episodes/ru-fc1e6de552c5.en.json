      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "muzhik",
      "text": "Sugar plum, at the bar they serve hot shrimp. My favorite.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
