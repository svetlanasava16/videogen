      "id": "l1",
      "character": "muzhik",
      "text": "Honey, I'm popping out for a couple of hours.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "zhena",
      "text": "Where are you going, bunny?",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "muzhik",
      "text": "Sweetheart, I thought I'd stop by the bar for a beer.",
