  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "A newlywed couple. One evening the husband says to his wife:",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "muzhik",
      "text": "Darling, I'm going out for a couple of hours.",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "zhena",
      "text": "And where are you off to, my little bunny?",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "Sweetheart, I'd like to pop into the bar for a beer.",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "zhena",
      "text": "You want a beer, kitten? Look, I bought you twenty-five kinds of beer, light and dark...",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "muzhik",
      "text": "You see, my angel, I'd like a beer with chips. I'll be back soon.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "zhena",
      "text": "My love, look in the cupboard, I've stocked a whole selection of chips for you...",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "muzhik",
      "text": "Listen, my little squirrel, at the bar they serve it with hot shrimp, my favorite.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l9",
      "character": "zhena",
      "text": "My sunshine, I'm just putting your favorite shrimp on to boil.",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l10",
      "character": "muzhik",
      "text": "How can I explain it, blue eyes, it's totally different at the bar, you can let loose sometimes and nobody judges you, people even swear freely there...",
      "emotion": "sad",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l11",
      "character": "zhena",
      "text": "Okay, honey!",
      "emotion": "smug",
      "pauseAfterSec": 0.6,
      "enter": [],
      "exit": []
    },
    {
      "id": "l12",
      "character": "zhena",
      "text": "Go on, drink your freaking beer with your crappy chips and those darn shrimp, because you're not going freaking anywhere, you jerk!",
      "uncensored": "Go on, drink your fucking beer with your shitty chips and those goddamn shrimp, because you're not going fucking anywhere, you jerk!",
      "emotion": "angry",
