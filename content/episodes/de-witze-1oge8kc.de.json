    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein Deutscher lernt Englisch. Er ist ein wahrer Spätzünder: Erst mit dreißig lernt er an der VHS Englisch.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Sein Lehrer empfiehlt ihm dringend, in Großbritannien zu üben. Also fährt er in ein typisches britisches Dorf, geht dort in einen typisch britischen Pub.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "Am Nebentisch sitzen drei typische britische Frauen. Er ist sehr nervös, aber traut sich, hinzugehen.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "paren",
      "text": "Excuse me, are you ladies from Scotland?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [
        "paren"
      ],
      "exit": []
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "Die drei merken gleich, dass er nur schlecht Englisch spricht. Freundlich antwortet eine.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "devushka",
      "text": "No, dear. Wales.",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "narrator",
      "text": "Er bemerkt seinen Fehler und fragt erneut.",
      "emotion": "neutral",
      "pauseAfterSec": 0.6,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "paren",
      "text": "Are you wales from Scotland?",
      "emotion": "happy",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
