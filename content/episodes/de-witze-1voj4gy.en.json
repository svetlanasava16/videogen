  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "A man is being chased by the police, and they have a wild car chase.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Eventually the police catch him after all.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "sluzhivy",
      "text": "If you don't have a really good reason for your driving and for running away, you're going to be in big trouble.",
      "emotion": "angry",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "Sorry, but two weeks ago my wife ran off with a policeman.",
      "emotion": "sad",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l5",
      "character": "muzhik",
      "text": "And I thought he wanted to bring her back to me.",
      "emotion": "surprised",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
