  "lines": [
    {
      "id": "l1",
      "character": "muzhik",
      "text": "Доктор, умоляю, приезжайте немедленно. У жены сильный приступ аппендицита!",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "doktor",
      "text": "Не волнуйтесь. Два года назад я сделал вашей жене операцию и удалил слепой отросток.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "doktor",
      "text": "У человека не может появиться второй аппендикс!",
      "emotion": "smug",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "Правильно, доктор.",
      "emotion": "neutral",
      "pauseAfterSec": 0.7,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "muzhik",
      "text": "Но у человека может появиться вторая жена.",
      "emotion": "neutral",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
