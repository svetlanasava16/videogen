  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Три мальчика сидят на заборе и хвастаются своими папами.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "vovochka-drug",
      "text": "Мой папа — гонщик Формулы-один.",
      "emotion": "happy",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l2b",
      "character": "vovochka-drug",
      "text": "Он такой быстрый: как нажмёт на газ, так асфальт горит!",
      "emotion": "happy",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l3",
      "character": "paren",
      "text": "Пф, а мой папа — пилот реактивного самолёта.",
      "emotion": "smug",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l3b",
      "character": "paren",
      "text": "Он такой быстрый, что обгоняет собственный звук!",
      "emotion": "smug",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l4",
      "character": "vovochka",
      "text": "Новички вы все. Мой папа — чиновник.",
      "emotion": "neutral",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l5",
      "character": "vovochka",
      "text": "У него хоть и рабочий день до пяти, а дома он уже в четыре.",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
