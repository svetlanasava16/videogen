{
  "id": "de-witze-1iep2pl.de",
  "jokeId": "de-witze-1iep2pl",
  "locale": "de",
  "title": "Danke an den Spender",
  "kind": "joke",
  "v": 2,
  "location": "bar",
  "place": "bar",
  "cast": [
    "sluzhivy",
    "muzhik-sosed"
  ],
  "roles": {
    "sluzhivy": "pirate",
    "muzhik-sosed": "tourist"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "In einer Hafenkneipe sitzt ein typischer Pirat an der Theke: Augenklappe, Holzbein, Haken als Hand.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l2",
      "character": "muzhik-sosed",
      "text": "Wo haben Sie denn das Bein verloren?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "sluzhivy",
      "text": "Das hat man mir bei einem Kampf vor Trinidad weggeschossen.",
      "emotion": "smug",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "muzhik-sosed",
      "text": "Und was war mit Ihrer Hand?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "sluzhivy",
      "text": "Ein Säbelhieb, als wir eine Fregatte geentert haben.",
      "emotion": "smug",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l6",
      "character": "muzhik-sosed",
      "text": "Und das Auge?",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l7",
      "character": "sluzhivy",
      "text": "Da hat mir eine Möwe reingekackt.",
      "uncensored": "Da hat mir eine Möwe reingeschissen.",
      "emotion": "sad",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l8",
      "character": "muzhik-sosed",
      "text": "Aber dadurch verliert man doch kein Auge?",
      "emotion": "surprised",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l9",
      "character": "sluzhivy",
      "text": "Doch, da hatte ich den Haken gerade erst zwei Tage.",
      "emotion": "sad",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
