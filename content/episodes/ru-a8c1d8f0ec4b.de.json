{
  "id": "ru-a8c1d8f0ec4b.de",
  "jokeId": "ru-a8c1d8f0ec4b",
  "locale": "de",
  "title": "Semjonytsch",
  "location": "derevnya",
  "place": "farm",
  "cast": [
    "paren",
    "muzhik-ryzhy"
  ],
  "roles": {
    "paren": "driver",
    "muzhik-ryzhy": "farmer"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Auf der Schweinefarm kippt ein Traktorist beim Zurücksetzen seinen riesigen Mistanhänger um.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Er rennt aufgeregt herum.",
      "emotion": "neutral",
      "pauseAfterSec": 0.2,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "muzhik-ryzhy",
      "text": "Mist, was regst du dich so auf, lass uns erst mal eine rauchen und überlegen, wie und was...",
      "uncensored": "Scheiße, was regst du dich so auf, lass uns erst mal eine rauchen und überlegen, wie und was...",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "paren",
      "text": "Keine Zeit, Semjonytsch wird schimpfen.",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "muzhik-ryzhy",
      "text": "Ach komm, steck dir eine an.",
      "emotion": "happy",
      "pauseAfterSec": 0.2,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "Sie rauchen.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "muzhik-ryzhy",
      "text": "So ist das... Jetzt wirst du dich hier den halben Tag abrackern...",
      "uncensored": "So ist das... Jetzt wirst du dich hier den halben Tag abficken...",
      "emotion": "sad",
      "pauseAfterSec": 0.2,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "muzhik-ryzhy",
      "text": "Wir sollten was futtern gehen, sonst, pass auf, bleibst du wegen dem Mist noch ohne Mittagessen.",
      "uncensored": "Wir sollten was futtern gehen, sonst, pass auf, bleibst du wegen dem Scheiß noch ohne Mittagessen.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l9",
      "character": "paren",
      "text": "Ich kann nicht, ich muss mich beeilen, sonst wird Semjonytsch sauer.",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l10",
      "character": "narrator",
      "text": "Sie gehen essen.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l11",
      "character": "muzhik-ryzhy",
      "text": "Na, dann kippen wir mal einen Kleinen...",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l12",
      "character": "paren",
      "text": "Ich kann echt nicht, Semjonytsch kriegt das raus und brüllt rum.",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l13",
      "character": "muzhik-ryzhy",
      "text": "Schnurzegal, mach dir nicht in die Hose, du schaffst alles noch.",
      "uncensored": "Scheißegal, scheiß dir nicht in die Hose, du schaffst alles noch.",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l14",
      "character": "narrator",
      "text": "Sie trinken.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l15",
      "character": "muzhik-ryzhy",
      "text": "Jetzt noch ein Bierchen obendrauf, das wär's...",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l16",
      "character": "paren",
      "text": "Ich geh lieber, sonst staucht mich Semjonytsch, fürchte ich, richtig zusammen.",
      "uncensored": "Ich geh lieber, sonst scheißt mich Semjonytsch, fürchte ich, richtig zusammen.",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l17",
      "character": "muzhik-ryzhy",
      "text": "Wo ist denn dein Semjonytsch überhaupt?",
      "emotion": "surprised",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    },
    {
      "id": "l18",
      "character": "paren",
      "text": "Na, der ist dort geblieben, den hat der Anhänger unter sich begraben.",
      "emotion": "neutral",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
