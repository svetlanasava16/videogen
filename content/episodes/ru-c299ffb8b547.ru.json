  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Звонок в дверь. На пороге огромный барабан с тарелками, а за ним человек.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "muzhik",
      "text": "Вам кого?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "paren",
      "text": "Простите, это у вас похороны?",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [
        "paren"
      ],
      "exit": []
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "Нет... Доктор сказал, ещё три дня осталось.",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "paren",
      "text": "Ой, ради бога, извините!",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": [
        "paren"
      ]
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "Через пару минут снова звонок.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "muzhik",
      "text": "Ну что ещё?",
      "emotion": "angry",
      "pauseAfterSec": 0.7,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "paren",
      "text": "Извините, можно я у вас пока барабан оставлю?",
      "emotion": "neutral",
      "pauseAfterSec": 0.8,
      "enter": [
        "paren"
      ],
      "exit": []
    }
  ],
