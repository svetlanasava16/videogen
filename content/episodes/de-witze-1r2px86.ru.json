      "id": "l1",
      "character": "paren",
      "text": "Шеф, можно я сегодня уйду на два часа пораньше?",
      "emotion": "sad",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l1b",
      "character": "paren",
      "text": "Жена хочет со мной по магазинам пройтись.",
      "emotion": "sad",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "nachalnik",
      "text": "Об этом не может быть и речи!",
      "emotion": "angry",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l3",
      "character": "paren",
      "text": "Огромное спасибо, шеф! Я знал, что на вас можно положиться!",
      "emotion": "happy",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
