  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "A little boy comes home from school and tells his father:",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "vovochka-drug",
      "text": "I got an F in math today.",
      "emotion": "sad",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "muzhik",
      "text": "What happened?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "vovochka-drug",
      "text": "Well, my teacher asked me, what's three times two, and I said six.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "muzhik",
      "text": "Well, that's correct.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l6",
      "character": "vovochka-drug",
      "text": "I know. Then she asked me, what's two times three.",
      "emotion": "sad",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l7",
      "character": "muzhik",
      "text": "What the heck is the difference?",
      "uncensored": "What the fuck is the difference?",
      "emotion": "angry",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l8",
      "character": "vovochka-drug",
      "text": "That's what I said!",
      "emotion": "happy",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
