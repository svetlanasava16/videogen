  "locale": "en",
  "title": "The Cabbie",
  "location": "doroga",
  "place": "car",
  "cast": [
    "ded",
    "muzhik-ryzhy",
    "muzhik-sosed"
  ],
  "roles": {
    "ded": "old-man",
    "muzhik-ryzhy": "driver",
    "muzhik-sosed": "customer"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "A country bumpkin in the city for the first time takes a ride in a Mercedes taxi.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "muzhik-sosed",
      "text": "What's that star on the hood for?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "muzhik-ryzhy",
      "text": "Just you wait, I'll pull your leg.",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "muzhik-ryzhy",
      "text": "That's a sight for hitting pensioners.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "muzhik-ryzhy",
      "text": "For every one I get, I get a five hundred dollar bonus.",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "With that he heads straight for a pensioner, but swerves at the very last moment.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "narrator",
      "text": "Still, there's a dull thud, and the pensioner is lying on the ground.",
      "emotion": "surprised",
      "pauseAfterSec": 0.6,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "muzhik-sosed",
      "text": "If I hadn't flung the door open at the last moment, we'd have lost that bonus for sure!",
      "emotion": "happy",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
