  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "A farmer comes to the city and takes a taxi for the first time. A Mercedes.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "muzhik-sosed",
      "text": "Say, what's that star on the hood for?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "muzhik-ryzhy",
      "text": "That? It's a sight. For aiming at old folks.",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "muzhik-ryzhy",
      "text": "Every one I hit, I get a five hundred dollar bonus.",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "muzhik-sosed",
      "text": "No kidding?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "muzhik-ryzhy",
      "text": "Watch this.",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [
        "ded"
      ],
      "exit": []
    },
    {
      "id": "l7",
      "character": "narrator",
      "text": "He floors it straight at an old man and swerves at the very last second. Still, there's a dull thud.",
      "emotion": "neutral",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "muzhik-sosed",
      "text": "Good thing I flung my door open at the last second, or we'd have lost that bonus!",
      "emotion": "happy",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    }
  ],
