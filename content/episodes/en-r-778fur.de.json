{
  "id": "en-r-778fur.de",
  "jokeId": "en-r-778fur",
  "locale": "de",
  "title": "Das Erbe",
  "kind": "joke",
  "v": 2,
  "location": "gostinaya",
  "place": "office",
  "cast": [
    "muzhik",
    "doktor"
  ],
  "roles": {
    "muzhik": "everyman",
    "doktor": "scientist"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Eines Tages erfährt ein Mann, dass ein entfernter Onkel gestorben ist.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Er ist nur ein bisschen traurig, denn sie kannten sich kaum.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "Ein paar Tage später kommt ein Paket mit seinem Erbe: eine Geige und ein Gemälde.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "narrator",
      "text": "Ratlos bringt er beides zu einem Gutachter.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "Kurz darauf ruft der Gutachter an.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l6",
      "character": "doktor",
      "text": "Ich habe meine Analyse abgeschlossen, und ich habe gute Nachrichten.",
      "emotion": "happy",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l7",
      "character": "doktor",
      "text": "Es besteht nicht der geringste Zweifel: Sie besitzen einen echten Van Gogh und eine echte Stradivari.",
      "emotion": "smug",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l8",
      "character": "muzhik",
      "text": "Die kann ich für Millionen verkaufen!",
      "emotion": "happy",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l9",
      "character": "doktor",
      "text": "Nun ja, verkaufen können Sie sie, und als Kuriosität bringen sie auch etwas Geld. Aber keine Millionen.",
      "emotion": "neutral",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l10",
      "character": "doktor",
      "text": "Wissen Sie, in Wahrheit war Stradivari kein großer Maler... und Van Gogh hat lausige Geigen gebaut.",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
  "explicit": false,
