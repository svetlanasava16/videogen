  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "На корпоративе один из руководителей говорит сотруднику:",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "nachalnik",
      "text": "Я слышал, вы очень талантливы?",
      "emotion": "smug",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "nachalnik",
      "text": "Почему вы не работаете в моём отделе?",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "paren",
      "text": "Но я ведь уже в вашем отделе.",
      "emotion": "surprised",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l5",
      "character": "nachalnik",
      "text": "Да знаю я! Вопрос был: какого чёрта вы не работаете?",
      "emotion": "angry",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
