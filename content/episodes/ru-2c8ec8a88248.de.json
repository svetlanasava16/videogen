  "locale": "de",
  "title": "Die Blinker",
  "kind": "joke",
  "v": 2,
  "location": "kukhnya",
  "place": "home-kitchen",
  "cast": [
    "devushka",
    "zhena"
  ],
  "roles": {
    "devushka": "woman",
    "zhena": "wife"
  },
  "lines": [
    {
      "id": "l1",
      "character": "devushka",
      "text": "Warum bist du denn so gereizt? Was ist passiert?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "zhena",
      "text": "Ich habe meinem Mann zum Geburtstag ein Set Angelblinker geschenkt.",
      "emotion": "sad",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "devushka",
      "text": "Na, ist doch genau richtig.",
      "emotion": "neutral",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l3b",
      "character": "devushka",
      "text": "Er fährt doch schon seit zehn Jahren jedes Wochenende zum Angeln.",
      "emotion": "neutral",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l3c",
      "character": "devushka",
      "text": "Was stimmt denn nicht?",
      "emotion": "neutral",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l4",
      "character": "zhena",
      "text": "Er hat es in den Händen gedreht und gedreht und fragt: Was ist das denn?",
      "emotion": "angry",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
