      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "zhena",
      "text": "Ich habe meinem Mann zum Geburtstag ein Set Angelblinker geschenkt.",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "devushka",
      "text": "Na, ist doch genau richtig. Er fährt doch schon seit zehn Jahren jedes Wochenende zum Angeln. Was stimmt denn nicht?",
      "emotion": "neutral",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "zhena",
      "text": "Er hat es in den Händen gedreht und gedreht und fragt: Was ist das denn?",
