  },
  "lines": [
    {
      "id": "l1",
      "character": "muzhik",
      "text": "Herr Doktor, ich flehe Sie an, kommen Sie sofort. Meine Frau hat eine schlimme Blinddarmentzündung!",
      "emotion": "surprised",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "doktor",
      "text": "Keine Sorge. Vor zwei Jahren habe ich Ihre Frau operiert und ihr den Blinddarm entfernt.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "doktor",
      "text": "Ein Mensch kann keinen zweiten Blinddarm bekommen!",
      "emotion": "smug",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "Richtig, Herr Doktor.",
      "emotion": "neutral",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l5",
      "character": "muzhik",
      "text": "Aber ein Mensch kann eine zweite Frau bekommen.",
      "emotion": "neutral",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
