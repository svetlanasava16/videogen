  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein Mercedes und ein Trabi parken nebeneinander. Beide Fahrer steigen aus.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Der Mercedes-Fahrer schielt schräg auf den Trabi und sagt:",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "nachalnik",
      "text": "Hier fahren lauter verdammte Laubenpieper mit ihren billigen Karren rum!",
      "emotion": "angry",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "nachalnik",
      "text": "Am Ende zerkratzen die noch ein richtig cooles Auto!",
      "emotion": "angry",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "Der Trabi-Fahrer nickt zustimmend, spreizt genauso lässig die Finger und antwortet:",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "muzhik",
      "text": "Sag bloß, Bruder! Die sind total dreist geworden!",
      "emotion": "smug",
      "pauseAfterSec": 0.6,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "muzhik",
      "text": "Stell dir vor, gestern ist mir ein Radfahrer voll in die Seite gekracht!",
      "emotion": "angry",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
