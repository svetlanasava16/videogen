{
  "id": "ru-d51ba21d6bfb.en",
  "jokeId": "ru-d51ba21d6bfb",
  "locale": "en",
  "title": "And Now, a Song",
  "location": "doroga",
  "place": "road",
  "cast": [
    "sluzhivy",
    "nachalnik"
  ],
  "roles": {
    "sluzhivy": "traffic-cop",
    "nachalnik": "new-russian"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "The millionaires' highway. A traffic cop pulls over a Bentley doing three times the speed limit.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "The Bentley stops, and the pitch-black tinted window slides down a crack.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "sluzhivy",
      "text": "Officer Peters. License and registration, please.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "narrator",
      "text": "A hand with a hundred-dollar bill comes out of the Bentley.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "sluzhivy",
      "text": "Have a nice day, and please try not to break the law again...",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "Another bill just like it comes out of the window.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "sluzhivy",
      "text": "And be careful, there's another patrol car two blocks down...",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "narrator",
      "text": "Another hundred.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l9",
      "character": "sluzhivy",
      "text": "I work here Tuesdays and Thursdays, from eight a.m. to three p.m. I've memorized your plate, so on those days you can drive in peace...",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l10",
      "character": "narrator",
      "text": "Another hundred-dollar bill.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l11",
      "character": "sluzhivy",
      "text": "Happiness and health to you, smart kids, success in business, and may your dog win every show...",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l12",
      "character": "narrator",
      "text": "Again, a hand with a bill. The officer stands there, lost for a moment, then clears his throat and announces...",
      "emotion": "neutral",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    },
    {
      "id": "l13",
      "character": "sluzhivy",
      "text": "And now, a song!",
      "emotion": "happy",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
