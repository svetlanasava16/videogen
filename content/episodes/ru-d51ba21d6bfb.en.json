{
  "id": "ru-d51ba21d6bfb.en",
  "jokeId": "ru-d51ba21d6bfb",
  "locale": "en",
  "title": "The Song",
  "location": "doroga",
  "place": "road",
  "cast": [
    "sluzhivy",
    "nachalnik"
  ],
  "roles": {
    "sluzhivy": "traffic-cop",
    "nachalnik": "new-russian"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "A traffic cop pulls over a Bentley doing three times the speed limit.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "The pitch-black tinted window rolls down an inch.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "sluzhivy",
      "text": "Officer Peters. License and registration, please.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "narrator",
      "text": "A hand pokes out of the Bentley with a hundred-dollar bill. The officer tucks it into his breast pocket.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "sluzhivy",
      "text": "Have a nice day, and please try not to break the law again...",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "Another bill just like it appears from the window.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "sluzhivy",
      "text": "And be careful, there's another patrol car two blocks down...",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "narrator",
      "text": "Another hundred.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l9",
      "character": "sluzhivy",
      "text": "I work here Tuesdays and Thursdays, from eight a.m. till three p.m.",
      "emotion": "smug",
      "pauseAfterSec": 0.2,
      "enter": [],
      "exit": []
    },
    {
      "id": "l10",
      "character": "sluzhivy",
      "text": "I've memorized your plate. On those days you can drive in peace...",
      "emotion": "smug",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": [],
      "laugh": "chuckle"
    },
    {
      "id": "l11",
      "character": "narrator",
      "text": "Another hundred-dollar bill.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l12",
      "character": "sluzhivy",
      "text": "Happiness and health to you, smart kids, success in business, and may your dog win every show...",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l13",
      "character": "narrator",
      "text": "Again, a hand with a bill. The officer stands there, lost, for a while, then clears his throat...",
      "emotion": "neutral",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    },
    {
      "id": "l14",
      "character": "sluzhivy",
      "text": "And now... a song!",
      "emotion": "happy",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
