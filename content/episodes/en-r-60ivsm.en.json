{
  "id": "en-r-60ivsm.en",
  "jokeId": "en-r-60ivsm",
  "locale": "en",
  "title": "Stop or Slow Down",
  "kind": "joke",
  "v": 2,
  "location": "doroga",
  "place": "road",
  "cast": [
    "nachalnik",
    "sluzhivy"
  ],
  "roles": {
    "nachalnik": "lawyer",
    "sluzhivy": "traffic-cop"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "A lawyer gets pulled over by a police officer.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "sluzhivy",
      "text": "Do you know why I pulled you over?",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "nachalnik",
      "text": "I haven't the foggiest idea.",
      "emotion": "smug",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "sluzhivy",
      "text": "You didn't make a full stop at the stop sign back there. You only slowed down.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l5",
      "character": "nachalnik",
      "text": "If you can prove to me the difference between stopping and slowing down, I'll take full responsibility.",
      "emotion": "smug",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l6",
      "character": "nachalnik",
      "text": "Otherwise, you let me off with a warning. Sound fair?",
      "emotion": "smug",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l7",
      "character": "sluzhivy",
      "text": "Sounds fair. Can you step out of the car please?",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l8",
      "character": "narrator",
      "text": "Just as the lawyer steps out and shuts the car door, the officer pulls out his baton and starts beating the lawyer.",
      "emotion": "neutral",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l9",
      "character": "sluzhivy",
      "text": "Now, would you like me to stop or slow down?",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
