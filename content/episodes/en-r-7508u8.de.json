  "locale": "de",
  "title": "Vom Weihnachtsmann",
  "kind": "joke",
  "v": 2,
  "location": "ulitsa",
  "place": "street",
  "cast": [
    "loshad",
    "sluzhivy",
    "devochka"
  ],
  "roles": {
    "loshad": "horse",
    "sluzhivy": "police-officer",
    "devochka": "child"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein Polizist auf einem Pferd sagt zu einem kleinen Mädchen auf einem Fahrrad:",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "sluzhivy",
      "text": "Hat dir das der Weihnachtsmann gebracht?",
      "emotion": "smug",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "devochka",
      "text": "Ja.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "sluzhivy",
      "text": "Dann sag ihm, er soll nächstes Jahr einen Reflektor dranmachen!",
      "emotion": "smug",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "Und er verpasst ihr fünf Euro Strafe.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l6",
      "character": "devochka",
      "text": "Schönes Pferd haben Sie da. Hat Ihnen das der Weihnachtsmann gebracht?",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l7",
      "character": "sluzhivy",
      "text": "Na klar!",
      "emotion": "happy",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l8",
      "character": "devochka",
      "text": "Dann sagen Sie dem Weihnachtsmann nächstes Jahr,",
      "emotion": "smug",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l8b",
      "character": "devochka",
      "text": "dass der Esel unter den Sattel gehört und nicht obendrauf!",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
