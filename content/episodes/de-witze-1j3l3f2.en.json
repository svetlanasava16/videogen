  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "At the entrance to heaven there are two gates.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "One sign says: for henpecked husbands. The other says: for husbands who were never henpecked.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "The first line stretches for miles. At the second gate stands one single man.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "ded",
      "text": "My son, why are you standing here all alone?",
      "emotion": "surprised",
      "pauseAfterSec": 0.8,
      "enter": [
        "ded"
      ],
      "exit": []
    },
    {
      "id": "l5",
      "character": "muzhik",
      "text": "I'm not really sure. My wife told me to stand here.",
      "emotion": "neutral",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    }
  ],
