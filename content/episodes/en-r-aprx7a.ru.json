{
  "id": "en-r-aprx7a.ru",
  "jokeId": "en-r-aprx7a",
  "locale": "ru",
  "title": "В Техасе всё больше",
  "location": "spalnya",
  "place": "hotel",
  "cast": [
    "muzhik",
    "paren"
  ],
  "roles": {
    "muzhik": "disabled-person",
    "paren": "employee"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Слепой приезжает в Техас. Зайдя в номер отеля, он ощупывает кровать.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "muzhik",
      "text": "Ого, какая большая кровать!",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "paren",
      "text": "В Техасе всё больше.",
      "emotion": "smug",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "narrator",
      "text": "Мужчина спускается в бар, усаживается на огромный барный стул и заказывает пиво. Ему в руки ставят кружку.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "muzhik",
      "text": "Ого, какие тут большие напитки!",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "barmen",
      "text": "В Техасе всё большое.",
      "emotion": "smug",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "narrator",
      "text": "Пропустив несколько кружек, слепой спрашивает, где туалет.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "barmen",
      "text": "Вторая дверь направо.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l9",
      "character": "narrator",
      "text": "Слепой идёт в туалет, но по ошибке заходит в третью дверь, которая ведёт к бассейну, и падает в воду.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l10",
      "character": "narrator",
      "text": "Вынырнув из-под воды и размахивая руками, он кричит:",
      "emotion": "neutral",
      "pauseAfterSec": 0.6,
      "enter": [],
      "exit": []
    },
    {
      "id": "l11",
      "character": "muzhik",
      "text": "Не смывайте, не смывайте!",
      "emotion": "surprised",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
