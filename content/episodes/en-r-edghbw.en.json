      "character": "vovochka",
      "text": "Dad, I've decided to get married.",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "muzhik",
      "text": "Wonderful! Do you have a girl in mind?",
