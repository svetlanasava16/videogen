  "locale": "en",
  "title": "The Wedding Plan",
  "kind": "joke",
  "v": 2,
  "location": "gostinaya",
  "place": "home-living-room",
  "cast": [
    "vovochka",
    "muzhik"
  ],
  "roles": {
    "vovochka": "child",
    "muzhik": "father"
  },
  "lines": [
    {
      "id": "l1",
      "character": "vovochka",
      "text": "Dad, I've decided to get married.",
      "emotion": "happy",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "muzhik",
      "text": "Wonderful! Do you have a girl in mind?!",
      "emotion": "happy",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "vovochka",
      "text": "Yes... grandma!",
      "emotion": "happy",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l3b",
      "character": "vovochka",
      "text": "She said she loves me, I love her,",
      "emotion": "happy",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l3c",
      "character": "vovochka",
      "text": "too... and she's the best cook and storyteller in the whole world!",
      "emotion": "happy",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "That's nice, but we have a small problem there!",
      "emotion": "smug",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "vovochka",
      "text": "What problem?!",
      "emotion": "surprised",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l6",
      "character": "muzhik",
      "text": "She happens to be my mother. How can you marry my mother!",
      "emotion": "surprised",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l7",
      "character": "vovochka",
      "text": "Why not?! You married mine!",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
