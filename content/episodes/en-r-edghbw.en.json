      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "vovochka",
      "text": "Yes! Grandma! She loves me, I love her, and she's the best cook in the whole world!",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "That's nice, but there's a small problem.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "vovochka",
      "text": "What problem?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "muzhik",
      "text": "She's my mother! How can you marry my mother?",
      "emotion": "angry",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "vovochka",
      "text": "Why not? You married mine!",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
