    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein Mann geht im Park spazieren und sieht einen anderen Mann, der neben einem Hund sitzt.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "muzhik",
      "text": "Beißt Ihr Hund?",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "muzhik-sosed",
      "text": "Nein, also mein Hund beißt nicht.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "narrator",
      "text": "Der Mann bückt sich, um den Hund zu streicheln. Sofort beißt der Hund zu und verpasst ihm eine blutende Wunde an der Hand.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "muzhik",
      "text": "Ich dachte, Ihr Hund beißt nicht!",
      "emotion": "angry",
      "pauseAfterSec": 0.6,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "muzhik-sosed",
      "text": "Das ist ja auch nicht mein Hund.",
      "emotion": "neutral",
