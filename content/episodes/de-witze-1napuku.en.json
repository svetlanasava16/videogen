    {
      "id": "l1",
      "character": "narrator",
      "text": "Having reached the mountain, Moses leaves the people waiting at the foot and begins the climb to the Lord to receive the commandments.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "After a week he comes back and stands before the people.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "ded",
      "text": "I've got good news and bad news.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l4",
      "character": "ded",
      "text": "The good news first: I got him down to ten!",
      "emotion": "happy",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l5",
      "character": "ded",
      "text": "The bad news: adultery is still in there!",
