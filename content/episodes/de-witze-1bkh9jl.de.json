{
  "id": "de-witze-1bkh9jl.de",
  "jokeId": "de-witze-1bkh9jl",
  "locale": "de",
  "title": "Fernprost",
  "kind": "joke",
  "v": 2,
  "location": "bar",
  "place": "bar",
  "cast": [
    "muzhik",
    "barmen"
  ],
  "roles": {
    "muzhik": "everyman",
    "barmen": "bartender"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein Mann kommt in die Kneipe und bestellt:",
      "emotion": "neutral",
      "pauseAfterSec": 0.2
    },
    {
      "id": "l2",
      "character": "muzhik",
      "text": "Zwei Bier und zwei Korn.",
      "emotion": "happy",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "Ein paar Tage später das Gleiche.",
      "emotion": "neutral",
      "pauseAfterSec": 0.2
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "Zwei Bier und zwei Korn.",
      "emotion": "happy",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "Nach dem dritten Mal fragt der Wirt:",
      "emotion": "neutral",
      "pauseAfterSec": 0.2
    },
    {
      "id": "l6",
      "character": "barmen",
      "text": "Warum bestellst du alles doppelt?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l7",
      "character": "muzhik",
      "text": "Mein Kumpel und ich haben ein Ritual,",
      "emotion": "smug",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l7b",
      "character": "muzhik",
      "text": "bei dem wir für den anderen mittrinken, wenn wir allein unterwegs sind.",
      "emotion": "smug",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l8",
      "character": "narrator",
      "text": "Das geht eine Weile so weiter. Eines Tages bestellt er nur:",
      "emotion": "neutral",
      "pauseAfterSec": 0.2
    },
    {
      "id": "l9",
      "character": "muzhik",
      "text": "Ein Bier und ein Korn.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l10",
      "character": "barmen",
      "text": "Was ist passiert, ist dein Kumpel verstorben?",
      "emotion": "sad",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l11",
      "character": "muzhik",
      "text": "Ne, aber ich habe aufgehört zu trinken.",
      "emotion": "happy",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
