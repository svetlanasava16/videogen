{
  "id": "en-r-c0qpyb.de",
  "jokeId": "en-r-c0qpyb",
  "locale": "de",
  "title": "Hast du heute Abend Zeit?",
  "kind": "joke",
  "v": 2,
  "location": "gostinaya",
  "place": "front-door",
  "cast": [
    "muzhik",
    "devushka",
    "pyos"
  ],
  "roles": {
    "muzhik": "everyman",
    "devushka": "woman",
    "pyos": "dog"
  },
  "lines": [
    {
      "id": "l1",
      "character": "muzhik",
      "text": "Meine Nachbarin. Sie ist Single. Sie hat eine tolle Figur, ist wunderschön und wohnt direkt gegenüber.",
      "emotion": "happy",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "muzhik",
      "text": "Ich habe sie heute Abend beobachtet, als sie von der Arbeit nach Hause kam.",
      "emotion": "smug",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "muzhik",
      "text": "Ich war überrascht, als sie über die Straße kam, meine Einfahrt hoch, und an meine Tür klopfte.",
      "emotion": "surprised",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "devushka",
      "text": "Ich bin gerade nach Hause gekommen und habe große Lust, heute Abend Spaß zu haben, mich zu betrinken und richtig zu feiern. Hast du was vor?",
      "emotion": "happy",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "muzhik",
      "text": "Nö, ich bin frei!",
      "emotion": "happy",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l6",
      "character": "devushka",
      "text": "Super. Kannst du auf meinen Hund aufpassen?",
      "emotion": "happy",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
