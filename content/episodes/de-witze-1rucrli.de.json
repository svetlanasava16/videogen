  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Die Mutter gibt ihrer Tochter, die gerade geheiratet hat, einige Tipps zum Haushalt.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "zhena",
      "text": "Also ich habe zum Beispiel auf den Handtüchern im Bad immer ein A für Antlitz und ein G für Gesäß stehen.",
      "emotion": "smug",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "zhena",
      "text": "So verwechsle ich die Handtücher nicht.",
      "emotion": "happy",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "Wie jetzt?! Ich dachte immer, es heißt Arsch und Gesicht.",
      "emotion": "surprised",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
