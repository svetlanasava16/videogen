  "lines": [
    {
      "id": "l1",
      "character": "uchilka",
      "text": "Wie möchtest du einmal sterben?",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "vovochka",
      "text": "So wie mein Opa.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "uchilka",
      "text": "Wie ist dein Opa denn gestorben?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "vovochka",
      "text": "Er ist eingeschlafen.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "uchilka",
      "text": "Ja, das ist ein schöner Tod, so würde ich auch sterben wollen.",
      "emotion": "happy",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l6",
      "character": "uchilka",
      "text": "Und wie würdest du nicht sterben wollen?",
      "emotion": "neutral",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l7",
      "character": "vovochka",
      "text": "So wie die zwei, die mit Opa mitgefahren sind.",
      "emotion": "sad",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
