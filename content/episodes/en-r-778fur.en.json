{
  "id": "en-r-778fur.en",
  "jokeId": "en-r-778fur",
  "locale": "en",
  "title": "The Inheritance",
  "kind": "joke",
  "v": 2,
  "location": "gostinaya",
  "place": "office",
  "cast": [
    "muzhik",
    "doktor"
  ],
  "roles": {
    "muzhik": "everyman",
    "doktor": "scientist"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "One day a man hears that a distant uncle passed away.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "He's a little sad, but only a little, for they barely knew each other.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "A few days later, a package arrives with his inheritance: a violin and a painting.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "narrator",
      "text": "He has no idea what to do with them, so he takes them to an appraiser.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "Not too long later the appraiser calls him.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l6",
      "character": "doktor",
      "text": "I've finished my analysis, and I've got some good news.",
      "emotion": "happy",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l7",
      "character": "doktor",
      "text": "There's no doubt at all that what you have is a genuine Van Gogh and a genuine Stradivarius.",
      "emotion": "smug",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l8",
      "character": "muzhik",
      "text": "I can sell these for millions!",
      "emotion": "happy",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l9",
      "character": "doktor",
      "text": "Well, you can sell them, and they'll fetch some money for their novelty value.",
      "emotion": "neutral",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l9b",
      "character": "doktor",
      "text": "But not millions.",
      "emotion": "neutral",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l10",
      "character": "doktor",
      "text": "You see, the truth is, Stradivarius wasn't much of a painter... and Van Gogh made lousy violins.",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
