  "lines": [
    {
      "id": "l1",
      "character": "devushka",
      "text": "Why are you so wound up? What happened?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "zhena",
      "text": "I gave my husband a set of fishing lures for his birthday.",
      "emotion": "sad",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "devushka",
      "text": "Well, that makes sense. He's been going fishing every weekend for ten years now. So what's wrong?",
      "emotion": "neutral",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l4",
      "character": "zhena",
      "text": "He turned it over and over in his hands and asked: what is this?",
      "emotion": "angry",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
