  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein älteres Ehepaar, das schon die Silberhochzeit gefeiert hat und lange zusammenlebt, sitzt morgens am Tisch und frühstückt.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Die Frau sieht ihren Mann lange an und fragt:",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "zhena",
      "text": "Horst, bitte, sag mir: Liebst du mich noch?",
      "emotion": "sad",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "narrator",
      "text": "Der Mann wirft gereizt die Gabel auf den Tisch.",
      "emotion": "angry",
      "pauseAfterSec": 0.6,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "muzhik",
      "text": "Gabi, jetzt erklär mir mal: Wozu zum Geier jeden Morgen mit einem Streit anfangen?",
      "uncensored": "Gabi, jetzt erklär mir mal: Wozu zum Teufel jeden Morgen mit einem Streit anfangen?",
      "emotion": "angry",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
