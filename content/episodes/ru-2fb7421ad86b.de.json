  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein älteres Ehepaar, das schon Silberhochzeit gefeiert hat und ewig zusammenlebt, sitzt morgens am Tisch beim Frühstück.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Die Frau sieht ihren Mann lange an und fragt.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "zhena",
      "text": "Horst, bitte sag mir, liebst du mich noch?",
      "emotion": "sad",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "narrator",
      "text": "Der Mann knallt gereizt die Gabel auf den Tisch.",
      "emotion": "neutral",
      "pauseAfterSec": 0.7,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "muzhik",
      "text": "Gabi, jetzt erklär mir mal, warum, verdammt noch mal, muss jeder Morgen mit Krach anfangen?",
      "emotion": "angry",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
