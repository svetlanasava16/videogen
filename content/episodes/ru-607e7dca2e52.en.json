  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Somebody kept stealing a farmer's watermelons, so in the end he put up a sign in the melon patch.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "muzhik-ryzhy",
      "text": "Warning! One of these watermelons contains rat poison!",
      "emotion": "smug",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "The next day he saw that nothing had been stolen, but someone had added a line to the sign.",
      "emotion": "neutral",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l4",
      "character": "muzhik-ryzhy",
      "text": "Now there are two!",
      "emotion": "surprised",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
