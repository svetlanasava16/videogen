  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Ночью вор забирается в тёмный дом.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "ptitsa",
      "text": "Я тебя вижу! И Иисус тебя тоже видит!",
      "emotion": "smug",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l3",
      "character": "vor",
      "text": "Фух, ну и напугал ты меня, малыш!",
      "emotion": "surprised",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "vor",
      "text": "Как тебя зовут?",
      "emotion": "happy",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "ptitsa",
      "text": "Геннадий.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l6",
      "character": "vor",
      "text": "Геннадий? Странное имя для попугая.",
      "emotion": "smug",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l7",
      "character": "ptitsa",
      "text": "Иисус тоже странная кличка для ротвейлера.",
      "emotion": "smug",
      "pauseAfterSec": 0.8
    }
  ],
