{
  "id": "ru-095e7c23ed09.de",
  "jokeId": "ru-095e7c23ed09",
  "locale": "de",
  "title": "Der Bart",
  "kind": "joke",
  "v": 2,
  "location": "klass",
  "place": "university",
  "cast": [
    "paren",
    "doktor"
  ],
  "roles": {
    "paren": "student",
    "doktor": "professor"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Durch den Flur der Uni geht ein Professor.",
      "emotion": "neutral",
      "pauseAfterSec": 0
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Ihm entgegen kommt ein Student:",
      "emotion": "neutral",
      "pauseAfterSec": 0
    },
    {
      "id": "l3",
      "character": "paren",
      "text": "Guten Tag, Herr Professor. Darf ich Sie etwas fragen?",
      "emotion": "happy",
      "pauseAfterSec": 0
    },
    {
      "id": "l4",
      "character": "doktor",
      "text": "Natürlich, fragen Sie nur, junger Mann.",
      "emotion": "smug",
      "pauseAfterSec": 0
    },
    {
      "id": "l5",
      "character": "paren",
      "text": "Sagen Sie, Herr Professor, wenn Sie schlafen gehen, legen Sie den Bart auf die Decke oder unter die Decke?",
      "emotion": "neutral",
      "pauseAfterSec": 0
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "Nach einer gewissen Pause:",
      "emotion": "neutral",
      "pauseAfterSec": 0
    },
    {
      "id": "l7",
      "character": "doktor",
      "text": "Wissen Sie, darüber habe ich nie nachgedacht.",
      "emotion": "surprised",
      "pauseAfterSec": 0
    },
    {
      "id": "l8",
      "character": "paren",
      "text": "Na, dann entschuldigen Sie bitte.",
      "emotion": "neutral",
      "pauseAfterSec": 0
    },
    {
      "id": "l9",
      "character": "narrator",
      "text": "Sie gingen auseinander.",
      "emotion": "neutral",
      "pauseAfterSec": 0
    },
    {
      "id": "l10",
      "character": "narrator",
      "text": "Eine Woche später begegnet der Professor, ganz grün im Gesicht und mit Ringen unter den Augen,",
      "emotion": "neutral",
      "pauseAfterSec": 0
    },
    {
      "id": "l11",
      "character": "narrator",
      "text": "im Flur demselben Studenten und packt ihn am Kragen:",
      "emotion": "neutral",
      "pauseAfterSec": 0
    },
    {
      "id": "l12",
      "character": "doktor",
      "text": "Du Mistkerl!",
      "emotion": "angry",
      "pauseAfterSec": 0
    },
    {
      "id": "l13",
      "character": "doktor",
      "text": "Seit einer Woche kann ich nicht schlafen — so ist es unbequem, und so ist es unbequem!",
      "emotion": "angry",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
