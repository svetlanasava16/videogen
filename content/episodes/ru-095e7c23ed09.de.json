  "lines": [
    {
      "id": "l1",
      "character": "paren",
      "text": "Guten Tag, Herr Professor! Darf ich Sie etwas fragen?",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [
        "paren"
      ],
      "exit": []
    },
    {
      "id": "l2",
      "character": "doktor",
      "text": "Natürlich, junger Mann.",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "paren",
      "text": "Wenn Sie schlafen gehen, legen Sie den Bart auf die Decke oder unter die Decke?",
      "emotion": "neutral",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "doktor",
      "text": "Hm. Wissen Sie, darüber habe ich nie nachgedacht.",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "paren",
      "text": "Entschuldigen Sie bitte.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": [
        "paren"
      ]
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "Eine Woche später. Der Professor ist blass, mit dunklen Ringen unter den Augen.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [
        "paren"
      ],
      "exit": []
    },
    {
      "id": "l7",
      "character": "doktor",
      "text": "Du Mistkerl!",
      "emotion": "angry",
      "pauseAfterSec": 0.6,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "doktor",
      "text": "Ich kann seit einer Woche nicht schlafen! Auf der Decke ist es unbequem, unter der Decke ist es unbequem!",
      "emotion": "angry",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    }
  ],
