{
  "id": "ru-095e7c23ed09.de",
  "jokeId": "ru-095e7c23ed09",
  "locale": "de",
  "title": "Der Bart",
  "location": "klass",
  "place": "university",
  "cast": [
    "doktor",
    "paren"
  ],
  "roles": {
    "doktor": "professor",
    "paren": "student"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein Professor geht den Flur der Universität entlang. Ihm kommt ein Student entgegen.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "paren",
      "text": "Guten Tag, Herr Professor. Darf ich Sie etwas fragen?",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "doktor",
      "text": "Natürlich, fragen Sie nur, junger Mann.",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "paren",
      "text": "Sagen Sie, Herr Professor, wenn Sie schlafen gehen, legen Sie den Bart auf die Bettdecke oder unter die Bettdecke?",
      "emotion": "neutral",
      "pauseAfterSec": 1,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "doktor",
      "text": "Wissen Sie, darüber habe ich nie nachgedacht.",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "paren",
      "text": "Oh, dann entschuldigen Sie bitte.",
      "emotion": "happy",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "narrator",
      "text": "Eine Woche später trifft der Professor, grün im Gesicht und mit Ringen unter den Augen, denselben Studenten im Flur und packt ihn am Kragen.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "doktor",
      "text": "Du Mistkerl!",
      "emotion": "angry",
      "pauseAfterSec": 0.6,
      "enter": [],
      "exit": []
    },
    {
      "id": "l9",
      "character": "doktor",
      "text": "Seit einer Woche kann ich nicht schlafen! So ist es unbequem, und so ist es auch unbequem!",
      "emotion": "angry",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
