  "lines": [
    {
      "id": "l1",
      "character": "muzhik",
      "text": "Моего брата здорово подкосило, когда ему пришлось сесть в тюрьму.",
      "emotion": "sad",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "muzhik",
      "text": "Он совершенно взбесился, отказывался и от еды, и от питья.",
      "emotion": "sad",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "muzhik",
      "text": "Начал плеваться и мазать стену собственными фекалиями.",
      "emotion": "surprised",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "С тех пор мы больше не играем в Монополию.",
      "emotion": "neutral",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
