{
  "id": "ru-34a2629b202c.de",
  "jokeId": "ru-34a2629b202c",
  "locale": "de",
  "title": "Der Start",
  "kind": "joke",
  "v": 2,
  "location": "ofis",
  "place": "office",
  "cast": [
    "paren",
    "ded",
    "muzhik-ryzhy"
  ],
  "roles": {
    "paren": "engineer",
    "ded": "engineer",
    "muzhik-ryzhy": "engineer"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein Weltraumbahnhof. Der erste Start einer neuen Rakete wird vorbereitet.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Im Kontrollzentrum sitzen Vertreter der verschiedenen Firmen, die an der Rakete mitgebaut haben.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "Eine der Firmen vertreten ein junger Fachmann und sein erfahrener Mentor.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "narrator",
      "text": "Der Countdown beginnt: zehn, neun...",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "paren",
      "text": "Warum sagen Sie denn nichts? Wir haben jede Menge Mängel, die Rakete hebt nicht ab!",
      "emotion": "surprised",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l6",
      "character": "ded",
      "text": "Sitz still und halt den Mund!",
      "emotion": "angry",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l7",
      "character": "narrator",
      "text": "Sieben, sechs...",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l8",
      "character": "paren",
      "text": "Gleich explodiert sie, ich melde es selbst!",
      "emotion": "angry",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l9",
      "character": "ded",
      "text": "Vertrau meiner Erfahrung, sitz still und halt den Mund.",
      "emotion": "smug",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l10",
      "character": "narrator",
      "text": "Vier, drei...",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l11",
      "character": "narrator",
      "text": "Da springt ein Vertreter einer anderen Firma auf und schreit:",
      "emotion": "neutral",
      "pauseAfterSec": 0.2
    },
    {
      "id": "l12",
      "character": "muzhik-ryzhy",
      "text": "Stoppt den Start, bei uns gibt es Mängel!",
      "emotion": "angry",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l13",
      "character": "ded",
      "text": "Siehst du, durch ihre Schuld ist der Raketenstart geplatzt.",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
