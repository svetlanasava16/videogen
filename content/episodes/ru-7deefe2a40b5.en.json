  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "A nature lesson in first grade.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "uchilka",
      "text": "Children, how do animals talk? Come on, Lily, tell us.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "devochka",
      "text": "The cow goes moooo.",
      "emotion": "happy",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "uchilka",
      "text": "Clever girl, Lily, sit down, A plus. And what do you say, Kevin?",
      "emotion": "happy",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "paren",
      "text": "Doggies go woof-woof.",
      "emotion": "happy",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l6",
      "character": "uchilka",
      "text": "Well done, Kevin, A plus.",
      "emotion": "happy",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l7",
      "character": "narrator",
      "text": "Johnny is stretching his hand up so hard he nearly falls off his chair.",
      "emotion": "neutral",
      "pauseAfterSec": 0.2
    },
    {
      "id": "l8",
      "character": "vovochka",
      "text": "Ms. Smith, Ms. Smith, I know how polar bears talk!",
      "emotion": "happy",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l9",
      "character": "uchilka",
      "text": "Well, and how do polar bears talk?",
      "emotion": "surprised",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l10",
      "character": "vovochka",
      "text": "Oh crap, the water's so co-o-old!",
      "uncensored": "Oh shit, the water's so co-o-old!",
      "emotion": "surprised",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
