  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Auf der Firmenfeier sagt einer aus der Führungsriege zu einem Angestellten:",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "nachalnik",
      "text": "Ich höre, dass Sie sehr talentiert sind?",
      "emotion": "smug",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "nachalnik",
      "text": "Warum arbeiten Sie nicht in meiner Abteilung?",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "paren",
      "text": "Aber ich bin doch bereits in Ihrer Abteilung.",
      "emotion": "surprised",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l5",
      "character": "nachalnik",
      "text": "Das weiß ich doch! Die Frage war: Warum zur Hölle arbeiten Sie nicht?",
      "emotion": "angry",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
