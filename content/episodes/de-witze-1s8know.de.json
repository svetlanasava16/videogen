      "id": "l1",
      "character": "narrator",
      "text": "Drei Jungs sitzen auf der Mauer und prahlen mit ihren Vätern.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "vovochka-drug",
      "text": "Mein Vater ist Formel-Eins-Fahrer. Der ist so schnell, wenn der auf das Gas tritt, brennt der Asphalt!",
      "emotion": "happy",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l3",
      "character": "paren",
      "text": "Pah, mein Vater ist Jet-Pilot. Der ist so schnell, der überholt seinen eigenen Schall!",
      "emotion": "smug",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l4",
      "character": "vovochka",
      "text": "Alles Anfänger. Mein Vater ist Beamter.",
      "emotion": "neutral",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l5",
      "character": "vovochka",
      "text": "Der hat zwar bis siebzehn Uhr Dienst, aber zu Hause ist er schon um sechzehn Uhr.",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
