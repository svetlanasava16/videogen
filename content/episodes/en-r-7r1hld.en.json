  "lines": [
    {
      "id": "l1",
      "character": "muzhik",
      "text": "My attractive female neighbor is completely paranoid.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "muzhik",
      "text": "She thinks I'm following or even stalking her,",
      "emotion": "surprised",
      "pauseAfterSec": 0.2
    },
    {
      "id": "l3",
      "character": "muzhik",
      "text": "she is worried that I may be obsessed with her",
      "emotion": "sad",
      "pauseAfterSec": 0.2
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "and any time she hears a noise in her house she is... purified?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "muzhik",
      "text": "Oh, wait: petrified.",
      "emotion": "happy",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l6",
      "character": "muzhik",
      "text": "Sorry, it's not easy reading a diary through binoculars from a tree.",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
