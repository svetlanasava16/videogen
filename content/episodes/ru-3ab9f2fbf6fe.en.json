      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "His wife and two kids run out of the room in horror.",
      "emotion": "neutral",
      "pauseAfterSec": 0.7,
