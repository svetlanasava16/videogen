    {
      "id": "l1",
      "character": "narrator",
      "text": "Посреди ночи сантехника вызывают в дом к врачу: прорвало трубу, подвал затопило.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Сантехник едет, спускается в подвал, который и правда уже наполовину залит водой.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [
        "barmen"
      ],
      "exit": []
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "Он смотрит налево, смотрит направо, потом бросает в воду три прокладки и говорит врачу:",
      "emotion": "neutral",
      "pauseAfterSec": 0.6,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "barmen",
      "text": "Если к утру лучше не станет, позвоните ещё раз.",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
