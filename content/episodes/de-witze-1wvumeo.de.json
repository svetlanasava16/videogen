{
  "id": "de-witze-1wvumeo.de",
  "jokeId": "de-witze-1wvumeo",
  "locale": "de",
  "title": "Wie Mutter",
  "location": "bar",
  "place": "bar",
  "cast": [
    "muzhik",
    "muzhik-sosed"
  ],
  "roles": {
    "muzhik": "everyman",
    "muzhik-sosed": "friend"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Andi ist neununddreißig Jahre alt und im Unterschied zu seinen Freunden noch immer nicht unter der Haube.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "muzhik-sosed",
      "text": "Woran liegt das?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "muzhik",
      "text": "Nun, wann immer ich eine Frau mit nach Hause bringe, kann sie meine Mutter nicht leiden.",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "muzhik-sosed",
      "text": "Weshalb probierst du es nicht mal mit einer Frau, die wie deine Mutter ist?",
      "emotion": "smug",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "Drei Wochen später treffen sie sich wieder.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "muzhik-sosed",
      "text": "Gab es Fortschritte?",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "muzhik",
      "text": "Ja, ich habe eine Frau kennengelernt, die wie meine Mutter ist, und ich habe sie mit nach Hause gebracht, und sie haben sich verstanden.",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "muzhik-sosed",
      "text": "Und ihr seid also zusammen?",
      "emotion": "happy",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    },
    {
      "id": "l9",
      "character": "muzhik",
      "text": "Nein, mein Vater kann sie nicht ausstehen.",
      "emotion": "sad",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
  "explicit": false,
  "outroLaughs": [],
