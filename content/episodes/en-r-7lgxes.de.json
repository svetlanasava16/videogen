      "character": "muzhik",
      "text": "Ich habe eine hübsche, junge Obdachlose gefragt,",
      "emotion": "smug",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l1b",
      "character": "muzhik",
      "text": "ob ich sie mit nach Hause nehmen darf.",
      "emotion": "smug",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "devushka",
      "text": "Ja!",
      "emotion": "happy",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l3",
      "character": "muzhik",
      "text": "Ihr Gesicht änderte sich schnell,",
      "emotion": "smug",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l3b",
      "character": "muzhik",
      "text": "als ich ihr Zuhause mitgenommen habe, ihren Pappkarton.",
      "emotion": "smug",
