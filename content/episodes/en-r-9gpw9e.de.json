    {
      "id": "l1",
      "character": "muzhik",
      "text": "Herr Doktor, ich habe eins von diesen Silikagel-Tütchen gegessen,",
      "emotion": "surprised",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l1b",
      "character": "muzhik",
      "text": "auf denen „Nicht essen“ steht.",
      "emotion": "surprised",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "muzhik",
      "text": "Werde ich jetzt sterben?",
      "emotion": "sad",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "doktor",
      "text": "Na ja, sterben werden wir alle irgendwann.",
      "emotion": "neutral",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "Alle?! Ach du Mist, was hab ich getan?",
      "uncensored": "Alle?! Ach du Scheiße, was hab ich getan?",
