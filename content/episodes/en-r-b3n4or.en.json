  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Two blind pilots enter a plane.",
      "emotion": "neutral",
      "pauseAfterSec": 0
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "They have sunglasses and white sticks.",
      "emotion": "neutral",
      "pauseAfterSec": 0
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "As the plane starts to move, the passengers are uncomfortable.",
      "emotion": "neutral",
      "pauseAfterSec": 0
    },
    {
      "id": "l4",
      "character": "narrator",
      "text": "The plane gains speed, but it stays on the ground.",
      "emotion": "neutral",
      "pauseAfterSec": 0
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "The remaining runway gets smaller and smaller, and the plane is rushing towards a fence.",
      "emotion": "neutral",
      "pauseAfterSec": 0
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "The passengers start shrieking",
      "emotion": "neutral",
      "pauseAfterSec": 0
    },
    {
      "id": "l7",
      "character": "narrator",
      "text": "and suddenly the plane lifts, avoiding the fence at the last second.",
      "emotion": "neutral",
      "pauseAfterSec": 0
    },
    {
      "id": "l8",
      "character": "narrator",
      "text": "All the passengers calm down, thinking it was a bad joke.",
      "emotion": "neutral",
      "pauseAfterSec": 0
    },
    {
      "id": "l9",
      "character": "narrator",
      "text": "In the pilot cabin, the co-pilot turns to the pilot and says:",
      "emotion": "neutral",
      "pauseAfterSec": 0
    },
    {
      "id": "l10",
      "character": "sluzhivy-ryadovoy",
      "text": "You know what? One day they're going to scream too late, and we're all going to die.",
      "emotion": "neutral",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
