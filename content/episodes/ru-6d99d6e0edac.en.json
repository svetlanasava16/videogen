  },
  "lines": [
    {
      "id": "l1",
      "character": "muzhik",
      "text": "Does your bank give loans on a word of honor?",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "nachalnik",
      "text": "No problem...",
      "emotion": "smug",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "muzhik",
      "text": "And what if I don't pay it back?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "nachalnik",
      "text": "You'll be ashamed before the Almighty when you meet Him.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "muzhik",
      "text": "That won't be for a long while...",
      "emotion": "happy",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l6",
      "character": "nachalnik",
      "text": "Well, if you don't pay it back on the fifth, you'll meet Him on the sixth.",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
