  "roles": {
    "uchilka": "clerk",
    "zhena": "wife",
    "doktor": "therapist"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Фрау Мюллер изменила мужу после десяти лет брака.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Эта ошибка её очень мучает, и она хочет, чтобы гипнотизёр стёр ей это воспоминание.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "В приёмной она объясняет администратору свои причины.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "zhena",
      "text": "Я всего один раз за десять лет совершила ошибку.",
      "emotion": "sad",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "zhena",
      "text": "Я не хочу, чтобы она разрушила мне всю жизнь.",
      "emotion": "sad",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "Вдруг в комнату входит гипнотизёр.",
      "emotion": "neutral",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l7",
      "character": "doktor",
      "text": "О, фрау Мюллер! Опять вы?!",
      "emotion": "surprised",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
