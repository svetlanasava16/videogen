{
  "id": "de-witze-1qeyycq.de",
  "jokeId": "de-witze-1qeyycq",
  "locale": "de",
  "title": "Die gute Tat",
  "kind": "joke",
  "v": 2,
  "location": "nebesa",
  "place": "heaven",
  "cast": [
    "ded",
    "paren"
  ],
  "roles": {
    "ded": "saint-peter",
    "paren": "everyman"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein junger Mann steht vor der Himmelspforte.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "ded",
      "text": "Hast du denn eine gute Tat vorzuweisen, die dich zur Aufnahme ins Himmelreich berechtigen würde?",
      "emotion": "neutral",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l3",
      "character": "paren",
      "text": "Ich habe zwei hübschen Damen geholfen, die von einer Rockergang belästigt wurden!",
      "emotion": "happy",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "ded",
      "text": "Und wie genau hast du das bewerkstelligt?",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "paren",
      "text": "Na, ich habe mich mutig vor sie gestellt und den Rockern klar gemacht, dass ich das nicht zulassen werde!",
      "emotion": "smug",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l6",
      "character": "ded",
      "text": "Und wann soll das gewesen sein?",
      "emotion": "surprised",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l7",
      "character": "paren",
      "text": "Vor ungefähr drei Minuten.",
      "emotion": "sad",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
  "explicit": false,
