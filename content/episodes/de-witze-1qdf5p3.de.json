      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "Aber doch nicht auf meinem Schnitzel! Stecken Sie ihn sich doch in den Hintern!",
      "emotion": "angry",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "barmen",
      "text": "Mache ich ja meistens. Aber zwischendurch muss ich auch mal servieren.",
      "emotion": "neutral",
