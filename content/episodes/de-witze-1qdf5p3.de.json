      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "barmen",
      "text": "Verzeihung. Ich habe eine Fistel am Daumen, und der Arzt sagt, ich soll ihn warm halten.",
