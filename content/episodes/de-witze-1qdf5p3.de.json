  "locale": "de",
  "title": "Im Restaurant",
  "kind": "joke",
  "v": 2,
  "location": "bar",
  "place": "restaurant",
  "cast": [
    "muzhik",
    "barmen"
  ],
  "roles": {
    "muzhik": "customer",
    "barmen": "waiter"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Im Restaurant serviert der Kellner dem Gast sein Schnitzel,",
      "emotion": "neutral",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l1b",
      "character": "narrator",
      "text": "und der Gast sieht, dass der Kellner seinen Daumen auf dem Schnitzel liegen hat.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "muzhik",
      "text": "Entschuldigung, aber was hat denn Ihr Daumen auf meinem Schnitzel zu suchen?",
      "emotion": "angry",
      "pauseAfterSec": 0.2
    },
    {
      "id": "l3",
      "character": "muzhik",
      "text": "Schon mal was von Hygiene gehört?",
      "emotion": "angry",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "barmen",
      "text": "Ja, tut mir leid, aber ich hab da eine Fistel am Daumen,",
      "emotion": "sad",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l4b",
      "character": "barmen",
      "text": "und der Arzt hat gesagt, ich soll ihn wenn möglich warm halten!",
      "emotion": "sad",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "muzhik",
      "text": "Aber doch nicht auf meinem Schnitzel,",
      "uncensored": "Aber doch nicht auf meinem Schnitzel,",
      "emotion": "angry",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l5b",
      "character": "muzhik",
      "text": "stecken Sie sich den Daumen von mir aus in den Hintern!",
      "uncensored": "stecken Sie sich den Daumen von mir aus in den Arsch!",
      "emotion": "angry",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l6",
      "character": "barmen",
      "text": "Das mache ich ja auch meistens, aber ich muss ja zwischendurch auch noch servieren!",
      "emotion": "neutral",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
