  "lines": [
    {
      "id": "l1",
      "character": "devushka",
      "text": "Ну как твой экзамен по вождению?",
      "emotion": "happy",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "devushka-blondinka",
      "text": "Ой, даже не спрашивай, я завалила!",
      "emotion": "sad",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "devushka",
      "text": "Ой-ой, а почему?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "devushka-blondinka",
      "text": "Ну, там было круговое движение со знаком тридцать, вот я и проехала по кругу тридцать раз.",
      "emotion": "sad",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l5",
      "character": "devushka",
      "text": "Только не говори, что ты сбилась со счёта!",
      "emotion": "surprised",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
