  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "In einer Firma, mitten am Arbeitstag, ertönen wilde Schreie, Typen in Tarnanzügen und Masken stürmen herein.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Alle kriegen Panik, da ein Schrei:",
      "emotion": "neutral",
      "pauseAfterSec": 0.2
    },
    {
      "id": "l3",
      "character": "vor",
      "text": "Hinlegen, das ist ein Überfall!",
      "emotion": "angry",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l4",
      "character": "narrator",
      "text": "Der Hauptbuchhalter, während er sich auf den Boden legt:",
      "emotion": "neutral",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l5",
      "character": "muzhik-sosed",
      "text": "Habt ihr mich erschreckt, ihr Mistkerle, ich dachte schon, das ist die Steuerfahndung...",
      "emotion": "happy",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
  "explicit": false,
