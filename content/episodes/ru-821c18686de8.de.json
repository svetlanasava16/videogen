  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein Trauerzug zieht die Straße entlang. Ihm entgegen kommt ein betrunkener Mann.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "muzhik",
      "text": "Ste-e-effen! Alter Schulkame-e-erad, lange nicht gesehen!",
      "emotion": "happy",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "muzhik-ryzhy",
      "text": "Hör mal, entschuldige, ich trauere gerade — meine Frau ist gestorben.",
      "emotion": "sad",
      "pauseAfterSec": 0.6,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "Du hast geheiratet?! Glückwunsch!",
      "emotion": "happy",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
