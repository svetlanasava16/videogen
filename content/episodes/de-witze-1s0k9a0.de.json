  ],
  "roles": {
    "devushka-blondinka": "blonde",
    "devushka": "blonde"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Zwei Blondinen stehen auf einer Brücke.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "devushka-blondinka",
      "text": "Das ist der Rhein!",
      "emotion": "smug",
      "pauseAfterSec": 0.2
    },
    {
      "id": "l3",
      "character": "devushka",
      "text": "So ein Unsinn, das ist die Donau!",
      "emotion": "angry",
      "pauseAfterSec": 0.2
    },
    {
      "id": "l4",
      "character": "devushka-blondinka",
      "text": "Rhein!",
      "emotion": "angry",
      "pauseAfterSec": 0.2
    },
    {
      "id": "l5",
      "character": "devushka",
      "text": "Donau!",
      "emotion": "angry",
      "pauseAfterSec": 0.2
    },
    {
      "id": "l6",
      "character": "devushka-blondinka",
      "text": "Rhein!",
      "emotion": "angry",
      "pauseAfterSec": 0.2
    },
    {
      "id": "l7",
      "character": "devushka",
      "text": "Donau!",
      "emotion": "angry",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l8",
      "character": "narrator",
      "text": "Nach einiger Zeit harten Wortgefechts meint die eine:",
      "emotion": "neutral",
      "pauseAfterSec": 0.2
    },
    {
      "id": "l9",
      "character": "devushka-blondinka",
      "text": "Ich gehe jetzt runter und frag mal nach.",
      "emotion": "smug",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l10",
      "character": "narrator",
      "text": "Zehn Minuten später kommt sie total zerzaust zurück – abgeschrammte Klamotten, Knochenbrüche, Platzwunden.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l11",
      "character": "devushka",
      "text": "Und? Rhein oder Donau?",
      "emotion": "surprised",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l12",
      "character": "devushka-blondinka",
      "text": "Die A-Zwei!",
      "emotion": "sad",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
