{
  "id": "en-r-b3n4or.de",
  "jokeId": "en-r-b3n4or",
  "locale": "de",
  "title": "Blinde Piloten",
  "location": "samolet",
  "place": "plane",
  "cast": [
    "muzhik",
    "sluzhivy",
    "sluzhivy-ryadovoy"
  ],
  "roles": {
    "muzhik": "customer",
    "sluzhivy": "pilot",
    "sluzhivy-ryadovoy": "pilot"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Zwei blinde Piloten betreten ein Flugzeug.",
      "emotion": "neutral",
      "pauseAfterSec": 0,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Sie haben Sonnenbrillen und weiße Stöcke.",
      "emotion": "neutral",
      "pauseAfterSec": 0,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "Als das Flugzeug losrollt, fühlen sich die Passagiere unwohl.",
      "emotion": "neutral",
      "pauseAfterSec": 0,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "narrator",
      "text": "Das Flugzeug wird schneller, aber es bleibt am Boden.",
      "emotion": "neutral",
      "pauseAfterSec": 0,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "Die restliche Startbahn wird immer kürzer, und das Flugzeug rast auf einen Zaun zu.",
      "emotion": "neutral",
      "pauseAfterSec": 0,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "Die Passagiere fangen an zu kreischen,",
      "emotion": "neutral",
      "pauseAfterSec": 0,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "narrator",
      "text": "und plötzlich hebt das Flugzeug ab und verfehlt den Zaun in letzter Sekunde.",
      "emotion": "neutral",
      "pauseAfterSec": 0,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "narrator",
      "text": "Alle Passagiere beruhigen sich und denken, es war ein schlechter Scherz.",
      "emotion": "neutral",
      "pauseAfterSec": 0,
      "enter": [],
      "exit": []
    },
    {
      "id": "l9",
      "character": "narrator",
      "text": "Im Cockpit dreht sich der Copilot zum Piloten um und sagt:",
      "emotion": "neutral",
      "pauseAfterSec": 0,
      "enter": [],
      "exit": []
    },
    {
      "id": "l10",
      "character": "sluzhivy-ryadovoy",
      "text": "Weißt du was? Eines Tages werden sie zu spät schreien, und wir werden alle sterben.",
      "emotion": "neutral",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
