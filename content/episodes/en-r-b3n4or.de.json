  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Zwei Piloten steigen ins Flugzeug. Beide mit dunkler Brille und weißem Blindenstock.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "muzhik",
      "text": "Moment mal. Sind das etwa unsere Piloten?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "Die Maschine rast über die Startbahn, hebt aber nicht ab. Der Zaun kommt immer näher.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "Der Zaun! Der Zaun! Hochziehen!",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "In letzter Sekunde hebt die Maschine ab. Und im Cockpit...",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "sluzhivy",
      "text": "Puh. Wieder geschafft.",
      "emotion": "happy",
      "pauseAfterSec": 0.7,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "sluzhivy-ryadovoy",
      "text": "Weißt du, eines Tages schreien die zu spät, und dann sind wir alle tot.",
      "emotion": "sad",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
