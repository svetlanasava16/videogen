{
  "id": "en-r-b3n4or.de",
  "jokeId": "en-r-b3n4or",
  "locale": "de",
  "title": "Zwei blinde Piloten",
  "location": "samolet",
  "place": "plane",
  "cast": [
    "sluzhivy",
    "sluzhivy-ryadovoy"
  ],
  "roles": {
    "sluzhivy": "pilot",
    "sluzhivy-ryadovoy": "pilot"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Zwei blinde Piloten steigen in ein Flugzeug.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Sie tragen Sonnenbrillen und weiße Stöcke.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "Als das Flugzeug losrollt, wird den Passagieren mulmig.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "narrator",
      "text": "Das Flugzeug wird schneller, bleibt aber am Boden.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "Die restliche Startbahn wird immer kürzer, und das Flugzeug rast auf einen Zaun zu.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "Die Passagiere fangen an zu kreischen, und plötzlich hebt das Flugzeug ab und verfehlt den Zaun in letzter Sekunde.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "narrator",
      "text": "Alle Passagiere beruhigen sich und denken, es war ein schlechter Scherz.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "narrator",
      "text": "Im Cockpit dreht sich der Kopilot zum Piloten um und sagt:",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l9",
      "character": "sluzhivy-ryadovoy",
      "text": "Weißt du was?",
      "emotion": "neutral",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    },
    {
      "id": "l10",
      "character": "sluzhivy-ryadovoy",
      "text": "Eines Tages schreien die zu spät, und dann sind wir alle tot.",
      "emotion": "sad",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
