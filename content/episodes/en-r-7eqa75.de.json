{
  "id": "en-r-7eqa75.de",
  "jokeId": "en-r-7eqa75",
  "locale": "de",
  "title": "Der Freundschaftsdienst",
  "location": "ulitsa",
  "place": "church",
  "cast": [
    "muzhik",
    "muzhik-sosed"
  ],
  "roles": {
    "muzhik": "everyman",
    "muzhik-sosed": "friend"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Horst geht zu seinem Kumpel Günther und sagt...",
      "emotion": "neutral",
      "pauseAfterSec": 0.2,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "muzhik",
      "text": "Ich schlafe mit der Frau vom Pfarrer.",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "muzhik",
      "text": "Kannst du ihn nach dem Gottesdienst eine Stunde in der Kirche aufhalten?",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "narrator",
      "text": "Dem Freund gefällt das nicht, aber als guter Kumpel sagt er zu.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "Nach dem Gottesdienst stellt Günther dem Pfarrer alle möglichen dummen Fragen, nur um ihn zu beschäftigen.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "Schließlich wird der Pfarrer ungehalten.",
      "emotion": "neutral",
      "pauseAfterSec": 0.2,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "batyushka",
      "text": "Was haben Sie eigentlich wirklich vor?",
      "emotion": "angry",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "narrator",
      "text": "Günther fühlt sich schuldig und gesteht dem Pfarrer schließlich...",
      "emotion": "neutral",
      "pauseAfterSec": 0.2,
      "enter": [],
      "exit": []
    },
    {
      "id": "l9",
      "character": "muzhik-sosed",
      "text": "Mein Freund schläft gerade mit Ihrer Frau, deshalb hat er mich gebeten, Sie zu beschäftigen.",
      "emotion": "sad",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l10",
      "character": "narrator",
      "text": "Der Pfarrer lächelt, legt Günther brüderlich die Hand auf die Schulter und sagt...",
      "emotion": "neutral",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    },
    {
      "id": "l11",
      "character": "batyushka",
      "text": "Sie sollten jetzt schnell nach Hause gehen. Meine Frau ist vor einem Jahr gestorben.",
      "emotion": "happy",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
