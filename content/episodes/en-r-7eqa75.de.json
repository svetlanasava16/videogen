{
  "id": "en-r-7eqa75.de",
  "jokeId": "en-r-7eqa75",
  "locale": "de",
  "title": "Die Frau vom Pfarrer",
  "kind": "joke",
  "v": 2,
  "location": "ulitsa",
  "place": "church",
  "cast": [
    "muzhik",
    "muzhik-sosed",
    "batyushka"
  ],
  "roles": {
    "batyushka": "priest",
    "muzhik-sosed": "friend",
    "muzhik": "everyman"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Jack geht zu seinem Kumpel Bob.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "muzhik",
      "text": "Ich schlafe mit der Frau vom Pfarrer.",
      "emotion": "smug",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l2b",
      "character": "muzhik",
      "text": "Kannst du ihn nach dem Gottesdienst eine Stunde in der Kirche aufhalten?",
      "emotion": "smug",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "Dem Freund gefällt das nicht, aber als Kumpel sagt er zu.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "narrator",
      "text": "Nach dem Gottesdienst fängt Bob ein Gespräch mit dem Pfarrer an und stellt ihm alle möglichen dummen Fragen, nur um ihn zu beschäftigen.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "Schließlich wird der Pfarrer ungehalten.",
      "emotion": "neutral",
      "pauseAfterSec": 0.2
    },
    {
      "id": "l6",
      "character": "batyushka",
      "text": "Was hast du wirklich vor?",
      "emotion": "angry",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l7",
      "character": "narrator",
      "text": "Bob hat ein schlechtes Gewissen und gesteht dem Pfarrer schließlich alles.",
      "emotion": "neutral",
      "pauseAfterSec": 0.2
    },
    {
      "id": "l8",
      "character": "muzhik-sosed",
      "text": "Mein Freund schläft gerade mit Ihrer Frau,",
      "emotion": "sad",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l8b",
      "character": "muzhik-sosed",
      "text": "deshalb hat er mich gebeten, Sie zu beschäftigen.",
      "emotion": "sad",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l9",
      "character": "narrator",
      "text": "Der Pfarrer lächelt und legt Bob brüderlich die Hand auf die Schulter.",
      "emotion": "neutral",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l10",
      "character": "batyushka",
      "text": "Du beeilst dich jetzt besser, nach Hause zu kommen.",
      "emotion": "happy",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l10b",
      "character": "batyushka",
      "text": "Meine Frau ist vor einem Jahr gestorben.",
      "emotion": "happy",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
