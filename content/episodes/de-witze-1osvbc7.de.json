  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein sechzigjähriger Milliardär heiratet eine heiße Fünfundzwanzigjährige.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Nach der Hochzeitsreise feiern sie eine große Party.",
      "emotion": "happy",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "Nach ein paar Drinks wollen die Freunde des Milliardärs wissen, wie er es geschafft hat, so eine junge Frau zu bekommen.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l4",
      "character": "nachalnik",
      "text": "Ganz einfach. Ich habe bei meinem Alter gelogen.",
      "emotion": "smug",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l5",
      "character": "muzhik-sosed",
      "text": "Ja gut, aber selbst für einen Vierzig- oder Fünfundvierzigjährigen ist sie ja unglaublich.",
      "emotion": "surprised",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l6",
      "character": "muzhik-sosed",
      "text": "Welches Alter hast du ihr denn gesagt?",
      "emotion": "surprised",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l7",
      "character": "nachalnik",
      "text": "Fünfundachtzig.",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
