{
  "id": "de-witze-1ikywni.ru",
  "jokeId": "de-witze-1ikywni",
  "locale": "ru",
  "title": "Жёнин кот",
  "location": "gostinaya",
  "place": "car",
  "cast": [
    "muzhik",
    "kot"
  ],
  "roles": {
    "muzhik": "husband",
    "kot": "cat"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Мужик хочет тайком избавиться от кота своей жены и решает его выбросить.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Он сажает его в машину, отъезжает на двадцать домов, высаживает кота и едет домой.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "Через десять минут кот тоже снова дома.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "Ну ладно, может, расстояние было маловато.",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "Он снова садится с котом в машину, отъезжает на пять километров и высаживает его.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "Через двадцать минут кот опять дома.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "muzhik",
      "text": "Ну всё, хватит!",
      "emotion": "angry",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "narrator",
      "text": "Он сажает кота в машину и едет двадцать километров, потом через лес, через мост, направо, налево,",
      "emotion": "neutral",
      "pauseAfterSec": 0.2,
      "enter": [],
      "exit": []
    },
    {
      "id": "l9",
      "character": "narrator",
      "text": "и наконец высаживает кота посреди леса на поляне.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l10",
      "character": "narrator",
      "text": "Через полчаса мужик звонит домой.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l11",
      "character": "muzhik",
      "text": "Кот дома?",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l12",
      "character": "zhena",
      "text": "Да, а что?",
      "emotion": "surprised",
      "pauseAfterSec": 0.6,
      "enter": [],
      "exit": []
    },
    {
      "id": "l13",
      "character": "muzhik",
      "text": "Позови-ка его к телефону, я заблудился.",
      "emotion": "sad",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
