      "character": "narrator",
      "text": "A man found a bottle in the sea.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "muzhik",
      "text": "Well, there's a genie in there, I've got to rub it!",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "He rubs for an hour, rubs for two, rubs for three hours...",
      "emotion": "neutral",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "narrator",
      "text": "Completely worn out, he hears a bored voice from the bottle.",
      "emotion": "neutral",
      "pauseAfterSec": 0.6,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "chort",
      "text": "Pull the cork, you moron!",
