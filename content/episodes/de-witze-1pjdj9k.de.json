    {
      "id": "l5",
      "character": "muzhik-ryzhy",
      "text": "So knapp dreißig Liter.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
