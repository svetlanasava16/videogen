  "locale": "de",
  "title": "Interview mit Bauer Hubert",
  "kind": "joke",
  "v": 2,
  "location": "derevnya",
  "place": "farm",
  "cast": [
    "paren",
    "muzhik-ryzhy",
    "korova",
    "korova-chyornaya"
  ],
  "roles": {
    "paren": "journalist",
    "muzhik-ryzhy": "farmer",
    "korova": "cow",
    "korova-chyornaya": "cow"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Bauer Hubert wird für einen Beitrag im Lokal-TV interviewt. Passenderweise führt man das Gespräch direkt an der Kuhwiese.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l2",
      "character": "paren",
      "text": "Sagen Sie mal, Herr Bauer, wie viele Liter Milch gibt denn so eine Kuh am Tag?",
      "emotion": "happy",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "muzhik-ryzhy",
      "text": "Die braune Kuh oder die schwarze Kuh?",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "paren",
      "text": "Die Braune.",
      "emotion": "neutral",
      "pauseAfterSec": 0.2
    },
    {
      "id": "l5",
      "character": "muzhik-ryzhy",
      "text": "So knapp dreißig Liter.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l6",
      "character": "paren",
      "text": "Und die Schwarze?",
      "emotion": "neutral",
      "pauseAfterSec": 0.2
    },
    {
      "id": "l7",
      "character": "muzhik-ryzhy",
      "text": "Auch.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l8",
      "character": "paren",
      "text": "Und was fressen die so den ganzen Tag?",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l9",
      "character": "muzhik-ryzhy",
      "text": "Die Braune oder die Schwarze?",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l10",
      "character": "paren",
      "text": "Die Schwarze.",
      "emotion": "sad",
      "pauseAfterSec": 0.2
    },
    {
      "id": "l11",
      "character": "muzhik-ryzhy",
      "text": "Gras.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l12",
      "character": "paren",
      "text": "Und die Braune?",
      "emotion": "sad",
      "pauseAfterSec": 0.2
    },
    {
      "id": "l13",
      "character": "muzhik-ryzhy",
      "text": "Auch.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l14",
      "character": "paren",
      "text": "Aber wenn doch immer bei beiden alles gleich ist, warum fragen Sie immer, ob ich die Braune oder die Schwarze meine?",
      "emotion": "angry",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l15",
      "character": "muzhik-ryzhy",
      "text": "Na, weil die braune Kuh von mir ist.",
      "emotion": "smug",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l16",
      "character": "paren",
      "text": "Und die Schwarze?",
      "emotion": "surprised",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l17",
      "character": "muzhik-ryzhy",
      "text": "Auch.",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
