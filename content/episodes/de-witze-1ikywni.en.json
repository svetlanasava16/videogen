  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "A man decides to secretly get rid of his wife's cat.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "muzhik",
      "text": "Twenty houses away. That'll do. Out you go!",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": [
        "kot"
      ]
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "Ten minutes later, the cat is back home. Three miles away, same thing.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [
        "kot"
      ],
      "exit": []
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "That's it! Twelve miles, through the woods, over the bridge, left, right. Out!",
      "emotion": "angry",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": [
        "kot"
      ]
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "Half an hour later, he calls home.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "muzhik",
      "text": "Honey, is the cat there?",
      "emotion": "sad",
      "pauseAfterSec": 0.7,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "muzhik",
      "text": "Great. Put him on the phone. I'm lost.",
      "emotion": "sad",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    }
  ],
