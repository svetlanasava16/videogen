{
  "id": "de-witze-1ikywni.en",
  "jokeId": "de-witze-1ikywni",
  "locale": "en",
  "title": "The Wife's Cat",
  "location": "doroga",
  "place": "car",
  "cast": [
    "muzhik",
    "kot"
  ],
  "roles": {
    "muzhik": "husband",
    "kot": "cat"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "A man wants to secretly get rid of his wife's cat and decides to dump him somewhere.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "He takes him in the car, drives twenty houses down, drops the cat off and drives home. Ten minutes later the cat is back too.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "muzhik",
      "text": "Fine, maybe the distance was a little too short.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "narrator",
      "text": "He gets back in the car with the cat, drives three miles and drops him off. Twenty minutes later the cat is back home again.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "muzhik",
      "text": "That's enough!",
      "emotion": "angry",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "He drives twelve miles, then through the forest, over a bridge, right, left, and finally drops the cat off in the middle of the forest, in a clearing.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "narrator",
      "text": "Half an hour later the man calls home.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "muzhik",
      "text": "Is the cat there?",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l9",
      "character": "zhena",
      "text": "Yes, why?",
      "emotion": "surprised",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    },
    {
      "id": "l10",
      "character": "muzhik",
      "text": "Put him on the phone, I'm lost.",
      "emotion": "sad",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
