    "zhena"
  ],
  "roles": {
    "muzhik": "husband",
    "kot": "cat",
    "zhena": "wife"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "A man decides to quietly get rid of his wife's cat.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "muzhik",
      "text": "Twenty houses away. That should do it. Bye, cat.",
      "emotion": "smug",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l3",
      "character": "muzhik",
      "text": "What? It's back already?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "Fine. Three miles this time.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l5",
      "character": "muzhik",
      "text": "Home again? That's it!",
      "emotion": "angry",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l6",
      "character": "muzhik",
      "text": "Twelve miles out, through the woods, over the bridge, left, right. Out you go!",
      "emotion": "angry",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l7",
      "character": "narrator",
      "text": "Half an hour later, he calls home.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l8",
      "character": "muzhik",
      "text": "Honey, is the cat there?",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l9",
      "character": "zhena",
      "text": "Yes. Why?",
      "emotion": "surprised",
      "pauseAfterSec": 0.7
    },
    {
      "id": "l10",
      "character": "muzhik",
      "text": "Put it on the phone. I'm lost.",
      "emotion": "sad",
      "pauseAfterSec": 0.8
    }
  ],
