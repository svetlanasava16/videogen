  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "A man answers the phone. It's his doctor.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "doktor",
      "text": "Mr. Miller, I'm sorry, but I have two pieces of bad news for you.",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "doktor",
      "text": "First: according to your latest test results, there is no longer any chance of a cure.",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "doktor",
      "text": "You will die within three days.",
      "emotion": "sad",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "doktor",
      "text": "Second: I've been trying to reach you since the day before yesterday.",
      "emotion": "neutral",
      "pauseAfterSec": 0.8,
