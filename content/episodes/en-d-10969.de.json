  "lines": [
    {
      "id": "l1",
      "character": "paren",
      "text": "Als ich sechzehn wurde, sagte mein Vater, es sei Zeit, mir einen Job zu suchen.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "muzhik",
      "text": "Als ich in deinem Alter war, hatte ich in meinem allerersten Job über fünfhundert Leute unter mir.",
      "emotion": "smug",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l3",
      "character": "paren",
      "text": "Wow! War das ein großer Konzern?",
      "emotion": "surprised",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "Nein. Ich habe auf dem Friedhof den Rasen gemäht.",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
