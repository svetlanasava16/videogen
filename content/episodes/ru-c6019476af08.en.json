  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "The kids had a class photo taken with their teacher. Now she is talking each of them into buying a copy.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "uchilka",
      "text": "Just imagine how wonderful it will be: when you're all grown up, you'll look at this photo and say:",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "uchilka",
      "text": "Here's little Molly, she's an actress now. And this is Pete, he's a doctor now...",
      "emotion": "happy",
      "pauseAfterSec": 0.6,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "vovochka",
      "text": "And this is Ms. Smith, she died a long time ago...",
      "emotion": "sad",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
