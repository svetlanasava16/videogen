  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Жена застала мужа на кухне голым, с пистолетом в руке.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "zhena",
      "text": "Ты что, чёрт возьми, делаешь?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "muzhik",
      "text": "Тихо, женщина! Я охочусь на десептиконов!",
      "emotion": "angry",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "zhena",
      "text": "Ты опять ходил во сне! Никаких десептиконов не бывает!",
      "emotion": "angry",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "muzhik",
      "text": "Наверное, ты права! Господи, я, должно быть, выгляжу как идиот!",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "Она засмеялась. Он засмеялся.",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "narrator",
      "text": "Тостер засмеялся.",
      "emotion": "neutral",
      "pauseAfterSec": 0.8,
