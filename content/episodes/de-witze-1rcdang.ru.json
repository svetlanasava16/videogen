    {
      "id": "l1",
      "character": "paren",
      "text": "Моя девушка хотела, чтобы я подарил ей на день рождения что-нибудь,",
      "emotion": "neutral",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l1b",
      "character": "paren",
      "text": "что разгоняется от нуля до ста меньше чем за четыре секунды.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l2",
      "character": "paren",
      "text": "Ну, я и купил ей напольные весы.",
      "emotion": "smug",
      "pauseAfterSec": 0.6,
      "laugh": "chuckle"
    },
    {
      "id": "l3",
      "character": "paren",
      "text": "Ссоримся уже третий день.",
      "emotion": "sad",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
