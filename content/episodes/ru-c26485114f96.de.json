{
  "id": "ru-c26485114f96.de",
  "jokeId": "ru-c26485114f96",
  "locale": "de",
  "title": "Gedanke und Idee",
  "location": "samolet",
  "place": "train",
  "cast": [
    "doktor",
    "nachalnik"
  ],
  "roles": {
    "doktor": "therapist",
    "nachalnik": "businessman"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Zwei Männer steigen im Süden in ein Schlafwagenabteil. Sie stellen sich vor.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "doktor",
      "text": "Ich bin Psychologe.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "nachalnik",
      "text": "Und ich bin Millionär.",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "nachalnik",
      "text": "Hör mal, wenn du Psychologe bist, dann errate meine Gedanken. Für jeden erratenen zahle ich dir hundert Euro.",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "doktor",
      "text": "Ich bin doch kein Hellseher, ich bin Psychologe...",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "nachalnik",
      "text": "Mann, hast du nicht verstanden? Hundert Euro pro Stück! Los, streng dich an, woran denke ich gerade?",
      "emotion": "angry",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "doktor",
      "text": "Also, du kommst aus dem Süden. Bestimmt denkst du daran, wie toll du Urlaub gemacht hast!",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "nachalnik",
      "text": "Richtig, Psychologe! Hier hast du hundert Euro! Rate weiter!",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l9",
      "character": "doktor",
      "text": "Und wenn du toll Urlaub gemacht hast, dann mit einer schönen Frau. Bestimmt denkst du an sie.",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l10",
      "character": "nachalnik",
      "text": "Gut gemacht! Nimm noch mal hundert! Weiter!",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l11",
      "character": "doktor",
      "text": "Und du denkst daran, wie wenig Lust du hast, nach Hause zu fahren...",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l12",
      "character": "nachalnik",
      "text": "Noch mal hundert!",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l13",
      "character": "doktor",
      "text": "Und wenn du keine Lust hast, dann wartet zu Hause eine Ehefrau...",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l14",
      "character": "nachalnik",
      "text": "Du Zauberer! Hier, noch ein Hunderter!",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l15",
      "character": "doktor",
      "text": "Du denkst: Soll ich sie umbringen, oder was?",
      "emotion": "neutral",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l16",
      "character": "nachalnik",
      "text": "Stopp, Mann! Hier hast du tausend Euro!",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l17",
      "character": "doktor",
      "text": "Was ist denn los? Ein Gedanke wie jeder andere...",
      "emotion": "surprised",
      "pauseAfterSec": 0.6,
      "enter": [],
      "exit": []
    },
    {
      "id": "l18",
      "character": "nachalnik",
      "text": "Mann, das ist kein Gedanke mehr. Das ist eine Idee!",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
