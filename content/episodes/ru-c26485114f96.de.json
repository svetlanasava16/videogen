{
  "id": "ru-c26485114f96.de",
  "jokeId": "ru-c26485114f96",
  "locale": "de",
  "title": "Nur ein Gedanke",
  "location": "samolet",
  "place": "train",
  "cast": [
    "doktor",
    "nachalnik"
  ],
  "roles": {
    "doktor": "therapist",
    "nachalnik": "new-russian"
  },
  "lines": [
    {
      "id": "l1",
      "character": "doktor",
      "text": "Ich bin Psychologe.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [
        "doktor",
        "nachalnik"
      ],
      "exit": []
    },
    {
      "id": "l2",
      "character": "nachalnik",
      "text": "Ich hab Kohle. Errate meine Gedanken. Hundert Euro pro Treffer.",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "doktor",
      "text": "Ich bin doch kein Hellseher.",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "nachalnik",
      "text": "Hundert Euro, Mann! Streng dich an!",
      "emotion": "angry",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "doktor",
      "text": "Du kommst aus dem Urlaub. Du denkst, wie schön er war.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "nachalnik",
      "text": "Richtig! Hundert für dich. Weiter!",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "doktor",
      "text": "Mit einer schönen Frau. An die denkst du.",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "nachalnik",
      "text": "Noch hundert!",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l9",
      "character": "doktor",
      "text": "Und nach Hause willst du nicht. Da wartet deine Frau.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l10",
      "character": "nachalnik",
      "text": "Du Zauberer! Nimm!",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l11",
      "character": "doktor",
      "text": "Und du denkst: Soll ich sie umbringen?",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l12",
      "character": "nachalnik",
      "text": "Stopp! Hier, tausend!",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l13",
      "character": "doktor",
      "text": "Wofür? Ein Gedanke wie jeder andere.",
      "emotion": "surprised",
      "pauseAfterSec": 0.7,
      "enter": [],
      "exit": []
    },
    {
      "id": "l14",
      "character": "nachalnik",
      "text": "Mann, das ist kein Gedanke mehr. Das ist eine Idee!",
      "emotion": "happy",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    }
  ],
  "explicit": false,
