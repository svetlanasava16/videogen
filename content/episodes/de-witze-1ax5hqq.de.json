    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein Mann trinkt in der Bar ein Bier nach dem anderen. Als er heimwill, fällt er vom Hocker und kommt nicht mehr hoch.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Also kriecht er nach Hause, ganz leise ins Bett, und seine Frau wacht nicht auf.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4,
      "enter": [
        "muzhik"
      ],
      "exit": []
    },
    {
      "id": "l3",
      "character": "zhena",
      "text": "Du warst schon wieder in der Bar und hast dich volllaufen lassen!",
      "emotion": "angry",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "Woher weißt du das denn schon wieder?",
      "emotion": "surprised",
      "pauseAfterSec": 0.7,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "zhena",
      "text": "Der Barkeeper hat heute Morgen angerufen. Du hast schon wieder deinen Rollstuhl dort vergessen.",
      "emotion": "angry",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    }
  ],
