{
  "id": "de-witze-1ax5hqq.de",
  "jokeId": "de-witze-1ax5hqq",
  "locale": "de",
  "title": "Der Rollstuhl",
  "location": "bar",
  "place": "bedroom",
  "cast": [
    "muzhik",
    "barmen"
  ],
  "roles": {
    "muzhik": "drunk",
    "barmen": "bartender"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein Mann sitzt gestresst in der Bar und zischt ein Bier nach dem anderen.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Als es spät wird und er kaum mehr geradeaus schauen kann, beschließt er, nach Hause zu gehen. Er fällt dabei vom Barhocker und schafft es nicht mehr aufzustehen.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "Er beschließt daraufhin, nach Hause zu kriechen.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "narrator",
      "text": "Daheim robbt er extra leise durch die Wohnung und die Treppe hoch. Seine Frau soll nicht merken, dass er schon wieder total dicht nach Hause gekommen ist.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "Er schafft es ins Bett, ohne dass seine Frau aufwacht, und schläft zufrieden ein.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "Am nächsten Morgen ist seine Frau stinksauer.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "zhena",
      "text": "Du warst schon wieder in der Bar und hast dich zugesoffen!",
      "emotion": "angry",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "muzhik",
      "text": "Wie hast du das schon wieder mitbekommen?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l9",
      "character": "zhena",
      "text": "Der Barkeeper hat heute Morgen angerufen.",
      "emotion": "smug",
      "pauseAfterSec": 0.7,
      "enter": [],
      "exit": []
    },
    {
      "id": "l10",
      "character": "zhena",
      "text": "Du hast wieder deinen Rollstuhl in der Bar vergessen.",
      "emotion": "angry",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
