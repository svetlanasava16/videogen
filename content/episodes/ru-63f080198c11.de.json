  "lines": [
    {
      "id": "l1",
      "character": "sluzhivy",
      "text": "Meine Damen und Herren, hier spricht Ihr Kapitän.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "sluzhivy",
      "text": "Wir fliegen in zehntausend Metern Höhe mit neunhundert Stundenkilometern, die Außentemperatur beträgt...",
      "emotion": "neutral",
      "pauseAfterSec": 0.2,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "sluzhivy",
      "text": "Aaah! Was ist das denn?! Oh nein, jetzt ist alles aus!",
      "emotion": "surprised",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "narrator",
      "text": "Totenstille in der Kabine.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "sluzhivy",
      "text": "Entschuldigen Sie bitte. Die Stewardess hat mir heißen Kaffee übergekippt.",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "sluzhivy",
      "text": "Sie sollten mal meine weiße Hose von vorne sehen!",
      "emotion": "sad",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "muzhik",
      "text": "Deine Hose ist gar nichts! Du solltest mal meine von hinten sehen!",
      "emotion": "angry",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    }
  ],
