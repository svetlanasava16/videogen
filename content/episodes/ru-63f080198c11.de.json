{
  "id": "ru-63f080198c11.de",
  "jokeId": "ru-63f080198c11",
  "locale": "de",
  "title": "Die weiße Hose",
  "kind": "joke",
  "v": 2,
  "location": "samolet",
  "place": "plane",
  "cast": [
    "sluzhivy",
    "muzhik"
  ],
  "roles": {
    "sluzhivy": "pilot",
    "muzhik": "customer"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein Flugzeug in der Luft. Der Pilot spricht über Lautsprecher.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "sluzhivy",
      "text": "Sehr geehrte Damen und Herren, hier spricht Ihr Kapitän.",
      "emotion": "smug",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l2b",
      "character": "sluzhivy",
      "text": "Hören Sie einige Informationen zu unserem Flug.",
      "emotion": "smug",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "sluzhivy",
      "text": "Wir fliegen in einer Höhe von zehntausend Metern mit neunhundert Kilometern pro Stunde,",
      "emotion": "neutral",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l3b",
      "character": "sluzhivy",
      "text": "die Außentemperatur beträgt...",
      "emotion": "neutral",
      "pauseAfterSec": 0.2
    },
    {
      "id": "l4",
      "character": "sluzhivy",
      "text": "Mist! Aaaah! Was ist das?! Na, jetzt ist alles im Eimer...",
      "uncensored": "Scheiße! Aaaah! Was ist das?! Na, jetzt ist alles im Arsch...",
      "emotion": "surprised",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "In der Kabine Totenstille. Eine Minute später wieder über Lautsprecher.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l6",
      "character": "sluzhivy",
      "text": "Ich bitte unsere verehrten Passagiere um Entschuldigung.",
      "emotion": "sad",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l6b",
      "character": "sluzhivy",
      "text": "Unsere Stewardess hat mir nur heißen Kaffee übergekippt.",
      "emotion": "sad",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l7",
      "character": "sluzhivy",
      "text": "Sie sollten jetzt mal meine weiße Hose von vorne sehen...",
      "emotion": "sad",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l8",
      "character": "muzhik",
      "text": "Pfeif auf deine Hose!",
      "uncensored": "Scheiß auf deine Hose!",
      "emotion": "angry",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l9",
      "character": "muzhik",
      "text": "Du solltest mal meine Hose von hinten sehen...",
      "emotion": "sad",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
