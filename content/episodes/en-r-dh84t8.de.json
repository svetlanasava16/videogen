  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein Mann hat vor Kurzem seinen besten Freund verloren. Trauernd an seinem Grab sagt er:",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "muzhik",
      "text": "Kumpel, ich vermisse dich wirklich.",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "muzhik",
      "text": "Meine Frau ist jetzt seit acht Monaten schwanger.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "Wie wäre es, wenn du als mein Kind wiedergeboren wirst?",
      "emotion": "happy",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "Einen Monat später bringt seine Frau einen kräftigen Jungen zur Welt.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "Mit jedem Tag wird das Kind älter, und er merkt, dass es seinem besten Freund sehr ähnlich sieht.",
      "emotion": "neutral",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "muzhik",
      "text": "Ich bin wirklich froh, dass mein Gebet gewirkt hat.",
      "emotion": "happy",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
