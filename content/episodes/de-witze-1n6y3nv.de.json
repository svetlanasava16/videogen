  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein Mann in der Psychiatrischen läuft den Flur entlang und zieht eine Zahnbürste hinter sich her.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "paren",
      "text": "Guten Tag, Herr Meier, führen Sie wieder Ihren Hund spazieren?",
      "emotion": "happy",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "muzhik",
      "text": "Wieso Hund? Das ist doch eine Zahnbürste.",
      "emotion": "surprised",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "narrator",
      "text": "Der Pfleger geht weiter und notiert, dass die Therapie gut verläuft.",
      "emotion": "neutral",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l5",
      "character": "muzhik",
      "text": "Na Fiffi, den haben wir aber reingelegt.",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
