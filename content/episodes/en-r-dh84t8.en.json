      ],
      "exit": []
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "Look, buddy. He's got your nose, your ears, even your laugh.",
      "emotion": "happy",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "muzhik",
      "text": "My prayer actually worked!",
