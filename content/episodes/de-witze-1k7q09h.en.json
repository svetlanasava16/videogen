  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Two guys are sitting at a bar on the forty-fifth floor of a skyscraper, getting plastered.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "paren",
      "text": "Now we've both had shooo much to drink, we can fly.",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": [
        "paren"
      ]
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "He opens a window, jumps out, flies once around the building and comes back in.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "paren",
      "text": "Your turn!",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [
        "paren"
      ],
      "exit": []
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "The other guy is still totally stunned by what he just saw, but in his state he's also totally motivated.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": [
        "muzhik"
      ]
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "He goes to the window, jumps out and… falls to his death.",
      "emotion": "sad",
      "pauseAfterSec": 0.6,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "barmen",
      "text": "As soon as you're drunk, you turn into a real jerk, Superman.",
      "uncensored": "As soon as you're drunk, you turn into a real ass, Superman.",
