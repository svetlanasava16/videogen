      "id": "l1",
      "character": "narrator",
      "text": "Ein Student kommt zur Prüfung und stellt wortlos eine Flasche Cognac auf den Tisch.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "doktor",
      "text": "Befriedigend.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "Der Student holt eine Schachtel Pralinen heraus.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "doktor",
      "text": "Gut.",
