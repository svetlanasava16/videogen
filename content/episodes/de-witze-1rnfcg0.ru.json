  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Госпожа Винтер пришла в египетский музей.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "zhena",
      "text": "Скажите, а сколько лет вот этой мумии?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "sluzhivy",
      "text": "Пять тысяч семь лет.",
      "emotion": "smug",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "zhena",
      "text": "Откуда это можно знать так точно?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "sluzhivy",
      "text": "Я работаю здесь семь лет.",
      "emotion": "neutral",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l6",
      "character": "sluzhivy",
      "text": "Когда я начинал, мне сказали, что ей пять тысяч лет.",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
