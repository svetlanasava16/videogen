    {
      "id": "l1",
      "character": "narrator",
      "text": "Es ist Prüfung.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Ein Student kommt zum Antworten nach vorne, mit einem kleinen Zettel, auf dem ein paar kurze Sätze stehen.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "doktor",
      "text": "Und wo ist Ihre Antwort?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "paren",
      "text": "Im Kopf.",
      "emotion": "smug",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l5",
      "character": "doktor",
      "text": "Und was ist das?",
      "emotion": "neutral",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l6",
      "character": "paren",
      "text": "Das hat nicht mehr reingepasst.",
      "emotion": "smug",
