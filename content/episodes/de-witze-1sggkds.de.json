    {
      "id": "l1",
      "character": "narrator",
      "text": "Fragt der neue Mieter seinen Nachbarn von oben:",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "paren",
      "text": "Sag mal, du hast doch die gleiche Wohnung wie ich.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "paren",
      "text": "Wie viele Rollen Tapete hast du denn für den Flur gekauft, um ihn zu tapezieren?",
