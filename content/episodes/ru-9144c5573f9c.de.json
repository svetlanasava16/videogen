  "locale": "de",
  "title": "Jemand unterm Bett",
  "location": "bolnitsa",
  "place": "doctor-office",
  "cast": [
    "muzhik",
    "doktor"
  ],
  "roles": {
    "muzhik": "patient",
    "doktor": "doctor"
  },
  "lines": [
    {
      "id": "l1",
      "character": "muzhik",
      "text": "Herr Doktor, ich kann nicht mehr. Nachts spüre ich: Unterm Bett liegt jemand.",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [
        "muzhik"
      ],
      "exit": []
    },
    {
      "id": "l2",
      "character": "muzhik",
      "text": "Krieche ich drunter, liegt jemand oben drauf. Die ganze Nacht.",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "doktor",
      "text": "Ein schweres Syndrom. Drei Monate Therapie. Teuer, aber heilbar.",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "Gut, ich überleg's mir.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": [
        "muzhik"
      ]
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "Einen Monat später trifft der Doktor ihn auf der Straße.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "doktor",
      "text": "Na? Warum sind Sie nicht wiedergekommen?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [
        "muzhik"
      ],
      "exit": []
    },
    {
      "id": "l7",
      "character": "muzhik",
      "text": "Mein Nachbar hat mich geheilt. Für eine Flasche Schnaps.",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "doktor",
      "text": "Wie das denn?",
      "emotion": "surprised",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    },
    {
      "id": "l9",
      "character": "muzhik",
      "text": "Wir haben einen gekippt, und er sagt: Säg doch die Bettbeine ab.",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    }
  ],
  "format": {
    "width": 1080,
    "height": 1920,
    "fps": 30
  }
}
