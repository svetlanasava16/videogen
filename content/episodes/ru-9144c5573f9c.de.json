{
  "id": "ru-9144c5573f9c.de",
  "jokeId": "ru-9144c5573f9c",
  "locale": "de",
  "title": "Die Bettbeine",
  "location": "bolnitsa",
  "place": "doctor-office",
  "cast": [
    "muzhik",
    "doktor"
  ],
  "roles": {
    "muzhik": "patient",
    "doktor": "doctor"
  },
  "lines": [
    {
      "id": "l1",
      "character": "muzhik",
      "text": "Herr Doktor, ich bin völlig fertig. Ich lege mich schlafen, und mir kommt vor, unter dem Bett ist jemand.",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "muzhik",
      "text": "Ich krieche unters Bett, schaue genau hin, und da spüre ich, dass jemand auf meinem Bett liegt.",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "muzhik",
      "text": "Ich krieche raus, oben ist niemand, ich lege mich hin und spüre: Unter dem Bett ist doch jemand.",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "Und wenn ich wieder unters Bett krieche, kommt mir vor, oben ist jemand. Und so die ganze Nacht.",
      "emotion": "sad",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "doktor",
      "text": "Ja, das ist ein komplexes Syndrom. Wir werden Sie intensiv behandeln, zwei, drei Monate lang.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "doktor",
      "text": "Wir sind zwar teuer, aber höchstwahrscheinlich heilen wir Sie.",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "muzhik",
      "text": "Gut, ich überlege es mir.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "narrator",
      "text": "Er kam nie wieder. Einen Monat später trifft der Arzt ihn zufällig auf der Straße.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l9",
      "character": "doktor",
      "text": "Wie geht es Ihnen?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l10",
      "character": "muzhik",
      "text": "Mich hat der Nachbar für eine Flasche geheilt.",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l11",
      "character": "doktor",
      "text": "Wie das?",
      "emotion": "surprised",
      "pauseAfterSec": 0.6,
      "enter": [],
      "exit": []
    },
    {
      "id": "l12",
      "character": "muzhik",
      "text": "Wir haben einen getrunken, und er sagt zu mir: Säg doch die verdammten Bettbeine ab.",
      "emotion": "happy",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
