  "locale": "en",
  "title": "The Fourth Bodyguard",
  "kind": "joke",
  "v": 2,
  "location": "bar",
  "place": "restaurant",
  "cast": [
    "sluzhivy",
    "muzhik",
    "nachalnik",
    "paren"
  ],
  "roles": {
    "sluzhivy": "guard",
    "muzhik": "new-russian",
    "nachalnik": "new-russian",
    "paren": "guard"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "A meeting of New Russians. Each one has brought a huge bodyguard. Only one has a puny, short, sickly-looking one.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "muzhik",
      "text": "Is he some tough fighter?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "nachalnik",
      "text": "No, not at all.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "A sniper?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "nachalnik",
      "text": "Never held a gun in his life.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l6",
      "character": "muzhik",
      "text": "So why do you drag him around with you?",
      "emotion": "angry",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l7",
      "character": "narrator",
      "text": "Patting the bodyguard on the head:",
      "emotion": "neutral",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l8",
      "character": "nachalnik",
      "text": "He's already my fourth one like this. Everyone takes him for me.",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
