  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Мужик идёт по берегу озера. Какой-то парень черпает рукой воду и пьёт.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [
        "muzhik"
      ],
      "exit": []
    },
    {
      "id": "l2",
      "character": "muzhik",
      "text": "Ты что, эту воду пьёшь?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "muzhik",
      "text": "Сюда весь мусор кидают! Завод отходы сливает! Со всей деревни канализация сюда течёт!",
      "emotion": "angry",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "muzhik-sosed",
      "text": "What did you say?",
      "emotion": "surprised",
      "pauseAfterSec": 0.7,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "muzhik",
      "text": "Я говорю, двумя руками черпай!",
      "emotion": "happy",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    }
  ],
