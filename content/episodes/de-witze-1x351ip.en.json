    {
      "id": "l1",
      "character": "uchilka",
      "text": "Here's your key. Please keep it down, the man next door is very nervous and sleeps badly.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": [
        "uchilka"
      ]
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Upstairs, dead tired, he drops one shoe on the floor with a loud thud.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "nachalnik",
      "text": "Oh, the nervous neighbor! I'll set the other one down quietly.",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "narrator",
      "text": "Two hours later, someone pounds on his door.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "nachalnik",
      "text": "Who is it?",
      "emotion": "angry",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "muzhik-sosed",
      "text": "Your neighbor. For heaven's sake, drop the other shoe already!",
      "emotion": "angry",
      "pauseAfterSec": 0.8,
      "enter": [
        "muzhik-sosed"
      ],
      "exit": []
    }
