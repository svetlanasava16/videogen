  "locale": "en",
  "title": "The Man Next Door",
  "location": "bar",
  "place": "hotel",
  "cast": [
    "nachalnik",
    "uchilka"
  ],
  "roles": {
    "nachalnik": "businessman",
    "uchilka": "clerk"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "A businessman had booked a hotel room.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "uchilka",
      "text": "The man in the room next door is very nervous and has a hard time falling asleep.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "The businessman was very tired after a long day at work.",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "narrator",
      "text": "When he entered his room and sat down on the bed, he took off one of his shoes rather loudly and let it drop to the floor.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "At that moment he remembered what the receptionist had said, and he set the second shoe down very quietly.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "Then he put on his pajamas and went to sleep.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "narrator",
      "text": "Two hours later he was woken up by loud knocking at his door.",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "nachalnik",
      "text": "What's going on?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l9",
      "character": "muzhik-sosed",
      "text": "I'm the man from the room next door.",
      "emotion": "angry",
      "pauseAfterSec": 0.6,
      "enter": [],
      "exit": []
    },
    {
      "id": "l10",
      "character": "muzhik-sosed",
      "text": "Would you please finally drop the other shoe too?",
      "emotion": "angry",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
