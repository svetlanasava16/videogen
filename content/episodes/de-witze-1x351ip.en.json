  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "A businessman had booked a hotel room.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "uchilka",
      "text": "The man in the room next door is very nervous and has a hard time falling asleep.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "After a long day at work the businessman was very tired. He sat down on the bed, took off one of his shoes rather loudly and let it drop to the floor.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "narrator",
      "text": "At that moment he remembered what the receptionist had said, and he set the second shoe down very quietly.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "Then he went to sleep. Two hours later he was woken by loud knocking at his door.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "nachalnik",
      "text": "What's going on?",
      "emotion": "surprised",
      "pauseAfterSec": 0.7,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "muzhik-sosed",
      "text": "I'm the man from the room next door. Would you please, finally, drop the other shoe?",
      "emotion": "angry",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
