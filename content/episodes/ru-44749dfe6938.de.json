    "muzhik"
  ],
  "roles": {
    "devushka": "woman",
    "muzhik": "everyman"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein Bus in Odessa. Eine Frau telefoniert.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "devushka",
      "text": "Und stell dir vor, Sofie, ich komme ins Schlafzimmer, und da liegt er mit der Nachbarin, in unserem Bett!",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "devushka",
      "text": "Ich schleiche auf Zehenspitzen in die Küche und nehme...",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "devushka",
      "text": "Oh, Sofie, meine Haltestelle! Um sechs fahr ich von der Arbeit heim und erzähl dir den Rest.",
      "emotion": "surprised",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": [
        "devushka"
      ]
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "Sechs Uhr abends. Dieselbe Frau, derselbe Bus, dieselben Gesichter.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [
        "devushka"
      ],
      "exit": []
    },
    {
      "id": "l6",
      "character": "muzhik",
      "text": "Bin ich zu spät?",
      "emotion": "surprised",
      "pauseAfterSec": 0.6,
      "enter": [
        "muzhik"
      ],
      "exit": []
    },
    {
      "id": "l7",
      "character": "muzhik",
      "text": "Na, was glotzt du so? Ruf Sofie an!",
      "emotion": "angry",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    }
  ],
  "format": {
    "width": 1080,
