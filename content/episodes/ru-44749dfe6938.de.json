{
  "id": "ru-44749dfe6938.de",
  "jokeId": "ru-44749dfe6938",
  "locale": "de",
  "title": "Ruf Sofie an",
  "location": "doroga",
  "place": "bus",
  "cast": [
    "zhena",
    "muzhik"
  ],
  "roles": {
    "zhena": "wife",
    "muzhik": "customer"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "In einem Bus in Odessa fährt eine Frau und telefoniert mit dem Handy.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "zhena",
      "text": "Und stell dir vor, Sofie, ich komme in unser Schlafzimmer, und da wälzt er sich mit der Nachbarin auf unserem Bett!",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "zhena",
      "text": "Also schleiche ich auf Zehenspitzen in die Küche und nehme...",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "zhena",
      "text": "Oh, Sofie, meine Haltestelle! Ich fahre um sechs von der Arbeit zurück und erzähl dir den Rest.",
      "emotion": "surprised",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "Sechs Uhr abends. Dieselbe Frau steigt in den Bus, und drin sitzen dieselben Gesichter. Da springt ein Mann herein, völlig außer Atem.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "muzhik",
      "text": "Bin ich zu spät?",
      "emotion": "surprised",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "muzhik",
      "text": "Na, was glotzt du so? Ruf Sofie an.",
      "emotion": "angry",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
