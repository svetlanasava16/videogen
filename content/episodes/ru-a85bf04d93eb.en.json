      "text": "A brand-new Mercedes slams into the back of a road roller.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "nachalnik",
      "text": "Hey, it's me. Some road roller got in my way. Come sort it out.",
      "emotion": "angry",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "Soon a traffic cop pulls up and takes the roller driver aside.",
      "emotion": "neutral",
