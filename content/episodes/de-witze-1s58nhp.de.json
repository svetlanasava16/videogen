  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Fritzchen muss mit seiner Mutter zur Nachbarin, die gerade ein Kind bekommen hat.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "zhena",
      "text": "Das Kind hat keine Ohren!",
      "emotion": "surprised",
      "pauseAfterSec": 0.2,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "zhena",
      "text": "Wenn wir rüber gehen, sag auf keinen Fall was darüber. Hast du verstanden?",
      "emotion": "angry",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "vovochka",
      "text": "Das Kind hat aber einen schönen Mund!",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "devushka",
      "text": "Ja, damit er später auch mal schön reden und sprechen kann!",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "vovochka",
      "text": "Das Kind hat aber eine schöne Nase!",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "devushka",
      "text": "Ja, damit er später gut riechen kann!",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "vovochka",
      "text": "Das Kind hat aber schöne Augen!",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l9",
      "character": "devushka",
      "text": "Ja, damit er später auch mal gut sehen kann!",
      "emotion": "angry",
      "pauseAfterSec": 0.7,
      "enter": [],
      "exit": []
    },
    {
      "id": "l10",
      "character": "vovochka",
      "text": "Naja, eine Brille kann er auch nicht tragen!",
      "emotion": "neutral",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
