  "locale": "de",
  "title": "Das Baby der Nachbarin",
  "kind": "joke",
  "v": 2,
  "location": "kukhnya",
  "place": "home-living-room",
  "cast": [
    "zhena",
    "vovochka",
    "devushka"
  ],
  "roles": {
    "zhena": "mother",
    "vovochka": "fritzchen",
    "devushka": "woman"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Fritzchen muss mit seiner Mutter zur Nachbarin, die gerade ein Kind bekommen hat.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "zhena",
      "text": "Das Kind hat keine Ohren!",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "zhena",
      "text": "Wenn wir rüber gehen, sag auf keinen Fall was darüber. Hast du verstanden?",
      "emotion": "angry",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l4",
      "character": "narrator",
      "text": "Die beiden gehen zur stolzen Mama rüber und bekommen auch gleich das Baby präsentiert.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "vovochka",
      "text": "Das Kind hat aber einen schönen Mund!",
      "emotion": "happy",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l6",
      "character": "devushka",
      "text": "Ja, damit er später auch mal schön reden und sprechen kann!",
      "emotion": "happy",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l7",
      "character": "vovochka",
      "text": "Das Kind hat aber eine schöne Nase!",
      "emotion": "happy",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l8",
      "character": "devushka",
      "text": "Ja, damit er später gut riechen kann!",
      "emotion": "smug",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l9",
      "character": "vovochka",
      "text": "Das Kind hat aber schöne Augen!",
      "emotion": "happy",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l10",
      "character": "devushka",
      "text": "Ja, damit er später auch mal gut sehen kann!",
      "emotion": "angry",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l11",
      "character": "vovochka",
      "text": "Naja, eine Brille kann er auch nicht tragen!",
      "emotion": "neutral",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
