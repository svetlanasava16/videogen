  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein Brautpaar hatte auf dem Weg zur Kirche einen Unfall und kam direkt in den Himmel, zu Gott.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "zhena",
      "text": "Wir lieben uns so sehr,",
      "emotion": "happy",
      "pauseAfterSec": 0.2,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "muzhik",
      "text": "und wir wollen trotzdem heiraten.",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "ded",
      "text": "Ihr seid hier die Ersten mit so einer Bitte.",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": [
        "ded"
      ]
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "Und er verschwand für drei Wochen.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "Nach drei Wochen tauchte er mit einem Priester auf, der sie traute.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [
        "ded",
        "batyushka"
      ],
      "exit": []
    },
    {
      "id": "l7",
      "character": "narrator",
      "text": "Doch das Brautpaar ist schon wieder unzufrieden.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "muzhik",
      "text": "Also, im Himmel braucht man doch eigentlich keine Ehe.",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l9",
      "character": "zhena",
      "text": "Könnten wir uns nicht scheiden lassen?",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l10",
      "character": "ded",
      "text": "Macht mich nicht verrückt!",
      "emotion": "angry",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l11",
      "character": "ded",
      "text": "Ich habe drei Wochen gebraucht, um im Himmel überhaupt irgendeinen Priester zu finden!",
      "emotion": "angry",
      "pauseAfterSec": 0.6,
      "enter": [],
      "exit": []
    },
    {
      "id": "l12",
      "character": "ded",
      "text": "Habt ihr eine Ahnung, wie lange es dauert, im Himmel einen Anwalt zu finden?!",
      "emotion": "angry",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
