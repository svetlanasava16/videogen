      "character": "muzhik",
      "text": "Man sagt, eine Geburt ist das Schmerzhafteste,",
      "emotion": "neutral",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l1b",
      "character": "muzhik",
      "text": "was ein Mensch erleben kann...",
      "emotion": "neutral",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l2",
      "character": "muzhik",
      "text": "Na ja, vielleicht war ich zu jung, um mich zu erinnern,",
      "emotion": "smug",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l2b",
      "character": "muzhik",
      "text": "aber ich fand nicht, dass es so weh getan hat.",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
