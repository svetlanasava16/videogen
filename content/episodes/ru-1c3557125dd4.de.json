{
  "id": "ru-1c3557125dd4.de",
  "jokeId": "ru-1c3557125dd4",
  "locale": "de",
  "title": "Hilf mir, Kumpel",
  "kind": "joke",
  "v": 2,
  "location": "spalnya",
  "place": "bedroom",
  "cast": [
    "muzhik",
    "zhena",
    "muzhik-sosed"
  ],
  "roles": {
    "muzhik": "husband",
    "zhena": "wife",
    "muzhik-sosed": "friend"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein Mann wacht morgens mit dem schlimmsten Kater seines Lebens vom Klingeln des Telefons auf.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Es ruft ein Freund an, den er lange nicht gesehen hat.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "muzhik",
      "text": "Von wo rufst du an?",
      "emotion": "sad",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "muzhik-sosed",
      "text": "Hilf mir, Kumpel, ich rufe aus der Ausnüchterungszelle an, nicht weit von dir.",
      "emotion": "sad",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "muzhik-sosed",
      "text": "Ich hab kein Geld, ich brauche sechsundfünfzig Euro,",
      "emotion": "sad",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l5b",
      "character": "muzhik-sosed",
      "text": "damit sie mich rauslassen.",
      "emotion": "sad",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "Der Mann verspricht es, legt auf, nimmt seine letzten Kräfte zusammen,",
      "emotion": "neutral",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l6b",
      "character": "narrator",
      "text": "steht auf und zieht sich langsam an, immer bemüht, nicht umzufallen.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l7",
      "character": "zhena",
      "text": "Wohin?!",
      "emotion": "angry",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l8",
      "character": "narrator",
      "text": "Er erklärt ehrlich, worum es geht.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l9",
      "character": "narrator",
      "text": "Die Frau betrachtet lange sein verquollenes Gesicht und sagt:",
      "emotion": "neutral",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l10",
      "character": "zhena",
      "text": "Nimm hundertzwölf Euro mit!",
      "emotion": "angry",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
  "explicit": false,
