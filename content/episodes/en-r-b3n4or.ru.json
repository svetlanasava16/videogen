  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Два слепых пилота входят в самолёт.",
      "emotion": "neutral",
      "audio": {
        "file": "audio/voice/en-r-b3n4or.ru/l1.mp3",
        "durationSec": 2.351,
        "words": [
          {
            "text": "Два",
            "start": 0,
            "end": 0.267
          },
          {
            "text": "слепых",
            "start": 0.302,
            "end": 0.662
          },
          {
            "text": "пилота",
            "start": 0.708,
            "end": 1.045
          },
          {
            "text": "входят",
            "start": 1.08,
            "end": 1.393
          },
          {
            "text": "в",
            "start": 1.416,
            "end": 1.44
          },
          {
            "text": "самолёт.",
            "start": 1.498,
            "end": 2.322
          }
        ],
        "provider": "elevenlabs",
        "voiceId": "ogi2DyUAKJb7CEdqqvlU",
        "model": "eleven_multilingual_v2",
        "textHash": "4fb82af2"
      },
      "pauseAfterSec": 0
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "У них тёмные очки и белые трости.",
      "emotion": "neutral",
      "audio": {
        "file": "audio/voice/en-r-b3n4or.ru/l2.mp3",
        "durationSec": 3.109,
        "words": [
