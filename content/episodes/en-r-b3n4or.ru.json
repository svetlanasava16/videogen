            "end": 0.093
          },
          {
            "text": "них",
            "start": 0.139,
            "end": 0.267
          },
          {
            "text": "тёмные",
            "start": 0.313,
            "end": 0.685
          },
          {
            "text": "очки",
            "start": 0.708,
            "end": 1.184
          },
          {
            "text": "и",
            "start": 1.393,
            "end": 1.486
          },
          {
            "text": "белые",
            "start": 1.556,
            "end": 1.823
          },
          {
            "text": "трости.",
            "start": 1.869,
            "end": 3.065
          }
