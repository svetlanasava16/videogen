        "model": "eleven_multilingual_v2",
        "textHash": "6472455f"
      },
      "pauseAfterSec": 0
    },
    {
      "id": "l4",
      "character": "narrator",
      "text": "Самолёт набирает скорость, но остаётся на земле.",
