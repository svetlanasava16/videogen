        "model": "eleven_multilingual_v2",
        "textHash": "839056f3"
      },
      "pauseAfterSec": 0
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "Самолёт трогается с места, и пассажирам становится не по себе.",
