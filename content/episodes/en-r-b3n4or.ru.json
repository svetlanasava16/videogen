      "audio": {
        "file": "audio/voice/en-r-b3n4or.ru/l3.mp3",
        "durationSec": 3.709,
        "words": [
          {
            "text": "Самолёт",
            "start": 0,
            "end": 0.441
          },
          {
            "text": "трогается",
            "start": 0.488,
            "end": 1.01
          },
          {
            "text": "с",
            "start": 1.033,
            "end": 1.068
          },
          {
            "text": "места,",
            "start": 1.184,
            "end": 1.486
          },
          {
            "text": "и",
            "start": 1.509,
            "end": 1.533
          },
          {
            "text": "пассажирам",
