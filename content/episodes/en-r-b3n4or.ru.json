{
  "id": "en-r-b3n4or.ru",
  "jokeId": "en-r-b3n4or",
  "locale": "ru",
  "title": "Два слепых пилота",
  "location": "samolet",
  "place": "plane",
  "cast": [
    "sluzhivy",
    "sluzhivy-ryadovoy"
  ],
  "roles": {
    "sluzhivy": "pilot",
    "sluzhivy-ryadovoy": "pilot"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Два слепых пилота заходят в самолёт.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "На них тёмные очки, в руках белые трости.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "Самолёт трогается с места, и пассажирам становится не по себе.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "narrator",
      "text": "Самолёт набирает скорость, но не отрывается от земли.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "Полоса становится всё короче и короче, и самолёт несётся прямо на забор.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "Пассажиры начинают визжать, и вдруг самолёт взлетает, в последнюю секунду проскочив над забором.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "narrator",
      "text": "Все пассажиры успокаиваются, решив, что это была неудачная шутка.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "narrator",
      "text": "В кабине второй пилот поворачивается к первому и говорит:",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l9",
      "character": "sluzhivy-ryadovoy",
      "text": "Знаешь что?",
      "emotion": "neutral",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    },
    {
      "id": "l10",
      "character": "sluzhivy-ryadovoy",
      "text": "Однажды они закричат слишком поздно, и мы все погибнем.",
      "emotion": "sad",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
