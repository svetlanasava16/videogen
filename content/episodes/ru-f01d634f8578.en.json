  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "The overfed daughter of rich parents is bragging to her classmate.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "devochka",
      "text": "Yesterday Dad and I went to a restaurant, and what didn't we eat there: lobster, steak, barbecue!",
      "emotion": "smug",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "devochka",
      "text": "I ate so much I almost burst!",
      "emotion": "happy",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l4",
      "character": "narrator",
      "text": "Her skinny classmate looks at her sadly, and then says:",
      "emotion": "neutral",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l5",
      "character": "devochka-podruga",
      "text": "Why only almost? Didn't Dad have enough money?",
      "emotion": "sad",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
