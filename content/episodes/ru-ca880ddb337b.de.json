  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein Polizist hält ein Auto an. Das Fenster geht runter, und der Fahrer lächelt unterwürfig:",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "muzhik",
      "text": "Guten Tag, Herr Wachtmeister!",
      "emotion": "happy",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "muzhik",
      "text": "Bitte schön, Führerschein, Fahrzeugschein, Vollmacht,",
      "emotion": "happy",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l3b",
      "character": "muzhik",
      "text": "Versicherung natürlich auch, alles wie es sich gehört, alles ordnungsgemäß...",
      "emotion": "happy",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l4",
      "character": "vovochka",
      "text": "Papa, wo sind denn die Bullen?",
      "emotion": "surprised",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
