    {
      "id": "l1",
      "character": "vovochka",
      "text": "Papa, ich hab beschlossen zu heiraten.",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "muzhik",
      "text": "Wunderbar! Hast du denn schon ein Mädchen im Auge?!",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "vovochka",
      "text": "Ja... Oma! Sie hat gesagt, sie hat mich lieb, ich hab sie auch lieb... und sie kocht und erzählt Geschichten am besten auf der ganzen Welt!",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "Das ist schön, aber da gibt es ein kleines Problem!",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "vovochka",
      "text": "Was für ein Problem?!",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "muzhik",
      "text": "Sie ist zufällig meine Mutter. Wie kannst du denn meine Mutter heiraten!",
      "emotion": "surprised",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "vovochka",
      "text": "Warum nicht?! Du hast doch meine geheiratet!",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
