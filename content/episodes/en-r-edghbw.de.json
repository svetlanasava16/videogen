      "id": "l1",
      "character": "vovochka",
      "text": "Papa, ich hab beschlossen zu heiraten.",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "muzhik",
      "text": "Wunderbar! Hast du denn schon ein Mädchen im Auge?",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "vovochka",
      "text": "Ja! Die Oma! Sie hat mich lieb, ich hab sie lieb, und sie kocht am besten auf der ganzen Welt!",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "Schön, aber da gibt es ein kleines Problem.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "vovochka",
      "text": "Was für ein Problem?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "muzhik",
      "text": "Sie ist meine Mutter! Du kannst doch nicht meine Mutter heiraten!",
      "emotion": "angry",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "vovochka",
      "text": "Warum nicht? Du hast doch auch meine geheiratet!",
      "emotion": "smug",
