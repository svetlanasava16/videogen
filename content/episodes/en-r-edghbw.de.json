{
  "id": "en-r-edghbw.de",
  "jokeId": "en-r-edghbw",
  "locale": "de",
  "title": "Heiratspläne",
  "kind": "joke",
  "v": 2,
  "location": "gostinaya",
  "place": "home-living-room",
  "cast": [
    "vovochka",
    "muzhik"
  ],
  "roles": {
    "vovochka": "child",
    "muzhik": "father"
  },
  "lines": [
    {
      "id": "l1",
      "character": "vovochka",
      "text": "Papa, ich hab beschlossen zu heiraten.",
      "emotion": "happy",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "muzhik",
      "text": "Wunderbar! Hast du denn schon ein Mädchen im Auge?!",
      "emotion": "happy",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "vovochka",
      "text": "Ja... Oma!",
      "emotion": "happy",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l3b",
      "character": "vovochka",
      "text": "Sie hat gesagt, sie hat mich lieb,",
      "emotion": "happy",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l3c",
      "character": "vovochka",
      "text": "ich hab sie auch lieb... und sie kocht und erzählt Geschichten am besten auf der ganzen Welt!",
      "emotion": "happy",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "Das ist schön, aber da gibt es ein kleines Problem!",
      "emotion": "smug",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "vovochka",
      "text": "Was für ein Problem?!",
      "emotion": "surprised",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l6",
      "character": "muzhik",
      "text": "Sie ist zufällig meine Mutter. Wie kannst du denn meine Mutter heiraten!",
      "emotion": "surprised",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l7",
      "character": "vovochka",
      "text": "Warum nicht?! Du hast doch meine geheiratet!",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
