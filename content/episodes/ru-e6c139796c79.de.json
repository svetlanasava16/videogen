  "locale": "de",
  "title": "Das Geheimnis der Gesundheit",
  "kind": "joke",
  "v": 2,
  "location": "bar",
  "place": "bar",
  "cast": [
    "ded",
    "muzhik",
    "muzhik-sosed"
  ],
  "roles": {
    "ded": "old-man",
    "muzhik": "everyman",
    "muzhik-sosed": "everyman"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Eine Gruppe Männer kam auf die Gesundheit zu sprechen.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "ded",
      "text": "Ich war keinen einzigen Tag krank, und zwar, weil ich ein einfaches, geregeltes Leben geführt habe.",
      "emotion": "smug",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "ded",
      "text": "Von zwanzig bis vierzig bin ich jeden Tag um neun ins Bett gegangen und um sechs Uhr morgens aufgestanden.",
      "emotion": "smug",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "ded",
      "text": "Von acht bis fünf habe ich gearbeitet, zu Mittag gegessen, und zwar einfache Kost, und dann eine Stunde Sport getrieben...",
      "emotion": "happy",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l5",
      "character": "muzhik-sosed",
      "text": "Entschuldigung, und wofür haben Sie gesessen?",
      "emotion": "neutral",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
  "explicit": false,
