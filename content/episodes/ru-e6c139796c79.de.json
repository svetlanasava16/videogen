      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "ded",
      "text": "Von zwanzig bis vierzig bin ich jeden Abend um neun ins Bett und um sechs aufgestanden.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "ded",
      "text": "Von acht bis fünf gearbeitet, einfach gegessen, danach eine Stunde Sport...",
