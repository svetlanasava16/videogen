  "locale": "de",
  "title": "Vom Balkon",
  "location": "zal",
  "place": "theater",
  "cast": [
    "muzhik",
    "zhena",
    "paren",
    "nachalnik",
    "sluzhivy"
  ],
  "roles": {
    "muzhik": "husband",
    "zhena": "wife",
    "paren": "everyman",
    "nachalnik": "bureaucrat",
    "sluzhivy": "police-officer"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Theater. Die Zuschauer nehmen ihre Plätze ein.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Im Parkett sitzt breit hingefläzt ein Mann: die Füße auf den vorderen Sitzen, die Arme auf den Nachbarsitzen, den Kopf zurückgeworfen, die Zunge heraus.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "Leute kommen zu ihm und sagen:",
      "emotion": "neutral",
      "pauseAfterSec": 0.2,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "Entschuldigen Sie, unsere Plätze sind etwas weiter. Würden Sie uns bitte durchlassen?",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "Der Mann, null Reaktion. Sie wieder:",
      "emotion": "neutral",
      "pauseAfterSec": 0.2,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "zhena",
      "text": "Junger Mann, Sie hindern uns am Durchgehen. Wenn Sie die Füße nicht wegnehmen, müssen wir den Administrator rufen.",
      "emotion": "angry",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "narrator",
      "text": "Null Emotionen. Der Administrator kommt.",
      "emotion": "neutral",
      "pauseAfterSec": 0.2,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "nachalnik",
      "text": "Genosse, nehmen Sie die Füße weg, Sie hindern die Leute daran, zu ihren Plätzen zu gehen!",
      "emotion": "angry",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l9",
      "character": "narrator",
      "text": "Keine Antwort.",
      "emotion": "neutral",
      "pauseAfterSec": 0.2,
      "enter": [],
      "exit": []
    },
    {
      "id": "l10",
      "character": "nachalnik",
      "text": "Junger Mann! Sie verstoßen gegen die Verhaltensregeln an einem öffentlichen Ort! Wenn Sie die Füße nicht wegnehmen, rufe ich einen Polizisten!",
      "emotion": "angry",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l11",
      "character": "narrator",
      "text": "Ein Polizist kommt.",
      "emotion": "neutral",
      "pauseAfterSec": 0.2,
      "enter": [],
      "exit": []
    },
    {
      "id": "l12",
      "character": "sluzhivy",
      "text": "Also so, Füße weg!",
      "emotion": "angry",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l13",
      "character": "narrator",
      "text": "Der Mann schweigt.",
      "emotion": "neutral",
      "pauseAfterSec": 0.2,
      "enter": [],
      "exit": []
    },
    {
      "id": "l14",
      "character": "sluzhivy",
      "text": "Bist du völlig übergeschnappt? Ich hab gesagt, Füße weg!",
      "emotion": "angry",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l15",
      "character": "narrator",
      "text": "Schweigen.",
      "emotion": "neutral",
      "pauseAfterSec": 0.2,
      "enter": [],
      "exit": []
    },
    {
      "id": "l16",
      "character": "sluzhivy",
      "text": "Hörst du mich nicht, oder was? Wo kommst du denn her?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l17",
      "character": "narrator",
      "text": "Da sagt der Mann, kaum die Lippen bewegend:",
      "emotion": "neutral",
      "pauseAfterSec": 0.7,
      "enter": [],
      "exit": []
    },
    {
      "id": "l18",
      "character": "paren",
      "text": "Vom Balkon...",
      "emotion": "sad",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
