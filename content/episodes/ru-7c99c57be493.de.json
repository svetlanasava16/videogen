  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein sehr nützlicher Rat für Männer.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Wenn weiche Händchen Ihnen die Augen zuhalten,",
      "emotion": "neutral",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l2b",
      "character": "narrator",
      "text": "sich ein üppiger Busen und ein rundes Bäuchlein an Ihren Rücken drücken und Sie von hinten hören:",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "zhena",
      "text": "Rate mal, wer?",
      "emotion": "happy",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l4",
      "character": "narrator",
      "text": "Antworten Sie auf jeden Fall:",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "muzhik",
      "text": "Jürgen, bist du das?",
      "emotion": "surprised",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "Glauben Sie mir, so ist es besser.",
      "emotion": "neutral",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
