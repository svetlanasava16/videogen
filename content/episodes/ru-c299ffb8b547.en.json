{
  "id": "ru-c299ffb8b547.en",
  "jokeId": "ru-c299ffb8b547",
  "locale": "en",
  "title": "The Drum",
  "location": "gostinaya",
  "place": "front-door",
  "cast": [
    "muzhik",
    "paren"
  ],
  "roles": {
    "muzhik": "everyman",
    "paren": "musician"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "The doorbell rings. The owner opens the door and sees a huge drum with cymbals on top... and someone standing behind it.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "muzhik",
      "text": "...Who are you looking for?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "paren",
      "text": "Excuse me, is this where the funeral is?",
      "emotion": "neutral",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "No... the doctor said I've got three more days...",
      "emotion": "sad",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "paren",
      "text": "Oh, I'm terribly sorry... forgive me...",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "The man with the drum somehow manages to turn around and leaves.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "narrator",
      "text": "A while later the doorbell rings again. The owner opens the door again. The same picture.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "muzhik",
      "text": "What do you want?",
      "emotion": "angry",
      "pauseAfterSec": 0.7,
      "enter": [],
      "exit": []
    },
    {
      "id": "l9",
      "character": "paren",
      "text": "Sorry, could I leave my drum here with you for now?",
      "emotion": "neutral",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
