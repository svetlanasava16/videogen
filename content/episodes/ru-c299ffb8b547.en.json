  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "The doorbell rings. On the doorstep is a huge drum with cymbals, and someone behind it.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "muzhik",
      "text": "Can I help you?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "paren",
      "text": "Excuse me, is this the funeral?",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [
        "paren"
      ],
      "exit": []
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "No... The doctor said three more days.",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "paren",
      "text": "Oh my God, I'm so sorry!",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": [
        "paren"
      ]
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "A few minutes later, the doorbell rings again.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "muzhik",
      "text": "What now?",
      "emotion": "angry",
      "pauseAfterSec": 0.7,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "paren",
      "text": "Sorry, mind if I leave the drum here in the meantime?",
      "emotion": "neutral",
      "pauseAfterSec": 0.8,
      "enter": [
        "paren"
      ],
      "exit": []
    }
  ],
