{
  "id": "ru-c299ffb8b547.en",
  "jokeId": "ru-c299ffb8b547",
  "locale": "en",
  "title": "The Drum",
  "kind": "joke",
  "v": 2,
  "location": "gostinaya",
  "place": "front-door",
  "cast": [
    "paren",
    "muzhik"
  ],
  "roles": {
    "paren": "musician",
    "muzhik": "patient"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "The doorbell rings. The owner opens the door and sees a huge drum with cymbals fixed on top, and someone standing behind it.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "muzhik",
      "text": "Who are you looking for?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "paren",
      "text": "Excuse me, is this where the funeral is?",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "No... the doctor said I've got three more days...",
      "emotion": "sad",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l5",
      "character": "paren",
      "text": "Oh God, I'm so sorry... forgive me...",
      "emotion": "sad",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "A little later the doorbell rings again. The owner opens the door again. Same picture.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l7",
      "character": "muzhik",
      "text": "What do you want?",
      "emotion": "angry",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l8",
      "character": "paren",
      "text": "Sorry, could I leave my drum here for now?",
      "emotion": "neutral",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
