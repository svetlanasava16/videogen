    {
      "id": "l1",
      "character": "muzhik",
      "text": "Доктор, я съел один из этих пакетиков с силикагелем, на которых написано «Не есть».",
      "emotion": "surprised",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "muzhik",
      "text": "Я умру?",
      "emotion": "sad",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "doktor",
      "text": "Ну, все когда-нибудь умрут.",
      "emotion": "neutral",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "Все?! Обалдеть, что же я наделал?",
      "uncensored": "Все?! Охренеть, что же я наделал?",
      "emotion": "surprised",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
