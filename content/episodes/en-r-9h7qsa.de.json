{
  "id": "en-r-9h7qsa.de",
  "jokeId": "en-r-9h7qsa",
  "locale": "de",
  "title": "Das Wechselgeld",
  "location": "bar",
  "place": "bar",
  "cast": [
    "muzhik",
    "barmen"
  ],
  "roles": {
    "muzhik": "customer",
    "barmen": "bartender"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein Typ kommt in eine Kneipe.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "muzhik",
      "text": "Ein Bier, bitte.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "barmen",
      "text": "Das macht fünf Euro.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "narrator",
      "text": "Der Typ wirft zehn Fünfzig-Cent-Stücke auf den Boden. Widerwillig sammelt der Wirt die Münzen auf und zapft das Bier.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "Am nächsten Tag kommt der Typ wieder in die Kneipe, bestellt ein Bier und wirft zehn Fünfzig-Cent-Stücke auf den Boden.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "Am nächsten Tag wieder.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "narrator",
      "text": "Am vierten Tag bestellt er ein Bier und gibt dem Wirt einen Zehn-Euro-Schein.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "narrator",
      "text": "Der Wirt nutzt die Chance auf Rache, wirft zehn Fünfzig-Cent-Stücke auf den Boden und brüllt:",
      "emotion": "smug",
      "pauseAfterSec": 0.2,
      "enter": [],
      "exit": []
    },
    {
      "id": "l9",
      "character": "barmen",
      "text": "Hier ist dein Wechselgeld, du Blödmann!",
      "uncensored": "Hier ist dein Wechselgeld, du Arschloch!",
      "emotion": "angry",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "chuckle"
    },
    {
      "id": "l10",
      "character": "muzhik",
      "text": "Ich nehme noch ein Bier, bitte.",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
