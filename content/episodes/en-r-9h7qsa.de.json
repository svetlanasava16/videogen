{
  "id": "en-r-9h7qsa.de",
  "jokeId": "en-r-9h7qsa",
  "locale": "de",
  "title": "Das Wechselgeld",
  "kind": "joke",
  "v": 2,
  "location": "bar",
  "place": "bar",
  "cast": [
    "muzhik",
    "barmen"
  ],
  "roles": {
    "muzhik": "customer",
    "barmen": "bartender"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein Typ kommt in eine Kneipe und bestellt ein Bier.",
      "emotion": "neutral",
      "pauseAfterSec": 0
    },
    {
      "id": "l2",
      "character": "barmen",
      "text": "Das macht fünf Euro,",
      "emotion": "neutral",
      "pauseAfterSec": 0
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "sagt der Wirt, und der Typ wirft zehn Fünfzig-Cent-Münzen auf den Boden.",
      "emotion": "neutral",
      "pauseAfterSec": 0
    },
    {
      "id": "l4",
      "character": "narrator",
      "text": "Widerwillig hebt der Wirt die Münzen auf",
      "emotion": "neutral",
      "pauseAfterSec": 0
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "und serviert das Bier.",
      "emotion": "neutral",
      "pauseAfterSec": 0
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "Am nächsten Tag kommt der Typ in die Kneipe, bestellt ein Bier,",
      "emotion": "neutral",
      "pauseAfterSec": 0
    },
    {
      "id": "l7",
      "character": "narrator",
      "text": "wirft zehn Fünfzig-Cent-Münzen auf den Boden, und so weiter.",
      "emotion": "neutral",
      "pauseAfterSec": 0
    },
    {
      "id": "l8",
      "character": "narrator",
      "text": "Am Tag darauf wieder.",
      "emotion": "neutral",
      "pauseAfterSec": 0
    },
    {
      "id": "l9",
      "character": "narrator",
      "text": "Am vierten Tag bestellt er ein Bier",
      "emotion": "neutral",
      "pauseAfterSec": 0
    },
    {
      "id": "l10",
      "character": "narrator",
      "text": "und gibt dem Wirt einen Zehn-Euro-Schein.",
      "emotion": "neutral",
      "pauseAfterSec": 0
    },
    {
      "id": "l11",
      "character": "narrator",
      "text": "Der Wirt nutzt seine Chance auf Rache, wirft zehn Fünfzig-Cent-Münzen auf den Boden und brüllt:",
      "emotion": "neutral",
      "pauseAfterSec": 0
    },
    {
      "id": "l12",
      "character": "barmen",
      "text": "Hier ist dein Wechselgeld, Mistkerl!",
      "uncensored": "Hier ist dein Wechselgeld, Arschloch!",
      "emotion": "angry",
      "pauseAfterSec": 0
    },
    {
      "id": "l13",
      "character": "narrator",
      "text": "Der Typ schaut auf die Münzen und sagt:",
      "emotion": "neutral",
      "pauseAfterSec": 0
    },
    {
      "id": "l14",
      "character": "muzhik",
      "text": "Ich nehme noch ein Bier, bitte.",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
