{
  "id": "ru-bcafdbeab440.en",
  "jokeId": "ru-bcafdbeab440",
  "locale": "en",
  "title": "Last Day on Duty",
  "kind": "joke",
  "v": 2,
  "location": "doroga",
  "place": "road",
  "cast": [
    "muzhik",
    "sluzhivy"
  ],
  "roles": {
    "muzhik": "driver",
    "sluzhivy": "traffic-cop"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "A man is driving his convertible Mercedes down the highway. A breeze is blowing, the sun is shining. Life is good.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Suddenly, out of nowhere, a highway patrol car appears and starts chasing him.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "muzhik",
      "text": "I'm in a car like this! They'll never catch me...",
      "emotion": "smug",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "narrator",
      "text": "He floors it, the speed climbs past a hundred. The police are on his tail and don't fall behind.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "A hundred and twenty on the speedometer, the police don't fall behind.",
      "emotion": "neutral",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l5b",
      "character": "narrator",
      "text": "He kicks it all the way down and hits a full hundred and fifty. The police don't fall behind.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "Time to stop and give up. He pulls over onto the shoulder.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l7",
      "character": "sluzhivy",
      "text": "Good afternoon, sir. Today is my last day on duty, I'm retiring.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l8",
      "character": "sluzhivy",
      "text": "So I don't really feel like writing tickets.",
      "emotion": "smug",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l8b",
      "character": "sluzhivy",
      "text": "If you can come up with a good explanation for what you did, I'll let you go.",
      "emotion": "smug",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l9",
      "character": "muzhik",
      "text": "Oh!",
      "emotion": "surprised",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l9b",
      "character": "muzhik",
      "text": "You see, a week ago my wife ran off with a policeman,",
      "emotion": "surprised",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l9c",
      "character": "muzhik",
      "text": "and I thought you were trying to bring her back...",
      "emotion": "surprised",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
