  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "A man is flying down the highway in his convertible, with the police right behind him.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "muzhik",
      "text": "Ha! They'll never catch me in this baby!",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "muzhik",
      "text": "A hundred and fifty, and they're still on my tail. Fine, I give up.",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "sluzhivy",
      "text": "Good afternoon, sir. It's my last day before retirement, and I really don't feel like writing tickets.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [
        "sluzhivy"
      ],
      "exit": []
    },
    {
      "id": "l5",
      "character": "sluzhivy",
      "text": "Give me a good excuse, and I'll let you go.",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "muzhik",
      "text": "Well, officer, last week my wife ran off with a cop.",
      "emotion": "sad",
      "pauseAfterSec": 0.7,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "muzhik",
      "text": "I thought you were trying to bring her back!",
      "emotion": "surprised",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    }
  ],
