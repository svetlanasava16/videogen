  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "A man is walking through the forest after shopping, with a full shopping bag.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "A little chick comes toward him – completely covered in crap.",
      "uncensored": "A little chick comes toward him – completely covered in shit.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [
        "ptitsa"
      ],
      "exit": []
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "The man feels sorry for the chick. So he takes a roll of toilet paper out of his bag and wipes it clean.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "narrator",
      "text": "Shortly after, three more chicks come toward him, also totally covered in crap. The man wipes these clean too.",
      "uncensored": "Shortly after, three more chicks come toward him, also totally covered in shit. The man wipes these clean too.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "A good way further on, he meets five more chicks, again completely covered in crap.",
      "uncensored": "A good way further on, he meets five more chicks, again completely covered in shit.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "He wipes these too, but at the last chick the toilet paper runs out.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "narrator",
      "text": "Because he feels sorry for the last chick, he goes deeper into the forest to find something else.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "narrator",
      "text": "Then a farmer on a tractor comes toward him.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l9",
      "character": "muzhik",
      "text": "Excuse me, would you happen to have some toilet paper?",
      "emotion": "sad",
      "pauseAfterSec": 0.7,
      "enter": [],
      "exit": []
    },
    {
      "id": "l10",
      "character": "muzhik-ryzhy",
      "text": "Toilet paper? Just use a chick!",
      "emotion": "surprised",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
