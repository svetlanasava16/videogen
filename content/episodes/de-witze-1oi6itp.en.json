  "locale": "en",
  "title": "Chicks in the Woods",
  "location": "derevnya",
  "place": "forest",
  "cast": [
    "muzhik",
    "ptitsa"
  ],
  "roles": {
    "muzhik": "everyman",
    "ptitsa": "chicken"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "After shopping, a man is walking through the forest with a full shopping bag.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "A little chick comes toward him, completely covered in crap.",
      "uncensored": "A little chick comes toward him, completely covered in shit.",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "The man feels sorry for the chick.",
      "emotion": "sad",
      "pauseAfterSec": 0.2,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "narrator",
      "text": "So he takes a roll of toilet paper out of his bag and wipes it clean.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "Shortly after, three more chicks come toward him, also totally covered in crap.",
      "uncensored": "Shortly after, three more chicks come toward him, also totally covered in shit.",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "The man wipes them clean too.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "narrator",
      "text": "A good way further on, he runs into five more chicks, again completely covered in crap.",
      "uncensored": "A good way further on, he runs into five more chicks, again completely covered in shit.",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "narrator",
      "text": "He wipes them too, but by the last chick the toilet paper has run out.",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l9",
      "character": "narrator",
      "text": "Because he feels sorry for the last chick, he walks on into the forest to find something else to clean it with.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l10",
      "character": "narrator",
      "text": "Then a farmer on a tractor comes toward him.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l11",
      "character": "muzhik",
      "text": "Excuse me, would you happen to have some toilet paper?",
      "emotion": "sad",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    },
    {
      "id": "l12",
      "character": "muzhik-ryzhy",
      "text": "Toilet paper? Why don't you just use a chick!",
      "emotion": "surprised",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
