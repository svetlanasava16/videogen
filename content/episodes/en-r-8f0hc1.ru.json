  "lines": [
    {
      "id": "l1",
      "character": "chort",
      "text": "У тебя три желания.",
      "emotion": "smug",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "muzhik",
      "text": "Я такое уже видел. Что бы я ни загадал, оно вернётся и как-нибудь меня укусит.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "chort",
      "text": "Обещаю, такого не будет.",
      "emotion": "smug",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l3b",
      "character": "chort",
      "text": "Я так в этом уверен, что, если будет, дам тебе бесконечное число желаний.",
      "emotion": "smug",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "Ладно. Хочу бумеранг с зубами.",
      "emotion": "smug",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l5",
      "character": "chort",
      "text": "Ах ты ж сукин...",
      "emotion": "angry",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
