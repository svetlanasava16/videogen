  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Nora wanted to go ice fishing. She had read lots of books on the subject and finally gathered all the gear she needed.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "After setting up her comfy little stool, she began to cut a circle in the ice. Suddenly a voice boomed from above.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "paren",
      "text": "There are no fish under the ice.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "narrator",
      "text": "Startled, she moved further across the ice and began to cut another hole. Again the voice boomed.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "paren",
      "text": "There are no fish under the ice.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "Now worried, Nora moved all the way to the far end of the ice and tried once more to cut her fishing hole.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "paren",
      "text": "There are no fish under the ice.",
      "emotion": "angry",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "narrator",
      "text": "She stopped and looked up at the sky.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l9",
      "character": "devushka",
      "text": "Is that you, Lord?",
      "emotion": "surprised",
      "pauseAfterSec": 0.6,
      "enter": [],
      "exit": []
    },
    {
      "id": "l10",
      "character": "paren",
      "text": "No, this is the manager of the ice rink.",
      "emotion": "neutral",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
