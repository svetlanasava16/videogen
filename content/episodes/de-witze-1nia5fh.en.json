{
  "id": "de-witze-1nia5fh.en",
  "jokeId": "de-witze-1nia5fh",
  "locale": "en",
  "title": "Ice Fishing",
  "location": "derevnya",
  "place": "river-lake",
  "cast": [
    "devushka",
    "paren"
  ],
  "roles": {
    "devushka": "woman",
