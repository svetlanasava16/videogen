  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein Treffen feministischer Organisationen.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Am Rednerpult wettert schon wieder eine Rednerin:",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "devushka",
      "text": "Was würden diese Männer jetzt ohne Frauen machen?!",
      "emotion": "angry",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "devushka",
      "text": "Na, was würden sie ohne uns machen?!",
      "emotion": "angry",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "devushka",
      "text": "Hä?! Ich frage Sie!",
      "emotion": "angry",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l6",
      "character": "muzhik",
      "text": "Was, was?! Wir würden im Paradies Kokosnüsse fressen!",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
