      "id": "l1",
      "character": "narrator",
      "text": "A burglar sneaks into a dark house at night.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "ptitsa",
      "text": "I see you! And Jesus sees you too!",
      "emotion": "smug",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l3",
      "character": "vor",
      "text": "Phew, you scared me, little guy!",
      "emotion": "surprised",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "vor",
      "text": "What's your name?",
      "emotion": "happy",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "ptitsa",
      "text": "Gerald.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l6",
      "character": "vor",
      "text": "Gerald? That's a weird name for a parrot.",
      "emotion": "smug",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l7",
      "character": "ptitsa",
      "text": "Jesus is a weird name for a Rottweiler, too.",
