{
  "id": "en-r-9ae08g.de",
  "jokeId": "en-r-9ae08g",
  "locale": "de",
  "title": "Die Statue",
  "location": "spalnya",
  "place": "bedroom",
  "cast": [
    "muzhik",
    "zhena",
    "paren"
  ],
  "roles": {
    "muzhik": "husband",
    "zhena": "wife",
    "paren": "lover"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Eine Frau und ihr Liebhaber lagen im Bett, als die Frau hörte, wie ihr Mann nach Hause kam.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "zhena",
      "text": "Schnell! Reib dich mit Babypuder ein und tu so, als wärst du eine Statue.",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "Der Liebhaber tat es.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "Schatz, was macht denn diese Statue hier?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "zhena",
      "text": "Ich habe gesehen, dass die Schmidts eine haben, also wollte ich auch eine.",
      "emotion": "smug",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "Der Mann ging ins Bett, und die Frau schlief ein.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "narrator",
      "text": "Ein paar Stunden später vergewisserte er sich, dass seine Frau schlief, stand leise auf, ging in die Küche, schmierte sich ein Brot und holte ein Glas Milch.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "narrator",
      "text": "Er kam zurück und ging zur Statue.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l9",
      "character": "muzhik",
      "text": "Hier, iss und trink was.",
      "emotion": "happy",
      "pauseAfterSec": 0.7,
      "enter": [],
      "exit": []
    },
    {
      "id": "l10",
      "character": "muzhik",
      "text": "Ich habe drei Tage wie ein Idiot bei den Schmidts rumgestanden, und keiner hat mir was zu essen angeboten!",
      "emotion": "angry",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
