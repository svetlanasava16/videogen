{
  "id": "en-r-9ae08g.de",
  "jokeId": "en-r-9ae08g",
  "locale": "de",
  "title": "Die Statue",
  "kind": "joke",
  "v": 2,
  "location": "spalnya",
  "place": "bedroom",
  "cast": [
    "zhena",
    "paren",
    "muzhik"
  ],
  "roles": {
    "zhena": "wife",
    "muzhik": "husband",
    "paren": "lover"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Eine Frau lag mit ihrem Liebhaber im Bett, als sie hörte, dass ihr Mann nach Hause kam.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "zhena",
      "text": "Schnell! Reib dich mit Babypuder ein und tu so, als wärst du eine Statue.",
      "emotion": "surprised",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "Der Liebhaber tat es.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "Schatz, was macht denn diese Statue hier?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "zhena",
      "text": "Ich habe gesehen, dass die Schmidts sich eine geholt haben, also wollte ich auch eine.",
      "emotion": "smug",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "Der Mann legte sich ins Bett, und die Frau schlief ein.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l7",
      "character": "narrator",
      "text": "Ein paar Stunden später, als er sicher war, dass seine Frau schlief, stand er leise auf, ging in die Küche,",
      "emotion": "neutral",
      "pauseAfterSec": 0.2
    },
    {
      "id": "l8",
      "character": "narrator",
      "text": "machte ein Butterbrot, holte ein Glas Milch,",
      "emotion": "neutral",
      "pauseAfterSec": 0.2
    },
    {
      "id": "l9",
      "character": "narrator",
      "text": "kam zurück und ging zur Statue.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l10",
      "character": "muzhik",
      "text": "Hier, iss und trink was.",
      "emotion": "neutral",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l11",
      "character": "muzhik",
      "text": "Ich habe drei Tage bei den Schmidts wie ein Idiot herumgestanden, und keiner hat mir was zu essen angeboten!",
      "emotion": "angry",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
