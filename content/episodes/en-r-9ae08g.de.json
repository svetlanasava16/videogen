    "muzhik-ryzhy"
  ],
  "roles": {
    "zhena": "wife",
    "muzhik": "everyman",
    "muzhik-ryzhy": "husband"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Eine Frau liegt mit ihrem Liebhaber im Bett, da hört sie ihren Mann heimkommen.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "zhena",
      "text": "Schnell! Pudere dich mit Babypuder ein und rühr dich nicht. Du bist eine Statue.",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "muzhik-ryzhy",
      "text": "Schatz, was macht denn die Statue hier?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [
        "muzhik-ryzhy"
      ],
      "exit": []
    },
    {
      "id": "l4",
      "character": "zhena",
      "text": "Die Meiers haben auch eine, da wollte ich auch eine.",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "Nachts, als seine Frau schläft, bringt der Mann der Statue ein Brot und ein Glas Milch.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "muzhik-ryzhy",
      "text": "Hier, iss was.",
      "emotion": "neutral",
      "pauseAfterSec": 0.6,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "muzhik-ryzhy",
      "text": "Ich stand drei Tage wie ein Idiot bei den Meiers, und keiner hat mir was angeboten!",
      "emotion": "angry",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    }
  ],
