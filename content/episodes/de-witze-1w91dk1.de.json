{
  "id": "de-witze-1w91dk1.de",
  "jokeId": "de-witze-1w91dk1",
  "locale": "de",
  "title": "Der Vortrag",
  "kind": "joke",
  "v": 2,
  "location": "doroga",
  "place": "car",
  "cast": [
    "sluzhivy",
    "ded"
  ],
  "roles": {
    "sluzhivy": "police-officer",
    "ded": "old-man"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein älterer Herr wird um zwei Uhr früh von der Polizei angehalten.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "sluzhivy",
      "text": "Wo fahren Sie denn um diese Zeit in der Nacht noch hin?",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "ded",
      "text": "Ich bin auf dem Weg zu einem Vortrag über Alkoholmissbrauch,",
      "emotion": "smug",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l3c",
      "character": "ded",
      "text": "die Auswirkungen auf den menschlichen Körper,",
      "emotion": "smug",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l3b",
      "character": "ded",
      "text": "sowie die Einflüsse durch Rauchen und spätes nach Hause kommen.",
      "emotion": "smug",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l4",
      "character": "sluzhivy",
      "text": "Wirklich? Und wer hält um diese Zeit noch solche Vorträge?",
      "emotion": "surprised",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l5",
      "character": "ded",
      "text": "Meine Frau!",
      "emotion": "sad",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
