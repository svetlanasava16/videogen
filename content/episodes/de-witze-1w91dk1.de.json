    {
      "id": "l1",
      "character": "narrator",
      "text": "Zwei Uhr nachts. Die Polizei hält einen älteren Herrn an.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "sluzhivy",
      "text": "Guten Abend. Wo wollen Sie denn um diese Uhrzeit noch hin?",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [
        "sluzhivy"
      ],
      "exit": []
    },
    {
      "id": "l3",
      "character": "ded",
      "text": "Zu einem Vortrag. Über Alkoholmissbrauch, die Folgen für den Körper, übers Rauchen und übers späte Nachhausekommen.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "sluzhivy",
      "text": "Wirklich? Und wer hält um diese Zeit noch solche Vorträge?",
      "emotion": "surprised",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "ded",
      "text": "Meine Frau.",
      "emotion": "sad",
