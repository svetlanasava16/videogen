  "locale": "de",
  "title": "Das Hörgerät",
  "location": "bolnitsa",
  "place": "doctor-office",
  "cast": [
    "ded",
    "doktor"
  ],
  "roles": {
    "ded": "old-man",
    "doktor": "doctor"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein achtzigjähriger Mann, der seit vielen Jahren fast nichts mehr hört, geht endlich zum Facharzt.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [
        "ded"
      ],
      "exit": []
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Der Arzt passt ihm problemlos ein kleines Hörgerät an, und er hört wieder wie in seiner Jugend.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "Einen Monat später geht der alte Mann wieder zum Arzt, zur Kontrolle.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "doktor",
      "text": "Nun, alles in bester Ordnung.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "doktor",
      "text": "Sagen Sie, Ihre Familie ist sicher begeistert, dass Sie wieder alles so gut hören?",
      "emotion": "happy",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "ded",
      "text": "Oh, ich habe ihnen noch nichts gesagt. Ich sitze da und höre ihren Gesprächen zu.",
      "emotion": "smug",
      "pauseAfterSec": 0.7,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "ded",
      "text": "Ich musste schon dreimal mein Testament ändern...",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
  "explicit": false,
