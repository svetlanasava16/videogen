  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Dank eines neuen Hörgeräts hört ein Achtzigjähriger wieder wie in jungen Jahren.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "ded",
      "text": "Guten Tag, Herr Doktor. Ich komme zur Kontrolle.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [
        "ded"
      ],
      "exit": []
    },
    {
      "id": "l3",
      "character": "doktor",
      "text": "Na, alles bestens.",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "doktor",
      "text": "Ihre Familie ist sicher begeistert, dass Sie wieder so gut hören.",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "ded",
      "text": "Ach, denen habe ich noch nichts gesagt.",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "ded",
      "text": "Ich sitze einfach da und höre zu, worüber sie reden.",
      "emotion": "smug",
      "pauseAfterSec": 0.7,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "ded",
      "text": "Mein Testament habe ich schon dreimal geändert.",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
