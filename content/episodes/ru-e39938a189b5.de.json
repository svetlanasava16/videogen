{
  "id": "ru-e39938a189b5.de",
  "jokeId": "ru-e39938a189b5",
  "locale": "de",
  "title": "Die Opfer",
  "location": "bolnitsa",
  "place": "hospital",
  "cast": [
    "doktor",
    "sluzhivy-ryadovoy"
  ],
  "roles": {
    "doktor": "doctor",
    "sluzhivy-ryadovoy": "firefighter"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Gewidmet unserer tapferen Feuerwehr...",
      "emotion": "neutral",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Die Feuerwehr rückte aus, um im Krankenhaus einen Brand zu löschen.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "Sie machten alles, wie es sich für echte Helden gehört: Feuer gelöscht, sich nicht blamiert.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "narrator",
      "text": "Nach dem Einsatz meldet der Zugführer dem Chefarzt:",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "sluzhivy-ryadovoy",
      "text": "Auftrag erfüllt, Brand gelöscht.",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [
        "sluzhivy-ryadovoy"
      ],
      "exit": []
    },
    {
      "id": "l6",
      "character": "sluzhivy-ryadovoy",
      "text": "Allerdings... gibt es Opfer. Neun Personen.",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "sluzhivy-ryadovoy",
      "text": "Sieben haben wir wiederbelebt, zwei konnten wir leider nicht retten.",
      "emotion": "sad",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "narrator",
      "text": "Bei diesen Worten fällt der Chefarzt in Ohnmacht.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l9",
      "character": "narrator",
      "text": "Als er zu sich kommt, stammelt er, kaum dass er die Worte herausbringt:",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l10",
      "character": "doktor",
      "text": "Wieso sieben?!",
      "emotion": "surprised",
      "pauseAfterSec": 0.7,
      "enter": [],
      "exit": []
    },
    {
      "id": "l11",
      "character": "doktor",
      "text": "Jungs, ihr habt doch die Leichenhalle gelöscht...",
      "emotion": "sad",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
  "explicit": false,
  "outroLaughs": [],
