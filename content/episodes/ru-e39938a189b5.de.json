{
  "id": "ru-e39938a189b5.de",
  "jokeId": "ru-e39938a189b5",
  "locale": "de",
  "title": "Die Feuerwehr",
  "location": "bolnitsa",
  "place": "hospital",
  "cast": [
    "sluzhivy",
    "sluzhivy-ryadovoy",
    "doktor"
  ],
  "roles": {
    "sluzhivy": "firefighter",
    "sluzhivy-ryadovoy": "firefighter",
    "doktor": "doctor"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Der tapferen Feuerwehr gewidmet...",
      "emotion": "neutral",
      "pauseAfterSec": 0,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Die Feuerwehr wird zu einem Brand im Krankenhaus gerufen.",
      "emotion": "neutral",
      "pauseAfterSec": 0,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "Nun, sie machten alles, wie es sich für echte Helden gehört:",
      "emotion": "happy",
      "pauseAfterSec": 0,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "narrator",
      "text": "Sie löschten das Feuer und blamierten sich nicht.",
      "emotion": "happy",
      "pauseAfterSec": 0,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "Nach dem Löschen meldet der Einsatzleiter dem Chefarzt:",
      "emotion": "neutral",
      "pauseAfterSec": 0,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "sluzhivy-ryadovoy",
      "text": "Auftrag erfüllt, der Brand ist gelöscht.",
      "emotion": "smug",
      "pauseAfterSec": 0,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "sluzhivy-ryadovoy",
      "text": "Allerdings... gibt es Verletzte. Neun Personen.",
      "emotion": "sad",
      "pauseAfterSec": 0,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "sluzhivy-ryadovoy",
      "text": "Sieben haben wir wiederbelebt, aber zwei konnten wir leider nicht retten.",
      "emotion": "sad",
      "pauseAfterSec": 0,
      "enter": [],
      "exit": []
    },
    {
      "id": "l9",
      "character": "narrator",
      "text": "Bei diesen Worten fällt der Chefarzt in Ohnmacht.",
      "emotion": "surprised",
      "pauseAfterSec": 0,
      "enter": [],
      "exit": []
    },
    {
      "id": "l10",
      "character": "narrator",
      "text": "Als er wieder zu sich kommt, sagt er stotternd und kaum fähig, die Worte herauszubringen:",
      "emotion": "neutral",
      "pauseAfterSec": 0,
      "enter": [],
      "exit": []
    },
    {
      "id": "l11",
      "character": "doktor",
      "text": "Wie, sieben??? Leute, ihr habt doch die Leichenhalle gelöscht...",
      "emotion": "surprised",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
