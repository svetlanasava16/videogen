  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein Mann trifft auf der Hauptstraße einen alten Schulfreund.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "nachalnik",
      "text": "Schau mich an! Toller Job, dickes Gehalt, ein nagelneuer Sportwagen.",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "nachalnik",
      "text": "Und das ist meine Frau. Wunderschön, oder?",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "Wenn du die schön findest, solltest du mal zu meiner Freundin gehen.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "nachalnik",
      "text": "Warum? Ist die noch schöner?",
      "emotion": "surprised",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "muzhik",
      "text": "Nein. Die ist Augenärztin.",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
