  "cast": [
    "muzhik",
    "nachalnik"
  ],
  "roles": {
    "muzhik": "everyman",
    "nachalnik": "businessman"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein Mann trifft einen alten Schulfreund.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Der fängt an anzugeben, erzählt von seinem gut bezahlten Job und seinem teuren Sportwagen.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "Dann zieht er ein Foto seiner Frau heraus.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "nachalnik",
      "text": "Sie ist wunderschön, oder?",
      "emotion": "smug",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "muzhik",
      "text": "Wenn du die schon hinreißend findest, dann geh mal zu meiner Freundin.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l6",
      "character": "nachalnik",
      "text": "Wieso? Ist sie eine Wucht?",
      "emotion": "surprised",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l7",
      "character": "muzhik",
      "text": "Nein, sie ist eine verdammte Augenärztin.",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
