  "roles": {
    "muzhik": "drunk",
    "muzhik-ryzhy": "husband"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein betrunkener Mann steht in der Straßenbahn und beschimpft die Fahrgäste zu seiner Linken:",
      "emotion": "neutral",
      "pauseAfterSec": 0.2
    },
    {
      "id": "l2",
      "character": "muzhik",
      "text": "Lauter Idioten, lauter Idioten!",
      "emotion": "angry",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "Die Leute zu seiner Rechten brüllt er an:",
      "emotion": "neutral",
      "pauseAfterSec": 0.2
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "Lauter Ehebrecher, lauter Ehebrecher!",
      "emotion": "angry",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "Plötzlich springt ein Mann auf und schreit ihn an:",
      "emotion": "neutral",
      "pauseAfterSec": 0.2
    },
    {
      "id": "l6",
      "character": "muzhik-ryzhy",
      "text": "Was fällt Ihnen ein?",
      "emotion": "angry",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l7",
      "character": "muzhik-ryzhy",
      "text": "Ich bin seit zwanzig Jahren verheiratet und habe meine Frau noch nie betrogen!",
      "emotion": "angry",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l8",
      "character": "muzhik",
      "text": "Dann setz dich rüber zu den Idioten!",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
