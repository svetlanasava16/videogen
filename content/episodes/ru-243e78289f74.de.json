  "locale": "de",
  "title": "Die Knödel",
  "location": "kukhnya",
  "place": "home-kitchen",
  "cast": [
    "zhena",
    "devushka-ryzhaya",
    "doktor"
  ],
  "roles": {
    "zhena": "mother",
    "devushka-ryzhaya": "daughter",
    "doktor": "doctor"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein blindes Mädchen tastet beim Essen immer den Teller ab und mault.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "devushka-ryzhaya",
      "text": "Na toll, ich hab schon wieder am wenigsten! Nur weil ich nichts sehe! Geizhälse!",
      "emotion": "angry",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "Die Mutter hält es nicht mehr aus und holt einen Psychologen.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "doktor",
      "text": "Kochen Sie ihr einen ganzen Topf Knödel. Soll sie essen.",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [
        "doktor"
      ],
      "exit": [
        "doktor"
      ]
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "Am nächsten Tag stellt die Mutter ihr einen riesigen Topf Knödel hin.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "zhena",
      "text": "Iss, Schatz. Alles für dich.",
      "emotion": "happy",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "devushka-ryzhaya",
      "text": "Wahnsinn... Ich will gar nicht wissen, wie viel ihr euch genommen habt!",
      "emotion": "surprised",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    }
  ],
  "explicit": false,
