{
  "id": "ru-243e78289f74.de",
  "jokeId": "ru-243e78289f74",
  "locale": "de",
  "title": "Die Teigtaschen",
  "location": "kukhnya",
  "place": "home-kitchen",
  "cast": [
    "zhena",
    "devochka"
  ],
  "roles": {
    "zhena": "mother",
    "devochka": "daughter"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Es war einmal ein Mädchen, das verdammt noch mal gar nichts sah. Kurz gesagt: blind.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Jedes Mal beim Essen betastete das Mädchen lange ihren Teller und jammerte:",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "devochka",
      "text": "Na klar, wie immer habt ihr mir am wenigsten gegeben!",
      "emotion": "angry",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "devochka",
      "text": "Weil ich nichts sehe, kann man mich ja benachteiligen! Geizkragen...",
      "emotion": "sad",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "Der Mama reichte es, und sie beschloss, sich bei einem Psychologen Rat zu holen.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "doktor",
      "text": "Kochen Sie einen ganzen Bottich Teigtaschen! So viel wie für eine Hochzeit. Und dann soll sie essen!",
      "emotion": "smug",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "narrator",
      "text": "Am nächsten Tag stellt die Mama dem Mädchen einen riesigen Kübel Teigtaschen hin.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "narrator",
      "text": "Das Mädchen betastet die ordentliche Portion lange mit den Händen und sagt:",
      "emotion": "neutral",
      "pauseAfterSec": 0.7,
      "enter": [],
      "exit": []
    },
    {
      "id": "l9",
      "character": "devochka",
      "text": "Ich stell mir vor, wie verdammt viel ihr euch selbst aufgetan habt...",
      "emotion": "surprised",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
