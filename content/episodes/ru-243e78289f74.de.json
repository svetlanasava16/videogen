{
  "id": "ru-243e78289f74.de",
  "jokeId": "ru-243e78289f74",
  "locale": "de",
  "title": "Teigtaschen",
  "location": "kukhnya",
  "place": "home-kitchen",
  "cast": [
    "zhena",
    "devochka",
    "muzhik"
  ],
  "roles": {
    "zhena": "mother",
    "devochka": "daughter",
    "muzhik": "father"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Es war einmal ein Mädchen, das verdammt noch mal gar nichts sehen konnte. Kurz gesagt: blind.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Jedes Mal, wenn sich die Familie an den Tisch setzte und Mama das Essen auftrug, betastete das Mädchen lange ihren Teller mit den Händen und jammerte jedes Mal:",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "devochka",
      "text": "Na toll, wie immer hab ich am wenigsten gekriegt!",
      "emotion": "angry",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "devochka",
      "text": "Weil ich nichts sehe, kann man mich ja übers Ohr hauen! Geizhälse...",
      "emotion": "angry",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "Mama hatte das satt und ging zu einem Psychologen.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "doktor",
      "text": "Kochen Sie eine ganze Wanne voll Teigtaschen! Wie für eine Hochzeit. Und dann soll sie essen!",
      "emotion": "smug",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "narrator",
      "text": "Am nächsten Tag deckt Mama den Tisch und stellt dem Mädchen einen ganzen Eimer Teigtaschen hin.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "narrator",
      "text": "Das Mädchen setzt sich, zieht die riesige Portion zu sich, betastet sie lange und sagt:",
      "emotion": "neutral",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    },
    {
      "id": "l9",
      "character": "devochka",
      "text": "Ich kann mir vorstellen, wie viel ihr euch verdammt noch mal selbst aufgeschaufelt habt...",
      "emotion": "angry",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
