{
  "id": "ru-243e78289f74.de",
  "jokeId": "ru-243e78289f74",
  "locale": "de",
  "title": "Maultaschen",
  "location": "kukhnya",
  "place": "home-kitchen",
  "cast": [
    "muzhik",
    "devochka",
    "zhena"
  ],
  "roles": {
    "muzhik": "father",
    "devochka": "daughter",
    "zhena": "mother"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Es war einmal ein kleines Mädchen, das einen Dreck sah. Kurz gesagt: blind.",
      "uncensored": "Es war einmal ein kleines Mädchen, das einen Scheißdreck sah. Kurz gesagt: blind.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Jedes Mal, wenn die Familie sich zu Tisch setzte und die Mama das Essen auftrug, betastete das Mädchen lange mit den Händen, was auf dem Teller lag, und jammerte jedes Mal.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "devochka",
      "text": "Na toll, wie immer hab ich am wenigsten gekriegt!",
      "emotion": "angry",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "devochka",
      "text": "Nur weil ich nichts sehe, kann man mich ja benachteiligen!",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "devochka",
      "text": "Geizhälse...",
      "emotion": "angry",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "Die Mama hatte das alles satt und beschloss, einen Psychologen um Rat zu fragen.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "doktor",
      "text": "Kochen Sie einen ganzen Bottich Maultaschen!",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "doktor",
      "text": "So viel wie für eine ganze Dorfhochzeit.",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l9",
      "character": "doktor",
      "text": "Und dann soll sie essen!",
      "emotion": "happy",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l10",
      "character": "narrator",
      "text": "Am nächsten Tag deckt die Mama den Tisch und stellt dem Mädchen einen ganzen Eimer Maultaschen hin.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l11",
      "character": "narrator",
      "text": "Das Mädchen setzt sich, zieht eine ordentliche Portion Maultaschen zu sich heran, betastet sie lange mit den Händen und sagt.",
      "emotion": "neutral",
      "pauseAfterSec": 0.6,
      "enter": [],
      "exit": []
    },
    {
      "id": "l12",
      "character": "devochka",
      "text": "Ich will gar nicht wissen, wie viel ihr euch verdammt noch mal aufgeladen habt...",
      "uncensored": "Ich will gar nicht wissen, wie viel ihr euch verfickt noch mal aufgeladen habt...",
      "emotion": "sad",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
