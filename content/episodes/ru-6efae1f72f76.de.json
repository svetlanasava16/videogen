{
  "id": "ru-6efae1f72f76.de",
  "jokeId": "ru-6efae1f72f76",
  "locale": "de",
  "title": "Der dritte Wunsch",
  "kind": "joke",
  "v": 2,
  "location": "kukhnya",
  "place": "home-kitchen",
  "cast": [
    "muzhik",
    "chort"
  ],
  "roles": {
    "muzhik": "everyman",
    "chort": "genie"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein Mann sitzt in der Küche und raucht. Plötzlich erscheint aus dem Aschenbecher ein Dschinn.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "chort",
      "text": "So, und jetzt dein dritter Wunsch.",
      "emotion": "smug",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "muzhik",
      "text": "Wieso gleich der dritte? Es gab doch weder einen ersten noch einen zweiten!",
      "emotion": "surprised",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "chort",
      "text": "Du erinnerst dich einfach an nichts!",
      "emotion": "neutral",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l4b",
      "character": "chort",
      "text": "Dein zweiter Wunsch war, alles genau so zu machen, wie es vor dem ersten Wunsch war.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "chort",
      "text": "Deshalb kannst du dich an nichts über mich erinnern.",
      "emotion": "smug",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l6",
      "character": "muzhik",
      "text": "Na gut, ich überleg mir gleich was...",
      "emotion": "happy",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l6b",
      "character": "muzhik",
      "text": "Ah, ich will für alle Frauen der Unwiderstehlichste werden!",
      "emotion": "happy",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l7",
      "character": "narrator",
      "text": "Der Dschinn schnippt mit den Fingern.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l8",
      "character": "chort",
      "text": "Fertig!",
      "emotion": "happy",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l9",
      "character": "chort",
      "text": "Übrigens, genau das war auch dein erster Wunsch...",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
