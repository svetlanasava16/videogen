  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Three weeks after the wedding. A young wife calls her mother in tears.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "devushka-ryzhaya",
      "text": "Mom, I just don't know what to do! We've had such a family scene here! It's awful!",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "zhena",
      "text": "Calm down, sweetie, don't get upset. Every family has its first arguments and fights sooner or later.",
      "emotion": "neutral",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "devushka-ryzhaya",
      "text": "Yeah, I know that. But what do I do with the body?",
      "emotion": "neutral",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
