  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "A father is playing poker at home with his buddies. The pot is getting big, a round of betting is on.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "vovochka-drug",
      "text": "Oh, Daddy, are four aces good?",
      "emotion": "happy",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "muzhik",
      "text": "Yes! Son...",
      "emotion": "angry",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l4",
      "character": "narrator",
      "text": "Everyone folds at once, and Dad rakes in the whole pot.",
      "emotion": "neutral",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l5",
      "character": "vovochka-drug",
      "text": "Too bad, Daddy, that you didn't have them...",
      "emotion": "sad",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
