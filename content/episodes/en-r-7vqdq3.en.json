  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "A man wakes up after a heavy night of drinking to his wife happily cooking breakfast.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Confused, he approaches his daughter for an explanation of last night when he arrived home.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "devushka-ryzhaya",
      "text": "You kicked in the door when you couldn't get your key in the lock,",
      "uncensored": "You kicked in the door when you couldn't get your key in the lock,",
      "emotion": "smug",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l3b",
      "character": "devushka-ryzhaya",
      "text": "fell through the table and broke it, and peed your pants.",
      "uncensored": "fell through the table and broke it, and pissed your pants.",
      "emotion": "smug",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "Geez! So then why the hell is she in such a good mood?",
      "uncensored": "Jesus! So then why the hell is she in such a good mood?",
      "emotion": "surprised",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l5",
      "character": "devushka-ryzhaya",
      "text": "When she tried to take your pants off to wash them,",
      "emotion": "smug",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l5b",
      "character": "devushka-ryzhaya",
      "text": "you slapped her hand away and said,",
      "emotion": "smug",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l6",
      "character": "devushka-ryzhaya",
      "text": "Get your hands off me! I'm married!",
      "emotion": "happy",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
