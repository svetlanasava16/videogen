    {
      "id": "l1",
      "character": "narrator",
      "text": "Kommt ein Mann aufs Arbeitsamt.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "muzhik",
      "text": "Haben Sie 'nen Job für mich?",
      "emotion": "happy",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "paren",
      "text": "Natürlich. Das wäre eine Halbtagsstelle, Dienstwagen, Dienstwohnung, vierzig Tage Urlaub.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "paren",
      "text": "Keine besondere Ausbildung, fünftausend im Monat.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l5",
      "character": "muzhik",
      "text": "Sagen Sie mal, Sie wollen mich wohl veräppeln?!",
      "uncensored": "Sagen Sie mal, Sie wollen mich wohl verarschen?!",
      "emotion": "angry",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l6",
      "character": "paren",
      "text": "Ja wer hat denn mit dem Mist angefangen?!!",
      "uncensored": "Ja wer hat denn mit dem Scheiß angefangen?!!",
      "emotion": "angry",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
