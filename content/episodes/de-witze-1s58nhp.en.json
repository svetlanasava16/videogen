  ],
  "roles": {
    "zhena": "mother",
    "vovochka": "vovochka",
    "devushka": "woman"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Johnny has to go with his mother to see the neighbor, who has just had a baby.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "zhena",
      "text": "The baby has no ears!",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "zhena",
      "text": "When we go over there, don't you dare say anything about it. Do you understand?",
      "emotion": "angry",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l4",
      "character": "narrator",
      "text": "The two of them go over to the proud mother, and she shows them the baby right away.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "vovochka",
      "text": "The baby has such a lovely mouth!",
      "emotion": "happy",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l6",
      "character": "devushka",
      "text": "Yes, so that later on he can talk and speak nicely!",
      "emotion": "happy",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l7",
      "character": "vovochka",
      "text": "The baby has such a lovely nose!",
      "emotion": "happy",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l8",
      "character": "devushka",
      "text": "Yes, so that later on he can smell well!",
      "emotion": "smug",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l9",
      "character": "vovochka",
      "text": "The baby has such lovely eyes!",
      "emotion": "happy",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l10",
      "character": "devushka",
      "text": "Yes, so that later on he can see well!",
      "emotion": "angry",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l11",
      "character": "vovochka",
      "text": "Well, he won't be able to wear glasses anyway!",
      "emotion": "neutral",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
