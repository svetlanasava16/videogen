{
  "id": "en-r-9phvd8.de",
  "jokeId": "en-r-9phvd8",
  "locale": "de",
  "title": "Das Rezept",
  "location": "magazin",
  "place": "pharmacy",
  "cast": [
    "zhena",
    "doktor"
  ],
  "roles": {
    "zhena": "wife",
    "doktor": "pharmacist"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Eine nette, ruhige und anständige Dame ging in die Apotheke, direkt zum Apotheker, und sah ihm fest in die Augen.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "zhena",
      "text": "Ich möchte gern etwas Zyankali kaufen.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "doktor",
      "text": "Wozu um alles in der Welt brauchen Sie Zyankali?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "zhena",
      "text": "Ich brauche es, um meinen Mann zu vergiften.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "doktor",
      "text": "Gott steh mir bei! Ich kann Ihnen doch kein Zyankali geben, damit Sie Ihren Mann umbringen!",
      "emotion": "surprised",
      "pauseAfterSec": 0.2,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "doktor",
      "text": "Das ist gegen das Gesetz! Ich verliere meine Zulassung! Die sperren uns beide ein!",
      "emotion": "angry",
      "pauseAfterSec": 0.2,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "doktor",
      "text": "Alle möglichen schlimmen Dinge werden passieren. Auf keinen Fall! Sie bekommen kein Zyankali!",
      "emotion": "angry",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "narrator",
      "text": "Die Dame griff in ihre Handtasche und zog ein Foto heraus: ihr Mann im Bett mit der Frau des Apothekers.",
      "emotion": "neutral",
      "pauseAfterSec": 0.9,
      "enter": [],
      "exit": []
    },
    {
      "id": "l9",
      "character": "doktor",
      "text": "Na, so was. Das ist natürlich etwas anderes. Sie haben mir nicht gesagt, dass Sie ein Rezept haben.",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
