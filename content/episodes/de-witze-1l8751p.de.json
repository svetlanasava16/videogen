  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Kommt ein Mann zum Arzt.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "muzhik",
      "text": "Herr Doktor, ich fühl mich die letzten Wochen immer so matt und schlaff, was kann das sein?",
      "emotion": "sad",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "doktor",
      "text": "Was machen Sie denn beruflich?",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "Beamter.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "doktor",
      "text": "Ah, und in den letzten Wochen, wie war es da so?",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l6",
      "character": "muzhik",
      "text": "Also, eigentlich bin ich zur Zeit im Urlaub...",
      "emotion": "sad",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l7",
      "character": "doktor",
      "text": "Na dann ist ja alles klar, Ihnen fehlt der Schlaf!",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
