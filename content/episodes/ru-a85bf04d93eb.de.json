  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein dicker Mercedes fährt hinten auf eine Straßenwalze auf.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Ein riesiger Kerl steigt aus und ruft mit dem Handy seinen Verkehrspolizisten an.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "Nach einer Weile hält ein Streifenwagen, ein Polizist steigt aus,",
      "emotion": "neutral",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l3b",
      "character": "narrator",
      "text": "geht zum Fahrer der Walze, nimmt ihn beiseite und flüstert vertraulich:",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "sluzhivy",
      "text": "Na, erzähl mal.",
      "emotion": "smug",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l5",
      "character": "sluzhivy",
      "text": "Wie du ihn überholt hast... Wie du ihn geschnitten hast...",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
