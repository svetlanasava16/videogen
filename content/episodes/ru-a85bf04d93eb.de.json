    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein dicker Mercedes kracht von hinten in eine Straßenwalze.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "nachalnik",
      "text": "Hallo, ich bin's. Hier hat mir eine Straßenwalze den Weg versperrt. Komm her und regel das.",
      "emotion": "angry",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "Bald hält ein Streifenwagen, und der Polizist nimmt den Walzenfahrer zur Seite.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [
        "sluzhivy"
      ],
      "exit": []
    },
    {
      "id": "l4",
      "character": "sluzhivy",
      "text": "So, mein Freund. Jetzt erzähl mal.",
      "emotion": "smug",
      "pauseAfterSec": 0.7,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "sluzhivy",
      "text": "Wie du ihn überholt hast. Wie du ihn geschnitten hast.",
      "emotion": "smug",
