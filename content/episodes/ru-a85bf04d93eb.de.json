  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein Mercedes S-Klasse fährt einer Straßenwalze hinten drauf.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Aus dem Wagen steigt ein riesiger Kerl und ruft mit dem Handy seinen eigenen Verkehrspolizisten an.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "Nach einer Weile hält ein Streifenwagen, der Polizist steigt aus, geht zum Fahrer der Walze, nimmt ihn beiseite und flüstert vertraulich:",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "sluzhivy",
      "text": "Na, erzähl mal.",
      "emotion": "smug",
      "pauseAfterSec": 0.6,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "sluzhivy",
      "text": "Wie du überholt hast... Wie du ihn geschnitten hast...",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
