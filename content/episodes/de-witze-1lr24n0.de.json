  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein Typ in einem Porsche fährt neben einen Lastwagen und ruft dem Fahrer zu:",
      "emotion": "neutral",
      "pauseAfterSec": 0.2
    },
    {
      "id": "l2",
      "character": "nachalnik",
      "text": "Mein Name ist Klausi, verdien am Tag nen Tausi,",
      "emotion": "smug",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l2b",
      "character": "nachalnik",
      "text": "neben mir sitzt meine Mausi und du verlierst Ladung!",
      "emotion": "smug",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "Der LKW-Fahrer fährt kopfschüttelnd weiter. Da kommt der Porschefahrer wieder angefahren:",
      "emotion": "neutral",
      "pauseAfterSec": 0.2
    },
    {
      "id": "l4",
      "character": "nachalnik",
      "text": "Mein Name ist Klausi, verdien am Tag nen Tausi,",
      "emotion": "smug",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l4b",
      "character": "nachalnik",
      "text": "neben mir sitzt meine Mausi und du verlierst Ladung!",
      "emotion": "smug",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "Erneut fährt der LKW-Fahrer weiter. Nachdem sich das ein paarmal wiederholt hat, wird's dem LKW-Fahrer zu bunt und er schreit zurück:",
      "emotion": "neutral",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l6",
      "character": "muzhik-ryzhy",
      "text": "Mein Name ist Günter, es ist Winter und das ist ein Streufahrzeug!",
      "emotion": "angry",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
