{
  "id": "en-r-7rbqew.ru",
  "jokeId": "en-r-7rbqew",
  "locale": "ru",
  "title": "Говорящие часы",
  "location": "gostinaya",
  "place": "home-living-room",
  "cast": [
    "muzhik",
    "muzhik-sosed",
    "paren"
  ],
  "roles": {
    "muzhik": "everyman",
    "muzhik-sosed": "friend",
    "paren": "friend"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Мужик хвастается новой квартирой.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "После вечера в баре он приводит к себе друзей, а у него там большой медный гонг и колотушка.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "muzhik-sosed",
      "text": "А зачем тебе гонг с колотушкой?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "Это не гонг, это говорящие часы.",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "muzhik-sosed",
      "text": "Говорящие часы? Серьёзно?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "muzhik",
      "text": "Ага.",
      "emotion": "smug",
      "pauseAfterSec": 0.2,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "muzhik-sosed",
      "text": "И как они работают?",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "muzhik",
      "text": "Смотри.",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l9",
      "character": "narrator",
      "text": "Он взял колотушку и со всей силы ударил в гонг, отступив назад, пока грохот разносился по комнате.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l10",
      "character": "narrator",
      "text": "Друзья в полном недоумении уставились на него.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l11",
      "character": "narrator",
      "text": "И вдруг кто-то за стеной заорал:",
      "emotion": "neutral",
      "pauseAfterSec": 0.6,
      "enter": [],
      "exit": []
    },
    {
      "id": "l12",
      "character": "muzhik-ryzhy",
      "text": "Ах ты гад! Три часа ночи!",
      "emotion": "angry",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
