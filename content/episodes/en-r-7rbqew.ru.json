{
  "id": "en-r-7rbqew.ru",
  "jokeId": "en-r-7rbqew",
  "locale": "ru",
  "title": "Говорящие часы",
  "kind": "joke",
  "v": 2,
  "location": "gostinaya",
  "place": "home-living-room",
  "cast": [
    "muzhik-sosed",
    "muzhik",
    "paren",
    "muzhik-ryzhy"
  ],
  "roles": {
    "muzhik-sosed": "friend",
    "muzhik": "everyman",
    "paren": "friend",
    "muzhik-ryzhy": "neighbor"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Мужик хвастается своей новой квартирой.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "После вечера в баре он приводит к себе друзей, а у него там большой медный гонг и колотушка.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "muzhik-sosed",
      "text": "А зачем тебе гонг с колотушкой?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "Это не гонг, это говорящие часы.",
      "emotion": "smug",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "paren",
      "text": "Говорящие часы? Серьёзно?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l6",
      "character": "muzhik",
      "text": "Ага.",
      "emotion": "smug",
      "pauseAfterSec": 0.2
    },
    {
      "id": "l7",
      "character": "muzhik-sosed",
      "text": "И как они работают?",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l8",
      "character": "muzhik",
      "text": "Смотри.",
      "emotion": "happy",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l9",
      "character": "narrator",
      "text": "Он взял колотушку, со всей силы ударил в гонг и отступил назад, а грохот разнёсся по всей комнате.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l10",
      "character": "narrator",
      "text": "Друзья смотрели на него в полном недоумении.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l11",
      "character": "narrator",
      "text": "И вдруг кто-то за стеной заорал:",
      "emotion": "neutral",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l12",
      "character": "muzhik-ryzhy",
      "text": "Ах ты гад! Три часа ночи!",
      "offscreen": true,
      "emotion": "angry",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
  "explicit": false,
