{
  "id": "ru-270a3709d3da.de",
  "jokeId": "ru-270a3709d3da",
  "locale": "de",
  "title": "Der Onkel",
  "kind": "joke",
  "v": 2,
  "location": "gostinaya",
  "place": "street",
  "cast": [
    "muzhik",
    "ded",
    "zhena"
  ],
  "roles": {
    "muzhik": "husband",
    "zhena": "wife",
    "ded": "old-man"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Es waren einmal ein Mann und eine Frau, und sie hätten sehr glücklich gelebt, aber bei ihnen zog ein Verwandter ein: ein Onkel.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Dieser liebe Onkel entpuppte sich als ein großer Mistkerl.",
      "emotion": "angry",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "Ständig war er mit allem unzufrieden: mal verdiente die Familie zu wenig,",
      "emotion": "angry",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l3b",
      "character": "narrator",
      "text": "mal schmeckte das Essen nicht, mal bekam er zu wenig Aufmerksamkeit.",
      "emotion": "angry",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "narrator",
      "text": "Mit seinen Launen machte er alle fertig. Aber die Familie war taktvoll und ertrug das alles.",
      "emotion": "sad",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "Endlich starb der alte Schmarotzer.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "Und auf dem Heimweg von der Beerdigung sagte der Mann zu seiner Frau:",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l7",
      "character": "muzhik",
      "text": "Ich muss dir gestehen, Liebling: Wenn ich dich nicht so sehr lieben würde,",
      "emotion": "sad",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l7b",
      "character": "muzhik",
      "text": "hätte ich diesen Onkel von dir längst rausgeworfen.",
      "emotion": "sad",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l8",
      "character": "narrator",
      "text": "Da fällt die Frau beinahe um:",
      "emotion": "surprised",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l9",
      "character": "zhena",
      "text": "Was? Meinen Onkel? Ich war immer sicher, dass das dein Onkel ist!",
      "emotion": "surprised",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
