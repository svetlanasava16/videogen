{
  "id": "ru-270a3709d3da.de",
  "jokeId": "ru-270a3709d3da",
  "locale": "de",
  "title": "Wessen Onkel",
  "location": "gostinaya",
  "place": "street",
  "cast": [
    "muzhik",
    "ded",
    "zhena"
  ],
  "roles": {
    "muzhik": "husband",
    "ded": "old-man",
    "zhena": "wife"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Es waren einmal ein Mann und eine Frau, und sie hätten sehr glücklich gelebt, aber bei ihnen zog ein Verwandter ein: ein Onkel.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Dieser Onkel entpuppte sich als echter Mistkerl. Immer war er mit allem unzufrieden: mal verdiente die Familie zu wenig, mal schmeckte das Essen nicht, mal bekam er zu wenig Aufmerksamkeit.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "Mit seinen Launen ging er allen gewaltig auf die Nerven. Aber die Familie war taktvoll und ertrug alles.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "narrator",
      "text": "Endlich starb der alte Schmarotzer.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "Und auf dem Heimweg von der Beerdigung sagte der Mann zu seiner Frau:",
      "emotion": "neutral",
      "pauseAfterSec": 0.2,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "muzhik",
      "text": "Ich gestehe dir, Liebling: Wenn ich dich nicht so sehr lieben würde, hätte ich diesen Onkel von dir längst rausgeworfen.",
      "emotion": "sad",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "zhena",
      "text": "Wie bitte? Meinen Onkel?",
      "emotion": "surprised",
      "pauseAfterSec": 0.6,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "zhena",
      "text": "Ich war immer überzeugt, dass das dein Onkel ist!",
      "emotion": "surprised",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
