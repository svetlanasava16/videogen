  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "A new tenant asks his upstairs neighbour.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "paren",
      "text": "Say, you've got exactly the same flat as me.",
      "emotion": "neutral",
      "pauseAfterSec": 0.2
    },
    {
      "id": "l3",
      "character": "paren",
      "text": "How many rolls of wallpaper did you buy to paper the hallway?",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "muzhik-sosed",
      "text": "Ten rolls.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "A week later the two of them meet in the stairwell.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l6",
      "character": "paren",
      "text": "Hey, I had five rolls left over, though.",
      "emotion": "surprised",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l7",
      "character": "muzhik-sosed",
      "text": "Yeah, so did I back then.",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
