{
  "id": "en-r-60ivsm.de",
  "jokeId": "en-r-60ivsm",
  "locale": "de",
  "title": "Anhalten oder abbremsen",
  "location": "doroga",
  "place": "road",
  "cast": [
    "nachalnik",
    "sluzhivy"
  ],
  "roles": {
    "nachalnik": "lawyer",
    "sluzhivy": "traffic-cop"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein Anwalt wird von einem Polizisten angehalten.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "sluzhivy",
      "text": "Wissen Sie, warum ich Sie angehalten habe?",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "nachalnik",
      "text": "Nicht die leiseste Ahnung.",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "sluzhivy",
      "text": "Sie haben da hinten am Stoppschild nicht vollständig angehalten. Sie haben nur abgebremst.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "nachalnik",
      "text": "Wenn Sie mir den Unterschied zwischen Anhalten und Abbremsen beweisen können, übernehme ich die volle Verantwortung.",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "nachalnik",
      "text": "Andernfalls lassen Sie mich mit einer Verwarnung davonkommen. Klingt fair?",
      "emotion": "smug",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "sluzhivy",
      "text": "Klingt fair. Würden Sie bitte aus dem Auto steigen?",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "narrator",
      "text": "Kaum ist der Anwalt ausgestiegen und hat die Autotür zugeschlagen, zieht der Polizist seinen Schlagstock und prügelt auf ihn ein.",
      "emotion": "neutral",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    },
    {
      "id": "l9",
      "character": "sluzhivy",
      "text": "So, soll ich jetzt anhalten oder abbremsen?",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
