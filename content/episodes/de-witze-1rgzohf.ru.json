  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Две блондинки гуляют по лесу и выходят на поляну.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "На поляне ещё две блондинки сидят в лодке прямо на земле и как бешеные гребут по воздуху.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l3",
      "character": "devushka-blondinka",
      "text": "Ого, глянь на этих двух дур, это как раз из-за таких у нас такая репутация.",
      "emotion": "angry",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l4",
      "character": "devushka",
      "text": "Точно, сейчас доплыву до них и врежу как следует.",
      "emotion": "angry",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
