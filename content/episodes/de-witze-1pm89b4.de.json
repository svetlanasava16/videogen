  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Josef und Maria suchen eine Herberge. Josef klopft schon an die zwölfte Tür.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "ded",
      "text": "Habt Ihr ein Quartier für mich und meine Frau?",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "barmen",
      "text": "Nein, alles ausgebucht.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "ded",
      "text": "Aber seht doch, meine Frau ist hochschwanger!",
      "emotion": "sad",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "barmen",
      "text": "Dafür kann ich doch nichts!",
      "emotion": "angry",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l6",
      "character": "ded",
      "text": "Ich doch auch nicht!",
      "emotion": "surprised",
      "pauseAfterSec": 0.8
    }
  ],
