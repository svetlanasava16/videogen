{
  "id": "ru-9cc0dee1c1f9.de",
  "jokeId": "ru-9cc0dee1c1f9",
  "locale": "de",
  "title": "Diebe im Schuppen",
  "kind": "joke",
  "v": 2,
  "location": "derevnya",
  "place": "garden",
  "cast": [
    "muzhik",
    "uchilka",
    "vor",
    "paren",
    "sluzhivy",
    "sluzhivy-ryadovoy"
  ],
  "roles": {
    "vor": "thief",
    "paren": "thief",
    "muzhik": "everyman",
    "sluzhivy": "police-officer",
    "sluzhivy-ryadovoy": "police-officer",
    "uchilka": "operator"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein Mann kommt spätabends nach Hause und sieht durch einen Spalt in der Schuppentür im Hof das Licht einer Taschenlampe.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Er ruft sofort die Polizei an.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "muzhik",
      "text": "Hallo, Polizei? In meinem Schuppen wühlt jemand herum, ich glaube, das sind Diebe!",
      "emotion": "surprised",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "uchilka",
      "text": "Mein Herr, leider sind gerade alle Streifenwagen im Einsatz.",
      "emotion": "neutral",
      "pauseAfterSec": 0.2
    },
    {
      "id": "l5",
      "character": "uchilka",
      "text": "Wir schicken eine Streife, sobald jemand frei wird, in ein, zwei Stunden...",
      "emotion": "neutral",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "Der Mann legt auf und ruft drei Minuten später wieder bei der Polizei an.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l7",
      "character": "muzhik",
      "text": "Hallo, ich bin's noch mal.",
      "emotion": "neutral",
      "pauseAfterSec": 0.2
    },
    {
      "id": "l8",
      "character": "muzhik",
      "text": "Da Sie keine freie Streife haben, musste ich die Diebe selbst erschießen.",
      "emotion": "smug",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l9",
      "character": "muzhik",
      "text": "Wenn die Streife also frei wird, schicken Sie gleich noch zwei,",
      "emotion": "smug",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l9b",
      "character": "muzhik",
      "text": "drei Krankenwagen mit, um die Leichen abzuholen.",
      "emotion": "smug",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l10",
      "character": "narrator",
      "text": "Eine Minute später rasen mit heulenden Sirenen etwa fünf Polizeiautos vor das Haus.",
      "emotion": "surprised",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l11",
      "character": "narrator",
      "text": "Der Hof füllt sich im Nu mit bewaffneten Polizisten, die verängstigten Diebe stürzen aus dem Schuppen und ergeben sich.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l12",
      "character": "sluzhivy",
      "text": "Sie haben gesagt, hier liegen mindestens drei Leichen!",
      "emotion": "angry",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l13",
      "character": "muzhik",
      "text": "Na, und Sie haben gesagt, in der ganzen Gegend gibt es keine freie Streife...",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
