{
  "id": "ru-9cc0dee1c1f9.de",
  "jokeId": "ru-9cc0dee1c1f9",
  "locale": "de",
  "title": "Drei Leichen",
  "location": "derevnya",
  "place": "garden",
  "cast": [
    "muzhik",
    "sluzhivy",
    "vor"
  ],
  "roles": {
    "muzhik": "everyman",
    "sluzhivy": "police-officer",
    "vor": "thief"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Spätabends sieht ein Mann Taschenlampenlicht in seinem Schuppen.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "muzhik",
      "text": "Hallo, Polizei? In meinem Schuppen sind Einbrecher!",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "Die Zentrale sagt: Alle Streifenwagen sind im Einsatz. In ein, zwei Stunden vielleicht.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "Hallo, ich bin's nochmal. Da ja keiner frei ist, hab ich sie selbst erschossen.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "muzhik",
      "text": "Schicken Sie also gleich ein paar Krankenwagen mit. Für die Leichen.",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "Eine Minute später wimmelt der Hof von Polizei. Die Einbrecher kommen raus und ergeben sich.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [
        "vor"
      ],
      "exit": []
    },
    {
      "id": "l7",
      "character": "sluzhivy",
      "text": "Sie sagten, hier liegen mindestens drei Leichen!",
      "emotion": "angry",
      "pauseAfterSec": 0.7,
      "enter": [
        "sluzhivy"
      ],
      "exit": []
    },
    {
      "id": "l8",
      "character": "muzhik",
      "text": "Und Sie sagten, es ist keiner frei.",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    }
  ],
  "outroLaughs": [],
  "format": {
    "width": 1080,
    "height": 1920,
    "fps": 30
  }
}
