{
  "id": "ru-9cc0dee1c1f9.de",
  "jokeId": "ru-9cc0dee1c1f9",
  "locale": "de",
  "title": "Keine freie Streife",
  "location": "derevnya",
  "place": "garden",
  "cast": [
    "muzhik"
  ],
  "roles": {
    "muzhik": "everyman"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein Mann kommt spät abends nach Hause und sieht im Schuppen das Licht einer Taschenlampe.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "muzhik",
      "text": "Hallo, Polizei? In meinem Schuppen stöbert jemand herum, ich glaube, das sind Einbrecher!",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "uchilka",
      "text": "Mein Herr, leider sind gerade alle Streifenwagen im Einsatz, wir schicken eine Streife, sobald jemand frei ist, in ein, zwei Stunden...",
      "emotion": "neutral",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "narrator",
      "text": "Drei Minuten später ruft er wieder an.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "muzhik",
      "text": "Hallo, ich bin's noch mal.",
      "emotion": "neutral",
      "pauseAfterSec": 0.2,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "muzhik",
      "text": "Da Sie keine freie Streife haben, musste ich die Einbrecher selbst erschießen.",
      "emotion": "smug",
      "pauseAfterSec": 0.2,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "muzhik",
      "text": "Wenn Ihre Streife also frei ist, schicken Sie gleich zwei, drei Krankenwagen mit, um die Leichen abzuholen.",
      "emotion": "smug",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "narrator",
      "text": "Eine Minute später rasen fünf Streifenwagen mit Sirenen vors Haus.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l9",
      "character": "narrator",
      "text": "Die Einbrecher stürzen aus dem Schuppen und ergeben sich.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l10",
      "character": "sluzhivy",
      "text": "Sie sagten, hier lägen mindestens drei Leichen!",
      "emotion": "angry",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    },
    {
      "id": "l11",
      "character": "muzhik",
      "text": "Na, und Sie sagten, in der ganzen Gegend gäbe es keine freie Streife...",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
