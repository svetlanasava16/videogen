    {
      "id": "l1",
      "character": "narrator",
      "text": "Mitten in der Nacht wird der Arzt zu einem Notfall gerufen.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [
        "doktor"
      ],
      "exit": []
    },
    {
      "id": "l2",
      "character": "doktor",
      "text": "Haben Sie schon Ihr Testament gemacht?",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "muzhik",
      "text": "Nein. Steht es denn wirklich so schlimm um mich?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "doktor",
      "text": "Lassen Sie sofort einen Notar kommen. Und rufen Sie Ihre nächsten Verwandten her!",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "muzhik",
      "text": "Heißt das, es geht mit mir zu Ende?",
      "emotion": "sad",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "doktor",
      "text": "Das nicht. Aber ich will nicht der Einzige sein, der mitten in der Nacht sinnlos aus dem Bett geholt wird.",
      "emotion": "angry",
