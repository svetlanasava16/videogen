{
  "id": "de-witze-1pdcxm0.de",
  "jokeId": "de-witze-1pdcxm0",
  "locale": "de",
  "title": "Hausbesuch zu später Stunde",
  "kind": "joke",
  "v": 2,
  "location": "spalnya",
  "place": "bedroom",
  "cast": [
    "doktor",
    "muzhik"
  ],
  "roles": {
    "doktor": "doctor",
    "muzhik": "patient"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Mitten in der Nacht wird der Arzt zu einem Notfall gerufen. Nachdem er den Patienten gründlich untersucht hat, sagt er schließlich:",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "doktor",
      "text": "Haben Sie schon Ihr Testament gemacht?",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "muzhik",
      "text": "Nein, das habe ich nicht. Steht es denn wirklich so schlimm um mich?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "doktor",
      "text": "Lassen Sie sofort einen Notar kommen und rufen Sie Ihre nächsten Verwandten her!",
      "emotion": "angry",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "muzhik",
      "text": "Heißt das, dass es mit mir zu Ende geht?",
      "emotion": "sad",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l6",
      "character": "doktor",
      "text": "Das nicht, aber ich will nicht der Einzige sein,",
      "emotion": "smug",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l6b",
      "character": "doktor",
      "text": "der mitten in der Nacht sinnlos aus dem Bett geholt wird.",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
  "explicit": false,
