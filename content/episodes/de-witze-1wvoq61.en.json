  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "A chicken walks into a hardware store.",
      "emotion": "neutral",
      "pauseAfterSec": 0.2
    },
    {
      "id": "l2",
      "character": "ptitsa",
      "text": "Do you have any spackle?",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "barmen",
      "text": "No, sorry.",
      "emotion": "surprised",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "narrator",
      "text": "The next day the chicken comes back.",
      "emotion": "neutral",
      "pauseAfterSec": 0.2
    },
    {
      "id": "l5",
      "character": "ptitsa",
      "text": "Do you have any spackle?",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l6",
      "character": "barmen",
      "text": "No, we don't!",
      "emotion": "angry",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l7",
      "character": "narrator",
      "text": "On the third day the chicken comes back again.",
      "emotion": "neutral",
      "pauseAfterSec": 0.2
    },
    {
      "id": "l8",
      "character": "ptitsa",
      "text": "Do you have any spackle?",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l9",
      "character": "barmen",
      "text": "Listen here, you bag of feathers!",
      "emotion": "angry",
      "pauseAfterSec": 0.2
    },
    {
      "id": "l10",
      "character": "barmen",
      "text": "If you ask me for spackle one more time, I'll nail your feet to the counter!",
      "emotion": "angry",
      "pauseAfterSec": 0.4,
      "laugh": "chuckle"
    },
    {
      "id": "l11",
      "character": "narrator",
      "text": "On the fourth day the chicken comes back.",
      "emotion": "neutral",
      "pauseAfterSec": 0.2
    },
    {
      "id": "l12",
      "character": "ptitsa",
      "text": "Do you have any nails?",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l13",
      "character": "barmen",
      "text": "No, not today.",
      "emotion": "smug",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l14",
      "character": "ptitsa",
      "text": "Good... Do you have any spackle?",
      "emotion": "happy",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
