{
  "id": "de-witze-1qeyycq.ru",
  "jokeId": "de-witze-1qeyycq",
  "locale": "ru",
  "title": "Доброе дело",
  "kind": "joke",
  "v": 2,
  "location": "nebesa",
  "place": "heaven",
  "cast": [
    "ded",
    "paren"
  ],
  "roles": {
    "ded": "saint-peter",
    "paren": "everyman"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Молодой человек стоит у небесных врат.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "ded",
      "text": "Совершил ли ты доброе дело, которое дало бы тебе право войти в Царствие Небесное?",
      "emotion": "neutral",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l3",
      "character": "paren",
      "text": "Я помог двум красивым девушкам, к которым приставала банда байкеров!",
      "emotion": "happy",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "ded",
      "text": "И как именно тебе это удалось?",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "paren",
      "text": "Ну, я смело встал перед ними и дал байкерам понять, что я этого не допущу!",
      "emotion": "smug",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l6",
      "character": "ded",
      "text": "И когда же это было?",
      "emotion": "surprised",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l7",
      "character": "paren",
      "text": "Минуты три назад.",
      "emotion": "sad",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
  "explicit": false,
