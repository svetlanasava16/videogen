    {
      "id": "l1",
      "character": "muzhik-sosed",
      "text": "Ты часто ставишь людей в неловкое положение,",
      "emotion": "sad",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l1b",
      "character": "muzhik-sosed",
      "text": "потому что нарушаешь их личное пространство.",
      "emotion": "sad",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l2",
      "character": "muzhik",
      "text": "Это было невероятно обидно…",
      "emotion": "sad",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l3",
      "character": "muzhik",
      "text": "…и напрочь испортило нам всю ванну.",
      "emotion": "angry",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
