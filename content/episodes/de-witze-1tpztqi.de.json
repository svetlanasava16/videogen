{
  "id": "de-witze-1tpztqi.de",
  "jokeId": "de-witze-1tpztqi",
  "locale": "de",
  "title": "Goldene Hochzeit",
  "location": "gostinaya",
  "place": "restaurant",
  "cast": [
    "ded",
    "tyoshcha"
  ],
  "roles": {
    "ded": "husband",
    "tyoshcha": "wife"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein Ehepaar feiert seinen fünfzigsten Hochzeitstag.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Sie sitzen beim romantischen Abendessen.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "ded",
      "text": "Schatz, wir sind jetzt ein halbes Jahrhundert zusammen.",
      "emotion": "happy",
      "pauseAfterSec": 0.2,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "ded",
      "text": "In all den Jahren gab es nie Geheimnisse zwischen uns.",
      "emotion": "neutral",
      "pauseAfterSec": 0.2,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "ded",
      "text": "Aber eine Sache geht mir einfach nicht aus dem Kopf...",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "tyoshcha",
      "text": "Was denn, mein Liebster?",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "ded",
      "text": "Unser achtes Kind, der Michael.",
      "emotion": "neutral",
      "pauseAfterSec": 0.2,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "ded",
      "text": "Er sieht völlig anders aus als seine sieben älteren Geschwister.",
      "emotion": "neutral",
      "pauseAfterSec": 0.2,
      "enter": [],
      "exit": []
    },
    {
      "id": "l9",
      "character": "ded",
      "text": "Er hat rote Haare, ist zwei Köpfe größer und hat ganz andere Züge.",
      "emotion": "neutral",
      "pauseAfterSec": 0.2,
      "enter": [],
      "exit": []
    },
    {
      "id": "l10",
      "character": "ded",
      "text": "Bitte sei ehrlich zu mir... hat er einen anderen Vater?",
      "emotion": "sad",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l11",
      "character": "narrator",
      "text": "Die Ehefrau senkt beschämt den Blick und bricht in Tränen aus.",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l12",
      "character": "tyoshcha",
      "text": "Ja, es tut mir so leid...",
      "emotion": "sad",
      "pauseAfterSec": 0.2,
      "enter": [],
      "exit": []
    },
    {
      "id": "l13",
      "character": "tyoshcha",
      "text": "Ja, er hat einen anderen Vater.",
      "emotion": "sad",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l14",
      "character": "narrator",
      "text": "Der Mann schluckt schwer, den Tränen nahe, versucht aber tapfer zu bleiben.",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l15",
      "character": "ded",
      "text": "Na gut... nach all den Jahren verzeihe ich dir.",
      "emotion": "sad",
      "pauseAfterSec": 0.2,
      "enter": [],
      "exit": []
    },
    {
      "id": "l16",
      "character": "ded",
      "text": "Aber sag mir: Wer ist es?",
      "emotion": "sad",
      "pauseAfterSec": 0.9,
      "enter": [],
      "exit": []
    },
    {
      "id": "l17",
      "character": "tyoshcha",
      "text": "Du.",
      "emotion": "sad",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
