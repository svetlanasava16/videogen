  "lines": [
    {
      "id": "l1",
      "character": "muzhik",
      "text": "Schatz, wir sind jetzt ein halbes Jahrhundert zusammen. Wir hatten nie Geheimnisse voreinander.",
      "emotion": "happy",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "muzhik",
      "text": "Aber eine Sache geht mir nicht aus dem Kopf.",
      "emotion": "sad",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "zhena",
      "text": "Was denn, mein Liebster?",
      "emotion": "happy",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "Unser Achtes, der Michael. Er sieht ganz anders aus als seine sieben Geschwister. Rote Haare, zwei Köpfe größer.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "muzhik",
      "text": "Sei ehrlich zu mir. Hat er einen anderen Vater?",
      "emotion": "sad",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l6",
      "character": "zhena",
      "text": "Ja, es tut mir so leid. Er hat einen anderen Vater.",
      "emotion": "sad",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l7",
      "character": "muzhik",
      "text": "Nach all den Jahren verzeihe ich dir. Aber sag mir, wer ist es?",
      "emotion": "sad",
      "pauseAfterSec": 0.8
    },
    {
      "id": "l8",
      "character": "zhena",
      "text": "Du.",
      "emotion": "sad",
      "pauseAfterSec": 0.8
    }
  ],
  "format": {
    "width": 1080,
    "height": 1920,
    "fps": 30
  }
}
