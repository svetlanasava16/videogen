{
  "id": "de-witze-1wrzxbf.en",
  "jokeId": "de-witze-1wrzxbf",
  "locale": "en",
  "title": "Silent but Harmless",
  "location": "bolnitsa",
  "place": "doctor-office",
  "cast": [
    "tyoshcha",
    "doktor"
  ],
  "roles": {
    "tyoshcha": "old-woman",
    "doktor": "doctor"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "An old lady is at the doctor's, complaining about terrible gas.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "tyoshcha",
      "text": "You know, doctor, I have gas all the time.",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "tyoshcha",
      "text": "Luckily, it's always silent and doesn't smell at all.",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "tyoshcha",
      "text": "Look, one just slipped out again. You can't even tell.",
      "emotion": "happy",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": [],
      "laugh": "chuckle"
    },
    {
      "id": "l5",
      "character": "doktor",
      "text": "I'll prescribe you some medicine. Take it and come back in two weeks.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": [
        "tyoshcha"
      ]
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "No sooner said than done. Two weeks later the lady is back at the doctor's, complaining.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [
        "tyoshcha"
      ],
      "exit": []
    },
    {
      "id": "l7",
      "character": "tyoshcha",
      "text": "Doctor, what on earth did you prescribe me?",
      "emotion": "angry",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "tyoshcha",
      "text": "The gas isn't any better, but now it smells awful!",
      "emotion": "angry",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l9",
      "character": "doktor",
      "text": "Very good, your nose is fine.",
      "emotion": "happy",
      "pauseAfterSec": 0.6,
      "enter": [],
      "exit": []
    },
    {
      "id": "l10",
      "character": "doktor",
      "text": "Next, we'll take care of your ears.",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
