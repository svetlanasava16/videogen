  "lines": [
    {
      "id": "l1",
      "character": "tyoshcha",
      "text": "Doctor, I have terrible gas.",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [
        "tyoshcha"
      ],
      "exit": []
    },
    {
      "id": "l2",
      "character": "tyoshcha",
      "text": "Luckily it's always silent and it never smells.",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "tyoshcha",
      "text": "See, I just let one go right now. Nobody would ever notice.",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "doktor",
      "text": "I'll prescribe you something. Come back in two weeks.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": [
        "tyoshcha"
      ]
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "Two weeks later.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "tyoshcha",
      "text": "Doctor, what did you give me?",
      "emotion": "angry",
      "pauseAfterSec": 0.3,
      "enter": [
        "tyoshcha"
      ],
      "exit": []
    },
    {
      "id": "l7",
      "character": "tyoshcha",
      "text": "The gas is no better, and now it stinks something awful!",
      "emotion": "angry",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "doktor",
      "text": "Excellent. Your nose is fixed. Next we'll work on your ears.",
      "emotion": "happy",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    }
  ],
