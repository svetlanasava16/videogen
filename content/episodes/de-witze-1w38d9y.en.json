    {
      "id": "l1",
      "character": "narrator",
      "text": "One evening a man walks into a doctor's office and says to the doctor:",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "muzhik",
      "text": "Good evening, Doctor, I'm a moth!",
      "emotion": "happy",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l3",
      "character": "doktor",
      "text": "Then you're in the wrong place. The psychologist is opposite, on the other side of the street.",
      "emotion": "neutral",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "But your light was still on!",
      "emotion": "surprised",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
