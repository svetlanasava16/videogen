  ],
  "roles": {
    "zhena": "mother",
    "devushka-ryzhaya": "daughter",
    "doktor": "doctor"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "A blind girl always feels her plate at dinner and whines.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "devushka-ryzhaya",
      "text": "Great, I got the smallest portion again! Just because I can't see! Cheapskates!",
      "emotion": "angry",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "Mom can't take it anymore and calls a psychologist.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "doktor",
      "text": "Cook her a whole tub of dumplings. Let her eat.",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [
        "doktor"
      ],
      "exit": [
        "doktor"
      ]
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "The next day, Mom sets a whole tub of dumplings in front of her.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "zhena",
      "text": "Eat up, sweetie. It's all yours.",
      "emotion": "happy",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "devushka-ryzhaya",
      "text": "Wow... I can only imagine how much you took for yourselves!",
      "emotion": "surprised",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    }
  ],
