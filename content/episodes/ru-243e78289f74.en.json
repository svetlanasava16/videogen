{
  "id": "ru-243e78289f74.en",
  "jokeId": "ru-243e78289f74",
  "locale": "en",
  "title": "The Dumplings",
  "location": "kukhnya",
  "place": "home-kitchen",
  "cast": [
    "zhena",
    "devochka"
  ],
  "roles": {
    "zhena": "mother",
    "devochka": "daughter"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Once upon a time there was a girl who couldn't see a freaking thing. Basically, she was blind.",
      "uncensored": "Once upon a time there was a girl who couldn't see a fucking thing. Basically, she was blind.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Every time the family sat down to eat and her mom served the food, the girl spent ages feeling what was on her plate with her hands, and every time she whined:",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "devochka",
      "text": "There you go, as always you gave me the least of all!",
      "emotion": "angry",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "devochka",
      "text": "I can't see anything, so you can short me! Cheapskates...",
      "emotion": "sad",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "Her mom got sick of it and decided to consult a psychologist.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "doktor",
      "text": "Cook a whole tub of dumplings! Enough for a wedding feast. And let her eat!",
      "emotion": "smug",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "narrator",
      "text": "The next day the mom sets the table and puts a giant bucket of dumplings in front of the girl.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "narrator",
      "text": "The girl pulls the hefty portion toward her, feels it over with her hands for a long time and says:",
      "emotion": "neutral",
      "pauseAfterSec": 0.7,
      "enter": [],
      "exit": []
    },
    {
      "id": "l9",
      "character": "devochka",
      "text": "I can only imagine how much you freaking piled up for yourselves...",
      "uncensored": "I can only imagine how much you fucking piled up for yourselves...",
      "emotion": "surprised",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
