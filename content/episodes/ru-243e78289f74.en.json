{
  "id": "ru-243e78289f74.en",
  "jokeId": "ru-243e78289f74",
  "locale": "en",
  "title": "Dumplings",
  "location": "kukhnya",
  "place": "home-kitchen",
  "cast": [
    "muzhik",
    "devochka",
    "zhena"
  ],
  "roles": {
    "muzhik": "father",
    "devochka": "daughter",
    "zhena": "mother"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Once upon a time there was a little girl who couldn't see a darn thing. In short, she was blind.",
      "uncensored": "Once upon a time there was a little girl who couldn't see a fucking thing. In short, she was blind.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Every time the family sat down to eat and Mom served the food, the girl would feel around her plate with her hands for a long time, and every time she whined.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "devochka",
      "text": "There you go, as always, I got the least of all!",
      "emotion": "angry",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "devochka",
      "text": "Just because I can't see, you think you can shortchange me!",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "devochka",
      "text": "Cheapskates...",
      "emotion": "angry",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "Mom got fed up with all this and decided to consult a psychologist.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "doktor",
      "text": "Cook a whole basin of dumplings!",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "doktor",
      "text": "Enough to feed a whole wedding.",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l9",
      "character": "doktor",
      "text": "And let her eat!",
      "emotion": "happy",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l10",
      "character": "narrator",
      "text": "The next day Mom sets the table and puts a whole bucket of dumplings in front of the girl.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l11",
      "character": "narrator",
      "text": "The girl sits down, pulls a hefty pile of dumplings toward her, feels them with her hands for a long time and says.",
      "emotion": "neutral",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    },
    {
      "id": "l12",
      "character": "devochka",
      "text": "I can only imagine how much you freaking piled up for yourselves...",
      "uncensored": "I can only imagine how much you fucking piled up for yourselves...",
      "emotion": "sad",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
