{
  "id": "ru-243e78289f74.en",
  "jokeId": "ru-243e78289f74",
  "locale": "en",
  "title": "Dumplings",
  "location": "kukhnya",
  "place": "home-kitchen",
  "cast": [
    "zhena",
    "devochka",
    "muzhik"
  ],
  "roles": {
    "zhena": "mother",
    "devochka": "daughter",
    "muzhik": "father"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Once upon a time there was a little girl who couldn't see a freaking thing. In short, she was blind.",
      "uncensored": "Once upon a time there was a little girl who couldn't see a fucking thing. In short, she was blind.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Every time the family sat down at the table and Mom served the food, the girl spent a long time feeling her plate with her hands, and every time she whined:",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "devochka",
      "text": "There you go, as always, I got the least of all!",
      "emotion": "angry",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "devochka",
      "text": "Just because I can't see, you think you can shortchange me! Cheapskates...",
      "emotion": "angry",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "Mom got sick of it and decided to see a psychologist.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "doktor",
      "text": "Cook a whole tub of dumplings! Enough to feed a whole wedding. And let her eat!",
      "emotion": "smug",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "narrator",
      "text": "The next day Mom sets the table and puts a whole bucket of dumplings in front of the girl.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "narrator",
      "text": "The girl sits down, pulls the hefty portion toward her, feels it with her hands for a long time and says:",
      "emotion": "neutral",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    },
    {
      "id": "l9",
      "character": "devochka",
      "text": "I can only imagine how much you freaking piled up for yourselves...",
      "uncensored": "I can only imagine how much you fucking piled up for yourselves...",
      "emotion": "angry",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
