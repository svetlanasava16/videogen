  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "An old man goes to confession for the first time in over thirty years.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "ded",
      "text": "Wow! A minibar, fancy chocolates, a padded leather seat!",
      "emotion": "surprised",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "batyushka",
      "text": "Good evening, my son.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "ded",
      "text": "Father, the church has really modernized! This is so inviting!",
      "emotion": "happy",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "batyushka",
      "text": "Please step out, my son.",
      "emotion": "sad",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l6",
      "character": "ded",
      "text": "Why? Did I do something wrong?",
      "emotion": "surprised",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l7",
      "character": "batyushka",
      "text": "Yes. You came in on the priest's side.",
      "emotion": "neutral",
      "pauseAfterSec": 0.8
    }
  ],
