  "title": "Самое лучшее в чашке",
  "kind": "joke",
  "v": 2,
  "location": "bolnitsa",
  "place": "doctor-office",
  "cast": [
    "zhena",
    "doktor"
  ],
  "roles": {
    "zhena": "wife",
    "doktor": "therapist"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Женщина приходит к психиатру пожаловаться на мужа.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "zhena",
      "text": "Мой муж совсем чокнутый.",
      "emotion": "angry",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "zhena",
      "text": "На завтрак он выпивает кофе, а потом съедает и саму чашку.",
      "emotion": "surprised",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "zhena",
      "text": "Оставляет только ручку.",
      "emotion": "sad",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l5",
      "character": "doktor",
      "text": "Да, это действительно ненормально.",
      "emotion": "neutral",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l6",
      "character": "doktor",
      "text": "Ручка ведь самое лучшее в чашке.",
      "emotion": "surprised",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
