  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Verlaufen sich zwei deutsche Geschäftsmänner im Urwald im Amazonasgebiet, völlig hoffnungslos.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "nachalnik",
      "text": "Sie werden uns nicht finden, auch wenn sie unser gesamtes Vermögen dafür einsetzen.",
      "emotion": "sad",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l3",
      "character": "paren",
      "text": "Oh doch, wir werden schon bald gerettet.",
      "emotion": "happy",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "nachalnik",
      "text": "Wie kannst du nur so sicher sein?",
      "emotion": "surprised",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l5",
      "character": "paren",
      "text": "Ich habe meine Steuererklärung nicht pünktlich abgegeben.",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
