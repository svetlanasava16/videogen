{
  "id": "ru-42a3f189345d.de",
  "jokeId": "ru-42a3f189345d",
  "locale": "de",
  "title": "Die Brücke",
  "kind": "joke",
  "v": 2,
  "location": "derevnya",
  "place": "river-lake",
  "cast": [
    "ded",
    "nachalnik"
  ],
  "roles": {
    "ded": "old-man",
    "nachalnik": "businessman"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Russland. Ein Fluss fließt, und am Ufer liegt ein Dorf.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Ein alter Opa sitzt da und schaut zu.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "Auf der Straße kommt ein Traktor, bremst vor der Brücke, biegt rechts ab, fährt durch die Furt, biegt links auf die Straße und fährt weiter.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "narrator",
      "text": "Ein Lastwagen kommt, bremst vor der Brücke, biegt rechts ab, fährt durch die Furt, biegt links auf die Straße und fährt weiter.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "Auf der Straße kommt ein kleiner Lada, bremst vor der Brücke, biegt rechts ab, fährt durch die Furt, biegt links auf die Straße und fährt weiter.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "Auf der Straße rast ein Mercedes heran, ohne abzubremsen, fliegt auf die Brücke, die Brücke stürzt krachend ein, der Mercedes fällt in den Fluss.",
      "emotion": "surprised",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l7",
      "character": "ded",
      "text": "Na bitte, lauter Idioten gibt's hier inzwischen. Rasen nur rum.",
      "emotion": "angry",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l8",
      "character": "ded",
      "text": "Bemerken nicht mal die Brücke.",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
  "explicit": false,
