{
  "id": "en-r-axy53t.en",
  "jokeId": "en-r-axy53t",
  "locale": "en",
  "title": "First Day on the Job",
  "kind": "joke",
  "v": 2,
  "location": "doroga",
  "place": "car",
  "cast": [
    "muzhik-ryzhy",
    "paren"
  ],
  "roles": {
    "muzhik-ryzhy": "driver",
    "paren": "customer"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "A taxi driver, new on the job, picks up his first customer.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "A few minutes had passed and the whole trip had been quiet. The radio wasn't even turned on.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "The passenger is very interpersonal, so he started to strike a conversation to break the silence.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "paren",
      "text": "Hey, ma—",
      "emotion": "happy",
      "pauseAfterSec": 0.2
    },
    {
      "id": "l5",
      "character": "muzhik-ryzhy",
      "text": "Holy freaking crap!",
      "uncensored": "Holy fucking shit!",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "laugh": "chuckle"
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "The driver abruptly hit the brakes.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l7",
      "character": "paren",
      "text": "Dude, what the heck!",
      "uncensored": "Dude, what the fuck!",
      "emotion": "angry",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l8",
      "character": "muzhik-ryzhy",
      "text": "Sorry, man. It's my first time on the job and I haven't adjusted from my previous job yet.",
      "emotion": "sad",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l9",
      "character": "paren",
      "text": "What did you do before this?",
      "emotion": "surprised",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l10",
      "character": "muzhik-ryzhy",
      "text": "I drove a hearse.",
      "emotion": "neutral",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
