  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Sunday night. A doctor's pipe has burst. He calls a plumber.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "barmen",
      "text": "Now? It's Sunday night, it's pouring rain, and I'm on my second beer.",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "doktor",
      "text": "My good man! I'm a doctor. When I have an emergency, I go out no matter what!",
      "emotion": "angry",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "barmen",
      "text": "Fine, fine. I'm coming.",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": [
        "barmen"
      ]
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "An hour later, the plumber is in the bathroom. Everything is under water.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [
        "barmen"
      ],
      "exit": []
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "He tosses a handful of washers into the water.",
      "emotion": "neutral",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "barmen",
      "text": "If it's not better by tomorrow, call me again!",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    }
  ],
  "explicit": false,
