      "text": "Sitzen zwei Angler am Fluss.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Kommt ein Trauerzug vorbei.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "Ein Angler steht auf, nimmt den Hut ab und senkt den Kopf, bis die Trauergemeinde vorbeigezogen ist, und geht dann wieder zurück zum Angeln.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "muzhik-sosed",
      "text": "Wow, Respekt, so viel Anstand hätte ich dir gar nicht zugetraut.",
      "emotion": "surprised",
