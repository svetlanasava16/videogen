  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "A psychiatrist sits in his office, bored. No patients are coming.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Then the door quietly opens, and a man crawls in on all fours, clutching something in his teeth and hands, with something else dragging behind him.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [
        "paren"
      ],
      "exit": []
    },
    {
      "id": "l3",
      "character": "doktor",
      "text": "Oh, who's this crawling in to see us! It must be a little snake.",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "doktor",
      "text": "Crawl in, little snake, crawl in, little one, the doctor will help you.",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "The man shakes his head.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "doktor",
      "text": "Ah, it must be a little turtle who's come to visit us.",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "doktor",
      "text": "Crawl into the armchair, little turtle, and tell Uncle Doctor what happened to you.",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "narrator",
      "text": "The man shakes his head.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l9",
      "character": "doktor",
      "text": "So who have we got here? A little worm, maybe?",
      "emotion": "surprised",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    },
    {
      "id": "l10",
      "character": "paren",
      "text": "Doctor, buzz off, I'm the sysadmin, I'm wiring your network!",
      "uncensored": "Doctor, fuck off, I'm the sysadmin, I'm wiring your network!",
      "emotion": "angry",
      "pauseAfterSec": 0.8,
