  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "A psychiatrist sits in his office, bored... No patients are coming.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Then the door quietly opens a crack, and a man crawls in on all fours, clutching something in his teeth, his hands and so on, with something else dragging behind him.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [
        "paren"
      ],
      "exit": []
    },
    {
      "id": "l3",
      "character": "doktor",
      "text": "Oh, who's this crawling in to see us! It must be a little snake.",
      "emotion": "happy",
      "pauseAfterSec": 0.2,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "doktor",
      "text": "Come on in, little snake, come on in, little one, the doctor will help you.",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "The man shakes his head.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "doktor",
      "text": "Ahh, then it must be a little turtle come to visit us.",
      "emotion": "surprised",
      "pauseAfterSec": 0.2,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "doktor",
      "text": "Crawl into the chair, little turtle, and tell the nice doctor what happened to you...",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "narrator",
      "text": "The man shakes his head.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l9",
      "character": "doktor",
      "text": "So who have we got here, then? A little worm, maybe?",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    },
    {
      "id": "l10",
      "character": "paren",
      "text": "Doctor, screw you, I'm the sysadmin, I'm laying your network cable!",
      "uncensored": "Doctor, fuck you, I'm the sysadmin, I'm laying your network cable!",
      "emotion": "angry",
      "pauseAfterSec": 0.8,
