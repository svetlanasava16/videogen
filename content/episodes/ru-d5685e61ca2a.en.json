  "title": "The Sysadmin",
  "kind": "joke",
  "v": 2,
  "location": "bolnitsa",
  "place": "doctor-office",
  "cast": [
    "paren",
    "doktor"
  ],
  "roles": {
    "paren": "programmer",
    "doktor": "doctor"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "A psychiatrist is sitting in his office, bored... no patients are coming.",
      "emotion": "neutral",
      "pauseAfterSec": 0
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Then the door quietly creaks open, and a man crawls in on all fours, clutching something in his teeth, his hands and so on, plus something else dragging behind him. The psychiatrist:",
      "emotion": "surprised",
      "pauseAfterSec": 0
    },
    {
      "id": "l3",
      "character": "doktor",
      "text": "Oh, who's this crawling in to see us! It must be a little snakey. Crawl in, snakey, crawl in, little one, the doctor will help you.",
      "emotion": "happy",
      "pauseAfterSec": 0
    },
    {
      "id": "l4",
      "character": "narrator",
      "text": "The man shakes his head no.",
      "emotion": "neutral",
      "pauseAfterSec": 0
    },
    {
      "id": "l5",
      "character": "doktor",
      "text": "A-a-ah, it must be a little turtle come to visit us. Crawl into the armchair, little turtle, and tell Uncle Doctor what happened to you...",
      "emotion": "happy",
      "pauseAfterSec": 0
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "The man shakes his head no.",
      "emotion": "neutral",
      "pauseAfterSec": 0
    },
    {
      "id": "l7",
      "character": "doktor",
      "text": "So who have we got here? A little wormy, maybe?",
      "emotion": "surprised",
      "pauseAfterSec": 0
    },
    {
      "id": "l8",
      "character": "paren",
      "text": "Doctor, back off, I'm the sysadmin, I'm laying your network cable!",
      "uncensored": "Doctor, fuck off, I'm the sysadmin, I'm laying your network cable!",
      "emotion": "angry",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
