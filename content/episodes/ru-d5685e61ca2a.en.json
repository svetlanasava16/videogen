  "locale": "en",
  "title": "The Crawling Patient",
  "location": "bolnitsa",
  "place": "doctor-office",
  "cast": [
    "doktor",
    "paren"
  ],
  "roles": {
    "doktor": "doctor",
    "paren": "programmer"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "A psychiatrist sits in his office, bored. No patients.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Then a man crawls in on all fours, dragging something behind him.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [
        "paren"
      ],
      "exit": []
    },
    {
      "id": "l3",
      "character": "doktor",
      "text": "Oh, who's crawling in to see us? Is it a little snake?",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "doktor",
      "text": "Come in, little snake, come in. The doctor will help you.",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "doktor",
      "text": "No? Then it must be a little turtle come to visit!",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "doktor",
      "text": "Climb into the chair, turtle, and tell the nice doctor what happened.",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "doktor",
      "text": "Not a turtle either? So who are we? A teeny little worm?",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "paren",
      "text": "Doc, get lost! I'm the sysadmin! I'm running your network cable!",
      "emotion": "angry",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    }
  ],
  "format": {
    "width": 1080,
