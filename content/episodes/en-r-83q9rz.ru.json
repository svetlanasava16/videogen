    {
      "id": "l6",
      "character": "barmen",
      "text": "Двести рублей.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l7",
      "character": "paren",
      "text": "Держите. Так какой пароль от вайфая?",
