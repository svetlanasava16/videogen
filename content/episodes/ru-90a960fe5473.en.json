{
  "id": "ru-90a960fe5473.en",
  "jokeId": "ru-90a960fe5473",
  "locale": "en",
  "title": "The Saucer",
  "location": "magazin",
  "place": "shop",
  "cast": [
    "kot",
    "muzhik",
    "barmen"
  ],
  "roles": {
    "kot": "cat",
    "muzhik": "customer",
    "barmen": "salesman"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "A man walked into an antique shop, glanced listlessly at the counter, and was about to leave.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Suddenly he sees a kitty by the door drinking milk, and the saucer is Tutankhamun! Fourteenth century BC!",
      "emotion": "surprised",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "muzhik",
      "text": "Excuse me, I'm a lonely man, I live without friends...",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "And I've taken such a liking to your kitty... Could you let me have him?",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "barmen",
      "text": "No, no. My kids love him so much.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "muzhik",
      "text": "Well, I'm so lonely... I'll give you ten dollars...",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "barmen",
      "text": "No, no, he's not for sale.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "narrator",
      "text": "In the end they settled on a hundred and fifty dollars.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l9",
      "character": "muzhik",
      "text": "Your kitty is probably used to drinking from this saucer, would you let me have it?",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l10",
      "character": "barmen",
      "text": "No, no.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l11",
      "character": "muzhik",
      "text": "I'll give you ten dollars for it...",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l12",
      "character": "barmen",
      "text": "Oh, come on, that's Tutankhamun, fourteenth century BC...",
      "emotion": "smug",
      "pauseAfterSec": 0.6,
      "enter": [],
      "exit": []
    },
    {
      "id": "l13",
      "character": "barmen",
      "text": "I've sold eighty-seven kitties this way...",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
