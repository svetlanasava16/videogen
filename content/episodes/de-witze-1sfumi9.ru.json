  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Мужчина гуляет в парке и видит другого мужчину, который сидит рядом с собакой.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "muzhik",
      "text": "Ваша собака кусается?",
      "emotion": "happy",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "muzhik-sosed",
      "text": "Нет, моя собака не кусается.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "narrator",
      "text": "Мужчина наклоняется, чтобы погладить собаку. Собака тут же кусает его и до крови прокусывает ему руку.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "muzhik",
      "text": "Я думал, ваша собака не кусается!",
      "emotion": "angry",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l6",
      "character": "muzhik-sosed",
      "text": "А это и не моя собака.",
      "emotion": "neutral",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
