  "lines": [
    {
      "id": "l1",
      "character": "barmen",
      "text": "So, what can I get you?",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "muzhik",
      "text": "I'd like the schnitzel with fried potatoes and salad, and a lukewarm beer with no head.",
      "emotion": "smug",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "muzhik",
      "text": "The potatoes properly burnt black, the schnitzel as tough and bland as possible, and you can leave out the salad altogether.",
      "emotion": "smug",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "And don't be shy with the bill.",
      "emotion": "smug",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l5",
      "character": "barmen",
      "text": "Well, you know, we don't actually serve that sort of thing.",
      "emotion": "angry",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l6",
      "character": "muzhik",
      "text": "Funny, that's exactly how it came yesterday...",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
