  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Пригласили один раз ветерана войны на урок истории в третий класс.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "uchilka",
      "text": "Расскажите самый запомнившийся вам бой.",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "ded",
      "text": "Ну, значит, попали мы в окружение под Минском.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "ded",
      "text": "Бац слева немцы, бац справа немцы и спереди немцы.",
      "uncensored": "Хуяк слева немцы, хуяк справа немцы и спереди немцы.",
      "emotion": "angry",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "uchilka",
      "text": "Это же дети!",
      "emotion": "surprised",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "ded",
      "text": "Какие на фиг дети?! Фашисты!",
      "uncensored": "Какие на хуй дети?! Фашисты!",
      "emotion": "angry",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
