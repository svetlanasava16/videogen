  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "На урок истории в третий класс пригласили ветерана.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [
        "ded"
      ],
      "exit": []
    },
    {
      "id": "l2",
      "character": "uchilka",
      "text": "Расскажите детям, какой бой вам запомнился больше всего.",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "ded",
      "text": "Ну, значит, попали мы в окружение под Минском.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "ded",
      "text": "Хренак, слева немцы! Хренак, справа немцы! И спереди тоже немцы!",
      "emotion": "angry",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "uchilka",
      "text": "Это же дети!",
      "emotion": "surprised",
      "pauseAfterSec": 0.7,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "ded",
      "text": "Какие, на хрен, дети? Фашисты!",
      "emotion": "angry",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    }
  ],
