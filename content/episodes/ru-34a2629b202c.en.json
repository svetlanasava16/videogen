{
  "id": "ru-34a2629b202c.en",
  "jokeId": "ru-34a2629b202c",
  "locale": "en",
  "title": "The Launch",
  "location": "ofis",
  "place": "office",
  "cast": [
    "paren",
    "ded",
    "muzhik-ryzhy"
  ],
  "roles": {
    "paren": "engineer",
    "ded": "engineer",
    "muzhik-ryzhy": "engineer"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "A spaceport. They are getting ready for the first launch of a new rocket.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "In mission control sit representatives of all the companies that helped build the rocket.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "One of the firms is represented by a young specialist and his experienced mentor.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "narrator",
      "text": "The countdown begins: ten, nine...",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "paren",
      "text": "Why aren't you saying anything? We've got a pile of defects, the rocket won't take off!",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "ded",
      "text": "Sit down and keep quiet!",
      "emotion": "angry",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "narrator",
      "text": "Seven, six...",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "paren",
      "text": "It's going to blow up any second, I'll report it myself!",
      "emotion": "angry",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l9",
      "character": "ded",
      "text": "Trust my experience, sit down and keep quiet.",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l10",
      "character": "narrator",
      "text": "Four, three...",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l11",
      "character": "narrator",
      "text": "Suddenly a representative of another firm jumps up and shouts:",
      "emotion": "neutral",
      "pauseAfterSec": 0.2,
      "enter": [],
      "exit": []
    },
    {
      "id": "l12",
      "character": "muzhik-ryzhy",
      "text": "Stop the launch, we've got defects!",
      "emotion": "angry",
      "pauseAfterSec": 0.7,
      "enter": [],
      "exit": []
    },
    {
      "id": "l13",
      "character": "ded",
      "text": "See? It's their fault the rocket launch was called off.",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
