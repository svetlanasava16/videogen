{
  "id": "de-witze-1otfre9.de",
  "jokeId": "de-witze-1otfre9",
  "locale": "de",
  "title": "Die Scheidung",
  "location": "gostinaya",
  "place": "home-living-room",
  "cast": [
    "ded",
    "tyoshcha",
    "paren"
  ],
  "roles": {
    "ded": "old-man",
    "tyoshcha": "old-woman",
    "paren": "son"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein alter Mann ruft seinen Sohn an.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "ded",
      "text": "Hör zu, deine Mutter und ich lassen uns scheiden.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "ded",
      "text": "Fünfundvierzig Jahre von dem Mist reichen jetzt auch.",
      "emotion": "angry",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "paren",
      "text": "Was redest du da, Papa?!",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "ded",
      "text": "Wir können uns einfach nicht mehr ab. Ich kann sie nicht mehr ansehen, es reicht.",
      "emotion": "angry",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "ded",
      "text": "Ich will darüber nicht diskutieren. Ruf deine Schwester an und sag ihr Bescheid.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "narrator",
      "text": "Der Sohn ruft völlig panisch sofort seine Schwester an.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "devushka-ryzhaya",
      "text": "Die lassen sich gar nix!",
      "emotion": "angry",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l9",
      "character": "narrator",
      "text": "Sie ruft direkt beim Vater an.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l10",
      "character": "devushka-ryzhaya",
      "text": "Du lässt dich nicht scheiden! Wag's bloß nicht, irgendwas zu unterschreiben!",
      "emotion": "angry",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l11",
      "character": "devushka-ryzhaya",
      "text": "Wir kommen morgen beide nach Hause und klären das. Keinen Anwalt, keine Formulare, gar nichts! Verstanden?!",
      "emotion": "angry",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [
        "devushka-ryzhaya"
      ]
    },
    {
      "id": "l12",
      "character": "ded",
      "text": "Gut. Beide kommen zu Weihnachten. Und zahlen dieses Jahr ihren Flug sogar selbst.",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
