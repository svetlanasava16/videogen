{
  "id": "de-witze-1otfre9.de",
  "jokeId": "de-witze-1otfre9",
  "locale": "de",
  "title": "Die Scheidung",
  "location": "gostinaya",
  "place": "home-living-room",
  "cast": [
    "tyoshcha",
    "ded",
    "paren"
  ],
  "roles": {
    "tyoshcha": "old-woman",
    "ded": "old-man",
    "paren": "son"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein alter Mann ruft seinen Sohn an.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "ded",
      "text": "Hör zu, deine Mutter und ich lassen uns scheiden.",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "ded",
      "text": "Fünfundvierzig Jahre von dem Mist reichen jetzt auch.",
      "emotion": "angry",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "paren",
      "text": "Was redest du da, Papa?!",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "ded",
      "text": "Wir können uns einfach nicht mehr ab.",
      "emotion": "angry",
      "pauseAfterSec": 0.2,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "ded",
      "text": "Ich kann sie nicht mehr ansehen, es reicht.",
      "emotion": "angry",
      "pauseAfterSec": 0.2,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "ded",
      "text": "Ich will darüber nicht diskutieren.",
      "emotion": "neutral",
      "pauseAfterSec": 0.2,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "ded",
      "text": "Ruf deine Schwester an und sag ihr Bescheid.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l9",
      "character": "narrator",
      "text": "Klick. Er legt auf.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l10",
      "character": "narrator",
      "text": "Der Sohn ruft völlig panisch sofort seine Schwester an. Die rastet komplett aus.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l11",
      "character": "devushka-ryzhaya",
      "text": "Die lassen sich gar nix!",
      "emotion": "angry",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l12",
      "character": "narrator",
      "text": "Sie ruft direkt beim Vater an.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l13",
      "character": "devushka-ryzhaya",
      "text": "Du lässt dich nicht scheiden!",
      "emotion": "angry",
      "pauseAfterSec": 0.2,
      "enter": [],
      "exit": []
    },
    {
      "id": "l14",
      "character": "devushka-ryzhaya",
      "text": "Wag's bloß nicht, irgendwas zu unterschreiben.",
      "emotion": "angry",
      "pauseAfterSec": 0.2,
      "enter": [],
      "exit": []
    },
    {
      "id": "l15",
      "character": "devushka-ryzhaya",
      "text": "Wir kommen morgen beide nach Hause und klären das.",
      "emotion": "angry",
      "pauseAfterSec": 0.2,
      "enter": [],
      "exit": []
    },
    {
      "id": "l16",
      "character": "devushka-ryzhaya",
      "text": "Keinen Anwalt, keine Formulare, gar nichts! Verstanden?!",
      "emotion": "angry",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l17",
      "character": "narrator",
      "text": "Bäm. Sie knallt den Hörer auf.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l18",
      "character": "ded",
      "text": "Gut. Beide kommen zu Weihnachten.",
      "emotion": "smug",
      "pauseAfterSec": 0.6,
      "enter": [],
      "exit": []
    },
    {
      "id": "l19",
      "character": "ded",
      "text": "Und zahlen dieses Jahr ihren Flug sogar selbst.",
      "emotion": "happy",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
