  "locale": "de",
  "title": "Der Mann im Nachbarzimmer",
  "kind": "joke",
  "v": 2,
  "location": "bar",
  "place": "hotel",
  "cast": [
    "nachalnik",
    "uchilka",
    "muzhik-sosed"
  ],
  "roles": {
    "nachalnik": "businessman",
    "muzhik-sosed": "neighbor",
    "uchilka": "clerk"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein Geschäftsmann hatte ein Hotelzimmer gebucht.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "uchilka",
      "text": "Der Mann im Nachbarzimmer ist sehr nervös und kann nur schwer einschlafen.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "Der Geschäftsmann war nach einem langen Arbeitstag sehr müde.",
      "emotion": "sad",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "narrator",
      "text": "Als er sein Zimmer betrat und sich aufs Bett setzte, zog er einen seiner Schuhe ziemlich laut aus und ließ ihn auf den Boden fallen.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "In diesem Moment erinnerte er sich an das, was die Rezeptionistin gesagt hatte, und stellte den zweiten Schuh ganz leise hin.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "Danach zog er seinen Schlafanzug an und ging schlafen.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l7",
      "character": "narrator",
      "text": "Zwei Stunden später wachte er durch ein lautes Klopfen an seiner Tür auf.",
      "emotion": "surprised",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l8",
      "character": "nachalnik",
      "text": "Was ist los?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l9",
      "character": "muzhik-sosed",
      "text": "Ich bin der Mann aus dem Nachbarzimmer.",
      "emotion": "angry",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l10",
      "character": "muzhik-sosed",
      "text": "Würden Sie jetzt bitte endlich auch Ihren anderen Schuh ausziehen?",
      "emotion": "angry",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
  "explicit": false,
