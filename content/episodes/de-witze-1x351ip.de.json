    {
      "id": "l1",
      "character": "uchilka",
      "text": "Ihr Schlüssel. Bitte seien Sie leise, der Herr nebenan ist sehr nervös und schläft schlecht.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": [
        "uchilka"
      ]
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Todmüde lässt er im Zimmer den ersten Schuh laut auf den Boden knallen.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "nachalnik",
      "text": "Ach, der nervöse Nachbar! Den zweiten stelle ich lieber ganz leise hin.",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "narrator",
      "text": "Zwei Stunden später hämmert jemand an die Tür.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "nachalnik",
      "text": "Wer ist da?",
      "emotion": "angry",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "muzhik-sosed",
      "text": "Ihr Nachbar. Würden Sie jetzt bitte endlich auch den anderen Schuh ausziehen?",
      "emotion": "angry",
      "pauseAfterSec": 0.8,
