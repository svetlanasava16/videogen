{
  "id": "de-witze-1x351ip.de",
  "jokeId": "de-witze-1x351ip",
  "locale": "de",
  "title": "Der Mann im Nachbarzimmer",
  "location": "bar",
  "place": "hotel",
  "cast": [
    "nachalnik",
    "uchilka"
  ],
  "roles": {
    "nachalnik": "businessman",
    "uchilka": "clerk"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein Geschäftsmann hatte ein Hotelzimmer gebucht.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "uchilka",
      "text": "Der Mann im Nachbarzimmer ist sehr nervös und kann nur schwer einschlafen.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "Der Geschäftsmann war nach einem langen Arbeitstag sehr müde. Er setzte sich aufs Bett, zog einen seiner Schuhe ziemlich laut aus und ließ ihn auf den Boden fallen.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "narrator",
      "text": "In diesem Moment erinnerte er sich an das, was die Rezeptionistin gesagt hatte, und stellte den zweiten Schuh ganz leise hin.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "Danach ging er schlafen. Zwei Stunden später wachte er durch ein lautes Klopfen an seiner Tür auf.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "nachalnik",
      "text": "Was ist los?",
      "emotion": "surprised",
      "pauseAfterSec": 0.7,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "muzhik-sosed",
      "text": "Ich bin der Mann aus dem Nachbarzimmer. Würden Sie jetzt bitte endlich auch Ihren anderen Schuh ausziehen?",
      "emotion": "angry",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
