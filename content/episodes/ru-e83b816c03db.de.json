{
  "id": "ru-e83b816c03db.de",
  "jokeId": "ru-e83b816c03db",
  "locale": "de",
  "title": "Das Wechselgeld",
  "location": "bar",
  "place": "bar",
  "cast": [
    "barmen",
    "muzhik"
  ],
  "roles": {
    "barmen": "bartender",
    "muzhik": "customer"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein Mann kommt in eine Bar und bestellt einen Whisky:",
      "emotion": "neutral",
      "pauseAfterSec": 0,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "muzhik",
      "text": "Was bin ich schuldig?",
      "emotion": "neutral",
      "pauseAfterSec": 0,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "barmen",
      "text": "Drei Euro.",
      "emotion": "neutral",
      "pauseAfterSec": 0,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "narrator",
      "text": "Der Mann holt drei Euro aus der Tasche.",
      "emotion": "neutral",
      "pauseAfterSec": 0,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "Einen legt er vor sich auf die Theke,",
      "emotion": "neutral",
      "pauseAfterSec": 0,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "dann geht er ans linke Ende der Theke und legt dort den zweiten hin,",
      "emotion": "neutral",
      "pauseAfterSec": 0,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "narrator",
      "text": "dann geht er ans rechte Ende der Theke und legt dort den dritten hin.",
      "emotion": "neutral",
      "pauseAfterSec": 0,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "narrator",
      "text": "Der Barkeeper geht leise fluchend nach rechts und nach links und sammelt das Geld ein.",
      "emotion": "neutral",
      "pauseAfterSec": 0,
      "enter": [],
      "exit": []
    },
    {
      "id": "l9",
      "character": "narrator",
      "text": "Am nächsten Tag kommt derselbe Mann wieder,",
      "emotion": "neutral",
      "pauseAfterSec": 0,
      "enter": [],
      "exit": []
    },
    {
      "id": "l10",
      "character": "narrator",
      "text": "bestellt wieder ein Gläschen Whisky und verteilt die Euros wieder an die verschiedenen Enden der Theke.",
      "emotion": "neutral",
      "pauseAfterSec": 0,
      "enter": [],
      "exit": []
    },
    {
      "id": "l11",
      "character": "narrator",
      "text": "Der Barkeeper ärgert sich, aber er holt sich das Geld.",
      "emotion": "neutral",
      "pauseAfterSec": 0,
      "enter": [],
      "exit": []
    },
    {
      "id": "l12",
      "character": "narrator",
      "text": "Kurz gesagt, das wiederholt sich Tag für Tag.",
      "emotion": "neutral",
      "pauseAfterSec": 0,
      "enter": [],
      "exit": []
    },
    {
      "id": "l13",
      "character": "narrator",
      "text": "Und eines Tages bestellt der Mann einen Whisky, nimmt das Glas,",
      "emotion": "neutral",
      "pauseAfterSec": 0,
      "enter": [],
      "exit": []
    },
    {
      "id": "l14",
      "character": "narrator",
      "text": "kramt in der Tasche und zieht einen Fünf-Euro-Schein heraus.",
      "emotion": "neutral",
      "pauseAfterSec": 0,
      "enter": [],
      "exit": []
    },
    {
      "id": "l15",
      "character": "narrator",
      "text": "Der Barkeeper schnappt sich schnell den Schein, lächelt rachsüchtig,",
      "emotion": "neutral",
      "pauseAfterSec": 0,
      "enter": [],
      "exit": []
    },
    {
      "id": "l16",
      "character": "narrator",
      "text": "holt zwei Euro Wechselgeld heraus,",
      "emotion": "neutral",
      "pauseAfterSec": 0,
      "enter": [],
      "exit": []
    },
    {
      "id": "l17",
      "character": "narrator",
      "text": "geht ans linke Ende der Theke und legt dort einen Euro hin,",
      "emotion": "neutral",
      "pauseAfterSec": 0,
      "enter": [],
      "exit": []
    },
    {
      "id": "l18",
      "character": "narrator",
      "text": "dann geht er ans rechte Ende und legt dort den zweiten hin.",
      "emotion": "neutral",
      "pauseAfterSec": 0,
      "enter": [],
      "exit": []
    },
    {
      "id": "l19",
      "character": "narrator",
      "text": "Dann kommt er zurück und schaut den Mann schadenfroh an.",
      "emotion": "neutral",
      "pauseAfterSec": 0,
      "enter": [],
      "exit": []
    },
    {
      "id": "l20",
      "character": "narrator",
      "text": "Der Mann trinkt seelenruhig seinen Whisky aus,",
      "emotion": "neutral",
      "pauseAfterSec": 0,
      "enter": [],
      "exit": []
    },
    {
      "id": "l21",
      "character": "narrator",
      "text": "holt einen Euro aus der Tasche, legt ihn vor sich hin und sagt:",
      "emotion": "neutral",
      "pauseAfterSec": 0,
      "enter": [],
      "exit": []
    },
    {
      "id": "l22",
      "character": "muzhik",
      "text": "Ich glaube, ich nehme noch ein Gläschen.",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
  "explicit": false,
