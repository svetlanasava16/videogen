{
  "id": "ru-e83b816c03db.de",
  "jokeId": "ru-e83b816c03db",
  "locale": "de",
  "title": "Drei Euro",
  "location": "bar",
  "place": "bar",
  "cast": [
    "muzhik",
    "barmen"
  ],
  "roles": {
    "muzhik": "customer",
    "barmen": "bartender"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein Mann kommt in eine Kneipe und bestellt einen Whisky.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "muzhik",
      "text": "Was bin ich schuldig?",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "barmen",
      "text": "Drei Euro.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "narrator",
      "text": "Einen Euro legt er vor sich hin, den zweiten ans linke Ende der Theke, den dritten ans rechte.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "Der Wirt geht leise fluchend hin und her und sammelt das Geld ein.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "Am nächsten Tag kommt der Mann wieder und verteilt die Münzen wieder an die Enden der Theke. Der Wirt ärgert sich, holt aber das Geld.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "narrator",
      "text": "So geht das Tag für Tag.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "narrator",
      "text": "Eines Tages bestellt er einen Whisky und zieht einen Fünf-Euro-Schein heraus.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l9",
      "character": "narrator",
      "text": "Der Wirt schnappt ihn sich, lächelt rachsüchtig und legt die zwei Euro Wechselgeld ans linke und ans rechte Ende der Theke. Dann sieht er den Mann schadenfroh an.",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l10",
      "character": "narrator",
      "text": "Der Mann trinkt in Ruhe aus, legt einen Euro vor sich hin und sagt:",
      "emotion": "neutral",
      "pauseAfterSec": 0.6,
      "enter": [],
      "exit": []
    },
    {
      "id": "l11",
      "character": "muzhik",
      "text": "Ich glaube, ich nehme noch einen.",
      "emotion": "neutral",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
