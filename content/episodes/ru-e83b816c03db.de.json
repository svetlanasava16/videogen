{
  "id": "ru-e83b816c03db.de",
  "jokeId": "ru-e83b816c03db",
  "locale": "de",
  "title": "Das Wechselgeld",
  "location": "bar",
  "place": "bar",
  "cast": [
    "muzhik",
    "barmen"
  ],
  "roles": {
    "muzhik": "everyman",
    "barmen": "bartender"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein Mann kommt in eine Kneipe und bestellt einen Whisky.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "muzhik",
      "text": "Was bin ich schuldig?",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "barmen",
      "text": "Drei Euro.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "narrator",
      "text": "Einen Euro legt er vor sich auf den Tresen, den zweiten ans linke Ende, den dritten ans rechte Ende.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "Der Wirt flucht leise und holt sich das Geld rechts und links.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "Am nächsten Tag dasselbe: Wieder verteilt der Mann seine Münzen an beide Enden. Der Wirt ärgert sich, aber er läuft.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "narrator",
      "text": "Und so geht das Tag für Tag.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "narrator",
      "text": "Eines Tages zieht der Mann einen Fünf-Euro-Schein heraus.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l9",
      "character": "narrator",
      "text": "Der Wirt lächelt rachsüchtig, legt einen Euro Wechselgeld ans linke Ende und den zweiten ans rechte.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l10",
      "character": "narrator",
      "text": "Dann kommt er zurück und schaut den Mann schadenfroh an.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l11",
      "character": "narrator",
      "text": "Der Mann trinkt in aller Ruhe aus, holt einen Euro heraus und legt ihn vor sich hin.",
      "emotion": "neutral",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    },
    {
      "id": "l12",
      "character": "muzhik",
      "text": "Ich glaube, ich nehme noch einen.",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
