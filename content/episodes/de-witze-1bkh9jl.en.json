  "locale": "en",
  "title": "Drinking for Two",
  "location": "bar",
  "place": "bar",
  "cast": [
    "barmen",
    "muzhik"
  ],
  "roles": {
    "barmen": "bartender",
    "muzhik": "everyman"
  },
  "lines": [
    {
      "id": "l1",
      "character": "muzhik",
      "text": "Two beers and two whiskey shots, please.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [
        "muzhik"
      ],
      "exit": []
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "A few days later, the same order. And again.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "barmen",
      "text": "Hey, why do you always order everything in twos?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "My buddy and I have a ritual. When one of us drinks alone, he drinks for the other one too.",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "This goes on for months. Then one day:",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "muzhik",
      "text": "One beer and one whiskey, please.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "barmen",
      "text": "Oh no. Did your buddy pass away?",
      "emotion": "sad",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "muzhik",
      "text": "Nope. I quit drinking.",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    }
  ],
