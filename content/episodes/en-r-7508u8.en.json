    },
    {
      "id": "l3",
      "character": "devochka",
      "text": "Yes.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "sluzhivy",
      "text": "Well tell him to put a reflector light on it next year!",
      "emotion": "smug",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "And he fines her five dollars.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4
