      "character": "narrator",
      "text": "A cop on a horse says to a little girl on a bike:",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "sluzhivy",
      "text": "Did Santa get you that?",
      "emotion": "smug",
