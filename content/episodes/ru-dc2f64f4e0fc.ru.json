  "locale": "ru",
  "title": "Кондишн",
  "kind": "joke",
  "v": 2,
  "location": "bar",
  "place": "restaurant",
  "cast": [
    "nachalnik",
    "barmen",
    "muzhik"
  ],
  "roles": {
    "nachalnik": "new-russian",
    "barmen": "waiter",
    "muzhik": "customer"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "В ресторане сидит новый русский, подзывает официанта.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "nachalnik",
      "text": "Человек, ну-ка убавь кондишн, а то холодновато в натуре!",
      "emotion": "angry",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "Через пять минут.",
      "emotion": "neutral",
      "pauseAfterSec": 0.2
    },
    {
      "id": "l4",
      "character": "nachalnik",
      "text": "Слышь, гарсон!",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "nachalnik",
      "text": "Прибавь-ка, братан, кондишен, что-то жарковато стало...",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "Через пять минут.",
      "emotion": "neutral",
      "pauseAfterSec": 0.2
    },
    {
      "id": "l7",
      "character": "nachalnik",
      "text": "Эй, чувак...",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l8",
      "character": "nachalnik",
      "text": "...ну-ка убавь кондишн, опять холодно.",
      "emotion": "angry",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l9",
      "character": "narrator",
      "text": "Сидящий за соседним столиком мужичок подзывает и спрашивает официанта:",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l10",
      "character": "muzhik",
      "text": "Как ты его еще терпишь?",
      "emotion": "surprised",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l11",
      "character": "barmen",
      "text": "Да без проблем! У нас и кондишена-то нет!",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
