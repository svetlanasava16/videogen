  "locale": "en",
  "title": "Three Bodies",
  "location": "derevnya",
  "place": "garden",
  "cast": [
    "muzhik",
    "sluzhivy",
    "vor"
  ],
  "roles": {
    "muzhik": "everyman",
    "sluzhivy": "police-officer",
    "vor": "thief"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Late at night, a man sees a flashlight moving in his shed.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "muzhik",
      "text": "Hello, police? There are burglars in my shed!",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "The dispatcher says every patrol car is busy. Maybe in an hour or two.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "Hello, it's me again. Since nobody's free, I shot them myself.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "muzhik",
      "text": "So when a car frees up, send a couple of ambulances for the bodies.",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "One minute later the yard is full of police. The burglars run out and surrender.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [
        "vor"
      ],
      "exit": []
    },
    {
      "id": "l7",
      "character": "sluzhivy",
      "text": "You said there were at least three bodies!",
      "emotion": "angry",
      "pauseAfterSec": 0.7,
      "enter": [
        "sluzhivy"
      ],
      "exit": []
    },
    {
      "id": "l8",
      "character": "muzhik",
      "text": "And you said nobody was free.",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    }
  ],
  "explicit": false,
