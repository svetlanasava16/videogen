  "lines": [
    {
      "id": "l1",
      "character": "sluzhivy",
      "text": "Стоп, стоять! Знаете, почему я вас остановил?",
      "emotion": "angry",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "paren",
      "text": "Потому что мы слишком сексуальные?",
      "emotion": "smug",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l3",
      "character": "sluzhivy",
      "text": "Очень смешно. Вы вообще в курсе, что едете впятером на одном электросамокате?",
      "emotion": "neutral",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l4",
      "character": "paren",
      "text": "Подождите. Вы сказали — впятером?",
      "emotion": "surprised",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l5",
      "character": "paren",
      "text": "Ребята, мы потеряли Надю!",
      "emotion": "surprised",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
