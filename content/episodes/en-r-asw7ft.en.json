  "locale": "en",
  "title": "Fifteen Eddys",
  "kind": "joke",
  "v": 2,
  "location": "bar",
  "place": "restaurant",
  "cast": [
    "zhena",
    "vovochka",
    "devushka"
  ],
  "roles": {
    "zhena": "mother",
    "vovochka": "child",
    "devushka": "waiter"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "A woman goes into a restaurant with fifteen kids.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "The kids start goofing around while she's talking to the waitress.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "zhena",
      "text": "Eddy! Stop that! Or else!",
      "emotion": "angry",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "narrator",
      "text": "All fifteen boys suddenly sit down, obedient and quiet.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "devushka",
      "text": "Did you really name all fifteen of your boys Eddy?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l6",
      "character": "zhena",
      "text": "Yup. Makes it easier than trying to remember who's who every damn time.",
      "emotion": "smug",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l7",
      "character": "devushka",
      "text": "But what if you only want to talk to one of them for some reason?",
      "emotion": "surprised",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l8",
      "character": "zhena",
      "text": "Well, then I just call them by their last names.",
      "emotion": "neutral",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
