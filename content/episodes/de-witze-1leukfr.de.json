  "locale": "de",
  "title": "Der Notfall",
  "location": "spalnya",
  "place": "bathroom",
  "cast": [
    "doktor",
    "barmen"
  ],
  "roles": {
    "doktor": "doctor",
    "barmen": "plumber"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Kommt ein Arzt zum Klempner.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Also, er ruft an. Notfall und so, Rohrbruch, Drama.",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "barmen",
      "text": "Ja gut, aber es ist Sonntagabend, es gießt wie aus Eimern und ich hab' auch schon das zweite Bier am Wickel...",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "doktor",
      "text": "Guter Mann! Ich bin Arzt. Wenn bei mir ein Notfall ist, muss ich auch raus, egal was ist!",
      "emotion": "angry",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "Hin und Her. Der Klempner hockt sich ins Auto und fährt hin.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "Der Arzt macht die Tür auf und führt ihn direkt ins Badezimmer. Alles unter Wasser.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "narrator",
      "text": "Der Klempner greift in die Hosentasche und schmeißt 'ne Handvoll Dichtungsringe ins Wasser.",
      "emotion": "neutral",
      "pauseAfterSec": 0.6,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "barmen",
      "text": "Wenn's morgen nicht besser ist, rufen Sie nochmal an!",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
