  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Sonntagabend. Bei einem Arzt ist ein Rohr geplatzt. Er ruft den Klempner an.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "barmen",
      "text": "Jetzt? Es ist Sonntagabend, es gießt wie aus Eimern, und ich bin schon beim zweiten Bier.",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "doktor",
      "text": "Guter Mann! Ich bin Arzt. Wenn bei mir ein Notfall ist, muss ich auch raus, egal was ist!",
      "emotion": "angry",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "barmen",
      "text": "Na gut, na gut. Ich komme.",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": [
        "barmen"
      ]
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "Eine Stunde später steht der Klempner im Badezimmer. Alles unter Wasser.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [
        "barmen"
      ],
      "exit": []
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "Er wirft eine Handvoll Dichtungsringe ins Wasser.",
      "emotion": "neutral",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "barmen",
      "text": "Wenn's morgen nicht besser ist, rufen Sie nochmal an!",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    }
  ],
