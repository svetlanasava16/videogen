  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein neues Medikament wird getestet.",
      "emotion": "neutral",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l1b",
      "character": "narrator",
      "text": "Die Patienten sind in zwei Gruppen aufgeteilt, eine Versuchsgruppe und eine Kontrollgruppe. Einer der Patienten kommt zum Arzt.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "muzhik",
      "text": "Herr Doktor, warum haben Sie mein Präparat ausgetauscht?",
      "emotion": "angry",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "doktor",
      "text": "Und wie kommen Sie darauf, dass ich es ausgetauscht habe?",
      "emotion": "surprised",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "Wissen Sie, früher, wenn ich die Tabletten ins Klo geworfen habe,",
      "emotion": "smug",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l4b",
      "character": "muzhik",
      "text": "sind sie geschwommen, und jetzt gehen sie plötzlich unter.",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
