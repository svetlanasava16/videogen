  "lines": [
    {
      "id": "l1",
      "character": "zhena",
      "text": "Schatz, wenn ich sterbe, heiratest du dann wieder?",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "muzhik",
      "text": "Ach Liebling, darüber will ich gar nicht nachdenken.",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "zhena",
      "text": "Doch, sag schon! Würde sie in unserem Haus wohnen?",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "Na ja, das Haus ist abbezahlt. Warum nicht?",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "zhena",
      "text": "Und würde sie in unserem Bett schlafen?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "muzhik",
      "text": "Es ist ein gutes Bett. Wäre schade drum.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "zhena",
      "text": "Und würdest du ihr meine Golfschläger geben?",
      "emotion": "angry",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "muzhik",
      "text": "Nein, auf keinen Fall! Sie ist Linkshänderin.",
      "emotion": "neutral",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    }
  ],
