    {
      "id": "l1",
      "character": "narrator",
      "text": "An older couple, long past their silver wedding, married for ages, are sitting at the table one morning, having breakfast.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "The wife gives her husband a long look and asks.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "zhena",
      "text": "Joe, please, tell me, do you still love me?",
      "emotion": "sad",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "narrator",
      "text": "The husband irritably throws his fork on the table.",
      "emotion": "neutral",
      "pauseAfterSec": 0.7,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "muzhik",
      "text": "Linda, just explain to me, why the heck start every single morning with a fight?",
      "uncensored": "Linda, just explain to me, why the fuck start every single morning with a fight?",
      "emotion": "angry",
