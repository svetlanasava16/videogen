  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "An older couple, who have already celebrated their silver wedding anniversary and have lived together a long time, are sitting at the table one morning, having breakfast.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "The wife gives her husband a long look and asks:",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "zhena",
      "text": "Joe, please, tell me: do you still love me?",
      "emotion": "sad",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l4",
      "character": "narrator",
      "text": "The man irritably throws his fork down on the table.",
      "emotion": "angry",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l5",
      "character": "muzhik",
      "text": "Linda, just explain it to me: why the heck start every morning with a fight?",
      "uncensored": "Linda, just explain it to me: why the fuck start every morning with a fight?",
      "emotion": "angry",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
  "explicit": false,
