  ],
  "roles": {
    "muzhik-sosed": "father",
    "devushka": "nurse",
    "muzhik-ryzhy": "father",
    "paren": "father",
    "muzhik": "father"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Vier Männer sitzen im Krankenhaus-Wartesaal, während ihre Frauen entbinden.",
      "emotion": "neutral",
      "pauseAfterSec": 0
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Die Krankenschwester kommt zum ersten:",
      "emotion": "neutral",
      "pauseAfterSec": 0
    },
    {
      "id": "l3",
      "character": "devushka",
      "text": "Glückwunsch, Sie sind Vater von Zwillingen geworden!",
      "emotion": "happy",
      "pauseAfterSec": 0
    },
    {
      "id": "l4",
      "character": "muzhik-sosed",
      "text": "Das passt ja,",
      "emotion": "smug",
      "pauseAfterSec": 0
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "sagt der Mann stolz.",
      "emotion": "neutral",
      "pauseAfterSec": 0
    },
    {
      "id": "l6",
      "character": "muzhik-sosed",
      "text": "Ich arbeite bei Zweirad Stadler!",
      "emotion": "happy",
      "pauseAfterSec": 0
    },
    {
      "id": "l7",
      "character": "narrator",
      "text": "Wenig später sagt sie zum zweiten:",
      "emotion": "neutral",
      "pauseAfterSec": 0
    },
    {
      "id": "l8",
      "character": "devushka",
      "text": "Gratulation, es sind Drillinge!",
      "emotion": "happy",
      "pauseAfterSec": 0
    },
    {
      "id": "l9",
      "character": "muzhik-ryzhy",
      "text": "Was für ein Zufall,",
      "emotion": "surprised",
      "pauseAfterSec": 0
    },
    {
      "id": "l10",
      "character": "narrator",
      "text": "meint dieser.",
      "emotion": "neutral",
      "pauseAfterSec": 0
    },
    {
      "id": "l11",
      "character": "muzhik-ryzhy",
      "text": "Ich arbeite bei Drei M!",
      "emotion": "happy",
      "pauseAfterSec": 0
    },
    {
      "id": "l12",
      "character": "narrator",
      "text": "Die Krankenschwester geht zum dritten Mann:",
      "emotion": "neutral",
      "pauseAfterSec": 0
    },
    {
      "id": "l13",
      "character": "devushka",
      "text": "Wahnsinn, es sind Vierlinge!",
      "emotion": "surprised",
      "pauseAfterSec": 0
    },
    {
      "id": "l14",
      "character": "paren",
      "text": "Das gibt's doch nicht,",
      "emotion": "surprised",
      "pauseAfterSec": 0
    },
    {
      "id": "l15",
      "character": "narrator",
      "text": "sagt er.",
      "emotion": "neutral",
      "pauseAfterSec": 0
    },
    {
      "id": "l16",
      "character": "paren",
      "text": "Ich arbeite für Schalke null vier!",
      "emotion": "happy",
      "pauseAfterSec": 0
    },
    {
      "id": "l17",
      "character": "narrator",
      "text": "Der vierte Mann wird plötzlich kreidebleich, hält sich den Kopf",
      "emotion": "neutral",
      "pauseAfterSec": 0
    },
    {
      "id": "l18",
      "character": "narrator",
      "text": "und fängt an zu zittern.",
      "emotion": "neutral",
      "pauseAfterSec": 0
    },
    {
      "id": "l19",
      "character": "paren",
      "text": "Was ist denn mit Ihnen los?",
      "emotion": "sad",
      "pauseAfterSec": 0
    },
    {
      "id": "l20",
      "character": "narrator",
      "text": "fragen ihn die anderen mitleidig.",
      "emotion": "neutral",
      "pauseAfterSec": 0
    },
    {
      "id": "l21",
      "character": "muzhik",
      "text": "Ich arbeite bei Seven-Eleven!",
      "emotion": "surprised",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
