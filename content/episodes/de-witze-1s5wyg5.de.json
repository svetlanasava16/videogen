  "locale": "de",
  "title": "Der Wartesaal",
  "kind": "joke",
  "v": 2,
  "location": "bolnitsa",
  "place": "hospital",
  "cast": [
    "muzhik-sosed",
    "devushka",
    "muzhik-ryzhy",
