  "lines": [
    {
      "id": "l1",
      "character": "doktor",
      "text": "Erzählen Sie mir nun, wie Sie sich die Ohren verbrannt haben.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "muzhik",
      "text": "Ich habe gebügelt, als das Telefon klingelte, und habe mir das Bügeleisen ans Ohr gehalten.",
      "emotion": "sad",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l3",
      "character": "doktor",
      "text": "Aber Sie haben sich beide Ohren verbrannt!",
      "emotion": "surprised",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "Das liegt daran, dass ich sofort den Notruf wählen wollte.",
      "emotion": "neutral",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
