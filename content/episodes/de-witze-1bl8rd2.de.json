    {
      "id": "l2",
      "character": "barmen",
      "text": "Na, Junge. Hier ein Fünf-Euro-Schein, da zwei Euromünzen. Welche Hand willst du?",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "vovochka",
