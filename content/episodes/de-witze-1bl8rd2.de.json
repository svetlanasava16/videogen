{
  "id": "de-witze-1bl8rd2.de",
  "jokeId": "de-witze-1bl8rd2",
  "locale": "de",
  "title": "Das dümmste Kind",
  "kind": "joke",
  "v": 2,
  "location": "magazin",
  "place": "barbershop",
  "cast": [
    "vovochka",
    "muzhik",
    "barmen"
  ],
  "roles": {
    "vovochka": "child",
    "muzhik": "customer",
    "barmen": "craftsman"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein kleiner Junge kommt in den Friseurladen.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "barmen",
      "text": "Das ist das dümmste Kind der Stadt. Passen Sie mal auf.",
      "emotion": "smug",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "Er nimmt einen Fünf-Euro-Schein in eine Hand und zwei Ein-Euro-Münzen in die andere.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "barmen",
      "text": "Na, Junge, such dir eine Hand aus. Welche willst du?",
      "emotion": "happy",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "Der Junge nimmt die zwei Münzen und geht.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l6",
      "character": "barmen",
      "text": "Na, was hab ich Ihnen gesagt?",
      "emotion": "smug",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l7",
      "character": "narrator",
      "text": "Etwas später verlässt der Kunde den Salon. Draußen sieht er den Jungen an der Eisdiele gegenüber stehen.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l8",
      "character": "muzhik",
      "text": "Hey Kleiner, ich hab da mal 'ne Frage. Warum nimmst du die zwei Euro und nicht den Fünfer?",
      "emotion": "neutral",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l9",
      "character": "vovochka",
      "text": "An dem Tag, an dem ich den Schein nehme, ist das Spiel vorbei.",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
  "explicit": false,
