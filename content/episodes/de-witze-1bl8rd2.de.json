      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": [
        "vovochka"
      ]
    },
    {
      "id": "l4",
      "character": "barmen",
      "text": "Na, was hab ich Ihnen gesagt?",
      "emotion": "smug",
