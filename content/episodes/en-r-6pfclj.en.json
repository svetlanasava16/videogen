    {
      "id": "l1",
      "character": "narrator",
      "text": "A cop pulls over a van. In the back sit ten penguins.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "sluzhivy",
      "text": "Are those your penguins?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [
        "sluzhivy"
      ],
      "exit": []
    },
    {
      "id": "l3",
      "character": "muzhik",
      "text": "Yes, officer. They're my pets.",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "sluzhivy",
      "text": "Take them to the zoo. Right now.",
      "emotion": "angry",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": [
        "sluzhivy"
      ]
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "The next day, the same cop stops the same van. The penguins are all wearing sunglasses.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "sluzhivy",
      "text": "I told you to take those penguins to the zoo!",
      "emotion": "angry",
      "pauseAfterSec": 0.7,
      "enter": [
        "sluzhivy"
      ],
      "exit": []
    },
    {
      "id": "l7",
      "character": "muzhik",
      "text": "I did. Today we're going to the beach!",
      "emotion": "happy",
      "pauseAfterSec": 0.8,
