  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Während des Ausverkaufs versucht ein Mann, mit ein paar reduzierten Artikeln zur Kasse zu gelangen, aber er hat nicht den Hauch einer Chance.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Jedes Mal, wenn er in der Menge ein Stück weiter nach vorne gekommen ist, wird er von den noch stärker drängelnden Damen wieder nach hinten geschoben.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "Irgendwann hat er es so satt, dass er beschließt, seine Ellbogen einzusetzen, und kurz darauf steht er vor der Kasse.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "narrator",
      "text": "Die Damen, die neben ihm stehen, sind empört.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "zhena",
      "text": "Können Sie sich nicht wie ein Gentleman verhalten?",
      "emotion": "angry",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "muzhik",
      "text": "Das versuche ich schon die ganze Zeit, meine Dame.",
      "emotion": "neutral",
      "pauseAfterSec": 0.6,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "muzhik",
      "text": "Aber als ich damit nicht weiterkam, habe ich angefangen, mich wie eine Dame zu verhalten.",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
