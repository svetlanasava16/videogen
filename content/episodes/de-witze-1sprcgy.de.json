  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Schlussverkauf. Ein Mann will mit ein paar Schnäppchen zur Kasse, doch drängelnde Damen schieben ihn immer wieder nach hinten.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Irgendwann reicht es ihm. Er fährt die Ellbogen aus und steht kurz darauf an der Kasse.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [
        "muzhik"
      ],
      "exit": []
    },
    {
      "id": "l3",
      "character": "devushka",
      "text": "Also wirklich! Können Sie sich nicht wie ein Gentleman benehmen?",
      "emotion": "angry",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "Das versuche ich schon die ganze Zeit, meine Dame.",
      "emotion": "neutral",
      "pauseAfterSec": 0.7,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "muzhik",
      "text": "Weil ich damit nicht weiterkam, benehme ich mich jetzt wie eine Dame.",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    }
  ],
