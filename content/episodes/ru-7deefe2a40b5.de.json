  "locale": "de",
  "title": "Wie Seehunde sprechen",
  "kind": "joke",
  "v": 2,
  "location": "klass",
  "place": "school-classroom",
  "cast": [
    "uchilka",
    "devochka",
    "paren",
    "vovochka"
  ],
  "roles": {
    "uchilka": "teacher",
    "devochka": "child",
    "paren": "student",
    "vovochka": "vovochka"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Sachkunde in der ersten Klasse.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "uchilka",
      "text": "Kinder, wie sprechen die Tiere? Na, Lisa, sag mal?",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "devochka",
      "text": "Die Kuh macht Muuuh.",
      "emotion": "happy",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "uchilka",
      "text": "Brav, Lisa, setz dich, eine Eins. Und was sagst du, Kevin?",
      "emotion": "happy",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "paren",
      "text": "Die Hunde machen Wau-wau.",
      "emotion": "happy",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l6",
      "character": "uchilka",
      "text": "Prima, Kevin, eine Eins.",
      "emotion": "happy",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l7",
      "character": "narrator",
      "text": "Fritzchen streckt so eifrig den Finger, dass er fast vom Stuhl fällt.",
      "emotion": "neutral",
      "pauseAfterSec": 0.2
    },
    {
      "id": "l8",
      "character": "vovochka",
      "text": "Frau Müller, Frau Müller, ich weiß, wie Seehunde sprechen!",
      "emotion": "happy",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l9",
      "character": "uchilka",
      "text": "Na, und wie sprechen Seehunde?",
      "emotion": "surprised",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l10",
      "character": "vovochka",
      "text": "Oh Mist, ist das Wasser ka-a-alt!",
      "uncensored": "Oh Scheiße, ist das Wasser ka-a-alt!",
      "emotion": "surprised",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
