  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Ihr Liebhaber hat einer Frau einen Nerzmantel geschenkt. Sie überlegt, wie sie es ihrem Mann sagen soll. Sie überlegte und überlegte und hatte eine Idee.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "zhena",
      "text": "Liebling, stell dir vor, ich habe auf der Straße einen Schein von der Gepäckaufbewahrung gefunden.",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "zhena",
      "text": "Geh doch mal zum Bahnhof, Schatz, vielleicht ist da was Schönes drin.",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "narrator",
      "text": "Der Mann geht mit dem Schein los, kommt dann zurück und sagt:",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "muzhik",
      "text": "Umsonst gelaufen. Irgendeine alte Tasche mit stinkenden Lumpen.",
      "emotion": "neutral",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "Am nächsten Tag kam die Sekretärin des Mannes im Nerzmantel zur Arbeit.",
      "emotion": "neutral",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
