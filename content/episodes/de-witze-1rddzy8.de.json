    {
      "id": "l1",
      "character": "paren",
      "text": "Chef, kann ich heute drei Stunden früher Feierabend machen?",
      "emotion": "happy",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "paren",
      "text": "Meine Frau will unbedingt mit mir einkaufen gehen.",
      "emotion": "sad",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l3",
      "character": "nachalnik",
      "text": "Das kommt überhaupt nicht infrage, ich bezahle dich doch nicht für die freie Zeit!",
      "emotion": "angry",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l4",
      "character": "paren",
      "text": "Danke, ich wusste, dass ich mich auf Sie verlassen kann!",
      "emotion": "happy",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
