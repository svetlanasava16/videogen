      "id": "l1",
      "character": "muzhik",
      "text": "My son is three years old and I took him shopping.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "muzhik",
      "text": "When we got home, he had a chocolate bar in his pocket.",
