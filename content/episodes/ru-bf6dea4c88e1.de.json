{
  "id": "ru-bf6dea4c88e1.de",
  "jokeId": "ru-bf6dea4c88e1",
  "locale": "de",
  "title": "Der saftige Rasen",
  "kind": "joke",
  "v": 2,
  "location": "doroga",
  "place": "car",
  "cast": [
    "muzhik",
    "nachalnik"
  ],
  "roles": {
    "muzhik": "homeless",
    "nachalnik": "new-russian"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Also, ein Neureicher fährt in seinem Mercedes und sieht einen Obdachlosen, der auf dem Rasen Gras kaut.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "nachalnik",
      "text": "Was machst du da, Mann?! Spinnst du?!",
      "emotion": "angry",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "muzhik",
      "text": "Ich habe seit drei Tagen nichts gegessen, guter Mann! Da kaue ich wenigstens ein bisschen Gras!",
      "emotion": "sad",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "nachalnik",
      "text": "Ach, du armer Kerl! Na los, spring rein! Ich bin heute gut drauf! Du fährst mit mir!",
      "emotion": "happy",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "Sie fahren also los.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l6",
      "character": "muzhik",
      "text": "Danke dir, guter Mensch! Die Leute sagen zu Unrecht, dass Reiche geizig sind!",
      "emotion": "happy",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l7",
      "character": "nachalnik",
      "text": "Schon gut, Bruder! Gleich sind wir bei mir in der Villa, dann siehst du selbst, wie saftig und ungemäht mein Rasen ist!",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
