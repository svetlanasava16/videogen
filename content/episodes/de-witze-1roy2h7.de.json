    {
      "id": "l1",
      "character": "paren",
      "text": "Hast du gehört? Unser Direktor ist gestorben.",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "devushka",
      "text": "Ja, und ich frage mich die ganze Zeit, wer da mit ihm gestorben ist.",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "paren",
      "text": "Wieso mit ihm?",
      "emotion": "surprised",
      "pauseAfterSec": 0.7,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "devushka",
      "text": "Na, in der Anzeige stand doch: Mit ihm starb einer unserer fähigsten Mitarbeiter.",
