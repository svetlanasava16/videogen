  "lines": [
    {
      "id": "l1",
      "character": "muzhik",
      "text": "Guys, is that your bull terrier running around here?!",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "nachalnik",
      "text": "Yeah, it's ours. What the heck do you want?",
      "uncensored": "Yeah, it's ours. What the fuck do you want?",
      "emotion": "angry",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "muzhik",
      "text": "You see, we're having a picnic nearby too,",
      "emotion": "sad",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l3b",
      "character": "muzhik",
      "text": "and my little dog accidentally killed yours!",
      "emotion": "sad",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "muzhik-ryzhy",
      "text": "No freaking way!? What kind of beast have you got?",
      "uncensored": "No fucking way!? What kind of beast have you got?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "muzhik",
      "text": "Oh, just a tiny little poodle!",
      "emotion": "neutral",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l6",
      "character": "muzhik",
      "text": "Yours choked on it!",
      "emotion": "sad",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
