  "title": "Die Benimmschule",
  "kind": "joke",
  "v": 2,
  "location": "ulitsa",
  "place": "street",
  "cast": [
    "devushka",
    "devushka-blondinka"
  ],
  "roles": {
    "devushka": "woman",
    "devushka-blondinka": "woman"
  },
  "lines": [
    {
      "id": "l1",
      "character": "devushka",
      "text": "Wie geht's?",
      "emotion": "neutral",
      "pauseAfterSec": 0.2
    },
    {
      "id": "l2",
      "character": "devushka-blondinka",
      "text": "Wunderbar!",
      "emotion": "smug",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l2b",
      "character": "devushka-blondinka",
      "text": "Weißt du, mein Liebhaber hat versprochen, mir einen Nerzmantel zu kaufen...",
      "emotion": "smug",
      "pauseAfterSec": 0.2
    },
    {
      "id": "l3",
      "character": "devushka",
      "text": "Fantastisch!",
      "emotion": "happy",
      "pauseAfterSec": 0.2
    },
    {
      "id": "l4",
      "character": "devushka-blondinka",
      "text": "...und er hat versprochen, mir einen Jaguar zu kaufen...",
      "emotion": "smug",
      "pauseAfterSec": 0.2
    },
    {
      "id": "l5",
      "character": "devushka",
      "text": "Fantastisch!",
      "emotion": "happy",
      "pauseAfterSec": 0.2
    },
    {
      "id": "l6",
      "character": "devushka-blondinka",
      "text": "...und wir fahren zusammen in den Urlaub auf die Kanaren!",
      "emotion": "happy",
      "pauseAfterSec": 0.2
    },
    {
      "id": "l7",
      "character": "devushka",
      "text": "Fantastisch!",
      "emotion": "happy",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l8",
      "character": "devushka-blondinka",
      "text": "Und was gibt's bei dir Neues?",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l9",
      "character": "devushka",
      "text": "Ich gehe auf eine Benimmschule.",
      "emotion": "smug",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l10",
      "character": "devushka-blondinka",
      "text": "Und was lernt man da?",
      "emotion": "surprised",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l11",
      "character": "devushka",
      "text": "Na, zum Beispiel haben sie uns in der letzten Stunde beigebracht,",
      "uncensored": "Na, zum Beispiel haben sie uns in der letzten Stunde beigebracht,",
      "emotion": "smug",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l11b",
      "character": "devushka",
      "text": "statt „Erzähl keinen Mist!“ zu sagen: „Fantastisch!“",
      "uncensored": "statt „Erzähl keinen Scheiß!“ zu sagen: „Fantastisch!“",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
