    {
      "id": "l3",
      "character": "muzhik",
      "text": "Oh Gott, Herr Doktor, was ist denn dann die gute Nachricht?",
      "emotion": "surprised",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l4",
      "character": "doktor",
      "text": "Der Herr nebenan kauft Ihnen die Schuhe ab.",
