      "id": "l1",
      "character": "narrator",
      "text": "A guy in a Porsche pulls up next to a truck and shouts to the driver:",
      "emotion": "neutral",
      "pauseAfterSec": 0.2,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "nachalnik",
      "text": "My name is Ray, I make a grand a day, next to me sits my bae, and you're losing your load!",
