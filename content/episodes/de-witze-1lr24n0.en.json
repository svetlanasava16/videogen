  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "A guy in a Porsche pulls up next to a truck and shouts to the driver:",
      "emotion": "neutral",
      "pauseAfterSec": 0.2
    },
    {
      "id": "l2",
      "character": "nachalnik",
      "text": "My name is Ray, I make a grand a day, next to me sits my bae, and you're losing your load!",
      "emotion": "smug",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "The truck driver shakes his head and drives on. Then the Porsche pulls up again:",
      "emotion": "neutral",
      "pauseAfterSec": 0.2
    },
    {
      "id": "l4",
      "character": "nachalnik",
      "text": "My name is Ray, I make a grand a day, next to me sits my bae, and you're losing your load!",
      "emotion": "smug",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "Again the truck driver drives on. After this happens a few more times, the driver has had enough and shouts back:",
      "emotion": "neutral",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l6",
      "character": "muzhik-ryzhy",
      "text": "My name is Pete, there's snow and sleet, and this is a salt truck!",
      "emotion": "angry",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
