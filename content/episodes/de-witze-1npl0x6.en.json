  "lines": [
    {
      "id": "l1",
      "character": "nachalnik",
      "text": "Excuse me for asking, but you are ninety-four and ninety-eight years old and have been married for over sixty years.",
      "emotion": "surprised",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "nachalnik",
      "text": "Why do you want to get divorced now?",
      "emotion": "surprised",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l3",
      "character": "tyoshcha",
      "text": "Well, it hasn't been working for a long time,",
      "emotion": "neutral",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l3b",
      "character": "tyoshcha",
      "text": "but we wanted to wait until the children were dead.",
      "emotion": "neutral",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
