  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "I was sitting on a bus with a friend and he told me this joke.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "muzhik",
      "text": "What do you do if you see an epileptic having a fit in the bath?",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "muzhik",
      "text": "Throw in your laundry.",
      "emotion": "happy",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": [],
      "laugh": "chuckle"
    },
    {
      "id": "l4",
      "character": "narrator",
      "text": "The guy behind us leaned over and said:",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "muzhik-sosed",
      "text": "I think that's disgusting. My son died in the bath whilst having a fit.",
      "emotion": "angry",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "We both went white and apologised.",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "narrator",
      "text": "The guy got up to get off and said:",
      "emotion": "neutral",
      "pauseAfterSec": 0.7,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "muzhik-sosed",
      "text": "He choked on a sock.",
      "emotion": "neutral",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [
        "muzhik-sosed"
      ],
      "laugh": "big"
    }
  ],
