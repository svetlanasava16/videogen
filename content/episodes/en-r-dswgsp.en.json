  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "A guy was sitting on a bus with a friend, and the friend told him this joke.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "muzhik",
      "text": "What do you do if you see an epileptic having a fit in the bath?",
      "emotion": "happy",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "muzhik",
      "text": "Throw in your laundry.",
      "emotion": "happy",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": [],
      "laugh": "chuckle"
    },
    {
      "id": "l4",
      "character": "ded",
      "text": "I think that's disgusting. My son died in the bath whilst having a fit.",
      "emotion": "angry",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "They both went white and apologised. The man got up to get off.",
      "emotion": "neutral",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "ded",
      "text": "He choked on a sock.",
      "emotion": "neutral",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [
        "ded"
      ],
      "laugh": "big"
    }
  ],
