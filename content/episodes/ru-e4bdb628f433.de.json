{
  "id": "ru-e4bdb628f433.de",
  "jokeId": "ru-e4bdb628f433",
  "locale": "de",
  "title": "Keiner zu Hause",
  "location": "derevnya",
  "place": "street",
  "cast": [
    "muzhik",
    "pyos"
  ],
  "roles": {
    "muzhik": "everyman",
    "pyos": "dog"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein Mann kommt an das Tor seines Nachbarn und klopft.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Er klopft und klopft, aber niemand antwortet. Er klopft stärker.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "Leise kommt ein Hund ans Tor.",
      "emotion": "neutral",
      "pauseAfterSec": 0.2,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "pyos",
      "text": "Mann, hör auf zu klopfen, es ist keiner zu Hause.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "Der Mann fällt auf der Stelle in Ohnmacht. Als er wieder zu sich kommt, sieht er den Hund an.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "muzhik",
      "text": "Was ist los mit dir, Hund, kannst du nicht bellen?",
      "emotion": "surprised",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "pyos",
      "text": "Doch, aber ich wollte dich nicht erschrecken.",
      "emotion": "happy",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
