  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein Mann klopft am Tor seines Nachbarn.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "muzhik",
      "text": "Hallo? Ist jemand zu Hause?",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "muzhik",
      "text": "Aufmachen!",
      "emotion": "angry",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "pyos",
      "text": "Hör auf zu klopfen, Mann. Es ist keiner da.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [
        "pyos"
      ],
      "exit": []
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "Der Mann fällt in Ohnmacht. Eine Minute später kommt er zu sich.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "muzhik",
      "text": "Kannst du nicht bellen wie ein normaler Hund?",
      "emotion": "surprised",
      "pauseAfterSec": 0.7,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "pyos",
      "text": "Kann ich. Ich wollte dich bloß nicht erschrecken.",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    }
  ],
