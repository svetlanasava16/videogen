{
  "id": "ru-e4bdb628f433.de",
  "jokeId": "ru-e4bdb628f433",
  "locale": "de",
  "title": "Der höfliche Hund",
  "kind": "joke",
  "v": 2,
  "location": "derevnya",
  "place": "street",
  "cast": [
    "pyos",
    "muzhik"
  ],
  "roles": {
    "pyos": "dog",
    "muzhik": "everyman"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein Mann kommt an das Tor seines Nachbarn",
      "emotion": "neutral",
      "pauseAfterSec": 0
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "und klopft.",
      "emotion": "neutral",
      "pauseAfterSec": 0
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "Er klopft und klopft, aber niemand antwortet.",
      "emotion": "neutral",
      "pauseAfterSec": 0
    },
    {
      "id": "l4",
      "character": "narrator",
      "text": "Er klopft fester.",
      "emotion": "neutral",
      "pauseAfterSec": 0
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "Leise kommt ein Hund ans Tor und sagt:",
      "emotion": "neutral",
      "pauseAfterSec": 0
    },
    {
      "id": "l6",
      "character": "pyos",
      "text": "Mann, klopf nicht, es ist keiner zu Hause.",
      "emotion": "neutral",
      "pauseAfterSec": 0
    },
    {
      "id": "l7",
      "character": "narrator",
      "text": "Da fällt der Mann sofort in Ohnmacht.",
      "emotion": "surprised",
      "pauseAfterSec": 0
    },
    {
      "id": "l8",
      "character": "narrator",
      "text": "Danach kommt er wieder zu sich, schaut den Hund an und sagt:",
      "emotion": "neutral",
      "pauseAfterSec": 0
    },
    {
      "id": "l9",
      "character": "muzhik",
      "text": "Was ist los mit dir, Hund, kannst du nicht bellen?",
      "emotion": "angry",
      "pauseAfterSec": 0
    },
    {
      "id": "l10",
      "character": "narrator",
      "text": "Der Hund antwortet:",
      "emotion": "neutral",
      "pauseAfterSec": 0
    },
    {
      "id": "l11",
      "character": "pyos",
      "text": "Kann ich, aber ich wollte dich nicht erschrecken.",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
  "explicit": false,
