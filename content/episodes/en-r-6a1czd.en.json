  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "A group of engineering professors were invited to fly in a plane.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "devushka-blondinka",
      "text": "This plane was built by your students.",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "All but one got off their seats and headed frantically to the exits in maniacal panic.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "devushka-blondinka",
      "text": "Why did you stay put?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "doktor",
      "text": "I have plenty of confidence in my students.",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "doktor",
      "text": "Knowing them, I for a fact can assure you this piece of crap plane will never even start.",
