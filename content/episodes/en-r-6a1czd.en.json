        "ded"
      ]
    },
    {
      "id": "l4",
      "character": "devushka-blondinka",
      "text": "Professor, everyone ran for the exits. Why are you still sitting here?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "doktor",
      "text": "I know my students very well.",
      "emotion": "smug",
      "pauseAfterSec": 0.7,
      "enter": [],
      "exit": []
    },
    {
