    {
      "id": "l1",
      "character": "narrator",
      "text": "A group of engineering professors take their seats on a brand new plane.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "devushka-blondinka",
      "text": "Ladies and gentlemen, you'll be proud to hear this plane was built by your own students!",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "ded",
      "text": "Our students? Let me off this thing!",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
