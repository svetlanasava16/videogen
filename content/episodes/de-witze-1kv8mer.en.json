  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "A man is walking past a fence and hears a few people on the other side shouting:",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "muzhik-sosed",
      "text": "Thirteen, thirteen, thirteen!",
      "emotion": "happy",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "muzhik",
      "text": "I wonder what they're doing.",
      "emotion": "surprised",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "narrator",
      "text": "A few steps further there's a hole in the fence, and he looks through it. At that moment a finger pokes him in the eye from the other side, and the people shout:",
      "emotion": "neutral",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l5",
      "character": "muzhik-sosed",
      "text": "Fourteen, fourteen, fourteen!",
      "emotion": "happy",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
