    {
      "id": "l1",
      "character": "narrator",
      "text": "Der Programmierer-Nerd wird von seiner Frau zum Einkaufen geschickt.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "zhena",
      "text": "Bring einen Liter Milch. Und falls sie Eier haben, bring zehn.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "Er kommt zurück mit zehn Liter Milch.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "zhena",
      "text": "Wieso bringst du zehn Liter Milch?",
      "emotion": "angry",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l5",
      "character": "paren",
      "text": "Na, weil sie Eier hatten!",
      "emotion": "happy",
      "pauseAfterSec": 0.8,
