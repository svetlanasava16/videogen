  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "A man walks into a pet shop.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "muzhik",
      "text": "Good afternoon, I'd like a hundred chicks.",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [
        "muzhik"
      ],
      "exit": []
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "The shopkeeper wonders what he wants with all those chicks, but says nothing for now and sells them to him.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": [
        "muzhik"
      ]
    },
    {
      "id": "l4",
      "character": "narrator",
      "text": "A few days later the man is back in the shop.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [
        "muzhik"
      ],
      "exit": []
    },
    {
      "id": "l5",
      "character": "muzhik",
      "text": "Good afternoon, another hundred chicks, please.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "This happens a few more times, until one day the shop owner asks, puzzled:",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "barmen",
      "text": "Tell me, what on earth do you do with all those chicks?",
      "emotion": "surprised",
      "pauseAfterSec": 0.6,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "muzhik",
      "text": "I don't know either! Either I plant them too deep or too close together!",
      "emotion": "sad",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
