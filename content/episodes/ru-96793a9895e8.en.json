{
  "id": "ru-96793a9895e8.en",
  "jokeId": "ru-96793a9895e8",
  "locale": "en",
  "title": "The Gravedigger",
  "location": "ulitsa",
  "place": "cemetery",
  "cast": [
    "muzhik",
    "muzhik-ryzhy"
  ],
  "roles": {
    "muzhik": "drunk",
    "muzhik-ryzhy": "everyman"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "A drunk got wasted at the cemetery, fell into a grave and fell asleep.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "He wakes up at night and figures out he's in a cemetery. He looks, and a gravedigger is digging a grave.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "muzhik",
      "text": "Let me give him a scare.",
      "emotion": "smug",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "narrator",
      "text": "He finds some white sheet, throws it over his head, walks up to the gravedigger and wails in a scary voice:",
      "emotion": "neutral",
      "pauseAfterSec": 0.2,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "muzhik",
      "text": "Woooooooo!",
      "emotion": "angry",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "The gravedigger gives him a totally couldn't-care-less look and keeps digging the grave.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "narrator",
      "text": "The drunk doesn't get it, comes up from the other side, even louder and scarier:",
      "emotion": "neutral",
      "pauseAfterSec": 0.2,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "muzhik",
      "text": "Wooo! Wooo! Wooo! Woooooooo!",
      "emotion": "angry",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l9",
      "character": "narrator",
      "text": "Again the gravedigger couldn't care less, looks at him, damn it, no reaction at all.",
      "uncensored": "Again the gravedigger couldn't care less, looks at him, fuck it, no reaction at all.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l10",
      "character": "narrator",
      "text": "So the drunk gets upset and heads for the cemetery exit, even forgets to take off the sheet.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l11",
      "character": "narrator",
      "text": "He reaches the gate, the gravedigger catches up, smacks him in his freaking face with the shovel and calmly says:",
      "uncensored": "He reaches the gate, the gravedigger catches up, smacks him in his fucking face with the shovel and calmly says:",
      "emotion": "neutral",
      "pauseAfterSec": 0.6,
      "enter": [],
      "exit": []
    },
    {
      "id": "l12",
      "character": "muzhik-ryzhy",
      "text": "Wander around all you like, but don't leave the grounds.",
      "emotion": "neutral",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
