    {
      "id": "l1",
      "character": "narrator",
      "text": "Ruft ein Mädel beim Radio an und sagt:",
      "emotion": "neutral",
      "pauseAfterSec": 0
    },
    {
      "id": "l2",
      "character": "devushka",
      "text": "Gestern habe ich ein Portemonnaie gefunden, da waren fünftausend Dollar drin,",
      "emotion": "happy",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l2b",
      "character": "devushka",
      "text": "sechshundertachtzehn Euro und eine Visitenkarte auf den Namen Gerd Maier,",
      "emotion": "happy",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l2c",
      "character": "devushka",
      "text": "Schillerstraße neunzehn...",
      "emotion": "happy",
      "pauseAfterSec": 0
    },
    {
      "id": "l3",
      "character": "devushka",
      "text": "Spielen Sie ihm doch bitte irgendein schönes Lied!",
      "emotion": "happy",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
