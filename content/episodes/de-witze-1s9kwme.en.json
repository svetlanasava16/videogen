  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "A photographer for a nature and science magazine was sent to take pictures of a huge forest fire.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "There was so much smoke near the ground that his publisher rented him a small plane for some aerial shots. The pilot was already waiting at a local airfield nearby.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "paren",
      "text": "Come on, quick! We're taking off right now!",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [
        "paren"
      ],
      "exit": []
    },
    {
      "id": "l4",
      "character": "narrator",
      "text": "As the plane took off, the photographer gave the pilot his instructions:",
      "emotion": "neutral",
      "pauseAfterSec": 0.2,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "paren",
      "text": "I want you to fly over the north side of the fire and make three or four really low passes over it.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "sluzhivy",
      "text": "Why?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "paren",
      "text": "What do you mean, why?",
      "emotion": "angry",
      "pauseAfterSec": 0.2,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "paren",
      "text": "So I can take some pictures, of course! I'm a photographer, and a photographer takes photos!",
      "emotion": "angry",
      "pauseAfterSec": 0.6,
      "enter": [],
      "exit": []
    },
    {
      "id": "l9",
      "character": "sluzhivy",
      "text": "You mean... you're not the flight instructor?",
      "emotion": "surprised",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
