    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein junger Mann sucht einen Nebenjob und bewirbt sich beim nahegelegenen Supermarkt.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Er bekommt den Job und erhält am ersten Tag vom Filialleiter den Auftrag, den Eingang zu kehren.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "paren",
      "text": "Kehren?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "paren",
      "text": "Entschuldigung, aber Sie wissen schon, dass ich Philosophie und Germanistik studiert habe!",
      "emotion": "angry",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "nachalnik",
      "text": "Nein. Das wusste ich tatsächlich nicht.",
      "emotion": "surprised",
      "pauseAfterSec": 0.6,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "nachalnik",
      "text": "Ist aber kein Problem, ich zeige Ihnen, wie es geht!",
      "emotion": "happy",
      "pauseAfterSec": 0.8,
