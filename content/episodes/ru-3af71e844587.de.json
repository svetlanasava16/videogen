{
  "id": "ru-3af71e844587.de",
  "jokeId": "ru-3af71e844587",
  "locale": "de",
  "title": "Arthritis",
  "location": "doroga",
  "place": "bus",
  "cast": [
    "muzhik",
    "batyushka"
  ],
  "roles": {
    "muzhik": "drunk",
    "batyushka": "priest"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein sturzbetrunkener Typ mit zerrissenem Hemd, Lippenstift im Gesicht und leeren Flaschen in den Taschen steigt in den Bus und setzt sich neben einen Pfarrer.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Der Betrunkene schlägt eine Zeitung auf und liest etwas.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "muzhik",
      "text": "Sagen Sie, Hochwürden, wissen Sie, wovon man Arthritis bekommt?",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "batyushka",
      "text": "Arthritis, mein Sohn, bekommen Menschen, die vom rechten Weg abgekommen sind, die mit gefallenen Frauen schlafen und Alkohol missbrauchen!",
      "emotion": "angry",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "muzhik",
      "text": "Verdammt noch mal...",
      "emotion": "surprised",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "Der Betrunkene verstummt und starrt nachdenklich auf den Boden. Der Pfarrer bereut, dass er so scharf geworden ist.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "batyushka",
      "text": "Na gut, mein Sohn! Wie lange hast du schon Arthritis?",
      "emotion": "sad",
      "pauseAfterSec": 0.6,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "muzhik",
      "text": "Was reden Sie denn da! Ich habe keine Arthritis! Hier in der Zeitung steht, dass der Papst Arthritis hat!",
      "emotion": "surprised",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
