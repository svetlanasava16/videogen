  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "A young artist is showing his art at an exhibition for the first time.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "There he meets a famous art critic.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "paren",
      "text": "Please, could I have your honest opinion of my art?",
      "emotion": "happy",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "nachalnik",
      "text": "It's worthless.",
      "emotion": "smug",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l5",
      "character": "paren",
      "text": "I know, but I'd still like to hear it.",
      "emotion": "neutral",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
