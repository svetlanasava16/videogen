    "paren": "everyman"
  },
  "lines": [
    {
      "id": "l1",
      "character": "vovochka-drug",
      "text": "Herr Gruppenleiter, ist die Schlange giftig?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "paren",
      "text": "Nein, die Schlange ist überhaupt nicht giftig.",
      "emotion": "smug",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "Der Junge hebt die Schlange auf, sie beißt ihn, und er bekommt Krämpfe und Schaum vor dem Mund, während die anderen Kinder entsetzt zusehen.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l4",
      "character": "paren",
      "text": "Aber die Schlange ist venomös.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "paren",
      "text": "Giftig ist, was man schluckt oder berührt, venomös ist, was injiziert wird.",
      "emotion": "smug",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l6",
      "character": "paren",
      "text": "Nächstes Mal machen wir es richtig, Jungs.",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
