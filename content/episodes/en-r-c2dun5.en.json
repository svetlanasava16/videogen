{
  "id": "en-r-c2dun5.en",
  "jokeId": "en-r-c2dun5",
  "locale": "en",
  "title": "Golf Clubs",
  "kind": "joke",
  "v": 2,
  "location": "gostinaya",
  "place": "home-living-room",
  "cast": [
    "zhena",
    "muzhik"
  ],
  "roles": {
    "zhena": "wife",
    "muzhik": "husband"
  },
  "lines": [
    {
      "id": "l1",
      "character": "zhena",
      "text": "Honey, if I died, would you remarry?",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "muzhik",
      "text": "After a considerable period of grieving, I guess I would. We all need companionship.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "zhena",
      "text": "If I died and you remarried, would she live in this house?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "We've spent a lot of money getting this house just the way we want it.",
      "emotion": "neutral",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l4b",
      "character": "muzhik",
      "text": "I'm not going to get rid of my house. I guess she would.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "zhena",
      "text": "If I died and you remarried, and she lived in this house, would she sleep in our bed?",
      "emotion": "angry",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l6",
      "character": "muzhik",
      "text": "Well, the bed is brand new, and it cost us two thousand dollars.",
      "emotion": "neutral",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l6b",
      "character": "muzhik",
      "text": "It's going to last a long time, so I guess she would.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l7",
      "character": "zhena",
      "text": "If I died and you remarried,",
      "emotion": "angry",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l7b",
      "character": "zhena",
      "text": "and she lived in this house and slept in our bed, would she use my golf clubs?",
      "emotion": "angry",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l8",
      "character": "muzhik",
      "text": "Oh, no. She's left-handed!",
      "emotion": "happy",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
