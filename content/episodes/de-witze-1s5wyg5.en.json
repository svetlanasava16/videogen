  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Four men are sitting in the hospital waiting room while their wives give birth.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "devushka",
      "text": "Congratulations, you're the father of twins!",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [
        "devushka"
      ],
      "exit": []
    },
    {
      "id": "l3",
      "character": "muzhik-sosed",
      "text": "That figures. I work for the Minnesota Twins!",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "devushka",
      "text": "Congratulations, it's triplets!",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "muzhik-ryzhy",
      "text": "What a coincidence. I work at Three M!",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "devushka",
      "text": "Unbelievable, it's quadruplets!",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "paren",
      "text": "No way. I work at the Four Seasons!",
      "emotion": "surprised",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "narrator",
      "text": "The fourth man suddenly turns white as chalk, clutches his head and starts to shake.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l9",
      "character": "muzhik-sosed",
      "text": "What's wrong with you?",
      "emotion": "sad",
      "pauseAfterSec": 0.7,
      "enter": [],
      "exit": []
    },
    {
      "id": "l10",
      "character": "muzhik",
      "text": "I work at Seven-Eleven!",
      "emotion": "surprised",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
