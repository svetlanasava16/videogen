  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "A drunk man is standing in a tram, yelling at the passengers on his left.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "muzhik",
      "text": "Nothing but idiots, nothing but idiots!",
      "emotion": "angry",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "Then he bellows at the people on his right.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "Nothing but adulterers, nothing but adulterers!",
      "emotion": "angry",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "muzhik-sosed",
      "text": "How dare you?",
      "emotion": "angry",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l5b",
      "character": "muzhik-sosed",
      "text": "I've been married for twenty years, and I've never once cheated on my wife!",
      "emotion": "angry",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l6",
      "character": "muzhik",
      "text": "Then go sit over there with the idiots!",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
