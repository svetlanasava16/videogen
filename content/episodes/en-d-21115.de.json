  "lines": [
    {
      "id": "l1",
      "character": "muzhik",
      "text": "Mein Sohn kam überhaupt nicht damit klar, ins Gefängnis zu kommen.",
      "emotion": "sad",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "muzhik",
      "text": "Er weigerte sich, irgendetwas zu essen oder zu trinken.",
      "emotion": "sad",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "muzhik",
      "text": "Er beschimpfte alle und beschmierte sein Zimmer mit seinem eigenen Mist.",
      "uncensored": "Er beschimpfte alle und beschmierte sein Zimmer mit seiner eigenen Scheiße.",
      "emotion": "angry",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "Danach haben wir nie wieder Monopoly gespielt.",
      "emotion": "neutral",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
