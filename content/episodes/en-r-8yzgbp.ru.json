{
  "id": "en-r-8yzgbp.ru",
  "jokeId": "en-r-8yzgbp",
  "locale": "ru",
  "title": "Всё болит",
  "kind": "joke",
  "v": 2,
  "location": "bolnitsa",
  "place": "doctor-office",
  "cast": [
    "doktor",
    "devushka-blondinka"
  ],
  "roles": {
    "doktor": "doctor",
    "devushka-blondinka": "blonde"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Шикарная молодая брюнетка приходит к врачу.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "devushka-blondinka",
      "text": "Доктор, у меня всё тело болит, где ни дотронусь.",
      "emotion": "sad",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "doktor",
      "text": "Не может быть! Покажите.",
      "emotion": "surprised",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "narrator",
      "text": "Она взяла палец и нажала на левое запястье.",
      "emotion": "neutral",
      "pauseAfterSec": 0.2
    },
    {
      "id": "l5",
      "character": "devushka-blondinka",
      "text": "Ай!",
      "emotion": "sad",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "Потом нажала на локоть.",
      "emotion": "neutral",
      "pauseAfterSec": 0.2
    },
    {
      "id": "l7",
      "character": "devushka-blondinka",
      "text": "Ай-ай-ай!",
      "emotion": "sad",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l8",
      "character": "narrator",
      "text": "Нажала на колено, потом на лодыжку.",
      "emotion": "neutral",
      "pauseAfterSec": 0.2
    },
    {
      "id": "l9",
      "character": "devushka-blondinka",
      "text": "Ай! Ай!",
      "emotion": "sad",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l10",
      "character": "doktor",
      "text": "Вы ведь не настоящая брюнетка, правда?",
      "emotion": "smug",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l11",
      "character": "devushka-blondinka",
      "text": "Ну, нет. Вообще-то я блондинка.",
      "emotion": "surprised",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l12",
      "character": "doktor",
      "text": "Так я и думал. У вас сломан палец.",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
