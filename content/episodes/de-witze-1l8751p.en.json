  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "A man goes to the doctor.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "muzhik",
      "text": "Doctor, these last few weeks I've been feeling so weak and limp all the time.",
      "emotion": "sad",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l2b",
      "character": "muzhik",
      "text": "What could it be?",
      "emotion": "sad",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "doktor",
      "text": "What do you do for a living?",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "Civil servant.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "doktor",
      "text": "Ah, and these last few weeks, how have they been?",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l6",
      "character": "muzhik",
      "text": "Well, actually, I'm on vacation at the moment...",
      "emotion": "sad",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l7",
      "character": "doktor",
      "text": "Well then, it's all clear. You're missing your sleep!",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
