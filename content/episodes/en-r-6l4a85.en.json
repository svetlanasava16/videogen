  "lines": [
    {
      "id": "l1",
      "character": "vovochka-drug",
      "text": "Johnny, adults have a deep dark secret and can be easily manipulated.",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Johnny decides to test it.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "vovochka",
      "text": "Mom, I know everything.",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "narrator",
      "text": "Mom shushes him and gives him ten dollars.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "zhena",
      "text": "Just don't tell Dad.",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "vovochka",
      "text": "Hey, it's working.",
      "emotion": "happy",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": [],
      "laugh": "chuckle"
    },
    {
      "id": "l7",
      "character": "narrator",
      "text": "An hour later, Dad comes home from work.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "vovochka",
      "text": "Dad, I know everything.",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l9",
      "character": "narrator",
      "text": "Dad gives Johnny a hundred dollars.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l10",
      "character": "muzhik",
      "text": "Don't tell Mom.",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l11",
      "character": "narrator",
      "text": "Just then, the mailman knocks on the door.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l12",
      "character": "vovochka",
      "text": "I know everything, Mister.",
      "emotion": "smug",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l13",
      "character": "narrator",
      "text": "The mailman drops all his mail, his eyes tear up, and he says:",
      "emotion": "neutral",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    },
    {
      "id": "l14",
      "character": "paren",
      "text": "Well then Johnny, come give Daddy a hug.",
      "emotion": "happy",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
