    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein Reporter fragt den Direktor einer Irrenanstalt:",
      "emotion": "neutral",
      "pauseAfterSec": 0.2,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "paren",
      "text": "Welcher Test entscheidet bei Ihnen über die Entlassung?",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "doktor",
      "text": "Wir füllen eine Badewanne mit Wasser, legen einen Teelöffel und einen großen Becher daneben und bitten, die Wanne zu leeren.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "paren",
      "text": "Na, jeder normale Mensch nimmt den Becher.",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "doktor",
      "text": "Nein. Ein normaler Mensch zieht den Stöpsel.",
      "emotion": "neutral",
      "pauseAfterSec": 0.8,
