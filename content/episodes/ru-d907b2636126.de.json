  "locale": "de",
  "title": "Der Entlassungstest",
  "kind": "joke",
  "v": 2,
  "location": "bolnitsa",
  "place": "hospital",
  "cast": [
    "paren",
    "doktor"
  ],
  "roles": {
    "paren": "journalist",
    "doktor": "doctor"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein Reporter fragt den Direktor einer Irrenanstalt:",
      "emotion": "neutral",
      "pauseAfterSec": 0.2
    },
    {
      "id": "l2",
      "character": "paren",
      "text": "Welcher Test entscheidet bei Ihnen über die Entlassung?",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "doktor",
      "text": "Wir füllen eine Badewanne mit Wasser,",
      "emotion": "neutral",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l3b",
      "character": "doktor",
      "text": "legen einen Teelöffel und einen großen Becher daneben und bitten, die Wanne zu leeren.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l4",
      "character": "paren",
      "text": "Na, jeder normale Mensch nimmt den Becher.",
      "emotion": "smug",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l5",
      "character": "doktor",
      "text": "Nein. Ein normaler Mensch zieht den Stöpsel.",
      "emotion": "neutral",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
