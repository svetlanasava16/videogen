  "lines": [
    {
      "id": "l1",
      "character": "paren",
      "text": "Herr Doktor, woran erkennen Sie, dass ein Patient entlassen werden kann?",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [
        "paren"
      ],
      "exit": []
    },
    {
      "id": "l2",
      "character": "doktor",
      "text": "Wir lassen eine Badewanne voll Wasser laufen.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "doktor",
      "text": "Daneben legen wir einen Teelöffel und einen großen Becher.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "doktor",
      "text": "Dann bitten wir den Patienten, die Wanne zu leeren.",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "paren",
      "text": "Ach so. Jeder normale Mensch nimmt natürlich den Becher.",
      "emotion": "happy",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "doktor",
      "text": "Nein. Ein normaler Mensch zieht den Stöpsel.",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    }
  ],
