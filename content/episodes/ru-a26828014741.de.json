{
  "id": "ru-a26828014741.de",
  "jokeId": "ru-a26828014741",
  "locale": "de",
  "title": "Der Leichenwagen",
  "kind": "joke",
  "v": 2,
  "location": "doroga",
  "place": "car",
  "cast": [
    "muzhik-ryzhy",
    "muzhik"
  ],
  "roles": {
    "muzhik-ryzhy": "driver",
    "muzhik": "customer"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein Taxifahrgast wollte dem Fahrer eine Frage stellen und tippte ihm auf die Schulter. Der Fahrer schrie wild auf und verlor die Kontrolle über den Wagen.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Das Taxi krachte fast in einen Bus, schoss auf den Gehweg und blieb einen Zentimeter vor einem Schaufenster stehen.",
      "emotion": "surprised",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "Einen Moment lang herrschte Stille im Wagen, dann sagte der Fahrer heiser:",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "muzhik-ryzhy",
      "text": "Hör mal, Kumpel, mach das nie wieder. Ich hätte mir fast in die Hose gemacht...",
      "emotion": "angry",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l5",
      "character": "muzhik",
      "text": "Entschuldigung. Ich hätte nie gedacht, dass ein leichtes Klopfen auf die Schulter Sie so erschrecken kann.",
      "emotion": "sad",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l6",
      "character": "muzhik-ryzhy",
      "text": "Eigentlich bist du gar nicht schuld... Heute ist einfach mein erster Tag als Taxifahrer.",
      "emotion": "neutral",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l7",
      "character": "muzhik-ryzhy",
      "text": "Davor bin ich fünfundzwanzig Jahre lang einen Leichenwagen gefahren!",
      "emotion": "sad",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
  "explicit": false,
