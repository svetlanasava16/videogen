  "roles": {
    "muzhik": "customer",
    "muzhik-ryzhy": "driver"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein Fahrgast tippt dem Taxifahrer auf die Schulter, um etwas zu fragen.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "muzhik-ryzhy",
      "text": "Aaaah!",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "Das Taxi schießt auf den Gehweg und hält einen Zentimeter vor einem Schaufenster.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "muzhik-ryzhy",
      "text": "Mann, mach das nie wieder. Ich hätte mir fast in die Hose gemacht.",
      "emotion": "angry",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "muzhik",
      "text": "Entschuldigung! Ich wusste nicht, dass Sie so erschrecken.",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "muzhik-ryzhy",
      "text": "Ist nicht deine Schuld. Heute ist mein erster Tag im Taxi.",
      "emotion": "neutral",
      "pauseAfterSec": 0.7,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "muzhik-ryzhy",
      "text": "Davor bin ich fünfundzwanzig Jahre lang einen Leichenwagen gefahren.",
      "emotion": "sad",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    }
  ],
