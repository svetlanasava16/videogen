  "locale": "de",
  "title": "Die lauten Engländer",
  "location": "spalnya",
  "place": "bedroom",
  "cast": [
    "zhena",
    "paren"
  ],
  "roles": {
    "zhena": "mother",
    "paren": "student"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein junger Schotte studiert in England und teilt sich ein Zimmer mit zwei Engländern.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "zhena",
      "text": "Na, mein Junge, wie sind denn die englischen Studenten so?",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [
        "zhena"
      ],
      "exit": []
    },
    {
      "id": "l3",
      "character": "paren",
      "text": "Mama, schreckliche, laute Leute!",
      "emotion": "angry",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "paren",
      "text": "Der auf der einen Seite schlägt die ganze Nacht mit dem Kopf gegen die Wand.",
      "emotion": "angry",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "paren",
      "text": "Und der auf der anderen Seite schreit und schreit. Jede Nacht.",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "zhena",
      "text": "Ach, Junge, wie hältst du das bloß aus?",
      "emotion": "sad",
      "pauseAfterSec": 0.7,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "paren",
      "text": "Ich ignoriere sie einfach. Ich sitze die ganze Nacht hier und spiele Dudelsack.",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    }
  ],
