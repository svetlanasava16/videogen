  "locale": "de",
  "title": "Der Dudelsack",
  "kind": "joke",
  "v": 2,
  "location": "spalnya",
  "place": "bedroom",
  "cast": [
    "zhena",
    "paren"
  ],
  "roles": {
    "zhena": "mother",
    "paren": "student"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Angus MacDonald kam aus Schottland zum Studium an eine englische Universität und bekam ein Zimmer mit zwei anderen Studenten. Nach etwa einem Monat besuchte ihn seine Mutter.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "zhena",
      "text": "Na, und wie findest du diese englischen Studenten, Angus?",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "paren",
      "text": "Mama, das sind so schreckliche, laute Leute!",
      "emotion": "angry",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "paren",
      "text": "Der auf dieser Seite schlägt die ganze Nacht ohne Pause mit dem Kopf gegen die Wand, und der auf der anderen Seite schreit und schreit, und das jede Nacht.",
      "emotion": "angry",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "zhena",
      "text": "Ach, Angus, wie hältst du es nur mit diesen schrecklichen, lauten Engländern aus?",
      "emotion": "sad",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l6",
      "character": "paren",
      "text": "Mama, ich tue gar nichts. Ich ignoriere sie einfach.",
      "emotion": "smug",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l7",
      "character": "paren",
      "text": "Ich sitze hier die ganze Nacht und spiele Dudelsack.",
      "emotion": "happy",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
  "explicit": false,
