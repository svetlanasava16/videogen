  "locale": "de",
  "title": "Laute Mitbewohner",
  "location": "spalnya",
  "place": "bedroom",
  "cast": [
    "zhena",
    "paren"
  ],
  "roles": {
    "zhena": "mother",
    "paren": "student"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Angus MacDonald kam aus Schottland zum Studium an eine englische Universität, wo man ihn mit zwei anderen Studenten in ein Zimmer steckte.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Als er dort etwa einen Monat gewohnt hatte, kam seine Mutter ihn besuchen.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [
        "zhena"
      ],
      "exit": []
    },
    {
      "id": "l3",
      "character": "zhena",
      "text": "Na, wie findest du diese englischen Studenten, Angus?",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "paren",
      "text": "Mama, das sind so schreckliche, laute Leute!",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "paren",
      "text": "Der auf dieser Seite schlägt die ganze Nacht ohne Pause mit dem Kopf gegen die Wand, und der auf der anderen Seite schreit und schreit, und so jede Nacht.",
      "emotion": "angry",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "zhena",
      "text": "Ach, Angus, wie kommst du denn mit diesen schrecklichen, lauten Engländern aus?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "paren",
      "text": "Mama, ich mache gar nichts. Ich ignoriere sie einfach.",
      "emotion": "neutral",
      "pauseAfterSec": 0.7,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "paren",
      "text": "Ich sitze hier die ganze Nacht und spiele auf meinem Dudelsack.",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
  "explicit": false,
  "outroLaughs": [],
