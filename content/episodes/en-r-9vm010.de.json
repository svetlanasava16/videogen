    {
      "id": "l1",
      "character": "muzhik",
      "text": "Mein Sohn ist drei Jahre alt, und ich war mit ihm einkaufen.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "muzhik",
      "text": "Als wir nach Hause kamen, hatte er einen Schokoriegel in der Tasche.",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "muzhik",
      "text": "Also, ich habe ihn nicht gekauft, und er hat ihn ganz bestimmt nicht gekauft.",
      "emotion": "angry",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "Also bin ich mit ihm sofort zurück ins Einkaufszentrum marschiert",
      "emotion": "neutral",
      "pauseAfterSec": 0.6,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "muzhik",
      "text": "und zum Juwelier gegangen.",
      "emotion": "smug",
