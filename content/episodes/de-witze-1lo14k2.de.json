  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Springt ein Mann mit dem Fallschirm aus dem Flugzeug.",
      "emotion": "neutral",
      "pauseAfterSec": 0,
      "enter": [],
      "exit": [
        "muzhik"
      ]
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Nach einiger Zeit will er den Fallschirm öffnen, aber nichts passiert. Denkt er:",
      "emotion": "neutral",
      "pauseAfterSec": 0,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "muzhik",
      "text": "Macht nix, hab ja den Notschirm noch.",
      "emotion": "smug",
      "pauseAfterSec": 0,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "narrator",
      "text": "Er will ihn öffnen, doch nichts tut sich.",
      "emotion": "neutral",
      "pauseAfterSec": 0,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "So langsam wird er panisch,",
      "emotion": "neutral",
      "pauseAfterSec": 0,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "als ihm plötzlich von unten ein Mann mit Werkzeugkiste entgegengeflogen kommt.",
      "emotion": "neutral",
      "pauseAfterSec": 0,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "narrator",
      "text": "Da fragt er ihn:",
      "emotion": "neutral",
      "pauseAfterSec": 0,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "muzhik",
      "text": "Sie schickt der Himmel, reparieren Sie Fallschirme?",
      "emotion": "happy",
      "pauseAfterSec": 0,
      "enter": [],
      "exit": []
    },
    {
      "id": "l9",
      "character": "narrator",
      "text": "Darauf dieser:",
      "emotion": "neutral",
      "pauseAfterSec": 0,
      "enter": [],
      "exit": []
    },
    {
      "id": "l10",
      "character": "barmen",
      "text": "Nein, Gasleitungen.",
      "emotion": "neutral",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
