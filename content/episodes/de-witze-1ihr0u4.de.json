{
  "id": "de-witze-1ihr0u4.de",
  "jokeId": "de-witze-1ihr0u4",
  "locale": "de",
  "title": "Die Kontaktlinsen",
  "location": "ofis",
  "place": "office",
  "cast": [
    "paren",
    "devushka-blondinka"
  ],
  "roles": {
    "paren": "employee",
    "devushka-blondinka": "secretary"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Im Vorzimmer des Personalchefs warten mehrere Männer auf ihr Bewerbungsgespräch. Einer nach dem anderen kommt sehr schnell und käsebleich wieder raus und verlässt fluchtartig das Lokal.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "paren",
      "text": "Was geht da drinnen vor sich?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "devushka-blondinka",
      "text": "Der Chef hat keine Ohren, und er kann es auf den Tod nicht leiden, wenn man ihn darauf anspricht.",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "paren",
      "text": "Vielen Dank!",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "Der junge Mann wird reingerufen. Man unterhält sich entspannt.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "nachalnik",
      "text": "Junger Mann, schauen Sie mich mal ganz genau an! Fällt Ihnen an mir was auf?",
      "emotion": "smug",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "paren",
      "text": "Sie tragen Kontaktlinsen!",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "nachalnik",
      "text": "Donnerwetter, Sie sind ja ein guter Beobachter! Woran haben Sie das denn so schnell bemerkt?",
      "emotion": "surprised",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    },
    {
      "id": "l9",
      "character": "paren",
      "text": "Wenn Sie Ohren hätten, würden Sie 'ne Brille tragen.",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
