  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "A young man looking for a side job applies at the supermarket nearby.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "He gets the job, and on his first day the store manager tells him to sweep the entrance.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "paren",
      "text": "Sweep?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "paren",
      "text": "Excuse me, but you do know that I studied philosophy and literature!",
      "emotion": "angry",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l5",
      "character": "nachalnik",
      "text": "No. I actually didn't know that.",
      "emotion": "surprised",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l6",
      "character": "nachalnik",
      "text": "But that's no problem, I'll show you how it's done!",
      "emotion": "happy",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
