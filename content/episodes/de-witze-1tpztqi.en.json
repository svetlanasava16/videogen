{
  "id": "de-witze-1tpztqi.en",
  "jokeId": "de-witze-1tpztqi",
  "locale": "en",
  "title": "Golden Anniversary",
  "kind": "joke",
  "v": 2,
  "location": "gostinaya",
  "place": "restaurant",
  "cast": [
    "ded",
    "tyoshcha"
  ],
  "roles": {
    "ded": "husband",
    "tyoshcha": "wife"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "A married couple is celebrating their fiftieth wedding anniversary.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "They are sitting at a romantic dinner.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "ded",
      "text": "Darling, we've been together for half a century now.",
      "emotion": "happy",
      "pauseAfterSec": 0.2
    },
    {
      "id": "l4",
      "character": "ded",
      "text": "In all these years there have never been any secrets between us.",
      "emotion": "neutral",
      "pauseAfterSec": 0.2
    },
    {
      "id": "l5",
      "character": "ded",
      "text": "But there's one thing I just can't get out of my head...",
      "emotion": "sad",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l6",
      "character": "tyoshcha",
      "text": "What is it, my love?",
      "emotion": "happy",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l7",
      "character": "ded",
      "text": "Our eighth child, Michael.",
      "emotion": "neutral",
      "pauseAfterSec": 0.2
    },
    {
      "id": "l8",
      "character": "ded",
      "text": "He looks completely different from his seven older brothers and sisters.",
      "emotion": "neutral",
      "pauseAfterSec": 0.2
    },
    {
      "id": "l9",
      "character": "ded",
      "text": "He has red hair, he's two heads taller and his features are completely different.",
      "emotion": "neutral",
      "pauseAfterSec": 0.2
    },
    {
      "id": "l10",
      "character": "ded",
      "text": "Please be honest with me... does he have a different father?",
      "emotion": "sad",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l11",
      "character": "narrator",
      "text": "The wife lowers her eyes in shame and bursts into tears.",
      "emotion": "sad",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l12",
      "character": "tyoshcha",
      "text": "Yes, I'm so sorry...",
      "emotion": "sad",
      "pauseAfterSec": 0.2
    },
    {
      "id": "l13",
      "character": "tyoshcha",
      "text": "Yes, he has a different father.",
      "emotion": "sad",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l14",
      "character": "narrator",
      "text": "The husband swallows hard, close to tears, but tries to stay brave.",
      "emotion": "sad",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l15",
      "character": "ded",
      "text": "All right... after all these years, I forgive you.",
      "emotion": "sad",
      "pauseAfterSec": 0.2
    },
    {
      "id": "l16",
      "character": "ded",
      "text": "But tell me: who is it?",
      "emotion": "sad",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l17",
      "character": "tyoshcha",
      "text": "You.",
      "emotion": "sad",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
