  "lines": [
    {
      "id": "l1",
      "character": "paren",
      "text": "Ну и профессор! Чуть пиджак не порвал. А ключи-то где?",
      "emotion": "surprised",
      "pauseAfterSec": 0
    },
    {
      "id": "l2",
      "character": "vor",
      "text": "Молодой человек, ключики потеряли? Я по замкам большой специалист.",
      "emotion": "smug",
      "pauseAfterSec": 0
    },
    {
      "id": "l3",
      "character": "paren",
      "text": "Правда? Вот спасибо! Только у нас брать нечего, один кот.",
      "emotion": "happy",
      "pauseAfterSec": 0
    },
    {
      "id": "l4",
      "character": "vor",
      "text": "Тогда маску наденьте. Для порядка.",
      "emotion": "neutral",
      "pauseAfterSec": 0.8
    }
  ],
