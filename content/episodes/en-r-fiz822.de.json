  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Zwei kleine Jungen gingen in eine Apotheke, nahmen eine Packung Tampons und gingen damit zur Kasse.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "doktor",
      "text": "Mein Junge, wie alt bist du?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "vovochka-drug",
      "text": "Acht.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "doktor",
      "text": "Weißt du, wofür die sind?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "vovochka-drug",
      "text": "Nicht genau, aber die sind nicht für mich.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "vovochka-drug",
      "text": "Die sind für ihn... Er ist mein Bruder. Er ist vier.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "vovochka-drug",
      "text": "Wir haben im Fernsehen gesehen, wenn man die benutzt, kann man schwimmen und Fahrrad fahren.",
      "emotion": "happy",
      "pauseAfterSec": 0.7,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "vovochka-drug",
      "text": "Im Moment kann er beides nicht.",
      "emotion": "sad",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
