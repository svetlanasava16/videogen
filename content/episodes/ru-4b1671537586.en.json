{
  "id": "ru-4b1671537586.en",
  "jokeId": "ru-4b1671537586",
  "locale": "en",
  "title": "The Neurosurgeon",
  "kind": "joke",
  "v": 2,
  "location": "spalnya",
  "place": "bathroom",
  "cast": [
    "doktor",
    "barmen"
  ],
  "roles": {
    "doktor": "doctor",
    "barmen": "plumber"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "A doctor's toilet got clogged at home.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "They called a plumber.",
      "emotion": "neutral",
      "pauseAfterSec": 0.2
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "The plumber came, tapped something with a hammer a couple of times, replaced a gasket, tightened a nut.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "barmen",
      "text": "Done, everything works. That'll be two hundred dollars.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "doktor",
      "text": "What do you mean, two hundred dollars? For five minutes of work?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l6",
      "character": "doktor",
      "text": "I'm a neurosurgeon, I studied my specialty for twelve years,",
      "emotion": "angry",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l6b",
      "character": "doktor",
      "text": "and nobody pays me two hundred dollars for five minutes of work.",
      "emotion": "angry",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l7",
      "character": "barmen",
      "text": "Well, that's normal.",
      "emotion": "smug",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l7b",
      "character": "barmen",
      "text": "When I was a neurosurgeon, they didn't pay me that either.",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
