  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein kleiner Junge rennt durch die Wohnung.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Er wirft die Bücher vom Büfett, verstreut die Kleider, wirft die Stühle um.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "zhena",
      "text": "Was machst du da?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "vovochka",
      "text": "Ich spiele ein Spiel.",
      "emotion": "happy",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "zhena",
      "text": "Welches denn?",
      "emotion": "surprised",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l6",
      "character": "vovochka",
      "text": "Verdammter Mist, wo sind die Autoschlüssel!",
      "uncensored": "Verdammte Scheiße, wo sind die Autoschlüssel!",
      "emotion": "happy",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
