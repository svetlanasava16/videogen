{
  "id": "de-witze-1xrms30.ru",
  "jokeId": "de-witze-1xrms30",
  "locale": "ru",
  "title": "Сначала убедитесь",
  "location": "derevnya",
  "place": "forest",
  "cast": [
    "muzhik",
    "muzhik-ryzhy"
  ],
  "roles": {
    "muzhik": "hunter",
    "muzhik-ryzhy": "hunter"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Два охотника в лесу, и вдруг один из них падает.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Он не дышит, взгляд застыл.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "Второй охотник в полной панике хватает телефон и звонит в службу спасения.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "muzhik-ryzhy",
      "text": "Мой друг умер! Что же мне делать?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "paren",
      "text": "Спокойно, я вам помогу.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "paren",
      "text": "Первым делом убедитесь, что он действительно мёртв.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "narrator",
      "text": "В трубке ненадолго тишина, потом раздаётся громкий выстрел.",
      "emotion": "neutral",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "muzhik-ryzhy",
      "text": "Так, готово. Что дальше?",
      "emotion": "neutral",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
