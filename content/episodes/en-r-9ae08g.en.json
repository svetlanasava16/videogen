  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "A wife is in bed with her lover when she hears her husband coming home.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "zhena",
      "text": "Quick! Rub baby powder all over yourself and freeze. You're a statue.",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "muzhik-ryzhy",
      "text": "Honey, what's this statue doing here?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [
        "muzhik-ryzhy"
      ],
      "exit": []
    },
    {
      "id": "l4",
      "character": "zhena",
      "text": "The Smiths got one, so I wanted one too.",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "That night, once his wife is asleep, the husband brings the statue a sandwich and a glass of milk.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "muzhik-ryzhy",
      "text": "Here, eat something.",
      "emotion": "neutral",
      "pauseAfterSec": 0.6,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "muzhik-ryzhy",
      "text": "I stood like an idiot for three days at the Smiths', and nobody offered me a thing!",
      "emotion": "angry",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    }
  ],
