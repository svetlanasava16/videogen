{
  "id": "en-r-9ae08g.en",
  "jokeId": "en-r-9ae08g",
  "locale": "en",
  "title": "The Statue",
  "location": "spalnya",
  "place": "bedroom",
  "cast": [
    "zhena",
    "paren"
  ],
  "roles": {
    "zhena": "wife",
    "paren": "lover"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "A woman and her lover were in bed, when the woman heard her husband getting back.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "zhena",
      "text": "Quick! Rub baby powder on you and pretend to be a statue.",
      "emotion": "surprised",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "The lover did that.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "Honey, what's this statue doing here?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "zhena",
      "text": "I saw that the Smiths got one, so I decided to get one as well.",
      "emotion": "smug",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": [],
      "laugh": "chuckle"
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "The husband got into bed, and the woman fell asleep.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "narrator",
      "text": "A few hours later, after checking his wife was asleep, he quietly got up, walked into the kitchen, made a sandwich and got a glass of milk, came back, and went to the statue.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "muzhik",
      "text": "Here, have something to eat and drink.",
      "emotion": "neutral",
      "pauseAfterSec": 0.7,
      "enter": [],
      "exit": []
    },
    {
      "id": "l9",
      "character": "muzhik",
      "text": "I stood like an idiot for three days at the Smiths, and no one offered me anything to eat!",
      "emotion": "angry",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
