  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Drei kleine Buben streiten sich darum, wessen Vater am schnellsten ist.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "devochka",
      "text": "Mein Vater fährt einen Porsche und erreicht locker dreihundert Kilometer pro Stunde!",
      "emotion": "smug",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "vovochka-drug",
      "text": "Ist doch gar nichts.",
      "emotion": "smug",
      "pauseAfterSec": 0.2
    },
    {
      "id": "l4",
      "character": "vovochka-drug",
      "text": "Mein Vater ist Pilot bei der Lufthansa und fliegt eine Boeing, die mit mindestens siebenhundert Kilometer pro Stunde abzischt!",
      "emotion": "happy",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "vovochka",
      "text": "Das ist alles überhaupt nichts. Mein Vater ist Beamter.",
      "emotion": "smug",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l6",
      "character": "vovochka",
      "text": "Um fünf Uhr abends hat er Dienstschluss und um halb vier ist er zu Hause!",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
