  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Маленький мальчик носится по квартире.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Сбрасывает книжки с буфета, раскидывает одежду, опрокидывает стулья.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "zhena",
      "text": "Ты что делаешь?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "vovochka",
      "text": "Я играю в игру.",
      "emotion": "happy",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "zhena",
      "text": "В какую?",
      "emotion": "surprised",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l6",
      "character": "vovochka",
      "text": "Ёшкин кот, где ключи от машины!",
      "uncensored": "Ёб твою мать, где ключи от машины!",
      "emotion": "happy",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
