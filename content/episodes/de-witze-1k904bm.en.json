    {
      "id": "l1",
      "character": "narrator",
      "text": "A father picks up his son from the drama club he joined only recently.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "That day the parts for the next play were supposed to be announced.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "muzhik",
      "text": "So, son, did you land a part in the next play?",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "paren",
      "text": "Yes! I'm playing a man who's been married for twenty years.",
      "emotion": "happy",
      "pauseAfterSec": 0.6,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "muzhik",
      "text": "Well, that's a good start. Keep it up, and next time you might even get a speaking part.",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
