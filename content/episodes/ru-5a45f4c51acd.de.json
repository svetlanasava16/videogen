  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein Vater spielt zu Hause mit seinen Kumpels Poker. Im Pott liegt schon ordentlich was, und die Bietrunde läuft.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Da kommt sein vierjähriger Sohn angerannt und schaut ihm in die Karten.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [
        "vovochka"
      ],
      "exit": []
    },
    {
      "id": "l3",
      "character": "vovochka",
      "text": "Oh, Papa, sind vier Asse gut?",
      "emotion": "surprised",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "Ja! Mein Sohn...",
      "emotion": "angry",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": [],
      "laugh": "chuckle"
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "Alle steigen sofort aus, und Papa streicht den riesigen Pott ein.",
      "emotion": "neutral",
      "pauseAfterSec": 0.7,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "vovochka",
      "text": "Schade, Papa, dass du sie nicht hattest...",
      "emotion": "sad",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
