  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Der Morgen nach einer durchzechten Nacht.",
      "emotion": "neutral",
      "pauseAfterSec": 0.2,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "zhena",
      "text": "Guten Morgen, Schatz! Ich hol schnell frische Brötchen!",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [
        "muzhik"
      ],
      "exit": [
        "zhena"
      ]
    },
    {
      "id": "l3",
      "character": "muzhik",
      "text": "Was war gestern Abend los?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "devushka-ryzhaya",
      "text": "Du hast den Schlüssel nicht ins Schloss gekriegt und die Tür eingetreten.",
      "emotion": "angry",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "devushka-ryzhaya",
      "text": "Dann bist du durch den Tisch gekracht. Und in die Hose gemacht hast du auch.",
      "emotion": "angry",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "muzhik",
      "text": "Um Gottes willen! Und warum ist Mama so gut gelaunt?",
      "emotion": "surprised",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "devushka-ryzhaya",
      "text": "Sie wollte dir die Hose zum Waschen ausziehen, da hast du ihre Hand weggeschlagen und gesagt: Finger weg, ich bin verheiratet!",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    }
  ],
