  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein Mann wacht nach einer durchzechten Nacht auf, und seine Frau macht fröhlich Frühstück.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Verwirrt geht er zu seiner Tochter und bittet sie, ihm die letzte Nacht zu erklären, als er nach Hause kam.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "devushka-ryzhaya",
      "text": "Du hast die Tür eingetreten, weil du den Schlüssel nicht ins Schloss gekriegt hast, bist durch den Tisch gekracht, hast ihn zerbrochen und dir in die Hose gemacht.",
      "uncensored": "Du hast die Tür eingetreten, weil du den Schlüssel nicht ins Schloss gekriegt hast, bist durch den Tisch gekracht, hast ihn zerbrochen und dir in die Hose gepisst.",
      "emotion": "smug",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "Mein Gott! Warum zum Teufel hat sie dann so gute Laune?",
      "emotion": "surprised",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "devushka-ryzhaya",
      "text": "Als sie dir die Hose ausziehen wollte, um sie zu waschen, hast du ihre Hand weggeschlagen und gesagt:",
      "emotion": "smug",
      "pauseAfterSec": 0.6,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "devushka-ryzhaya",
      "text": "Hände weg von mir! Ich bin verheiratet!",
      "emotion": "happy",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
