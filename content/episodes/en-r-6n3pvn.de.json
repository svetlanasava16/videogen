      "id": "l1",
      "character": "muzhik",
      "text": "Gestern beim Frühstück wollte ich zu meiner Frau sagen: Reich mir mal die Milch, Schatz. Und hab mich versprochen.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "muzhik",
      "text": "Aus Versehen sagte ich:",
      "emotion": "neutral",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l3",
      "character": "muzhik",
      "text": "Leck mich, Helene, du hast mein verdammtes Leben ruiniert.",
      "uncensored": "Fick dich, Helene, du hast mein verficktes Leben ruiniert.",
      "emotion": "angry",
      "pauseAfterSec": 0.8,
