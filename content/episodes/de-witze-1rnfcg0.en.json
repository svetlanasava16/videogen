    },
    {
      "id": "l2",
      "character": "zhena",
      "text": "Tell me, how old is this mummy here?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "sluzhivy",
      "text": "Five thousand and seven years.",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "zhena",
      "text": "How can anyone know that so exactly?",
