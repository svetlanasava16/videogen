  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Auf dem Friedhof, während einer Beerdigung, sieht der Vorarbeiter der Totengräber, dass dem Toten ein Fünfzig-Euro-Schein aus der Brusttasche des Jacketts ragt.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Sofort bittet er einen aus seiner Truppe, die Leute unter irgendeinem Vorwand vom Sarg wegzudrängen.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "Als das erledigt ist und er nach dem Schein greift, packt ihn der Tote plötzlich an der Hand und schreit:",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "sluzhivy",
      "text": "Steuerfahndung! Testbeerdigung!",
      "emotion": "angry",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": [],
      "laugh": "chuckle"
    },
    {
      "id": "l5",
      "character": "barmen",
      "text": "Du hast deine Arbeit, und ich hab meine.",
      "emotion": "neutral",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "Und er schlug Nägel in den Sargdeckel.",
      "emotion": "neutral",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
