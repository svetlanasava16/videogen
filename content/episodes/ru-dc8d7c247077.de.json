{
  "id": "ru-dc8d7c247077.de",
  "jokeId": "ru-dc8d7c247077",
  "locale": "de",
  "title": "Der Angler",
  "kind": "joke",
  "v": 2,
  "location": "derevnya",
  "place": "river-lake",
  "cast": [
    "muzhik",
    "muzhik-ryzhy"
  ],
  "roles": {
    "muzhik": "everyman",
    "muzhik-ryzhy": "fisherman"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein Mann fährt mit dem Fahrrad in sein Dorf. Es ist heiß, die Straße geht bergauf, er ist fix und fertig.",
      "emotion": "neutral",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l1b",
      "character": "narrator",
      "text": "Auf der Brücke beschließt er, sich auszuruhen.",
      "emotion": "neutral",
      "pauseAfterSec": 0
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Er sieht: Auf der Brücke steht einer mit einer Angel und schaut auf den Schwimmer.",
      "emotion": "neutral",
      "pauseAfterSec": 0
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "Der Mann geht zu ihm hin und fragt:",
      "emotion": "neutral",
      "pauseAfterSec": 0
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "Na, fangen wir Fische?",
      "emotion": "happy",
      "pauseAfterSec": 0
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "Der Angler schweigt.",
      "emotion": "neutral",
      "pauseAfterSec": 0
    },
    {
      "id": "l6",
      "character": "muzhik",
      "text": "Ich sag, fangen wir Fische?",
      "emotion": "surprised",
      "pauseAfterSec": 0
    },
    {
      "id": "l7",
      "character": "narrator",
      "text": "Wieder Schweigen.",
      "emotion": "neutral",
      "pauseAfterSec": 0
    },
    {
      "id": "l8",
      "character": "muzhik",
      "text": "Was ist, bist du taub? Ich frag, fangen wir Fische?",
      "emotion": "angry",
      "pauseAfterSec": 0
    },
    {
      "id": "l9",
      "character": "narrator",
      "text": "Der schaut immer nur auf den Schwimmer.",
      "emotion": "neutral",
      "pauseAfterSec": 0
    },
    {
      "id": "l10",
      "character": "narrator",
      "text": "Der Mann spuckt aus, setzt sich aufs Rad und strampelt schweißgebadet weiter bergauf.",
      "emotion": "neutral",
      "pauseAfterSec": 0
    },
    {
      "id": "l11",
      "character": "narrator",
      "text": "Er ist schon gut drei Kilometer weg, dreht sich um und sieht: Der Angler winkt ihm mit aller Kraft, er soll schnell zurückkommen.",
      "emotion": "surprised",
      "pauseAfterSec": 0
    },
    {
      "id": "l12",
      "character": "narrator",
      "text": "Also dreht er um und rollt wieder runter. Der Angler zu ihm:",
      "emotion": "neutral",
      "pauseAfterSec": 0
    },
    {
      "id": "l13",
      "character": "muzhik-ryzhy",
      "text": "Na, fahren wir Fahrrad?",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
