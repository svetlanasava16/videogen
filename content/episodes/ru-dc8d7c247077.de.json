{
  "id": "ru-dc8d7c247077.de",
  "jokeId": "ru-dc8d7c247077",
  "locale": "de",
  "title": "Na, angeln wir?",
  "location": "derevnya",
  "place": "river-lake",
  "cast": [
    "muzhik",
    "muzhik-ryzhy"
  ],
  "roles": {
    "muzhik": "everyman",
    "muzhik-ryzhy": "fisherman"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein Mann fährt mit dem Fahrrad in sein Dorf. Hitze, es geht bergauf, er ist fix und fertig. Auf der Brücke beschließt er, sich auszuruhen.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Da sieht er: Auf der Brücke steht einer mit einer Angel und schaut auf seinen Schwimmer.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "muzhik",
      "text": "Na, angeln wir ein bisschen?",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [
        "muzhik"
      ],
      "exit": []
    },
    {
      "id": "l4",
      "character": "narrator",
      "text": "Der Angler schweigt.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "muzhik",
      "text": "Ich sag, angeln wir ein bisschen?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "Wieder Schweigen.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "muzhik",
      "text": "Was ist, bist du taub? Ich frage, angeln wir ein bisschen?",
      "emotion": "angry",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "narrator",
      "text": "Der schaut nur weiter auf den Schwimmer. Der Mann spuckt aus, steigt aufs Rad und strampelt schweißgebadet weiter bergauf.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": [
        "muzhik"
      ]
    },
    {
      "id": "l9",
      "character": "narrator",
      "text": "Nach etwa drei Kilometern dreht er sich um und sieht: Der Angler winkt ihm wie wild, er soll schnell zurückkommen.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l10",
      "character": "narrator",
      "text": "Also dreht er um und rollt wieder hinunter.",
      "emotion": "neutral",
      "pauseAfterSec": 0.7,
      "enter": [
        "muzhik"
      ],
      "exit": []
    },
    {
      "id": "l11",
      "character": "muzhik-ryzhy",
      "text": "Na, fahren wir ein bisschen Fahrrad?",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
