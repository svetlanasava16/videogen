{
  "id": "ru-dc8d7c247077.de",
  "jokeId": "ru-dc8d7c247077",
  "locale": "de",
  "title": "Na, angeln wir?",
  "location": "derevnya",
  "place": "river-lake",
  "cast": [
    "muzhik",
    "muzhik-ryzhy"
  ],
  "roles": {
    "muzhik": "everyman",
    "muzhik-ryzhy": "fisherman"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein Mann fährt mit dem Fahrrad in sein Dorf. Hitze, es geht bergauf, er ist völlig fertig. Auf der Brücke will er sich ausruhen.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "muzhik",
      "text": "Na, angeln wir?",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "muzhik",
      "text": "Ich sag, angeln wir?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "Was ist, bist du taub? Ich frage: angeln wir?",
      "emotion": "angry",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "Der Mann spuckt aus, steigt wieder aufs Rad und strampelt schweißgebadet weiter bergauf.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "Nach gut drei Kilometern dreht er sich um und sieht: Der Angler winkt ihm wie wild, komm schnell zurück!",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "narrator",
      "text": "Also wendet er und rollt wieder hinunter.",
      "emotion": "neutral",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "muzhik-ryzhy",
      "text": "Na, fahren wir Fahrrad?",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
