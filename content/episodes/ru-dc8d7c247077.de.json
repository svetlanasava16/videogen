    {
      "id": "l1",
      "character": "narrator",
      "text": "Hitze, es geht bergauf. Ein völlig erschöpfter Radfahrer hält auf einer Brücke neben einem Angler.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "muzhik",
      "text": "Na, wir angeln, ja?",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [
        "muzhik"
      ],
      "exit": []
    },
    {
      "id": "l3",
      "character": "muzhik",
      "text": "Ich sage, wir angeln, ja?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "Bist du taub? Ich frage, ob wir angeln!",
      "emotion": "angry",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": [
        "muzhik"
      ]
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "Er spuckt aus und strampelt schweißgebadet weiter bergauf. Drei Kilometer später dreht er sich um: Der Angler winkt wie wild, er soll zurückkommen.",
      "emotion": "neutral",
      "pauseAfterSec": 0.7,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "muzhik-ryzhy",
      "text": "Na, wir fahren Fahrrad, ja?",
