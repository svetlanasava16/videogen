  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Two math professors meet.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "ded",
      "text": "Colleague, I've been robbed again!",
      "emotion": "sad",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "doktor",
      "text": "Imagine, colleague, I've solved that problem once and for all!",
      "emotion": "smug",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "ded",
      "text": "Hmm... I'd be curious to know how.",
      "emotion": "surprised",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "doktor",
      "text": "I used probability theory and put the six cheapest Chinese locks on my door!",
      "emotion": "smug",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l6",
      "character": "ded",
      "text": "And what does probability theory have to do with it, if one key opens them all?!",
      "emotion": "angry",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l7",
      "character": "doktor",
      "text": "Oh, but it does, colleague! When I leave the house, I lock three of them, and three I don't!",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
