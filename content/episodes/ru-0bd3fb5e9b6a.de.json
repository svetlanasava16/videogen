  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein Student holt den Hausmeister vom Wohnheim in sein Zimmer.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [
        "paren",
        "barmen"
      ],
      "exit": []
    },
    {
      "id": "l2",
      "character": "paren",
      "text": "Hier kann man nicht wohnen. Ein Albtraum! Überall Mäuse!",
      "emotion": "angry",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "barmen",
      "text": "Ach was, kann nicht sein.",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "paren",
      "text": "Passen Sie auf. Ich streue ein paar Krümel.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "barmen",
      "text": "Eine Maus... zwei... drei...",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "barmen",
      "text": "Moment. War das gerade ein kleiner Fisch?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "barmen",
      "text": "Und noch eine Maus. Gut, ein paar Mäuse habt ihr. Aber was war das mit dem Fisch?",
      "emotion": "neutral",
      "pauseAfterSec": 0.7,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "paren",
      "text": "So, das mit den Mäusen ist geklärt? Dann reden wir jetzt über die Feuchtigkeit!",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    }
  ],
