{
  "id": "ru-0bd3fb5e9b6a.de",
  "jokeId": "ru-0bd3fb5e9b6a",
  "locale": "de",
  "title": "Mäuse im Wohnheim",
  "location": "ofis",
  "place": "bedroom",
  "cast": [
    "paren",
    "uchilka"
  ],
  "roles": {
    "paren": "student",
    "uchilka": "clerk"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein Student geht zur Heimleiterin seines Wohnheims.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "paren",
      "text": "In unserem Zimmer kann man einfach nicht wohnen. Ein Albtraum!",
      "emotion": "angry",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "uchilka",
      "text": "Was ist denn los?",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "paren",
      "text": "Na, zum Beispiel jede Menge Mäuse!",
      "emotion": "angry",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "uchilka",
      "text": "Das kann nicht sein!",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "paren",
      "text": "Kommen Sie, ich zeig's Ihnen.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "narrator",
      "text": "Sie gehen ins Zimmer. Der Student nimmt Brotkrümel und wirft sie auf den Boden.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "narrator",
      "text": "Eine Maus taucht auf, dann eine zweite, eine dritte, dann ein kleiner Fisch, dann eine vierte Maus.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l9",
      "character": "uchilka",
      "text": "Ja, ein paar Mäuschen haben sich eingenistet.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l10",
      "character": "uchilka",
      "text": "Und was war das für ein Fischlein?",
      "emotion": "surprised",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l11",
      "character": "paren",
      "text": "So, von den Mäusen haben Sie sich überzeugt?",
      "emotion": "smug",
      "pauseAfterSec": 0.6,
      "enter": [],
      "exit": []
    },
    {
      "id": "l12",
      "character": "paren",
      "text": "Jetzt kümmern wir uns um die Feuchtigkeit!",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
