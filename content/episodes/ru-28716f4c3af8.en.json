  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "A rude young man walks into a church and slaps the priest across the face.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "muzhik",
      "text": "Well, Father?",
      "emotion": "smug",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l2b",
      "character": "muzhik",
      "text": "Doesn't it say, if someone strikes your right cheek, turn the other one too?",
      "emotion": "smug",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "The priest, a former boxing champion, sends him into the corner with a left hook.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "batyushka",
      "text": "It also says, with the measure you use, it will be measured to you.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "The frightened parishioners ask the deacon what is going on.",
      "emotion": "neutral",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l6",
      "character": "batyushka-molodoy",
      "text": "We're interpreting the Gospel.",
      "emotion": "smug",
      "pauseAfterSec": 0.8
    }
  ],
