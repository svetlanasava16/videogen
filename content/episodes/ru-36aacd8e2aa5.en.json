  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "A few rich guys in a sauna. A phone rings.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "nachalnik",
      "text": "Hello? Yes, honey. Yes, at the sauna. Yes, with the guys. Yes. Till eleven.",
      "emotion": "neutral",
      "pauseAfterSec": 0.2,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "nachalnik",
      "text": "What to buy? A dress? A thousand dollars?",
      "emotion": "surprised",
      "pauseAfterSec": 0.2,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "nachalnik",
      "text": "Why do you need a fiftieth dress? To go to the theatre? Well, all right.",
      "emotion": "neutral",
      "pauseAfterSec": 0.2,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "nachalnik",
      "text": "You know where the money is? Buy it.",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "Another call.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "nachalnik",
      "text": "Hello? Yes, honey. Yes, at the sauna. Yes, with the guys. Yes. Till eleven.",
      "emotion": "neutral",
      "pauseAfterSec": 0.2,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "nachalnik",
      "text": "What to buy? A fur coat? Why do you need a tenth fur coat?",
      "emotion": "surprised",
      "pauseAfterSec": 0.2,
      "enter": [],
      "exit": []
    },
    {
      "id": "l9",
      "character": "nachalnik",
      "text": "A trip to the Canaries? Fifty thousand? Well, all right. You know where the money is.",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l10",
      "character": "narrator",
      "text": "Another call.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l11",
      "character": "nachalnik",
      "text": "Hello? Yes, honey. Yes, at the sauna. Yes, with the guys. Yes. Till eleven.",
      "emotion": "neutral",
      "pauseAfterSec": 0.2,
      "enter": [],
      "exit": []
    },
    {
      "id": "l12",
      "character": "nachalnik",
      "text": "What to buy? A car? Why do you need a sixth car?",
      "emotion": "surprised",
      "pauseAfterSec": 0.2,
      "enter": [],
      "exit": []
    },
    {
      "id": "l13",
      "character": "nachalnik",
      "text": "To show off in front of your mom? How much? Three hundred thousand bucks?",
      "emotion": "surprised",
      "pauseAfterSec": 0.2,
      "enter": [],
      "exit": []
    },
    {
      "id": "l14",
      "character": "nachalnik",
      "text": "Well, all right. Go ahead. You know where the money is.",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l15",
      "character": "narrator",
      "text": "He hangs up.",
      "emotion": "neutral",
      "pauseAfterSec": 0.7,
      "enter": [],
      "exit": []
    },
    {
      "id": "l16",
      "character": "nachalnik",
