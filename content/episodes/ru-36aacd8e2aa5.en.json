  ],
  "roles": {
    "muzhik": "new-russian",
    "nachalnik": "new-russian",
    "muzhik-sosed": "new-russian"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "A few rich guys are sitting in a sauna.",
      "emotion": "neutral",
      "pauseAfterSec": 0
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "A cell phone rings.",
      "emotion": "neutral",
      "pauseAfterSec": 0
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "One of them picks it up:",
      "emotion": "neutral",
      "pauseAfterSec": 0
    },
    {
      "id": "l4",
      "character": "nachalnik",
      "text": "Hello... yes, darling... yes, in the sauna... yes, with the guys... yes. Till eleven.",
      "emotion": "neutral",
      "pauseAfterSec": 0
    },
    {
      "id": "l5",
      "character": "nachalnik",
      "text": "Buy what? A dress?? A thousand dollars? What do you need a fiftieth dress for?",
      "emotion": "surprised",
      "pauseAfterSec": 0
    },
    {
      "id": "l6",
      "character": "nachalnik",
      "text": "To go to the theatre? Well, all right. You know where the money is? Buy it.",
      "emotion": "smug",
      "pauseAfterSec": 0
    },
    {
      "id": "l7",
      "character": "narrator",
      "text": "Another call, the same rich guy picks it up:",
      "emotion": "neutral",
      "pauseAfterSec": 0
    },
    {
      "id": "l8",
      "character": "nachalnik",
      "text": "Hello... yes, darling... yes, in the sauna... yes, with the guys... yes. Till eleven.",
      "emotion": "neutral",
      "pauseAfterSec": 0
    },
    {
      "id": "l9",
      "character": "nachalnik",
      "text": "Buy what? A fur coat?? What do you need a tenth fur coat for??",
      "emotion": "surprised",
      "pauseAfterSec": 0
    },
    {
      "id": "l10",
      "character": "nachalnik",
      "text": "A trip to the Canaries? Fifty thousand?? Well, all right... you know where the money is...",
      "emotion": "smug",
      "pauseAfterSec": 0
    },
    {
      "id": "l11",
      "character": "narrator",
      "text": "Another call, the same rich guy again:",
      "emotion": "neutral",
      "pauseAfterSec": 0
    },
    {
      "id": "l12",
      "character": "nachalnik",
      "text": "Hello... yes, darling... yes, in the sauna... yes, with the guys... yes. Till eleven.",
      "emotion": "neutral",
      "pauseAfterSec": 0
    },
    {
      "id": "l13",
      "character": "nachalnik",
      "text": "Buy what? A car??? What do you need a sixth car for???",
      "emotion": "angry",
      "pauseAfterSec": 0
    },
    {
      "id": "l14",
      "character": "nachalnik",
      "text": "To show off in front of your mom? How much??? Three hundred thousand bucks??? Well, all right... buy it... you know where the money is...",
      "emotion": "smug",
      "pauseAfterSec": 0
    },
    {
      "id": "l15",
      "character": "narrator",
      "text": "He hangs up...",
      "emotion": "neutral",
      "pauseAfterSec": 0
    },
    {
      "id": "l16",
      "character": "nachalnik",
      "text": "Hmm... ahem... guys, whose phone is this?",
      "emotion": "surprised",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
