  "lines": [
    {
      "id": "l1",
      "character": "barmen",
      "text": "Sehen Sie den Jungen? Das dümmste Kind der Stadt. Ich zeig's Ihnen.",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [
        "vovochka"
      ],
      "exit": []
    },
    {
      "id": "l2",
      "character": "barmen",
      "text": "Na, Fritzchen, hier ein Fünf-Euro-Schein, da zwei Euromünzen. Such dir was aus.",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "vovochka",
      "text": "Die zwei Münzen, bitte.",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": [
        "vovochka"
      ]
    },
    {
      "id": "l4",
      "character": "barmen",
      "text": "Was hab ich gesagt? Jedes Mal, wirklich jedes Mal! Der lernt es nie.",
      "emotion": "smug",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "Später sieht der Kunde Fritzchen draußen mit einem Eis.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [
        "vovochka"
      ],
      "exit": []
    },
    {
      "id": "l6",
      "character": "muzhik",
      "text": "Sag mal, Kleiner, warum nimmst du nie den Schein?",
      "emotion": "surprised",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "vovochka",
      "text": "An dem Tag, an dem ich den Schein nehme, ist das Spiel vorbei.",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    }
  ],
