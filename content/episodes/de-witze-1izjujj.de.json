{
  "id": "de-witze-1izjujj.de",
  "jokeId": "de-witze-1izjujj",
  "locale": "de",
  "title": "Das dümmste Kind der Stadt",
  "kind": "joke",
  "v": 2,
  "location": "magazin",
  "place": "barbershop",
  "cast": [
    "vovochka",
    "barmen",
    "muzhik"
  ],
  "roles": {
    "vovochka": "fritzchen",
    "muzhik": "customer",
    "barmen": "craftsman"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Fritzchen geht in einen Friseursalon.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "barmen",
      "text": "Das ist das dümmste Kind der Stadt! Moment, ich zeige es Ihnen.",
      "emotion": "smug",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "Er nimmt einen Fünf-Euro-Schein in eine Hand und zwei Eurostücke in die andere.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "barmen",
      "text": "Na, Junge, such dir eine Hand aus. Welche willst du?",
      "emotion": "happy",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "Fritzchen nimmt die zwei Münzen und geht.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l6",
      "character": "barmen",
      "text": "Na, was habe ich Ihnen gesagt? Jedesmal, wirklich jedesmal!",
      "emotion": "smug",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l7",
      "character": "barmen",
      "text": "Der Bengel lernt es nie und nimmer!",
      "emotion": "happy",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l8",
      "character": "narrator",
      "text": "Etwas später verlässt der Kunde den Salon und geht auf die Straße. Dort sieht er Fritzchen an der Eisdiele sitzen.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l9",
      "character": "muzhik",
      "text": "He, Kleiner, ich habe mal eine Frage.",
      "emotion": "surprised",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l9b",
      "character": "muzhik",
      "text": "Warum nimmst du lieber die zwei Euro und nicht den Fünf-Euro-Schein?",
      "emotion": "surprised",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l10",
      "character": "vovochka",
      "text": "An dem Tag, an dem ich den Schein nehme, ist das Spiel vorbei.",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
