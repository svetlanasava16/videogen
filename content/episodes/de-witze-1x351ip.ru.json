  "locale": "ru",
  "title": "Сосед по номеру",
  "kind": "joke",
  "v": 2,
  "location": "bar",
  "place": "hotel",
  "cast": [
    "nachalnik",
    "uchilka",
    "muzhik-sosed"
  ],
  "roles": {
    "nachalnik": "businessman",
    "muzhik-sosed": "neighbor",
    "uchilka": "clerk"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Бизнесмен забронировал номер в гостинице.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "uchilka",
      "text": "Мужчина в соседнем номере очень нервный и с трудом засыпает.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "После долгого рабочего дня бизнесмен очень устал.",
      "emotion": "sad",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "narrator",
      "text": "Войдя в номер и сев на кровать, он довольно громко снял один ботинок и уронил его на пол.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "В этот момент он вспомнил, что говорила администратор, и поставил второй ботинок совсем тихо.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "Потом он надел пижаму и лёг спать.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l7",
      "character": "narrator",
      "text": "Через два часа его разбудил громкий стук в дверь.",
      "emotion": "surprised",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l8",
      "character": "nachalnik",
      "text": "Что случилось?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l9",
      "character": "muzhik-sosed",
      "text": "Я мужчина из соседнего номера.",
      "emotion": "angry",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l10",
      "character": "muzhik-sosed",
      "text": "Не могли бы вы теперь наконец снять и второй ботинок?",
      "emotion": "angry",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
  "explicit": false,
