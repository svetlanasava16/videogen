  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Zwei Blondinen gehen im Wald spazieren und kommen an eine Lichtung.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Auf der Lichtung sitzen zwei weitere Blondinen in einem Ruderboot auf dem Trockenen und paddeln wie wild in der Luft herum.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "devushka-blondinka",
      "text": "Boah, schau dir die zwei Doofen an, das sind genau die, die unseren Ruf versauen.",
      "emotion": "angry",
      "pauseAfterSec": 0.6,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "devushka",
      "text": "Stimmt, ich schwimm direkt rüber und hau denen eine rein.",
      "emotion": "angry",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
