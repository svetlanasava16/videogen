    {
      "id": "l1",
      "character": "narrator",
      "text": "Zwei Männer trinken in einer Kneipe.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Sie packen die Butterbrote aus, die ihre Frauen liebevoll für sie geschmiert haben, und fangen an zu essen.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "barmen",
      "text": "Sie dürfen hier nicht Ihr eigenes Essen essen.",
      "emotion": "angry",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "narrator",
      "text": "Also tauschten sie ihre Butterbrote.",
