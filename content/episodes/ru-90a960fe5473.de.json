{
  "id": "ru-90a960fe5473.de",
  "jokeId": "ru-90a960fe5473",
  "locale": "de",
  "title": "Das Schälchen",
  "location": "magazin",
  "place": "shop",
  "cast": [
    "kot",
    "muzhik",
    "barmen"
  ],
  "roles": {
    "kot": "cat",
    "muzhik": "customer",
    "barmen": "salesman"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein Mann betritt einen Antiquitätenladen, schaut lustlos auf die Theke und will schon wieder gehen.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Plötzlich sieht er: Am Eingang trinkt ein Kätzchen Milch, und das Schälchen, heiliger Strohsack, ist Tutanchamun! Altes Ägypten, vierzehntes Jahrhundert vor Christus!",
      "emotion": "surprised",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "muzhik",
      "text": "Entschuldigen Sie, ich bin ein einsamer Mensch, ich habe keine Freunde...",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "Ihr Kätzchen hat es mir so angetan... Könnten Sie es mir überlassen?",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "barmen",
      "text": "Nein, nein. Meine Kinder lieben es so sehr.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "muzhik",
      "text": "Na ja, ich bin so einsam... Ich gebe Ihnen zehn Euro...",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "barmen",
      "text": "Nein, nein, es ist unverkäuflich.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "narrator",
      "text": "Schließlich einigen sie sich auf hundertfünfzig Euro.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l9",
      "character": "muzhik",
      "text": "Ihr Kätzchen ist bestimmt gewohnt, aus diesem Schälchen zu trinken, würden Sie es mir mitgeben?",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l10",
      "character": "barmen",
      "text": "Nein, nein.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l11",
      "character": "muzhik",
      "text": "Ich gebe Ihnen zehn Euro dafür...",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l12",
      "character": "barmen",
      "text": "Aber ich bitte Sie, das ist Tutanchamun, vierzehntes Jahrhundert vor Christus...",
      "emotion": "surprised",
      "pauseAfterSec": 0.7,
      "enter": [],
      "exit": []
    },
    {
      "id": "l13",
      "character": "barmen",
      "text": "So habe ich schon siebenundachtzig Kätzchen verkauft...",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
