{
  "id": "de-witze-1qq89sg.en",
  "jokeId": "de-witze-1qq89sg",
  "locale": "en",
  "title": "The Salt Shop",
  "kind": "joke",
  "v": 2,
  "location": "magazin",
  "place": "shop",
  "cast": [
    "muzhik",
    "barmen"
  ],
  "roles": {
    "muzhik": "customer",
    "barmen": "salesman"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "A guy is passing through and stops at a grocery store to buy a little something to eat.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "He walks in, and everything is full of salt. All the shelves, top to bottom, the counter, even the floor: the whole shop is crammed with these little packets of salt. Nothing else, just salt.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l3",
      "character": "muzhik",
      "text": "Wow! You must have a huge demand for table salt around here.",
      "emotion": "surprised",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "barmen",
      "text": "Not really. Rather little. Actually, none at all.",
      "emotion": "sad",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "muzhik",
      "text": "Oh, I see. Then you must be a real sales genius if you always manage to sell all of it.",
      "emotion": "happy",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l6",
      "character": "barmen",
      "text": "Zero. Selling isn't exactly my talent.",
      "emotion": "sad",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l7",
      "character": "muzhik",
      "text": "But then why on earth is your whole shop full of salt?!",
      "emotion": "angry",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l8",
      "character": "barmen",
      "text": "Well, the man I buy the salt from, now he's a really good salesman.",
      "emotion": "neutral",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
