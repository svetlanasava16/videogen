  "title": "The Salt Shop",
  "location": "magazin",
  "place": "shop",
  "cast": [
    "muzhik",
    "barmen"
  ],
  "roles": {
    "muzhik": "customer",
    "barmen": "salesman"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "A man passing through stops at a little country store.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "muzhik",
      "text": "Whoa. Everything in here is salt! The shelves, the counter, even the floor!",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [
        "muzhik"
      ],
      "exit": []
    },
    {
      "id": "l3",
      "character": "muzhik",
      "text": "There must be a huge demand for salt around here.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "barmen",
      "text": "Not really. Actually, none at all.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "muzhik",
      "text": "Then you must be a sales genius to move all this.",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "barmen",
      "text": "Nope. Selling isn't really my thing.",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "muzhik",
      "text": "Then why on earth is your whole store full of salt?",
      "emotion": "angry",
      "pauseAfterSec": 0.7,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "barmen",
      "text": "Well, the guy who sells me the salt, now he's a really good salesman.",
      "emotion": "sad",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    }
  ],
