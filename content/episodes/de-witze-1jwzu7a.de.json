  "locale": "de",
  "title": "Trauerfall auf dem Bauernhof",
  "kind": "joke",
  "v": 2,
  "location": "ofis",
  "place": "police-station",
  "cast": [
    "sluzhivy",
    "muzhik-ryzhy"
  ],
  "roles": {
    "sluzhivy": "police-officer",
    "muzhik-ryzhy": "farmer"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Bauer Erwin erscheint mit Tränen in den Augen auf der örtlichen Polizeiwache.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "muzhik-ryzhy",
      "text": "Ich habe meinen Esel heute Morgen tot im Stall aufgefunden.",
      "emotion": "sad",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "sluzhivy",
      "text": "Gibt es denn Anzeichen für ein Verbrechen?",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "muzhik-ryzhy",
      "text": "Nein, der Esel war schon alt und krank.",
      "emotion": "sad",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "muzhik-ryzhy",
      "text": "Nach einigem Leiden hat er es nun endlich geschafft.",
      "emotion": "sad",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l6",
      "character": "sluzhivy",
      "text": "Und warum haben Sie dann jetzt die Polizei aufgesucht?",
      "emotion": "surprised",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l7",
      "character": "muzhik-ryzhy",
      "text": "Na, ich wollte nur die nächsten Angehörigen informieren.",
      "emotion": "neutral",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
