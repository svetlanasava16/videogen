    {
      "id": "l1",
      "character": "narrator",
      "text": "Bauer Rudi kommt mit Tränen in den Augen auf die Polizeiwache.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [
        "muzhik-ryzhy"
      ],
      "exit": []
    },
    {
      "id": "l2",
      "character": "muzhik-ryzhy",
      "text": "Herr Wachtmeister, mein Esel lag heute Morgen tot im Stall.",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "sluzhivy",
      "text": "Gibt es Anzeichen für ein Verbrechen?",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "muzhik-ryzhy",
      "text": "Nein, nein. Er war alt und krank. Jetzt hat er es endlich geschafft.",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "sluzhivy",
      "text": "Und warum kommen Sie dann zur Polizei?",
      "emotion": "surprised",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "muzhik-ryzhy",
      "text": "Na, ich wollte nur die nächsten Angehörigen informieren.",
      "emotion": "neutral",
