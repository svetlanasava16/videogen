{
  "id": "ru-b0ecacc4cdf7.de",
  "jokeId": "ru-b0ecacc4cdf7",
  "locale": "de",
  "title": "Flugangst",
  "kind": "joke",
  "v": 2,
  "location": "samolet",
  "place": "plane",
  "cast": [
    "devushka-blondinka",
    "muzhik"
  ],
  "roles": {
    "devushka-blondinka": "flight-attendant",
    "muzhik": "customer"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Als die Stewardess durch die Kabine ging, bemerkte sie einen schweißgebadeten Mann, der zitterte und an den Nägeln kaute.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "devushka-blondinka",
      "text": "Vielleicht bringe ich Ihnen ein Gläschen Cognac, dann geht es Ihnen besser?",
      "emotion": "happy",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "Nach einem sichtbaren Kampf mit sich selbst flüsterte der Mann:",
      "emotion": "neutral",
      "pauseAfterSec": 0.2
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "Na gut...",
      "emotion": "sad",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "Als die Stewardess wieder nach demselben Passagier sah, fand sie ihn in einem noch jämmerlicheren Zustand.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l6",
      "character": "devushka-blondinka",
      "text": "Ein zweites Gläschen?",
      "emotion": "happy",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l7",
      "character": "narrator",
      "text": "Der Mann sagte nichts und nickte nur.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l8",
      "character": "narrator",
      "text": "Als die Stewardess zum dritten Mal zu dem Passagier kam, schluchzte er hemmungslos.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l9",
      "character": "devushka-blondinka",
      "text": "Ich habe noch nie jemanden gesehen, der solche Angst vorm Fliegen hat.",
      "emotion": "surprised",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l10",
      "character": "muzhik",
      "text": "Ich habe überhaupt keine Angst vorm Fliegen,",
      "emotion": "sad",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l10b",
      "character": "muzhik",
      "text": "ich versuche, mit dem Trinken aufzuhören!",
      "emotion": "sad",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
