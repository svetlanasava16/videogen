{
  "id": "ru-e83b816c03db.ru",
  "jokeId": "ru-e83b816c03db",
  "locale": "ru",
  "title": "Сдача",
  "location": "bar",
  "place": "bar",
  "cast": [
    "barmen",
    "muzhik"
  ],
  "roles": {
    "barmen": "bartender",
    "muzhik": "customer"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Мужик заходит в бар, заказывает виски:",
      "emotion": "neutral",
      "pauseAfterSec": 0,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "muzhik",
      "text": "Сколько с меня?",
      "emotion": "neutral",
      "pauseAfterSec": 0,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "barmen",
      "text": "Три доллара.",
      "emotion": "neutral",
      "pauseAfterSec": 0,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "narrator",
      "text": "Мужик вынимает из кармана три доллара.",
      "emotion": "neutral",
      "pauseAfterSec": 0,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "Один кладёт на стойку перед собой,",
      "emotion": "neutral",
      "pauseAfterSec": 0,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "потом идёт в левый конец стойки, там кладёт второй,",
      "emotion": "neutral",
      "pauseAfterSec": 0,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "narrator",
      "text": "потом идёт в правый конец стойки, там кладёт третий.",
      "emotion": "neutral",
      "pauseAfterSec": 0,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "narrator",
      "text": "Бармен, тихо матерясь, идёт направо-налево и забирает деньги.",
      "emotion": "neutral",
      "pauseAfterSec": 0,
      "enter": [],
      "exit": []
    },
    {
      "id": "l9",
      "character": "narrator",
      "text": "На следующий день опять тот же мужик приходит,",
      "emotion": "neutral",
      "pauseAfterSec": 0,
      "enter": [],
      "exit": []
    },
    {
      "id": "l10",
      "character": "narrator",
      "text": "опять стаканчик виски заказывает и снова раскладывает доллары в разные концы стойки.",
      "emotion": "neutral",
      "pauseAfterSec": 0,
      "enter": [],
      "exit": []
    },
    {
      "id": "l11",
      "character": "narrator",
      "text": "Бармен злится, но за деньгами ходит.",
      "emotion": "neutral",
      "pauseAfterSec": 0,
      "enter": [],
      "exit": []
    },
    {
      "id": "l12",
      "character": "narrator",
      "text": "Короче, такая картина повторяется день за днём.",
      "emotion": "neutral",
      "pauseAfterSec": 0,
      "enter": [],
      "exit": []
    },
    {
      "id": "l13",
      "character": "narrator",
      "text": "И вот однажды мужик заказывает виски, берёт стакан,",
      "emotion": "neutral",
      "pauseAfterSec": 0,
      "enter": [],
      "exit": []
    },
    {
      "id": "l14",
      "character": "narrator",
      "text": "роется в кармане и вытаскивает бумажку в пять долларов.",
      "emotion": "neutral",
      "pauseAfterSec": 0,
      "enter": [],
      "exit": []
    },
    {
      "id": "l15",
      "character": "narrator",
      "text": "Бармен быстро эту бумажку берёт, мстительно улыбается,",
      "emotion": "neutral",
      "pauseAfterSec": 0,
      "enter": [],
      "exit": []
    },
    {
      "id": "l16",
      "character": "narrator",
      "text": "достаёт два доллара сдачи,",
      "emotion": "neutral",
      "pauseAfterSec": 0,
      "enter": [],
      "exit": []
    },
    {
      "id": "l17",
      "character": "narrator",
      "text": "идёт в левый конец стойки, там кладёт один доллар,",
      "emotion": "neutral",
      "pauseAfterSec": 0,
      "enter": [],
      "exit": []
    },
    {
      "id": "l18",
      "character": "narrator",
      "text": "потом идёт в правый конец и там кладёт второй.",
      "emotion": "neutral",
      "pauseAfterSec": 0,
      "enter": [],
      "exit": []
    },
    {
      "id": "l19",
      "character": "narrator",
      "text": "Затем возвращается и злорадно смотрит на мужика.",
      "emotion": "neutral",
      "pauseAfterSec": 0,
      "enter": [],
      "exit": []
    },
    {
      "id": "l20",
      "character": "narrator",
      "text": "Мужик флегматично выпивает виски,",
      "emotion": "neutral",
      "pauseAfterSec": 0,
      "enter": [],
      "exit": []
    },
    {
      "id": "l21",
      "character": "narrator",
      "text": "вытаскивает из кармана доллар, кладёт его перед собой и говорит:",
      "emotion": "neutral",
      "pauseAfterSec": 0,
      "enter": [],
      "exit": []
    },
    {
      "id": "l22",
      "character": "muzhik",
      "text": "Пожалуй, возьму ещё стаканчик.",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
