  "lines": [
    {
      "id": "l1",
      "character": "paren",
      "text": "When I turned sixteen, my dad told me it was time to get a job.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "muzhik",
      "text": "When I was your age, my very first job I had, I worked with over five hundred people under me.",
      "emotion": "smug",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l3",
      "character": "paren",
      "text": "Wow! Was it some big corporation?",
      "emotion": "surprised",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "No. I mowed the lawn in the cemetery.",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
