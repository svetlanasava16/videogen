  "locale": "en",
  "title": "The AC",
  "kind": "joke",
  "v": 2,
  "location": "bar",
  "place": "restaurant",
  "cast": [
    "nachalnik",
    "barmen",
    "muzhik"
  ],
  "roles": {
    "nachalnik": "businessman",
    "barmen": "waiter",
    "muzhik": "customer"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "A rich big shot is sitting in a restaurant and calls the waiter over.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "nachalnik",
      "text": "Hey, my man, turn the AC down, it's kinda chilly in here, for real!",
      "emotion": "angry",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "Five minutes later.",
      "emotion": "neutral",
      "pauseAfterSec": 0.2
    },
    {
      "id": "l4",
      "character": "nachalnik",
      "text": "Yo, garçon!",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "nachalnik",
      "text": "Turn the AC up, bro, it's getting kinda hot...",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "Five minutes later.",
      "emotion": "neutral",
      "pauseAfterSec": 0.2
    },
    {
      "id": "l7",
      "character": "nachalnik",
      "text": "Hey, dude...",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l8",
      "character": "nachalnik",
      "text": "...turn the AC down, it's cold again.",
      "emotion": "angry",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l9",
      "character": "narrator",
      "text": "A modest man at the next table calls the waiter over and asks:",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l10",
      "character": "muzhik",
      "text": "How do you put up with him?",
      "emotion": "surprised",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l11",
      "character": "barmen",
      "text": "No problem at all! We don't even have an air conditioner!",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
