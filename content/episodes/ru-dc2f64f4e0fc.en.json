  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "A rich big shot is sitting in a restaurant and calls the waiter over.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "nachalnik",
      "text": "Hey, my man, turn the AC down, it's kinda chilly in here, for real!",
      "emotion": "angry",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": [
        "barmen"
      ]
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "Five minutes later.",
      "emotion": "neutral",
      "pauseAfterSec": 0.2,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "nachalnik",
      "text": "Yo, garçon!",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "nachalnik",
      "text": "Turn the AC up, bro, it's getting kinda hot...",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
