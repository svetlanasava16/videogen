  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Eine Mitarbeiterin der Notrufzentrale sitzt an ihrem Schreibtisch, als ein Anruf kommt.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "uchilka",
      "text": "Notruf eins-eins-zwei, was ist passiert?",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "muzhik-ryzhy",
      "text": "Mein Freund und ich sind durch den Wald gelaufen, und plötzlich ist er zusammengebrochen.",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "muzhik-ryzhy",
      "text": "Ich glaube, er ist tot.",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "uchilka",
      "text": "Okay, beruhigen Sie sich. Stellen Sie zuerst sicher, dass er tot ist.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "Am Telefon ist es still. Dann fällt ein Schuss.",
      "emotion": "neutral",
      "pauseAfterSec": 0.6,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "muzhik-ryzhy",
      "text": "Okay, und jetzt?",
      "emotion": "neutral",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
