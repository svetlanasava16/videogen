{
  "id": "ru-4b75a0e1bc8d.de",
  "jokeId": "ru-4b75a0e1bc8d",
  "locale": "de",
  "title": "Der Schluckauf",
  "location": "bolnitsa",
  "place": "hospital",
  "cast": [
    "zhena",
    "paren"
  ],
  "roles": {
    "zhena": "patient",
    "paren": "doctor"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Frau Peters ging zum Arzt. Sie bekam einen Termin bei einem ganz jungen Doktor, frisch von der Uni.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Nach ein paar Minuten in seinem Sprechzimmer stürzte Frau Peters mit wilden Schreien heraus und rannte den Flur entlang.",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "Ihr kam ein älterer Arzt entgegen. Er hielt sie an und fragte, was los sei.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "narrator",
      "text": "Als er das Sprechzimmer des jungen Arztes betrat, sah er streng aus.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "doktor",
      "text": "Was erlaubst du dir eigentlich?",
      "emotion": "angry",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "doktor",
      "text": "Frau Peters wird sechsundfünfzig, sie hat eine erwachsene Tochter, bald kommt ein Enkel, und du sagst ihr, sie ist schwanger!",
      "emotion": "angry",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "narrator",
      "text": "Der junge Arzt schrieb weiter etwas in die Karteikarte und antwortete:",
      "emotion": "neutral",
      "pauseAfterSec": 0.6,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "paren",
      "text": "Aber der Schluckauf ist doch weg, oder?",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
