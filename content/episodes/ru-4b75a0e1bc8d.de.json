  "locale": "de",
  "title": "Schluckauf",
  "kind": "joke",
  "v": 2,
  "location": "bolnitsa",
  "place": "hospital",
  "cast": [
    "paren",
    "tyoshcha",
    "doktor"
  ],
  "roles": {
    "paren": "doctor",
    "doktor": "doctor",
    "tyoshcha": "patient"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Frau Peters ging zum Arzt.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Sie bekam einen Termin bei einem ganz jungen Arzt, frisch von der Uni.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "Nach ein paar Minuten in seinem Sprechzimmer stürzte Frau Peters mit wildem Kreischen und Geschrei heraus und rannte den Flur entlang.",
      "emotion": "surprised",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "narrator",
      "text": "Ihr kam ein älterer Arzt entgegen. Er hielt sie an.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "doktor",
      "text": "Was ist denn los?",
      "emotion": "surprised",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l6",
      "character": "doktor",
      "text": "Was erlaubst du dir eigentlich?",
      "emotion": "angry",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l7",
      "character": "doktor",
      "text": "Frau Peters ist fünfundfünfzig, sie hat eine erwachsene Tochter,",
      "emotion": "angry",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l7b",
      "character": "doktor",
      "text": "bald kommt ein Enkel, und du sagst ihr, dass sie schwanger ist!",
      "emotion": "angry",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l8",
      "character": "narrator",
      "text": "Der junge Arzt schrieb weiter etwas in die Karteikarte und antwortete.",
      "emotion": "neutral",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l9",
      "character": "paren",
      "text": "Aber der Schluckauf ist doch weg, oder?",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
