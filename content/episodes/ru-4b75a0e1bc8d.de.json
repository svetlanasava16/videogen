  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Frau Petersen ging zum Arzt. Man gab ihr einen Termin bei einem ganz jungen Doktor, frisch von der Uni.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Nach ein paar Minuten in seinem Sprechzimmer stürzte Frau Petersen mit wildem Geschrei heraus und rannte den Flur entlang.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "Ihr kam ein älterer Arzt entgegen. Er hielt sie an und fragte, was los sei.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "narrator",
      "text": "Als er das Zimmer des jungen Arztes betrat, sah er streng aus.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "doktor",
      "text": "Was erlaubst du dir eigentlich?",
      "emotion": "angry",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "doktor",
      "text": "Frau Petersen ist fünfundfünfzig, sie hat eine erwachsene Tochter, bald kommt ein Enkel, und du sagst ihr, sie ist schwanger!",
      "emotion": "angry",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "paren",
      "text": "Aber der Schluckauf ist doch weg, oder?",
      "emotion": "neutral",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
