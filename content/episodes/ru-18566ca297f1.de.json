  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein riesiger Deutscher Schäferhund kommt in die Post, nimmt ein Telegrammformular und schreibt: Wuff... wuff... wuff... wuff... wuff... wuff... wuff... wuff... wuff.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "uchilka",
      "text": "Das sind nur neun Wörter. Sie können zum gleichen Preis noch ein Wort dazuschreiben.",
      "emotion": "neutral",
      "pauseAfterSec": 0.6,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "pyos",
      "text": "Ach nein, dann kommt ja nur Mist dabei raus...",
      "uncensored": "Ach nein, dann kommt ja nur Scheiße dabei raus...",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
