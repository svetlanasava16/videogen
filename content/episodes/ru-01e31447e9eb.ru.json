    {
      "id": "l1",
      "character": "nachalnik",
      "text": "Доброе утро, вы в прямом эфире!",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "devushka",
      "text": "Здравствуйте! Я вчера нашла кошелёк.",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "devushka",
      "text": "Там было пять тысяч долларов, шестьсот восемнадцать евро и визитка.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "devushka",
      "text": "Гарик Марикян, проспект Шверника, дом девятнадцать.",
      "emotion": "neutral",
      "pauseAfterSec": 0.6,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "devushka",
      "text": "Поставьте ему, пожалуйста, какую-нибудь хорошую песню!",
      "emotion": "happy",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    }
  ],
