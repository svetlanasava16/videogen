  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein Mann geht zu einem Anwalt und bittet um Rat.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [
        "muzhik"
      ],
      "exit": []
    },
    {
      "id": "l2",
      "character": "muzhik",
      "text": "Mein Nachbar schuldet mir fünfhundert Euro und gibt sie nicht zurück. Kann ich das Geld irgendwie bei ihm einklagen?",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "nachalnik",
      "text": "Können Sie, aber dafür brauchen Sie einen schriftlichen Beweis, dass er Ihnen etwas schuldet. Haben Sie so einen Beweis?",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "Ich fürchte, nein. Er hat es sich einfach so bei mir genommen.",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "nachalnik",
      "text": "Dann schreiben Sie ihm einen Brief und verlangen Sie in diesem Brief, dass er Ihnen sofort tausend Euro zurückgibt.",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "muzhik",
      "text": "Aber er schuldet mir doch nur fünfhundert Euro!",
      "emotion": "surprised",
      "pauseAfterSec": 0.7,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "nachalnik",
      "text": "Genau das wird er Ihnen antworten. Und das ist dann der schriftliche Beweis.",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
  "explicit": false,
