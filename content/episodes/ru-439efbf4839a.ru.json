  "locale": "ru",
  "title": "Проверка",
  "kind": "joke",
  "v": 2,
  "location": "klass",
  "place": "university",
  "cast": [
    "paren",
    "doktor"
  ],
  "roles": {
    "paren": "student",
    "doktor": "professor"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Идёт экзамен типа тест с вопросами, на которые надо отвечать «да» или «нет».",
      "emotion": "neutral",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l1b",
      "character": "narrator",
      "text": "Один из студентов подбрасывает монетку и записывает результаты.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "doktor",
      "text": "Ну, этот первым закончит.",
      "emotion": "smug",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "Экзамен закончился, остальные студенты уже написали и ушли, а этот всё сидит и монетку подбрасывает.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "narrator",
      "text": "Преподу это надоело.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "doktor",
      "text": "Ну что, ответил на вопросы?",
      "emotion": "angry",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l6",
      "character": "paren",
      "text": "Да.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l7",
      "character": "doktor",
      "text": "А чего тогда делаешь?",
      "emotion": "surprised",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l8",
      "character": "paren",
      "text": "Проверяю.",
      "emotion": "neutral",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
