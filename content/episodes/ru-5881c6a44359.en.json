  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "A terrible blunder has been made at the office, with awful consequences.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "A furious boss runs into the room and grabs his employee by the collar.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "nachalnik",
      "text": "One of us two is an idiot: either you or me!",
      "emotion": "angry",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l4",
      "character": "paren",
      "text": "Boss, with all your experience and foresight,",
      "emotion": "smug",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l4b",
      "character": "paren",
      "text": "could you really have hired an idiot?",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
