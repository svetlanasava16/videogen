{
  "id": "de-witze-1xrms30.de",
  "jokeId": "de-witze-1xrms30",
  "locale": "de",
  "title": "Die Jäger",
  "location": "derevnya",
  "place": "forest",
  "cast": [
    "muzhik-sosed",
    "muzhik-ryzhy"
  ],
  "roles": {
    "muzhik-sosed": "hunter",
    "muzhik-ryzhy": "hunter"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Zwei Jäger sind im Wald, als einer von beiden plötzlich zusammenbricht.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Er atmet nicht mehr und sein Blick ist starr.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "Der andere Jäger greift völlig panisch zum Telefon und wählt den Notruf.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "muzhik-ryzhy",
      "text": "Mein Freund ist tot! Was soll ich bloß tun?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "paren",
      "text": "Ganz ruhig, ich kann Ihnen helfen.",
      "emotion": "neutral",
      "pauseAfterSec": 0.2,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "paren",
      "text": "Stellen Sie als Erstes absolut sicher, dass er wirklich tot ist.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "narrator",
      "text": "Am Telefon ist kurz Stille, dann hört man einen lauten Schuss.",
      "emotion": "neutral",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "muzhik-ryzhy",
      "text": "Okay, erledigt. Und was jetzt?",
      "emotion": "neutral",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
