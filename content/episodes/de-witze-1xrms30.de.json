    {
      "id": "l1",
      "character": "narrator",
      "text": "Zwei Jäger im Wald. Plötzlich bricht einer zusammen und atmet nicht mehr.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "muzhik-ryzhy",
      "text": "Hallo, Notruf? Mein Freund ist tot! Was soll ich bloß tun?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "uchilka",
      "text": "Ganz ruhig, ich kann Ihnen helfen.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "uchilka",
      "text": "Stellen Sie als Erstes absolut sicher, dass er wirklich tot ist.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "Kurze Stille. Dann ein lauter Schuss.",
      "emotion": "neutral",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "muzhik-ryzhy",
      "text": "Okay, erledigt. Und was jetzt?",
