  "locale": "de",
  "title": "Ich weiß alles!",
  "location": "gostinaya",
  "place": "home-living-room",
  "cast": [
    "vovochka",
    "zhena",
    "muzhik"
  ],
  "roles": {
    "vovochka": "fritzchen",
    "zhena": "mother",
    "muzhik": "father"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Fritzchens Freunde haben ihm erzählt, dass alle Erwachsenen ein Geheimnis haben und man sie deshalb ganz leicht erpressen kann.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Fritzchen will das prüfen.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "vovochka",
      "text": "Ich weiß alles!",
      "emotion": "smug",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "narrator",
      "text": "Mama wird blass und steckt Fritzchen zwanzig Euro zu.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "zhena",
      "text": "Nur sag es nicht Papa!",
      "emotion": "surprised",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "Das gefällt Fritzchen sehr. Dann kommt Papa von der Arbeit.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "vovochka",
      "text": "Ich weiß alles!",
      "emotion": "smug",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "narrator",
      "text": "Papa schaut sich nervös um und gibt Fritzchen fünfzig Euro.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l9",
      "character": "muzhik",
      "text": "Zu Mama kein Wort!",
      "emotion": "surprised",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": [],
      "laugh": "chuckle"
    },
    {
      "id": "l10",
      "character": "narrator",
      "text": "Am Morgen trifft Fritzchen den Briefträger am Gartentor.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l11",
      "character": "vovochka",
      "text": "Ich weiß alles!",
      "emotion": "smug",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l12",
      "character": "narrator",
      "text": "Der Briefträger lässt seine Tasche fallen, eine Träne glänzt auf seiner Wange, und mit offenen Armen ruft er:",
      "emotion": "neutral",
      "pauseAfterSec": 0.6,
      "enter": [],
      "exit": []
    },
    {
      "id": "l13",
      "character": "paren",
      "text": "Dann komm doch her und umarme deinen Papa, mein Sohn!",
      "emotion": "happy",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
