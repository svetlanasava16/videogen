  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Два адвоката заходят в кафе, заказывают напитки и достают бутерброды.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "barmen",
      "text": "Извините, но у нас нельзя есть свою еду.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "Адвокаты переглядываются, пожимают плечами...",
      "emotion": "neutral",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l4",
      "character": "narrator",
      "text": "...и меняются своими бутербродами...",
      "emotion": "neutral",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
