{
  "id": "ru-5f735d01c987.ru",
  "jokeId": "ru-5f735d01c987",
  "locale": "ru",
  "title": "Имя на стекле",
  "kind": "joke",
  "v": 2,
  "location": "ulitsa",
  "place": "street",
  "cast": [
    "muzhik",
    "paren"
  ],
  "roles": {
    "muzhik": "everyman",
    "paren": "boyfriend"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Встречаются два приятеля. Один в плохом настроении.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "muzhik",
      "text": "Ты чего такой грустный?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "paren",
      "text": "Да с девушкой своей поссорился.",
      "emotion": "sad",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "Из-за чего?",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "paren",
      "text": "Ехали мы с ней вчера в метро,",
      "emotion": "sad",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l5b",
      "character": "paren",
      "text": "и я всю дорогу дышал на стекло и писал её имя, а она обиделась.",
      "emotion": "sad",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l6",
      "character": "muzhik",
      "text": "Странно! Разве на это можно обидеться?",
      "emotion": "surprised",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l7",
      "character": "paren",
      "text": "Да не любит она, когда ей на очки дышат.",
      "emotion": "sad",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
