{
  "id": "ru-d0d7c4a8d256.en",
  "jokeId": "ru-d0d7c4a8d256",
  "locale": "en",
  "title": "The Tickets",
  "kind": "joke",
  "v": 2,
  "location": "doroga",
  "place": "street",
  "cast": [
    "muzhik",
    "sluzhivy"
  ],
  "roles": {
    "muzhik": "everyman",
    "sluzhivy": "police-officer"
  },
  "lines": [
    {
      "id": "l1",
      "character": "muzhik",
      "text": "I went into the shop and was only in there for a few minutes.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "muzhik",
      "text": "When I came out, I saw a cop on a motorcycle writing a parking ticket.",
      "emotion": "surprised",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "muzhik",
      "text": "Aw, come on, forgive me this first time!",
      "emotion": "happy",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "He ignored me and kept writing the ticket.",
      "emotion": "sad",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "muzhik",
      "text": "You lousy Nazi!",
      "emotion": "angry",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l6",
      "character": "muzhik",
      "text": "In return he wrote another ticket, this time for the tires.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l7",
      "character": "muzhik",
      "text": "You freak!",
      "emotion": "angry",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l8",
      "character": "muzhik",
      "text": "Having written the second ticket and tucked it under the wiper, he started on a third.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l9",
      "character": "muzhik",
      "text": "For twenty minutes I called him names, and he wrote tickets.",
      "emotion": "happy",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l10",
      "character": "muzhik",
      "text": "But I didn't care: my car was parked around the corner.",
      "emotion": "smug",
      "pauseAfterSec": 0.6,
      "laugh": "chuckle"
    },
    {
      "id": "l11",
      "character": "muzhik",
      "text": "I just felt like having a little fun...",
      "emotion": "happy",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
  "explicit": false,
