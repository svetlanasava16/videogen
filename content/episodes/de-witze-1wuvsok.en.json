{
  "id": "de-witze-1wuvsok.en",
  "jokeId": "de-witze-1wuvsok",
  "locale": "en",
  "title": "The Ticket",
  "kind": "joke",
  "v": 2,
  "location": "samolet",
  "place": "train-station",
  "cast": [
    "paren",
    "muzhik"
  ],
  "roles": {
    "paren": "employee",
    "muzhik": "customer"
  },
  "lines": [
    {
      "id": "l1",
      "character": "muzhik",
      "text": "Excuse me, how much is a ticket to Springfield?",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "paren",
      "text": "Fifty dollars.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "muzhik",
      "text": "Nah, that's too much...",
      "emotion": "angry",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "narrator",
      "text": "The train starts rolling, and the guy starts jogging alongside, faster and faster, until he's going flat out, giving it all he's got.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "The next station comes into view, a final sprint, and at last the train stops.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "The guy, bright red in the face, drenched in sweat, pulse at two hundred, gasps for air.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l7",
      "character": "muzhik",
      "text": "And... now...?",
      "emotion": "sad",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l8",
      "character": "paren",
      "text": "Sixty dollars.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l9",
      "character": "muzhik",
      "text": "What?!",
      "emotion": "surprised",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l10",
      "character": "paren",
      "text": "Springfield is the other direction...",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
