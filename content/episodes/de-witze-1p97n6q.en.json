    {
      "id": "l1",
      "character": "narrator",
      "text": "A man is floating over the countryside in a hot-air balloon, but sadly he's lost his way. He spots a man on the ground.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "nachalnik",
      "text": "Where am I?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "paren",
      "text": "You're in a hot-air balloon.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "nachalnik",
      "text": "You must be an engineer. Your answer was absolutely correct, but not the least bit helpful.",
      "emotion": "angry",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "paren",
      "text": "And you are definitely a manager.",
      "emotion": "smug",
      "pauseAfterSec": 0.6,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "paren",
      "text": "You don't know where you are, you're completely helpless, and yet suddenly it's all my fault.",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
