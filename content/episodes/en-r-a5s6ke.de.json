  "lines": [
    {
      "id": "l1",
      "character": "devushka-ryzhaya",
      "text": "Mama, ich bin mit einem Mann zusammen.",
      "emotion": "happy",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "zhena",
      "text": "Mit wem denn, Schatz?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "devushka-ryzhaya",
      "text": "Mit Paul, dem Postboten.",
      "emotion": "happy",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "zhena",
      "text": "Mit Paul, dem Postboten? Aber er könnte dein Vater sein!",
      "emotion": "surprised",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l5",
      "character": "devushka-ryzhaya",
      "text": "Aber Mama, Alter ist doch nur eine Zahl.",
      "emotion": "smug",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l6",
      "character": "zhena",
      "text": "Schatz, ich glaube, du hast mich nicht verstanden.",
      "emotion": "sad",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
