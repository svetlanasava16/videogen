  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Two hunters are in the woods when one of them suddenly collapses.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "He isn't breathing, and his eyes are glazed over.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "In a total panic, the other hunter grabs his phone and calls emergency services.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "muzhik-ryzhy",
      "text": "My friend is dead! What do I do?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "paren",
      "text": "Stay calm, I can help you.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l6",
      "character": "paren",
      "text": "First, make absolutely sure he's really dead.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l7",
      "character": "narrator",
      "text": "There's a brief silence on the line, then a loud gunshot.",
      "emotion": "neutral",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l8",
      "character": "muzhik-ryzhy",
      "text": "Okay, done. Now what?",
      "emotion": "neutral",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
