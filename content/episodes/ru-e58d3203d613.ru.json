  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Вольво цепляет на перекрестке джип.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Все останавливаются, из джипа вываливают ребята в спортивной форме и подходят к водителю Вольво.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "nachalnik",
      "text": "Ну все, мужик, ты попал!",
      "emotion": "angry",
      "pauseAfterSec": 0.2,
      "enter": [
        "nachalnik",
        "muzhik-ryzhy",
        "paren"
      ],
      "exit": []
    },
    {
      "id": "l4",
      "character": "nachalnik",
      "text": "Продавай машину, продавай квартиру, с тебя деньги!",
      "emotion": "angry",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "muzhik",
      "text": "Ребята, а кто вы такие?",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "nachalnik",
      "text": "Мы? Мы спортсмены!",
      "emotion": "surprised",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "narrator",
      "text": "Мужик достает пистолет и, заряжая его:",
      "emotion": "neutral",
      "pauseAfterSec": 0.7,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "muzhik",
      "text": "Ну тогда на старт! Внимание!..",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
