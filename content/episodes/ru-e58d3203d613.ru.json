  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "На перекрёстке «Вольво» цепляет джип. Из джипа вываливаются ребята в спортивных костюмах.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "nachalnik",
      "text": "Ну всё, мужик, ты попал!",
      "emotion": "angry",
      "pauseAfterSec": 0.3,
      "enter": [
        "nachalnik"
      ],
      "exit": []
    },
    {
      "id": "l3",
      "character": "nachalnik",
      "text": "Продавай машину, продавай квартиру, с тебя деньги!",
      "emotion": "angry",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "Ребята, а вы вообще кто такие?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "nachalnik",
      "text": "Мы? Мы спортсмены!",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "Мужик молча достаёт пистолет.",
      "emotion": "neutral",
      "pauseAfterSec": 0.7,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "muzhik",
      "text": "Ну тогда на старт! Внимание!",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    }
  ],
