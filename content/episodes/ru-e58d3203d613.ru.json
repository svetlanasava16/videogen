  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Вольво цепляет на перекрёстке джип. Все останавливаются, из джипа вываливают ребята в спортивной форме и подходят к водителю Вольво.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "nachalnik",
      "text": "Ну всё, мужик, ты попал! Продавай машину, продавай квартиру, с тебя деньги!",
      "emotion": "angry",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "muzhik",
      "text": "Ребята, а кто вы такие?",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "nachalnik",
      "text": "Мы? Мы спортсмены!",
      "emotion": "surprised",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "muzhik",
      "text": "Ну тогда на старт! Внимание!",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
