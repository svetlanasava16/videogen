      "character": "nachalnik",
      "text": "Ich habe gehört, Sie sind extrem schnell im Rechnen.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "paren",
      "text": "Ja, das bin ich tatsächlich.",
      "emotion": "smug",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "nachalnik",
      "text": "Was ist vierzehn mal siebenundzwanzig?",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
