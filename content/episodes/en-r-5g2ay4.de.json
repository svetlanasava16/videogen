    {
      "id": "l4",
      "character": "paren",
      "text": "Neunundvierzig.",
      "emotion": "happy",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l5",
      "character": "nachalnik",
      "text": "Das ist nicht mal annähernd richtig.",
      "emotion": "angry",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l6",
      "character": "paren",
      "text": "Ja, aber es war schnell.",
