  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein Mann kommt mit Schmerzen ins Krankenhaus. Ein Arzt untersucht ihn.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "doktor",
      "text": "Sie haben eine schwere Krankheit.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "doktor",
      "text": "Wir müssen Sie hierbehalten und auf eine strikte Diät setzen: Pizza und Spiegelei!",
      "emotion": "neutral",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "Und davon werde ich wieder gesund?",
      "emotion": "surprised",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l5",
      "character": "doktor",
      "text": "Keine Ahnung, aber das kann man prima unter der Tür durchschieben.",
      "emotion": "neutral",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
