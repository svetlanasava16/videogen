{
  "id": "en-r-9h7qsa.ru",
  "jokeId": "en-r-9h7qsa",
  "locale": "ru",
  "title": "Сдача",
  "kind": "joke",
  "v": 2,
  "location": "bar",
  "place": "bar",
  "cast": [
    "muzhik",
    "barmen"
  ],
  "roles": {
    "muzhik": "customer",
    "barmen": "bartender"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Заходит мужик в бар и просит пива.",
      "emotion": "neutral",
      "pauseAfterSec": 0
    },
    {
      "id": "l2",
      "character": "barmen",
      "text": "С вас сто рублей.",
      "emotion": "neutral",
      "pauseAfterSec": 0
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "Говорит бармен, а мужик бросает на пол двадцать пятирублёвых монет.",
      "emotion": "neutral",
      "pauseAfterSec": 0
    },
    {
      "id": "l4",
      "character": "narrator",
      "text": "Бармен нехотя собирает монеты",
      "emotion": "neutral",
      "pauseAfterSec": 0
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "и наливает пиво.",
      "emotion": "neutral",
      "pauseAfterSec": 0
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "На следующий день мужик снова приходит в бар, просит пива,",
      "emotion": "neutral",
      "pauseAfterSec": 0
    },
    {
      "id": "l7",
      "character": "narrator",
      "text": "бросает на пол двадцать пятирублёвых монет, и так далее.",
      "emotion": "neutral",
      "pauseAfterSec": 0
    },
    {
      "id": "l8",
      "character": "narrator",
      "text": "На следующий день — опять.",
      "emotion": "neutral",
      "pauseAfterSec": 0
    },
    {
      "id": "l9",
      "character": "narrator",
      "text": "На четвёртый день он просит пива",
      "emotion": "neutral",
      "pauseAfterSec": 0
    },
    {
      "id": "l10",
      "character": "narrator",
      "text": "и протягивает бармену двухсотрублёвую купюру.",
      "emotion": "neutral",
      "pauseAfterSec": 0
    },
    {
      "id": "l11",
      "character": "narrator",
      "text": "Бармен пользуется шансом отомстить,",
      "emotion": "smug",
      "pauseAfterSec": 0
    },
    {
      "id": "l12",
      "character": "narrator",
      "text": "бросает на пол двадцать пятирублёвых монет и орёт:",
      "emotion": "neutral",
      "pauseAfterSec": 0
    },
    {
      "id": "l13",
      "character": "barmen",
      "text": "Вот твоя сдача, козёл!",
      "uncensored": "Вот твоя сдача, мудак!",
      "emotion": "angry",
      "pauseAfterSec": 0
    },
    {
      "id": "l14",
      "character": "narrator",
      "text": "Мужик смотрит на монеты и говорит:",
      "emotion": "neutral",
      "pauseAfterSec": 0
    },
    {
      "id": "l15",
      "character": "muzhik",
      "text": "Мне ещё пива, пожалуйста.",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
