  "lines": [
    {
      "id": "l1",
      "character": "ded",
      "text": "Forgive me, Father, for I have sinned.",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [
        "ded"
      ],
      "exit": []
    },
    {
      "id": "l2",
      "character": "batyushka",
      "text": "What have you done, my son?",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "ded",
      "text": "During the Second World War I hid a Jewish man in my attic.",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "batyushka",
      "text": "But that's no sin.",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "ded",
      "text": "I told him that for twenty dollars a week he could stay as long as he liked.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "batyushka",
      "text": "Well, you did a good thing.",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "ded",
      "text": "Thank you, that's a great relief. But I do have one more question.",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "batyushka",
      "text": "Yes, my son?",
      "emotion": "neutral",
      "pauseAfterSec": 0.6,
      "enter": [],
      "exit": []
    },
    {
      "id": "l9",
      "character": "ded",
      "text": "Should I tell him the war is over?",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "enter": [],
