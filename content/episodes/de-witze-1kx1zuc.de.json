  "lines": [
    {
      "id": "l1",
      "character": "paren",
      "text": "Professor Doktor Vögele, Ihnen als dem renommiertesten Naturforscher unserer Zeit ist es nach jahrzehntelanger Suche im tiefsten,",
      "emotion": "neutral",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l1b",
      "character": "paren",
      "text": "abgelegensten Teil des Dschungels von Madagaskar gelungen,",
      "emotion": "neutral",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l1c",
      "character": "paren",
      "text": "die letzten Exemplare der Dodos zu entdecken.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l2",
      "character": "paren",
      "text": "Bitte erzählen Sie unseren Zuschauern, wie fanden Sie sie?",
      "emotion": "happy",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l3",
      "character": "doktor",
      "text": "Sehr lecker! Alle beide. Auch die Eier.",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
