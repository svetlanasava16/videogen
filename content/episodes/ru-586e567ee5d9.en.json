  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "A man left his pager at home.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "In the evening he comes back and reads his messages.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "The first one:",
      "emotion": "neutral",
      "pauseAfterSec": 0.2
    },
    {
      "id": "l4",
      "character": "devushka",
      "text": "Sweetie, darling, my love, please call me.",
      "emotion": "happy",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "devushka",
      "text": "Kisses, always yours, Marina.",
      "emotion": "happy",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "The second one:",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l7",
      "character": "zhena",
      "text": "I already called, you don't have to worry.",
      "emotion": "smug",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l8",
      "character": "zhena",
      "text": "Your wife.",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
