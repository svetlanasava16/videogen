  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Stirlitz, the Soviet spy, came to a familiar bar to meet his contact.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "sluzhivy",
      "text": "A double vodka.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "barmen",
      "text": "We ran out of vodka two days ago.",
      "emotion": "sad",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "sluzhivy",
      "text": "Well, then a double cognac.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "barmen",
      "text": "We ran out of cognac yesterday.",
      "emotion": "sad",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l6",
      "character": "sluzhivy",
      "text": "Well, do you at least have beer?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l7",
      "character": "barmen",
      "text": "Sorry, that ran out this morning.",
      "emotion": "sad",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l8",
      "character": "sluzhivy",
      "text": "So my contact is already here.",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
