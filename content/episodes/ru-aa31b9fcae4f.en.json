{
  "id": "ru-aa31b9fcae4f.en",
  "jokeId": "ru-aa31b9fcae4f",
  "locale": "en",
  "title": "To Round It Off",
  "kind": "joke",
  "v": 2,
  "location": "ulitsa",
  "place": "street",
  "cast": [
    "muzhik",
    "muzhik-sosed"
  ],
  "roles": {
    "muzhik": "everyman",
    "muzhik-sosed": "friend"
  },
  "lines": [
    {
      "id": "l1",
      "character": "muzhik",
      "text": "Oh, damn, I forgot my wallet, and I'm ten dollars short. Lend me ten?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "muzhik-sosed",
      "text": "Well, here you go.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "The next day.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "Do I owe you ten?",
      "emotion": "neutral",
      "pauseAfterSec": 0.2
    },
    {
      "id": "l5",
      "character": "muzhik-sosed",
      "text": "Yes.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l6",
      "character": "muzhik",
      "text": "I forgot my wallet again. Lend me another forty, and I'll owe you an even fifty.",
      "emotion": "happy",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l7",
      "character": "muzhik-sosed",
      "text": "Well, all right.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l8",
      "character": "narrator",
      "text": "The next day.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l9",
      "character": "muzhik",
      "text": "Do I owe you fifty dollars?",
      "emotion": "neutral",
      "pauseAfterSec": 0.2
    },
    {
      "id": "l10",
      "character": "muzhik-sosed",
      "text": "Yes.",
      "emotion": "sad",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l11",
      "character": "muzhik",
      "text": "No wallet on me again today. Come on, lend me another hundred and fifty, and then I'll pay you back two hundred.",
      "emotion": "happy",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l12",
      "character": "muzhik-sosed",
      "text": "Well, okay.",
      "emotion": "sad",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l13",
      "character": "narrator",
      "text": "The next day.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l14",
      "character": "muzhik",
      "text": "Do I owe you two hundred?",
      "emotion": "neutral",
      "pauseAfterSec": 0.2
    },
    {
      "id": "l15",
      "character": "muzhik-sosed",
      "text": "Well, of course.",
      "emotion": "sad",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l16",
      "character": "muzhik",
      "text": "Let me borrow another three hundred, just to round it off, and then I'll pay you back five hundred in one go.",
      "emotion": "smug",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l17",
      "character": "muzhik-sosed",
      "text": "Well, what can I do. Here.",
      "emotion": "sad",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l18",
      "character": "narrator",
      "text": "The next day.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l19",
      "character": "muzhik",
      "text": "Do I owe you five hundred?",
      "emotion": "neutral",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l20",
      "character": "muzhik-sosed",
      "text": "No!",
      "emotion": "angry",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
