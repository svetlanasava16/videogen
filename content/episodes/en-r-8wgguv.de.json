{
  "id": "en-r-8wgguv.de",
  "jokeId": "en-r-8wgguv",
  "locale": "de",
  "title": "Die Katze auf dem Dach",
  "kind": "joke",
  "v": 2,
  "location": "plyazh",
  "place": "beach",
  "cast": [
    "zhena",
    "muzhik"
  ],
  "roles": {
    "zhena": "wife",
    "muzhik": "husband"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Eine Frau ist im Urlaub und ruft zu Hause an.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "zhena",
      "text": "Wie geht's meiner Katze?",
      "emotion": "happy",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "muzhik",
      "text": "Die Katze ist tot.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l4",
      "character": "zhena",
      "text": "Also, das hättest du mir auch sagen können, wenn ich wieder zu Hause bin!",
      "emotion": "angry",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "zhena",
      "text": "Jetzt kann ich meinen Urlaub nicht mehr genießen.",
      "emotion": "sad",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l6",
      "character": "zhena",
      "text": "Du hättest einfach eine kleine Notlüge erzählen können. Zum Beispiel, die Katze sitzt auf dem Dach und du kriegst sie nicht runter.",
      "emotion": "angry",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l7",
      "character": "muzhik",
      "text": "Okay, tut mir leid. Das merke ich mir.",
      "emotion": "sad",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l8",
      "character": "zhena",
      "text": "Na ja, und wie geht's meiner Mutter?",
      "emotion": "neutral",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l9",
      "character": "muzhik",
      "text": "Deine Mutter sitzt auf dem Dach, und wir kriegen sie nicht runter.",
      "emotion": "neutral",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
