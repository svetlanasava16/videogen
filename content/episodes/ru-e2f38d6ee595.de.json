{
  "id": "ru-e2f38d6ee595.de",
  "jokeId": "ru-e2f38d6ee595",
  "locale": "de",
  "title": "Der Testkauf",
  "location": "bar",
  "place": "bar",
  "cast": [
    "nachalnik",
    "barmen"
  ],
  "roles": {
    "nachalnik": "bureaucrat",
    "barmen": "bartender"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "In eine schicke Kneipe kommt ein Mann und sagt zum Wirt:",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "nachalnik",
      "text": "Hundert Gramm Wodka.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "Der Wirt schenkt ein und serviert. Der Mann zieht einen Messbecher und einen Dienstausweis aus der Tasche:",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "nachalnik",
      "text": "Testkauf. Fünfundsiebzig Gramm! Fünfzig Euro Strafe.",
      "emotion": "smug",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "Am nächsten Abend. Dieselben Gesichter. Der Mann misst wieder mit dem Messbecher nach und kassiert den nächsten Fünfziger Strafe.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "nachalnik",
      "text": "Sag mal, du hast mich doch erkannt, warum hast du trotzdem zu wenig eingeschenkt?",
      "emotion": "surprised",
      "pauseAfterSec": 0.6,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "barmen",
      "text": "Mir ist es einfacher, dir den Fünfziger zu geben, als mir wegen solcher Idioten die geübte Hand zu verderben...",
      "uncensored": "Mir ist es einfacher, dir den Fünfziger zu geben, als mir wegen solcher Arschlöcher die geübte Hand zu verderben...",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
  "explicit": false,
