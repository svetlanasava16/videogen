  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Bei einem Besuch in der Irrenanstalt fragte ich den Direktor:",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "muzhik",
      "text": "Wie stellen Sie fest, ob ein Patient eingewiesen werden sollte oder nicht?",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "doktor",
      "text": "Nun, wir füllen eine Badewanne. Dann bieten wir dem Patienten einen Teelöffel, eine Teetasse und einen Eimer an und bitten ihn oder sie, die Badewanne zu leeren.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "Ah, ich verstehe. Ein normaler Mensch würde den Eimer nehmen, weil er größer ist als der Löffel oder die Teetasse.",
      "emotion": "smug",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "doktor",
      "text": "Nein. Ein normaler Mensch würde den Stöpsel aus der Badewanne ziehen.",
      "emotion": "smug",
      "pauseAfterSec": 0.6,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "doktor",
      "text": "Möchten Sie ein Bett am Fenster?",
      "emotion": "happy",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
  "explicit": false,
