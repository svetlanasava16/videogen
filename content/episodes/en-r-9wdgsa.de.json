{
  "id": "en-r-9wdgsa.de",
  "jokeId": "en-r-9wdgsa",
  "locale": "de",
  "title": "Der Badewannentest",
  "kind": "joke",
  "v": 2,
  "location": "bolnitsa",
  "place": "hospital",
  "cast": [
    "muzhik",
    "doktor"
  ],
  "roles": {
    "muzhik": "everyman",
    "doktor": "doctor"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Bei einem Besuch in der Irrenanstalt fragte ich den Direktor:",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "muzhik",
      "text": "Wie stellen Sie fest, ob ein Patient eingewiesen werden sollte oder nicht?",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "doktor",
      "text": "Nun, wir füllen eine Badewanne.",
      "emotion": "neutral",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l3b",
      "character": "doktor",
      "text": "Dann bieten wir dem Patienten einen Teelöffel,",
      "emotion": "neutral",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l3c",
      "character": "doktor",
      "text": "eine Teetasse und einen Eimer an und bitten ihn oder sie, die Badewanne zu leeren.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "Ah, ich verstehe.",
      "emotion": "smug",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l4b",
      "character": "muzhik",
      "text": "Ein normaler Mensch würde den Eimer nehmen,",
      "emotion": "smug",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l4c",
      "character": "muzhik",
      "text": "weil er größer ist als der Löffel oder die Teetasse.",
      "emotion": "smug",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l5",
      "character": "doktor",
      "text": "Nein. Ein normaler Mensch würde den Stöpsel aus der Badewanne ziehen.",
      "emotion": "smug",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l6",
      "character": "doktor",
      "text": "Möchten Sie ein Bett am Fenster?",
      "emotion": "happy",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
