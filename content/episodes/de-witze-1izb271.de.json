  "locale": "de",
  "title": "Keiner hat auf meinen Opa gehört",
  "kind": "joke",
  "v": 2,
  "location": "samolet",
  "place": "theater",
  "cast": [
    "ded",
    "muzhik-sosed",
    "sluzhivy"
  ],
  "roles": {
    "ded": "grandpa",
    "sluzhivy": "guard",
    "muzhik-sosed": "customer"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Als die Titanic damals losgefahren ist, hat mein Opa alle vor dem drohenden Unheil gewarnt.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "ded",
      "text": "Das Schiff wird auf einen Eisberg krachen und untergehen,",
      "emotion": "angry",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l2b",
      "character": "ded",
      "text": "und die meisten werden sterben!",
      "emotion": "angry",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "Doch niemand wollte ihn hören.",
      "emotion": "sad",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "muzhik-sosed",
      "text": "Halt die Klappe! Du ruinierst alles!",
      "emotion": "angry",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "Schließlich hat man ihn dann aus dem Kino geworfen.",
      "emotion": "neutral",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
  "explicit": false,
