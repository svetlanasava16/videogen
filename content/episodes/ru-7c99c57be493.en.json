  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "A very useful piece of advice for men.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "If soft little hands cover your eyes, a full bosom and a chubby little tummy press into your back, and from behind you hear:",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "zhena",
      "text": "Guess who?",
      "emotion": "happy",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l4",
      "character": "narrator",
      "text": "Whatever happens, answer:",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "muzhik",
      "text": "Dave, is that you?",
      "emotion": "surprised",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "Trust me, it's better that way.",
      "emotion": "neutral",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
