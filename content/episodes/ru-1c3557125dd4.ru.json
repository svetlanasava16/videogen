{
  "id": "ru-1c3557125dd4.ru",
  "jokeId": "ru-1c3557125dd4",
  "locale": "ru",
  "title": "Выручай, друг",
  "kind": "joke",
  "v": 2,
  "location": "spalnya",
  "place": "bedroom",
  "cast": [
    "muzhik",
    "zhena",
    "muzhik-sosed"
  ],
  "roles": {
    "muzhik": "husband",
    "zhena": "wife",
    "muzhik-sosed": "friend"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Мужик утром просыпается с глубочайшего похмелья от телефонного звонка.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Звонит друг, которого он давно не видел.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "muzhik",
      "text": "Ты откуда?",
      "emotion": "sad",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "muzhik-sosed",
      "text": "Выручай, друг, из вытрезвителя звоню, недалеко от твоего дома.",
      "emotion": "sad",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "muzhik-sosed",
      "text": "Денег нет, надо сто пятьдесят шесть рублей, чтобы отпустили.",
      "emotion": "sad",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "Мужик обещает, кладёт трубку и, собрав остаток сил, поднимается и начинает медленно одеваться, стараясь не упасть.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l7",
      "character": "zhena",
      "text": "Куда?!",
      "emotion": "angry",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l8",
      "character": "narrator",
      "text": "Тот честно объясняет ситуацию.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l9",
      "character": "narrator",
      "text": "Жена пристально смотрит на его опухшую физиономию и говорит:",
      "emotion": "neutral",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l10",
      "character": "zhena",
      "text": "Триста двенадцать рублей возьми!",
      "emotion": "angry",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
  "explicit": false,
