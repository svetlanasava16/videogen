      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "devushka",
      "text": "Das gibt's doch nicht! So ein großer, gutaussehender Mann und keine Freundin? Warum?",
