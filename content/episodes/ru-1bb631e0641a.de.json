  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein Mann betritt ein Juweliergeschäft.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [
        "muzhik"
      ],
      "exit": []
    },
    {
      "id": "l2",
      "character": "devushka",
      "text": "Ach, der Herr, wie schön, dass Sie zu uns kommen! Zum Valentinstag haben wir zwei Wochen lang zwanzig Prozent Rabatt, kaufen Sie doch etwas für Ihre Freundin.",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "devushka",
      "text": "Hier, ein goldener Anhänger in Herzform, der wird Ihrer Freundin sehr gefallen.",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "Ich habe keine Freundin...",
      "emotion": "sad",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "devushka",
      "text": "Das kann doch nicht sein! So ein stattlicher, schöner, großer Mann, und keine Freundin? Warum denn?!",
      "emotion": "surprised",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "muzhik",
      "text": "Meine Frau erlaubt es nicht...",
      "emotion": "sad",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
