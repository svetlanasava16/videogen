{
  "id": "ru-1bb631e0641a.de",
  "jokeId": "ru-1bb631e0641a",
  "locale": "de",
  "title": "Ein Geschenk für die Freundin",
  "kind": "joke",
  "v": 2,
  "location": "magazin",
  "place": "shop",
  "cast": [
    "muzhik",
    "devushka"
  ],
  "roles": {
    "muzhik": "everyman",
    "devushka": "cashier"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein Mann betritt ein Juweliergeschäft.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "devushka",
      "text": "Oh, der Herr, wie schön, dass Sie zu uns kommen!",
      "emotion": "happy",
      "pauseAfterSec": 0.2
    },
    {
      "id": "l3",
      "character": "devushka",
      "text": "Zum Valentinstag haben wir zwei Wochen lang zwanzig Prozent Rabatt,",
      "emotion": "happy",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l3b",
      "character": "devushka",
      "text": "kaufen Sie doch etwas als Geschenk für Ihre Freundin.",
      "emotion": "happy",
      "pauseAfterSec": 0.2
    },
    {
      "id": "l4",
      "character": "devushka",
      "text": "Hier, ein goldener Anhänger in Herzform, der wird Ihrer Freundin sehr gefallen.",
      "emotion": "smug",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "muzhik",
      "text": "Ich habe keine Freundin...",
      "emotion": "sad",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l6",
      "character": "devushka",
      "text": "Das kann doch nicht sein, so ein stattlicher,",
      "emotion": "surprised",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l6c",
      "character": "devushka",
      "text": "gutaussehender, großer Mann und keine Freundin?",
      "emotion": "surprised",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l6b",
      "character": "devushka",
      "text": "Warum denn?!",
      "emotion": "surprised",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l7",
      "character": "muzhik",
      "text": "Meine Frau erlaubt es nicht...",
      "emotion": "sad",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
  "explicit": false,
