  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Холодным зимним утром жена пишет мужу.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "zhena",
      "text": "Окна замёрзли, не открываются.",
      "emotion": "sad",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "muzhik",
      "text": "Аккуратно полей их тёплой водой, а потом осторожно простучи края молотком.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l4",
      "character": "narrator",
      "text": "Через десять минут жена пишет снова.",
      "emotion": "neutral",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l5",
      "character": "zhena",
      "text": "Компьютер теперь совсем накрылся.",
      "emotion": "sad",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
