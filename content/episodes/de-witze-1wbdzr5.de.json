  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein Klempner wird mitten in der Nacht zum Haus des Arztes gerufen: Ein Wasserrohr sei geplatzt, der Keller stehe unter Wasser.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Der Klempner fährt also los, geht in den Keller, der wirklich schon bis zur Hälfte voll Wasser steht.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "Er schaut nach links, er schaut nach rechts, wirft dann drei Dichtungen ins Wasser und sagt zum Arzt:",
      "emotion": "neutral",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l4",
      "character": "barmen",
      "text": "Wenn's morgen früh nicht besser ist, rufen Sie noch mal an.",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
  "explicit": false,
