      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "narrator",
      "text": "Der Klempner schaut nach links, schaut nach rechts und wirft drei Dichtungen ins Wasser.",
      "emotion": "neutral",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "barmen",
      "text": "Wenn's morgen früh nicht besser ist, rufen Sie noch mal an.",
