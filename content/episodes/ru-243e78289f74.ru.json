  "roles": {
    "zhena": "mother",
    "devushka-ryzhaya": "daughter",
    "doktor": "doctor"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Слепая девочка за обедом всегда ощупывает тарелку и ноет.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "devushka-ryzhaya",
      "text": "Ну вот, мне опять меньше всех положили! Раз я не вижу, можно и обделить! Жмоты!",
      "emotion": "angry",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "Мама не выдерживает и зовёт психолога.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "doktor",
      "text": "Сварите ей целый таз пельменей. И пусть ест.",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [
        "doktor"
      ],
      "exit": [
        "doktor"
      ]
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "На следующий день мама ставит перед дочкой целый таз пельменей.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "zhena",
      "text": "Ешь, доченька. Это всё тебе.",
      "emotion": "happy",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "devushka-ryzhaya",
      "text": "Ничего себе... Представляю, сколько вы себе наложили!",
      "emotion": "surprised",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    }
  ],
