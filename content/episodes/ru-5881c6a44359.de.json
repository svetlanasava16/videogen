  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Im Büro ist ein grober Fehler passiert, mit furchtbaren Folgen.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Der wütende Chef stürmt ins Zimmer und packt seinen Mitarbeiter am Kragen.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "nachalnik",
      "text": "Einer von uns beiden ist ein Idiot: entweder Sie oder ich!",
      "emotion": "angry",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l4",
      "character": "paren",
      "text": "Chef, hätten Sie mit Ihrer Erfahrung und Weitsicht etwa einen Idioten eingestellt?",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
