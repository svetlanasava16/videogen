  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "On his ninety-fifth birthday, an old man in a retirement home is interviewed for a story in the local paper.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "paren",
      "text": "How do you feel at your age and in these surroundings?",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "ded",
      "text": "Thank you, very well.",
      "emotion": "happy",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "paren",
      "text": "So what does your daily routine look like in here?",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "ded",
      "text": "Mornings: first, a pee!",
      "uncensored": "Mornings: first, a piss!",
      "emotion": "happy",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l6",
      "character": "paren",
      "text": "And? No problems?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l7",
      "character": "ded",
      "text": "Not at all! Strong stream, no burning, healthy color!",
      "emotion": "smug",
      "pauseAfterSec": 0.4,
      "laugh": "chuckle"
    },
    {
      "id": "l8",
      "character": "paren",
      "text": "And then?",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l9",
      "character": "ded",
      "text": "Bowel movement.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l10",
      "character": "paren",
      "text": "Any complaints?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l11",
      "character": "ded",
      "text": "Not a trace. Good pressure, no blood, a perfectly normal emptying of the bowels.",
      "emotion": "smug",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l12",
      "character": "paren",
      "text": "And what happens next?",
      "emotion": "neutral",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l13",
      "character": "ded",
      "text": "Well, then I get up.",
      "emotion": "happy",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
