  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "A man jumps out of a plane with a parachute.",
      "emotion": "neutral",
      "pauseAfterSec": 0
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "After a while he wants to open the parachute, but nothing happens. He thinks:",
      "emotion": "neutral",
      "pauseAfterSec": 0
    },
    {
      "id": "l3",
      "character": "muzhik",
      "text": "No big deal, I've still got the reserve chute.",
      "emotion": "smug",
      "pauseAfterSec": 0
    },
    {
      "id": "l4",
      "character": "narrator",
      "text": "He wants to open it, but nothing works.",
      "emotion": "neutral",
      "pauseAfterSec": 0
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "Slowly he starts to panic,",
      "emotion": "neutral",
      "pauseAfterSec": 0
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "when suddenly a man with a toolbox comes flying up towards him from below.",
      "emotion": "neutral",
      "pauseAfterSec": 0
    },
    {
      "id": "l7",
      "character": "narrator",
      "text": "So he asks him:",
      "emotion": "neutral",
      "pauseAfterSec": 0
    },
    {
      "id": "l8",
      "character": "muzhik",
      "text": "Heaven sent you! Do you repair parachutes?",
      "emotion": "happy",
      "pauseAfterSec": 0
    },
    {
      "id": "l9",
      "character": "narrator",
      "text": "And the man answers:",
      "emotion": "neutral",
      "pauseAfterSec": 0
    },
    {
      "id": "l10",
      "character": "barmen",
      "text": "No, gas lines.",
      "emotion": "neutral",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
