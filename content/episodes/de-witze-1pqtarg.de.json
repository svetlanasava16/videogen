  "title": "Halbidiot",
  "kind": "joke",
  "v": 2,
  "location": "klass",
  "place": "school-classroom",
  "cast": [
    "paren",
    "vovochka"
  ],
  "roles": {
    "paren": "teacher",
    "vovochka": "fritzchen"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Der Lehrer gibt die Klassenarbeiten zurück.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "paren",
      "text": "Fritzchen, schon wieder eine Fünf!",
      "emotion": "angry",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "paren",
      "text": "Als ich in deinem Alter...",
      "emotion": "neutral",
      "pauseAfterSec": 0.2
    },
    {
      "id": "l4",
      "character": "vovochka",
      "text": "So alt sind Sie auch noch nicht.",
      "emotion": "smug",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "paren",
      "text": "Achso, na dann sag mal, wie alt bin ich denn?",
      "emotion": "smug",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l6",
      "character": "vovochka",
      "text": "Sie sind ganz genau vierunddreißig Jahre.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l7",
      "character": "paren",
      "text": "Das ist absolut richtig, Fritzchen, wieso weißt du das?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l8",
      "character": "vovochka",
      "text": "Tja, ich kenne Ihren Sohn aus der Zehn a.",
      "emotion": "smug",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l9",
      "character": "vovochka",
      "text": "Der ist siebzehn und ein Halbidiot.",
      "emotion": "happy",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
