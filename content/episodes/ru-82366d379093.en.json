  "locale": "en",
  "title": "The Last Chicken",
  "location": "magazin",
  "place": "shop",
  "cast": [
    "devushka",
    "barmen"
  ],
  "roles": {
    "devushka": "woman",
    "barmen": "salesman"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "A butcher's shop, one minute before closing.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "devushka",
      "text": "Thank God, I made it! Do you have any chickens?",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "The butcher takes the only chicken out of the freezer and puts it on the scales. The scales show two pounds.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "devushka",
      "text": "Hmm... Don't you have a bigger one?",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "The butcher puts the chicken back, then takes out the same one, turns it around, puts it on the scales and presses down with his finger. The scales show three pounds.",
      "emotion": "neutral",
      "pauseAfterSec": 0.6,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "devushka",
      "text": "Great! I'll take both, please.",
      "emotion": "happy",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
