    {
      "id": "l1",
      "character": "narrator",
      "text": "A butcher shop, one minute to closing.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "devushka",
      "text": "Thank God, I made it! Do you have any chicken?",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [
        "devushka"
      ],
      "exit": []
    },
    {
      "id": "l3",
      "character": "barmen",
      "text": "Last one. Exactly two pounds.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "devushka",
      "text": "Hmm. Nothing bigger?",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "barmen",
      "text": "Let me check.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "He carries the same chicken away, brings it right back, and presses the scale with his thumb.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "barmen",
      "text": "Here. Three pounds.",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "devushka",
      "text": "Perfect! I'll take both.",
      "emotion": "happy",
      "pauseAfterSec": 0.8,
