  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "A little old lady goes to the doctor and says,",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [
        "tyoshcha"
      ],
      "exit": []
    },
    {
      "id": "l2",
      "character": "tyoshcha",
      "text": "Doctor, I have a terrible problem with gas, but it doesn't bother me much.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "tyoshcha",
      "text": "My farts are always silent and never smell.",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "tyoshcha",
      "text": "I probably farted fifteen times since I've been here, and you didn't realize it.",
      "emotion": "smug",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "doktor",
      "text": "Interesting. Why don't you take these pills and come see me in a week?",
      "emotion": "neutral",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": [
        "tyoshcha"
      ]
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "The old lady returns in a week and says,",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [
        "tyoshcha"
      ],
      "exit": []
    },
    {
      "id": "l7",
      "character": "tyoshcha",
      "text": "I don't know what the hell you gave me.",
      "emotion": "angry",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "tyoshcha",
      "text": "My farts are still silent, but my God, they stink!",
      "emotion": "angry",
      "pauseAfterSec": 0.6,
      "enter": [],
      "exit": []
    },
    {
      "id": "l9",
      "character": "doktor",
      "text": "Excellent. Now that your sinuses are cleared, let's work on your hearing.",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
