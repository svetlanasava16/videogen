    "zhena": "wife",
    "muzhik": "customer"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "A woman is riding a bus in Odessa, talking on her cell phone.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "zhena",
      "text": "And can you imagine, Sophie, I walk into our bedroom, and there he is, rolling around with the neighbour on our bed!",
      "emotion": "surprised",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "zhena",
      "text": "So I tiptoe into the kitchen and grab...",
      "emotion": "smug",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "zhena",
      "text": "Oh, Sophie, this is my stop! I'll take the bus home from work at six and tell you the rest.",
      "emotion": "surprised",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "Six in the evening. The same woman gets on the bus, and the same faces are sitting there. Suddenly a man jumps in, out of breath.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l6",
      "character": "muzhik",
      "text": "Am I too late?",
      "emotion": "surprised",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l7",
      "character": "muzhik",
      "text": "Well, what are you staring at? Call Sophie.",
      "emotion": "angry",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
  "explicit": false,
