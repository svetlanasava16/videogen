  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "A bus in Odessa. A woman is chatting on her phone.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "devushka",
      "text": "And can you imagine, Sophie, I walk into our bedroom, and there he is with the neighbor, in our bed!",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "devushka",
      "text": "So I tiptoe into the kitchen, and I grab...",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "devushka",
      "text": "Oh, Sophie, this is my stop! I'll ride home from work at six and tell you the rest.",
      "emotion": "surprised",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": [
        "devushka"
      ]
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "Six in the evening. Same woman, same bus, all the same faces.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [
        "devushka"
      ],
      "exit": []
    },
    {
      "id": "l6",
      "character": "muzhik",
      "text": "Did I miss it?",
      "emotion": "surprised",
      "pauseAfterSec": 0.6,
      "enter": [
        "muzhik"
      ],
      "exit": []
    },
    {
      "id": "l7",
      "character": "muzhik",
      "text": "Well, what are you staring at? Call Sophie!",
      "emotion": "angry",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    }
  ],
