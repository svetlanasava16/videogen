  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Eine Frau geht mit fünfzehn Kindern in ein Restaurant.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Während sie mit der Kellnerin spricht, fangen die Kinder an herumzualbern.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "zhena",
      "text": "Eddy! Hör auf damit! Sonst gibt's was!",
      "emotion": "angry",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "narrator",
      "text": "Alle fünfzehn Jungen setzen sich sofort hin, brav und still.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "devushka",
      "text": "Haben Sie wirklich alle fünfzehn Jungen Eddy genannt?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "zhena",
      "text": "Jep. Das ist einfacher, als sich jedes verdammte Mal zu merken, wer wer ist.",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "devushka",
      "text": "Und wenn Sie aus irgendeinem Grund nur mit einem von ihnen reden wollen?",
      "emotion": "surprised",
      "pauseAfterSec": 0.7,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "zhena",
      "text": "Na, dann rufe ich sie einfach beim Nachnamen.",
      "emotion": "neutral",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
