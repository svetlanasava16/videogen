    {
      "id": "l1",
      "character": "narrator",
      "text": "Eine Frau kommt mit fünfzehn Jungs in ein Restaurant. Die toben wild herum.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [
        "vovochka",
        "zhena"
      ],
      "exit": []
    },
    {
      "id": "l2",
      "character": "zhena",
      "text": "Eddy! Sofort hinsetzen!",
      "emotion": "angry",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "Alle fünfzehn Jungs setzen sich auf der Stelle hin.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "barmen",
      "text": "Moment, die heißen alle Eddy?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "zhena",
      "text": "Klar. Dann muss ich mir nicht merken, wer wer ist.",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "barmen",
      "text": "Und wenn Sie nur einen von ihnen meinen?",
      "emotion": "surprised",
      "pauseAfterSec": 0.7,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "zhena",
      "text": "Dann rufe ich ihn beim Nachnamen.",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    }
  ],
