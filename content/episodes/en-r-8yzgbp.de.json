  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Eine bildhübsche junge Brünette kommt in die Arztpraxis.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [
        "devushka-blondinka"
      ],
      "exit": []
    },
    {
      "id": "l2",
      "character": "devushka-blondinka",
      "text": "Herr Doktor, mir tut der ganze Körper weh, egal wo ich ihn berühre.",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "doktor",
      "text": "Unmöglich! Zeigen Sie mal.",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "narrator",
      "text": "Sie nahm ihren Finger und drückte auf ihr linkes Handgelenk.",
      "emotion": "neutral",
      "pauseAfterSec": 0.2,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "devushka-blondinka",
      "text": "Au!",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "Dann drückte sie auf ihren Ellbogen.",
      "emotion": "neutral",
      "pauseAfterSec": 0.2,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "devushka-blondinka",
      "text": "Au, au, au!",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "narrator",
      "text": "Sie drückte auf ihr Knie, dann auf ihren Knöchel.",
      "emotion": "neutral",
      "pauseAfterSec": 0.2,
      "enter": [],
      "exit": []
    },
    {
      "id": "l9",
      "character": "devushka-blondinka",
      "text": "Au! Au!",
      "emotion": "sad",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l10",
      "character": "doktor",
      "text": "Sie sind gar keine echte Brünette, oder?",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l11",
      "character": "devushka-blondinka",
      "text": "Na ja, nein. Eigentlich bin ich blond.",
      "emotion": "surprised",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    },
    {
      "id": "l12",
      "character": "doktor",
      "text": "Dachte ich mir. Ihr Finger ist gebrochen.",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
