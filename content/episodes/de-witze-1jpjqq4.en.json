  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "On the way from the church to the cemetery, the funeral procession passes a lake where an angler is sitting.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "He sees the procession, stands up, takes off his hat and bows to it.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "After the burial, the priest passes the lake again on his way back.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "batyushka",
      "text": "That gesture from the angler was wonderful, I must tell him so.",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "batyushka",
      "text": "Your gesture earlier really impressed me.",
      "emotion": "happy",
      "pauseAfterSec": 0.6,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "muzhik-ryzhy",
      "text": "Oh, you know, Father, after thirty years of marriage...",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
