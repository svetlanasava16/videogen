    {
      "id": "l1",
      "character": "narrator",
      "text": "A man downs beer after beer at a bar. When he tries to leave, he falls off his stool and can't get back up.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "So he crawls all the way home, slips quietly into bed, and his wife never wakes up.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4,
      "enter": [
        "muzhik"
      ],
      "exit": []
    },
    {
      "id": "l3",
      "character": "zhena",
      "text": "You were at that bar again, getting plastered!",
      "emotion": "angry",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "How on earth did you find out?",
      "emotion": "surprised",
      "pauseAfterSec": 0.7,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "zhena",
      "text": "The bartender called this morning. You left your wheelchair there again.",
      "emotion": "angry",
      "pauseAfterSec": 0.8,
