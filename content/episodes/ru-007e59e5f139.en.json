    {
      "id": "l1",
      "character": "narrator",
      "text": "A man is walking along a lake. Some guy is scooping up the water with his hand and drinking it.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [
        "muzhik"
      ],
      "exit": []
    },
    {
      "id": "l2",
      "character": "muzhik",
      "text": "Hey, are you drinking that?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "muzhik",
      "text": "Everybody dumps their trash here! The factory pours its waste in! The whole village's sewage ends up in this lake!",
      "emotion": "angry",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "muzhik-sosed",
      "text": "Pardon, monsieur? Qu'est-ce que vous dites?",
      "emotion": "surprised",
      "pauseAfterSec": 0.7,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "muzhik",
      "text": "I said, use both hands!",
