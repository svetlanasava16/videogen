    {
      "id": "l1",
      "character": "narrator",
      "text": "A man is walking along the lake shore and sees some guy scooping up lake water with his hand and drinking it. The man shouts:",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "muzhik",
      "text": "Why are you drinking this dirty water?",
      "emotion": "angry",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "muzhik",
      "text": "Everybody dumps their trash here, the factories pour their waste in, and all the crap from the whole village drains in here!",
      "uncensored": "Everybody dumps their trash here, the factories pour their waste in, and all the shit from the whole village drains in here!",
      "emotion": "angry",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "inostranets",
      "text": "Pardon? Qu'est-ce que vous avez dit?",
      "emotion": "surprised",
      "pauseAfterSec": 0.7,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "muzhik",
      "text": "I said: scoop with both hands!",
      "emotion": "happy",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
