{
  "id": "ru-e30eafa1a0e6.en",
  "jokeId": "ru-e30eafa1a0e6",
  "locale": "en",
  "title": "The Matchbox",
  "location": "gostinaya",
  "place": "hospital",
  "cast": [
    "muzhik",
    "zhena"
  ],
  "roles": {
    "muzhik": "husband",
    "zhena": "wife"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "A man went to hand in a stool sample. He put it in a matchbox and set off for the clinic.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": [
        "muzhik"
      ]
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "And vanished... For three days he's nowhere to be found.",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "His wife is going out of her mind, she's called everyone she possibly could, he's nowhere.",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "zhena",
      "text": "Well, I'll go to the clinic, maybe somebody there knows something.",
      "emotion": "sad",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "She gets there, but nobody there has a clue either.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "tyoshcha",
      "text": "Have a look in the surgical ward, some man's been sitting there for ages, maybe he's yours?",
      "emotion": "neutral",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "narrator",
      "text": "The wife goes there. She looks, and her husband is sitting there, all in plaster.",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "zhena",
      "text": "Joe, how could this happen, who did this to you?",
      "emotion": "surprised",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l9",
      "character": "muzhik",
      "text": "I don't remember a thing.",
      "emotion": "sad",
      "pauseAfterSec": 0.7,
      "enter": [],
      "exit": []
    },
    {
      "id": "l10",
      "character": "muzhik",
      "text": "All I remember is, someone asked me for matches...",
      "emotion": "sad",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
