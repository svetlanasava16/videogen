  "locale": "en",
  "title": "Just Like Mother",
  "location": "bar",
  "place": "bar",
  "cast": [
    "muzhik",
    "muzhik-sosed"
  ],
  "roles": {
    "muzhik": "everyman",
    "muzhik-sosed": "friend"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Andy is thirty-nine and, unlike his friends, still not married.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "muzhik-sosed",
      "text": "Why is that?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "muzhik",
      "text": "Well, whenever I bring a woman home, my mother can't stand her.",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "muzhik-sosed",
      "text": "Why don't you try a woman who's like your mother?",
      "emotion": "smug",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "Three weeks later they meet again.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "muzhik-sosed",
      "text": "Any progress?",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "muzhik",
      "text": "Yes, I met a woman who's like my mother, and I brought her home, and they got along.",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "muzhik-sosed",
      "text": "So you two are together?",
      "emotion": "happy",
      "pauseAfterSec": 0.6,
      "enter": [],
      "exit": []
    },
    {
      "id": "l9",
      "character": "muzhik",
      "text": "No, my father can't stand her.",
      "emotion": "sad",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
  "explicit": false,
