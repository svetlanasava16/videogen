  "lines": [
    {
      "id": "l1",
      "character": "muzhik",
      "text": "Son, why did you tell the whole class that the math teacher and the PE teacher were kissing at the movies?",
      "emotion": "angry",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "vovochka",
      "text": "She asked me to do it herself.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "muzhik",
      "text": "What do you mean, herself?",
      "emotion": "surprised",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l4",
      "character": "vovochka",
      "text": "She told me: Johnny, you're always laughing in the back row!",
      "emotion": "smug",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l4b",
      "character": "vovochka",
      "text": "Tell everyone, so we can laugh too!",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
