  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein katholischer Priester, ein evangelischer Pfarrer und ein jüdischer Rabbi diskutieren darüber, wann der Beginn des Lebens ist.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "batyushka",
      "text": "Das Leben beginnt mit der Zeugung!",
      "emotion": "angry",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "batyushka-molodoy",
      "text": "Unsinn, das Leben beginnt mit der Geburt!",
      "emotion": "angry",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l4",
      "character": "batyushka-ravvin",
      "text": "Werte Kollegen, Sie haben ja keine Ahnung.",
      "emotion": "smug",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l5",
      "character": "batyushka-ravvin",
      "text": "Das Leben beginnt, wenn die Kinder aus dem Haus sind.",
      "emotion": "happy",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
