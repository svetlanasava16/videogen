    "vovochka": "fritzchen"
  },
  "lines": [
    {
      "id": "l1",
      "character": "muzhik",
      "text": "Sohn, warum hast du der ganzen Klasse erzählt,",
      "emotion": "angry",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l1b",
      "character": "muzhik",
      "text": "dass sich die Mathelehrerin und der Sportlehrer im Kino geküsst haben?",
      "emotion": "angry",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "vovochka",
      "text": "Sie hat mich selbst darum gebeten.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "muzhik",
      "text": "Wie, selbst?",
      "emotion": "surprised",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l4",
      "character": "vovochka",
      "text": "Sie hat zu mir gesagt: Fritzchen, du lachst die ganze Zeit in der letzten Bank!",
      "emotion": "smug",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l4b",
      "character": "vovochka",
      "text": "Erzähl es allen, dann lachen wir auch!",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
