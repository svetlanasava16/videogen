  ],
  "roles": {
    "muzhik": "husband",
    "kot": "cat",
    "zhena": "wife"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "A man had a cat.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Maybe the tomcat had just got too old, maybe he'd stolen the sour cream,",
      "emotion": "neutral",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l2b",
      "character": "narrator",
      "text": "but the man's wife ordered him to carry it far into the forest and leave it there to its fate.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "Nothing to be done, the man carried the cat into the forest.",
      "emotion": "sad",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "narrator",
      "text": "And vanished himself.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "One day he's gone, two days gone, on the third day the cat shows up at home.",
      "emotion": "neutral",
      "pauseAfterSec": 0.2
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "And right behind it, the man: dirty, angry and hungry.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l7",
      "character": "zhena",
      "text": "Well, you moron, did you take the cat to the forest?",
      "emotion": "angry",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l8",
      "character": "muzhik",
      "text": "Yeah, I took it, dammit!",
      "emotion": "angry",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l8b",
      "character": "muzhik",
      "text": "And if I hadn't followed it, I'd have gotten lost as hell...",
      "emotion": "angry",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
  "explicit": false,
