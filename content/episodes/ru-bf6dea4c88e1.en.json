  "title": "The Juicy Lawn",
  "location": "doroga",
  "place": "car",
  "cast": [
    "muzhik",
    "nachalnik"
  ],
  "roles": {
    "muzhik": "homeless",
    "nachalnik": "new-russian"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "So, this rich guy is driving his Mercedes and sees a homeless man chewing grass on a lawn.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "nachalnik",
      "text": "What are you doing, man?! Have you lost your mind?!",
      "emotion": "angry",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "muzhik",
      "text": "I haven't eaten for three days, kind sir! So I'm chewing a bit of grass at least!",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "nachalnik",
      "text": "Oh, you poor thing! Come on, hop in! I'm feeling generous today! You're coming with me!",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "So off they drive.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "muzhik",
      "text": "Thank you, kind man! People are wrong when they say the rich are greedy!",
      "emotion": "happy",
      "pauseAfterSec": 0.7,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "nachalnik",
      "text": "Don't mention it, bro! We'll be at my villa in a minute, you'll see for yourself how juicy and uncut my lawn is!",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
