  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein hochbetagtes Ehepaar, beide weit über hundert Jahre alt, sitzt beim Anwalt.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "tyoshcha",
      "text": "Wir wollen uns scheiden lassen.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "nachalnik",
      "text": "Nach so langer Ehe und in dem hohen Alter wollen Sie sich noch scheiden lassen?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "nachalnik",
      "text": "Haben Sie sich das gut überlegt?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "tyoshcha",
      "text": "Ja, haben wir schon lange.",
      "emotion": "neutral",
      "pauseAfterSec": 0.6,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "tyoshcha",
      "text": "Wir wollten nur noch warten, bis die Kinder tot sind.",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
