    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein Ehepaar, beide weit über hundert, sitzt beim Anwalt.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "ded",
      "text": "Wir wollen uns scheiden lassen.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "nachalnik",
      "text": "Wie bitte? Nach so langer Ehe? In Ihrem Alter?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "nachalnik",
      "text": "Haben Sie sich das gut überlegt?",
      "emotion": "surprised",
      "pauseAfterSec": 0.7,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "tyoshcha",
      "text": "Ja, schon lange. Wir wollten nur noch warten, bis die Kinder tot sind.",
      "emotion": "smug",
