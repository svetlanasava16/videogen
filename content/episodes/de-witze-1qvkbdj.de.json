    {
      "id": "l1",
      "character": "barmen",
      "text": "Sehen Sie den Kleinen da? Der dümmste Junge der Welt. Passen Sie auf.",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [
        "vovochka"
      ],
      "exit": []
    },
    {
      "id": "l2",
      "character": "barmen",
      "text": "Na, mein Junge, hier ein Fünf-Euro-Schein, da zwei Euromünzen. Was möchtest du?",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "vovochka",
      "text": "Die Münzen, bitte!",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": [
        "vovochka"
      ]
    },
    {
      "id": "l4",
      "character": "barmen",
      "text": "Was hab ich gesagt? Der lernt es nie!",
      "emotion": "smug",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "Später trifft der Kunde den Jungen vor der Eisdiele.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [
        "vovochka"
      ],
      "exit": []
    },
    {
      "id": "l6",
      "character": "muzhik",
      "text": "Sag mal, warum nimmst du immer die Münzen und nicht den Schein?",
      "emotion": "surprised",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "vovochka",
      "text": "Weil das Spiel vorbei ist, sobald ich den Schein nehme.",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    }
  ],
