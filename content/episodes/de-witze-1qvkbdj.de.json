  "locale": "de",
  "title": "Der dümmste Junge",
  "kind": "joke",
  "v": 2,
  "location": "magazin",
  "place": "barbershop",
  "cast": [
    "muzhik",
    "barmen",
    "vovochka"
  ],
  "roles": {
    "muzhik": "customer",
    "vovochka": "child",
    "barmen": "craftsman"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein kleiner Junge betritt einen Friseursalon.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "barmen",
      "text": "Das ist der dümmste Junge der Welt. Ich werde es Ihnen beweisen.",
      "emotion": "smug",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "Der Friseur nimmt einen Dollarschein in die eine Hand und zwei Vierteldollarstücke in die andere und ruft den Jungen zu sich.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "barmen",
      "text": "Was möchtest du, mein Junge?",
      "emotion": "happy",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "Der Junge nimmt die Vierteldollarstücke und geht.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l6",
      "character": "barmen",
      "text": "Was habe ich dir gesagt? Dieser Junge lernt nie dazu!",
      "emotion": "smug",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l7",
      "character": "narrator",
      "text": "Später, als der Kunde geht, sieht er denselben Jungen aus der Eisdiele kommen.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l8",
      "character": "muzhik",
      "text": "Hey, mein Junge! Darf ich dir eine Frage stellen?",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l9",
      "character": "muzhik",
      "text": "Warum hast du die Vierteldollar-Münzen genommen statt den Dollarschein?",
      "emotion": "surprised",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l10",
      "character": "vovochka",
      "text": "Weil das Spiel vorbei ist, sobald ich den Dollar nehme!",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
