      ],
      "exit": []
    },
    {
      "id": "l2",
      "character": "uchilka",
      "text": "That's deadly poison! I can't sell you that.",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "muzhik",
      "text": "But I want to poison my wife!",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "uchilka",
      "text": "Are you crazy? I'm calling the police!",
      "emotion": "angry",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "muzhik",
      "text": "Take a look at this photo. That's my wife. And the guy she's kissing, do you recognise him?",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "uchilka",
      "text": "That's... my husband!",
      "emotion": "surprised",
      "pauseAfterSec": 0.7,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "uchilka",
      "text": "Oh. Why didn't you say you had a prescription?",
      "emotion": "smug",
