  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Таможенники думают, что подарить коллеге на день рождения.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "sluzhivy",
      "text": "Может, шестисотый мерс подарим?",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "sluzhivy-ryadovoy",
      "text": "Есть уже. В прошлом году дарили.",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "sluzhivy-ryadovoy",
      "text": "Тогда бунгало на Канарах.",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "sluzhivy",
      "text": "Да есть у него бунгало.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "sluzhivy",
      "text": "Придумал! Пусть отработает целую смену один!",
      "emotion": "happy",
      "pauseAfterSec": 0.7,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "sluzhivy-ryadovoy",
      "text": "Ты что, обалдел? Такой дорогой подарок!",
      "emotion": "surprised",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    }
  ],
