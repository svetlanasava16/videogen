    "sluzhivy-ryadovoy": "customs-officer",
    "muzhik-ryzhy": "customs-officer"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Сидят три таможенника и думают, что подарить четвертому на день рождения.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "sluzhivy",
      "text": "Давайте подарим шестисотый мерс?",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "muzhik-ryzhy",
      "text": "Да не, у него уже есть, на прошлый день рождения подарили.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "sluzhivy-ryadovoy",
      "text": "Тогда давайте подарим бунгало на Канарах.",
      "emotion": "smug",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "sluzhivy",
      "text": "Да не, у него есть уже.",
      "emotion": "sad",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l6",
      "character": "muzhik-ryzhy",
      "text": "Придумал! Давайте в подарок оставим его одного работать всю смену!",
      "emotion": "happy",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l7",
      "character": "sluzhivy-ryadovoy",
      "text": "Да ты че, обалдел, такой дорогой подарок дарить!",
      "emotion": "angry",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
