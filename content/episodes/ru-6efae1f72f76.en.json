{
  "id": "ru-6efae1f72f76.en",
  "jokeId": "ru-6efae1f72f76",
  "locale": "en",
  "title": "The Third Wish",
  "kind": "joke",
  "v": 2,
  "location": "kukhnya",
  "place": "home-kitchen",
  "cast": [
    "muzhik",
    "chort"
  ],
  "roles": {
    "muzhik": "everyman",
    "chort": "genie"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "A man is sitting in his kitchen, smoking. Suddenly a genie appears out of the ashtray.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "chort",
      "text": "Well, and now for your third wish.",
      "emotion": "smug",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "muzhik",
      "text": "Why start with the third? There was no first or second!",
      "emotion": "surprised",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "chort",
      "text": "You just don't remember anything! Your second wish was to make everything exactly the way it was before the first wish.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "chort",
      "text": "That's why you can't remember anything about me.",
      "emotion": "smug",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l6",
      "character": "muzhik",
      "text": "Okay then, let me think... Ah, I want to become the most irresistible man to all women!",
      "emotion": "happy",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l7",
      "character": "narrator",
      "text": "The genie snaps his fingers.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l8",
      "character": "chort",
      "text": "Done!",
      "emotion": "happy",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l9",
      "character": "chort",
      "text": "By the way, that was exactly your first wish too...",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
