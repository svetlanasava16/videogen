  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Three boys are sitting on a wall, bragging about their dads.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "vovochka-drug",
      "text": "My dad is a Formula One driver. He's so fast, when he steps on the gas, the asphalt burns!",
      "emotion": "happy",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l3",
      "character": "paren",
      "text": "Pfft, my dad is a jet pilot. He's so fast, he overtakes his own sound!",
      "emotion": "smug",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l4",
      "character": "vovochka",
      "text": "Amateurs, all of you. My dad is a government worker.",
      "emotion": "neutral",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l5",
      "character": "vovochka",
      "text": "He works until five, but he's already home by four.",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
