    },
    {
      "id": "l2",
      "character": "paren",
      "text": "My dad's a Formula One driver. When he hits the gas, the asphalt catches fire!",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "devochka",
      "text": "So what? My dad's a jet pilot. He's so fast he outruns his own sonic boom!",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "vovochka",
      "text": "Amateurs. My dad works for the government.",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "vovochka",
      "text": "He works till five, but he's home by four.",
      "emotion": "smug",
