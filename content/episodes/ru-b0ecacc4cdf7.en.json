{
  "id": "ru-b0ecacc4cdf7.en",
  "jokeId": "ru-b0ecacc4cdf7",
  "locale": "en",
  "title": "Fear of Flying",
  "kind": "joke",
  "v": 2,
  "location": "samolet",
  "place": "plane",
  "cast": [
    "devushka-blondinka",
    "muzhik"
  ],
  "roles": {
    "devushka-blondinka": "flight-attendant",
    "muzhik": "customer"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Walking down the aisle of the plane, the flight attendant noticed a man drenched in sweat, shaking and biting his nails.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "devushka-blondinka",
      "text": "Maybe I could bring you a little glass of brandy, and you'll feel better?",
      "emotion": "happy",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "After an obvious struggle with himself, the man whispered:",
      "emotion": "neutral",
      "pauseAfterSec": 0.2
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "All right...",
      "emotion": "sad",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "Checking on the same passenger again, the flight attendant found him in an even worse state.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l6",
      "character": "devushka-blondinka",
      "text": "A second glass?",
      "emotion": "happy",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l7",
      "character": "narrator",
      "text": "The man said nothing and just nodded.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l8",
      "character": "narrator",
      "text": "When the flight attendant came back to the passenger a third time, he was sobbing uncontrollably.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l9",
      "character": "devushka-blondinka",
      "text": "I've never seen anyone so afraid of flying.",
      "emotion": "surprised",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l10",
      "character": "muzhik",
      "text": "I'm not afraid of flying at all, I'm trying to quit drinking!",
      "emotion": "sad",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
