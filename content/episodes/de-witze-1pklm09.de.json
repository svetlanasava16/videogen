  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Kommt ein Mann in die Apotheke.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "muzhik",
      "text": "Geben Sie mir bitte ein Fläschchen Arsen.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "uchilka",
      "text": "Das Zeug ist hochgiftig, so etwas darf ich nicht verkaufen!",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "Aber ich möchte doch meine Frau vergiften!",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "uchilka",
      "text": "Sie sind wohl verrückt! Das ist verboten, ich werde gleich die Polizei rufen!",
      "emotion": "angry",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "Der Mann holt ein Foto von seiner Frau heraus, die auf dem Bild gerade den Mann der Apothekerin küsst, und legt es auf den Tresen.",
      "emotion": "neutral",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "uchilka",
      "text": "Ach so, Sie haben ein Rezept dabei...",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
