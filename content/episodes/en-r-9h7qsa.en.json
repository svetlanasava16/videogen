      "id": "l1",
      "character": "narrator",
      "text": "A guy walks into a bar.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "muzhik",
      "text": "A beer, please.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "barmen",
      "text": "That'll be five dollars.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "narrator",
      "text": "The guy throws twenty quarters onto the floor. Reluctantly, the bartender picks up the coins and serves the beer.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "The next day, the guy comes into the bar, asks for a beer, and throws twenty quarters onto the floor.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "The next day, again.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "narrator",
      "text": "On the fourth day, he asks for a beer, and hands the bartender a ten-dollar bill.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "narrator",
      "text": "The bartender takes advantage of his chance for revenge, throws twenty quarters onto the floor and yells:",
      "emotion": "smug",
      "pauseAfterSec": 0.2,
      "enter": [],
      "exit": []
    },
    {
      "id": "l9",
      "character": "barmen",
      "text": "Here's your change, jerk!",
      "uncensored": "Here's your change, asshole!",
      "emotion": "angry",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "chuckle"
    },
    {
      "id": "l10",
      "character": "muzhik",
      "text": "I'll have another beer, please.",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
