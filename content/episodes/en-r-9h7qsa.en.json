  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "A guy walks into a bar and asks for a beer.",
      "emotion": "neutral",
      "pauseAfterSec": 0
    },
    {
      "id": "l2",
      "character": "barmen",
      "text": "That'll be five dollars.",
      "emotion": "neutral",
      "pauseAfterSec": 0
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "Says the bartender, and the guy throws twenty quarters onto the floor.",
      "emotion": "neutral",
      "pauseAfterSec": 0
    },
    {
      "id": "l4",
      "character": "narrator",
      "text": "Reluctantly, the bartender picks up the coins",
      "emotion": "neutral",
      "pauseAfterSec": 0
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "and serves the beer.",
      "emotion": "neutral",
      "pauseAfterSec": 0
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "The next day, the guy comes into the bar, asks for a beer,",
      "emotion": "neutral",
      "pauseAfterSec": 0
    },
    {
      "id": "l7",
      "character": "narrator",
      "text": "throws twenty quarters onto the floor, et cetera.",
      "emotion": "neutral",
      "pauseAfterSec": 0
    },
    {
      "id": "l8",
      "character": "narrator",
      "text": "The next day, again.",
      "emotion": "neutral",
      "pauseAfterSec": 0
    },
    {
      "id": "l9",
      "character": "narrator",
      "text": "On the fourth day, he asks for a beer,",
      "emotion": "neutral",
      "pauseAfterSec": 0
    },
    {
      "id": "l10",
      "character": "narrator",
      "text": "and hands the bartender a ten-dollar bill.",
      "emotion": "neutral",
      "pauseAfterSec": 0
    },
    {
      "id": "l11",
      "character": "narrator",
      "text": "The bartender takes advantage of his chance for revenge,",
      "emotion": "smug",
      "pauseAfterSec": 0
    },
    {
      "id": "l12",
      "character": "narrator",
      "text": "throws twenty quarters onto the floor and yells:",
      "emotion": "neutral",
      "pauseAfterSec": 0
    },
    {
      "id": "l13",
      "character": "barmen",
      "text": "Here's your change, jerk!",
      "uncensored": "Here's your change, asshole!",
      "emotion": "angry",
      "pauseAfterSec": 0
    },
    {
      "id": "l14",
      "character": "narrator",
      "text": "The guy looks down at the coins and says:",
      "emotion": "neutral",
      "pauseAfterSec": 0
    },
    {
      "id": "l15",
      "character": "muzhik",
      "text": "I'll have another beer, please.",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
