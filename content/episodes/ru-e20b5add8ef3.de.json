  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Eine Frau ruft ihren Mann bei der Arbeit an, um ein bisschen zu plaudern.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "muzhik",
      "text": "Tut mir leid, Schatz, aber ich stecke heute bis zum Hals in Arbeit.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "zhena",
      "text": "Aber, Liebling, ich habe Neuigkeiten für dich: eine gute und eine schlechte.",
      "emotion": "happy",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "Na gut, ich habe jetzt keine Zeit, sag mir nur die gute Neuigkeit.",
      "emotion": "angry",
      "pauseAfterSec": 0.6,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "zhena",
      "text": "Tja... also... der Airbag funktioniert.",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
