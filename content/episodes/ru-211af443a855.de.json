  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "In einem Spielzeugladen erkundigt sich ein Kunde nach Barbie-Puppen.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "barmen",
      "text": "Das ist Barbie im Schwimmbad, achtzehn Euro neunundneunzig.",
      "emotion": "happy",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "barmen",
      "text": "Das ist Barbie im College, achtzehn Euro neunundneunzig.",
      "emotion": "happy",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "barmen",
      "text": "Und das ist die geschiedene Barbie, hundertneunundneunzig Euro neunundneunzig.",
      "emotion": "smug",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "muzhik",
      "text": "Wie viel?!",
      "emotion": "surprised",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l6",
      "character": "barmen",
      "text": "Im Set „Geschiedene Barbie“ sind Kens Haus, Kens Auto und Kens Hubschrauber mit dabei.",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
