  "lines": [
    {
      "id": "l1",
      "character": "muzhik",
      "text": "Jungs, ist das euer Bullterrier, der hier rumläuft?!",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "nachalnik",
      "text": "Ja, unserer. Und was willst du, verdammt?",
      "emotion": "angry",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "muzhik",
      "text": "Wissen Sie, wir machen hier in der Nähe auch Picknick, und mein Hündchen hat aus Versehen euren totgemacht!",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "muzhik-ryzhy",
      "text": "Verdammter Mist!? Was hast du denn für ein Vieh?",
      "uncensored": "Verdammte Scheiße!? Was hast du denn für ein Vieh?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "muzhik",
      "text": "Ach, so ein kleiner Pudel!",
      "emotion": "neutral",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "muzhik",
      "text": "Eurer hat sich an ihm verschluckt!",
      "emotion": "sad",
      "pauseAfterSec": 0.8,
