{
  "id": "en-r-f9y2jy.de",
  "jokeId": "en-r-f9y2jy",
  "locale": "de",
  "title": "Der Zaubertrick",
  "location": "magazin",
  "place": "shop",
  "cast": [
    "muzhik-sosed",
    "muzhik-ryzhy",
    "barmen"
  ],
  "roles": {
    "muzhik-sosed": "customer",
    "muzhik-ryzhy": "customer",
    "barmen": "cook"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein Engländer und ein Ire gehen in eine Bäckerei.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Der Engländer klaut drei Brötchen, steckt sie in seine Taschen und geht. Er sagt zum Iren:",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "muzhik-sosed",
      "text": "Es hat großes Geschick und viel List gebraucht, diese Brötchen zu klauen. Der Besitzer hat mich nicht mal gesehen.",
      "emotion": "smug",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "muzhik-ryzhy",
      "text": "Das ist einfach nur Diebstahl.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "muzhik-ryzhy",
      "text": "Ich zeige dir, wie man es auf die ehrliche Art macht und dasselbe Ergebnis bekommt.",
      "emotion": "smug",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "Dann ruft der Ire den Besitzer der Bäckerei herbei.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "muzhik-ryzhy",
      "text": "Mein Herr, ich möchte Ihnen einen Zaubertrick zeigen.",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "narrator",
      "text": "Der Besitzer war neugierig und kam herüber, um sich den Zaubertrick anzusehen.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l9",
      "character": "narrator",
      "text": "Der Ire bat ihn um ein Brötchen und aß es dann auf.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l10",
      "character": "narrator",
      "text": "Er bat noch zweimal darum, und nachdem er auch die aufgegessen hatte, sagt der Besitzer:",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l11",
      "character": "barmen",
      "text": "Also gut, mein Freund, wo ist der Zaubertrick?",
      "emotion": "surprised",
      "pauseAfterSec": 0.7,
      "enter": [],
      "exit": []
    },
    {
      "id": "l12",
      "character": "muzhik-ryzhy",
      "text": "Schauen Sie in die Taschen des Engländers.",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
