  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Zwei Kumpel in einer Bäckerei. Der eine steckt heimlich drei Brötchen ein.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "vor",
      "text": "Siehst du? Drei Brötchen, und der Bäcker hat nichts gemerkt. Das nennt man Können.",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "muzhik",
      "text": "Das ist bloß Diebstahl. Ich zeig dir, wie man das ehrlich macht.",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "Herr Bäcker! Ich möchte Ihnen einen Zaubertrick zeigen!",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "barmen",
      "text": "Ein Zaubertrick? Na, da bin ich gespannt.",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [
        "barmen"
      ],
      "exit": []
    },
    {
      "id": "l6",
      "character": "muzhik",
      "text": "Geben Sie mir ein Brötchen. Und noch eins. Und noch eins.",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "barmen",
      "text": "Jetzt haben Sie drei Brötchen aufgegessen. Wo ist denn der Trick?",
      "emotion": "angry",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "muzhik",
      "text": "Schauen Sie mal in seine Taschen.",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    }
  ],
