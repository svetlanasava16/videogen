{
  "id": "en-r-f9y2jy.de",
  "jokeId": "en-r-f9y2jy",
  "locale": "de",
  "title": "Der Zaubertrick",
  "location": "magazin",
  "place": "shop",
  "cast": [
    "muzhik-ryzhy",
    "vor",
    "barmen"
  ],
  "roles": {
    "muzhik-ryzhy": "customer",
    "vor": "thief",
    "barmen": "cook"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein Engländer und ein Ire gehen in eine Bäckerei. Der Engländer klaut drei Brötchen und steckt sie in seine Taschen.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "vor",
      "text": "Es hat großes Geschick und viel List gebraucht, diese Brötchen zu klauen. Der Besitzer hat mich nicht mal gesehen.",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "muzhik-ryzhy",
      "text": "Das ist doch nur gewöhnlicher Diebstahl. Ich zeige dir, wie man es auf die ehrliche Art macht und dasselbe erreicht.",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "muzhik-ryzhy",
      "text": "Mein Herr, ich möchte Ihnen einen Zaubertrick zeigen.",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "Der Besitzer wurde neugierig und kam herüber, um sich den Zaubertrick anzusehen.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "Der Ire bat ihn um ein Brötchen und aß es auf. Er bat noch zwei weitere Male, und als er auch die gegessen hatte, sagte der Besitzer:",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "barmen",
      "text": "Okay, mein Freund, wo ist denn jetzt der Zaubertrick?",
      "emotion": "surprised",
      "pauseAfterSec": 0.7,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "muzhik-ryzhy",
      "text": "Schauen Sie mal in die Taschen des Engländers.",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
