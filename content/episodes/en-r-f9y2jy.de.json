  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein Engländer und ein Ire gehen in eine Bäckerei. Der Engländer klaut drei Brötchen und steckt sie in seine Taschen.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "vor",
      "text": "Es hat großes Geschick und List gebraucht, diese Brötchen zu klauen. Der Besitzer hat mich nicht mal gesehen.",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "muzhik",
      "text": "Das ist einfach nur Diebstahl.",
      "emotion": "neutral",
      "pauseAfterSec": 0.2,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "Ich zeig dir, wie man das auf die ehrliche Art macht und dasselbe Ergebnis bekommt.",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "muzhik",
      "text": "Mein Herr, ich möchte Ihnen einen Zaubertrick zeigen.",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "Der Bäcker ist neugierig und kommt herüber.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [
        "barmen"
      ],
      "exit": []
    },
    {
      "id": "l7",
      "character": "muzhik",
      "text": "Darf ich ein Brötchen haben?",
      "emotion": "happy",
      "pauseAfterSec": 0.2,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "narrator",
      "text": "Und er isst es auf.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l9",
      "character": "muzhik",
      "text": "Noch eins, bitte.",
      "emotion": "happy",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l10",
      "character": "muzhik",
      "text": "Und noch eins.",
      "emotion": "happy",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l11",
      "character": "barmen",
      "text": "Na gut, mein Freund, wo ist denn jetzt der Zaubertrick?",
      "emotion": "surprised",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    },
    {
      "id": "l12",
      "character": "muzhik",
      "text": "Schauen Sie in die Taschen des Engländers.",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
