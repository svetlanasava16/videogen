  "locale": "ru",
  "title": "Цыплята",
  "kind": "joke",
  "v": 2,
  "location": "magazin",
  "place": "shop",
  "cast": [
    "barmen",
    "muzhik"
  ],
  "roles": {
    "barmen": "salesman",
    "muzhik": "customer"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Приходит мужчина в зоомагазин.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "muzhik",
      "text": "Добрый день, мне сто цыплят.",
      "emotion": "happy",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "Продавец удивляется, что он будет делать со всеми этими цыплятами, но пока ничего не говорит и продаёт их ему.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "narrator",
      "text": "Через пару дней мужчина снова стоит в магазине.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "muzhik",
      "text": "Добрый день, ещё сто цыплят, пожалуйста.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "Так повторяется ещё несколько раз, пока хозяин магазина наконец не спрашивает в недоумении:",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l7",
      "character": "barmen",
      "text": "Да скажите же, что вы делаете со всеми этими цыплятами?",
      "emotion": "surprised",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l8",
      "character": "muzhik",
      "text": "Да я и сам не знаю!",
      "emotion": "sad",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l8b",
      "character": "muzhik",
      "text": "То ли я сажаю их слишком глубоко, то ли слишком близко друг к другу!",
      "emotion": "sad",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
