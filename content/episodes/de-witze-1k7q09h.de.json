  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Zwei Typen sitzen im fünfundvierzigsten Stock eines Wolkenkratzers an der Bar und lassen sich volllaufen.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "paren",
      "text": "Jetsch habm wir beie schon sooooo viel getrungn, wir könn fliegn.",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": [
        "paren"
      ]
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "Er öffnet ein Fenster, springt raus, fliegt eine Runde um das Gebäude und kommt wieder rein.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "paren",
      "text": "Jetsch du!",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [
        "paren"
      ],
      "exit": []
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "Der andere ist immer noch total verblüfft wegen dem, was er gerade gesehen hat, aber in seinem Zustand auch total motiviert.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": [
        "muzhik"
      ]
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "Er geht zum Fenster, springt raus und… stürzt in den Tod.",
      "emotion": "sad",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "barmen",
      "text": "Sobald du betrunken bist, wirst du echt zum Ekel, Superman.",
      "uncensored": "Sobald du betrunken bist, wirst du echt zum Arsch, Superman.",
      "emotion": "neutral",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
