  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "In der Pause sieht die Lehrerin, wie Fritzchen die ganze Zeit andere Kinder ärgert, indem er hässliche Grimassen und Fratzen zieht.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "uchilka",
      "text": "Als ich so alt war wie du, hat mein Lehrer in der Sonntagsschule mich gewarnt,",
      "emotion": "angry",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l2b",
      "character": "uchilka",
      "text": "dass mein Gesicht beim Grimassenziehen einfach einfrieren kann und dann für immer so bleibt.",
      "emotion": "angry",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l3",
      "character": "vovochka",
      "text": "Nun, immerhin hat er Sie gewarnt.",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
