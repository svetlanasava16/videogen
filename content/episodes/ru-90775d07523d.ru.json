  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Идёт в институте лекция по ОБЖ.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "doktor",
      "text": "Вы — прораб на стройке.",
      "emotion": "neutral",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l2b",
      "character": "doktor",
      "text": "На ваших глазах с лесов падает и разбивается насмерть рабочий.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "doktor",
      "text": "Ваши первые действия?",
      "emotion": "neutral",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l4",
      "character": "paren",
      "text": "Вызвать скорую!",
      "emotion": "surprised",
      "pauseAfterSec": 0.2
    },
    {
      "id": "l5",
      "character": "devushka",
      "text": "Вызвать милицию!",
      "emotion": "surprised",
      "pauseAfterSec": 0.2
    },
    {
      "id": "l6",
      "character": "devushka-blondinka",
      "text": "Сообщить родственникам!",
      "emotion": "sad",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l7",
      "character": "doktor",
      "text": "Наденьте на труп каску и страховочный пояс, иначе милиция приедет за вами.",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
