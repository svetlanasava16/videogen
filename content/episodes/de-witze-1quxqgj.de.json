  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Sie treffen sich bei ihr.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "paren",
      "text": "Erzähl mir was, was ich noch nicht über dich weiß.",
      "emotion": "happy",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "devushka",
      "text": "Nun, ich bin dreißig und habe den Körper einer Achtzehnjährigen.",
      "emotion": "smug",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "paren",
      "text": "Beweis es!",
      "emotion": "happy",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l5",
      "character": "devushka",
      "text": "Nicht jetzt.",
      "emotion": "neutral",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l5b",
      "character": "devushka",
      "text": "Ich hab ihn in der Gefriertruhe in der Garage und es ist mir gerade zu dunkel und zu kalt, um hinzugehen.",
      "emotion": "neutral",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
