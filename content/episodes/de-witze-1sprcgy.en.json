  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "During a sale, a man is trying to get to the checkout with a few discounted items, but he doesn't stand a chance.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Every time he gets a little further forward in the crowd, the even pushier ladies shove him back again.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "At some point he's so fed up that he decides to use his elbows, and shortly after he's standing at the checkout.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "narrator",
      "text": "The ladies standing next to him are outraged.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "zhena",
      "text": "Can't you behave like a gentleman?",
      "emotion": "angry",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l6",
      "character": "muzhik",
      "text": "I've been trying that the whole time, madam.",
      "emotion": "neutral",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l7",
      "character": "muzhik",
      "text": "But when it got me nowhere, I started behaving like a lady.",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
