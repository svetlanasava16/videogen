  "lines": [
    {
      "id": "l1",
      "character": "sluzhivy-ryadovoy",
      "text": "Товарищ сержант, проснитесь! Утро уже!",
      "emotion": "surprised",
      "pauseAfterSec": 0
    },
    {
      "id": "l2",
      "character": "sluzhivy",
      "text": "Сидоров? Я живой? И на своём перекрёстке?",
      "emotion": "surprised",
      "pauseAfterSec": 0
    },
    {
      "id": "l3",
      "character": "sluzhivy-ryadovoy",
      "text": "Так точно, живой. А вон нарушитель летит!",
      "emotion": "neutral",
      "pauseAfterSec": 0
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "Петренко, не свисти! У меня жена рожает!",
      "emotion": "angry",
      "pauseAfterSec": 0
    },
    {
      "id": "l5",
      "character": "sluzhivy",
      "text": "Проезжай, Вася! Я теперь людям только добро делаю.",
      "emotion": "happy",
      "pauseAfterSec": 0.8
    }
  ],
