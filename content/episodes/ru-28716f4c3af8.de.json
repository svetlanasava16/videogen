  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein frecher junger Mann kommt in die Kirche und ohrfeigt den Pfarrer.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [
        "muzhik"
      ],
      "exit": []
    },
    {
      "id": "l2",
      "character": "muzhik",
      "text": "Na, Hochwürden? Es steht doch geschrieben: Wer dich auf die rechte Wange schlägt, dem halte auch die linke hin.",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "Der Pfarrer, ehemaliger Boxmeister, schickt ihn mit einem linken Haken in die Ecke.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "batyushka",
      "text": "Es steht auch geschrieben: Mit dem Maß, mit dem ihr messt, wird euch zugemessen werden.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "Die erschrockenen Gemeindemitglieder fragen den Diakon, was da los ist.",
      "emotion": "neutral",
      "pauseAfterSec": 0.7,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "batyushka-molodoy",
      "text": "Wir legen das Evangelium aus.",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    }
  ],
