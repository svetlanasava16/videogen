  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Stirlitz, der sowjetische Spion, kam in eine vertraute Kneipe, um seinen Verbindungsmann zu treffen, und bestellte einen doppelten Wodka.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "barmen",
      "text": "Der Wodka ist uns leider schon vor zwei Tagen ausgegangen.",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "sluzhivy",
      "text": "Na, dann einen doppelten Cognac.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "barmen",
      "text": "Der Cognac ist gestern ausgegangen.",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "sluzhivy",
      "text": "Na, aber Bier habt ihr doch?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "barmen",
      "text": "Leider seit heute Morgen alle.",
      "emotion": "sad",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "sluzhivy",
      "text": "Also ist mein Verbindungsmann schon da.",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
