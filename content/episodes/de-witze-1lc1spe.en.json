  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "A man in pain comes to the hospital. A doctor examines him.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "doktor",
      "text": "You have a serious illness.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "doktor",
      "text": "We'll have to keep you here and put you on a strict diet: pizza and fried eggs!",
      "emotion": "neutral",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "And that will make me better?",
      "emotion": "surprised",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l5",
      "character": "doktor",
      "text": "No idea, but it slides nicely under the door.",
      "emotion": "neutral",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
