  "title": "Der freie Platz",
  "location": "ulitsa",
  "place": "stadium",
  "cast": [
    "muzhik",
    "muzhik-ryzhy"
  ],
  "roles": {
    "muzhik": "everyman",
    "muzhik-ryzhy": "husband"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein Mann setzt sich beim WM-Finale auf seinen Platz.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Er schaut zur Seite und bemerkt, dass zwischen ihm und dem Nächsten ein Platz frei ist.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "muzhik",
      "text": "Wer verpasst denn bitte ein WM-Finale?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "muzhik-ryzhy",
      "text": "Nun, das war der Platz meiner Frau.",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "muzhik-ryzhy",
      "text": "Wir waren zusammen bei den letzten fünf WM-Endspielen, aber leider ist sie verstorben.",
      "emotion": "sad",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "muzhik",
      "text": "Das ist schrecklich, aber hätten Sie nicht ein anderes nahes Familienmitglied mitnehmen können?",
      "emotion": "sad",
      "pauseAfterSec": 0.6,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "muzhik-ryzhy",
      "text": "Nein. Die sind alle auf der Beerdigung.",
      "emotion": "neutral",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
