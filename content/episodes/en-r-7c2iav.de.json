  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Finale der Weltmeisterschaft. Ein Fan setzt sich und sieht, dass der Platz neben ihm frei ist.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "muzhik",
      "text": "Wer verpasst denn bitte ein Weltmeisterschaftsfinale?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [
        "muzhik"
      ],
      "exit": []
    },
    {
      "id": "l3",
      "character": "muzhik-ryzhy",
      "text": "Das war der Platz meiner Frau.",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "muzhik-ryzhy",
      "text": "Wir waren bei den letzten fünf Endspielen zusammen. Leider ist sie gestorben.",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "muzhik",
      "text": "Das tut mir leid. Aber hätte nicht jemand aus der Familie mitkommen können?",
      "emotion": "sad",
      "pauseAfterSec": 0.6,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "muzhik-ryzhy",
      "text": "Nein. Die sind alle auf der Beerdigung.",
      "emotion": "neutral",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    }
  ],
