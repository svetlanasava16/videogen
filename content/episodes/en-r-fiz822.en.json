  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Two young boys walked into a pharmacy, picked out a box of tampons, and proceeded to the checkout counter.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "doktor",
      "text": "Son, how old are you?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "vovochka-drug",
      "text": "Eight.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "doktor",
      "text": "Do you know what these are used for?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "vovochka-drug",
      "text": "Not exactly, but they aren't for me.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "vovochka-drug",
      "text": "They're for him... He's my brother. He's four.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "vovochka-drug",
      "text": "We saw on TV that if you use these, you will be able to swim and ride a bike.",
      "emotion": "happy",
      "pauseAfterSec": 0.7,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "vovochka-drug",
      "text": "Right now, he can't do either.",
      "emotion": "sad",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
