      "character": "narrator",
      "text": "Ein junger Mann kommt zum Bewerbungsgespräch, der Chef stellt sich vor.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "nachalnik",
      "text": "Wie heißen Sie?",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "paren",
      "text": "P-P-P-Peter Müller.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l4",
      "character": "nachalnik",
      "text": "Ach, Sie stottern?",
      "emotion": "surprised",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l5",
      "character": "paren",
      "text": "Nein, aber mein Vater und der Standesbeamte war ein Blödmann!",
      "uncensored": "Nein, aber mein Vater und der Standesbeamte war ein Arschloch!",
      "emotion": "angry",
