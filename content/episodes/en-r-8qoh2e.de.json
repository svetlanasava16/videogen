{
  "id": "en-r-8qoh2e.de",
  "jokeId": "en-r-8qoh2e",
  "locale": "de",
  "title": "Leise, aber tödlich",
  "location": "bolnitsa",
  "place": "doctor-office",
  "cast": [
    "doktor",
    "tyoshcha"
  ],
  "roles": {
    "doktor": "doctor",
    "tyoshcha": "old-woman"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Eine kleine alte Dame geht zum Arzt und sagt:",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [
        "tyoshcha"
      ],
      "exit": []
    },
    {
      "id": "l2",
      "character": "tyoshcha",
      "text": "Herr Doktor, ich habe ein schreckliches Problem mit Blähungen, aber es stört mich nicht besonders.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "tyoshcha",
      "text": "Meine Pupse sind immer lautlos und riechen nie.",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "tyoshcha",
      "text": "Ich habe bestimmt fünfzehnmal gepupst, seit ich hier bin, und Sie haben es nicht gemerkt.",
      "emotion": "smug",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "doktor",
      "text": "Interessant. Nehmen Sie doch diese Tabletten und kommen Sie in einer Woche wieder.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": [
        "tyoshcha"
      ]
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "Nach einer Woche kommt die alte Dame wieder und sagt:",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [
        "tyoshcha"
      ],
      "exit": []
    },
    {
      "id": "l7",
      "character": "tyoshcha",
      "text": "Ich weiß nicht, was zum Teufel Sie mir gegeben haben.",
      "emotion": "angry",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "tyoshcha",
      "text": "Meine Pupse sind immer noch lautlos, aber mein Gott, wie die stinken!",
      "emotion": "angry",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    },
    {
      "id": "l9",
      "character": "doktor",
      "text": "Ausgezeichnet. Jetzt, wo Ihre Nebenhöhlen frei sind, kümmern wir uns um Ihr Gehör.",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
  "explicit": false,
  "outroLaughs": [],
