      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "ded",
      "text": "Morgens erst mal pinkeln!",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "paren",
      "text": "Und? Keine Probleme?",
