    {
      "id": "l1",
      "character": "zhena",
      "text": "Явился! Курицу принёс?",
      "emotion": "angry",
      "pauseAfterSec": 0
    },
    {
      "id": "l2",
      "character": "muzhik",
      "text": "Не успел, Люсь. Кур больше нет, Даша последних забрала. Обеих.",
      "emotion": "sad",
      "pauseAfterSec": 0
    },
    {
      "id": "l3",
      "character": "zhena",
      "text": "А где ты был, пока лавка работала? Опять у Петровича?",
      "emotion": "angry",
      "pauseAfterSec": 0
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "Да всего стаканчик, Люся. Ну, два.",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "laugh": "laugh"
    }
  ],
