      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "nachalnik",
      "text": "Оно ничего не стоит.",
      "emotion": "smug",
      "pauseAfterSec": 0.6,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "paren",
      "text": "Я знаю, но всё равно хотел бы его услышать.",
