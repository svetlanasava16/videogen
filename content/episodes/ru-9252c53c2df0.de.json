  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Mitten im Flug ist in der Kabine plötzlich ein Knirschen und Quietschen des Rumpfes zu hören.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Einer der Passagiere wird blass, ihm tritt kalter Schweiß auf die Stirn, und er krallt sich mit den Fingern in den Sitz.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "muzhik",
      "text": "Sie brauchen sich doch nicht so aufzuregen!",
      "emotion": "happy",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "Ich fliege oft und kann Ihnen versichern, dass die Jungs da vorne im Cockpit wissen, was sie tun!",
      "emotion": "smug",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l5",
      "character": "muzhik-sosed",
      "text": "Ich bin Pilot! Ich weiß genau, was die da vorne tun!",
      "emotion": "angry",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
  "explicit": false,
