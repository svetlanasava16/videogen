  "lines": [
    {
      "id": "l1",
      "character": "muzhik",
      "text": "Heute habe ich auf der Straße gesehen, wie ein Mann mit seinem Hund redet.",
      "emotion": "smug",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "muzhik",
      "text": "Man hat gemerkt, dass er glaubt, der Hund versteht ihn!",
      "emotion": "happy",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l3",
      "character": "muzhik",
      "text": "Ich bin nach Hause gekommen und hab's meinem Kater erzählt.",
      "emotion": "neutral",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "Wir haben lange gelacht.",
      "emotion": "happy",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
