  "locale": "de",
  "title": "Weltfremd",
  "kind": "joke",
  "v": 2,
  "location": "podyezd",
  "place": "shop",
  "cast": [
    "muzhik-ryzhy",
    "paren",
    "tyoshcha",
    "devushka"
  ],
  "roles": {
    "muzhik-ryzhy": "farmer",
    "paren": "son",
    "tyoshcha": "old-woman",
    "devushka": "woman"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Bauer Hein kommt mit seinem Sohn Jürgen das erste Mal vom Land an den Stadtrand, denn sie wollen in das dort neu eröffnete Shopping-Center.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Im Parkhaus angekommen sehen sie, wie eine alte Frau gerade auf den Fahrstuhl wartet.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "paren",
      "text": "Vattern, guck ma. Wat is dat denn?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "muzhik-ryzhy",
      "text": "Jung, dat is 'ne alte Omma!",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "paren",
      "text": "Nee Vattern, ich mein dat silberne Ding.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l6",
      "character": "muzhik-ryzhy",
      "text": "Keine Ahnung, Sohn. Warte mal, ich frag die Omma eben.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l7",
      "character": "narrator",
      "text": "In dem Moment aber öffnet sich die Kabinentür, die alte Frau steigt in den Fahrstuhl und die Türe schließt sich.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l8",
      "character": "narrator",
      "text": "Vater und Sohn bleiben wie angewurzelt stehen und schauen sich die Vorrichtung von außen genau an.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l9",
      "character": "narrator",
      "text": "Einen Augenblick später öffnet sich die Türe wieder, und eine junge, attraktive Dame steigt aus.",
      "emotion": "surprised",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l10",
      "character": "narrator",
      "text": "Sie geht schnurstracks an den verdutzten Bauern vorbei.",
      "emotion": "neutral",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l11",
      "character": "muzhik-ryzhy",
      "text": "Jürgen, ich hab keine Ahnung, wat dat für 'ne Kasten is,",
      "emotion": "happy",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l11b",
      "character": "muzhik-ryzhy",
      "text": "aber du fährst jetzt sofort zurück zum Hof und holst deine Mutter her!",
      "emotion": "happy",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
