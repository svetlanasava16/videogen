{
  "id": "en-r-5l3p32.de",
  "jokeId": "en-r-5l3p32",
  "locale": "de",
  "title": "Der Decepticon-Jäger",
  "kind": "joke",
  "v": 2,
  "location": "kukhnya",
  "place": "home-kitchen",
  "cast": [
    "muzhik",
    "zhena"
  ],
  "roles": {
    "muzhik": "husband",
    "zhena": "wife"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Seine Frau fand ihn nackt in der Küche, mit einer Pistole in der Hand.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "zhena",
      "text": "Was zum Teufel machst du da?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "muzhik",
      "text": "Ruhe, Frau! Ich jage Decepticons!",
      "emotion": "angry",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "zhena",
      "text": "Du schlafwandelst schon wieder! So etwas wie Decepticons gibt es nicht!",
      "emotion": "angry",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "Er blinzelte und merkte, wie dämlich er aussah.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l6",
      "character": "muzhik",
      "text": "Du hast wohl recht! Mann, ich muss aussehen wie ein Idiot!",
      "emotion": "happy",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l7",
      "character": "narrator",
      "text": "Sie lachte.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l8",
      "character": "narrator",
      "text": "Er lachte.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l9",
      "character": "narrator",
      "text": "Der Toaster lachte.",
      "emotion": "neutral",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l10",
      "character": "narrator",
      "text": "Er erschoss den Toaster.",
      "emotion": "neutral",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
