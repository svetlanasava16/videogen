  "lines": [
    {
      "id": "l1",
      "character": "tyoshcha",
      "text": "Herr Doktor, ich habe ständig Blähungen.",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [
        "tyoshcha"
      ],
      "exit": []
    },
    {
      "id": "l2",
      "character": "tyoshcha",
      "text": "Zum Glück sind sie ganz lautlos und riechen überhaupt nicht.",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "tyoshcha",
      "text": "Sehen Sie, gerade ist mir wieder einer entwichen. Man merkt gar nichts.",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "doktor",
      "text": "Ich verschreibe Ihnen etwas. Kommen Sie in zwei Wochen wieder.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": [
        "tyoshcha"
      ]
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "Zwei Wochen später.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "tyoshcha",
      "text": "Herr Doktor, was haben Sie mir da verschrieben?",
      "emotion": "angry",
      "pauseAfterSec": 0.3,
      "enter": [
        "tyoshcha"
      ],
      "exit": []
    },
    {
      "id": "l7",
      "character": "tyoshcha",
      "text": "Die Blähungen sind nicht besser, aber jetzt stinken sie fürchterlich!",
      "emotion": "angry",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "doktor",
      "text": "Sehr gut, die Nase ist gesund. Als Nächstes kümmern wir uns um die Ohren.",
      "emotion": "happy",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    }
  ],
