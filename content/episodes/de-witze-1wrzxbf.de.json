{
  "id": "de-witze-1wrzxbf.de",
  "jokeId": "de-witze-1wrzxbf",
  "locale": "de",
  "title": "Lautlos und geruchlos",
  "kind": "joke",
  "v": 2,
  "location": "bolnitsa",
  "place": "doctor-office",
  "cast": [
    "tyoshcha",
    "doktor"
  ],
  "roles": {
    "tyoshcha": "old-woman",
    "doktor": "doctor"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Eine alte Frau sitzt beim Arzt und klagt über schreckliche Blähungen.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "tyoshcha",
      "text": "Wissen Sie, Herr Doktor, ich habe ständig Blähungen.",
      "emotion": "sad",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "tyoshcha",
      "text": "Zum Glück sind sie immer lautlos und stinken überhaupt nicht.",
      "emotion": "smug",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "tyoshcha",
      "text": "Sehen Sie, gerade ist mir wieder einer entwichen. Man bekommt es gar nicht mit.",
      "emotion": "happy",
      "pauseAfterSec": 0.4,
      "laugh": "chuckle"
    },
    {
      "id": "l5",
      "character": "doktor",
      "text": "Ich verschreibe Ihnen ein Medikament.",
      "emotion": "neutral",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l5b",
      "character": "doktor",
      "text": "Das nehmen Sie und kommen dann in zwei Wochen wieder.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "Gesagt, getan. Zwei Wochen später sitzt die Frau wieder beim Arzt und beklagt sich.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l7",
      "character": "tyoshcha",
      "text": "Herr Doktor, was haben Sie mir denn da verschrieben?",
      "emotion": "angry",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l8",
      "character": "tyoshcha",
      "text": "Die Blähungen sind nicht besser geworden, aber dafür stinken sie jetzt fürchterlich!",
      "emotion": "angry",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l9",
      "character": "doktor",
      "text": "Sehr gut, die Nase ist gesund.",
      "emotion": "happy",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l10",
      "character": "doktor",
      "text": "Als Nächstes kümmern wir uns um die Ohren.",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
