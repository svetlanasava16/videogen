  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein General schlendert über eine Brücke. Ein Soldat, unerlaubt unterwegs, will sich an ihm vorbeischleichen.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [
        "sluzhivy-ryadovoy"
      ],
      "exit": []
    },
    {
      "id": "l2",
      "character": "sluzhivy",
      "text": "Soldat! Was soll das? Warum grüßen Sie nicht?",
      "emotion": "angry",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "sluzhivy-ryadovoy",
      "text": "Laut Paragraf hundertsiebenundvierzig der Dienstvorschrift wird auf Brücken nicht gegrüßt!",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": [
        "sluzhivy-ryadovoy"
      ]
    },
    {
      "id": "l4",
      "character": "narrator",
      "text": "Der General grüßt verwirrt zurück. Zu Hause schlägt er die Vorschrift auf.",
      "emotion": "neutral",
      "pauseAfterSec": 0.7,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "sluzhivy",
      "text": "Paragraf hundertsiebenundvierzig. Der Soldat muss findig und mutig sein.",
      "emotion": "surprised",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    }
  ],
