  "locale": "de",
  "title": "Punkt hundertsiebenundvierzig",
  "kind": "joke",
  "v": 2,
  "location": "derevnya",
  "place": "river-lake",
  "cast": [
    "sluzhivy",
    "sluzhivy-ryadovoy"
  ],
  "roles": {
    "sluzhivy": "officer",
    "sluzhivy-ryadovoy": "soldier"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein General schlendert über eine Brücke, schaut sich träge um, und wie es der Zufall will, fällt ihm ein Soldat ins Auge.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Der Soldat ist wie immer unerlaubt unterwegs und will sich vorbeischleichen, als würde er den General nicht bemerken.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "sluzhivy",
      "text": "Soldat, verdammt nochmal, was soll das?!",
      "emotion": "angry",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "sluzhivy",
      "text": "Warum haben Sie nicht gegrüßt?!",
      "emotion": "angry",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "sluzhivy-ryadovoy",
      "text": "Laut Punkt hundertsiebenundvierzig der Dienstvorschrift wird auf einer Brücke nicht gegrüßt!",
      "emotion": "smug",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "Der General ist verdutzt, salutiert und geht sofort nach Hause.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l7",
      "character": "narrator",
      "text": "Er kommt an, blättert in der Dienstvorschrift, findet den Punkt, liest und traut seinen Augen nicht:",
      "emotion": "neutral",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l8",
      "character": "sluzhivy",
      "text": "Punkt hundertsiebenundvierzig. Ein Soldat muss findig und mutig sein.",
      "emotion": "surprised",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
  "explicit": false,
