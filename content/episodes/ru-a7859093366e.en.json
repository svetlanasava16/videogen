  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Gerasim, a huge yardman who couldn't speak a word, took his little dog Mumu out to drown. He tied a stone around the dog's neck, threw him in the river and rowed home.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Poor Mumu thrashes about, trying to get free. That's how another man swimming by finds him.",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "He pulls the dog out, unties the stone... and then:",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "pyos",
      "text": "Thank you, kind man! You saved me!",
      "emotion": "happy",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "muzhik",
      "text": "First time in my life I've seen a talking dog!",
      "emotion": "surprised",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "pyos",
      "text": "First time in my life I've seen a talking man!",
      "emotion": "surprised",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
