  ],
  "roles": {
    "muzhik-ryzhy": "everyman",
    "pyos-pudel": "dog",
    "muzhik": "everyman"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Gerasim, a big mute yardman, rowed his little dog Mumu out on the river to drown her.",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "He tied a stone around her neck and threw her into the river. Threw her in and rowed home.",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": [
        "muzhik-ryzhy"
      ]
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "Poor Mumu is thrashing about, trying to get free.",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "narrator",
      "text": "That's how another man, swimming past, finds her.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [
        "muzhik"
      ],
      "exit": []
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "He pulls her out, unties the stone... and then Mumu says:",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "pyos-pudel",
      "text": "Thank you, kind man! You saved me!",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "muzhik",
      "text": "First time in my life I've seen a talking dog!",
      "emotion": "surprised",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "pyos-pudel",
      "text": "First time in my life I've seen a talking man!",
      "emotion": "surprised",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
