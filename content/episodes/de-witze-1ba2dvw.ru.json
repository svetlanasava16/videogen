    {
      "id": "l1",
      "character": "narrator",
      "text": "Один москвич другому.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "muzhik",
      "text": "Я выиграл в лотерею десять миллионов рублей! Куплю себе для начала хорошую двухкомнатную квартиру.",
      "emotion": "happy",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "muzhik-sosed",
      "text": "Ого, поздравляю! А что будешь делать с остальным?",
      "emotion": "surprised",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "Остальное, наверное, возьму в ипотеку.",
      "emotion": "neutral",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
