  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein Russe und ein Amerikaner sterben und kommen in die Hölle.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [
        "muzhik",
        "inostranets"
      ],
      "exit": []
    },
    {
      "id": "l2",
      "character": "chort",
      "text": "Welche Hölle hättet ihr gern, die russische oder die amerikanische?",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "inostranets",
      "text": "Wo ist der Unterschied?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "chort",
      "text": "In der amerikanischen isst man jeden Tag einen Eimer Mist. In der russischen zwei.",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "inostranets",
      "text": "Ich nehme die amerikanische.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "muzhik",
      "text": "Ich habe mein ganzes Leben in Russland gelebt. Warum jetzt was ändern?",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "narrator",
      "text": "Einen Monat später treffen sie sich.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "muzhik",
      "text": "Na, wie ist es bei euch?",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l9",
      "character": "inostranets",
      "text": "Super. Morgens esse ich meinen Eimer, dann habe ich den ganzen Tag frei. Und bei euch?",
      "emotion": "happy",
      "pauseAfterSec": 0.7,
      "enter": [],
      "exit": []
    },
    {
      "id": "l10",
      "character": "muzhik",
      "text": "Wie immer. Mal wird kein Mist geliefert, mal reichen die Eimer nicht für alle.",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    }
  ],
