{
  "id": "ru-f6065bfed9a3.de",
  "jokeId": "ru-f6065bfed9a3",
  "locale": "de",
  "title": "Die russische Hölle",
  "kind": "joke",
  "v": 2,
  "location": "nebesa",
  "place": "hell",
  "cast": [
    "chort",
    "muzhik",
    "inostranets"
  ],
  "roles": {
    "muzhik": "everyman",
    "inostranets": "foreigner",
    "chort": "devil"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Nach dem Tod kommen ein Russe und ein Amerikaner in die Hölle. Der Teufel fragt sie:",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "chort",
      "text": "In welche Hölle wollt ihr, in die russische oder in die amerikanische?",
      "emotion": "smug",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "muzhik",
      "text": "Was ist der Unterschied?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "chort",
      "text": "In der amerikanischen muss man jeden Tag einen Eimer Mist essen,",
      "uncensored": "In der amerikanischen muss man jeden Tag einen Eimer Scheiße essen,",
      "emotion": "smug",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l4b",
      "character": "chort",
      "text": "in der russischen zwei.",
      "uncensored": "in der russischen zwei.",
      "emotion": "smug",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "Der Amerikaner wählt die amerikanische, und der Russe denkt:",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l6",
      "character": "muzhik",
      "text": "Mein ganzes Leben hab ich in Russland gelebt, warum jetzt was ändern?",
      "emotion": "neutral",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l7",
      "character": "narrator",
      "text": "Einen Monat später treffen sie sich. Der Russe fragt:",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l8",
      "character": "muzhik",
      "text": "Na, wie ist es bei euch?",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l9",
      "character": "inostranets",
      "text": "Wunderbar. Morgens einen Eimer Mist gegessen, und den ganzen Tag frei.",
      "uncensored": "Wunderbar. Morgens einen Eimer Scheiße gegessen, und den ganzen Tag frei.",
      "emotion": "happy",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l10",
      "character": "inostranets",
      "text": "Und bei euch?",
      "emotion": "neutral",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l11",
      "character": "muzhik",
      "text": "Wie immer: mal wurde kein Mist geliefert, mal reichen die Eimer nicht für alle.",
      "uncensored": "Wie immer: mal wurde keine Scheiße geliefert, mal reichen die Eimer nicht für alle.",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
