{
  "id": "ru-1c3557125dd4.en",
  "jokeId": "ru-1c3557125dd4",
  "locale": "en",
  "title": "Bail Money",
  "location": "spalnya",
  "place": "bedroom",
  "cast": [
    "muzhik",
    "zhena",
    "muzhik-sosed"
  ],
  "roles": {
    "muzhik": "husband",
    "zhena": "wife",
    "muzhik-sosed": "friend"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "One morning a man wakes up with the deepest hangover of his life to the phone ringing.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "It's a friend he hasn't seen for ages.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "muzhik",
      "text": "Where are you calling from?",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "muzhik-sosed",
      "text": "Help me out, buddy, I'm calling from the drunk tank, not far from your place.",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "muzhik-sosed",
      "text": "I've got no money, I need fifty-six dollars for them to let me go.",
      "emotion": "sad",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "The man promises, hangs up, and gathering the last of his strength, gets up and starts slowly getting dressed, trying not to fall over.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "zhena",
      "text": "Where to?!",
      "emotion": "angry",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "narrator",
      "text": "He honestly explains the situation.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l9",
      "character": "narrator",
      "text": "His wife takes a long hard look at his puffy face and says:",
      "emotion": "neutral",
      "pauseAfterSec": 0.6,
      "enter": [],
      "exit": []
    },
    {
      "id": "l10",
      "character": "zhena",
      "text": "Take a hundred and twelve dollars!",
      "emotion": "angry",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
