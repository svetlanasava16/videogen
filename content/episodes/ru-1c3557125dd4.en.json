{
  "id": "ru-1c3557125dd4.en",
  "jokeId": "ru-1c3557125dd4",
  "locale": "en",
  "title": "The Drunk Tank",
  "location": "spalnya",
  "place": "bedroom",
  "cast": [
    "muzhik"
  ],
  "roles": {
    "muzhik": "husband"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "One morning a man wakes up with the worst hangover of his life to a phone call. It's a friend he hasn't seen in ages.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "muzhik",
      "text": "Where are you calling from?",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "muzhik-sosed",
      "text": "Help me out, buddy, I'm calling from the drunk tank, not far from your place.",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "muzhik-sosed",
      "text": "I've got no money, and I need seventy-eight dollars so they'll let me go.",
      "emotion": "sad",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "The man promises, hangs up, gathers what's left of his strength, gets up and starts slowly getting dressed, trying not to fall over.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "zhena",
      "text": "Where do you think you're going?!",
      "emotion": "angry",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "narrator",
      "text": "He honestly explains the situation. His wife takes a long hard look at his puffy face.",
      "emotion": "neutral",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "zhena",
      "text": "Take a hundred and fifty-six!",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
