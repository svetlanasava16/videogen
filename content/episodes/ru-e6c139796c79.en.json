  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "A group of men got to talking about health.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "ded",
      "text": "I've never been sick a single day, and that's because I've led a simple, measured life.",
      "emotion": "smug",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "ded",
      "text": "From the age of twenty to forty, I went to bed at nine every day and got up at six in the morning.",
      "emotion": "smug",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "ded",
      "text": "From eight to five I worked, I had lunch, plain food at that, and then I exercised for an hour...",
      "emotion": "happy",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l5",
      "character": "muzhik-sosed",
      "text": "Excuse me, but what were you in for?",
      "emotion": "neutral",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
