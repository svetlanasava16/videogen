    {
      "id": "l2",
      "character": "barmen",
      "text": "Hey, kiddo. A dollar bill in this hand, two quarters in that one. Which do you want?",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "vovochka",
