  "lines": [
    {
      "id": "l1",
      "character": "muzhik",
      "text": "Для улучшения пищеварения я пью пиво, при отсутствии аппетита я пью белое вино,",
      "emotion": "neutral",
      "pauseAfterSec": 0.2
    },
    {
      "id": "l2",
      "character": "muzhik",
      "text": "при низком давлении — красное, при повышенном — коньяк, при ангине — водку.",
      "emotion": "smug",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l3",
      "character": "muzhik-ryzhy",
      "text": "А воду?",
      "emotion": "surprised",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "Такой болезни у меня ещё не было...",
      "emotion": "neutral",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
