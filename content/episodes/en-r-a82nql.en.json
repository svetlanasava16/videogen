  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "A drunk guy is showing friends his new apartment. The last stop is the bedroom, where a big brass gong sits next to the bed.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "muzhik-ryzhy",
      "text": "What's that gong for?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "muzhik",
      "text": "It's not a gong. It's a talking clock.",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "muzhik-ryzhy",
      "text": "How does it work?",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "The guy picks up a hammer, gives the gong an ear-shattering pound, and steps back.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "Suddenly, someone on the other side of the wall screams.",
      "emotion": "surprised",
      "pauseAfterSec": 0.6,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "muzhik-sosed",
      "text": "For God's sake, you jerk... it's three thirty in the god damn morning!",
      "uncensored": "For God's sake, you asshole... it's three thirty in the god damn morning!",
      "emotion": "angry",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
