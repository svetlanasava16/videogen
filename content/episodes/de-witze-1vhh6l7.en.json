{
  "id": "de-witze-1vhh6l7.en",
  "jokeId": "de-witze-1vhh6l7",
  "locale": "en",
  "title": "Back in Paris",
  "location": "gostinaya",
  "place": "home-living-room",
  "cast": [
    "ded",
    "paren"
  ],
  "roles": {
    "ded": "grandpa",
    "paren": "relative"
  },
  "lines": [
    {
      "id": "l1",
      "character": "ded",
      "text": "Boy, you kids today don't even know how to really party.",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "ded",
      "text": "When we were in Paris back then, we drank till we dropped, picked up the most beautiful women, stuffed our faces nonstop.",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "ded",
      "text": "We peed against the bar in the café, smashed everything to pieces, got into fights and ran off without paying.",
      "emotion": "happy",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "narrator",
      "text": "Two weeks later the grandson comes back: black eye, broken nose, arm in a cast.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "ded",
      "text": "Boy, what happened to you?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "paren",
      "text": "I did exactly what you told me.",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "ded",
      "text": "Who were you in Paris with?",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "paren",
      "text": "A couple of buddies.",
      "emotion": "sad",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    },
    {
      "id": "l9",
      "character": "ded",
      "text": "Boy... back then I was there with the SS!",
      "emotion": "surprised",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
