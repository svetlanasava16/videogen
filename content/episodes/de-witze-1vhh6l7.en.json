{
  "id": "de-witze-1vhh6l7.en",
  "jokeId": "de-witze-1vhh6l7",
  "locale": "en",
  "title": "Paris",
  "kind": "joke",
  "v": 2,
  "location": "gostinaya",
  "place": "home-living-room",
  "cast": [
    "ded",
    "paren"
  ],
  "roles": {
    "ded": "grandpa",
    "paren": "relative"
  },
  "lines": [
    {
      "id": "l1",
      "character": "ded",
      "text": "Boy, you kids today don't even know how to party properly.",
      "emotion": "smug",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "ded",
      "text": "Back when we were in Paris, we drank till we dropped,",
      "emotion": "happy",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l2b",
      "character": "ded",
      "text": "picked up the most beautiful women, stuffed our faces nonstop,",
      "emotion": "happy",
      "pauseAfterSec": 0.2
    },
    {
      "id": "l3",
      "character": "ded",
      "text": "peed against the bar in the café, smashed everything to pieces,",
      "emotion": "happy",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l3b",
      "character": "ded",
      "text": "got into brawls and ran off without paying.",
      "emotion": "happy",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l4",
      "character": "narrator",
      "text": "Two weeks later the grandson comes back: black eye, broken nose, arm in a cast.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "ded",
      "text": "Boy, what on earth happened to you?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l6",
      "character": "paren",
      "text": "I did exactly what you told me.",
      "emotion": "sad",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l7",
      "character": "ded",
      "text": "Who did you go to Paris with?",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l8",
      "character": "paren",
      "text": "With a couple of buddies.",
      "emotion": "sad",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l9",
      "character": "ded",
      "text": "Boy… back then I was there with the SS!",
      "emotion": "surprised",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
