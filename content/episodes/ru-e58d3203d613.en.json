  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "A Volvo clips a jeep at an intersection.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Everyone stops, a bunch of guys in tracksuits pile out of the jeep and walk up to the Volvo driver.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "nachalnik",
      "text": "That's it, man, you're done!",
      "emotion": "angry",
      "pauseAfterSec": 0.2,
      "enter": [
        "nachalnik",
        "muzhik-ryzhy",
        "paren"
      ],
      "exit": []
    },
    {
      "id": "l4",
      "character": "nachalnik",
      "text": "Sell your car, sell your apartment, you owe us money!",
      "emotion": "angry",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "muzhik",
      "text": "Guys, and who are you?",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "nachalnik",
      "text": "Us? We're athletes!",
      "emotion": "surprised",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "narrator",
      "text": "The man pulls out a pistol and, loading it, says:",
      "emotion": "neutral",
      "pauseAfterSec": 0.7,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "muzhik",
      "text": "Well then, on your marks! Get set!..",
