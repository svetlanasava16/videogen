{
  "id": "ru-d51ba21d6bfb.de",
  "jokeId": "ru-d51ba21d6bfb",
  "locale": "de",
  "title": "Ein Gedicht",
  "location": "doroga",
  "place": "road",
  "cast": [
    "sluzhivy",
    "nachalnik"
  ],
  "roles": {
    "sluzhivy": "traffic-cop",
    "nachalnik": "new-russian"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Die Villenstraße. Ein Polizist stoppt einen Bentley mit dreifacher Geschwindigkeit.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Die pechschwarz getönte Scheibe geht einen Spalt auf.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "sluzhivy",
      "text": "Polizeiobermeister Peters, Ihre Papiere bitte.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "narrator",
      "text": "Aus dem Fenster kommt eine Hand mit einem Fünfhunderter.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "sluzhivy",
      "text": "Schönen Tag noch, und versuchen Sie, nicht mehr gegen die Regeln zu verstoßen...",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "Noch ein Fünfhunderter.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "sluzhivy",
      "text": "Und passen Sie auf, zwei Blocks weiter steht noch eine Streife...",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "narrator",
      "text": "Wieder ein Fünfhunderter.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l9",
      "character": "sluzhivy",
      "text": "Ich arbeite hier dienstags und donnerstags von acht bis fünfzehn Uhr. Ich habe mir Ihr Kennzeichen gemerkt, an diesen Tagen können Sie ganz entspannt fahren...",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l10",
      "character": "narrator",
      "text": "Und noch einer.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l11",
      "character": "sluzhivy",
      "text": "Glück und Gesundheit, kluge Kinder, Erfolg im Geschäft, und dass Ihr Hund jede Ausstellung gewinnt...",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l12",
      "character": "narrator",
      "text": "Wieder die Hand mit dem Schein. Der Polizist steht eine Weile ratlos da, dann räuspert er sich und verkündet...",
      "emotion": "neutral",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    },
    {
      "id": "l13",
      "character": "sluzhivy",
      "text": "Ein Gedicht!",
      "emotion": "happy",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
