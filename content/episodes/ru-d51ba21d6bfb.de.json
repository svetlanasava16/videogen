{
  "id": "ru-d51ba21d6bfb.de",
  "jokeId": "ru-d51ba21d6bfb",
  "locale": "de",
  "title": "Das Gedicht",
  "location": "doroga",
  "place": "road",
  "cast": [
    "sluzhivy",
    "nachalnik"
  ],
  "roles": {
    "sluzhivy": "traffic-cop",
    "nachalnik": "new-russian"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein Polizist hält einen Bentley an. Dreifache Geschwindigkeitsüberschreitung.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Die tiefschwarz getönte Scheibe geht einen Spalt auf.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "sluzhivy",
      "text": "Wachtmeister Peters, Ihre Papiere, bitte.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "narrator",
      "text": "Aus dem Bentley streckt sich eine Hand mit einem Hunderteuroschein. Der Polizist steckt ihn in die Brusttasche.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "sluzhivy",
      "text": "Alles Gute, und versuchen Sie, nicht mehr gegen die Regeln zu verstoßen...",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "Aus dem Fenster kommt der nächste Hunderter.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "sluzhivy",
      "text": "Und passen Sie auf, zwei Straßen weiter steht noch eine Streife...",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "narrator",
      "text": "Wieder ein Hunderter.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l9",
      "character": "sluzhivy",
      "text": "Ich arbeite hier dienstags und donnerstags, von acht Uhr morgens bis fünfzehn Uhr.",
      "emotion": "smug",
      "pauseAfterSec": 0.2,
      "enter": [],
      "exit": []
    },
    {
      "id": "l10",
      "character": "sluzhivy",
      "text": "Ich habe mir Ihr Kennzeichen gemerkt, an diesen Tagen können Sie ganz entspannt fahren...",
      "emotion": "smug",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": [],
      "laugh": "chuckle"
    },
    {
      "id": "l11",
      "character": "narrator",
      "text": "Wieder ein Hundert-Euro-Schein.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l12",
      "character": "sluzhivy",
      "text": "Glück und Gesundheit, kluge Kinder, Erfolg im Geschäft, und dass Ihr Hund jeden Wettbewerb gewinnt...",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l13",
      "character": "narrator",
      "text": "Wieder ein Schein. Der Polizist steht eine Weile ratlos da, dann räuspert er sich...",
      "emotion": "neutral",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    },
    {
      "id": "l14",
      "character": "sluzhivy",
      "text": "Und jetzt ein Gedicht!",
      "emotion": "happy",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
