{
  "id": "ru-d51ba21d6bfb.de",
  "jokeId": "ru-d51ba21d6bfb",
  "locale": "de",
  "title": "Das Gedicht",
  "kind": "joke",
  "v": 2,
  "location": "doroga",
  "place": "road",
  "cast": [
    "sluzhivy",
    "nachalnik"
  ],
  "roles": {
    "sluzhivy": "traffic-cop",
    "nachalnik": "new-russian"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Moskau, die Rubljowka-Chaussee. Ein Verkehrspolizist hält einen Bentley an: dreifach zu schnell.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Der Bentley hält, die pechschwarz getönte Scheibe geht einen Spalt auf. Der Polizist salutiert:",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "sluzhivy",
      "text": "Inspektor Petrow, Ihre Papiere bitte.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "narrator",
      "text": "Aus dem Bentley streckt sich eine Hand mit einem Fünfhundert-Euro-Schein. Der Inspektor steckt ihn in die Brusttasche.",
      "emotion": "surprised",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "sluzhivy",
      "text": "Alles Gute, und versuchen Sie, nicht mehr gegen die Regeln zu verstoßen...",
      "emotion": "happy",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "Aus dem Fenster kommt der nächste Schein, genauso groß.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l7",
      "character": "sluzhivy",
      "text": "Und passen Sie auf, zwei Straßen weiter steht noch eine Streife...",
      "emotion": "smug",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l8",
      "character": "narrator",
      "text": "Wieder ein Fünfhunderter. Der Polizist schaut sich das Nummernschild genau an.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l9",
      "character": "sluzhivy",
      "text": "Ich arbeite hier dienstags und donnerstags, von acht Uhr morgens bis fünfzehn Uhr.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l10",
      "character": "sluzhivy",
      "text": "Ich habe mir Ihr Kennzeichen gemerkt,",
      "emotion": "smug",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l10b",
      "character": "sluzhivy",
      "text": "an diesen Tagen können Sie ganz ruhig fahren...",
      "emotion": "smug",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l11",
      "character": "narrator",
      "text": "Wieder ein Schein über fünfhundert.",
      "emotion": "surprised",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l12",
      "character": "sluzhivy",
      "text": "Glück und Gesundheit für Sie, kluge Kinder, Erfolg im Geschäft,",
      "emotion": "happy",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l12b",
      "character": "sluzhivy",
      "text": "und dass Ihr Hund jeden Wettbewerb gewinnt...",
      "emotion": "happy",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l13",
      "character": "narrator",
      "text": "Wieder die Hand mit einem Schein. Der Inspektor steht eine Weile verwirrt da, dann räuspert er sich und sagt:",
      "emotion": "neutral",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l14",
      "character": "sluzhivy",
      "text": "Ein Gedicht!",
      "emotion": "happy",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
