  "locale": "de",
  "title": "Der Akkordeonspieler",
  "location": "doroga",
  "place": "road",
  "cast": [
    "sluzhivy",
    "muzhik",
    "muzhik-ryzhy"
  ],
  "roles": {
    "sluzhivy": "traffic-cop",
    "muzhik": "everyman",
    "muzhik-ryzhy": "driver"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Nachts hält ein Polizist einen Trabi an. Er schaut rein, und da sitzen siebzehn sturzbetrunkene Männer.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Er ist so baff, dass er nicht mal einen Strafzettel schreibt.",
      "emotion": "neutral",
      "pauseAfterSec": 0.2,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "sluzhivy",
      "text": "Aber morgen meldet ihr euch bei mir, in derselben Besetzung und nüchtern!",
      "emotion": "surprised",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "narrator",
      "text": "Am Morgen quetschen sie sich in den Wagen. Sechzehn passen rein, aber der Siebzehnte, keine Chance.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "muzhik-ryzhy",
      "text": "Hör mal, vielleicht warst du gar nicht dabei?",
      "emotion": "neutral",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "muzhik",
      "text": "Na hallo! Und wer hat euch gestern auf dem Akkordeon gespielt?",
      "emotion": "angry",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
