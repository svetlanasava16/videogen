  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Nachts hält ein Polizist einen alten Trabi an. Drin sitzen siebzehn sturzbetrunkene Männer.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "sluzhivy",
      "text": "Siebzehn? In einem Trabi?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "sluzhivy",
      "text": "Ich verzichte auf die Strafe. Aber morgen kommt ihr wieder. Nüchtern. Vollzählig.",
      "emotion": "angry",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "narrator",
      "text": "Am Morgen quetschen sich sechzehn hinein. Der Siebzehnte passt einfach nicht.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "muzhik-ryzhy",
      "text": "Sag mal, warst du gestern vielleicht gar nicht dabei?",
      "emotion": "neutral",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "muzhik",
      "text": "Wie bitte? Und wer hat dann Akkordeon gespielt?",
      "emotion": "angry",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    }
  ],
