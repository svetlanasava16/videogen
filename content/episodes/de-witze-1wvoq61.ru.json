  "title": "Шпаклёвка",
  "kind": "joke",
  "v": 2,
  "location": "magazin",
  "place": "shop",
  "cast": [
    "ptitsa",
    "barmen"
  ],
  "roles": {
    "ptitsa": "chicken",
    "barmen": "salesman"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Курица заходит в строительный магазин.",
      "emotion": "neutral",
      "pauseAfterSec": 0.2
    },
    {
      "id": "l2",
      "character": "ptitsa",
      "text": "У вас есть шпаклёвка?",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "barmen",
      "text": "Нет, к сожалению.",
      "emotion": "surprised",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "narrator",
      "text": "На следующий день курица приходит снова.",
      "emotion": "neutral",
      "pauseAfterSec": 0.2
    },
    {
      "id": "l5",
      "character": "ptitsa",
      "text": "У вас есть шпаклёвка?",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l6",
      "character": "barmen",
      "text": "Нет, у нас её нет!",
      "emotion": "angry",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l7",
      "character": "narrator",
      "text": "На третий день курица приходит опять.",
      "emotion": "neutral",
      "pauseAfterSec": 0.2
    },
    {
      "id": "l8",
      "character": "ptitsa",
      "text": "У вас есть шпаклёвка?",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l9",
      "character": "barmen",
      "text": "Слушай сюда, пернатая!",
      "emotion": "angry",
      "pauseAfterSec": 0.2
    },
    {
      "id": "l10",
      "character": "barmen",
      "text": "Если ты ещё раз спросишь у меня шпаклёвку, я прибью твои лапы гвоздями к прилавку!",
      "emotion": "angry",
      "pauseAfterSec": 0.4,
      "laugh": "chuckle"
    },
    {
      "id": "l11",
      "character": "narrator",
      "text": "На четвёртый день курица приходит снова.",
      "emotion": "neutral",
      "pauseAfterSec": 0.2
    },
    {
      "id": "l12",
      "character": "ptitsa",
      "text": "У вас есть гвозди?",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l13",
      "character": "barmen",
      "text": "Нет, сегодня нет.",
      "emotion": "smug",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l14",
      "character": "ptitsa",
      "text": "Хорошо... У вас есть шпаклёвка?",
      "emotion": "happy",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
