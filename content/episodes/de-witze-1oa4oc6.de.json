  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Am frühen Morgen geht ein Mann auf die Jagd.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Im Wald angekommen, beginnt es zu regnen, der Wind nimmt zu. Der Mann beschließt umzukehren.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "Er kommt nach Hause, zieht sich aus und legt sich wieder zu seiner Frau ins Bett.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "narrator",
      "text": "Seine Frau fragt gähnend im Halbschlaf:",
      "emotion": "neutral",
      "pauseAfterSec": 0.2
    },
    {
      "id": "l5",
      "character": "zhena",
      "text": "Wie ist es draußen?",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l6",
      "character": "muzhik-ryzhy",
      "text": "Kalt, es regnet…",
      "emotion": "sad",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l7",
      "character": "zhena",
      "text": "…und mein Mann, der Idiot, ist auf die Jagd gegangen.",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
