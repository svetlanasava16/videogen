  "locale": "de",
  "title": "Das Geburtstagsgeschenk",
  "kind": "joke",
  "v": 2,
  "location": "doroga",
  "place": "road",
  "cast": [
    "sluzhivy",
    "sluzhivy-ryadovoy",
    "muzhik-ryzhy"
  ],
  "roles": {
    "sluzhivy": "customs-officer",
    "sluzhivy-ryadovoy": "customs-officer",
    "muzhik-ryzhy": "customs-officer"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Drei Zöllner sitzen zusammen und überlegen, was sie dem vierten zum Geburtstag schenken sollen.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "sluzhivy",
      "text": "Schenken wir ihm doch eine neue S-Klasse?",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "muzhik-ryzhy",
      "text": "Ach nee, die hat er schon, die haben wir ihm letztes Jahr zum Geburtstag geschenkt.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "sluzhivy-ryadovoy",
      "text": "Dann schenken wir ihm einen Bungalow auf den Kanaren.",
      "emotion": "smug",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "sluzhivy",
      "text": "Ach nee, den hat er schon.",
      "emotion": "sad",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l6",
      "character": "muzhik-ryzhy",
      "text": "Ich hab's! Wir schenken ihm, dass er die ganze Schicht allein arbeiten darf!",
      "emotion": "happy",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l7",
      "character": "sluzhivy-ryadovoy",
      "text": "Spinnst du? So ein teures Geschenk!",
      "emotion": "angry",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
  "explicit": false,
