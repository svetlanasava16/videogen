  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Two boys are arguing when the teacher enters the classroom.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "uchilka",
      "text": "What are you two arguing about?",
      "emotion": "angry",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "vovochka",
      "text": "We found a ten-dollar bill and decided whoever tells the biggest lie gets to keep it.",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "uchilka",
      "text": "You two should be ashamed of yourselves.",
      "emotion": "angry",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "uchilka",
      "text": "When I was your age, I didn't even know what a lie was.",
      "emotion": "smug",
      "pauseAfterSec": 0.6,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "The boys looked at each other and handed the ten dollars to the teacher.",
      "emotion": "neutral",
      "pauseAfterSec": 0.8,
