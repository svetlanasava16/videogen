  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "One morning the boss pulls up in a brand-new, very expensive sports car.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "paren",
      "text": "That's a great new car you've got there. It makes a man downright jealous.",
      "emotion": "surprised",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l3",
      "character": "nachalnik",
      "text": "You know, if you work hard all year,",
      "emotion": "smug",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l3b",
      "character": "nachalnik",
      "text": "throw everything you've got into the company's success and beat last year's results,",
      "emotion": "smug",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l4",
      "character": "nachalnik",
      "text": "then next year I can afford an even better car.",
      "emotion": "happy",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
