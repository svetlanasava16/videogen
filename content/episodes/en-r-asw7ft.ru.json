  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "В ресторан заходит женщина с пятнадцатью мальчишками. Они носятся по залу.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [
        "vovochka",
        "zhena"
      ],
      "exit": []
    },
    {
      "id": "l2",
      "character": "zhena",
      "text": "Серёжа! А ну сел!",
      "emotion": "angry",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "Все пятнадцать мальчишек тут же садятся.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "barmen",
      "text": "Подождите, их что, всех зовут Серёжа?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "zhena",
      "text": "Ну да. Так проще, не надо помнить, кто есть кто.",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "barmen",
      "text": "А если вам нужен кто-то один?",
      "emotion": "surprised",
      "pauseAfterSec": 0.7,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "zhena",
      "text": "Тогда я зову его по фамилии.",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    }
  ],
