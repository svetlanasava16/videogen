  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Einmal wurde ein Kriegsveteran in den Geschichtsunterricht einer dritten Klasse eingeladen.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "uchilka",
      "text": "Erzählen Sie uns von der Schlacht, an die Sie sich am meisten erinnern.",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "ded",
      "text": "Also, wir sind bei Minsk eingekesselt worden.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "ded",
      "text": "Mist, links Deutsche, Mist, rechts Deutsche, und vorne auch Deutsche.",
      "uncensored": "Scheiße, links Deutsche, Scheiße, rechts Deutsche, und vorne auch Deutsche.",
      "emotion": "angry",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "uchilka",
      "text": "Das sind doch Kinder!",
      "emotion": "surprised",
      "pauseAfterSec": 0.6,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "ded",
      "text": "Was für verdammte Kinder?! Faschisten!",
      "uncensored": "Was für Scheißkinder?! Faschisten!",
      "emotion": "angry",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
