  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein Kriegsveteran ist zu Gast im Geschichtsunterricht der dritten Klasse.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [
        "ded"
      ],
      "exit": []
    },
    {
      "id": "l2",
      "character": "uchilka",
      "text": "Erzählen Sie den Kindern von der Schlacht, an die Sie sich am meisten erinnern.",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "ded",
      "text": "Also, bei Minsk waren wir eingekesselt.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "ded",
      "text": "Verdammt, links die Deutschen! Verdammt, rechts die Deutschen! Und vorne auch!",
      "emotion": "angry",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "uchilka",
      "text": "Das sind doch Kinder!",
      "emotion": "surprised",
      "pauseAfterSec": 0.7,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "ded",
      "text": "Was für verdammte Kinder? Das waren Faschisten!",
      "emotion": "angry",
      "pauseAfterSec": 0.8,
