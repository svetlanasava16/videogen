  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein Mann wird von der Polizei verfolgt, und sie liefern sich eine wilde Verfolgungsjagd.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Irgendwann erwischt die Polizei den Mann doch.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "sluzhivy",
      "text": "Wenn Sie jetzt nicht einen wirklich triftigen Grund für Ihre Fahrweise und die Flucht haben, werden Sie mächtig Ärger bekommen.",
      "emotion": "angry",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "Entschuldigung, aber meine Frau ist vor zwei Wochen mit einem Polizisten durchgebrannt.",
      "emotion": "sad",
      "pauseAfterSec": 0.6,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "muzhik",
      "text": "Und ich dachte, er will sie mir zurückbringen.",
      "emotion": "surprised",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
