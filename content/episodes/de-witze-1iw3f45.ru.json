{
  "id": "de-witze-1iw3f45.ru",
  "jokeId": "de-witze-1iw3f45",
  "locale": "ru",
  "title": "Три собаки",
  "location": "ulitsa",
  "place": "park",
  "cast": [
    "pyos"
  ],
  "roles": {
    "pyos": "dog"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "На собачьей площадке встречаются далматинец, пудель и дворняга.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "pyos",
      "text": "Добрый день. Меня зовут Антониус фон Когтенберг.",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "pyos",
      "text": "Я происхожу из древнего дворянского рода.",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "pyos",
      "text": "Как и мои предки, я тоже живу подле герцога.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "pyos",
      "text": "Меня зовут Изабелла фон Хундсмарк.",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "pyos",
      "text": "Как уже понятно по звучанию моего имени, я тоже происхожу из древнего дворянского рода.",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "pyos",
      "text": "Как и мои предки, я — гордость графа.",
      "emotion": "happy",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "pyos",
      "text": "Йоу, друзья, хозяин обычно зовёт меня просто Шарик.",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l9",
      "character": "pyos",
      "text": "Но я тоже дворянин.",
      "emotion": "smug",
      "pauseAfterSec": 0.7,
      "enter": [],
      "exit": []
    },
    {
      "id": "l10",
      "character": "pyos",
      "text": "Моё полное имя — Шарик-слезь-с-дивана.",
      "emotion": "happy",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
