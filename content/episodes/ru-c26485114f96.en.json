  "title": "Just a Thought",
  "location": "samolet",
  "place": "train",
  "cast": [
    "doktor",
    "nachalnik"
  ],
  "roles": {
    "doktor": "therapist",
    "nachalnik": "new-russian"
  },
  "lines": [
    {
      "id": "l1",
      "character": "doktor",
      "text": "I'm a psychologist.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [
        "doktor",
        "nachalnik"
      ],
      "exit": []
    },
    {
      "id": "l2",
      "character": "nachalnik",
      "text": "And I'm loaded. Guess what I'm thinking. A hundred bucks for every right guess.",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "doktor",
      "text": "I'm not a mind reader, I'm a psychologist.",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "nachalnik",
      "text": "A hundred bucks, man! Try!",
      "emotion": "angry",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "doktor",
      "text": "You're back from the beach, thinking what a great vacation it was.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "nachalnik",
      "text": "Bingo! Here's a hundred. Next!",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "doktor",
      "text": "You spent it with a beautiful woman. You're thinking about her.",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "nachalnik",
      "text": "Another hundred!",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l9",
      "character": "doktor",
      "text": "And you don't want to go home. Your wife is there.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l10",
      "character": "nachalnik",
      "text": "You're a wizard! Take it!",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l11",
      "character": "doktor",
      "text": "And you're thinking, maybe I should kill her.",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l12",
      "character": "nachalnik",
      "text": "Stop! Here's a thousand!",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l13",
      "character": "doktor",
      "text": "What for? It's just a thought.",
      "emotion": "surprised",
      "pauseAfterSec": 0.7,
      "enter": [],
      "exit": []
    },
    {
      "id": "l14",
      "character": "nachalnik",
      "text": "Buddy, that's not a thought anymore. That's an idea!",
      "emotion": "happy",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    }
  ],
