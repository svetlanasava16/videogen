{
  "id": "ru-c26485114f96.en",
  "jokeId": "ru-c26485114f96",
  "locale": "en",
  "title": "Thought and Idea",
  "location": "samolet",
  "place": "train",
  "cast": [
    "doktor",
    "nachalnik"
  ],
  "roles": {
    "doktor": "therapist",
    "nachalnik": "businessman"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Two men get into a sleeper compartment on a train down south. They introduce themselves.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "doktor",
      "text": "I'm a psychologist.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "nachalnik",
      "text": "And I'm a self-made millionaire.",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "nachalnik",
      "text": "Listen, since you're a psychologist, guess my thoughts. I'll pay you a hundred bucks for every one you get right.",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "doktor",
      "text": "But I'm not a mind reader, I'm a psychologist...",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "nachalnik",
      "text": "Buddy, didn't you hear me? A hundred bucks each! Come on, concentrate, what am I thinking right now?",
      "emotion": "angry",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "doktor",
      "text": "Well, you're coming back from the south. You're probably thinking about what a great vacation you had!",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "nachalnik",
      "text": "Right, psychologist! Here's a hundred bucks! Keep guessing!",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l9",
      "character": "doktor",
      "text": "And if you had a great vacation, it was with a beautiful woman. You're probably thinking about her.",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l10",
      "character": "nachalnik",
      "text": "Attaboy! Take another hundred! Go on!",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l11",
      "character": "doktor",
      "text": "And you're thinking how much you don't want to go home...",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l12",
      "character": "nachalnik",
      "text": "Another hundred!",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l13",
      "character": "doktor",
      "text": "And if you don't want to go home, that means there's a wife at home...",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l14",
      "character": "nachalnik",
      "text": "Man, you're a wizard! Here's another hundred!",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l15",
      "character": "doktor",
      "text": "You're thinking: why don't I just kill her?",
      "emotion": "neutral",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l16",
      "character": "nachalnik",
      "text": "Stop, buddy! Here, take a thousand bucks!",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l17",
      "character": "doktor",
      "text": "What happened? A thought like any other...",
      "emotion": "surprised",
      "pauseAfterSec": 0.7,
      "enter": [],
      "exit": []
    },
    {
      "id": "l18",
      "character": "nachalnik",
      "text": "Buddy, that's not a thought anymore. That's an idea!",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
