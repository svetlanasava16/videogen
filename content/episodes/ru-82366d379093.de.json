{
  "id": "ru-82366d379093.de",
  "jokeId": "ru-82366d379093",
  "locale": "de",
  "title": "Das letzte Hähnchen",
  "location": "magazin",
  "place": "shop",
  "cast": [
    "devushka",
    "barmen"
  ],
  "roles": {
    "devushka": "woman",
    "barmen": "salesman"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Eine Metzgerei, eine Minute vor Ladenschluss.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "devushka",
      "text": "Gott sei Dank, ich hab's geschafft! Haben Sie Hähnchen?",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "Der Metzger holt das einzige Hähnchen aus der Tiefkühltruhe und legt es auf die Waage. Die Waage zeigt ein Kilo.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "devushka",
      "text": "Hm... Haben Sie kein größeres?",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "Der Metzger legt das Hähnchen zurück, holt dasselbe wieder heraus, dreht es um, legt es auf die Waage und drückt mit dem Finger drauf. Die Waage zeigt anderthalb Kilo.",
      "emotion": "neutral",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "devushka",
      "text": "Wunderbar! Dann nehme ich bitte beide.",
      "emotion": "happy",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
