{
  "id": "ru-82366d379093.de",
  "jokeId": "ru-82366d379093",
  "locale": "de",
  "title": "Das einzige Hähnchen",
  "location": "magazin",
  "place": "shop",
  "cast": [
    "devushka",
    "barmen"
  ],
  "roles": {
    "devushka": "customer",
    "barmen": "salesman"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Eine Metzgerei, eine Minute vor Ladenschluss.",
      "emotion": "neutral",
      "pauseAfterSec": 0,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Eine atemlose Frau stürzt herein und sagt:",
      "emotion": "surprised",
      "pauseAfterSec": 0,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "devushka",
      "text": "Gott sei Dank, ich hab's geschafft! Haben Sie Hähnchen?",
      "emotion": "happy",
      "pauseAfterSec": 0,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "narrator",
      "text": "Der Metzger holt das einzige Hähnchen aus der Tiefkühltruhe",
      "emotion": "neutral",
      "pauseAfterSec": 0,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "und legt es auf die Waage. Die Waage zeigt ein Kilo. Die Frau:",
      "emotion": "neutral",
      "pauseAfterSec": 0,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "devushka",
      "text": "Hm... Haben Sie kein größeres?",
      "emotion": "sad",
      "pauseAfterSec": 0,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "narrator",
      "text": "Der Metzger legt das Hähnchen zurück,",
      "emotion": "neutral",
      "pauseAfterSec": 0,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "narrator",
      "text": "holt dann dasselbe wieder heraus, dreht es um,",
      "emotion": "neutral",
      "pauseAfterSec": 0,
      "enter": [],
      "exit": []
    },
    {
      "id": "l9",
      "character": "narrator",
      "text": "legt es auf die Waage und drückt mit dem Finger drauf.",
      "emotion": "smug",
      "pauseAfterSec": 0,
      "enter": [],
      "exit": []
    },
    {
      "id": "l10",
      "character": "narrator",
      "text": "Die Waage zeigt anderthalb Kilo. Die Frau:",
      "emotion": "neutral",
      "pauseAfterSec": 0,
      "enter": [],
      "exit": []
    },
    {
      "id": "l11",
      "character": "devushka",
      "text": "Wunderbar! Geben Sie mir bitte beide.",
      "emotion": "happy",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
