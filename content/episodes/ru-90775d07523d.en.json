  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "A workplace safety lecture at the university.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "doktor",
      "text": "You are a foreman on a construction site. Right in front of you, a worker falls off the scaffolding and is killed.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "doktor",
      "text": "What are your first actions?",
      "emotion": "neutral",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l4",
      "character": "paren",
      "text": "Call an ambulance!",
      "emotion": "surprised",
      "pauseAfterSec": 0.2
    },
    {
      "id": "l5",
      "character": "devushka",
      "text": "Call the police!",
      "emotion": "surprised",
      "pauseAfterSec": 0.2
    },
    {
      "id": "l6",
      "character": "devushka-blondinka",
      "text": "Inform the relatives!",
      "emotion": "sad",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l7",
      "character": "doktor",
      "text": "Put a hard hat and a safety harness on the body, or the police will come for you.",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
