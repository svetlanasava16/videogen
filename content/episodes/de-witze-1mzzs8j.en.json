    {
      "id": "l1",
      "character": "narrator",
      "text": "A man dies and finds himself at the pearly gates.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [
        "muzhik"
      ],
      "exit": []
    },
    {
      "id": "l2",
      "character": "ded",
      "text": "Well, my son, you weren't exactly a good man. Name one good deed.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "muzhik",
      "text": "Once, a gang of bikers was harassing some nuns.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "So I walked up to their leader. Huge guy, tattoos, nose ring. Grabbed him by the ring, slapped him and said: now apologise to the ladies!",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "ded",
      "text": "I can't find that in my book. When did this happen?",
      "emotion": "surprised",
      "pauseAfterSec": 0.7,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "muzhik",
      "text": "About a minute or two ago.",
      "emotion": "sad",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    }
  ],
