{
  "id": "de-witze-1mzzs8j.en",
  "jokeId": "de-witze-1mzzs8j",
  "locale": "en",
  "title": "Fresh Case",
  "kind": "joke",
  "v": 2,
  "location": "nebesa",
  "place": "heaven",
  "cast": [
    "muzhik",
    "ded"
  ],
  "roles": {
    "muzhik": "everyman",
    "ded": "saint-peter"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "A man dies and finds himself at the gates of heaven, where Saint Peter is waiting for him.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "ded",
      "text": "Well, my son! You weren't exactly a good person in your life.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "ded",
      "text": "Can you name one good deed on the basis of which I can let you in here?",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "Yes. Once some bikers were harassing a few nuns.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "muzhik",
      "text": "So I went up to their leader, a big tattooed guy with a nose ring,",
      "emotion": "smug",
      "pauseAfterSec": 0.2
    },
    {
      "id": "l6",
      "character": "muzhik",
      "text": "grabbed him by the ring, slapped him across the face and said: And now you apologize to the ladies!",
      "emotion": "smug",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l7",
      "character": "narrator",
      "text": "Saint Peter leafs through his book.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l8",
      "character": "ded",
      "text": "I can't find anything like that here! Tell me, when did this happen?",
      "emotion": "surprised",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l9",
      "character": "muzhik",
      "text": "About one or two minutes ago.",
      "emotion": "sad",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
