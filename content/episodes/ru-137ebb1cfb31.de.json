    {
      "id": "l1",
      "character": "paren",
      "text": "Mir reicht's! Immer nur mit euch, immer pünktlich zu Hause!",
      "emotion": "angry",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "paren",
      "text": "Ich will Romantik, Freiheit, Bier und Mädchen!",
      "emotion": "angry",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "paren",
      "text": "Ich gehe! Und versucht ja nicht, mich aufzuhalten!",
      "emotion": "angry",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "narrator",
      "text": "An der Tür holt ihn sein Vater ein.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "paren",
      "text": "Papa, ich hab doch gesagt, halt mich nicht auf!",
