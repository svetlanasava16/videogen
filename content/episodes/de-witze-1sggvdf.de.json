  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein Städter schießt auf der Jagd eine Ente, doch sie fällt auf den Hof eines Bauern.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "muzhik-ryzhy",
      "text": "Das ist mein Vogel! Geben Sie ihn her!",
      "emotion": "angry",
      "pauseAfterSec": 0.3,
      "enter": [
        "muzhik-ryzhy"
      ],
      "exit": []
    },
    {
      "id": "l3",
      "character": "muzhik-sosed",
      "text": "Bei uns auf dem Land klärt man so was mit einem Tritt zwischen die Beine.",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "muzhik-sosed",
      "text": "Wer weniger schreit, kriegt die Ente.",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "muzhik-ryzhy",
      "text": "Einverstanden.",
      "emotion": "angry",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "Der Bauer tritt zu. Der Städter liegt zwanzig Minuten am Boden.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "muzhik-ryzhy",
      "text": "Okay. Jetzt bin ich dran.",
      "emotion": "sad",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "muzhik-sosed",
      "text": "Nee. Hier, nehmen Sie die Ente.",
      "emotion": "neutral",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [
        "muzhik-sosed"
      ]
    }
  ],
