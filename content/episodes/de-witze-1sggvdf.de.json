  "locale": "de",
  "title": "Entenjagd",
  "kind": "joke",
  "v": 2,
  "location": "derevnya",
  "place": "farm",
  "cast": [
    "muzhik-ryzhy",
    "ptitsa",
    "muzhik-sosed"
  ],
  "roles": {
    "muzhik-ryzhy": "hunter",
    "ptitsa": "duck",
    "muzhik-sosed": "farmer"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein Einwohner aus der Großstadt fährt zur Entenjagd aufs Land. Als er eine Ente sieht, zielt er und schießt.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Doch der Vogel fällt auf den Hof eines Bauern, und der rückt die Beute nicht heraus.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "muzhik-ryzhy",
      "text": "Das ist mein Vogel.",
      "emotion": "angry",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "muzhik-sosed",
      "text": "Wie auf dem Land üblich, legen wir den Streit mit einem Tritt in den Unterleib bei.",
      "emotion": "smug",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "muzhik-sosed",
      "text": "Wer weniger schreit, kriegt den Vogel.",
      "emotion": "smug",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l6",
      "character": "muzhik-ryzhy",
      "text": "Einverstanden.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l7",
      "character": "narrator",
      "text": "Der Bauer holt aus und landet einen gewaltigen Tritt in den Weichteilen des Mannes.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l8",
      "character": "narrator",
      "text": "Der bricht zusammen und bleibt zwanzig Minuten am Boden liegen.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l9",
      "character": "muzhik-ryzhy",
      "text": "Okay, jetzt bin ich dran.",
      "emotion": "angry",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l10",
      "character": "muzhik-sosed",
      "text": "Nee. Hier, nehmen Sie die Ente.",
      "emotion": "neutral",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
  "explicit": false,
