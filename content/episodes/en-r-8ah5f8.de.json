  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein Linguistikprofessor vom Massachusetts Institute of Technology hielt neulich eine Vorlesung.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "doktor",
      "text": "Im Englischen ergibt eine doppelte Verneinung eine Bejahung.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "doktor",
      "text": "In manchen Sprachen jedoch, etwa im Russischen, bleibt eine doppelte Verneinung eine Verneinung.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "doktor",
      "text": "Aber es gibt keine einzige Sprache, nicht eine, in der eine doppelte Bejahung eine Verneinung ausdrücken kann.",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "paren",
      "text": "Ja, ja.",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
