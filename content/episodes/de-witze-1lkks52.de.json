{
  "id": "de-witze-1lkks52.de",
  "jokeId": "de-witze-1lkks52",
  "locale": "de",
  "title": "Der Fallschirmsprung",
  "kind": "joke",
  "v": 2,
  "location": "samolet",
  "place": "plane",
  "cast": [
    "sluzhivy",
    "sluzhivy-ryadovoy",
    "paren"
  ],
  "roles": {
    "sluzhivy-ryadovoy": "soldier",
    "paren": "soldier",
    "sluzhivy": "officer"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Der Ausbilder schreit gegen den Motorenlärm an.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "sluzhivy",
      "text": "Jetzt ihr zwei!",
      "emotion": "angry",
      "pauseAfterSec": 0.2
    },
    {
      "id": "l3",
      "character": "sluzhivy",
      "text": "Jeder den Fallschirm, wir sind über Zielgebiet, steuert das rote X an,",
      "emotion": "angry",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l3b",
      "character": "sluzhivy",
      "text": "und da wartet ein Lkw, der bringt euch dann zurück zur Kaserne.",
      "emotion": "angry",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "sluzhivy",
      "text": "Und drei, zwei, eins – ab!",
      "emotion": "angry",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "Die springen raus, fliegen ein Stück.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "Der Erste zieht am Strick, nüscht. Der Zweite an seinem, nüscht.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l7",
      "character": "narrator",
      "text": "So schweben sie, dann sagt der eine:",
      "emotion": "neutral",
      "pauseAfterSec": 0.2
    },
    {
      "id": "l8",
      "character": "sluzhivy-ryadovoy",
      "text": "Da ist doch noch der Notstrick, glaub' ich.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l9",
      "character": "narrator",
      "text": "Er zieht, der andere auch, nüscht.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l10",
      "character": "sluzhivy-ryadovoy",
      "text": "Weißt du, das is so'n richtiger Mistverein, die Bundeswehr.",
      "uncensored": "Weißt du, das is so'n richtiger Scheißverein, die Bundeswehr.",
      "emotion": "sad",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l11",
      "character": "paren",
      "text": "Find' ich auch.",
      "emotion": "neutral",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l12",
      "character": "paren",
      "text": "Und weißt du was? Ich wette, der Lkw ist auch nicht da.",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
