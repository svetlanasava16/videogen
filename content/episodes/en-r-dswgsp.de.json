  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Ich saß mit einem Freund im Bus, und er hat mir diesen Witz erzählt.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "muzhik",
      "text": "Was machst du, wenn du einen Epileptiker siehst, der in der Badewanne einen Anfall hat?",
      "emotion": "smug",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "muzhik",
      "text": "Deine Wäsche reinwerfen.",
      "emotion": "happy",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": [],
      "laugh": "chuckle"
    },
    {
      "id": "l4",
      "character": "narrator",
      "text": "Der Typ hinter uns beugte sich vor und sagte:",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "muzhik-sosed",
      "text": "Ich finde das widerlich. Mein Sohn ist in der Badewanne gestorben, als er einen Anfall hatte.",
      "emotion": "angry",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "Wir wurden beide kreidebleich und haben uns entschuldigt.",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "narrator",
      "text": "Der Typ stand auf, um auszusteigen, und sagte:",
      "emotion": "neutral",
      "pauseAfterSec": 0.7,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "muzhik-sosed",
      "text": "Er ist an einer Socke erstickt.",
      "emotion": "neutral",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [
        "muzhik-sosed"
      ],
      "laugh": "big"
    }
  ],
