  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein Typ saß mit einem Kumpel im Bus, und der Kumpel erzählte ihm einen Witz.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "muzhik",
      "text": "Was machst du, wenn ein Epileptiker in der Badewanne einen Anfall hat?",
      "emotion": "happy",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "muzhik",
      "text": "Du wirfst deine Wäsche rein.",
      "emotion": "happy",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": [],
      "laugh": "chuckle"
    },
    {
      "id": "l4",
      "character": "ded",
      "text": "Ich finde das widerlich. Mein Sohn ist in der Badewanne bei einem Anfall gestorben.",
      "emotion": "angry",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "Beide wurden kreidebleich und entschuldigten sich. Der Mann stand auf, um auszusteigen.",
      "emotion": "neutral",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "ded",
      "text": "Er ist an einer Socke erstickt.",
      "emotion": "neutral",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [
        "ded"
      ],
      "laugh": "big"
    }
  ],
