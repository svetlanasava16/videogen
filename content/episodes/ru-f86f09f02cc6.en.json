  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Two men ran into each other. They hadn't seen each other in a long time.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "muzhik-sosed",
      "text": "Come on, let's drink to this, after all, we haven't seen each other in ages.",
      "emotion": "happy",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "muzhik",
      "text": "Nah, I quit drinking.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "muzhik-sosed",
      "text": "Why?!",
      "emotion": "surprised",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "muzhik",
      "text": "Well, remember last summer?",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l6",
      "character": "muzhik-sosed",
      "text": "Yes.",
      "emotion": "neutral",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l7",
      "character": "muzhik",
      "text": "Well, I don't!",
      "emotion": "sad",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
