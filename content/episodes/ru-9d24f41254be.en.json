    {
      "id": "l1",
      "character": "muzhik",
      "text": "Doctor, I'm begging you, come right away. My wife has a bad attack of appendicitis!",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "doktor",
      "text": "Don't worry. Two years ago I operated on your wife and removed her appendix. A person can't grow a second appendix!",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "muzhik",
      "text": "That's right, doctor. But a person can get a second wife.",
      "emotion": "neutral",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
