  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Zwei Pfarrer stellen an der Straße ein Schild auf: „Halt, das Ende ist nah! Kehr um, bevor es zu spät ist!“",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Ein Laster rast mit Vollgas an ihnen vorbei.",
      "emotion": "neutral",
      "pauseAfterSec": 0.2,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "muzhik-ryzhy",
      "text": "Verdammte Sektierer, ihr geht mir auf den Geist!",
      "emotion": "angry",
      "pauseAfterSec": 0.4,
      "enter": [
        "muzhik-ryzhy"
      ],
      "exit": [
        "muzhik-ryzhy"
      ]
    },
    {
      "id": "l4",
      "character": "narrator",
      "text": "Der Laster verschwindet hinter der Kurve, dann hört man ein Krachen und ein lautes Platschen.",
      "emotion": "neutral",
      "pauseAfterSec": 0.9,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "batyushka",
      "text": "Sieht so aus, als hättest du recht gehabt. Wir hätten einfach „Brücke eingestürzt“ schreiben sollen.",
      "emotion": "sad",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
