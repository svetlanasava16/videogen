    "muzhik-ryzhy": "driver"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Zwei Priester stellen an der Straße ein Schild auf: „Halt, das Ende ist nah! Kehr um, bevor es zu spät ist!“",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Ein Lastwagen rast mit voller Geschwindigkeit an ihnen vorbei.",
      "emotion": "neutral",
      "pauseAfterSec": 0.2,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "muzhik-ryzhy",
      "text": "Verdammte Sektierer, ihr geht mir auf die Nerven!",
      "emotion": "angry",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "narrator",
      "text": "Der Lastwagen verschwindet hinter der Kurve, von dort hört man ein Krachen und ein lautes Platschen.",
      "emotion": "neutral",
      "pauseAfterSec": 0.9,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "batyushka",
      "text": "Sieht so aus, als hättest du recht gehabt, wir hätten einfach „Brücke eingestürzt“ schreiben sollen.",
      "emotion": "sad",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
