  "locale": "ru",
  "title": "Пересдача",
  "location": "klass",
  "place": "university",
  "cast": [
    "doktor",
    "paren"
  ],
  "roles": {
    "doktor": "professor",
    "paren": "student"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Старый профессор на экзамене:",
      "emotion": "neutral",
      "pauseAfterSec": 0.2,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "doktor",
      "text": "Так, кто считает, что знает предмет на пять баллов?",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "narrator",
      "text": "Подняла руки пара студентов.",
      "emotion": "neutral",
      "pauseAfterSec": 0.2,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "doktor",
      "text": "Давайте зачетки.",
      "emotion": "happy",
      "pauseAfterSec": 0.2,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "И ставит отлично.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "doktor",
      "text": "Кто считает, что знает предмет на четыре балла?",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "narrator",
      "text": "Подняло руки человек десять. Тоже собирает зачетки, ставит четыре.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "doktor",
      "text": "Кто считает, что на три?",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l9",
      "character": "narrator",
      "text": "Подняли руки — та же история.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l10",
      "character": "doktor",
      "text": "Значит, так — остальные неуд, приходите на пересдачу.",
      "emotion": "smug",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l11",
      "character": "paren",
      "text": "А когда пересдача?",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l12",
      "character": "doktor",
      "text": "Ну-у-у, давайте сейчас.",
      "emotion": "happy",
      "pauseAfterSec": 0.7,
      "enter": [],
      "exit": []
    },
    {
      "id": "l13",
      "character": "doktor",
      "text": "Итак, кто считает, что знает предмет на пять баллов?..",
      "emotion": "neutral",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
