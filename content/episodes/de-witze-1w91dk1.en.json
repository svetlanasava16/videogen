    {
      "id": "l1",
      "character": "narrator",
      "text": "Two in the morning. A police officer pulls over an elderly man.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "sluzhivy",
      "text": "Evening, sir. Where are you headed at this hour?",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [
        "sluzhivy"
      ],
      "exit": []
    },
    {
      "id": "l3",
      "character": "ded",
      "text": "To a lecture. On alcohol abuse, its effects on the human body, smoking, and coming home late.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "sluzhivy",
      "text": "Really? And who gives lectures like that at this time of night?",
      "emotion": "surprised",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "ded",
      "text": "My wife.",
      "emotion": "sad",
      "pauseAfterSec": 0.8,
