  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "An elderly man is pulled over by the police at two in the morning.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "sluzhivy",
      "text": "Where are you driving at this time of night?",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "ded",
      "text": "I'm on my way to a lecture on alcohol abuse, its effects on the human body,",
      "emotion": "smug",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l3b",
      "character": "ded",
      "text": "and the effects of smoking and coming home late.",
      "emotion": "smug",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l4",
      "character": "sluzhivy",
      "text": "Really? And who gives lectures like that at this hour?",
      "emotion": "surprised",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l5",
      "character": "ded",
      "text": "My wife!",
      "emotion": "sad",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
