  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Drei Wochen nach der Hochzeit ruft die junge Frau weinend ihre Mutter an.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "devushka-ryzhaya",
      "text": "Mama, ich weiß nicht weiter! Wir hatten einen furchtbaren Streit!",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "zhena",
      "text": "Beruhige dich, Schatz. Nicht weinen.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "zhena",
      "text": "Jedes Paar hat mal seinen ersten Streit.",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "devushka-ryzhaya",
      "text": "Das weiß ich ja. Aber was mache ich mit der Leiche?",
      "emotion": "sad",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    }
