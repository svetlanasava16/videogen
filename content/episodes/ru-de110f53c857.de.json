  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Drei Wochen nach der Hochzeit. Die junge Ehefrau ruft ganz in Tränen ihre Mutter an.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "devushka-ryzhaya",
      "text": "Mama, ich weiß einfach nicht, was ich tun soll!",
      "emotion": "sad",
      "pauseAfterSec": 0.2
    },
    {
      "id": "l3",
      "character": "devushka-ryzhaya",
      "text": "Bei uns hat sich gerade so eine Familienszene abgespielt! Furchtbar!",
      "emotion": "sad",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "zhena",
      "text": "Ruhig, Kind, reg dich nicht auf.",
      "emotion": "neutral",
      "pauseAfterSec": 0.2
    },
    {
      "id": "l5",
      "character": "zhena",
      "text": "In jeder Familie gibt es irgendwann die ersten Streits und Konflikte.",
      "emotion": "smug",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l6",
      "character": "devushka-ryzhaya",
      "text": "Ja, das weiß ich. Aber was mache ich mit der Leiche?",
      "emotion": "sad",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
