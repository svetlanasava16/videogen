  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Drei Wochen nach der Hochzeit. Die junge Ehefrau ruft weinend ihre Mutter an.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "devushka-ryzhaya",
      "text": "Mama, ich weiß einfach nicht, was ich tun soll! Bei uns gab es so eine Familienszene! Schrecklich!",
      "emotion": "sad",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "zhena",
      "text": "Ruhig, Kind, reg dich nicht auf. In jeder Familie gibt es irgendwann den ersten Streit, die ersten Konflikte.",
      "emotion": "neutral",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "devushka-ryzhaya",
      "text": "Ja, das weiß ich. Aber was mache ich mit der Leiche?",
      "emotion": "neutral",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
