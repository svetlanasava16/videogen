  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Im Büro. Das Telefon klingelt einmal, zweimal …",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "nachalnik",
      "text": "Meier, es klingelt! Nun gehen Sie verdammt nochmal ran!",
      "emotion": "angry",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "paren",
      "text": "Chef, ich lasse es immer fünfmal klingeln.",
      "emotion": "smug",
      "pauseAfterSec": 0.2
    },
    {
      "id": "l4",
      "character": "paren",
      "text": "Die Leute sollen doch denken, dass ich schwer beschäftigt bin.",
      "emotion": "smug",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "nachalnik",
      "text": "Gehen Sie ran!",
      "emotion": "angry",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "Meier seufzt, geht an die Leitung und sagt:",
      "emotion": "neutral",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l7",
      "character": "paren",
      "text": "Notrufzentrale der Polizei. Wie können wir Ihnen helfen?",
      "emotion": "neutral",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
