  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Мужик выигрывает в лотерею десять миллионов.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "muzhik",
      "text": "Собирай чемоданы, дорогая!",
      "emotion": "happy",
      "pauseAfterSec": 0.2
    },
    {
      "id": "l3",
      "character": "muzhik",
      "text": "Я выиграл в лотерею!",
      "emotion": "happy",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "zhena",
      "text": "О боже, как здорово!",
      "emotion": "surprised",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "zhena",
      "text": "А что мне брать с собой?",
      "emotion": "happy",
      "pauseAfterSec": 0.2
    },
    {
      "id": "l6",
      "character": "zhena",
      "text": "Летние вещи для Карибов?",
      "emotion": "happy",
      "pauseAfterSec": 0.2
    },
    {
      "id": "l7",
      "character": "zhena",
      "text": "Лыжное для Альп?",
      "emotion": "happy",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l8",
      "character": "muzhik",
      "text": "Без разницы! Главное, чтобы к восьми вечера тебя уже не было дома!",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
