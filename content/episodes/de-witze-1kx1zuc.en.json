  "lines": [
    {
      "id": "l1",
      "character": "paren",
      "text": "Professor Vögele, as the most renowned naturalist of our time,",
      "emotion": "neutral",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l1c",
      "character": "paren",
      "text": "after decades of searching in the deepest,",
      "emotion": "neutral",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l1b",
      "character": "paren",
      "text": "most remote part of the jungle of Madagascar,",
      "emotion": "neutral",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l1d",
      "character": "paren",
      "text": "you have managed to discover the last specimens of the dodo.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l2",
      "character": "paren",
      "text": "Please tell our viewers, how did you find them?",
      "emotion": "happy",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l3",
      "character": "doktor",
      "text": "Delicious! Both of them. The eggs too.",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
