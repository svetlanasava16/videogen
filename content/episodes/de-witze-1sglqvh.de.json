{
  "id": "de-witze-1sglqvh.de",
  "jokeId": "de-witze-1sglqvh",
  "locale": "de",
  "title": "Die Bioprüfung",
  "kind": "joke",
  "v": 2,
  "location": "klass",
  "place": "university",
  "cast": [
    "doktor",
    "paren"
  ],
  "roles": {
    "doktor": "professor",
    "paren": "student"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Mündliche Prüfung in Biologie. Der Professor ist leider einer, der die unmöglichsten Fragen stellt.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Der Professor zeigt ein Bild eines Tieres, aber nur die Füße.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "doktor",
      "text": "Zu welchem Tier gehören diese Füße?",
      "emotion": "smug",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "paren",
      "text": "Elefant!",
      "emotion": "happy",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "doktor",
      "text": "Richtig.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "Bei den drei nächsten Bildern liegt der Prüfling daneben.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l7",
      "character": "doktor",
      "text": "Sie sind durchgefallen!",
      "emotion": "angry",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l8",
      "character": "doktor",
      "text": "Wie ist Ihr Name?",
      "emotion": "angry",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l9",
      "character": "narrator",
      "text": "Der Prüfling zieht die Hosenbeine hoch.",
      "emotion": "neutral",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l10",
      "character": "paren",
      "text": "Raten Sie mal?",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
