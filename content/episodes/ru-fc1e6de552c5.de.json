{
  "id": "ru-fc1e6de552c5.de",
  "jokeId": "ru-fc1e6de552c5",
  "locale": "de",
  "title": "Bier mit Chips",
  "kind": "joke",
  "v": 2,
  "location": "gostinaya",
  "place": "home-living-room",
  "cast": [
    "muzhik",
    "zhena"
  ],
  "roles": {
    "muzhik": "husband",
    "zhena": "wife"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein frisch verheiratetes Paar. Eines Abends sagt der Mann zu seiner Frau:",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "muzhik",
      "text": "Liebling, ich gehe mal für ein paar Stündchen raus.",
      "emotion": "happy",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "zhena",
      "text": "Und wohin willst du denn, mein Häschen?",
      "emotion": "happy",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "Schatz, ich würde gern kurz in die Kneipe, ein Bier trinken.",
      "emotion": "happy",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "zhena",
      "text": "Du willst Bier, Kätzchen?",
      "emotion": "happy",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l5b",
      "character": "zhena",
      "text": "Schau mal, ich hab dir fünfundzwanzig Sorten Bier gekauft, helles und dunkles...",
      "emotion": "happy",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l6",
      "character": "muzhik",
      "text": "Weißt du, mein Engel, ich hätte gern ein Bier mit Chips. Ich bin bald zurück.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l7",
      "character": "zhena",
      "text": "Liebster, schau mal in den Schrank,",
      "emotion": "happy",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l7b",
      "character": "zhena",
      "text": "da hab ich dir eine ganze Auswahl an Chips hingelegt...",
      "emotion": "happy",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l8",
      "character": "muzhik",
      "text": "Hör mal, Eichhörnchen, in der Kneipe gibt es dazu heiße Garnelen, meine liebsten.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l9",
      "character": "zhena",
      "text": "Mein Sonnenschein, ich setze gerade deine Lieblingsgarnelen auf.",
      "emotion": "happy",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l10",
      "character": "muzhik",
      "text": "Wie soll ich dir das erklären, Blauäuglein, in der Kneipe ist alles ganz anders,",
      "emotion": "sad",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l10b",
      "character": "muzhik",
      "text": "da kann man sich mal gehen lassen,",
      "emotion": "sad",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l10c",
      "character": "muzhik",
      "text": "und keiner verurteilt einen, da wird sogar frei geflucht...",
      "emotion": "sad",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l11",
      "character": "zhena",
      "text": "So, mein Lieber!",
      "emotion": "smug",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l12",
      "character": "zhena",
      "text": "Dann trink doch dein bescheuertes Bier mit deinen Mist-Chips und diesen verdammten Garnelen,",
      "uncensored": "Dann trink doch dein beschissenes Bier mit deinen Scheiß-Chips und diesen verfickten Garnelen,",
      "emotion": "angry",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l12b",
      "character": "zhena",
      "text": "weil du verdammt noch mal nirgendwohin gehst, du Mistkerl!",
      "uncensored": "weil du verdammt noch mal nirgendwohin gehst, du Mistkerl!",
      "emotion": "angry",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
