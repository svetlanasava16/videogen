  ],
  "roles": {
    "doktor": "doctor",
    "paren": "programmer"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein Psychiater langweilt sich in seiner Praxis.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Da kriecht ein Mann auf allen vieren herein und zieht etwas hinter sich her.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [
        "paren"
      ],
      "exit": []
    },
    {
      "id": "l3",
      "character": "doktor",
      "text": "Ach, wer kriecht denn da zu uns? Ist das eine kleine Schlange?",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "doktor",
      "text": "Komm rein, kleine Schlange, der Doktor hilft dir.",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "doktor",
      "text": "Nein? Dann ist das bestimmt eine kleine Schildkröte!",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "doktor",
      "text": "Kletter auf den Sessel und erzähl dem Onkel Doktor alles.",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "doktor",
      "text": "Auch nicht? Wer sind wir denn dann? Ein kleines Würmchen?",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "paren",
      "text": "Herr Doktor, Sie können mich mal! Ich bin der Admin, ich verlege Ihr Netzwerkkabel!",
      "emotion": "angry",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    }
  ],
