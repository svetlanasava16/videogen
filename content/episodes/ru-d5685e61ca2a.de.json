  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein Psychiater sitzt in seiner Praxis und langweilt sich... Keine Patienten.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Da geht leise die Tür auf, und ein Mann kriecht auf allen vieren herein, etwas zwischen den Zähnen, in den Händen und so weiter, und hinten schleift noch etwas nach.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [
        "paren"
      ],
      "exit": []
    },
    {
      "id": "l3",
      "character": "doktor",
      "text": "Oh, wer kriecht denn da zu uns! Das ist bestimmt eine kleine Schlange.",
      "emotion": "happy",
      "pauseAfterSec": 0.2,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "doktor",
      "text": "Komm rein, Schlange, komm rein, Kleine, der Doktor hilft dir.",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "Der Mann schüttelt den Kopf.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "doktor",
      "text": "Aaah, dann besucht uns bestimmt ein Schildkrötchen.",
      "emotion": "surprised",
      "pauseAfterSec": 0.2,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "doktor",
      "text": "Kriech in den Sessel, Schildkrötchen, und erzähl dem Onkel Doktor, was dir passiert ist...",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "narrator",
      "text": "Der Mann schüttelt den Kopf.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l9",
      "character": "doktor",
      "text": "Wer ist denn das dann bei uns? Bestimmt ein kleines Würmchen?",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    },
    {
      "id": "l10",
      "character": "paren",
      "text": "Doktor, hauen Sie ab, ich bin der Admin, ich verlege Ihnen das Netzwerk!",
      "uncensored": "Doktor, verpissen Sie sich, ich bin der Admin, ich verlege Ihnen das Netzwerk!",
      "emotion": "angry",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
