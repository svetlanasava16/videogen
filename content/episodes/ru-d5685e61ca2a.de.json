{
  "id": "ru-d5685e61ca2a.de",
  "jokeId": "ru-d5685e61ca2a",
  "locale": "de",
  "title": "Der Admin",
  "kind": "joke",
  "v": 2,
  "location": "bolnitsa",
  "place": "doctor-office",
  "cast": [
    "paren",
    "doktor"
  ],
  "roles": {
    "paren": "programmer",
    "doktor": "doctor"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein Psychiater sitzt in seiner Praxis und langweilt sich... keine Patienten kommen.",
      "emotion": "neutral",
      "pauseAfterSec": 0
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Da geht ganz leise die Tür auf, und auf allen vieren kriecht ein Mann zu ihm herein,",
      "emotion": "surprised",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l2c",
      "character": "narrator",
      "text": "irgendwas zwischen den Zähnen, in den Händen und so weiter, und hinten schleift noch etwas hinterher.",
      "emotion": "surprised",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l2b",
      "character": "narrator",
      "text": "Der Psychiater:",
      "emotion": "surprised",
      "pauseAfterSec": 0
    },
    {
      "id": "l3",
      "character": "doktor",
      "text": "Oh, wer kriecht denn da zu uns herein! Das ist bestimmt eine kleine Schlange.",
      "emotion": "happy",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l3b",
      "character": "doktor",
      "text": "Kriech rein, Schlängelchen, kriech rein, meine Kleine, der Doktor hilft dir.",
      "emotion": "happy",
      "pauseAfterSec": 0
    },
    {
      "id": "l4",
      "character": "narrator",
      "text": "Der Mann schüttelt den Kopf.",
      "emotion": "neutral",
      "pauseAfterSec": 0
    },
    {
      "id": "l5",
      "character": "doktor",
      "text": "Aaah, dann ist das bestimmt ein Schildkrötchen, das uns besuchen kommt.",
      "emotion": "happy",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l5b",
      "character": "doktor",
      "text": "Kriech in den Sessel, Schildkrötchen,",
      "emotion": "happy",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l5c",
      "character": "doktor",
      "text": "und erzähl dem Onkel Doktor, was dir passiert ist...",
      "emotion": "happy",
      "pauseAfterSec": 0
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "Der Mann schüttelt den Kopf.",
      "emotion": "neutral",
      "pauseAfterSec": 0
    },
    {
      "id": "l7",
      "character": "doktor",
      "text": "Wer ist denn das bei uns? Bestimmt ein kleines Würmchen?",
      "emotion": "surprised",
      "pauseAfterSec": 0
    },
    {
      "id": "l8",
      "character": "paren",
      "text": "Doktor, verziehen Sie sich, ich bin der Admin, ich verlege Ihnen das Netzwerk!",
      "uncensored": "Doktor, verpissen Sie sich, ich bin der Admin, ich verlege Ihnen das Netzwerk!",
      "emotion": "angry",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
