  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Ein Psychiater sitzt in seiner Praxis und langweilt sich. Keine Patienten kommen.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Da öffnet sich leise die Tür, und ein Mann kriecht auf allen vieren herein, etwas zwischen den Zähnen und in den Händen, und hinter ihm schleift noch etwas her.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [
        "paren"
      ],
      "exit": []
    },
    {
      "id": "l3",
      "character": "doktor",
      "text": "Oh, wer kriecht denn da zu uns! Das ist bestimmt eine kleine Schlange.",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "doktor",
      "text": "Kriech rein, Schlange, kriech rein, Kleine, der Doktor hilft dir.",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "Der Mann schüttelt den Kopf.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "doktor",
      "text": "Aha, dann hat uns bestimmt eine kleine Schildkröte besucht.",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "doktor",
      "text": "Kriech in den Sessel, Schildkröte, und erzähl dem Onkel Doktor, was mit dir passiert ist.",
      "emotion": "happy",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l8",
      "character": "narrator",
      "text": "Der Mann schüttelt den Kopf.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l9",
      "character": "doktor",
      "text": "Wer ist denn das bei uns? Bestimmt ein kleines Würmchen?",
      "emotion": "surprised",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": []
    },
    {
      "id": "l10",
      "character": "paren",
      "text": "Doktor, hauen Sie ab, ich bin der Systemadmin, ich verlege Ihnen das Netzwerk!",
      "uncensored": "Doktor, verpissen Sie sich, ich bin der Systemadmin, ich verlege Ihnen das Netzwerk!",
      "emotion": "angry",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
