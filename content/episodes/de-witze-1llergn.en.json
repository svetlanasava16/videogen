  "title": "The Mirror",
  "kind": "joke",
  "v": 2,
  "location": "doroga",
  "place": "road",
  "cast": [
    "nachalnik",
    "muzhik-ryzhy"
  ],
  "roles": {
    "nachalnik": "boss",
    "muzhik-ryzhy": "driver"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "A late-night call to the boss of a trucking company. One of his drivers is on the line.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "muzhik-ryzhy",
      "text": "Boss, sorry to wake you, but I've had an accident and I can't make the delivery.",
      "emotion": "sad",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "nachalnik",
      "text": "Good heavens, are you all right?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "muzhik-ryzhy",
      "text": "Yeah, I'm fine, but I can't keep going, the mirror on the passenger side is broken.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "nachalnik",
      "text": "What is this nonsense? You can easily keep driving with that!",
      "emotion": "angry",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l6",
      "character": "muzhik-ryzhy",
      "text": "Nope, can't.",
      "emotion": "sad",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l7",
      "character": "nachalnik",
      "text": "Are you nuts? Because of a mirror?",
      "emotion": "angry",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l8",
      "character": "muzhik-ryzhy",
      "text": "Well, the truck is lying on it.",
      "emotion": "neutral",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
