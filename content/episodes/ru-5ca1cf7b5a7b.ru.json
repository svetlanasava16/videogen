{
  "id": "ru-5ca1cf7b5a7b.ru",
  "jokeId": "ru-5ca1cf7b5a7b",
  "locale": "ru",
  "title": "Четвёртый охранник",
  "kind": "joke",
  "v": 2,
  "location": "bar",
  "place": "restaurant",
  "cast": [
    "sluzhivy",
    "muzhik",
    "nachalnik",
    "paren"
  ],
  "roles": {
    "sluzhivy": "guard",
    "muzhik": "new-russian",
    "nachalnik": "new-russian",
    "paren": "guard"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Встреча новых русских. Каждый привёл с собой громадину-охранника. И только у одного — щуплый, низкорослый, болезненного вида.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "muzhik",
      "text": "Он у тебя крутой боец?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "nachalnik",
      "text": "Да нет, совсем никакой.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "Снайпер?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "nachalnik",
      "text": "Никогда оружия в руках не держал.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l6",
      "character": "muzhik",
      "text": "Так зачем ты его за собой таскаешь?",
      "emotion": "angry",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l7",
      "character": "narrator",
      "text": "Поглаживая охранника по голове:",
      "emotion": "neutral",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l8",
      "character": "nachalnik",
      "text": "А он у меня уже четвёртый такой, все его за меня принимают.",
      "emotion": "smug",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
  "explicit": false,
