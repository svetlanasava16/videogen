      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "sluzhivy",
      "text": "Ich hab Ihnen doch gesagt, Sie sollen die Pinguine in den Zoo bringen!",
