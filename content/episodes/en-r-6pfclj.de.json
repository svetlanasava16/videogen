{
  "id": "en-r-6pfclj.de",
  "jokeId": "en-r-6pfclj",
  "locale": "de",
  "title": "Die Pinguine",
  "kind": "joke",
  "v": 2,
  "location": "doroga",
  "place": "road",
  "cast": [
    "sluzhivy",
    "pingvin",
    "muzhik"
  ],
  "roles": {
    "sluzhivy": "traffic-cop",
    "pingvin": "penguin",
    "muzhik": "everyman"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Eines Tages hält ein Polizist einen Lieferwagen an, und als er ans Fenster tritt, sieht er hinten zehn Pinguine sitzen.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "sluzhivy",
      "text": "Sind das Ihre Pinguine?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "muzhik",
      "text": "Ja, das sind meine Haustiere.",
      "emotion": "happy",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "sluzhivy",
      "text": "Sie müssen sie sofort in den Zoo bringen.",
      "emotion": "angry",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "narrator",
      "text": "Der Mann ist einverstanden und fährt los.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l6",
      "character": "narrator",
      "text": "Am nächsten Tag hält der Polizist denselben Lieferwagen an, tritt ans Fenster und sieht die zehn Pinguine, alle mit Sonnenbrillen.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l7",
      "character": "sluzhivy",
      "text": "Ich dachte, ich hätte Ihnen gesagt, Sie sollen die Pinguine in den Zoo bringen.",
      "emotion": "angry",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l8",
      "character": "muzhik",
      "text": "Hab ich! Heute fahren wir an den Strand!",
      "emotion": "happy",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
