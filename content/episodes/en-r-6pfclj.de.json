      "id": "l1",
      "character": "narrator",
      "text": "Ein Polizist hält einen Lieferwagen an. Hinten sitzen zehn Pinguine.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "sluzhivy",
      "text": "Sind das Ihre Pinguine?",
