      "character": "barmen",
      "text": "Your Holiness, we'll pay ten million dollars if from now on the prayer goes: give us this day our daily cola.",
      "emotion": "smug",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "batyushka",
      "text": "Out of the question. We can't do that!",
      "emotion": "angry",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "barmen",
      "text": "We'd even pay the Church a hundred million.",
      "emotion": "smug",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l4",
      "character": "batyushka",
      "text": "Brother, when exactly does our contract with the bakery run out?",
