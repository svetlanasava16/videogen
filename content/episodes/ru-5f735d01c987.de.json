{
  "id": "ru-5f735d01c987.de",
  "jokeId": "ru-5f735d01c987",
  "locale": "de",
  "title": "Name auf dem Glas",
  "kind": "joke",
  "v": 2,
  "location": "ulitsa",
  "place": "street",
  "cast": [
    "muzhik",
    "paren"
  ],
  "roles": {
    "muzhik": "everyman",
    "paren": "boyfriend"
  },
  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Zwei Kumpel treffen sich. Einer ist schlecht gelaunt.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "muzhik",
      "text": "Warum bist du so traurig?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "paren",
      "text": "Hab mich mit meiner Freundin gestritten.",
      "emotion": "sad",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "muzhik",
      "text": "Weswegen?",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l5",
      "character": "paren",
      "text": "Wir sind gestern mit der U-Bahn gefahren,",
      "emotion": "sad",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l5b",
      "character": "paren",
      "text": "und ich hab die ganze Fahrt aufs Glas gehaucht und ihren Namen geschrieben, und sie war beleidigt.",
      "emotion": "sad",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l6",
      "character": "muzhik",
      "text": "Komisch! Wie kann man denn deswegen beleidigt sein?",
      "emotion": "surprised",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l7",
      "character": "paren",
      "text": "Na, sie mag es nicht, wenn man ihr auf die Brille haucht.",
      "emotion": "sad",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
