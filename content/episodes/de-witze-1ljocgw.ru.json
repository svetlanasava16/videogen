  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Приходит мужик на биржу труда.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l2",
      "character": "muzhik",
      "text": "У вас есть для меня работа?",
      "emotion": "happy",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l3",
      "character": "uchilka",
      "text": "Конечно.",
      "emotion": "neutral",
      "pauseAfterSec": 0.15
    },
    {
      "id": "l3b",
      "character": "uchilka",
      "text": "Работа на полдня, служебная машина, служебная квартира, сорок дней отпуска.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3
    },
    {
      "id": "l4",
      "character": "uchilka",
      "text": "Никакого особого образования, пять тысяч долларов в месяц.",
      "emotion": "neutral",
      "pauseAfterSec": 0.4
    },
    {
      "id": "l5",
      "character": "muzhik",
      "text": "Слушайте, вы что, издеваетесь надо мной?!",
      "emotion": "angry",
      "pauseAfterSec": 0.6
    },
    {
      "id": "l6",
      "character": "uchilka",
      "text": "А кто первый начал эту фигню?!",
      "uncensored": "А кто первый начал эту херню?!",
      "emotion": "angry",
      "pauseAfterSec": 0.8,
      "laugh": "big"
    }
  ],
