  "lines": [
    {
      "id": "l1",
      "character": "narrator",
      "text": "Fährt ein dicker Mercedes, und hinter ihm ein Krankenwagen und die Feuerwehr.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l2",
      "character": "narrator",
      "text": "Wie üblich wird er an der Polizeikontrolle angehalten, und gleich hinter ihm halten auch der Krankenwagen und die Feuerwehr.",
      "emotion": "neutral",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l3",
      "character": "sluzhivy",
      "text": "Warum halten Sie denn an? Fahren Sie weiter, ich habe nur den Mercedes angehalten.",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l4",
      "character": "nachalnik",
      "text": "Die gehören zu mir.",
      "emotion": "smug",
      "pauseAfterSec": 0.4,
      "enter": [],
      "exit": []
    },
    {
      "id": "l5",
      "character": "sluzhivy",
      "text": "Wozu brauchst du die?",
      "emotion": "surprised",
      "pauseAfterSec": 0.3,
      "enter": [],
      "exit": []
    },
    {
      "id": "l6",
      "character": "nachalnik",
      "text": "Na, wegen euch Parasiten!",
      "emotion": "angry",
      "pauseAfterSec": 0.6,
      "enter": [],
      "exit": []
    },
    {
      "id": "l7",
      "character": "nachalnik",
      "text": "Mal soll ich euch den Verbandskasten zeigen, mal den Feuerlöscher...",
      "emotion": "angry",
      "pauseAfterSec": 0.8,
      "enter": [],
      "exit": [],
      "laugh": "big"
    }
  ],
