{
  "items": [
    { "id": "pilot-uniform", "slot": "torso", "layer": 0, "wear": true, "note": "dark-blue double-breasted jacket, white shirt and black tie, gold wings, gold cuff stripes",
      "outfit": { "sleeve": "#1e2a44", "pants": "#1e2a44", "cuff": { "color": "#d9a92a", "n": 4 } },
      "let": { "vy": "top + h * 0.42" },
      "draw": [
        { "p": "base", "color": "#1e2a44" },
        { "p": "vneck", "top": "top", "vy": "vy", "color": "#f4f4ef" },
        { "p": "tie", "y0": "top + 8", "y1": "vy - 4", "color": "#151515" },
        { "p": "lapels", "top": "top", "vy": "vy", "color": "shade(#1e2a44, -0.1)" },
        { "p": "each", "var": "s", "in": [-1, 1], "do": [ { "p": "buttons", "x": "150 + s * 17", "y0": "vy + 14", "y1": "bottom - 26", "n": 3 } ] },
        { "p": "g", "transform": "translate({150 - iw * 0.3} {top + h * 0.5})", "fill": "#d9a92a", "do": [
          { "p": "path", "d": "M-26 -2 Q-14 -10 0 -4 Q14 -10 26 -2 Q14 2 0 2 Q-14 2 -26 -2 Z" }, { "p": "circle", "cx": 0, "cy": -2, "r": 6 } ] },
        { "p": "each", "var": "s", "in": [-1, 1], "do": [ { "p": "rect", "x": "150 + s * iw * 0.32 - iw * 0.13", "y": "bottom - h * 0.24", "w": "iw * 0.26", "h": 6, "rx": 3, "fill": "shade(#1e2a44, 0.25)" } ] }
      ] },
