# Скопируйте в infra/.env и заполните. infra/.env в git не попадает.

# База ANEK. (локально можно оставить по умолчанию)
ANEK_DB_PASSWORD=anek

# Postiz
POSTIZ_URL=https://postiz.example.com        # публичный HTTPS-адрес через Cloudflare Tunnel
POSTIZ_DB_PASSWORD=change-me
JWT_SECRET=change-me-long-random-string
DISABLE_REGISTRATION=false                    # после создания своего аккаунта поставить true

# Cloudflare Tunnel (Zero Trust → Networks → Tunnels → токен)
CLOUDFLARE_TUNNEL_TOKEN=

# Площадки (см. docs/POSTIZ.md)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
# Instagram: либо через Facebook-страницу…
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# …либо standalone (профессиональный аккаунт без страницы)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
THREADS_APP_ID=
THREADS_APP_SECRET=
# Позже
X_API_KEY=
X_API_SECRET=
VK_ID=
