{
  "name": "joke-factory",
  "private": true,
  "type": "module",
  "scripts": {
    "studio": "pnpm --filter @jf/remotion studio",
    "render:demo": "pnpm --filter @jf/remotion render:demo",
    "typecheck": "pnpm -r typecheck",
    "jokes": "pnpm --filter @jf/pipeline jokes",
    "llm": "pnpm --filter @jf/pipeline llm",
    "catalog": "pnpm --filter @jf/pipeline catalog",
    "canon": "pnpm --filter @jf/pipeline canon",
    "registry": "pnpm --filter @jf/pipeline registry",
    "audio": "pnpm --filter @jf/pipeline audio",
    "db": "pnpm --filter @jf/pipeline db",
    "render": "pnpm --filter @jf/pipeline render",
    "posts": "pnpm --filter @jf/pipeline posts",
    "metrics": "pnpm --filter @jf/pipeline metrics",
    "voice": "pnpm --filter @jf/pipeline voice",
    "board": "pnpm --filter @jf/pipeline board",
    "compile": "pnpm --filter @jf/pipeline compile",
    "validate": "pnpm --filter @jf/pipeline validate",
    "stills": "pnpm --filter @jf/pipeline stills",
    "golden": "pnpm --filter @jf/pipeline golden",
    "migrate-episodes": "pnpm --filter @jf/pipeline migrate-episodes",
    "golden:docker": "bash tests/golden-env/golden.sh"
  },
  "packageManager": "pnpm@10.0.0"
}
