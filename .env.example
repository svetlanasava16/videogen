# Шаблон .env (сам .env в git не попадает): cp .env.example .env — и вставить ключи.
# Ключи ElevenLabs: elevenlabs.io → Developers → API keys → Create API key.
# Права ключа: Text to Speech (Access) · Voices (Read + Write) · User (Read); остальное выключено.

# Бесплатный аккаунт — по умолчанию (тесты): озвучка помечается elevenlabs-free и в публикации не идёт
ELEVENLABS_API_KEY=PASTE_KEY_HERE
ELEVENLABS_PLAN=free

# Платный аккаунт (Starter/Creator) — озвучка для публикации, включается флагом --paid у любой команды pnpm voice
ELEVENLABS_API_KEY_PAID=PASTE_KEY_HERE
